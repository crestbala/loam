//! Loam — the language site. One entry, the wasm web target.
//!
//! `zeli routes` generates app_routes.loam from routes/. This file mounts it.
//! The app itself has no server import, no filesystem, and no working
//! directory. Analytics post to `/api/track`, which has no server yet: see
//! docs/site-analytics.md before publishing.

import "std:zeus"
import "std:analytics"
import "app_routes.loam" as approutes
import "tests/smoke.loam" as smoketest

fn main() {
    zeus.App("Loam", fn() -> Node {
        analytics.start(AnalyticsProps {})
        return approutes.app()
    })
}
