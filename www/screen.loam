//! Docs UI. Sidebar picks a page id; article copy was loaded over Docs.Page.

import "std:zeus"
import "std:colors"
import "std:zui"
import "cache.loam"

fn NavItem(page: Signal<int>, id: int, label: string) -> Node {
    return zeus.Box(
        style = merge(Style(padding = edges2(6, 12), radius = corners(8)), Style(background = if page.get() == id { colors.wash() } else { "" })),
        on_click = fn() => page.set(id)
    ) {
        zeus.Text(label, style = Style(font = 13, color = zeus.ink()))
    }
}

fn Nav(page: Signal<int>) -> Node {
    return zeus.Box(style = Style(width = px(240), direction = Direction.Column, gap = 4)) {
        zui.Overline("Start")
        NavItem(page, 0, "Overview")
        NavItem(page, 1, "Install")
        zui.Overline("Language")
        NavItem(page, 2, "Syntax")
        NavItem(page, 3, "Types")
        NavItem(page, 4, "Ownership")
        NavItem(page, 5, "Control flow")
        NavItem(page, 6, "Modules")
        zui.Overline("Libraries")
        NavItem(page, 7, "Overview")
        NavItem(page, 8, "fmt")
        NavItem(page, 9, "zeus")
        NavItem(page, 10, "http")
        NavItem(page, 11, "maya")
        NavItem(page, 12, "sys")
        NavItem(page, 13, "net")
        zui.Overline("More")
        NavItem(page, 14, "Platforms")
        NavItem(page, 15, "Examples")
    }
}

fn Block(id: int, page: Signal<int>) -> Node {
    return zui.Show(when = page.get() == id, style = Style(gap = 8)) {
        zeus.Text(cache.title(id), style = Style(font = 22, color = zeus.ink()))
        zeus.Text(cache.lead(id), style = Style(font = 14, color = colors.mute()))
        zeus.Text(cache.body(id), style = Style(font = 13, color = zeus.ink()))
        zeus.Box(style = Style(padding = edges(12), radius = corners(8), background = colors.wash())) {
            zeus.Text(cache.sample(id), style = Style(font = 12, color = zeus.ink()))
        }
    }
}

fn Article(page: Signal<int>) -> Node {
    return zeus.Box(style = Style(direction = Direction.Column, gap = 16, grow = 1)) {
        let mut i = 0
        while i < cache.n() {
            Block(i, page)
            i += 1
        }
    }
}

fn Screen(chip: string, page: Signal<int>) -> Node {
    return zeus.Box(style = Style(direction = Direction.Column,
                           gap = 16,
                           padding = edges(28),
                           background = colors.paper())) {
        zui.Row(8) {
            zeus.Text("Loam", style = Style(font = 22, color = zeus.ink()))
            zui.Chip(chip, zeus.Tint.Ink)
            zui.Badge("Docs.Page", zeus.Tint.Ok)
        }
        zui.Alert("RPC", "Sidebar writes a signal. Copy was fetched once over Docs.Page (gRPC-Web).")
        zui.Row(24) {
            Nav(page)
            Article(page)
        }
    }
}
