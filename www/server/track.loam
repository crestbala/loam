//! Receives the batches `zeus:analytics` sends. Everything here came from a browser,
//! so it is checked and cut to size before it is stored. Native only.

import "std:json"
import "std:result"
import "db.loam" as db

/// `json.kind` of an array.
const JSON_ARRAY: int = 4
const MAX_EVENTS: int = 50
const MAX_TEXT: int = 200
/// One event's visible time. A day is more than any page holds a person, and a
/// forged value must not overflow the report's sums.
const MAX_MS: int = 86400000
const MAX_WIDTH: int = 100000
/// A browser clock can be wrong: outside this window the server's time is used.
const MAX_SKEW_MS: i64 = 86400000

fn is_id(s: string) -> bool {
    if s.len != 32 {
        return false
    }
    for i in 0..s.len {
        let c = s[i]
        if !((c >= 48 && c <= 57) || (c >= 97 && c <= 102)) {
            return false
        }
    }
    return true
}

/// An id as an integer: its last 15 hex digits, which is 60 random bits, plenty to
/// tell a site's visitors apart. `s` has passed `is_id`.
fn short_id(s: string) -> i64 {
    let mut v: i64 = 0
    for i in 17..32 {
        let digit = if s[i] <= 57 { s[i] - 48 } else { s[i] - 87 }
        v = v * 16 + i64(digit)
    }
    return v
}

fn known_kind(k: string) -> bool {
    return k == "page" || k == "leave" || k == "click" || k == "event"
}

/// `s` cut to `MAX_TEXT` bytes, on a character boundary. Text with control
/// characters is dropped: it has no honest use here.
fn clean_text(s: string) -> string {
    for i in 0..s.len {
        if s[i] < 32 || s[i] == 127 {
            return ""
        }
    }
    if s.len <= MAX_TEXT {
        return s
    }
    let mut end = MAX_TEXT
    // A byte of the form 10xxxxxx continues a character.
    while end > 0 && s[end] >= 128 && s[end] < 192 {
        end -= 1
    }
    let mut out = []int {}
    for i in 0..end {
        out.push(s[i])
    }
    return string_from_bytes(out)
}

fn text_at(doc: JsonDoc, id: int, key: string) -> string {
    let f = json.field(doc.nodes, id, key, key)
    if f.ok != 1 {
        return ""
    }
    let s = json.as_str(doc.nodes, f.id, key)
    if s.ok != 1 {
        return ""
    }
    return s.s
}

/// The whole number at `key`, from 0 to `most`, or -1.
fn count_at(doc: JsonDoc, id: int, key: string, most: int) -> int {
    let f = json.field(doc.nodes, id, key, key)
    if f.ok != 1 {
        return -1
    }
    let n = json.as_int(doc.nodes, f.id, key)
    if n.ok != 1 || n.n < i64(0) || n.n > i64(most) {
        return -1
    }
    return int(n.n)
}

/// The browser's time for an event, or `now` when that is missing or far off.
fn time_at(doc: JsonDoc, id: int, now: i64) -> i64 {
    let f = json.field(doc.nodes, id, "ts", "ts")
    if f.ok != 1 {
        return now
    }
    let n = json.as_int(doc.nodes, f.id, "ts")
    if n.ok != 1 || n.n <= now - MAX_SKEW_MS || n.n >= now + MAX_SKEW_MS {
        return now
    }
    return n.n
}

/// Add event `id` to `rows`, if it passes. A bad event drops only itself.
fn add_row(rows: &mut []EventRow, doc: JsonDoc, id: int, vid: i64, now: i64) {
    let kind = text_at(doc, id, "k")
    let sid = text_at(doc, id, "sid")
    let pv = text_at(doc, id, "pv")
    if !known_kind(kind) || !is_id(sid) || !is_id(pv) {
        return
    }
    let path = clean_text(text_at(doc, id, "path"))
    if path.len == 0 || path[0] != 47 {
        return
    }
    push(rows, EventRow {
        vid: vid,
        sid: short_id(sid),
        pv: short_id(pv),
        kind: kind,
        path: path,
        name: clean_text(text_at(doc, id, "name")),
        data: clean_text(text_at(doc, id, "data")),
        ms: count_at(doc, id, "ms", MAX_MS),
        width: count_at(doc, id, "w", MAX_WIDTH),
        ref: clean_text(text_at(doc, id, "ref")),
        ts: time_at(doc, id, now),
    })
}

/// Store the batch in `body`. Returns the HTTP status to answer with.
fn receive(body: string, now: i64) -> int {
    let doc = json.parse(body)
    if doc.ok != 1 {
        return 400
    }
    let version = count_at(doc, doc.root, "v", 1000)
    let vid = text_at(doc, doc.root, "vid")
    let events = json.field(doc.nodes, doc.root, "events", "events")
    if version != 1 || !is_id(vid) || events.ok != 1 || json.kind(doc.nodes, events.id) != JSON_ARRAY {
        return 400
    }
    let mut rows = []EventRow {}
    let n = json.child_count(doc.nodes, events.id)
    for i in 0..(if n < MAX_EVENTS { n } else { MAX_EVENTS }) {
        add_row(&mut rows, doc, json.index(doc.nodes, events.id, i, "events").id, short_id(vid), now)
    }
    if rows.len == 0 {
        return 204
    }
    if result.is_err(db.insert(rows)) {
        return 503
    }
    return 204
}
