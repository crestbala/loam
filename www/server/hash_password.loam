//! Prints the hash for `VAULT_PASSWORD_HASH`. It reads the password from standard
//! input, so it stays out of the shell history. A final line break is dropped:
//!
//!     ./bin/loamc www/server/hash_password.loam -o /tmp/hash-password
//!     read -rs PW; printf %s "$PW" | /tmp/hash-password; unset PW

import "std:crypto"
import "std:fmt"
import "std:result"
import "std:sys"

#[c("read")]
fn c_read(fd: int, out: []u8, n: i64) -> i64 {}

const MAX_PASSWORD: int = 4096

/// Standard input, up to `MAX_PASSWORD` bytes, without its final line break.
fn read_password() -> string {
    let mut out = []int {}
    let chunk = []u8 { 0 }
    while out.len < MAX_PASSWORD && c_read(0, chunk, i64(1)) == 1 {
        out.push(int(chunk[0]))
    }
    while out.len > 0 && (out[out.len - 1] == 10 || out[out.len - 1] == 13) {
        let _ = out.pop()
    }
    return string_from_bytes(out)
}

fn main() {
    let hashed = crypto.hash_password(read_password())
    if result.is_err(hashed) {
        fmt.println(hashed.err)
        sys.exit(1)
    }
    fmt.println(hashed.val)
}
