import "zeus"
import "zui"
import "zeus:router"
import "../components/home.loam" as home

fn Page(p: Params) -> Node {
    return home.Home()
}

fn meta(p: Params) -> Meta {
    return Meta {
        title: "Loam",
        description: "A memory-safe systems language, its standard UI, and a browser playground.",
    }
}
