// Site chrome: the top bar, the section sidebar, and the footer. Every entry
// is a real URL.

import "zeus"
import "zui:colors"
import "zui:spacing"
import "zui"
import "zeus:router"

/** *Below this content width the sidebar folds away and the top bar wraps. */
const WIDE: int = 920

/** *Width of the site column, set by the layout. Pages size grids from it. */
let page_w = zeus.signal(1200)

/** *The navigation drawer on narrow screens. */
let menu_open = zeus.signal(false)

/** *Where the language's source lives. */
const GITHUB_URL: string = "https://github.com/crestbala/loam"

const GITHUB_ICON: string = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><path fill='currentColor' d='M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z'/></svg>"

const MENU_ICON: string = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' d='M4 7h16M4 12h16M4 17h16'/></svg>"
const DOOR_ICON: string = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='none' stroke='currentColor' stroke-width='1.75' stroke-linecap='round' stroke-linejoin='round' d='M6 21V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v17M3 21h18M14 12v.5'/></svg>"
const CLOSE_ICON: string = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' d='M6 6l12 12M18 6L6 18'/></svg>"

/** *True while the page is wide enough for the sidebar and the top links. */
fn wide() -> bool {
    return page_w.get() >= WIDE
}

/** *Go to `href` and close the drawer, if it is open. */
fn go(href: string) {
    menu_open.set(false)
    router.navigate(href)
}

/** *Width left for a page's content: the column, less the sidebar and its gap */
/** *when the sidebar shows. */
fn content_w() -> int {
    let w = page_w.get()
    if w >= WIDE {
        let rest = w - 248
        return if rest > 840 { 840 } else { rest }
    }
    return w
}

fn starts_with(path: string, href: string) -> bool {
    if href.len == 0 || href == "/" {
        return false
    }
    if path.len < href.len {
        return false
    }
    for i in 0..href.len {
        if path[i] != href[i] {
            return false
        }
    }
    if path.len == href.len {
        return true
    }
    return path[href.len] == 47
}

fn NavLink(label: string, href: string) -> Node {
    let path = router.path_signal()
    fn active() -> bool {
        return starts_with(path.get(), href) || path.get() == href
    }
    return zeus.Box(
        style = Style(
            height = px(32),
            direction = Direction.Row,
            align = Align.Center,
            paddingX = 10,
            radius = 6,
            cursor = "pointer",
            background = if active() { colors.raised() } else { "" },
        ),
        hoverStyle = fn() -> Style {
            return Style(background = colors.raised())
        },
        on_click = fn() => go(href),
        href = href,
        role = "link",
        label = label,
    ) {
        zeus.Text(
            label,
            style = Style(font = spacing.FONT_BODY, color = if active() {
                zeus.ink()
            } else {
                colors.mute()
            }),
        )
    }
}

fn Brand() -> Node {
    return zeus.Box(
        style = Style(
            direction = Direction.Row,
            align = Align.Center,
            gap = 10,
            cursor = "pointer",
        ),
        on_click = fn() => go("/"),
        href = "/",
        role = "link",
        label = "Loam home",
    ) {
        zeus.Box(style = Style(
            width = px(26),
            height = px(26),
            radius = 7,
            direction = Direction.Row,
            align = Align.Center,
            justify = Align.Center,
            background = zeus.accent(),
        )) {
            zeus.Text("L", style = Style(font = spacing.FONT_TITLE, color = colors.on_accent()))
        }
        zeus.Text("Loam", style = Style(font = spacing.FONT_TITLE, color = zeus.ink()))
    }
}

fn Topbar() -> Node {
    return zeus.Box(style = Style(direction = Direction.Column, gap = 0, width = pct(100))) {
        zeus.Box(style = Style(
            direction = Direction.Row,
            align = Align.Center,
            gap = 4,
            wrap = true,
            width = pct(100),
            paddingBottom = 14,
        )) {
            zui.Show(when = !wide()) {
                zui.IconButton(
                    MENU_ICON,
                    zeus.Look.Ghost,
                    Size.Md,
                    "Open navigation",
                    on_click = fn() => menu_open.set(true),
                )
            }
            Brand()
            zui.Show(when = router.pending().get()) {
                zui.Spinner(label = "Loading page", style = Style(marginLeft = 8))
            }
            zui.Show(when = wide()) {
                zeus.Box(style = Style(direction = Direction.Row, align = Align.Center, gap = 4, paddingLeft = 20)) {
                    NavLink("Language", "/language")
                    NavLink("Types", "/types")
                    NavLink("Zeus", "/zeus")
                    NavLink("Components", "/components")
                    NavLink("Tooling", "/tooling")
                    NavLink("Playground", "/playground")
                }
            }
            zui.Grow()
            zeus.Box(style = Style(direction = Direction.Row, align = Align.Center, gap = 8)) {
                zeus.Text("Dark", style = Style(font = spacing.FONT_CONTROL, color = colors.mute()))
                zui.ThemeSwitch()
                zui.IconButton(
                    GITHUB_ICON,
                    zeus.Look.Ghost,
                    Size.Md,
                    "Loam on GitHub",
                    on_click = fn() => zeus.open_external(GITHUB_URL),
                )
            }
        }
        zui.Separator()
    }
}

fn SideLink(label: string, href: string) -> Node {
    let path = router.path_signal()
    fn active() -> bool {
        return path.get() == href
    }
    return zeus.Box(
        style = Style(
            width = pct(100),
            height = px(30),
            direction = Direction.Row,
            align = Align.Center,
            paddingX = 10,
            radius = 6,
            cursor = "pointer",
            background = if active() { colors.raised() } else { "" },
        ),
        hoverStyle = fn() -> Style {
            return Style(background = colors.raised())
        },
        on_click = fn() => go(href),
        href = href,
        role = "link",
        label = label,
    ) {
        zeus.Text(
            label,
            style = Style(font = spacing.FONT_BODY, color = if active() {
                zeus.ink()
            } else {
                colors.mute()
            }),
        )
    }
}

/** *A group heading. It is a link to the group's overview page. */
fn Group(title: string, href: string) -> Node {
    let path = router.path_signal()
    fn active() -> bool {
        return path.get() == href
    }
    return zeus.Box(
        style = Style(
            width = pct(100),
            height = px(30),
            direction = Direction.Row,
            align = Align.Center,
            paddingX = 10,
            marginTop = 12,
            radius = 6,
            cursor = "pointer",
            background = if active() { colors.raised() } else { "" },
        ),
        hoverStyle = fn() -> Style {
            return Style(background = colors.raised())
        },
        on_click = fn() => go(href),
        href = href,
        role = "link",
        label = title,
    ) {
        zeus.Text(title, style = Style(font = spacing.FONT_CONTROL, color = zeus.ink()))
    }
}

fn Sidebar() -> Node {
    return zeus.Box(style = Style(
        width = px(200),
        shrink = 0,
        direction = Direction.Column,
        gap = 2,
    )) {
        Group("Language", "/language")
        SideLink("Ownership", "/language/ownership")
        SideLink("Control flow", "/language/control")
        SideLink("Errors", "/language/errors")
        SideLink("Modules", "/language/modules")
        SideLink("Functions", "/language/functions")
        Group("Types", "/types")
        SideLink("Numbers", "/types/numbers")
        SideLink("Aggregates", "/types/aggregates")
        SideLink("Text", "/types/text")
        SideLink("Memory", "/types/memory")
        Group("Zeus", "/zeus")
        SideLink("Signals", "/zeus/signals")
        SideLink("Views", "/zeus/views")
        SideLink("Routing", "/zeus/routing")
        SideLink("Hosts", "/zeus/hosts")
        Group("Tooling", "/tooling")
        SideLink("Formatter", "/tooling/fmt")
        SideLink("Tests", "/tooling/tests")
        Group("Components", "/components")
        SideLink("Forms", "/components/forms")
        SideLink("Dashboards", "/components/charts")
        SideLink("Data display", "/components/data")
        SideLink("Navigation", "/components/navigation")
        SideLink("Overlays", "/components/overlays")
        Group("Playground", "/playground")
    }
}

/** *The sidebar in a drawer from the start edge, for narrow screens. Every */
/** *link closes it; so do Escape and a tap outside. */
fn MenuDrawer() -> Node {
    return zui.Drawer(menu_open, side = Side.SideStart, size = 280) {
        zeus.Box(style = Style(
            direction = Direction.Column,
            gap = 8,
            width = pct(100),
            grow = 1,
            minHeight = 0,
        )) {
            zeus.Box(style = Style(direction = Direction.Row, align = Align.Center, width = pct(100))) {
                Brand()
                zui.Grow()
                zui.IconButton(
                    CLOSE_ICON,
                    zeus.Look.Ghost,
                    Size.Md,
                    "Close navigation",
                    on_click = fn() => menu_open.set(false),
                )
            }
            zui.Separator()
            zui.Scroll(style = Style(direction = Direction.Column, grow = 1, minHeight = 0, width = pct(100))) {
                SideLink("Home", "/")
                Sidebar()
            }
        }
    }
}

fn Footer() -> Node {
    return zeus.Box(style = Style(
        direction = Direction.Column,
        gap = 14,
        width = pct(100),
        marginTop = 64,
    )) {
        zui.Separator()
        zeus.Box(style = Style(
            direction = Direction.Row,
            align = Align.Center,
            gap = 16,
            wrap = true,
            width = pct(100),
        )) {
            zeus.Text(
                "Loam. This site is a Loam program, compiled to WebAssembly and drawn by Zeus.",
                style = Style(font = spacing.FONT_CONTROL, color = colors.mute(), wrap = true),
            )
            zui.Link(
                "View the source on GitHub",
                fn() => zeus.open_external(GITHUB_URL),
                external = true,
                font = spacing.FONT_CONTROL,
            )
            zeus.Box(style = Style(grow = 1))
            zui.IconButton(
                DOOR_ICON,
                zeus.Look.Ghost,
                zeus.Size.Sm,
                "Site analytics",
                on_click = fn() => go("/vault"),
            )
        }
        zeus.Text(
            "This site counts visits with a random id stored in your browser. It keeps no addresses, and honours Global Privacy Control.",
            style = Style(font = spacing.FONT_CONTROL, color = colors.mute(), wrap = true),
        )
    }
}
