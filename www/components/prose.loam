//! Shared reading layout: a code block and a section stack.

import "zeus"
import "zui"
import "highlight.loam" as highlight

/// Space between the sections of a page.
const SECTION_GAP: int = 48
/// Space inside a page header: overline, title, lead.
const HEAD_GAP: int = 12
/// Space inside a section: its header and its blocks.
const BLOCK_GAP: int = 16

fn CodeBlock(lines: []string) -> Node {
    return highlight.Block(lines)
}

fn Stack() -> Node {
    return zui.Column(Space.Sm)
}

/// Join three strings. Used when a sample must show the characters `{{`,
/// which a normal string would treat as interpolation.
fn join3(a: string, b: string, c: string) -> string {
    return "{{a}}{{b}}{{c}}"
}
