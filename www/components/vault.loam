//! The owner's analytics. The door in the footer leads here.
//!
//! The password is checked by the server, never here: everything in this module
//! downloads to every visitor who opens the page, so it holds no secret and shows
//! only what `/api/stats` agrees to return.

import "std:analytics"
import "std:colors"
import "std:fmt"
import "std:http"
import "std:json"
import "std:spacing"
import "std:str"
import "std:zeus"
import "std:zui"
import "shell.loam" as shell

const CHECKING: int = 0
const SIGN_IN: int = 1
const REPORT: int = 2
const FAILED: int = 3

const SIGN_IN_W: int = 380
const CHART_H: int = 216

struct Line {
    cells: []string,
}

struct Report {
    visitors: int,
    page_views: int,
    unique_page_visits: int,
    clicks: int,
    sessions: int,
    bounces: int,
    avg_session_ms: int,
    screens: string,
}

let view = zeus.signal(CHECKING)
let email = zeus.signal("")
let password = zeus.signal("")
let sign_in_error = zeus.signal("")
let failure = zeus.signal("")
let busy = zeus.signal(false)
let range = zeus.signal(1)
let report = zeus.signal(Report {
    visitors: 0,
    page_views: 0,
    unique_page_visits: 0,
    clicks: 0,
    sessions: 0,
    bounces: 0,
    avg_session_ms: 0,
    screens: "",
})
let traffic = zeus.signal(ChartData {
    labels: []string { "" },
    names: []string { "Page views", "Visitors" },
    vals: []int { 0, 0 },
})
let lengths = zeus.signal(ChartData {
    labels: []string { "" },
    names: []string { "Sessions" },
    vals: []int { 0 },
})
let pages = zeus.signal([]Line {})
let entries = zeus.signal([]Line {})
let exits = zeus.signal([]Line {})
let clicks = zeus.signal([]Line {})
let events = zeus.signal([]Line {})
let referrers = zeus.signal([]Line {})

/// Replies to an older request are dropped: the range can change mid-flight.
let mut asked = 0

fn range_days(i: int) -> int {
    if i == 0 {
        return 7
    }
    if i == 1 {
        return 30
    }
    return 90
}

fn int_at(doc: JsonDoc, id: int, key: string) -> int {
    let f = json.field(doc.nodes, id, key, key)
    if f.ok != 1 {
        return 0
    }
    let n = json.as_int(doc.nodes, f.id, key)
    if n.ok != 1 {
        return 0
    }
    return int(n.n)
}

fn str_at(doc: JsonDoc, id: int, key: string) -> string {
    let f = json.field(doc.nodes, id, key, key)
    if f.ok != 1 {
        return ""
    }
    let s = json.as_str(doc.nodes, f.id, key)
    if s.ok != 1 {
        return ""
    }
    return s.s
}

/// The rows at `key`, as `Line`s. `text` columns print as they are, and `nums`
/// and `times` as counts and durations.
fn lines_at(doc: JsonDoc, key: string, text: []string, nums: []string, times: []string) -> []Line {
    let mut out = []Line {}
    let list = json.field(doc.nodes, doc.root, key, key)
    if list.ok != 1 {
        return out
    }
    for i in 0..json.child_count(doc.nodes, list.id) {
        let row = json.index(doc.nodes, list.id, i, key)
        let mut cells = []string {}
        for t in 0..text.len {
            push(cells, str_at(doc, row.id, text[t]))
        }
        for n in 0..nums.len {
            push(cells, "{{int_at(doc, row.id, nums[n])}}")
        }
        for d in 0..times.len {
            push(cells, duration(int_at(doc, row.id, times[d])))
        }
        push(out, Line { cells: cells })
    }
    return out
}

fn duration(ms: int) -> string {
    let s = ms / 1000
    if s < 60 {
        return "{{s}}s"
    }
    return "{{s / 60}}m {{s % 60}}s"
}

fn percent(part: int, whole: int) -> string {
    if whole == 0 {
        return "0%"
    }
    return "{{part * 100 / whole}}%"
}

fn parse_report(doc: JsonDoc) {
    let mut days = []string {}
    let mut daily = []int {}
    let series = json.field(doc.nodes, doc.root, "daily", "daily")
    if series.ok == 1 {
        for i in 0..json.child_count(doc.nodes, series.id) {
            let d = json.index(doc.nodes, series.id, i, "daily")
            // Month and day of YYYY-MM-DD.
            let name = str_at(doc, d.id, "day")
            push(days, str.slice(name, 5, name.len))
            push(daily, int_at(doc, d.id, "page_views"))
            push(daily, int_at(doc, d.id, "visitors"))
        }
    }
    let mut leaving = []int {}
    let left = json.field(doc.nodes, doc.root, "leaving", "leaving")
    if left.ok == 1 {
        let keys = []string { "under_10s", "under_30s", "under_1m", "under_5m", "over_5m" }
        for i in 0..keys.len {
            push(leaving, int_at(doc, left.id, keys[i]))
        }
    }
    let mut screens = ""
    let s = json.field(doc.nodes, doc.root, "screens", "screens")
    if s.ok == 1 {
        let phone = int_at(doc, s.id, "phone")
        let tablet = int_at(doc, s.id, "tablet")
        let desktop = int_at(doc, s.id, "desktop")
        screens = "{{phone}} phone, {{tablet}} tablet, {{desktop}} desktop"
    }
    let root = doc.root
    report.set(Report {
        visitors: int_at(doc, root, "visitors"),
        page_views: int_at(doc, root, "page_views"),
        unique_page_visits: int_at(doc, root, "unique_page_visits"),
        clicks: int_at(doc, root, "clicks"),
        sessions: int_at(doc, root, "sessions"),
        bounces: int_at(doc, root, "bounces"),
        avg_session_ms: int_at(doc, root, "avg_session_ms"),
        screens: screens,
    })
    traffic.set(ChartData {
        labels: days,
        names: []string { "Page views", "Visitors" },
        vals: daily,
    })
    lengths.set(ChartData {
        labels: []string { "Under 10s", "10-30s", "30-60s", "1-5m", "Over 5m" },
        names: []string { "Sessions" },
        vals: leaving,
    })
    let none = []string {}
    pages.set(lines_at(doc, "pages", []string { "path" }, []string { "views", "visitors" }, []string { "avg_ms" }))
    entries.set(lines_at(doc, "entries", []string { "path" }, []string { "sessions" }, none))
    exits.set(lines_at(doc, "exits", []string { "path" }, []string { "sessions" }, none))
    clicks.set(lines_at(doc, "clicks_top", []string { "name" }, []string { "count" }, none))
    events.set(lines_at(doc, "events_top", []string { "name", "data" }, []string { "count" }, none))
    referrers.set(lines_at(doc, "referrers", []string { "ref" }, []string { "sessions" }, none))
}

fn fail(text: string) {
    failure.set(text)
    view.set(FAILED)
}

fn load() {
    asked = asked + 1
    let mine = asked
    http.post_async("/api/stats?days={{range_days(range.peek())}}", "", fn(status: int, body: string) {
        if mine != asked {
            return
        }
        if status == 401 {
            view.set(SIGN_IN)
        } else if status != 200 {
            fail("The analytics service did not answer. Try again in a moment.")
        } else {
            let doc = json.parse(body)
            if doc.ok != 1 {
                fail("The report came back unreadable.")
            } else {
                parse_report(doc)
                // Whoever can sign in stays out of their own numbers.
                analytics.opt_out()
                view.set(REPORT)
            }
        }
    })
}

fn sign_in() {
    if busy.peek() {
        return
    }
    busy.set(true)
    sign_in_error.set("")
    json.enc_obj_begin()
    json.enc_key("email")
    json.enc_str(email.peek())
    json.enc_key("password")
    json.enc_str(password.peek())
    json.enc_obj_end()
    http.post_async("/api/login", json.enc_take(), fn(status: int, body: string) {
        busy.set(false)
        password.set("")
        if status == 200 {
            load()
        } else if status == 401 {
            sign_in_error.set("That email and password do not match.")
        } else if status == 429 {
            sign_in_error.set("Too many tries. Wait 15 minutes and try again.")
        } else {
            sign_in_error.set("Sign in is not available right now.")
        }
    })
}

fn sign_out() {
    http.post_async("/api/logout", "", fn(status: int, body: string) {
        view.set(SIGN_IN)
    })
}

fn SignIn() -> Node {
    fn submit(text: string) {
        sign_in()
    }
    return zeus.Box(style = Style(
        direction = Direction.Column,
        gap = 16,
        width = pct(100),
        maxWidth = SIGN_IN_W,
    )) {
        zui.Heading("Vault")
        zui.FormField("Email") {
            zui.TextInput(email, "you@example.com", on_submit = submit)
        }
        zui.FormField("Password") {
            zui.PasswordInput(password, placeholder = "Password", on_submit = submit)
        }
        zui.Show(when = sign_in_error.get().len > 0) {
            zui.Alert("Could not sign in", sign_in_error.get(), tint = zeus.Tint.Danger)
        }
        zui.Button("Sign in", loading = busy, on_click = sign_in)
    }
}

fn line_cells(line: Line) -> []string {
    return line.cells
}

fn Ranking(title: string, cols: []string, rows: Signal<[]Line>) -> Node {
    let mut spec = []TableCol {}
    for i in 0..cols.len {
        push(spec, TableCol { title: cols[i], width: 0 })
    }
    return zeus.Box(style = Style(direction = Direction.Column, gap = 8, width = pct(100))) {
        zui.Title(title)
        zui.Show(when = rows.get().len > 0) {
            zui.Table(spec, rows, line_cells)
        }
        zui.Show(when = rows.get().len == 0) {
            zeus.Text("None yet.", style = Style(font = spacing.FONT_CONTROL, color = colors.mute()))
        }
    }
}

fn Dashboard() -> Node {
    return zeus.Box(style = Style(direction = Direction.Column, gap = 32, width = pct(100))) {
        zeus.Box(style = Style(
            direction = Direction.Row,
            align = Align.Center,
            gap = 16,
            wrap = true,
            width = pct(100),
        )) {
            zui.Heading("Site analytics")
            zeus.Box(style = Style(grow = 1))
            zui.Segmented(range, []string { "7 days", "30 days", "90 days" })
            zui.Button("Sign out", look = zeus.Look.Ghost, on_click = sign_out)
        }
        zui.Grid(config = GridConfig(columns = 3, autoColumns = 220, gap = Space.Sm)) {
            zui.Stat("Unique visitors", "{{report.get().visitors}}", zeus.Tint.Ink)
            zui.Stat("Page views", "{{report.get().page_views}}", zeus.Tint.Ink)
            zui.Stat("Unique page visits", "{{report.get().unique_page_visits}}", zeus.Tint.Ink)
            zui.Stat("Bounce rate", percent(report.get().bounces, report.get().sessions), zeus.Tint.Ink)
            zui.Stat("Average visit", duration(report.get().avg_session_ms), zeus.Tint.Ink)
            zui.Stat("Clicks", "{{report.get().clicks}}", zeus.Tint.Ink)
        }
        zeus.Box(style = Style(direction = Direction.Column, gap = 8, width = pct(100))) {
            zui.Title("Traffic by day")
            zui.LineChartOf(traffic, shell.content_w(), CHART_H, labelEvery = 0, dots = false)
        }
        zeus.Box(style = Style(direction = Direction.Column, gap = 8, width = pct(100))) {
            zui.Title("How long visits last")
            zui.BarChartOf(lengths, shell.content_w(), CHART_H)
        }
        Ranking("Pages", []string { "Page", "Views", "Visitors", "Average time" }, pages)
        Ranking("Where visits start", []string { "Page", "Sessions" }, entries)
        Ranking("Where visits end", []string { "Page", "Sessions" }, exits)
        Ranking("Clicks", []string { "Control", "Clicks" }, clicks)
        Ranking("Events", []string { "Event", "Detail", "Count" }, events)
        Ranking("Sites that sent visitors", []string { "Site", "Sessions" }, referrers)
        zeus.Text(
            "Screens: {{report.get().screens}}. Times are visible time only.",
            style = Style(font = spacing.FONT_CONTROL, color = colors.mute(), wrap = true),
        )
    }
}

fn Vault() -> Node {
    // The first run asks whether this browser is signed in; later ones follow
    // the range.
    zeus.effect(fn() {
        range.get()
        load()
    })
    return zeus.Box(style = Style(direction = Direction.Column, width = pct(100))) {
        zui.Show(when = view.get() == CHECKING) {
            zui.Spinner()
        }
        zui.Show(when = view.get() == SIGN_IN) {
            SignIn()
        }
        zui.Show(when = view.get() == REPORT) {
            Dashboard()
        }
        zui.Show(when = view.get() == FAILED) {
            zui.Alert("Analytics unavailable", failure.get(), tint = zeus.Tint.Danger)
        }
    }
}
