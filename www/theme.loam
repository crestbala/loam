//! Theme tokens. Widgets resolve each role per appearance at paint time.

import "zeus"

fn install() {
    zeus.theme(ROLE.Accent, 0x1F4B3A, 0x8FBF9F)
    zeus.theme(ROLE.AccentSoft, 0xE5F2EA, 0x1E3328)
    zeus.theme(ROLE.Paper, 0xF6F7F9, 0x0B0C0F)
    zeus.theme(ROLE.Ink, 0x15181D, 0xECEEF2)
    zeus.theme(ROLE.Mute, 0x545A65, 0xADB4BF)
    zeus.theme(ROLE.Plate, 0xFFFFFF, 0x14161B)
    zeus.theme(ROLE.Raised, 0xEFF1F4, 0x1C1F25)
    zeus.theme(ROLE.Rule, 0xE0E3E8, 0x31353E)
}
