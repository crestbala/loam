{
  "name": "loam",
  "displayName": "Loam",
  "description": "Loam language: syntax highlighting and IntelliSense via loam-lsp",
  "version": "0.1.0",
  "publisher": "loam",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": [
    "onLanguage:loam",
    "workspaceContains:**/*.loam",
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "loam",
        "aliases": ["Loam", "loam"],
        "extensions": [".loam", ".loa"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "loam",
        "scopeName": "source.loam",
        "path": "./syntaxes/loam.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Loam",
      "properties": {
        "loam.lspPath": {
          "type": "string",
          "default": "",
          "description": "Path to loam-lsp. Empty walks up from the workspace to bin/loam-lsp, then PATH."
        }
      }
    }
  }
}
