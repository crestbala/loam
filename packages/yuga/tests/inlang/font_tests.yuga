// In-language tests for `std:font` (TrueType table parsing + metrics).
//
// Fixture: `packages/yuga/tests/fonts/tiny.ttf`, generated by the
// `make_tiny_font.py` beside it. The font is deliberately tiny — unitsPerEm
// 1000, eight glyphs — so at px = 1000 pixel advances equal design units and
// the expected numbers are obvious.

import "std:test"
import "std:sys"
import "std:font"

const FONT_PATH: string = "packages/yuga/tests/fonts/tiny.ttf"

fn font_bytes() -> string {
    return sys.read_file(FONT_PATH)
}

fn bytes(xs: []int) -> string {
    return string_from_bytes(xs)
}

/// Offset of the `cmap` subtable whose format is `fmt`, or -1.
fn subtable(s: string, fmt: int) -> int {
    let c = font.table_offset(s, "cmap")
    let n = font.read_u16_be(s, c + 2)
    let mut i = 0
    while i < n {
        let rec = c + 4 + i * 8
        let off = c + font.read_u32_be(s, rec + 4)
        if font.read_u16_be(s, off) == fmt {
            return off
        }
        i = i + 1
    }
    return -1
}

#[test]
fn test_tables() {
    let s = font_bytes()
    test.assert(s.len > 0)
    test.assert_eq_int(font.units_per_em(s), 1000)
    test.assert_eq_int(font.num_glyphs(s), 8)
    test.assert_eq_int(font.ascender(s), 800)
    test.assert_eq_int(font.descender(s), -200)
    test.assert_eq_int(font.line_gap(s), 200)
    test.assert_eq_int(font.num_hmetrics(s), 8)
    test.assert(font.table_offset(s, "hmtx") > 0)
    test.assert_eq_int(font.table_offset(s, "zzzz"), -1)
    // A font that is not a font reads as empty, not as a trap.
    test.assert_eq_int(font.units_per_em("nope"), 0)
    test.assert_eq_int(font.num_glyphs("nope"), 0)
}

#[test]
fn test_cmap4_direct() {
    let s = font_bytes()
    let sub = subtable(s, 4)
    test.assert(sub > 0)
    test.assert_eq_int(font.cmap4(s, sub, 0x41), 1) // A via glyphIdArray
    test.assert_eq_int(font.cmap4(s, sub, 0x42), 2)
    test.assert_eq_int(font.cmap4(s, sub, 0x43), 3)
    test.assert_eq_int(font.cmap4(s, sub, 0x20), 4) // space via idDelta
    test.assert_eq_int(font.cmap4(s, sub, 0xE9), 5) // é via idDelta
    test.assert_eq_int(font.cmap4(s, sub, 0x5A), 0) // 'Z' unmapped
    test.assert_eq_int(font.cmap4(s, sub, 0x1F600), 0) // non-BMP not in format 4
}

#[test]
fn test_cmap12_and_glyph_index() {
    let s = font_bytes()
    let sub = subtable(s, 12)
    test.assert(sub > 0)
    test.assert_eq_int(font.cmap12(s, sub, 0x41), 1)
    test.assert_eq_int(font.cmap12(s, sub, 0x1F600), 6) // non-BMP
    test.assert_eq_int(font.cmap12(s, sub, 0x2603), 0) // unmapped
    // `cmap_best` prefers the (3,10) format 12 subtable.
    test.assert_eq_int(font.cmap_best(s), sub)
    test.assert_eq_int(font.glyph_index(s, 0x41), 1)
    test.assert_eq_int(font.glyph_index(s, 0xE9), 5)
    test.assert_eq_int(font.glyph_index(s, 0x1F600), 6)
    test.assert_eq_int(font.glyph_index(s, 0x5A), 0)
}

#[test]
fn test_advances() {
    let s = font_bytes()
    test.assert_eq_int(font.advance_units(s, 0), 500)
    test.assert_eq_int(font.advance_units(s, 1), 600)
    test.assert_eq_int(font.advance_units(s, 4), 250)
    test.assert_eq_int(font.advance_units(s, 6), 1000)
    // gid clamps into hmtx's range.
    test.assert_eq_int(font.advance_units(s, 99), 500)
    test.assert_eq_int(font.advance_units(s, -3), 500)
    test.assert_eq_int(font.advance_px(s, 1, 100), 60)
    test.assert_eq_int(font.advance_px(s, 4, 100), 25)
}

#[test]
fn test_text_width() {
    let s = font_bytes()
    // px == unitsPerEm, so widths equal design units.
    test.assert_eq_int(font.text_width(s, 1000, "AB"), 1200)
    test.assert_eq_int(font.text_width(s, 1000, "A B"), 1450)
    test.assert_eq_int(font.text_width(s, 1000, "é"), 500)
    test.assert_eq_int(font.text_width(s, 1000, "Z"), 500) // .notdef advance
    test.assert_eq_int(font.text_width(s, 1000, ""), 0)
    // A cluster carries the width of its base glyph; the combining U+0301 is
    // part of the same cluster, not a second advance.
    test.assert_eq_int(font.text_width(s, 1000, bytes([]int { 0x41, 0xCC, 0x81 })), 600)
    test.assert_eq_int(font.text_width(s, 100, "AB"), 120)
    // Non-BMP code point resolves through cmap format 12.
    test.assert_eq_int(font.text_width(s, 1000, bytes([]int { 0xF0, 0x9F, 0x98, 0x80 })), 1000)
}

#[test]
fn test_line_height() {
    let s = font_bytes()
    // (800 - -200 + 200) / 1000 = 1.2em.
    test.assert_eq_int(font.line_height(s, 1000), 1200)
    test.assert_eq_int(font.line_height(s, 16), 19)
    // A font with no tables falls back to the pixel size.
    test.assert_eq_int(font.line_height("", 16), 16)
}

#[test]
fn test_glyph_run() {
    let s = font_bytes()
    // px == unitsPerEm, so pen positions equal design units.
    let run = font.glyph_run(s, 1000, "A A")
    test.assert_eq_int(run.len, 3)
    test.assert_eq_int(run[0].id, 1)   // A
    test.assert_eq_int(run[0].x, 0)
    test.assert_eq_int(run[1].id, 4)   // space
    test.assert_eq_int(run[1].x, 600)
    test.assert_eq_int(run[2].id, 1)
    test.assert_eq_int(run[2].x, 850)
    // A combining mark stays in its base cluster, so it is not a second glyph.
    let cl = font.glyph_run(s, 1000, bytes([]int { 0x41, 0xCC, 0x81 }))
    test.assert_eq_int(cl.len, 1)
    // An unmapped code point still gets a run slot (.notdef, gid 0).
    let nd = font.glyph_run(s, 1000, "Z")
    test.assert_eq_int(nd.len, 1)
    test.assert_eq_int(nd[0].id, 0)
}

#[test]
fn test_measure() {
    let s = font_bytes()
    let mut w = 0
    let mut h = 0
    font.measure(s, 1000, "AB", &mut w, &mut h)
    test.assert_eq_int(w, 1200)
    test.assert_eq_int(h, 1200)
}

#[test]
fn test_measure_wrap() {
    let s = font_bytes()
    let mut w = 0
    let mut h = 0
    // "AB AB" at 1300px breaks between the words; the broken-on space is not
    // carried to the start of the next line.
    font.measure_wrap(s, 1000, "AB AB", 1300, &mut w, &mut h)
    test.assert_eq_int(w, 1200)
    test.assert_eq_int(h, 2400)
    // A newline is a hard break.
    font.measure_wrap(s, 1000, "A\nB", 10000, &mut w, &mut h)
    test.assert_eq_int(w, 600)
    test.assert_eq_int(h, 2400)
    // max_w <= 0 means "do not wrap".
    font.measure_wrap(s, 1000, "AB AB", 0, &mut w, &mut h)
    test.assert_eq_int(w, 2650)
    test.assert_eq_int(h, 1200)
    // Nothing to wrap.
    font.measure_wrap(s, 1000, "", 100, &mut w, &mut h)
    test.assert_eq_int(w, 0)
    test.assert_eq_int(h, 1200)
}
