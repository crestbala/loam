// Phase 19 animation: `zeus.animate` tweens a signal per frame and keeps the
// frame loop alive until it settles (§2.8).

import "std:fmt"
import "std:sys"
import "std:zeus"

fn must(ok: bool, what: string) {
    if !ok {
        fmt.println("FAIL", what)
        sys.exit(1)
    }
}

fn main() {
    let s = zeus.signal(0)
    zeus.animate(s, 100, 160) // 10 frames
    must(s.get() == 0, "starts at the from value")

    let mut i = 0
    while i < 5 {
        zeus.engine_step()
        i = i + 1
    }
    let mid = s.get()
    must(mid > 0, "moves off the floor")
    must(mid < 100, "not there yet")

    i = 0
    while i < 8 {
        zeus.engine_step()
        i = i + 1
    }
    must(s.get() == 100, "settles exactly on the target")

    // Retarget mid-flight, then a zero-duration jump.
    zeus.animate(s, 0, 160)
    zeus.engine_step()
    must(s.get() > 0 && s.get() < 100, "retargets in flight")
    zeus.animate(s, 7, 0)
    must(s.get() == 7, "zero ms jumps")

    fmt.println("anim ok")
}
