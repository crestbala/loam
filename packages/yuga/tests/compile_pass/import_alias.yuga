// `import "path.yuga" as name` gives two files with the same stem distinct
// aliases — file-system routing imports many `page.yuga`.

import "std:fmt"
import "std:sys"
import "../mod/left/page.yuga" as lpage
import "../mod/right/page.yuga" as rpage

fn main() {
    if lpage.who() != "left" {
        fmt.println("FAIL left")
        sys.exit(1)
    }
    if rpage.who() != "right" {
        fmt.println("FAIL right")
        sys.exit(1)
    }
    fmt.println("import alias ok")
}
