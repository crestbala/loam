//! json — a JSON codec: parse, stringify, and path-aware access.
//!
//! One document is live at a time: `parse` fills a module-global node pool and
//! returns a `JsonDoc` carrying `root` (an index into the pool) plus any error.
//! The pool is deliberately **not** returned by value — a `[]Json` (slice of
//! structs that themselves hold slices) copied around by value corrupts in the
//! current compiler, so the tree lives in a global and accessors read it there.
//!
//! Errors never trap: `parse` sets `ok == 0` with a message and byte offset,
//! and the accessors return a small result naming the **field path** that
//! failed (missing key, wrong type, integer out of range). Parsing enforces a
//! nesting-depth limit, so a deeply nested document is an error, not a stack
//! overflow.
//!
//! ```
//! import "std:json"
//! let d = json.parse(text)
//! if d.ok == 0 { fmt.println("bad json:", d.err); }
//! let name = json.field(d.root, "name", "user.name")
//! if name.ok == 1 { let s = json.as_str(name.id, "user.name") }
//! ```

import "std:fmt"

enum JSON_KIND {
    Null = 0,
    Bool = 1,
    Num = 2,
    Str = 3,
    Arr = 4,
    Obj = 5,
}

/// One node. `num` keeps the raw number text so integer range is checked
/// exactly at conversion time; `keys[i]` is the key for object child `kids[i]`.
struct Json {
    kind: int,
    b: bool,
    num: string,
    s: string,
    kids: []int,
    keys: []string,
}

/// The result of `parse`. `root` indexes the live node pool.
struct JsonDoc {
    ok: int,
    err: string,
    at: int,
    root: int,
}

struct JVal {
    ok: int,
    id: int,
    err: string,
}

struct JInt {
    ok: int,
    n: i64,
    err: string,
}

struct JStr {
    ok: int,
    s: string,
    err: string,
}

struct JBool {
    ok: int,
    b: bool,
    err: string,
}

/// Nesting limit: deeper than this is an error (defeats nesting bombs).
const JSON_MAX_DEPTH: int = 64

const I64_MAX: i64 = 9223372036854775807

// --- parse state + node pool (one document at a time) ---

let mut P_text: string = ""
let mut P_i: int = 0
let mut P_at: int = 0
let mut P_ok: int = 1
let mut P_err: string = ""
let mut P_nodes: []Json = []Json {}

fn jerr(msg: string, at: int) {
    if P_ok == 1 {
        P_ok = 0
        P_err = msg
        P_at = at
    }
}

fn jcat(a: string, b: string) -> string {
    let mut out = []int {}
    let mut i = 0
    while i < a.len {
        push(out, a[i])
        i = i + 1
    }
    i = 0
    while i < b.len {
        push(out, b[i])
        i = i + 1
    }
    return string_from_bytes(out)
}

fn jsub(s: string, a: int, b: int) -> string {
    let mut out = []int {}
    let mut i = a
    while i < b {
        push(out, s[i])
        i = i + 1
    }
    return string_from_bytes(out)
}

fn jpush(j: Json) -> int {
    push(P_nodes, j)
    return P_nodes.len - 1
}

fn jnull() -> Json {
    return Json { kind: 0, b: false, num: "", s: "", kids: []int {}, keys: []string {} }
}

fn jws(c: int) -> int {
    if c == 32 {
        return 1
    }
    if c == 9 {
        return 1
    }
    if c == 10 {
        return 1
    }
    if c == 13 {
        return 1
    }
    return 0
}

fn jskipws() {
    while P_i < P_text.len {
        if jws(P_text[P_i]) == 0 {
            break
        }
        P_i = P_i + 1
    }
}

fn jhex(c: int) -> int {
    if c >= 48 {
        if c <= 57 {
            return c - 48
        }
    }
    if c >= 97 {
        if c <= 102 {
            return c - 97 + 10
        }
    }
    if c >= 65 {
        if c <= 70 {
            return c - 65 + 10
        }
    }
    return -1
}

fn jutf8(out: &mut []int, cp: int) {
    if cp < 128 {
        push(out, cp)
    } else if cp < 2048 {
        push(out, 192 + cp / 64)
        push(out, 128 + cp % 64)
    } else if cp < 65536 {
        push(out, 224 + cp / 4096)
        push(out, 128 + (cp / 64) % 64)
        push(out, 128 + cp % 64)
    } else {
        push(out, 240 + cp / 262144)
        push(out, 128 + (cp / 4096) % 64)
        push(out, 128 + (cp / 64) % 64)
        push(out, 128 + cp % 64)
    }
}

fn jstring() -> string {
    P_i = P_i + 1
    let mut out = []int {}
    while P_i < P_text.len {
        let c = P_text[P_i]
        if c == 34 {
            P_i = P_i + 1
            return string_from_bytes(out)
        }
        if c == 92 {
            P_i = P_i + 1
            if P_i >= P_text.len {
                jerr("unterminated escape", P_i)
                return string_from_bytes(out)
            }
            let e = P_text[P_i]
            P_i = P_i + 1
            if e == 34 {
                push(out, 34)
            } else if e == 92 {
                push(out, 92)
            } else if e == 47 {
                push(out, 47)
            } else if e == 98 {
                push(out, 8)
            } else if e == 102 {
                push(out, 12)
            } else if e == 110 {
                push(out, 10)
            } else if e == 114 {
                push(out, 13)
            } else if e == 116 {
                push(out, 9)
            } else if e == 117 {
                let mut cp = 0
                let mut k = 0
                while k < 4 {
                    if P_i >= P_text.len {
                        jerr("bad \\u escape", P_i)
                        return string_from_bytes(out)
                    }
                    let h = jhex(P_text[P_i])
                    if h < 0 {
                        jerr("bad \\u escape", P_i)
                        return string_from_bytes(out)
                    }
                    cp = cp * 16 + h
                    P_i = P_i + 1
                    k = k + 1
                }
                jutf8(&mut out, cp)
            } else {
                jerr("unknown escape", P_i)
                return string_from_bytes(out)
            }
            continue
        }
        push(out, c)
        P_i = P_i + 1
    }
    jerr("unterminated string", P_i)
    return string_from_bytes(out)
}

fn jnumber() -> Json {
    let start = P_i
    if P_i < P_text.len {
        if P_text[P_i] == 45 {
            P_i = P_i + 1
        }
    }
    let mut digits = 0
    while P_i < P_text.len {
        let c = P_text[P_i]
        if c < 48 {
            break
        }
        if c > 57 {
            break
        }
        P_i = P_i + 1
        digits = digits + 1
    }
    if digits == 0 {
        jerr("invalid number", start)
        return jnull()
    }
    if P_i < P_text.len {
        if P_text[P_i] == 46 {
            P_i = P_i + 1
            let mut f = 0
            while P_i < P_text.len {
                let c = P_text[P_i]
                if c < 48 {
                    break
                }
                if c > 57 {
                    break
                }
                P_i = P_i + 1
                f = f + 1
            }
            if f == 0 {
                jerr("invalid fraction", P_i)
                return jnull()
            }
        }
    }
    if P_i < P_text.len {
        if P_text[P_i] == 101 {
            P_i = P_i + 1
            if P_i < P_text.len {
                if P_text[P_i] == 43 {
                    P_i = P_i + 1
                } else if P_text[P_i] == 45 {
                    P_i = P_i + 1
                }
            }
            let mut e = 0
            while P_i < P_text.len {
                let c = P_text[P_i]
                if c < 48 {
                    break
                }
                if c > 57 {
                    break
                }
                P_i = P_i + 1
                e = e + 1
            }
            if e == 0 {
                jerr("invalid exponent", P_i)
                return jnull()
            }
        }
    }
    let mut j = jnull()
    j.kind = 2
    j.num = jsub(P_text, start, P_i)
    return j
}

fn jliteral(word: string, b: bool, kind: int) -> int {
    let mut k = 0
    while k < word.len {
        if P_i >= P_text.len {
            jerr("unexpected end of input", P_i)
            return 0
        }
        if P_text[P_i] != word[k] {
            jerr("invalid literal", P_i)
            return 0
        }
        P_i = P_i + 1
        k = k + 1
    }
    let mut j = jnull()
    j.kind = kind
    j.b = b
    return jpush(j)
}

fn jvalue(depth: int) -> int {
    if P_ok == 0 {
        return 0
    }
    if depth > JSON_MAX_DEPTH {
        jerr("nesting too deep", P_i)
        return 0
    }
    jskipws()
    if P_i >= P_text.len {
        jerr("unexpected end of input", P_i)
        return 0
    }
    let c = P_text[P_i]
    if c == 123 {
        return jobject(depth)
    }
    if c == 91 {
        return jarray(depth)
    }
    if c == 34 {
        let mut j = jnull()
        j.kind = 3
        j.s = jstring()
        return jpush(j)
    }
    if c == 116 {
        return jliteral("true", true, 1)
    }
    if c == 102 {
        return jliteral("false", false, 1)
    }
    if c == 110 {
        let word = "null"
        let mut k = 0
        while k < 4 {
            if P_i >= P_text.len {
                jerr("unexpected end of input", P_i)
                return 0
            }
            if P_text[P_i] != word[k] {
                jerr("invalid literal", P_i)
                return 0
            }
            P_i = P_i + 1
            k = k + 1
        }
        return jpush(jnull())
    }
    if c == 45 {
        return jpush(jnumber())
    }
    if c >= 48 {
        if c <= 57 {
            return jpush(jnumber())
        }
    }
    jerr("unexpected character", P_i)
    return 0
}

fn jarray(depth: int) -> int {
    P_i = P_i + 1
    let mut kids = []int {}
    jskipws()
    if P_i < P_text.len {
        if P_text[P_i] == 93 {
            P_i = P_i + 1
            let mut j = jnull()
            j.kind = 4
            j.kids = kids
            return jpush(j)
        }
    }
    while P_ok == 1 {
        let id = jvalue(depth + 1)
        if P_ok == 0 {
            break
        }
        push(kids, id)
        jskipws()
        if P_i >= P_text.len {
            jerr("unexpected end of array", P_i)
            break
        }
        if P_text[P_i] == 44 {
            P_i = P_i + 1
            continue
        }
        if P_text[P_i] == 93 {
            P_i = P_i + 1
            break
        }
        jerr("expected , or ] in array", P_i)
        break
    }
    let mut j = jnull()
    j.kind = 4
    j.kids = kids
    return jpush(j)
}

fn jobject(depth: int) -> int {
    P_i = P_i + 1
    let mut keys = []string {}
    let mut kids = []int {}
    jskipws()
    if P_i < P_text.len {
        if P_text[P_i] == 125 {
            P_i = P_i + 1
            let mut j = jnull()
            j.kind = 5
            j.keys = keys
            j.kids = kids
            return jpush(j)
        }
    }
    while P_ok == 1 {
        jskipws()
        if P_i >= P_text.len {
            jerr("unexpected end of object", P_i)
            break
        }
        if P_text[P_i] != 34 {
            jerr("expected string key", P_i)
            break
        }
        let k = jstring()
        if P_ok == 0 {
            break
        }
        jskipws()
        if P_i >= P_text.len {
            jerr("unexpected end of object", P_i)
            break
        }
        if P_text[P_i] != 58 {
            jerr("expected : after key", P_i)
            break
        }
        P_i = P_i + 1
        let id = jvalue(depth + 1)
        if P_ok == 0 {
            break
        }
        push(keys, k)
        push(kids, id)
        jskipws()
        if P_i >= P_text.len {
            jerr("unexpected end of object", P_i)
            break
        }
        if P_text[P_i] == 44 {
            P_i = P_i + 1
            continue
        }
        if P_text[P_i] == 125 {
            P_i = P_i + 1
            break
        }
        jerr("expected , or } in object", P_i)
        break
    }
    let mut j = jnull()
    j.kind = 5
    j.keys = keys
    j.kids = kids
    return jpush(j)
}

/// Parse `text`. Check `doc.ok`; on failure `doc.err` names the problem and
/// `doc.at` is the byte offset. The tree stays live in the module pool until
/// the next `parse`.
fn parse(text: string) -> JsonDoc {
    P_text = text
    P_i = 0
    P_at = 0
    P_ok = 1
    P_err = ""
    P_nodes = []Json {}
    let root = jvalue(0)
    if P_ok == 1 {
        jskipws()
        if P_i < P_text.len {
            jerr("trailing characters", P_i)
        }
    }
    return JsonDoc { ok: P_ok, err: P_err, at: P_at, root: root }
}

// --- access (reads the live pool) ---

fn in_pool(id: int) -> int {
    if id < 0 {
        return 0
    }
    if id >= P_nodes.len {
        return 0
    }
    return 1
}

fn kind(id: int) -> int {
    if in_pool(id) == 0 {
        return 0
    }
    return P_nodes[id].kind
}

/// Number of children (array elements / object members).
fn child_count(id: int) -> int {
    if in_pool(id) == 0 {
        return 0
    }
    return P_nodes[id].kids.len
}

fn missing(path: string) -> string {
    return jcat(path, ": missing")
}

fn wrong(path: string, want: string) -> string {
    return jcat(jcat(path, ": expected "), want)
}

/// Object member by name. Pass the path to this key as `path`.
fn field(id: int, name: string, path: string) -> JVal {
    if in_pool(id) == 0 {
        return JVal { ok: 0, id: 0, err: missing(path) }
    }
    if P_nodes[id].kind != 5 {
        return JVal { ok: 0, id: 0, err: wrong(path, "object") }
    }
    let keys = P_nodes[id].keys
    let kids = P_nodes[id].kids
    let mut i = 0
    while i < keys.len {
        if keys[i] == name {
            return JVal { ok: 1, id: kids[i], err: "" }
        }
        i = i + 1
    }
    return JVal { ok: 0, id: 0, err: missing(path) }
}

fn index(id: int, i: int, path: string) -> JVal {
    if in_pool(id) == 0 {
        return JVal { ok: 0, id: 0, err: missing(path) }
    }
    if P_nodes[id].kind != 4 {
        return JVal { ok: 0, id: 0, err: wrong(path, "array") }
    }
    let kids = P_nodes[id].kids
    if i < 0 {
        return JVal { ok: 0, id: 0, err: missing(path) }
    }
    if i >= kids.len {
        return JVal { ok: 0, id: 0, err: missing(path) }
    }
    return JVal { ok: 1, id: kids[i], err: "" }
}

fn as_str(id: int, path: string) -> JStr {
    if in_pool(id) == 0 {
        return JStr { ok: 0, s: "", err: wrong(path, "string") }
    }
    if P_nodes[id].kind != 3 {
        return JStr { ok: 0, s: "", err: wrong(path, "string") }
    }
    return JStr { ok: 1, s: P_nodes[id].s, err: "" }
}

fn as_bool(id: int, path: string) -> JBool {
    if in_pool(id) == 0 {
        return JBool { ok: 0, b: false, err: wrong(path, "bool") }
    }
    if P_nodes[id].kind != 1 {
        return JBool { ok: 0, b: false, err: wrong(path, "bool") }
    }
    return JBool { ok: 1, b: P_nodes[id].b, err: "" }
}

/// Integer from a number node. Non-integers, non-numbers, and values outside
/// the `i64` range are errors naming `path` — never a trap.
fn as_int(id: int, path: string) -> JInt {
    if in_pool(id) == 0 {
        return JInt { ok: 0, n: 0, err: wrong(path, "number") }
    }
    if P_nodes[id].kind != 2 {
        return JInt { ok: 0, n: 0, err: wrong(path, "number") }
    }
    let s = P_nodes[id].num
    if s.len == 0 {
        return JInt { ok: 0, n: 0, err: wrong(path, "number") }
    }
    let mut i = 0
    let mut neg = false
    if s[0] == 45 {
        neg = true
        i = 1
    }
    if i >= s.len {
        return JInt { ok: 0, n: 0, err: jcat(path, ": not an integer") }
    }
    let mut v: i64 = 0
    while i < s.len {
        let c = s[i]
        if c < 48 {
            return JInt { ok: 0, n: 0, err: jcat(path, ": not an integer") }
        }
        if c > 57 {
            return JInt { ok: 0, n: 0, err: jcat(path, ": not an integer") }
        }
        let digit = i64(c - 48)
        if v > (I64_MAX - digit) / 10 {
            return JInt { ok: 0, n: 0, err: jcat(path, ": integer out of range") }
        }
        v = v * 10 + digit
        i = i + 1
    }
    if neg {
        v = 0 - v
    }
    return JInt { ok: 1, n: v, err: "" }
}

// --- stringify ---

let mut S_out: []int = []int {}

fn jhexd(x: int) -> int {
    if x < 10 {
        return 48 + x
    }
    return 97 + x - 10
}

fn jquote(s: string) {
    push(S_out, 34)
    let mut i = 0
    while i < s.len {
        let c = s[i]
        if c == 34 {
            push(S_out, 92)
            push(S_out, 34)
        } else if c == 92 {
            push(S_out, 92)
            push(S_out, 92)
        } else if c == 10 {
            push(S_out, 92)
            push(S_out, 110)
        } else if c == 9 {
            push(S_out, 92)
            push(S_out, 116)
        } else if c == 13 {
            push(S_out, 92)
            push(S_out, 114)
        } else if c < 32 {
            push(S_out, 92)
            push(S_out, 117)
            push(S_out, 48)
            push(S_out, 48)
            push(S_out, jhexd(c / 16))
            push(S_out, jhexd(c % 16))
        } else {
            push(S_out, c)
        }
        i = i + 1
    }
    push(S_out, 34)
}

fn jwrite(id: int, depth: int) {
    if depth > JSON_MAX_DEPTH {
        push(S_out, 110)
        push(S_out, 117)
        push(S_out, 108)
        push(S_out, 108)
        return
    }
    if in_pool(id) == 0 {
        return
    }
    let k = P_nodes[id].kind
    if k == 0 {
        push(S_out, 110)
        push(S_out, 117)
        push(S_out, 108)
        push(S_out, 108)
    } else if k == 1 {
        if P_nodes[id].b {
            push(S_out, 116)
            push(S_out, 114)
            push(S_out, 117)
            push(S_out, 101)
        } else {
            push(S_out, 102)
            push(S_out, 97)
            push(S_out, 108)
            push(S_out, 115)
            push(S_out, 101)
        }
    } else if k == 2 {
        let num = P_nodes[id].num
        let mut i = 0
        while i < num.len {
            push(S_out, num[i])
            i = i + 1
        }
    } else if k == 3 {
        jquote(P_nodes[id].s)
    } else if k == 4 {
        push(S_out, 91)
        let kids = P_nodes[id].kids
        let mut i = 0
        while i < kids.len {
            if i > 0 {
                push(S_out, 44)
            }
            jwrite(kids[i], depth + 1)
            i = i + 1
        }
        push(S_out, 93)
    } else {
        push(S_out, 123)
        let keys = P_nodes[id].keys
        let kids = P_nodes[id].kids
        let mut i = 0
        while i < keys.len {
            if i > 0 {
                push(S_out, 44)
            }
            jquote(keys[i])
            push(S_out, 58)
            jwrite(kids[i], depth + 1)
            i = i + 1
        }
        push(S_out, 125)
    }
}

/// Serialize a node back to a compact JSON string.
fn stringify(id: int) -> string {
    S_out = []int {}
    jwrite(id, 0)
    return string_from_bytes(S_out)
}

// --- helpers for `#[json]` derives ---

/// Join a field onto a JSON path: `child("user", "name")` -> `user.name`;
/// an empty base yields just the name.
fn child(base: string, name: string) -> string {
    if base.len == 0 {
        return name
    }
    return jcat(jcat(base, "."), name)
}

/// Error channel for generated decoders (no `Res` yet): a decoder that fails
/// stores the field-path error and returns a zero value; the caller checks
/// `take_err`.
let mut D_err: string = ""

fn set_err(e: string) {
    D_err = e
}

fn take_err() -> string {
    let e = D_err
    D_err = ""
    return e
}

// Encode builder: writes one object into `S_out`.
let mut E_first: int = 1

fn enc_obj_begin() {
    S_out = []int {}
    E_first = 1
    push(S_out, 123)
}

fn enc_key(name: string) {
    if E_first == 0 {
        push(S_out, 44)
    }
    E_first = 0
    jquote(name)
    push(S_out, 58)
}

fn jint(v0: i64) {
    let mut v = v0
    if v < 0 {
        push(S_out, 45)
        let imin = (0 - I64_MAX) - 1
        if v == imin {
            let s = "9223372036854775808"
            let mut i = 0
            while i < s.len {
                push(S_out, s[i])
                i = i + 1
            }
            return
        }
        v = 0 - v
    }
    let mut buf = []int {}
    if v == 0 {
        push(buf, 48)
    }
    while v > 0 {
        push(buf, 48 + int(v % 10))
        v = v / 10
    }
    let mut i = buf.len
    while i > 0 {
        i = i - 1
        push(S_out, buf[i])
    }
}

fn enc_int(v: i64) {
    jint(v)
}

fn enc_str(v: string) {
    jquote(v)
}

fn enc_obj_end() {
    push(S_out, 125)
}

fn enc_take() -> string {
    return string_from_bytes(S_out)
}
