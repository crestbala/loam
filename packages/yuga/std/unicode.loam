/// Is `cp` inside the sorted `[lo, hi, …]` range table `r`?
fn in_ranges(r: []int, cp: int) -> bool {
    let mut lo = 0
    let mut hi = r.len / 2 - 1
    while lo <= hi {
        let mid = (lo + hi) / 2
        let a = r[mid * 2]
        let b = r[mid * 2 + 1]
        if cp < a {
            hi = mid - 1
        } else if cp > b {
            lo = mid + 1
        } else {
            return true
        }
    }
    return false
}

/// Grapheme cluster break class of `cp`.
fn gcb(cp: int) -> int {
    if cp == 0x0D {
        return GCB_CR
    }
    if cp == 0x0A {
        return GCB_LF
    }
    if cp == 0x200D {
        return GCB_ZWJ
    }
    if in_ranges(control_ranges, cp) {
        return GCB_CONTROL
    }
    if cp >= 0x1F1E6 && cp <= 0x1F1FF {
        return GCB_REGIONAL
    }
    // Hangul (GB6-GB8): algorithmic L/V/T/LV/LVT.
    if (cp >= 0x1100 && cp <= 0x115F) || (cp >= 0xA960 && cp <= 0xA97C) {
        return GCB_L
    }
    if (cp >= 0x1160 && cp <= 0x11A7) || (cp >= 0xD7B0 && cp <= 0xD7C6) {
        return GCB_V
    }
    if (cp >= 0x11A8 && cp <= 0x11FF) || (cp >= 0xD7CB && cp <= 0xD7FB) {
        return GCB_T
    }
    if cp >= 0xAC00 && cp <= 0xD7A3 {
        if (cp - 0xAC00) % 28 == 0 {
            return GCB_LV
        }
        return GCB_LVT
    }
    if in_ranges(prepend_ranges, cp) {
        return GCB_PREPEND
    }
    if in_ranges(join_ranges, cp) {
        return GCB_EXTEND
    }
    return GCB_OTHER
}

/// `Extended_Pictographic` (approximate) — used only by GB11.
fn is_ext_pict(cp: int) -> bool {
    return in_ranges(ext_pict_ranges, cp)
}

// --- boundaries ------------------------------------------------------------

/// GB11: `ExtPict Extend* ZWJ × ExtPict`. `zwj` is the ZWJ byte offset; scan
/// back over `Extend` code points to an `Extended_Pictographic`.
fn gb11_before(s: string, zwj: int) -> bool {
    let mut p = prev_cp(s, zwj)
    while p < zwj && gcb(codepoint(s, p)) == GCB_EXTEND {
        if p == 0 {
            return false
        }
        p = prev_cp(s, p)
    }
    if p == zwj {
        return false
    }
    return is_ext_pict(codepoint(s, p))
}

/// Should a break be placed between the code point before `j` and the one at
/// `j`? `ri_run` is the number of Regional_Indicator code points immediately
/// before `j` in the current cluster (GB12/GB13).
fn breaks_at(s: string, j: int, ri_run: int) -> bool {
    let ia = prev_cp(s, j)
    let a = codepoint(s, ia)
    let b = codepoint(s, j)
    let ga = gcb(a)
    let gb = gcb(b)

    if ga == GCB_CR && gb == GCB_LF {
        return false
    }
    if ga == GCB_CONTROL || ga == GCB_CR || ga == GCB_LF {
        return true
    }
    if gb == GCB_CONTROL || gb == GCB_CR || gb == GCB_LF {
        return true
    }
    if ga == GCB_L && (gb == GCB_L || gb == GCB_V || gb == GCB_LV || gb == GCB_LVT) {
        return false
    }
    if (ga == GCB_LV || ga == GCB_V) && (gb == GCB_V || gb == GCB_T) {
        return false
    }
    if (ga == GCB_LVT || ga == GCB_T) && gb == GCB_T {
        return false
    }
    // GB9 / GB9a: join forward over Extend, ZWJ, SpacingMark.
    if gb == GCB_EXTEND || gb == GCB_ZWJ {
        return false
    }
    // GB9b: Prepend joins forward.
    if ga == GCB_PREPEND {
        return false
    }
    // GB11: emoji ZWJ sequence.
    if gb == GCB_OTHER && ga == GCB_ZWJ && is_ext_pict(b) && gb11_before(s, ia) {
        return false
    }
    // GB12 / GB13: break between RI pairs (odd run joins).
    if ga == GCB_REGIONAL && gb == GCB_REGIONAL {
        return ri_run % 2 == 0
    }
    return true
}

/// Byte offset of the next extended grapheme cluster boundary after `i`.
fn next_grapheme(s: string, i: int) -> int {
    if i >= s.len {
        return s.len
    }
    let mut ri = 0
    if gcb(codepoint(s, i)) == GCB_REGIONAL {
        ri = 1
    }
    let mut j = next_cp(s, i)
    while j < s.len {
        if breaks_at(s, j, ri) {
            break
        }
        if gcb(codepoint(s, j)) == GCB_REGIONAL {
            ri = ri + 1
        } else {
            ri = 0
        }
        j = next_cp(s, j)
    }
    return j
}

/// Byte offset of the greatest cluster boundary strictly before `i`.
fn prev_grapheme(s: string, i: int) -> int {
    if i <= 0 {
        return 0
    }
    let mut prev = 0
    let mut cur = 0
    while cur < i {
        prev = cur
        cur = next_grapheme(s, cur)
    }
    return prev
}

/// Number of extended grapheme clusters in `s`.
fn grapheme_count(s: string) -> int {
    let mut n = 0
    let mut i = 0
    while i < s.len {
        i = next_grapheme(s, i)
        n = n + 1
    }
    return n
}

/// Byte offset of cluster `k` (0 = start). Clamps at `s.len`.
fn grapheme_start(s: string, k: int) -> int {
    let mut i = 0
    let mut n = 0
    while n < k && i < s.len {
        i = next_grapheme(s, i)
        n = n + 1
    }
    return i
}
