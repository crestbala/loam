//! unicode — UTF-8 decoding and extended grapheme clusters.
//!
//! A `string` is bytes and `s[i]` is one byte. These helpers decode code points
//! and step by *extended grapheme cluster* (UAX #29), so a caret or backspace
//! moves once per visible character for combining marks, Indic scripts, Hangul,
//! and emoji ZWJ sequences.
//!
//! The property tables are a curated subset of the Unicode database covering
//! the scripts this tree targets (Latin+diacritics, Indic, Hangul, emoji,
//! variation selectors). `SpacingMark` and `ZWNJ` are folded into the "joins"
//! set because both simply forbid a break before the next code point.

// --- code points -----------------------------------------------------------

/// UTF-8 sequence length from lead byte `b0` (1..4; malformed leads count 1).
fn cp_len(b0: int) -> int {
    if b0 < 0x80 {
        return 1
    }
    if b0 < 0xC0 {
        return 1
    }
    if b0 < 0xE0 {
        return 2
    }
    if b0 < 0xF0 {
        return 3
    }
    if b0 < 0xF8 {
        return 4
    }
    return 1
}

/// The code point beginning at byte `i`, or `-1` past the end.
fn codepoint(s: string, i: int) -> int {
    if i < 0 || i >= s.len {
        return -1
    }
    let b0 = s[i]
    let n = cp_len(b0)
    if n == 1 {
        return b0
    }
    if n == 2 {
        if i + 1 >= s.len {
            return b0
        }
        return ((b0 & 0x1F) << 6) | (s[i + 1] & 0x3F)
    }
    if n == 3 {
        if i + 2 >= s.len {
            return b0
        }
        return ((b0 & 0x0F) << 12) | ((s[i + 1] & 0x3F) << 6) | (s[i + 2] & 0x3F)
    }
    if i + 3 >= s.len {
        return b0
    }
    let a = (b0 & 0x07) << 18
    let b = ((s[i + 1] & 0x3F) << 12) | ((s[i + 2] & 0x3F) << 6) | (s[i + 3] & 0x3F)
    return a | b
}

/// Byte offset one code point after `i`.
fn next_cp(s: string, i: int) -> int {
    if i >= s.len {
        return s.len
    }
    let j = i + cp_len(s[i])
    if j > s.len {
        return s.len
    }
    return j
}

/// Byte offset of the code point before `i`.
fn prev_cp(s: string, i: int) -> int {
    if i <= 0 {
        return 0
    }
    let mut j = i - 1
    while j > 0 && (s[j] & 0xC0) == 0x80 {
        j = j - 1
    }
    return j
}

// --- grapheme cluster break classes ---------------------------------------

const GCB_OTHER: int = 0
const GCB_CR: int = 1
const GCB_LF: int = 2
const GCB_CONTROL: int = 3
const GCB_EXTEND: int = 4
const GCB_ZWJ: int = 5
const GCB_PREPEND: int = 6
const GCB_L: int = 7
const GCB_V: int = 8
const GCB_T: int = 9
const GCB_LV: int = 10
const GCB_LVT: int = 11
const GCB_REGIONAL: int = 12

