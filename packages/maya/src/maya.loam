// `maya` — small 3D/2D engine (raylib-shaped, not raylib-heavy).
//
// Build a retained scene, then `maya.run()`. Scene, tracer, and 2D map
// live in Loam (`mayacore/`), and so do the draw order (`engine_present`)
// and the RGBA frame. C is only the Cocoa window, the event loop and the
// draw primitives (`hosts/mac.m`): it calls the int-only `engine_*` exports,
// and Loam calls it through the `#[os("macos")] #[c]` bindings below, so no
// other target compiles or links it.
//
// Example (3D sphere):
// ```
// import "maya"
//
// fn main() {
//     maya.init()
//     maya.window("hello", 800, 600)
//     maya.add(maya.sphere(16)).pos(0, 0, 0).scale(512).tint(maya.rgb(200, 80, 80))
//     maya.run()
// }
// ```
//
// 3D: analytic spheres, world unit 1024 = 1.0. CPU tracer, Cocoa 2D blit.
// Camera: drag to orbit, scroll to zoom, shift/right-drag to pan, WASD orbit,
// Q/E zoom, R reset.
//
// 2D: `maya.flat()` draws discs + orbit rings. `name()` labels a body.
// `scale` is disc radius in 720p pixels. `orbit` period is milliseconds.
//
// Sine/cosine: 1024 turns = 360°, result -1024..1024.
// `sin(0)=0`  `sin(256)=1024`  `sin(512)=0`  `sin(768)=-1024`
// `cos(t) = sin(t + 256)`
//
// `MAYA_HEADLESS=1` / `ZEUS_HEADLESS=1`: one frame, then exit.

#![c_source("hosts/mac.m", "-x", "objective-c", "-fobjc-arc")]
#![c_link("-framework", "Cocoa")]
import "mayacore/math.loam"
import "mayacore/scene.loam"
import "std:async"
import "std:sys"

/** *Integer 3D vector. Unit 1024 = 1.0 world. */
struct Vec3 {
    x: int,
    y: int,
    z: int,
}

/** *A mesh asset (analytic sphere). Copy handle. */
struct Mesh {
    id: int,
}

/** *An instance of a mesh in the scene. Chain `.pos` / `.scale` / `.tint`. */
struct Body {
    id: int,
}

// --- host ------------------------------------------------------------------

/** *Open the Cocoa window (`hosts/mac.m`). */
#[os("macos")]
#[c("maya_mac_window")]
fn plat_window(title: string, w: int, h: int) {}

/** *No window host off macOS: such a build is always headless. */
#[os("ios", "linux", "android", "windows", "wasm", "other")]
fn plat_window(title: string, w: int, h: int) {
    return
}

/** *Run the Cocoa event loop until the window closes. */
#[os("macos")]
#[c("maya_mac_run")]
fn plat_run() {}

#[os("ios", "linux", "android", "windows", "wasm", "other")]
fn plat_run() {
    return
}

// What the Cocoa host draws a frame with, called from `engine_present`.
#[os("macos")]
#[c("maya_mac_star")]
fn host_star(x16: int, y16: int, s100: int, w100: int) {}
#[os("macos")]
#[c("maya_mac_clear")]
fn host_clear() {}
#[os("macos")]
#[c("maya_mac_ring")]
fn host_ring(cx: int, cy: int, r: int) {}
#[os("macos")]
#[c("maya_mac_disc")]
fn host_disc(x: int, y: int, r: int, rgb: int, glow: int) {}
#[os("macos")]
#[c("maya_mac_label")]
fn host_label(text: string, x: int, y: int, r: int) {}
#[os("macos")]
#[c("maya_mac_hud")]
fn host_hud(text: string) {}
#[os("macos")]
#[c("maya_mac_blit")]
fn host_blit(rgba: []u8, w: int, h: int) {}

let mut host_vw: int = 640
let mut host_vh: int = 480
let mut host_last_ms: i64 = 0
let mut host_acc_ms: int = 0
let mut host_mouse_x: int = 0
let mut host_mouse_y: int = 0
let mut host_have_mouse: int = 0

/** *Draw the current frame through the Cocoa host: the 2D map (stars, orbit */
/** *rings around the sun, discs, names) or the traced 3D frame, then the HUD. */
#[os("macos")]
fn engine_present() {
    if scene.is_map() != 0 {
        present_map()
        host_hud(scene.hud_text())
        return
    }
    let frame = scene.fb_rgba()
    if frame.len == 0 {
        host_clear()
        return
    }
    host_blit(frame, scene.fb_w(), scene.fb_h())
    host_hud(scene.hud_text())
}

/** *No window host off macOS, so nothing to present. */
#[os("ios", "linux", "android", "windows", "wasm", "other")]
fn engine_present() {
    return
}

#[os("macos")]
fn present_map() {
    host_clear()
    for i in 0..220 {
        let mut h = wrapping_add(wrapping_mul(u32(i), u32(374761393)), u32(668265263))
        h = h ^ (h >> u32(17))
        let x16 = int(h & u32(4095)) * host_vw / 256
        let y16 = int((h >> u32(12)) & u32(4095)) * host_vh / 256
        let s100 = 60 + int((h >> u32(10)) & u32(7)) * 12
        let w100 = 55 + int((h >> u32(6)) & u32(7)) * 6
        host_star(x16, y16, s100, w100)
    }
    let n = scene.sprite_count()
    let mut cx = 0
    let mut cy = 0
    for i in 0..n {
        if scene.sprite_is_sun(i) != 0 {
            cx = scene.sprite_x(i)
            cy = scene.sprite_y(i)
            break
        }
    }
    for i in 0..n {
        let orbit = scene.sprite_orbit_r(i)
        if orbit > 1 {
            host_ring(cx, cy, orbit)
        }
    }
    for i in 0..n {
        let x = scene.sprite_x(i)
        let y = scene.sprite_y(i)
        let r = scene.sprite_r(i)
        host_disc(x, y, r, scene.sprite_rgb(i), scene.sprite_is_sun(i))
        let label = scene.sprite_name(i)
        if label.len > 0 {
            host_label(label, x, y, r)
        }
    }
}

#[os("ios", "linux", "android", "windows", "wasm", "other")]
fn present_map() {
    return
}

/** *An environment flag set to `1`. */
fn env_on(name: string) -> bool {
    let v = sys.env(name)
    return v.len > 0 && v[0] == '1'
}

/** *1 when no window opens: `MAYA_HEADLESS`, `ZEUS_HEADLESS` or */
/** *`LOAM_HEADLESS` is `1`. */
#[os("macos")]
fn plat_headless() -> int {
    if env_on("MAYA_HEADLESS") || env_on("ZEUS_HEADLESS") || env_on("LOAM_HEADLESS") {
        return 1
    }
    return 0
}

/** *Every other target has no window host. */
#[os("ios", "linux", "android", "windows", "wasm", "other")]
fn plat_headless() -> int {
    return 1
}

/** *Monotonic milliseconds. */
fn plat_now_ms() -> i64 {
    return async.now_ms()
}

/** *Build a `Vec3`. */
fn vec3(x: int, y: int, z: int) -> Vec3 {
    return Vec3 { x: x, y: y, z: z }
}

/** *Pack 0..255 channels into an RGB int (`r*65536 + g*256 + b`). */
fn rgb(r: int, g: int, b: int) -> int {
    return r * 65536 + g * 256 + b
}

/** *Sine. `turns` is 1024 = 360°. Result is -1024..1024. */
fn sin(turns: int) -> int {
    return math.sin_turns(turns)
}

/** *Cosine. Same units as `sin`. `cos(t) = sin(t + 256)`. */
fn cos(turns: int) -> int {
    return math.cos_turns(turns)
}

/** *Initialize the engine. Call once before `window`. */
fn init() {
    scene.do_init(plat_now_ms())
}

/** *Open a window. Sizes are pixels. */
fn window(title: string, width: int, height: int) {
    init()
    scene.do_window(title, width, height)
}

/** *Unit sphere mesh. `segments` is a quality hint (unused for analytic spheres). */
fn sphere(segments: int) -> Mesh {
    if segments < 0 {
        return Mesh { id: 0 }
    }
    return Mesh { id: 1 }
}

/** *Place `mesh` in the scene. Returns a `Body` to position and color. */
fn add(mesh: Mesh) -> Body {
    if mesh.id < 0 {
        return Body { id: 0 }
    }
    return Body { id: scene.do_add() }
}

/** *Set world position (unit 1024 = 1.0). */
fn pos(body: Body, x: int, y: int, z: int) -> Body {
    scene.do_pos(body.id, x, y, z)
    return body
}

/** *Uniform scale (unit 1024 = 1.0). */
fn scale(body: Body, s: int) -> Body {
    scene.do_scale(body.id, s)
    return body
}

/** *Diffuse color (`maya.rgb`). */
fn tint(body: Body, rgb: int) -> Body {
    scene.do_tint(body.id, rgb)
    return body
}

/** *0..256. 256 = the body emits light (the sun) and lights others. */
fn glow(body: Body, amount: int) -> Body {
    scene.do_glow(body.id, amount)
    return body
}

/** *Circle in the XZ plane around `around` (or world origin if `around.id` is 0). */
/** *`period_ms` is one revolution. */
fn orbit(body: Body, around: Body, radius: int, period_ms: int) -> Body {
    scene.do_orbit(body.id, around.id, radius, period_ms)
    return body
}

/** *Place the camera: eye `(ex,ey,ez)` looks at `(tx,ty,tz)`. */
fn look(ex: int, ey: int, ez: int, tx: int, ty: int, tz: int) {
    scene.do_look(ex, ey, ez, tx, ty, tz)
}

/** *Field of view in millidegrees. */
fn fov(milli_deg: int) {
    scene.do_fov(milli_deg)
}

/** *Ambient light color. */
fn ambient(rgb: int) {
    scene.do_ambient(rgb)
}

/** *Background clear color. */
fn clear(rgb: int) {
    scene.do_clear(rgb)
}

/** *Top-down 2D discs. No lighting. Planet data belongs in the app. */
fn flat() {
    init()
    scene.do_flat()
}

/** *Label a body (2D overlay). */
fn name(body: Body, label: string) -> Body {
    scene.do_name(body.id, label)
    return body
}

/** *Event loop + vsync present. Returns after the window closes. */
fn run() {
    init()
    if plat_headless() != 0 {
        if scene.is_map() != 0 {
            engine_set_viewport(scene.window_w(), scene.window_h())
            engine_fixed_update(8)
        } else {
            engine_frame()
        }
        return
    }
    plat_window(scene.window_title(), scene.window_w(), scene.window_h())
    plat_run()
}

fn engine_is_map() -> int {
    return scene.is_map()
}

fn engine_set_viewport(w: int, h: int) {
    scene.set_viewport(w, h)
}

fn engine_fixed_update(dt_ms: int) {
    scene.fixed_update(dt_ms)
}

fn engine_frame() {
    scene.frame(plat_now_ms(), plat_headless())
}

fn engine_input_key(key: int) {
    scene.input_key(key)
}

fn engine_cam_orbit(dx: int, dy: int) {
    scene.cam_orbit(dx, dy)
}

fn engine_cam_zoom(dy100: int) {
    scene.cam_zoom(dy100)
}

fn engine_cam_pan(dx: int, dy: int) {
    scene.cam_pan(dx, dy)
}

fn engine_cam_reset() {
    scene.cam_reset()
}

fn engine_note_present(dt_ms: int) {
    scene.note_present(dt_ms)
}

fn engine_sprite_count() -> int {
    return scene.sprite_count()
}

fn engine_sprite_x(i: int) -> int {
    return scene.sprite_x(i)
}

fn engine_sprite_y(i: int) -> int {
    return scene.sprite_y(i)
}

fn engine_sprite_r(i: int) -> int {
    return scene.sprite_r(i)
}

fn engine_sprite_orbit_r(i: int) -> int {
    return scene.sprite_orbit_r(i)
}

fn engine_sprite_rgb(i: int) -> int {
    return scene.sprite_rgb(i)
}

fn engine_sprite_is_sun(i: int) -> int {
    return scene.sprite_is_sun(i)
}

fn engine_sprite_name(i: int) -> string {
    return scene.sprite_name(i)
}

fn engine_hud() -> string {
    return scene.hud_text()
}

fn engine_fb_w() -> int {
    return scene.fb_w()
}

fn engine_fb_h() -> int {
    return scene.fb_h()
}

fn engine_fb_at(i: int) -> int {
    return scene.fb_at(i)
}

fn engine_draw(vw: int, vh: int) {
    if vw < 1 || vh < 1 {
        return
    }
    host_vw = vw
    host_vh = vh
    let now = plat_now_ms()
    if host_last_ms == 0 {
        host_last_ms = now
    }
    let mut dt_ms = int(now - host_last_ms)
    host_last_ms = now
    if dt_ms < 1 {
        dt_ms = 1
    }
    scene.note_present(dt_ms)
    if dt_ms > 250 {
        dt_ms = 250
    }
    scene.set_viewport(vw, vh)
    if scene.is_map() != 0 {
        host_acc_ms = host_acc_ms + dt_ms
        while host_acc_ms >= 16 {
            scene.fixed_update(16)
            host_acc_ms = host_acc_ms - 16
        }
    } else {
        engine_frame()
    }
    engine_present()
}

fn engine_key_down(key: int) -> int {
    if scene.is_map() != 0 {
        if key == 32 || key == 43 || key == 61 || key == 45 || key == 95 {
            scene.input_key(key)
            return 1
        }
        return 0
    }
    let mut k = key
    if k == 63234 {
        k = 97
    } else if k == 63235 {
        k = 100
    } else if k == 63232 {
        k = 119
    } else if k == 63233 {
        k = 115
    }
    let lo = if k >= 65 && k <= 90 { k + 32 } else { k }
    if lo == 97 ||
        lo == 100 ||
        lo == 119 ||
        lo == 115 ||
        lo == 113 ||
        lo == 101 ||
        lo == 114 ||
        k == 43 ||
        k == 61 ||
        k == 45 ||
        k == 95 {
        scene.input_key(k)
        return 1
    }
    return 0
}

fn engine_mouse_down(x: int, y: int) {
    host_mouse_x = x
    host_mouse_y = y
    host_have_mouse = 1
}

fn engine_mouse_drag(x: int, y: int, pan: int) -> int {
    if host_have_mouse == 0 {
        host_mouse_x = x
        host_mouse_y = y
        host_have_mouse = 1
        return 0
    }
    let dx = x - host_mouse_x
    let dy = y - host_mouse_y
    host_mouse_x = x
    host_mouse_y = y
    if scene.is_map() != 0 {
        return 0
    }
    if pan != 0 {
        scene.cam_pan(dx, 0 - dy)
    } else {
        scene.cam_orbit(dx, 0 - dy)
    }
    return 1
}

fn engine_wheel(dy100: int, precise: int) -> int {
    if scene.is_map() != 0 {
        return 0
    }
    let d = if precise != 0 { dy100 } else { dy100 * 4 }
    scene.cam_zoom(d)
    return 1
}
