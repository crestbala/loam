//! str — byte-level string helpers: search, slice, trim, case, split / join,
//! replace, pad, and shell quoting.
//!
//! A `string` is bytes and `s[i]` is one byte, so indices here are byte
//! offsets. Every search and slice works on whole needles, which keeps UTF-8
//! intact as long as the offsets came from a search (or from `std:unicode`).
//! Case mapping is ASCII only.
//!
//! Method calls rewrite to module calls, so after `import "std:str"` both
//! spellings work:
//!
//! ```
//! str.trim("  hi  ")          // "hi"
//! "a.mkv".ends_with(".mkv")   // true
//! ```

/// True for ASCII space, tab, newline, carriage return, vertical tab, form feed.
fn is_space(c: int) -> bool {
    return c == 32 || (c >= 9 && c <= 13)
}

/// True for ASCII `0`..`9`.
fn is_digit(c: int) -> bool {
    return c >= 48 && c <= 57
}

// --- slicing ------------------------------------------------------------------

/// `s[a..b]` as a new string. Out-of-range bounds are clamped; an empty or
/// inverted range gives `""`.
fn slice(s: string, a: int, b: int) -> string {
    let mut lo = a
    let mut hi = b
    if lo < 0 {
        lo = 0
    }
    if hi > s.len {
        hi = s.len
    }
    let mut x = []int {}
    if lo < hi {
        for i in lo..hi {
            push(x, s[i])
        }
    }
    return string_from_bytes(x)
}

/// Everything from byte `a` on.
fn slice_from(s: string, a: int) -> string {
    return slice(s, a, s.len)
}

// --- search -------------------------------------------------------------------

/// True when `needle` occurs in `s` at byte `at`.
fn has_at(s: string, needle: string, at: int) -> bool {
    if at < 0 || at + needle.len > s.len {
        return false
    }
    for k in 0..needle.len {
        if s[at + k] != needle[k] {
            return false
        }
    }
    return true
}

fn starts_with(s: string, prefix: string) -> bool {
    return has_at(s, prefix, 0)
}

fn ends_with(s: string, suffix: string) -> bool {
    return has_at(s, suffix, s.len - suffix.len)
}

/// First index of `needle` at or after `from`, or -1. An empty needle is found
/// at `from` (clamped into the string).
fn index_from(s: string, needle: string, from: int) -> int {
    let mut i = from
    if i < 0 {
        i = 0
    }
    if i > s.len {
        return -1
    }
    while i + needle.len <= s.len {
        if has_at(s, needle, i) {
            return i
        }
        i += 1
    }
    return -1
}

/// First index of `needle`, or -1.
fn index_of(s: string, needle: string) -> int {
    return index_from(s, needle, 0)
}

/// Last index of `needle`, or -1. An empty needle is found at `s.len`.
fn last_index_of(s: string, needle: string) -> int {
    let mut i = s.len - needle.len
    while i >= 0 {
        if has_at(s, needle, i) {
            return i
        }
        i -= 1
    }
    return -1
}

/// First index of byte `c`, or -1.
fn index_of_byte(s: string, c: int) -> int {
    for i in 0..s.len {
        if s[i] == c {
            return i
        }
    }
    return -1
}

/// Last index of byte `c`, or -1.
fn last_index_of_byte(s: string, c: int) -> int {
    let mut i = s.len - 1
    while i >= 0 {
        if s[i] == c {
            return i
        }
        i -= 1
    }
    return -1
}

fn contains(s: string, needle: string) -> bool {
    return index_of(s, needle) >= 0
}

/// Non-overlapping occurrences of `needle`; 0 for an empty needle.
fn count(s: string, needle: string) -> int {
    if needle.len == 0 {
        return 0
    }
    let mut n = 0
    let mut i = index_from(s, needle, 0)
    while i >= 0 {
        n += 1
        i = index_from(s, needle, i + needle.len)
    }
    return n
}

// --- trimming -------------------------------------------------------------------

fn trim_start(s: string) -> string {
    let mut a = 0
    while a < s.len && is_space(s[a]) {
        a += 1
    }
    return slice(s, a, s.len)
}

fn trim_end(s: string) -> string {
    let mut b = s.len
    while b > 0 && is_space(s[b - 1]) {
        b -= 1
    }
    return slice(s, 0, b)
}

/// `s` without leading and trailing ASCII whitespace.
fn trim(s: string) -> string {
    let mut a = 0
    let mut b = s.len
    while a < b && is_space(s[a]) {
        a += 1
    }
    while b > a && is_space(s[b - 1]) {
        b -= 1
    }
    return slice(s, a, b)
}

/// True when `s` is empty or only whitespace.
fn is_blank(s: string) -> bool {
    for i in 0..s.len {
        if !is_space(s[i]) {
            return false
        }
    }
    return true
}

/// `s` without `prefix`, or `s` unchanged when it does not start with it.
fn strip_prefix(s: string, prefix: string) -> string {
    if starts_with(s, prefix) {
        return slice(s, prefix.len, s.len)
    }
    return s
}

/// `s` without `suffix`, or `s` unchanged when it does not end with it.
fn strip_suffix(s: string, suffix: string) -> string {
    if ends_with(s, suffix) {
        return slice(s, 0, s.len - suffix.len)
    }
    return s
}

/// `s` with every trailing byte `c` removed, but never down to empty: a lone
/// `/` stays `/`.
fn trim_end_byte(s: string, c: int) -> string {
    let mut b = s.len
    while b > 1 && s[b - 1] == c {
        b -= 1
    }
    return slice(s, 0, b)
}

// --- case -------------------------------------------------------------------------

fn to_upper(s: string) -> string {
    let mut x = []int {}
    for i in 0..s.len {
        let c = s[i]
        push(x, if c >= 97 && c <= 122 { c - 32 } else { c })
    }
    return string_from_bytes(x)
}

fn to_lower(s: string) -> string {
    let mut x = []int {}
    for i in 0..s.len {
        let c = s[i]
        push(x, if c >= 65 && c <= 90 { c + 32 } else { c })
    }
    return string_from_bytes(x)
}

/// ASCII case-insensitive equality.
fn eq_fold(a: string, b: string) -> bool {
    if a.len != b.len {
        return false
    }
    for i in 0..a.len {
        let x = if a[i] >= 65 && a[i] <= 90 { a[i] + 32 } else { a[i] }
        let y = if b[i] >= 65 && b[i] <= 90 { b[i] + 32 } else { b[i] }
        if x != y {
            return false
        }
    }
    return true
}

// --- split / join -----------------------------------------------------------------

/// The pieces of `s` between occurrences of `sep`. `split("a,,b", ",")` is
/// `["a", "", "b"]`; an empty `s` gives one empty piece; an empty `sep` gives
/// `[s]`.
fn split(s: string, sep: string) -> []string {
    let mut out = []string {}
    if sep.len == 0 {
        push(out, s)
        return out
    }
    let mut start = 0
    let mut i = index_from(s, sep, 0)
    while i >= 0 {
        push(out, slice(s, start, i))
        start = i + sep.len
        i = index_from(s, sep, start)
    }
    push(out, slice(s, start, s.len))
    return out
}

/// `s` split on `\n`, with a trailing `\r` dropped from each line.
fn lines(s: string) -> []string {
    let parts = split(s, "\n")
    let mut out = []string {}
    for i in 0..parts.len {
        push(out, strip_suffix(parts[i], "\r"))
    }
    return out
}

/// `parts` with `sep` between each pair.
fn join(parts: []string, sep: string) -> string {
    let mut x = []int {}
    for i in 0..parts.len {
        if i > 0 {
            for k in 0..sep.len {
                push(x, sep[k])
            }
        }
        let p = parts[i]
        for k in 0..p.len {
            push(x, p[k])
        }
    }
    return string_from_bytes(x)
}

/// `s` with every non-overlapping `from` replaced by `to`. An empty `from`
/// leaves `s` unchanged.
fn replace_all(s: string, from: string, to: string) -> string {
    if from.len == 0 {
        return s
    }
    return join(split(s, from), to)
}

// --- building -----------------------------------------------------------------------

/// `s` repeated `n` times (`""` for n <= 0).
fn repeat(s: string, n: int) -> string {
    let mut x = []int {}
    for r in 0..n {
        for k in 0..s.len {
            push(x, s[k])
        }
    }
    return string_from_bytes(x)
}

/// `s` left-padded with byte `fill` to at least `width` bytes:
/// `pad_start("7", 2, 48)` is `"07"`.
fn pad_start(s: string, width: int, fill: int) -> string {
    let mut x = []int {}
    for i in s.len..width {
        push(x, fill)
    }
    for k in 0..s.len {
        push(x, s[k])
    }
    return string_from_bytes(x)
}

/// `s` right-padded with byte `fill` to at least `width` bytes.
fn pad_end(s: string, width: int, fill: int) -> string {
    let mut x = []int {}
    for k in 0..s.len {
        push(x, s[k])
    }
    for i in s.len..width {
        push(x, fill)
    }
    return string_from_bytes(x)
}

/// `s` single-quoted for `sh`: `it's` becomes `'it'\''s'`.
fn shell_quote(s: string) -> string {
    let mut x = []int { 39 }
    for i in 0..s.len {
        if s[i] == 39 {
            push(x, 39)
            push(x, 92)
            push(x, 39)
            push(x, 39)
        } else {
            push(x, s[i])
        }
    }
    push(x, 39)
    return string_from_bytes(x)
}
