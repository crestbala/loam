// Language-level seam (`docs/boundary.md`).
//
// Bodyless `fn`s resolve to `loam_sys_<name>` in `loam_rt`. No protocol here.

import "std:result"

/** *The operating system: `"macos"`, `"linux"`, `"windows"`, `"ios"`, */
/** *`"android"`, `"wasm"`, or `"other"`. */
fn os() -> string {}

/** *The CPU: `"x86_64"`, `"aarch64"`, `"wasm32"`, or `"other"`. */
fn arch() -> string {}

/** *Online CPUs, at least 1: how many children a parallel job runs at once. */
/** *`1` on wasm, iOS and Android. */
fn cpu_count() -> int {}

/** *Compile `--target`: `"wasm"`, `"ios"`, `"android"`, or `"native"`. */
fn target() -> string {}

/** *`1` if the environment variable is set and non-empty. */
fn env_set(name: string) -> int {}

/** *Exit the process with `code`. */
fn exit(code: int) {}

/** *Value of `name`, or empty if unset. Native only; wasm returns empty. */
fn env(name: string) -> string {}

/** *Write `body` to `path`. `0` on success. Native only; wasm returns `1`. */
fn write_file(path: string, body: string) -> int {}

/** *Run `cmd` via the shell; capture stdout (redirect `2>&1` to include stderr). */
/** *Native only; wasm returns empty. `exec_status` is the exit code. */
fn exec(cmd: string) -> string {}

/** *Exit code of the last `exec` (`1` if it could not start). */
fn exec_status() -> int {}

/** *`1` if stdout is a terminal, so output may be redrawn in place. A child of */
/** *`exec` cannot tell, its stdout being the capture pipe. Wasm returns `0`. */
fn stdout_tty() -> int {}

/** *Read the whole file. Empty if missing or over 1 GiB. Native only; wasm */
/** *returns empty. */
fn read_file(path: string) -> string {}

/** *Why the last `read_file` came back empty: `""` when it succeeded (the file */
/** *may just be empty), otherwise a message such as `"No such file or directory"`. */
fn io_error() -> string {}

/** *Read the whole file, or an error saying why not. Unlike `read_file`, an empty */
/** *file and a missing one are told apart. */
fn read(path: string) -> Result<string> {
    let body = read_file(path)
    let e = io_error()
    if e.len > 0 {
        return res_err(e, "")
    }
    return res_ok(body)
}

/** *Write the bytes of `b` to `path` without building a string first (see */
/** *`std:buf`). `0` on success. Native only; wasm returns `1`. */
fn write_bytes(path: string, b: &[]u8) -> int {}

/** *Last modification time of `path` in milliseconds since the epoch, or `-1` */
/** *when it does not exist. Sub-second where the file system records it. */
fn mtime(path: string) -> i64 {}

/** *`"<sec> <nsec> <size>"` of the regular file at `path`: its modification time */
/** *(seconds and nanoseconds since the epoch; nanoseconds are `0` where the file */
/** *system has none) and its size in bytes. `""` when `path` is missing or is not */
/** *a regular file. Compare two stamps whole to tell whether a file changed. */
/** *Native only; wasm returns `""`. */
fn stamp(path: string) -> string {}

/** *Start `argv[0]` (looked up on `PATH`) with `argv` as its arguments, without */
/** *a shell, so nothing in an argument is ever interpreted. Returns a handle for */
/** *`wait`, or `-1` if it could not start. Up to 256 children at a time. Native */
/** *only; wasm returns `-1`. */
fn spawn(argv: &[]string) -> int {}

/** *Wait for a `spawn`ed child: its exit code, or `-1` for a bad handle or a */
/** *child killed by a signal. Each handle is waited for once. */
fn wait(handle: int) -> int {}

/** *`spawn` then `wait`: the exit code, or `-1` if it could not start. */
fn run(argv: &[]string) -> int {
    let h = spawn(argv)
    if h < 0 {
        return 0 - 1
    }
    return wait(h)
}

/** *Read exactly `n` bytes of stdin (fewer only at end of input), unbuffered. */
fn read_stdin(n: int) -> string {}

/** *One line of stdin *including* its `\n`: `""` is end of input, `"\n"` a */
/** *blank line. Unbuffered, so it can be mixed with `read_stdin`. */
fn read_line() -> string {}

/** *True for an absolute path: `/x`, or on Windows `C:/x`, `C:\x`, `\\host\x`. */
fn is_abs(path: string) -> bool {
    if path.len == 0 {
        return false
    }
    if path[0] == '/' || path[0] == '\\' {
        return true
    }
    return path.len >= 3 && path[1] == ':' && (path[2] == '/' || path[2] == '\\') &&
        ((path[0] >= 'a' && path[0] <= 'z') || (path[0] >= 'A' && path[0] <= 'Z'))
}

/** *Create `path` and parents (`mkdir -p`). `0` on success. Native only; */
/** *wasm returns `1`. */
fn mkdir(path: string) -> int {}

/** *Rename `from` to `to`. `0` on success. Native only; wasm returns `1`. */
fn rename(from: string, to: string) -> int {}

/** *Command-line argument count, the program path included. `0` on iOS, */
/** *Android and wasm, where no command line reaches the program. */
fn argc() -> int {}

/** *Argument `i` as the shell gave it: `arg(0)` is the program path. Empty when */
/** *`i` is out of range. Native only; wasm returns empty. */
fn arg(i: int) -> string {}

/** *Every argument, `arg(0)` first. The convenience form of `argc` / `arg`. */
fn args() -> []string {
    let mut out = []string {}
    for i in 0..argc() {
        push(out, arg(i))
    }
    return out
}

/** *`1` if `path` exists, whatever it is. Native only; wasm returns `0`. */
fn exists(path: string) -> int {}

/** *`1` if `path` is a directory. Native only; wasm returns `0`. */
fn is_dir(path: string) -> int {}

/** *The canonical absolute spelling of an existing path (symlinks, `.` and */
/** *`..` resolved), or `""` when it does not exist. Native only; wasm */
/** *returns `""`. */
fn realpath(path: string) -> string {}

/** *Number of entries in the directory `path`, `.` and `..` excluded. `0` when */
/** *`path` is not a readable directory. Native only; wasm returns `0`. */
fn dir_count(path: string) -> int {}

/** *Entry `i` of `path`, sorted by name, as a fresh string — a caller that keeps */
/** *it keeps its own copy. Empty when `i` is out of range. Native only; wasm */
/** *returns empty. */
fn dir_entry(path: string, i: int) -> string {}

/** *Every entry of `path`, sorted. The convenience form of `dir_count` / */
/** *`dir_entry`. */
fn list_dir(path: string) -> []string {
    let mut out = []string {}
    for i in 0..dir_count(path) {
        push(out, dir_entry(path, i))
    }
    return out
}

/** *Remove `path`, recursing into a directory. `0` on success, including when */
/** *`path` is already gone. Native only; wasm returns `1`. */
fn remove_path(path: string) -> int {}

/** *The process's working directory, absolute. Empty when it cannot be read, and */
/** *on wasm, where there is none. */
fn cwd() -> string {}

/** *Open a filesystem watcher, for the paths `watch_add` is then given. Returns a */
/** *handle (> 0), or `0` when this host has no kernel watcher — macOS and the */
/** *BSDs do, wasm and Linux do not yet. */
fn watch_open() -> int {}

/** *Watch one path — a directory or a file — under `handle`. Returns a */
/** *registration id (> 0), which is also a descriptor the caller closes with */
/** *`watch_close`. `0` when the path cannot be opened. */
/** */
/** *The id is the caller's to keep: the mapping from id back to path is the */
/** *caller's business, because the watcher itself holds no state. */
fn watch_add(handle: int, path: string) -> int {}

/** *Wait for one change, and return the id of the watcher that fired — or `0` */
/** *when nothing happened in time. */
/** */
/** *`timeout_ms` follows `poll(2)`: negative blocks until something changes, `0` */
/** *returns at once, positive waits at most that long. Block with a negative */
/** *value for the first event of a burst, then drain the rest with `0`. */
/** */
/** *A file fires when its contents change. A directory fires when an entry inside */
/** *it is added, removed or renamed — so a caller that wants the *name* of a new */
/** *file has to list the directory it was handed. */
fn watch_next(handle: int, timeout_ms: int) -> int {}

/** *Close a descriptor from `watch_open` or `watch_add`. Returns `0`. */
fn watch_close(fd: int) -> int {}
