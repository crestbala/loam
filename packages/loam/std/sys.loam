// Language-level seam.
//
// Bodyless `fn`s resolve to `loam_sys_<name>` in `loam_rt`. No protocol here.

import "std:buf"
import "std:result"
import "std:str"

/** *Why the last `read_file` came back empty. Set by `read_file`, read by */
/** *`io_error`: an empty file and a missing one read the same, and `sys.read` */
/** *tells them apart. */
let mut last_error: string = ""

/** *Why the last `read_file` came back empty: `""` when it succeeded (the file */
/** *may just be empty), otherwise a message such as `"No such file or directory"`. */
fn io_error() -> string {
    return last_error
}

/** *The operating system: `"macos"`, `"linux"`, `"windows"`, `"ios"`, */
/** *`"android"`, `"wasm"`, or `"other"`. Fixed when the program is built: */
/** *each target compiles only its own variant. */
#[os("macos")]
fn os() -> string {
    return "macos"
}

/** *`sys.os()` on this target. */
#[os("ios")]
fn os() -> string {
    return "ios"
}

/** *`sys.os()` on this target. */
#[os("linux")]
fn os() -> string {
    return "linux"
}

/** *`sys.os()` on this target. */
#[os("android")]
fn os() -> string {
    return "android"
}

/** *`sys.os()` on this target. */
#[os("windows")]
fn os() -> string {
    return "windows"
}

/** *`sys.os()` on this target. */
#[os("wasm")]
fn os() -> string {
    return "wasm"
}

/** *`sys.os()` on this target. */
#[os("other")]
fn os() -> string {
    return "other"
}

/** *The CPU: `"x86_64"`, `"aarch64"`, `"wasm32"`, or `"other"`. Fixed when */
/** *the program is built, like `os`. */
#[arch("x86_64")]
fn arch() -> string {
    return "x86_64"
}

/** *`sys.arch()` on this CPU. */
#[arch("aarch64")]
fn arch() -> string {
    return "aarch64"
}

/** *`sys.arch()` on this CPU. */
#[arch("wasm32")]
fn arch() -> string {
    return "wasm32"
}

/** *`sys.arch()` on this CPU. */
#[arch("other")]
fn arch() -> string {
    return "other"
}

/** *Online CPUs, at least 1: how many children a parallel job runs at once. */
/** *`1` on wasm, iOS and Android, where nothing is spawned, and on an Unix */
/** *this std does not know (`_SC_NPROCESSORS_ONLN` is a per-OS number). */
#[os("macos")]
fn cpu_count() -> int {
    // `_SC_NPROCESSORS_ONLN` in the macOS SDK.
    return at_least_one(c_sysconf(58))
}

/** *Linux: `_SC_NPROCESSORS_ONLN` is 84 in glibc and musl alike. */
#[os("linux")]
fn cpu_count() -> int {
    return at_least_one(c_sysconf(84))
}

/** *Windows: the count the system puts in the environment, read as `strtol` */
/** *did (leading spaces, then digits; anything else stops it). */
#[os("windows")]
fn cpu_count() -> int {
    let v = env("NUMBER_OF_PROCESSORS")
    let mut i = 0
    while i < v.len && (v[i] == ' ' || v[i] == '\t') {
        i = i + 1
    }
    // A sign as `strtol` takes it: `-` can only make the count below one.
    if i < v.len && (v[i] == '+' || v[i] == '-') {
        if v[i] == '-' {
            return 1
        }
        i = i + 1
    }
    let mut n = 0
    while i < v.len && v[i] >= '0' && v[i] <= '9' && n < 1000000 {
        n = n * 10 + int(v[i] - '0')
        i = i + 1
    }
    return if n > 0 { n } else { 1 }
}

/** *wasm, iOS, Android, and an unknown Unix: one at a time. */
#[os("wasm", "ios", "android", "other")]
fn cpu_count() -> int {
    return 1
}

/** *`sysconf(name)` straight from libc: `-1` when the name is unknown. */
#[os("macos", "linux")]
#[c("sysconf")]
fn c_sysconf(name: i32) -> i64 {}

/** *`v` as a count: never below one. */
fn at_least_one(v: i64) -> int {
    return if v > i64(0) { int(v) } else { 1 }
}

/** *Compile `--target`: `"wasm"`, `"ios"`, `"android"`, or `"native"`. */
#[os("wasm")]
fn target() -> string {
    return "wasm"
}

/** *`sys.target()` on iOS. */
#[os("ios")]
fn target() -> string {
    return "ios"
}

/** *`sys.target()` on Android. */
#[os("android")]
fn target() -> string {
    return "android"
}

/** *`sys.target()` on a desktop or server build. */
#[os("macos", "linux", "windows", "other")]
fn target() -> string {
    return "native"
}

/** *`1` if the environment variable is set and non-empty. */
fn env_set(name: string) -> int {
    return env_set_os(name)
}

/** *Native `env_set`: `getenv`'s pointer and one byte of it, never a copy. */
#[os("posix", "windows")]
fn env_set_os(name: string) -> int {
    if name.len == 0 || name.len >= 256 {
        return 0
    }
    // Set and non-empty: a pointer whose first byte is not the NUL.
    let p = c_getenv_at(name)
    return if p != 0 && c_memchr(p, 0, 1) == 0 { 1 } else { 0 }
}

/** *No environment on wasm. */
#[os("wasm")]
fn env_set_os(name: string) -> int {
    return 0
}

/** *`getenv` as the address of its answer (`0` when unset). Private, and */
/** *only ever handed to `c_memchr` below. */
#[os("posix", "windows")]
#[c("getenv")]
fn c_getenv_at(name: string) -> i64 {}

/** *`memchr` straight from libc: the first `c` in the `n` bytes at `p`, or */
/** *`0`. Reads at most `n` bytes. */
#[os("posix", "windows")]
#[c("memchr")]
fn c_memchr(p: i64, c: i32, n: i64) -> i64 {}

/** *Exit the process with `code`. */
fn exit(code: int) {
    exit_os(code)
}

/** *Native `exit`: libc's, so `atexit` handlers and stdio flushing run. */
#[os("posix", "windows")]
fn exit_os(code: int) {
    c_exit(i32(code))
}

/** *wasm has no process to leave: the host traps (`abort`), as before. */
#[os("wasm")]
fn exit_os(code: int) {
    wasm_exit()
}

/** *`exit` straight from libc. */
#[os("posix", "windows")]
#[c("exit")]
fn c_exit(code: i32) {}

/** *The wasm runtime's `abort`: a bodyless hook, since wasm binds no libc. */
#[os("wasm")]
fn wasm_exit() {}

/** *Value of `name`, or empty if unset. Native only; wasm returns empty. */
fn env(name: string) -> string {
    return env_os(name)
}

/** *Native `env`: `getenv` straight from libc, its answer copied (NULL is */
/** *`""`). A name of 256 bytes or more is never looked up, as before. */
#[os("posix", "windows")]
fn env_os(name: string) -> string {
    if name.len == 0 || name.len >= 256 {
        return ""
    }
    return c_getenv(name)
}

/** *No environment on wasm. */
#[os("wasm")]
fn env_os(name: string) -> string {
    return ""
}

/** *`getenv` straight from libc. */
#[os("posix", "windows")]
#[c("getenv")]
fn c_getenv(name: string) -> string {}

/** *Write `body` to `path`. `0` on success. Native only; wasm returns `1`. */
fn write_file(path: string, body: string) -> int {
    return write_file_os(path, body)
}

/** *Native `write_file`: stdio in one call (`wb`), like the C it replaces. */
#[os("posix", "windows")]
fn write_file_os(path: string, body: string) -> int {
    let f = c_fopen(path, "wb")
    if f == 0 {
        return 1
    }
    if body.len > 0 && c_fwrite(body, 1, i64(body.len), f) != i64(body.len) {
        c_fclose(f)
        return 1
    }
    return c_fclose(f)
}

/** *No filesystem on wasm: nothing is written. */
#[os("wasm")]
fn write_file_os(path: string, body: string) -> int {
    return 1
}

/** *`FILE*` from `fopen(path, mode)`, or `0`. Private: only this module's own */
/** *fns may name it, and only between their `fopen` and their `fclose`. */
#[os("posix", "windows")]
#[c("fopen")]
fn c_fopen(path: string, mode: string) -> i64 {}

/** *`fwrite` straight from libc: bytes of `p` through `f`. */
#[os("posix", "windows")]
#[c("fwrite")]
fn c_fwrite(p: string, size: i64, n: i64, f: i64) -> i64 {}

/** *`fclose` straight from libc: `0` when `f` closed. */
#[os("posix", "windows")]
#[c("fclose")]
fn c_fclose(f: i64) -> i32 {}

/** *Exit code of the last `exec`; `1` until one runs, and when it could not. */
let mut last_status: int = 1

/** *Run `cmd` via the shell; capture stdout (redirect `2>&1` to include stderr). */
/** *Native only; wasm returns empty. `exec_status` is the exit code. Output */
/** *past 256 KiB is cut off. */
fn exec(cmd: string) -> string {
    return exec_os(cmd)
}

/** *Exit code of the last `exec` (`1` if it could not start). */
fn exec_status() -> int {
    return last_status
}

/** *Native `exec`: `popen`, 512-byte `fread`s up to the cap, `pclose`, the */
/** *C's shape. A full chunk is one `push_bytes`; only the last, short one */
/** *goes byte by byte. */
#[os("posix", "windows")]
fn exec_os(cmd: string) -> string {
    if cmd.len == 0 || cmd.len >= 8191 {
        last_status = 1
        return ""
    }
    let p = c_popen(cmd, "r")
    if p == 0 {
        last_status = 1
        return ""
    }
    let mut out = []u8 {}
    let mut chunk = buf.with_len(512)
    while out.len < 262144 {
        let r = int(c_fread(chunk, 1, 512, p))
        if r == 512 {
            buf.push_bytes(&mut out, &chunk)
            continue
        }
        for i in 0..r {
            push(out, chunk[i])
        }
        break
    }
    last_status = exit_code(c_pclose(p))
    return string_from_bytes(out)
}

/** *No processes on wasm: nothing runs, and the status stays `1`. */
#[os("wasm")]
fn exec_os(cmd: string) -> string {
    return ""
}

/** *A `pclose` wait status as an exit code: `WIFEXITED` / `WEXITSTATUS` are */
/** *macros, so their bits are spelled here (the same on Linux and macOS): */
/** *exited when the low seven bits are clear, the code in the next byte. A */
/** *signal or a failed `pclose` is `1`. */
#[os("posix")]
fn exit_code(st: i32) -> int {
    if st == -1 || (st & 127) != 0 {
        return 1
    }
    return int((st >> 8) & 255)
}

/** *Windows `_pclose` hands back the exit code itself. */
#[os("windows")]
fn exit_code(st: i32) -> int {
    return if st == -1 { 1 } else { int(st) }
}

/** *`popen` straight from libc: a `FILE*` as an `i64`, or `0`. */
#[os("posix")]
#[c("popen")]
fn c_popen(cmd: string, mode: string) -> i64 {}

/** *The Windows CRT spells it `_popen`. */
#[os("windows")]
#[c("_popen")]
fn c_popen(cmd: string, mode: string) -> i64 {}

/** *`pclose` straight from libc: the child's wait status, or `-1`. */
#[os("posix")]
#[c("pclose")]
fn c_pclose(f: i64) -> i32 {}

/** *The Windows CRT spells it `_pclose`. */
#[os("windows")]
#[c("_pclose")]
fn c_pclose(f: i64) -> i32 {}

/** *`1` if stdout is a terminal, so output may be redrawn in place. A child of */
/** *`exec` cannot tell, its stdout being the capture pipe. Wasm returns `0`. */
fn stdout_tty() -> int {
    // `_isatty` answers any nonzero value for a terminal; this answers `1`.
    return if c_isatty(1) != 0 { 1 } else { 0 }
}

/** *`isatty(2)`, bound straight from libc: `1` when `fd` is a terminal. */
#[os("posix")]
#[c("isatty")]
fn c_isatty(fd: i32) -> i32 {}

/** *No terminal on wasm: what stdout a host gives is not a tty. */
#[os("wasm")]
fn c_isatty(fd: i32) -> i32 {
    return 0
}

/** *The Windows CRT spells it `_isatty`. */
#[os("windows")]
#[c("_isatty")]
fn c_isatty(fd: i32) -> i32 {}

/** *Read the whole file. Empty if missing or over 1 GiB. Native only; wasm */
/** *returns empty. */
fn read_file(path: string) -> string {
    last_error = ""
    return read_sized(path)
}

/** *Native `read_file`: `fopen` + `fseek`/`ftell` sizing + one `with_len` */
/** *allocation + `fread`, the C shape verbatim. Sets `last_error` itself: a */
/** *short read keeps the bytes it got and still says why it stopped. */
#[os("posix", "windows")]
fn read_sized(path: string) -> string {
    if path.len == 0 || path.len >= 4095 {
        last_error = if path.len == 0 { "empty path" } else { "path too long" }
        return ""
    }
    let f = c_fopen(path, "rb")
    if f == 0 {
        last_error = c_strerror()
        return ""
    }
    if c_fseek(f, 0, 2) != 0 {
        last_error = c_strerror()
        c_fclose(f)
        return ""
    }
    let size = c_ftell(f)
    // Loam's `int` indexes a string: past 1 GiB the read is empty, as before.
    if size < 0 || size > 1073741824 {
        last_error = if size < 0 { "not a regular file" } else { "file too large (over 1 GiB)" }
        c_fclose(f)
        return ""
    }
    c_fseek(f, 0, 0)
    let mut bytes = buf.with_len(int(size))
    let n = c_fread(bytes, 1, size, f)
    if n < size && c_ferror(f) != 0 {
        last_error = "read error"
    }
    c_fclose(f)
    if n == 0 {
        return ""
    }
    let text = string_from_bytes(bytes)
    return if n < size { str.slice(text, 0, int(n)) } else { text }
}

/** *No filesystem on wasm: nothing is read. */
#[os("wasm")]
fn read_sized(path: string) -> string {
    last_error = "no filesystem"
    return ""
}

/** *The first `cap` bytes of a file (fewer when it is shorter), without */
/** *reading the rest. Empty when it is missing, unreadable or `cap <= 0`. */
/** *Native only; wasm returns empty. */
fn read_prefix(path: string, cap: int) -> []u8 {
    return read_prefix_os(path, cap)
}

/** *Native `read_prefix`: sized by `fseek`/`ftell` first, so the buffer is */
/** *allocated once at exactly the length that is read. */
#[os("posix", "windows")]
fn read_prefix_os(path: string, cap: int) -> []u8 {
    if cap <= 0 || path.len == 0 || path.len >= 4095 {
        return []u8 {}
    }
    let f = c_fopen(path, "rb")
    if f == 0 {
        return []u8 {}
    }
    let mut size: i64 = -1
    if c_fseek(f, 0, 2) == 0 {
        size = c_ftell(f)
    }
    if size <= 0 || c_fseek(f, 0, 0) != 0 {
        c_fclose(f)
        return []u8 {}
    }
    let want = if size < i64(cap) { size } else { i64(cap) }
    let mut bytes = buf.with_len(int(want))
    let got = c_fread(bytes, 1, want, f)
    c_fclose(f)
    if got != want {
        return []u8 {}
    }
    return bytes
}

/** *No filesystem on wasm: nothing is read. */
#[os("wasm")]
fn read_prefix_os(path: string, cap: int) -> []u8 {
    return []u8 {}
}

/** *This process's memory in KB: Apple's `phys_footprint` (the number */
/** *Xcode's memory gauge shows), the resident set on Linux and Android, the */
/** *live heap on wasm. 0 where none is known (Windows, other). */
fn mem_kb() -> int {
    return mem_kb_os()
}

/** *This task's port, as `mach_task_self()`. Asked once: each */
/** *`task_self_trap` adds a user reference to the send right. */
let mut task_port: u32 = 0

/** *`phys_footprint`: the u64 at byte 144 of `struct task_vm_info`, read */
/** *whole (`TASK_VM_INFO` 22, 93 `natural_t`s, in 47 words). */
#[os("apple")]
fn mem_kb_os() -> int {
    if task_port == 0 {
        task_port = c_task_self_trap()
    }
    let mut info = buf_words(47)
    let mut count = []u32 { 93 }
    if c_task_info(task_port, 22, info, count) != 0 {
        return 0
    }
    return int(info[18] / i64(1024))
}

/** *The `VmRSS:` line of `/proc/self/status`, already in kB. */
#[os("linux", "android")]
fn mem_kb_os() -> int {
    return vmrss_kb(read_file("/proc/self/status"))
}

/** *The kB count on the `VmRSS:` line of a `/proc/<pid>/status` text, or 0. */
fn vmrss_kb(status: string) -> int {
    let at = str.index_of(status, "VmRSS:")
    if at < 0 {
        return 0
    }
    let mut kb = 0
    let mut i = at + 6
    while i < status.len && (status[i] == 32 || status[i] == 9) {
        i = i + 1
    }
    while i < status.len && status[i] >= 48 && status[i] <= 57 {
        kb = kb * 10 + int(status[i] - 48)
        i = i + 1
    }
    return kb
}

#[os("wasm")]
fn mem_kb_os() -> int {
    return wasm_heap_used() / 1024
}

#[os("windows", "other")]
fn mem_kb_os() -> int {
    return 0
}

/** *Live wasm heap bytes: the wasm libc's own count (codegen's */
/** *`wasm_libc_defs`). */
#[os("wasm")]
fn wasm_heap_used() -> int {}

/** *`n` zeroed words for a C struct to be written into. */
fn buf_words(n: int) -> []i64 {
    let mut words = []i64 {}
    for i in 0..n {
        words.push(i64(0))
    }
    return words
}

#[os("apple")]
#[c("task_self_trap")]
fn c_task_self_trap() -> u32 {}

#[os("apple")]
#[c("task_info")]
fn c_task_info(task: u32, flavor: i32, info: &mut []i64, count: &mut []u32) -> i32 {}

/** *`ferror` straight from libc: nonzero when the stream hit an error. */
#[os("posix", "windows")]
#[c("ferror")]
fn c_ferror(f: i64) -> i32 {}

/** *`fseek` straight from libc: `0` when it moved. */
#[os("posix", "windows")]
#[c("fseek")]
fn c_fseek(f: i64, off: i64, whence: i32) -> i32 {}

/** *`ftell` straight from libc: the size after a seek to the end, or `-1`. */
#[os("posix", "windows")]
#[c("ftell")]
fn c_ftell(f: i64) -> i64 {}

/** *`fread` straight from libc: bytes through `f` into `buf`. A fresh `with_len` */
/** *buffer, as `compile_pass/c_ffi` proves: C writes through the wrapper are */
/** *visible to the caller, which then moves it into `string_from_bytes`. */
#[os("posix", "windows")]
#[c("fread")]
fn c_fread(buf: &mut []u8, size: i64, n: i64, f: i64) -> i64 {}

/** *`strerror(errno)` as a fresh string: why the last call failed. Named */
/** *`c_strerror` because C's own two-meaning `strerror` takes an argument */
/** *this wrapper never passes: the error is always the current one. */
#[os("posix", "windows")]
#[c("loam_sys_strerror")]
fn c_strerror() -> string {}

/** *Read the whole file, or an error saying why not. Unlike `read_file`, an empty */
/** *file and a missing one are told apart. */
fn read(path: string) -> Result<string> {
    let body = read_file(path)
    let e = io_error()
    if e.len > 0 {
        return res_err(e, "")
    }
    return res_ok(body)
}

/** *Write the bytes of `b` to `path` without building a string first (see */
/** *`std:buf`). `0` on success. Native only; wasm returns `1`. By value: the */
/** *call shares the buffer (one refcount bump, no byte copy). */
fn write_bytes(path: string, b: []u8) -> int {
    return write_bytes_os(path, b)
}

/** *Native `write_bytes`: one `fwrite` of the buffer, like the C it replaces. */
#[os("posix", "windows")]
fn write_bytes_os(path: string, b: []u8) -> int {
    let f = c_fopen(path, "wb")
    if f == 0 {
        return 1
    }
    if b.len > 0 && c_fwrite_buf(b, 1, i64(b.len), f) != i64(b.len) {
        c_fclose(f)
        return 1
    }
    return c_fclose(f)
}

/** *No filesystem on wasm: nothing is written. */
#[os("wasm")]
fn write_bytes_os(path: string, b: []u8) -> int {
    return 1
}

/** *`fwrite` straight from libc over a byte buffer (the `string` twin above */
/** *covers text). Borrowed: C only reads, and the wrapper does not retain. */
#[os("posix", "windows")]
#[c("fwrite")]
fn c_fwrite_buf(b: &[]u8, size: i64, n: i64, f: i64) -> i64 {}

/** *Last modification time of `path` in milliseconds since the epoch, or `-1` */
/** *when it does not exist. Sub-second where the file system records it. */
fn mtime(path: string) -> i64 {
    return mtime_os(path)
}

/** *Native `mtime`: one `stat`, through the five-slot `c_stat` shim. */
#[os("posix", "windows")]
fn mtime_os(path: string) -> i64 {
    let st = c_stat(path)
    if st.tag == ResultTag.Err {
        return -1
    }
    return st.val[0] * 1000 + st.val[1] / 1000000
}

/** *No filesystem on wasm: nothing has a time. */
#[os("wasm")]
fn mtime_os(path: string) -> i64 {
    return -1
}

/** *`"<sec> <nsec> <size>"` of the regular file at `path`: its modification time */
/** *(seconds and nanoseconds since the epoch; nanoseconds are `0` where the file */
/** *system has none) and its size in bytes. `""` when `path` is missing or is not */
/** *a regular file. Compare two stamps whole to tell whether a file changed. */
/** *Native only; wasm returns `""`. */
fn stamp(path: string) -> string {
    let t = stamp_os(path)
    if t.tag == ResultTag.Err {
        return ""
    }
    return t.val
}

/** *Native `stamp`: the same `stat`, formatted in Loam. */
#[os("posix", "windows")]
fn stamp_os(path: string) -> Result<string> {
    let st = c_stat(path)
    if st.tag == ResultTag.Err {
        return res_err("", "")
    }
    // The C compared whole structs; here the regular-file test is the shim's
    // own slot, and the text is what `%lld %lld %lld` printed.
    if st.val[3] == 0 {
        return res_err("", "")
    }
    return res_ok("{{st.val[0]}} {{st.val[1]}} {{st.val[2]}}")
}

/** *No filesystem on wasm: nothing has a stamp. */
#[os("wasm")]
fn stamp_os(path: string) -> Result<string> {
    return res_err("", "")
}

/** *One `stat(2)`: five slots (mtime-sec, mtime-nsec, size, is-regular, */
/** *is-dir). The layout lives in C; Loam only reads numbers. */
#[os("posix", "windows")]
#[c("loam_sys_stat")]
fn c_stat_raw(path: string, out: &mut []i64) -> i32 {}

/** *The shim's five slots, or an error (no message: no caller asks). A five-zero literal */
/** *on every call: the shim writes through the wrapper into it. */
#[os("posix", "windows")]
fn c_stat(path: string) -> Result<[]i64> {
    let mut out = []i64 { 0, 0, 0, 0, 0 }
    // No caller reads why: a miss is just a miss, so no message is built.
    if c_stat_raw(path, out) == 0 {
        return res_err("", out)
    }
    return res_ok(out)
}

/** *Start `argv[0]` (looked up on `PATH`) with `argv` as its arguments, without */
/** *a shell, so nothing in an argument is ever interpreted. Returns a handle for */
/** *`wait`, or `-1` if it could not start. Up to 256 children at a time. Native */
/** *only; wasm returns `-1`. */
fn spawn(argv: &[]string) -> int {
    return spawn_os(argv)
}

/** *Wait for a `spawn`ed child: its exit code, or `-1` for a bad handle or a */
/** *child killed by a signal. Each handle is waited for once. */
fn wait(handle: int) -> int {
    return wait_os(handle)
}

/** *The spawn table: a child's pid (posix) or process handle (Windows) per */
/** *slot, `0` for a free one. A handle is its slot plus one, so it is a */
/** *small int on every platform. Filled to 256 slots on the first `spawn`. */
let mut spawned: []i64 = []i64 {}

/** *The most children alive at once. */
const SPAWN_MAX: int = 256

/** *Native `spawn`: a free slot, the arguments packed NUL-terminated into one */
/** *buffer, a `char **` laid over Loam-owned slots, then one start call. C */
/** *allocates nothing, and every buffer outlives the call that reads it. */
#[os("posix", "windows")]
fn spawn_os(argv: &[]string) -> int {
    let n = argv.len
    if n <= 0 {
        return -1
    }
    if spawned.len == 0 {
        for i in 0..SPAWN_MAX {
            push(spawned, i64(0))
        }
    }
    let mut slot = -1
    for i in 0..SPAWN_MAX {
        if spawned[i] == i64(0) {
            slot = i
            break
        }
    }
    if slot < 0 {
        return -1
    }
    let mut block = []u8 {}
    let mut offsets = []i64 {}
    let mut slots = []i64 {}
    let mut file = ""
    for i in 0..n {
        let a = spawn_arg(argv[i])
        if i == 0 {
            file = a
        }
        push(offsets, i64(block.len))
        buf.push_str(&mut block, a)
        push(block, u8(0))
        push(slots, i64(0))
    }
    push(slots, i64(0))
    c_argv_fill(block, offsets, i64(n), slots)
    let id = start_child(file, slots)
    if id == i64(0) {
        return -1
    }
    spawned[slot] = id
    return slot + 1
}

/** *No processes on wasm. */
#[os("wasm")]
fn spawn_os(argv: &[]string) -> int {
    return -1
}

/** *Native `wait`: the slot's child, freed first so a handle is waited for */
/** *once, whatever the outcome. */
#[os("posix", "windows")]
fn wait_os(handle: int) -> int {
    let slot = handle - 1
    if slot < 0 || slot >= spawned.len || spawned[slot] == i64(0) {
        return -1
    }
    let id = spawned[slot]
    spawned[slot] = i64(0)
    return wait_child(id)
}

/** *No processes on wasm. */
#[os("wasm")]
fn wait_os(handle: int) -> int {
    return -1
}

/** *An argument as the child sees it: posix passes it untouched. */
#[os("posix")]
fn spawn_arg(a: string) -> string {
    return a
}

/** *The MS C runtime joins argv with spaces, so each argument is quoted the */
/** *way `CommandLineToArgvW` splits it back: backslashes double only before */
/** *a quote, and a quote is escaped. A plain argument stays as it is. */
#[os("windows")]
fn spawn_arg(a: string) -> string {
    let mut plain = a.len > 0
    for i in 0..a.len {
        if a[i] == ' ' || a[i] == '\t' || a[i] == '"' {
            plain = false
        }
    }
    if plain {
        return a
    }
    let mut q = []u8 {}
    push(q, u8('"'))
    let mut i = 0
    while i < a.len {
        let mut slashes = 0
        while i < a.len && a[i] == '\\' {
            slashes = slashes + 1
            i = i + 1
        }
        // Before a quote, or the closing quote, each backslash doubles.
        let doubled = i == a.len || a[i] == '"'
        for k in 0..(if doubled { slashes * 2 } else { slashes }) {
            push(q, u8('\\'))
        }
        if i == a.len {
            break
        }
        if a[i] == '"' {
            push(q, u8('\\'))
        }
        push(q, u8(a[i]))
        i = i + 1
    }
    push(q, u8('"'))
    return string_from_bytes(q)
}

/** *posix: `posix_spawnp` through the shim (it names `environ`); the pid, */
/** *or `0` when the program could not start. */
#[os("posix")]
fn start_child(file: string, argv: []i64) -> i64 {
    let mut pid = []i32 { 0 }
    if c_spawnp(pid, file, argv) != 0 {
        return i64(0)
    }
    return i64(pid[0])
}

/** *Windows: `_spawnvp(_P_NOWAIT, ...)`, the process handle or `0`. */
#[os("windows")]
fn start_child(file: string, argv: []i64) -> i64 {
    let h = c_spawnvp(1, file, argv)
    return if h == i64(-1) { i64(0) } else { h }
}

/** *posix: `waitpid`, retried only when a signal interrupted it (`EINTR` */
/** *is 4 on Linux and macOS). The exit code, or `-1` for a child a signal */
/** *killed or a failed wait (`WIFEXITED` spelled out, as in `exit_code`). */
#[os("posix")]
fn wait_child(id: i64) -> int {
    let mut st = []i32 { 0 }
    while c_waitpid(i32(id), st, 0) < 0 {
        if c_errno() != 4 {
            return -1
        }
    }
    if (st[0] & 127) != 0 {
        return -1
    }
    return int((st[0] >> 8) & 255)
}

/** *Windows: `_cwait` hands back the exit code itself. */
#[os("windows")]
fn wait_child(id: i64) -> int {
    let mut st = []i32 { 0 }
    if c_cwait(st, id, 0) == i64(-1) {
        return -1
    }
    return int(st[0])
}

/** *Lay a `char **` over `slots`: entry `i` points at `offsets[i]` in */
/** *`block`, then a NULL. The slots are storage only; Loam never reads them. */
#[os("posix", "windows")]
#[c("loam_sys_argv_fill")]
fn c_argv_fill(block: &[]u8, offsets: &[]i64, n: i64, slots: &mut []i64) {}

/** *`posix_spawnp(pid, file, NULL, NULL, argv, environ)`: `0` on success. */
#[os("posix")]
#[c("loam_sys_spawnp")]
fn c_spawnp(pid: &mut []i32, file: string, argv: &[]i64) -> i32 {}

/** *`_spawnvp` straight from the Windows CRT: a process handle or `-1`. */
#[os("windows")]
#[c("_spawnvp")]
fn c_spawnvp(mode: i32, file: string, argv: &[]i64) -> i64 {}

/** *`waitpid` straight from libc: the pid, or `-1` (see `c_errno`). */
#[os("posix")]
#[c("waitpid")]
fn c_waitpid(pid: i32, status: &mut []i32, options: i32) -> i32 {}

/** *`_cwait` straight from the Windows CRT: the handle, or `-1`. */
#[os("windows")]
#[c("_cwait")]
fn c_cwait(status: &mut []i32, h: i64, action: i32) -> i64 {}

/** *The calling thread's `errno`, for a retry that must know why. */
#[os("posix", "windows")]
#[c("loam_sys_errno")]
fn c_errno() -> i32 {}

/** *`spawn` then `wait`: the exit code, or `-1` if it could not start. */
fn run(argv: &[]string) -> int {
    let h = spawn(argv)
    if h < 0 {
        return 0 - 1
    }
    return wait(h)
}

/** *Read exactly `n` bytes of stdin (fewer only at end of input), unbuffered. */
fn read_stdin(n: int) -> string {
    return read_stdin_os(n)
}

/** *One line of stdin *including* its `\n`: `""` is end of input, `"\n"` a */
/** *blank line. Unbuffered, so it can be mixed with `read_stdin`. */
fn read_line() -> string {
    return read_line_os()
}

/** *Up to `n` bytes from the open descriptor `fd`: reads until `n` arrive or */
/** *the input ends, retrying when a signal interrupts. Fewer at end of input */
/** *or on an error; empty for a bad `fd`. Each byte is written once, never */
/** *zero-filled first. Native only. */
#[os("posix", "windows")]
fn read_fd(fd: int, n: int) -> []u8 {}

/** *Native `read_stdin`: one `read_fd` of fd 0, the buffer taken over as the */
/** *string without a copy. */
#[os("posix", "windows")]
fn read_stdin_os(n: int) -> string {
    stdin_binary()
    if n <= 0 {
        return ""
    }
    return string_from_bytes(read_fd(0, n))
}

/** *No stdin on wasm. */
#[os("wasm")]
fn read_stdin_os(n: int) -> string {
    return ""
}

/** *Native `read_line`: one byte per `read`, so not a byte past the `\n` is */
/** *taken from a stream another reader (or a child) shares. At most 8192 */
/** *bytes, as before. */
#[os("posix", "windows")]
fn read_line_os() -> string {
    stdin_binary()
    if stdin_byte.len == 0 {
        stdin_byte = buf.with_len(1)
    }
    // Emptied, not freed: its capacity carries over, so a line costs one
    // allocation (the copy out), as the C's stack buffer did.
    while line_buf.len > 0 {
        pop(line_buf)
    }
    while line_buf.len < 8192 {
        let r = read_byte()
        if r < 0 && c_errno() == 4 {
            // `EINTR` (4 on every target here): a signal, not the end.
            continue
        }
        if r <= 0 {
            break
        }
        let c = stdin_byte[0]
        push(line_buf, c)
        if c == u8('\n') {
            break
        }
    }
    return buf.to_string(&line_buf)
}

/** *`read_line`'s one-byte landing spot and line under construction, kept */
/** *between calls. Workers cannot reach `sys` (docs/threads.md), so no two */
/** *threads share them. */
let mut stdin_byte: []u8 = []u8 {}
let mut line_buf: []u8 = []u8 {}

/** *No stdin on wasm. */
#[os("wasm")]
fn read_line_os() -> string {
    return ""
}

/** *One byte of fd 0 into `stdin_byte`: `1`, `0` at end of input, `-1` on */
/** *an error. */
#[os("posix")]
fn read_byte() -> i64 {
    return c_read(0, stdin_byte, i64(1))
}

/** *Windows: `_read` takes an `unsigned` count and gives an `int`. */
#[os("windows")]
fn read_byte() -> i64 {
    return i64(c_read_win(0, stdin_byte, 1))
}

/** *`read` straight from libc (`size_t` in, `ssize_t` out). */
#[os("posix")]
#[c("read")]
fn c_read(fd: i32, b: &mut []u8, n: i64) -> i64 {}

/** *`_read` straight from the Windows CRT. */
#[os("windows")]
#[c("_read")]
fn c_read_win(fd: i32, b: &mut []u8, n: u32) -> i32 {}

/** *Whether stdin is in binary mode yet (Windows only needs it). */
let mut stdin_raw: bool = false

/** *posix stdin is bytes already. */
#[os("posix")]
fn stdin_binary() {
    return
}

/** *Windows: binary mode once (`_O_BINARY`), so no `\r\n` is rewritten. */
#[os("windows")]
fn stdin_binary() {
    if !stdin_raw {
        c_setmode(0, 32768)
        stdin_raw = true
    }
}

/** *`_setmode` straight from the Windows CRT. */
#[os("windows")]
#[c("_setmode")]
fn c_setmode(fd: i32, mode: i32) -> i32 {}

/** *True for an absolute path: `/x`, or on Windows `C:/x`, `C:\x`, `\\host\x`. */
fn is_abs(path: string) -> bool {
    if path.len == 0 {
        return false
    }
    if path[0] == '/' || path[0] == '\\' {
        return true
    }
    return path.len >= 3 && path[1] == ':' && (path[2] == '/' || path[2] == '\\') &&
        ((path[0] >= 'a' && path[0] <= 'z') || (path[0] >= 'A' && path[0] <= 'Z'))
}

/** *Create `path` and parents (`mkdir -p`). `0` on success. Native only; */
/** *wasm returns `1`. */
fn mkdir(path: string) -> int {
    return mkdir_os(path)
}

/** *Native `mkdir -p`: walk the path in Loam, one `mkdir` per level. `C:` is */
/** *a drive, not a directory to create. A level that fails with `EEXIST` (17 */
/** *on every target here) is already there; `errno`, not message text, which */
/** *would depend on the locale. */
#[os("posix", "windows")]
fn mkdir_os(path: string) -> int {
    let n = path.len
    let mut i = 1
    while i <= n {
        if i != n && path[i] != '/' && path[i] != '\\' {
            i = i + 1
            continue
        }
        // `C:` is a drive, not a directory to create.
        if i == 2 && path[1] == ':' {
            i = i + 1
            continue
        }
        let part = str.slice(path, 0, i)
        if part.len > 0 && mkdir_level(part) != 0 && c_errno() != 17 {
            return 1
        }
        i = i + 1
    }
    return 0
}

/** *No filesystem on wasm: nothing is created. */
#[os("wasm")]
fn mkdir_os(path: string) -> int {
    return 1
}

/** *One level, mode `0755`: `0` when it was created. */
#[os("posix")]
fn mkdir_level(path: string) -> i32 {
    return c_mkdir(path, 493)
}

/** *One level on Windows, where `_mkdir` takes no mode. */
#[os("windows")]
fn mkdir_level(path: string) -> i32 {
    return c_mkdir_win(path)
}

/** *`mkdir` straight from libc. */
#[os("posix")]
#[c("mkdir")]
fn c_mkdir(path: string, mode: i32) -> i32 {}

/** *`_mkdir` straight from the Windows CRT. */
#[os("windows")]
#[c("_mkdir")]
fn c_mkdir_win(path: string) -> i32 {}

/** *Rename `from` to `to`. `0` on success. Native only; wasm returns `1`. */
fn rename(from: string, to: string) -> int {
    return rename_os(from, to)
}

/** *Native `rename`: POSIX replaces the target; Windows refuses an existing */
/** *one, so the Loam side removes it first and retries, like the C did. */
#[os("posix", "windows")]
fn rename_os(from: string, to: string) -> int {
    if c_rename(from, to) == 0 {
        return 0
    }
    if c_remove(to) == 0 && c_rename(from, to) == 0 {
        return 0
    }
    return 1
}

/** *No filesystem on wasm: nothing is renamed. */
#[os("wasm")]
fn rename_os(from: string, to: string) -> int {
    return 1
}

/** *`rename` straight from libc: `0` when `to` names `from` now. */
#[os("posix", "windows")]
#[c("rename")]
fn c_rename(from: string, to: string) -> i32 {}

/** *Command-line argument count, the program path included. `0` on iOS, */
/** *Android and wasm, where no command line reaches the program. */
fn argc() -> int {}

/** *Argument `i` as the shell gave it: `arg(0)` is the program path. Empty when */
/** *`i` is out of range. Native only; wasm returns empty. */
fn arg(i: int) -> string {}

/** *Every argument, `arg(0)` first. The convenience form of `argc` / `arg`. */
fn args() -> []string {
    let mut out = []string {}
    for i in 0..argc() {
        push(out, arg(i))
    }
    return out
}

/** *`1` if `path` exists, whatever it is. Native only; wasm returns `0`. */
fn exists(path: string) -> int {
    return exists_os(path)
}

/** *Native `exists`: the `stat` shim says whether the path stats. */
#[os("posix", "windows")]
fn exists_os(path: string) -> int {
    let st = c_stat(path)
    return if st.tag == ResultTag.Err { 0 } else { 1 }
}

/** *No filesystem on wasm: nothing exists. */
#[os("wasm")]
fn exists_os(path: string) -> int {
    return 0
}

/** *`1` if `path` is a directory. Native only; wasm returns `0`. */
fn is_dir(path: string) -> int {
    return is_dir_os(path)
}

/** *Native `is_dir`: the shim's own directory slot. */
#[os("posix", "windows")]
fn is_dir_os(path: string) -> int {
    let st = c_stat(path)
    if st.tag == ResultTag.Err {
        return 0
    }
    return int(st.val[4])
}

/** *No filesystem on wasm: nothing is a directory. */
#[os("wasm")]
fn is_dir_os(path: string) -> int {
    return 0
}

/** *The canonical absolute spelling of an existing path (symlinks, `.` and */
/** *`..` resolved), or `""` when it does not exist. Native only; wasm */
/** *returns `""`. */
fn realpath(path: string) -> string {
    return realpath_os(path)
}

/** *`realpath(3)` straight from libc, into the caller's buffer (4096 bytes */
/** *covers `PATH_MAX` on every posix target), so libc allocates nothing. */
/** *`0` (NULL) when the path does not resolve. */
#[os("posix")]
#[c("realpath")]
fn c_realpath(path: string, resolved: &mut []u8) -> i64 {}

/** *posix `realpath`: resolve into a zeroed buffer, trimmed at the first */
/** *NUL. An empty path is `""`, as the C had it. */
#[os("posix")]
fn realpath_os(path: string) -> string {
    let mut resolved = buf.with_len(4096)
    if path.len == 0 || c_realpath(path, resolved) == 0 {
        return ""
    }
    return until_nul(resolved)
}

/** *Windows has no `realpath`: `_fullpath` makes the path absolute (without */
/** *touching the disk), so the answer is `/`-separated here and must exist. */
#[os("windows")]
fn realpath_os(path: string) -> string {
    let mut resolved = buf.with_len(4096)
    if path.len == 0 || c_fullpath(resolved, path, i64(4096)) == 0 {
        return ""
    }
    let full = forward_slashes(until_nul(resolved))
    return if exists_os(full) == 1 { full } else { "" }
}

/** *`_fullpath(absolute, relative, max)` straight from the Windows CRT. */
#[os("windows")]
#[c("_fullpath")]
fn c_fullpath(resolved: &mut []u8, path: string, max: i64) -> i64 {}

/** *A Windows path with its `\\` turned to `/`: paths are `/` on the Loam side, */
/** *which every Win32 file API accepts. */
#[os("windows")]
fn forward_slashes(p: string) -> string {
    let mut out = []u8 {}
    for i in 0..p.len {
        push(out, u8(if p[i] == '\\' { '/' } else { p[i] }))
    }
    return string_from_bytes(out)
}

/** *No filesystem on wasm: nothing resolves. */
#[os("wasm")]
fn realpath_os(path: string) -> string {
    return ""
}

/** *Number of entries in the directory `path`, `.` and `..` excluded. `0` when */
/** *`path` is not a readable directory. Native only; wasm returns `0`. */
fn dir_count(path: string) -> int {
    return dir_count_os(path)
}

/** *Native `dir_count`: one listing, freed at once. */
#[os("posix", "windows")]
fn dir_count_os(path: string) -> int {
    let t = dir_names_raw(path)
    if t.tag == ResultTag.Err {
        return 0
    }
    c_dir_free(t.val.ptr, t.val.n)
    return t.val.n
}

/** *No filesystem on wasm: no directory has entries. */
#[os("wasm")]
fn dir_count_os(path: string) -> int {
    return 0
}

/** *Entry `i` of `path`, sorted by name, as a fresh string — a caller that keeps */
/** *it keeps its own copy. Empty when `i` is out of range. Native only; wasm */
/** *returns empty. */
fn dir_entry(path: string, i: int) -> string {
    return dir_entry_os(path, i)
}

/** *Native `dir_entry`: one listing, freed at once. The rescan-per-call costs */
/** *what the C paid: directories here are small, and no stale cache can lie. */
#[os("posix", "windows")]
fn dir_entry_os(path: string, i: int) -> string {
    let names = list_dir_os(path)
    if i < 0 || i >= names.len {
        return ""
    }
    return names[i]
}

/** *No filesystem on wasm: no directory has entries. */
#[os("wasm")]
fn dir_entry_os(path: string, i: int) -> string {
    return ""
}

/** *Every entry of `path`, sorted. The convenience form of `dir_count` / */
/** *`dir_entry`. */
fn list_dir(path: string) -> []string {
    return list_dir_os(path)
}

/** *Native `list_dir`: the shim's names, insertion-sorted in Loam by byte order */
/** *(what `strcmp` orders), because a walk visits the same tree in the same */
/** *order every time. A directory here holds tens of entries. */
#[os("posix", "windows")]
fn list_dir_os(path: string) -> []string {
    let t = dir_names_raw(path)
    if t.tag == ResultTag.Err {
        return []string {}
    }
    let mut out = []string {}
    for i in 0..t.val.n {
        push(out, c_dir_name(t.val.ptr, i64(i)))
    }
    c_dir_free(t.val.ptr, t.val.n)
    // Insertion sort, the C shape: tens of entries, no second dependency.
    for i in 1..out.len {
        let key = out[i]
        let mut j = i - 1
        while j >= 0 && c_strcmp(out[j], key) > 0 {
            out[j + 1] = out[j]
            j = j - 1
        }
        out[j + 1] = key
    }
    return out
}

/** *No filesystem on wasm: every listing is empty. */
#[os("wasm")]
fn list_dir_os(path: string) -> []string {
    return []string {}
}

/** *One `opendir`/`readdir` pass: the C array's address as an `i64` and its */
/** *length. The dirent layout never crosses into Loam. */
#[os("posix", "windows")]
#[c("loam_dir_names")]
fn c_dir_names(path: string, out: &mut []i64) -> i64 {}

/** *One name out of the listing: a fresh string, so the caller keeps its own */
/** *copy after the array is freed. */
#[os("posix", "windows")]
#[c("loam_dir_name_at")]
fn c_dir_name(names: i64, i: i64) -> string {}

/** *Free the listing and its names. */
#[os("posix", "windows")]
#[c("loam_dir_free")]
fn c_dir_free(names: i64, n: int) {}

/** *`strcmp` straight from libc: byte order for the directory sort. */
#[os("posix", "windows")]
#[c("strcmp")]
fn c_strcmp(a: string, b: string) -> i32 {}

/** *A directory listing in hand: the C array as an `i64`, its length, and the */
/** *freedom to read it. Freed by the caller (`dir_count`, `list_dir`). */
struct DirNames {
    ptr: i64,
    n: int,
}

/** *The shim's listing, or the reason it failed. A one-slot `[]i64` carries */
/** *the `char**` across, as a `FILE*` crosses as an `i64`. */
#[os("posix", "windows")]
fn dir_names_raw(path: string) -> Result<DirNames> {
    let mut slot = []i64 { 0 }
    let n = c_dir_names(path, slot)
    if slot[0] == 0 {
        return res_err(c_strerror(), DirNames { ptr: 0, n: 0 })
    }
    return res_ok(DirNames { ptr: slot[0], n: int(n) })
}

/** *Remove `path`, recursing into a directory. `0` on success, including when */
/** *`path` is already gone. Native only; wasm returns `1`. */
fn remove_path(path: string) -> int {
    return remove_path_os(path)
}

/** *Native `remove_path`: the `lstat`-and-recurse walk in Loam. Symlinks are */
/** *never followed (`lstat`, not `stat`): a linked directory removes the link, */
/** *not its target. Paths are `/` on every side, and overlong children are */
/** *skipped as before. */
#[os("posix", "windows")]
fn remove_path_os(path: string) -> int {
    let st = c_lstat(path)
    if st.tag == ResultTag.Err {
        return 0
    }
    if st.val[1] != 0 {
        let t = dir_names_raw(path)
        if t.tag == ResultTag.Ok {
            for i in 0..t.val.n {
                let child = c_dir_name(t.val.ptr, i64(i))
                let sub = "{{path}}/{{child}}"
                if sub.len < 4096 {
                    remove_path_os(sub)
                }
            }
            c_dir_free(t.val.ptr, t.val.n)
        }
        return c_rmdir(path)
    }
    return c_remove(path)
}

/** *No filesystem on wasm: nothing is removed. */
#[os("wasm")]
fn remove_path_os(path: string) -> int {
    return 1
}

/** *One `lstat(2)`: like `c_stat` but never follows a symlink. Slots */
/** *(exists, is-dir); `0` when the path is gone. */
#[os("posix", "windows")]
#[c("loam_sys_lstat")]
fn c_lstat_raw(path: string, out: &mut []i64) -> i32 {}

/** *The `lstat` shim's two slots. */
#[os("posix", "windows")]
fn c_lstat(path: string) -> Result<[]i64> {
    let mut out = []i64 { 0, 0 }
    // No caller reads why: a miss is just a miss, so no message is built.
    if c_lstat_raw(path, out) == 0 {
        return res_err("", out)
    }
    return res_ok(out)
}

/** *`rmdir` straight from libc: `0` when the directory went. */
#[os("posix", "windows")]
#[c("rmdir")]
fn c_rmdir(path: string) -> i32 {}

/** *`remove` straight from libc: `0` when the file went. */
#[os("posix", "windows")]
#[c("remove")]
fn c_remove(path: string) -> i32 {}

/** *The process's working directory, absolute. Empty when it cannot be read, and */
/** *on wasm, where there is none. */
fn cwd() -> string {
    return cwd_os()
}

/** *posix `cwd`: `getcwd` into a `with_len` buffer, trimmed at the first NUL */
/** *(a path cannot hold one, and the buffer is zeroed). */
#[os("posix")]
fn cwd_os() -> string {
    let mut cwd = buf.with_len(4096)
    if c_getcwd(cwd, i64(4096)) == 0 {
        return ""
    }
    return until_nul(cwd)
}

/** *Windows `cwd`: `_getcwd`, then `/` for `\\`. */
#[os("windows")]
fn cwd_os() -> string {
    let mut cwd = buf.with_len(4096)
    if c_getcwd_win(cwd, i32(4096)) == 0 {
        return ""
    }
    return forward_slashes(until_nul(cwd))
}

/** *The bytes of a C-filled buffer up to its first NUL, as a string. */
#[os("posix", "windows")]
fn until_nul(b: []u8) -> string {
    let mut n = 0
    while n < b.len && b[n] != 0 {
        n = n + 1
    }
    let mut out = []u8 {}
    for i in 0..n {
        push(out, b[i])
    }
    return string_from_bytes(out)
}

/** *No filesystem on wasm: there is no directory. */
#[os("wasm")]
fn cwd_os() -> string {
    return ""
}

/** *`getcwd` straight from libc: the path bytes in `buf`, or NULL. */
#[os("posix")]
#[c("getcwd")]
fn c_getcwd(buf: &mut []u8, n: i64) -> i64 {}

/** *`_getcwd` straight from the Windows CRT (its size is an `int`). */
#[os("windows")]
#[c("_getcwd")]
fn c_getcwd_win(buf: &mut []u8, n: i32) -> i64 {}

/** *Open a filesystem watcher, for the paths `watch_add` is then given. Returns a */
/** *handle (> 0), or `0` when this host has no kernel watcher: macOS and iOS */
/** *have kqueue and Linux has inotify; Windows, Android, wasm and other Unix */
/** *poll instead. */
fn watch_open() -> int {
    return watch_open_os()
}

/** *Watch one path — a directory or a file — under `handle`. Returns a */
/** *registration id (> 0) the caller closes with `watch_close`. `0` when the */
/** *path cannot be watched. */
/** */
/** *The id is the caller's to keep: the mapping from id back to path is the */
/** *caller's business. */
fn watch_add(handle: int, path: string) -> int {
    return watch_add_os(handle, path)
}

/** *Wait for one change, and return the id of the watcher that fired — or `0` */
/** *when nothing happened in time. */
/** */
/** *`timeout_ms` follows `poll(2)`: negative blocks until something changes, `0` */
/** *returns at once, positive waits at most that long. Block with a negative */
/** *value for the first event of a burst, then drain the rest with `0`. */
/** */
/** *A file fires when its contents change. A directory fires when an entry inside */
/** *it is added, removed or renamed — so a caller that wants the *name* of a new */
/** *file has to list the directory it was handed. */
fn watch_next(handle: int, timeout_ms: int) -> int {
    return watch_next_os(handle, timeout_ms)
}

/** *Close a handle from `watch_open` or an id from `watch_add`. Returns `0`. */
fn watch_close(fd: int) -> int {
    return watch_close_os(fd)
}

// --- kqueue (macOS, iOS) ------------------------------------------------
//
// One `kevent` per call and no state: the id is the watched path's own
// descriptor. `struct kevent` is 32 bytes on Apple's 64-bit targets: ident
// (8), filter (2), flags (2), fflags (4), data (8), udata (8), so it is four
// `i64` slots, the second holding filter, flags and fflags little-endian.

/** *macOS / iOS: a kqueue, or `0`. */
#[os("apple")]
fn watch_open_os() -> int {
    let kq = c_kqueue()
    return if kq < 0 { 0 } else { int(kq) }
}

/** *Open `path` and register it with the queue; its descriptor is the id. */
/** *`O_CLOEXEC` keeps it out of the `sh` children `sys.exec` spawns. Not */
/** *`NOTE_ATTRIB`: a write also changes the metadata, which kqueue reports */
/** *as a second, later event, waking a reload twice for one save. */
#[os("apple")]
fn watch_add_os(handle: int, path: string) -> int {
    if handle <= 0 || path.len == 0 || path.len >= 4096 {
        return 0
    }
    // O_RDONLY | O_CLOEXEC (0x1000000 in Apple's fcntl.h).
    let fd = c_open_watched(path, 16777216)
    if fd < 0 {
        return 0
    }
    // EVFILT_VNODE (-4, as u16 0xfffc), EV_ADD | EV_CLEAR (0x21) and
    // NOTE_WRITE | NOTE_DELETE | NOTE_RENAME (0x23), laid out as above.
    let change = []i64 { i64(fd), i64(35) * i64(4294967296) + i64(33) * i64(65536) + i64(65532), i64(0), i64(0) }
    if c_kevent_add(i32(handle), change, 1, i64(0), 0, i64(0)) < 0 {
        c_close(fd)
        return 0
    }
    return int(fd)
}

/** *The id whose vnode fired, or `0`: one event per call, so the caller */
/** *batches a burst. */
#[os("apple")]
fn watch_next_os(handle: int, timeout_ms: int) -> int {
    if handle <= 0 {
        return 0
    }
    if kevent_slots.len == 0 {
        kevent_slots = []i64 { i64(0), i64(0), i64(0), i64(0) }
        timespec_slots = []i64 { i64(0), i64(0) }
    }
    let mut n = 0
    if timeout_ms < 0 {
        n = int(c_kevent_block(i32(handle), i64(0), 0, kevent_slots, 1, i64(0)))
    } else {
        timespec_slots[0] = i64(timeout_ms / 1000)
        timespec_slots[1] = i64(timeout_ms % 1000) * i64(1000000)
        n = int(c_kevent_wait(i32(handle), i64(0), 0, kevent_slots, 1, timespec_slots))
    }
    return if n <= 0 { 0 } else { int(kevent_slots[0]) }
}

/** *`watch_next`'s event and timeout, kept between calls (a drain asks */
/** *thousands of times); workers cannot reach `sys`, so nothing shares them. */
let mut kevent_slots: []i64 = []i64 {}
let mut timespec_slots: []i64 = []i64 {}

/** *A queue and an id are both descriptors. */
#[os("apple")]
fn watch_close_os(fd: int) -> int {
    if fd > 0 {
        c_close(i32(fd))
    }
    return 0
}

/** *`kqueue` straight from libc. */
#[os("apple")]
#[c("kqueue")]
fn c_kqueue() -> i32 {}

/** *`open(path, flags)` straight from libc (no mode: nothing is created). */
#[os("apple")]
#[c("open")]
fn c_open_watched(path: string, flags: i32) -> i32 {}

/** *`kevent` registering one change (no event list, no timeout: `0` is NULL). */
#[os("apple")]
#[c("kevent")]
fn c_kevent_add(kq: i32, changes: &[]i64, n: i32, events: i64, nevents: i32, timeout: i64) -> i32 {}

/** *`kevent` waiting for one event at most `timeout` (a `struct timespec`). */
#[os("apple")]
#[c("kevent")]
fn c_kevent_wait(kq: i32, changes: i64, n: i32, events: &mut []i64, nevents: i32, timeout: &[]i64) -> i32 {}

/** *`kevent` waiting for one event with no timeout (NULL). */
#[os("apple")]
#[c("kevent")]
fn c_kevent_block(kq: i32, changes: i64, n: i32, events: &mut []i64, nevents: i32, timeout: i64) -> i32 {}

/** *`close` straight from libc. */
#[os("posix")]
#[c("close")]
fn c_close(fd: i32) -> i32 {}

// --- inotify (Linux) -----------------------------------------------------
//
// inotify names a watch by a small number inside its handle, not by a
// descriptor of its own, so an id here packs both: handle * 2^20 + watch.
// `watch_close` can then tell an id from a handle (ids are >= 2^20) and needs
// no table. One `read` can bring several events; the ones not yet returned
// wait in `watch_queue_*`, so `watch_next` still answers one per call, and a
// repeat of an id already waiting is dropped, as kqueue's EV_CLEAR folds it.

/** *Two to the twentieth: the stride between handles in an inotify id. */
const WATCH_STRIDE: int = 1048576

/** *Events read but not returned yet: the handle and the id of each. */
let mut watch_queue_handles: []int = []int {}
let mut watch_queue_ids: []int = []int {}

/** *Linux: an inotify descriptor (`IN_CLOEXEC`), or `0`. */
#[os("linux")]
fn watch_open_os() -> int {
    let fd = c_inotify_init1(524288)
    // An id must fit `int`: handle * 2^20 stays below 2^31.
    if fd >= 2048 {
        c_close(fd)
        return 0
    }
    return if fd < 0 { 0 } else { int(fd) }
}

/** *Watch `path`: its contents changed (`IN_MODIFY`), it went away */
/** *(`IN_DELETE_SELF`, `IN_MOVE_SELF`), or an entry inside it came, went or */
/** *moved (`IN_CREATE`, `IN_DELETE`, `IN_MOVED_FROM`, `IN_MOVED_TO`) — what */
/** *the kqueue variant reports for a file and a directory alike. */
#[os("linux")]
fn watch_add_os(handle: int, path: string) -> int {
    if handle <= 0 || path.len == 0 || path.len >= 4096 {
        return 0
    }
    let mask = u32(2) | u32(1024) | u32(2048) | u32(256) | u32(512) | u32(64) | u32(128)
    let wd = c_inotify_add_watch(i32(handle), path, mask)
    if wd <= 0 || int(wd) >= WATCH_STRIDE {
        return 0
    }
    return handle * WATCH_STRIDE + int(wd)
}

/** *The next waiting id of `handle`, else one `poll` for up to `timeout_ms` */
/** *and one `read` of whatever arrived. */
#[os("linux")]
fn watch_next_os(handle: int, timeout_ms: int) -> int {
    if handle <= 0 {
        return 0
    }
    let waiting = watch_take(handle)
    if waiting != 0 {
        return waiting
    }
    // `struct pollfd`: fd (4 bytes), events = POLLIN (2), revents (2).
    let mut fds = []i64 { i64(handle) + i64(1) * i64(4294967296) }
    if c_poll(fds, i64(1), i32(timeout_ms)) <= 0 {
        return 0
    }
    let mut bytes = buf.with_len(4096)
    let n = int(c_read(i32(handle), bytes, i64(4096)))
    // `struct inotify_event`: wd (4), mask (4), cookie (4), len (4), name.
    let mut at = 0
    while n > 0 && at + 16 <= n {
        let wd = le32(bytes, at)
        let mask = le32(bytes, at + 4)
        // IN_IGNORED (0x8000): the watch is gone, nothing changed.
        if wd > 0 && (mask & 32768) == 0 {
            watch_queue(handle, handle * WATCH_STRIDE + wd)
        }
        at = at + 16 + le32(bytes, at + 12)
    }
    return watch_take(handle)
}

/** *An id drops its watch; a handle closes, and its waiting events go. */
#[os("linux")]
fn watch_close_os(fd: int) -> int {
    if fd >= WATCH_STRIDE {
        c_inotify_rm_watch(i32(fd / WATCH_STRIDE), i32(fd % WATCH_STRIDE))
        watch_forget(fd, false)
    } else if fd > 0 {
        c_close(i32(fd))
        watch_forget(fd, true)
    }
    return 0
}

/** *Little-endian 32 bits of `b` at `at`, as the kernel wrote them (the */
/** *values read here are small and positive). */
#[os("linux")]
fn le32(b: []u8, at: int) -> int {
    return int(b[at]) | (int(b[at + 1]) << 8) | (int(b[at + 2]) << 16) | (int(b[at + 3] & u8(127)) << 24)
}

/** *Queue `id` under `handle`, unless it is already waiting. */
#[os("linux")]
fn watch_queue(handle: int, id: int) {
    for i in 0..watch_queue_ids.len {
        if watch_queue_ids[i] == id {
            return
        }
    }
    push(watch_queue_handles, handle)
    push(watch_queue_ids, id)
}

/** *The first waiting id of `handle`, removed, or `0`. */
#[os("linux")]
fn watch_take(handle: int) -> int {
    let mut found = 0
    let mut handles = []int {}
    let mut ids = []int {}
    for i in 0..watch_queue_ids.len {
        if found == 0 && watch_queue_handles[i] == handle {
            found = watch_queue_ids[i]
        } else {
            push(handles, watch_queue_handles[i])
            push(ids, watch_queue_ids[i])
        }
    }
    watch_queue_handles = handles
    watch_queue_ids = ids
    return found
}

/** *Drop the waiting events of one id, or (`handle`) of a whole handle. */
#[os("linux")]
fn watch_forget(fd: int, handle: bool) {
    let mut handles = []int {}
    let mut ids = []int {}
    for i in 0..watch_queue_ids.len {
        let gone = if handle { watch_queue_handles[i] == fd } else { watch_queue_ids[i] == fd }
        if !gone {
            push(handles, watch_queue_handles[i])
            push(ids, watch_queue_ids[i])
        }
    }
    watch_queue_handles = handles
    watch_queue_ids = ids
}

/** *`inotify_init1` straight from libc. */
#[os("linux")]
#[c("inotify_init1")]
fn c_inotify_init1(flags: i32) -> i32 {}

/** *`inotify_add_watch` straight from libc: a watch number, or `-1`. */
#[os("linux")]
#[c("inotify_add_watch")]
fn c_inotify_add_watch(fd: i32, path: string, mask: u32) -> i32 {}

/** *`inotify_rm_watch` straight from libc. */
#[os("linux")]
#[c("inotify_rm_watch")]
fn c_inotify_rm_watch(fd: i32, wd: i32) -> i32 {}

/** *`poll` straight from libc (`nfds_t` is 8 bytes on Linux). */
#[os("linux")]
#[c("poll")]
fn c_poll(fds: &mut []i64, n: i64, timeout_ms: i32) -> i32 {}

// --- no kernel watcher ---------------------------------------------------

/** *Windows, Android, wasm and other Unix: no watcher, so a caller polls. */
#[os("windows", "android", "wasm", "other")]
fn watch_open_os() -> int {
    return 0
}

/** *No watcher: nothing is watched. */
#[os("windows", "android", "wasm", "other")]
fn watch_add_os(handle: int, path: string) -> int {
    return 0
}

/** *No watcher: nothing fires. */
#[os("windows", "android", "wasm", "other")]
fn watch_next_os(handle: int, timeout_ms: int) -> int {
    return 0
}

/** *No watcher: nothing to close. */
#[os("windows", "android", "wasm", "other")]
fn watch_close_os(fd: int) -> int {
    return 0
}
