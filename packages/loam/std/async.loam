// `async` — timers, spawn, and the one-thread async pump (std:async).
//
// The UI thread is the only thread (§5.1). Everything here runs **on** it:
// queues and dispatch are plain Loam state; the C seam is only a monotonic
// clock (`now_ms`) and a blocking `sleep` (console/headless loops).
//
// ```
// import "std:async"
//
// let id = async.after(30, || { tick.set(tick.get() + 1) })
// let iv = async.interval(1000, || { pings.set(pings.get() + 1) })
// // later:
// async.cancel(iv)
// ```
//
// A UI app never calls `tick` by hand: the zeus engine runs it at the top of
// every frame (`engine_layout`), and `engine_step` keeps frames flowing while
// async work is in flight. Console programs pump explicitly:
//
// ```
// while !done {
//     async.tick()
//     async.sleep(1)
// }
// ```
//
// `after(ms, cb)` / `interval(ms, cb)` schedule `cb` on the UI thread; the
// callback may read or set signals, so a label fed by a signal updates on
// the next paint. `spawn(cb)` runs `cb` at the start of the next tick — the
// "fake async op" of headless tests. `add_step(f)` registers a per-frame
// stepper (the http async client registers its socket state machines here);
// `io_open` / `io_close` keep `busy()` true while an op is in flight so the
// hosts keep drawing frames until it completes.
//
// CPU-bound work that must not block this pump runs on `std:thread` workers;
// `busy()` includes their liveness, so the hosts keep drawing frames until
// every worker is done and its result channel is drained.

import "std:thread"

struct Timer {
    id: int,
    at: i64,
    every: int,
    cb: fn(),
}

/** *A single-use mailbox: created by `future` / `future_str`, filled by */
/** *`resolve`, drained by `await_value` (the `await` sugar). `T` must be Copy */
/** *(`int`, `string`, `float`, `bool`, `[]U` when `U` is Copy, or a Copy struct). */
/** */
/** *`#[no_send]`: the cell lives in the UI-thread async store, like a */
/** *`Signal<T>` lives in the signal arena. It is plain bytes (`{ id: int }`), so */
/** *the structural Send rule would otherwise let a worker capture it; the marker */
/** *makes that a compile error. Workers return results through a `Chan<T>` */
/** *instead (see `std:thread`). */
#[no_send]
struct Future<T> {
    id: int,
}

/** *Monotonic milliseconds (host clock). i64: epoch millis overflow i32 in ~24 */
/** *days (§3.6). Native: `clock_gettime(CLOCK_MONOTONIC)` through one raw */
/** *binding (a two-slot `[]i64` carries the `struct timespec`, as the `pollfd` */
/** *in `sys.watch_next_os` carries a struct); wasm: the JS clock. */
fn now_ms() -> i64 {
    return now_ms_os()
}

/** *Native `now_ms`: two C words, `sec` then `nsec`, out of `clock_gettime`. */
#[os("posix", "windows")]
fn now_ms_os() -> i64 {
    let mut ts = []i64 { 0, 0 }
    if c_clock_gettime(c_clock_monotonic(), ts) != 0 {
        return 0
    }
    return ts[0] * 1000 + ts[1] / 1000000
}

/** *No libc clock on wasm: the JS host clock, through a header bridge (a */
/** *`#[c]` binding cannot reach a wasm build at all; a bodyless `#[os]` hook */
/** *resolves to C like `sys.wasm_exit` does). */
#[os("wasm")]
fn now_ms_os() -> i64 {
    return wasm_now_ms()
}

/** *The wasm `now_ms` bridge in `loam_rt.h` (over the `zeus_js_now_ms` host */
/** *import), like `sys.wasm_exit` bridges `abort`. */
#[os("wasm")]
fn wasm_now_ms() -> i64 {}

/** *CLOCK_MONOTONIC on the Darwin clocks (macOS, iOS): 6. */
#[os("apple")]
fn c_clock_monotonic() -> i32 {
    return 6
}

/** *CLOCK_MONOTONIC on Linux, Android, other Unix and Windows: 1. */
#[os("linux", "android", "other", "windows")]
fn c_clock_monotonic() -> i32 {
    return 1
}

/** *`clock_gettime` straight from libc: `sec` then `nsec` through a two-slot */
/** *`[]i64` (see `sys.watch_next_os`'s `pollfd` for the shape). `0` on */
/** *success, as before. */
#[os("posix", "windows")]
#[c("clock_gettime")]
fn c_clock_gettime(clk: i32, ts: &mut []i64) -> i32 {}

/** *Block the calling thread for `ms`. Console/headless only — never in UI */
/** *code; use `after` there. Native: `nanosleep` with EINTR retry, through one */
/** *raw binding; wasm: the JS spin. */
fn sleep(ms: int) {
    sleep_os(ms)
}

/** *Native `sleep`: whole `ms` even when a signal interrupts the wait. */
#[os("posix", "windows")]
fn sleep_os(ms: int) {
    if ms <= 0 {
        return
    }
    let mut req = []i64 { i64(ms / 1000), i64(ms % 1000) * 1000000 }
    let mut rem = []i64 { 0, 0 }
    while c_nanosleep(req, rem) != 0 && c_sleep_errno() == 4 {
        req[0] = rem[0]
        req[1] = rem[1]
    }
}

/** *`nanosleep` straight from libc: two words each way (`sec`, `nsec`), `0` */
/** *when the whole wait elapsed. EINTR is 4 on Linux and macOS, and Windows */
/** *sleeps through `nanosleep` the same way (its shim returns EINTR likewise). */
#[os("posix", "windows")]
#[c("nanosleep")]
fn c_nanosleep(req: &[]i64, rem: &mut []i64) -> i32 {}

/** *The calling thread's `errno`, so the retry above only repeats on EINTR. */
/** *`sys` keeps its own `c_errno`; a `#[c]` fn is private to its module, so */
/** *`async` binds the same symbol itself. */
#[os("posix", "windows")]
#[c("loam_sys_errno")]
fn c_sleep_errno() -> i32 {}

/** *No libc sleep on wasm: the same JS spin the runtime busy-waited. */
#[os("wasm")]
fn sleep_os(ms: int) {
    wasm_sleep(i64(ms))
}

/** *The wasm `sleep` bridge in `loam_rt.h` (a spin on the JS clock). */
#[os("wasm")]
fn wasm_sleep(ms: i64) {}

let mut timers: []Timer = []Timer {}
let mut next_tid: int = 1
let mut spawns: []fn() = []fn() {}
let mut steps: []fn() = []fn() {}
let mut io_ops: int = 0

/** *Run `cb` once, `ms` from now, on the UI thread. Returns a handle for */
/** *`cancel`. A UI app: the host wakes to run it even while idle. */
fn after(ms: int, cb: fn()) -> int {
    let id = next_tid
    next_tid = next_tid + 1
    if next_tid <= 0 {
        next_tid = 1
    }
    let mut d = ms
    if d < 0 {
        d = 0
    }
    push(timers, Timer { id: id, at: now_ms() + i64(d), every: 0, cb: cb })
    return id
}

/** *Run `cb` every `ms`, on the UI thread, until `cancel`ed. */
fn interval(ms: int, cb: fn()) -> int {
    let id = next_tid
    next_tid = next_tid + 1
    if next_tid <= 0 {
        next_tid = 1
    }
    let mut d = ms
    if d < 1 {
        d = 1
    }
    push(timers, Timer { id: id, at: now_ms() + i64(d), every: d, cb: cb })
    return id
}

/** *Drop a timer or interval. No-op for unknown ids. */
fn cancel(id: int) {
    if timers.len == 0 {
        return
    }
    let mut keep = []Timer {}
    let n = timers.len
    for i in 0..n {
        if timers[i].id != id {
            push(keep, timers[i])
        }
    }
    timers = keep
}

/** *Run `cb` on the UI thread at the start of the next `tick` (next frame). */
fn spawn(cb: fn()) {
    push(spawns, cb)
}

/** *Register a per-frame stepper. Steps run at the top of every tick, in */
/** *registration order, before spawns and timers. */
fn add_step(f: fn()) {
    push(steps, f)
}

/** *Mark one async op in flight (the http client does this per call). */
fn io_open() {
    io_ops = io_ops + 1
}

/** *Mark one async op finished. Paired with `io_open`. */
fn io_close() {
    if io_ops > 0 {
        io_ops = io_ops - 1
    }
}

/** *Whether the engine should keep drawing frames: an op is in flight (its */
/** *completion is not time-scheduled), a spawn waits for the next tick, or a */
/** *`thread.spawn`ed worker is still running. */
fn busy() -> int {
    if io_ops > 0 {
        return 1
    }
    if spawns.len > 0 {
        return 1
    }
    if thread.running() > 0 {
        return 1
    }
    return 0
}

/** *Milliseconds until the next timer is due, for hosts that sleep while idle: */
/** *0 = no timer pending. `-1` = a spawn is waiting, draw a frame now. */
fn next_due() -> int {
    if spawns.len > 0 {
        return -1
    }
    let n = timers.len
    if n == 0 {
        return 0
    }
    let now = now_ms()
    let mut soon = 0
    for i in 0..n {
        let mut d = i32(timers[i].at - now)
        if d < 1 {
            d = 1
        }
        if soon == 0 || d < soon {
            soon = d
        }
    }
    return soon
}

/** *Advance the async world one frame: run steppers (in-flight socket state */
/** *machines), then spawns, then timers that are due. Callbacks run on this */
/** *(the UI) thread. The zeus engine calls this at the top of every */
/** *`engine_layout`; console programs call it from their own loop. */
fn tick() {
    let mut n = steps.len
    for i in 0..n {
        steps[i]()
    }
    // Spawns fire once, in order; ones added by a callback wait for the next
    // tick (they are past the snapshot).
    n = spawns.len
    if n > 0 {
        let mut run = []fn() {}
        for i in 0..n {
            push(run, spawns[i])
        }
        let mut rest = []fn() {}
        let k = spawns.len
        for i in n..k {
            push(rest, spawns[i])
        }
        spawns = rest
        for i in 0..n {
            run[i]()
        }
    }
    let nt = timers.len
    if nt == 0 {
        return
    }
    let now = now_ms()
    // Snapshot the due ids; a callback that cancels/fires before its turn
    // must not run. Re-arm or remove happens before the callback runs, so a
    // repeating timer that schedules from its own callback cannot double-arm.
    let mut due = []int {}
    for i in 0..nt {
        if timers[i].at <= now {
            push(due, timers[i].id)
        }
    }
    let nd = due.len
    for i in 0..nd {
        let id = due[i]
        let mut idx = -1
        let mut j = 0
        let m = timers.len
        while j < m {
            if timers[j].id == id {
                idx = j
            }
            j = j + 1
        }
        if idx >= 0 {
            if timers[idx].at <= now_ms() {
                let every = timers[idx].every
                let cb = timers[idx].cb
                if every > 0 {
                    timers[idx].at = now_ms() + i64(every)
                } else {
                    let mut keep = []Timer {}
                    let m2 = timers.len
                    for j2 in 0..m2 {
                        if j2 != idx {
                            push(keep, timers[j2])
                        }
                    }
                    timers = keep
                }
                cb()
            }
        }
    }
}

// --- Futures: `await`-able typed mailboxes ---------------------------
// The `await expr` syntax in an `async fn` is sugar for `await_value(expr)`
// (see parser.c). Awaiting re-enters the one-thread pump: timers, spawns,
// and the http socket steppers keep running until `resolve` fills the
// mailbox, then the value returns. UI code that must stay repaint-reactive
// should keep using callbacks; `await` fits startup sequences and headless
// flows (the counter app fetches before its App starts).
//
// The store lives here, not in the runtime header (docs/runtime-in-loam.md,
// R3.1): one `[]u8` arena plus parallel slot metadata. Codegen lowers the
// `__fut_*` builtins to per-type byte moves through `fut_arena_*` + `memcpy`
// (see `builtin_call`), so a heterogeneous `T` never crosses Loam as a value.
// S0 typed cells hold: the slot records `handle_key(T)` at push (the key is
// FNV-1a over the type's spelling, never 0), and every access passes the key
// it expects — a mismatch panics, as the `handle_forge_future` trap proves.
// UI-thread only, like the signal arena: `__fut_*` on a worker is a compile
// error (threadcheck), so no lock.

/** *One future slot: byte range in the arena, readiness, and the S0 type key. */
struct FutSlot {
    off: int,
    len: int,
    ready: int,
    key: i64,
}

/** *The mailbox store: payload bytes plus one slot per `future`. */
let mut fut_data: []u8 = []u8 {}
let mut fut_slots: []FutSlot = []FutSlot {}

/** *A fresh slot id holding `n` zeroed bytes under `key`, unreadied. */
fn fut_alloc(n: int, key: i64) -> int {
    let off = fut_data.len
    let mut i = 0
    while i < n {
        push(fut_data, u8(0))
        i = i + 1
    }
    push(fut_slots, FutSlot { off: off, len: n, ready: 0, key: key })
    return fut_slots.len - 1
}

/** *`1` when `id` names a live slot. Dead ids read zeroed, as before. */
fn fut_live(id: int) -> int {
    return if id >= 0 && id < fut_slots.len { 1 } else { 0 }
}

/** *`1` when `id` is live and resolved. A forged id is never ready. */
fn fut_is_ready(id: int) -> int {
    if fut_live(id) == 0 {
        return 0
    }
    return fut_slots[id].ready
}

/** *Unready `id` (a no-op on a dead id). */
fn fut_unready(id: int) {
    if fut_live(id) != 0 {
        fut_slots[id].ready = 0
    }
}

/** *Mark `id` resolved, after codegen checks `key` and moved the bytes. */
fn fut_mark_ready(id: int) {
    fut_slots[id].ready = 1
}

/** *The S0 key check, in Loam: `id` must be live and keyed `key`. A forged */
/** *id or a mismatched `T` panics, naming the handle kind as before. */
fn fut_check(id: int, key: i64) {
    if fut_live(id) == 0 {
        panic("future handle used at the wrong type")
    }
    if fut_slots[id].key != key {
        panic("future handle used at the wrong type")
    }
}

/** *The arena itself, for codegen's per-type byte moves (a `[]u8` shares its */
/** *buffer, so no bytes copy; the caller drops its handle). */
fn fut_arena() -> []u8 {
    return fut_data
}

/** *Slot `id`'s byte offset in the arena. */
fn fut_off(id: int) -> int {
    return fut_slots[id].off
}

/** *Allocate a fresh future. `init` is the value until `resolve` fills it */
/** *(and the timeout fallback if the mailbox never resolves). */
fn future<T>(init: T) -> Future<T> {
    return Future { id: __fut_push(init) }
}

/** *Allocate a fresh string future (RPC bodies, `http.async_call`). */
fn future_str() -> Future<string> {
    return future("")
}

/** *Resolve `f` with `v`; an `await_value` pumping on it returns next tick. */
fn resolve<T>(f: Future<T>, v: T) {
    __fut_store(f.id, v)
}

/** *Wait for `f` while pumping the async world. Bounded (~20s at 1ms ticks) */
/** *so a never-resolved future fails instead of hanging the process. */
fn await_value<T>(f: Future<T>) -> T {
    let mut guard = 0
    while guard < 20000 {
        if __fut_ready(f.id) != 0 {
            let v: T = __fut_load(f.id)
            __fut_clear(f.id)
            return v
        }
        tick()
        sleep(1)
        guard = guard + 1
    }
    return __fut_load(f.id)
}
