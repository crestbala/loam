// `fmt` — write to stdout, or stderr (`eprintln`). No heap, no printf, no C strings.
//
// Import it, then call `fmt.println` with any mix of `string`, `int`, `bool`, and `float`.
//
// Example:
// ```
// import "std:fmt"
//
// fn main() {
//     fmt.println("hello,", 42, true)
// }
// ```
//
// `println` is not a real function: the compiler turns the arguments into
// `write` / `write_int` / `write_bool` plus a newline. Empty bodies below
// are runtime hooks (`loam_fmt_*` in loam_rt.h).

import "std:decimal"

/** *Write `s` to stdout (`write(2)`). Uses `s.len` bytes; no trailing NUL. */
/** */
/** *Example: */
/** *``` */
/** *fmt.write("hi") */
/** *``` */
fn write(s: string) {}

/** *Write integer `n` in decimal. */
/** */
/** *Example: */
/** *``` */
/** *fmt.write_int(42) */
/** *``` */
fn write_int(n: int) {
    decimal.write_int(i64(n))
}

/** *Write `true` or `false` (no quotes). */
fn write_bool(b: bool) {
    write(if b { "true" } else { "false" })
}

/** *Write a float in decimal (`%.15g`). */
fn write_float(x: float) {}

/** *Write a single newline. */
fn writeln() {
    write("\n")
}

/** *Print the arguments and a newline. Accepts mixed `string` / `int` / `bool` / `float`. */
/** */
/** *Example: */
/** *``` */
/** *fmt.println("count:", 3, true) */
/** *``` */
fn println() {}

/** *Write `s` to stderr. Diagnostics go here, so they never mix with what a */
/** *program prints to stdout. */
fn ewrite(s: string) {}

/** *`write_bool` to stderr. */
fn ewrite_bool(b: bool) {
    ewrite(if b { "true" } else { "false" })
}

/** *`writeln` to stderr. */
fn ewriteln() {
    ewrite("\n")
}

/** *`println` to stderr: the same mix of `string` / `int` / `bool` / `float`. */
/** */
/** *Example: */
/** *``` */
/** *fmt.eprintln("error:", path, "not found") */
/** *``` */
fn eprintln() {}

/** *Length-based string equality. Loam strings are not C `strcmp` / NUL-terminated. */
/** */
/** *Example: */
/** *``` */
/** *if fmt.eq(name, "ok") { */
/** *fmt.println("yes") */
/** *} */
/** *``` */
fn eq(a: string, b: string) -> bool {}
