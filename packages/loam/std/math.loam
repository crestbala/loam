//! `math` — elementary functions for `f64`.
//!
//! Loam has no math library and no libm seam: `docs/boundary.md` reserves C for
//! platform bindings, and a per-library `*_rt.c` for arithmetic is the thing
//! that document rejects. Everything here is ordinary Loam, which also makes it
//! deterministic on every target instead of inheriting the host libm's
//! last-bit behavior.
//!
//! ```loam
//! import "std:math"
//!
//! let sd = math.sqrt(variance)
//! let cagr = math.pow(end / begin, 1.0 / years) - 1.0
//! ```
//!
//! Everything is `f64`, and every module constant carries an explicit `f64`
//! annotation: an untyped float *literal* at module level infers `float` (f32),
//! so `f64(k) * LOG2` would otherwise be an f64-times-f32 mix and a compile
//! error. That is not a style preference.
//!
//! Accuracy, asserted in `packages/loam/tests/inlang/math_tests.loam`:
//!
//! - `sqrt` converges to a relative error under 1e-12 (Newton, quadratic).
//! - `ln`, `exp`, `pow` hold 1e-10 relative, measured against a hand-checked
//!   table rather than against the host's libm — the point is to be right, not
//!   to agree with whatever `cc` happens to link. In practice they land at
//!   1e-16 and better.
//!
//! Out-of-domain arguments return a defined value instead of trapping, because
//! callers reach them from real data: a flat NAV series gives `variance == 0`
//! and so `sqrt(0)`, and a wiped-out portfolio gives a negative base to `pow`.
//! The runtimes that must not be zero (`ln`, `sqrt`) return zero; `pow` follows
//! the usual conventions. `is_finite` is the check to run before dividing.

/// ln 2, to 53 bits.
let LOG2: f64 = 0.6931471805599453

/// 1 / ln 2, for splitting an exponent into whole powers of two.
let INV_LOG2: f64 = 1.4426950408889634

/// Terms in `ln`'s atanh series, in odd powers. 20 terms at `u <= 1/3` put the
/// truncation error below 1e-19, seven orders under this module's contract.
let LN_TERMS: int = 20

/// Terms in `exp`'s Taylor series on the reduced argument. 18 terms at
/// `|r| <= ln 2 / 2` leave a truncation error near 1e-21.
let EXP_TERMS: int = 18

/// |x|.
fn abs(x: f64) -> f64 {
    if x < 0.0 {
        return -x
    }
    return x
}

/// `x` toward zero.
fn trunc(x: f64) -> f64 {
    return f64(i64(x))
}

/// Largest whole number not greater than `x`.
///
/// Truncation first — the result is then exact in the f64 mantissa — and a
/// correction of one when truncation moved toward zero.
fn floor(x: f64) -> f64 {
    let t = trunc(x)
    if x < 0.0 && t > x {
        return t - 1.0
    }
    return t
}

/// Smallest whole number not less than `x`.
fn ceil(x: f64) -> f64 {
    let t = trunc(x)
    if x > 0.0 && t < x {
        return t + 1.0
    }
    return t
}

/// `x` rounded to the nearest whole number, halves away from zero.
fn round(x: f64) -> f64 {
    if x < 0.0 {
        return -floor(-x + 0.5)
    }
    return floor(x + 0.5)
}

/// The smaller of `a` and `b`.
fn min(a: f64, b: f64) -> f64 {
    if a < b {
        return a
    }
    return b
}

/// The larger of `a` and `b`.
fn max(a: f64, b: f64) -> f64 {
    if a > b {
        return a
    }
    return b
}

/// `x` constrained to `[lo, hi]`.
fn clamp(x: f64, lo: f64, hi: f64) -> f64 {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    return x
}

/// True when `x` is finite: not NaN, not beyond the f64 range. The check to run
/// before dividing, since every in-tree producer of a non-finite f64 is a
/// division by zero or a runaway `exp`.
fn is_finite(x: f64) -> bool {
    if x != x {
        return false
    }
    if x > 1.0e308 || x < -1.0e308 {
        return false
    }
    return true
}

/// Square root by Newton-Raphson.
///
/// Seeded by `sqrt_seed`, which brings the value within a factor of two of the
/// answer, so convergence is monotone from the first iteration. It is quadratic
/// — each iteration roughly doubles the number of correct digits — so 80
/// iterations is far more than 53 bits needs and the cap only guards against a
/// non-finite input spinning forever.
///
/// `sqrt(0) == 0` and `sqrt(x < 0) == 0`: a negative argument is a caller bug,
/// and returning zero rather than trapping keeps one bad sample from taking the
/// process down. Run `is_finite` first if the input is computed.
fn sqrt(x: f64) -> f64 {
    if x <= 0.0 {
        return 0.0
    }
    let mut g = sqrt_seed(x)
    let mut i = 0
    while i < 80 {
        let next = 0.5 * (g + x / g)
        if next == g {
            return next
        }
        g = next
        i = i + 1
    }
    return g
}

/// A start point for Newton inside a factor of two of `sqrt(x)`.
///
/// Scale `x` down by powers of four until it is at most 4, counting the powers,
/// then scale back up by the matching powers of two — `sqrt(4^k * v)` is
/// `2^k * sqrt(v)`. The reduced value sits in `(0.25, 4]`, where `1.0` is within
/// a factor of two of the root, which is all Newton needs.
fn sqrt_seed(x: f64) -> f64 {
    let mut v = x
    let mut scale: f64 = 1.0
    while v >= 4.0 {
        v = v / 4.0
        scale = scale * 2.0
    }
    while v < 0.25 {
        v = v * 4.0
        scale = scale / 2.0
    }
    return scale
}

/// Natural logarithm: argument reduction to `[1, 2)` by powers of two, then the
/// atanh series `ln((1+u)/(1-u)) = 2 * (u + u^3/3 + u^5/5 + ...)`.
///
/// With `x = m * 2^k` and `m` in `[1, 2)`, `u = (m-1)/(m+1)` is at most 1/3, so
/// `u^2 <= 1/9` and twenty terms take the series below 1e-19. `k * LOG2` is
/// added back once, at the end, so nothing is lost to repeated multiplication.
///
/// `ln(1) == 0`, `ln(x <= 0) == 0`. Zero and negatives are outside the domain;
/// the callers that can produce them — a volatility on a flat series, a CAGR on
/// a wiped-out portfolio — guard first, and returning 0 here keeps a degenerate
/// series from trapping the whole program.
fn ln(x: f64) -> f64 {
    if x <= 0.0 {
        return 0.0
    }
    if x == 1.0 {
        return 0.0
    }
    // Bring the mantissa into [1, 2), counting the powers of two removed.
    let mut m = x
    let mut k = 0
    while m >= 2.0 {
        m = m / 2.0
        k = k + 1
    }
    while m < 1.0 {
        m = m * 2.0
        k = k - 1
    }
    // 1 <= m < 2, so u <= 1/3 and u^2 <= 1/9.
    let u = (m - 1.0) / (m + 1.0)
    let u2 = u * u
    let mut term: f64 = u
    let mut sum: f64 = u
    let mut n = 3
    while n <= 2 * LN_TERMS + 1 {
        term = term * u2
        sum = sum + term / f64(n)
        n = n + 2
    }
    return 2.0 * sum + f64(k) * LOG2
}

/// `e` raised to `x`.
///
/// Range reduction first: `x = k * ln 2 + r` with `k = round(x / ln 2)` and
/// `|r| <= ln 2 / 2`, so `exp(x) = 2^k * exp(r)`. The Taylor series on `r` then
/// converges in eighteen terms to about 1e-21, and `2^k` is applied as exact
/// binary doublings or halvings, which add no rounding of their own.
///
/// The argument is clamped to `[-745, 709]`: below that an f64 cannot hold the
/// result next to 1, and above it the f64 range ends. A clamped answer is a
/// number the reader can see, where an infinity propagates into every metric
/// that consumes it.
fn exp(x: f64) -> f64 {
    if x != x {
        return 0.0
    }
    if x > 709.0 {
        return 1.0e308
    }
    if x < -745.0 {
        return 0.0
    }
    // k = round(x / ln 2), r = x - k * ln 2, |r| <= ln 2 / 2.
    let k = i64(round(x * INV_LOG2))
    let r = x - f64(k) * LOG2
    let mut term: f64 = 1.0
    let mut sum: f64 = 1.0
    let mut n = 1
    while n <= EXP_TERMS {
        term = term * r / f64(n)
        sum = sum + term
        n = n + 1
    }
    return scale_pow2(sum, k)
}

/// `v * 2^n` by `n` exact doublings or halvings.
///
/// Powers of two are exact in binary floating point, so this adds no error of
/// its own — unlike routing `2^k` back through `pow` and `ln`.
fn scale_pow2(v: f64, n: i64) -> f64 {
    let mut out = v
    let mut i = i64(0)
    if n >= 0 {
        while i < n {
            out = out * 2.0
            i = i + 1
        }
        return out
    }
    while i > n {
        out = out * 0.5
        i = i - 1
    }
    return out
}

/// `x` raised to `y`.
///
/// A whole-number `y` is special-cased: it goes through exponentiation by
/// squaring on the exact binary value, so `pow(x, 2)` is `x * x` to the last
/// bit rather than `exp(2 * ln x)`, which is off in the last place or two.
/// A whole year count — the common case in a compounding calculation — always
/// takes this path.
///
/// Everything else is `exp(y * ln(x))` and so needs `x > 0`. `pow(x, 0)` is 1
/// for every `x` including zero, by the usual convention; a negative base with
/// a fractional exponent is not real, and returns 0 rather than a NaN that
/// would spread.
fn pow(x: f64, y: f64) -> f64 {
    if y == 0.0 {
        return 1.0
    }
    if x == 0.0 {
        return 0.0
    }
    if is_whole(y) {
        return pow_int(x, i64(y))
    }
    if x < 0.0 {
        return 0.0
    }
    return exp(y * ln(x))
}

/// True when `x` is a whole number.
fn is_whole(x: f64) -> bool {
    if x > 1.0e15 || x < -1.0e15 {
        return false
    }
    return trunc(x) == x
}

/// `x^n` by exponentiation by squaring, for a whole `n`, negative included.
fn pow_int(x: f64, n: i64) -> f64 {
    let mut e = n
    let mut base = x
    if e < 0 {
        base = 1.0 / base
        e = -e
    }
    let mut acc: f64 = 1.0
    while e > 0 {
        if e - (e / 2) * 2 == 1 {
            acc = acc * base
        }
        base = base * base
        e = e / 2
    }
    return acc
}
