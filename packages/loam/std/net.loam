#[os("posix")]
#[c("listen")]
fn c_listen(fd: i32, backlog: i32) -> i32 {}

/** *`accept(fd, NULL, NULL)`: the two `0`s are null pointers. */
#[os("posix")]
#[c("accept")]
fn c_accept(fd: i32, addr: i64, len: i64) -> i32 {}

#[os("posix")]
