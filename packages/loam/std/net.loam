fn c_recv(fd: i32, into: []u8, len: i64, flags: i32) -> i64 {}

/** *`poll(fds, n, ms)`: `nfds_t` is an `unsigned int` on Apple. */
#[os("apple")]
fn c_poll(fds: []i32, n: int, ms: i32) -> i32 {
    return c_poll_apple(fds, u32(n), ms)
}

/** *`nfds_t` is an `unsigned long` on Linux. */
#[os("linux", "android", "other")]
fn c_poll(fds: []i32, n: int, ms: i32) -> i32 {
    return c_poll_linux(fds, u64(n), ms)
}

#[os("windows", "wasm")]
fn c_poll(fds: []i32, n: int, ms: i32) -> i32 {
    return -1
}

#[os("apple")]
