#[c("SSLCreateContext")]
fn c_ssl_create_context(allocator: i64, side: i32, kind: i32) -> i64 {}

/** *The read and write callbacks: `OSStatus (*)(SSLConnectionRef, void *, */
/** *size_t *)`, every argument an address-sized `i64`. */
#[os("apple")]
#[c("SSLSetIOFuncs")]
fn c_ssl_set_io_funcs(
    ctx: i64,
    read: fn(i64, i64, i64) -> i32,
    write: fn(i64, i64, i64) -> i32
) -> i32 {}

/** *The connection ref is the socket itself, as an address-sized value. */
