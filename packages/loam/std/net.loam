// --- TLS: the slot table (macOS, iOS, Linux) ----------------------------------------------
//
// A connection is a slot; its handle is `TLS_BASE + slot`, far above any
// socket, so the TCP calls above hand it here and the HTTP client treats a
// TLS connection like a socket. The slot logic, the name lookup, the
// handshake loop and the non-blocking state machine are shared, and the
// TCP calls reach them through the hooks above; each
// backend gives seven ops over its opaque context: `tls_new`, `tls_shake`,
// `tls_put`, `tls_get`, `tls_buffered`, `tls_end` and `tls_free`. On Apple
// that is SecureTransport, on Linux OpenSSL. Layouts and constants are
// checked by `nob integration c_layouts`.

const TLS_SLOTS: int = 8
/** *Slot states: free, ready, TCP still connecting, TLS handshake running. */
const TLS_FREE: i32 = -1
const TLS_READY: i32 = 0
const TLS_CONNECTING: i32 = 1
const TLS_SHAKING: i32 = 2
/** *What `tls_put` and `tls_get` answer when the socket would block. */
const TLS_WOULD_BLOCK: int = -2

/** *Per slot: state, socket and the backend's context (an opaque address, */
/** *never read by Loam). Made on the first TLS connect. */
let mut tls_state: []i32 = []i32 {}
let mut tls_socket_fd: []i32 = []i32 {}
let mut tls_context: []i64 = []i64 {}
/** *`size_t` out-cells: SecureTransport's processed count, and the length */
/** *word the I/O callbacks read and write through C's pointer. */
let mut processed_cell: []u64 = []u64 {}
let mut io_word: []u64 = []u64 {}
/** *One `struct addrinfo` (48 bytes) copied out of `getaddrinfo`'s list. */
let mut addrinfo_cell: []i64 = []i64 {}

#[os("apple", "linux")]
fn ensure_tls_slots() {
    if tls_state.len == 0 {
        for i in 0..TLS_SLOTS {
            tls_state.push(TLS_FREE)
            tls_socket_fd.push(-1)
            tls_context.push(i64(0))
        }
        processed_cell.push(u64(0))
        io_word.push(u64(0))
        for i in 0..6 {
            addrinfo_cell.push(i64(0))
        }
    }
}

/** *The slot of a live TLS handle, or `-1`. */
#[os("apple", "linux")]
fn tls_slot_of(fd: int) -> int {
    let slot = fd - TLS_BASE
    if fd < TLS_BASE || slot >= TLS_SLOTS || tls_state.len == 0 {
        return -1
    }
    return if tls_state[slot] != TLS_FREE { slot } else { -1 }
}

#[os("apple", "linux")]
fn free_tls_slot() -> int {
    ensure_tls_slots()
    install_tls()
    for i in 0..TLS_SLOTS {
        if tls_state[i] == TLS_FREE {
            return i
        }
    }
    return -1
}

/** *Free a slot: its context released and its socket closed. */
#[os("apple", "linux")]
fn drop_tls_slot(slot: int) {
    tls_state[slot] = TLS_FREE
    tls_free(tls_context[slot])
    if tls_socket_fd[slot] >= 0 {
        c_close(tls_socket_fd[slot])
    }
    tls_context[slot] = i64(0)
    tls_socket_fd[slot] = -1
}

/** *`getaddrinfo` for `host`:`port`, then each address in order until one */
/** *gives a socket; `-1` when none does. `family` 0 is any. */
#[os("apple", "linux")]
fn connect_by_name(host: string, port: int, family: i32, blocking: bool) -> i32 {
    let hints = []i32 { 0, family, SOCK_STREAM, 0, 0, 0, 0, 0, 0, 0, 0, 0 }
    let mut list = []i64 { i64(0) }
    if c_getaddrinfo(host, "{{port}}", hints, list) != 0 {
        return -1
    }
    let addr_word = ai_addr_word()
    let mut fd: i32 = -1
    let mut at = list[0]
    while fd < 0 && at != i64(0) {
        c_load_words(addrinfo_cell, at, 48)
        // Words: flags | family << 32, socktype | protocol << 32, addrlen,
        // then `ai_addr` and `ai_canonname` (Apple has them the other way
        // round), then `ai_next`.
        let ai_family = i32((addrinfo_cell[0] >> 32) & i64(4294967295))
        let ai_socktype = i32(addrinfo_cell[1] & i64(4294967295))
        let ai_protocol = i32((addrinfo_cell[1] >> 32) & i64(4294967295))
        let ai_addrlen = u32(addrinfo_cell[2] & i64(4294967295))
        let ai_addr = addrinfo_cell[addr_word]
        at = addrinfo_cell[5]
        fd = if blocking {
            blocking_socket_to(ai_family, ai_socktype, ai_protocol, ai_addr, ai_addrlen)
        } else {
            pending_socket_to(ai_family, ai_socktype, ai_protocol, ai_addr, ai_addrlen)
        }
    }
    c_freeaddrinfo(list[0])
    return fd
}

/** *The `struct addrinfo` word that holds `ai_addr`. */
#[os("apple")]
fn ai_addr_word() -> int {
    return 4
}

#[os("linux")]
fn ai_addr_word() -> int {
    return 3
}

/** *`SO_SNDTIMEO`. */
#[os("apple")]
fn so_sndtimeo() -> i32 {
    return 4101
}

#[os("linux")]
fn so_sndtimeo() -> i32 {
    return 21
}

/** *A connected blocking socket, its reads and writes bounded at 10 s so a */
/** *silent peer (one that never speaks TLS) cannot block forever; or `-1`. */
#[os("apple", "linux")]
fn blocking_socket_to(family: i32, kind: i32, protocol: i32, addr: i64, addrlen: u32) -> i32 {
    let f = c_socket(family, kind, protocol)
    if f < 0 {
        return -1
    }
    set_cloexec(f)
    no_sigpipe(f)
    let timeout = []i64 { i64(10), i64(0) }
    c_setsockopt_time(f, sol_socket(), so_rcvtimeo(), timeout, u32(16))
    c_setsockopt_time(f, sol_socket(), so_sndtimeo(), timeout, u32(16))
    if c_connect_at(f, addr, addrlen) != 0 {
        c_close(f)
        return -1
    }
    return f
}

/** *A non-blocking socket whose connect finished or is in progress; `-1`. */
#[os("apple", "linux")]
fn pending_socket_to(family: i32, kind: i32, protocol: i32, addr: i64, addrlen: u32) -> i32 {
    let f = c_socket(family, kind, protocol)
    if f < 0 {
        return -1
    }
    set_cloexec(f)
    if set_nonblock(f) != 0 {
        c_close(f)
        return -1
    }
    no_sigpipe(f)
    if c_connect_at(f, addr, addrlen) != 0 {
        let e = c_errno()
        if e != e_inprogress() && e != EINTR && e != e_already() {
            c_close(f)
            return -1
        }
    }
    return f
}

/** *Native `tls_connect`: TCP, then the handshake to the end. A handshake */
/** *that would block polls the socket 50 ms at a time and gives up after */
/** *three idle polls in a row. */
#[os("apple", "linux")]
fn tls_connect_os(host: string, port: int) -> int {
    if port <= 0 || port > 65535 || host.len == 0 || host.len >= 256 {
        return -1
    }
    let slot = free_tls_slot()
    if slot < 0 {
        return -1
    }
    let fd = connect_by_name(host, port, 0, true)
    if fd < 0 {
        return -1
    }
    let ctx = tls_new(host, fd)
    if ctx == i64(0) {
        c_close(fd)
        return -1
    }
    tls_state[slot] = TLS_READY
    tls_socket_fd[slot] = fd
    tls_context[slot] = ctx
    ensure_cells()
    let mut st = tls_shake(ctx)
    let mut idle = 0
    while st == 0 {
        one_poll[0] = fd
        one_poll[1] = POLLIN | POLLOUT
        if c_poll(one_poll, 1, 50) <= 0 {
            idle += 1
            if idle >= 3 {
                st = -1
                break
            }
        } else {
            idle = 0
        }
        st = tls_shake(ctx)
    }
    if st != 1 {
        drop_tls_slot(slot)
        return -1
    }
    return TLS_BASE + slot
}

#[os("android", "other", "windows", "wasm")]
fn tls_connect_os(host: string, port: int) -> int {
    return -1
}

/** *Native `tls_nb_connect`: an IPv4 connect started and the context */
/** *made; `tls_nb_ready` drives the rest. */
#[os("apple", "linux")]
fn tls_nb_connect_os(host: string, port: int) -> int {
    if port <= 0 || port > 65535 || host.len == 0 || host.len >= 256 {
        return -1
    }
    let slot = free_tls_slot()
    if slot < 0 {
        return -1
    }
    let fd = connect_by_name(host, port, AF_INET, false)
    if fd < 0 {
        return -1
    }
    let ctx = tls_new(host, fd)
    if ctx == i64(0) {
        c_close(fd)
        return -1
    }
    tls_state[slot] = TLS_CONNECTING
    tls_socket_fd[slot] = fd
    tls_context[slot] = ctx
    return TLS_BASE + slot
}

#[os("android", "other", "windows", "wasm")]
fn tls_nb_connect_os(host: string, port: int) -> int {
    return -1
}

/** *One step of a non-blocking connect: the TCP connect, then one */
/** *handshake round. A failure frees the slot. */
#[os("apple", "linux")]
fn tls_nb_ready_os(fd: int) -> int {
    let slot = tls_slot_of(fd)
    if slot < 0 {
        return -1
    }
    if tls_state[slot] == TLS_READY {
        return 1
    }
    let sock = tls_socket_fd[slot]
    ensure_cells()
    if tls_state[slot] == TLS_CONNECTING {
        one_poll[0] = sock
        one_poll[1] = POLLOUT
        if c_poll(one_poll, 1, 0) <= 0 {
            return 0
        }
        if socket_error(int(sock)) != 0 {
            drop_tls_slot(slot)
            return -1
        }
        tls_state[slot] = TLS_SHAKING
    }
    one_poll[0] = sock
    one_poll[1] = POLLIN | POLLOUT
    c_poll(one_poll, 1, 0)
    let st = tls_shake(tls_context[slot])
    if st == 1 {
        tls_state[slot] = TLS_READY
        return 1
    }
    if st == 0 {
        return 0
    }
    drop_tls_slot(slot)
    return -1
}

#[os("android", "other", "windows", "wasm")]
fn tls_nb_ready_os(fd: int) -> int {
    return -1
}

/** *One backend write of `data[off..]` (`off < data.len`): bytes taken, */
/** *`0` when it would block. */
#[os("apple", "linux")]
fn tls_send(fd: int, data: string, off: int) -> int {
    last_would_block = false
    let slot = tls_slot_of(fd)
    if slot < 0 {
        return -1
    }
    let n = tls_put(tls_context[slot], data, off)
    if n == TLS_WOULD_BLOCK {
        last_would_block = true
        return 0
    }
    return n
}

/** *One backend read of up to `max` bytes; `""` at the end, on an error, */
/** *or when it would block (then `tcp_wouldblock` says so). */
#[os("apple", "linux")]
fn tls_read(fd: int, max: int) -> string {
    last_would_block = false
    let slot = tls_slot_of(fd)
    if slot < 0 || max <= 0 {
        return ""
    }
    if read_cell.len == 0 {
        read_cell = buf.with_len(READ_MAX)
    }
    let got = tls_get(tls_context[slot], max)
    if got == TLS_WOULD_BLOCK {
        last_would_block = true
        return ""
    }
    if got <= 0 {
        return ""
    }
    return buf.prefix_to_string(&read_cell, got)
}

/** *Close a TLS handle: a best-effort `close_notify`, then free its slot. */
#[os("apple", "linux")]
fn tls_close(fd: int) {
    let slot = tls_slot_of(fd)
    if slot < 0 {
        return
    }
    tls_end(tls_context[slot])
    drop_tls_slot(slot)
}

/** *A TLS handle's socket, handshake state or buffered bytes (`TLS_INFO_*`). */
#[os("apple", "linux")]
fn tls_info(fd: int, what: int) -> int {
    let slot = tls_slot_of(fd)
    if slot < 0 {
        return no_tls_info(fd, what)
    }
    if what == TLS_INFO_SOCKET {
        return int(tls_socket_fd[slot])
    }
    let ready = tls_state[slot] == TLS_READY
    if what == TLS_INFO_SHAKING {
        return if ready { 0 } else { 1 }
    }
    return if ready && tls_buffered(tls_context[slot]) { 1 } else { 0 }
}

/** *The TLS client behind the TCP calls, from the first TLS connect on. */
#[os("apple", "linux")]
fn install_tls() {
    tls_send_hook = tls_send
    tls_read_hook = tls_read
    tls_info_hook = tls_info
    tls_close_hook = tls_close
}

// --- TLS backend: SecureTransport (macOS, iOS) --------------------------------------------
//
// SecureTransport is deprecated in favor of Network.framework, but it is
// the only synchronous TLS API on macOS and fits this blocking-socket
// design. Its bindings name Security and CoreFoundation, so a program
// that never connects over TLS links neither. Its read and write callbacks are Loam fns C calls through plain
// function pointers.

/** *`OSStatus` results and SecureTransport enums. */
const NO_ERR: i32 = 0
const ERR_SSL_WOULD_BLOCK: i32 = -9803
const ERR_SSL_CLOSED_GRACEFUL: i32 = -9805
const ERR_SSL_CLOSED_ABORT: i32 = -9806
const ERR_SSL_INTERNAL: i32 = -9810
const ERR_SSL_ILLEGAL_PARAM: i32 = -9830
const SSL_CLIENT_SIDE: i32 = 1
const SSL_STREAM_TYPE: i32 = 0
const TLS_PROTOCOL_12: i32 = 8

/** *A client context for `host` over socket `fd`: TLS 1.2 at least, SNI */
/** *and the certificate name checked against `host` (SecureTransport */
/** *validates the chain and the name by default), I/O through the Loam */
/** *callbacks. `0` when no context could be made. */
#[os("apple")]
fn tls_new(host: string, fd: i32) -> i64 {
    let ctx = c_ssl_create_context(i64(0), SSL_CLIENT_SIDE, SSL_STREAM_TYPE)
    if ctx == i64(0) {
        return i64(0)
    }
    c_ssl_set_io_funcs(ctx, tls_io_read, tls_io_write)
    c_ssl_set_connection(ctx, i64(fd))
    c_ssl_set_peer_domain_name(ctx, host, i64(host.len))
    c_ssl_set_protocol_version_min(ctx, TLS_PROTOCOL_12)
    return ctx
}

/** *One handshake step: 1 done, 0 would block, `-1` failed. */
#[os("apple")]
fn tls_shake(ctx: i64) -> int {
    let st = c_ssl_handshake(ctx)
    if st == NO_ERR {
        return 1
    }
    return if st == ERR_SSL_WOULD_BLOCK { 0 } else { -1 }
}

/** *One `SSLWrite` of `data[off..]`: bytes taken, `TLS_WOULD_BLOCK`, or */
/** *`-1`. */
#[os("apple")]
fn tls_put(ctx: i64, data: string, off: int) -> int {
    processed_cell[0] = u64(0)
    let st = c_ssl_write(ctx, string_bytes_at(data, off), i64(data.len - off), processed_cell)
    if st == ERR_SSL_WOULD_BLOCK {
        return TLS_WOULD_BLOCK
    }
    return if st == NO_ERR { int(processed_cell[0]) } else { -1 }
}

/** *One `SSLRead` of up to `max` bytes into `read_cell`: bytes read (`0` */
/** *at the end or on an error), or `TLS_WOULD_BLOCK`. */
#[os("apple")]
fn tls_get(ctx: i64, max: int) -> int {
    processed_cell[0] = u64(0)
    let st = c_ssl_read(ctx, read_cell, i64(max), processed_cell)
    if st == ERR_SSL_WOULD_BLOCK {
        return TLS_WOULD_BLOCK
    }
    return int(processed_cell[0])
}

/** *SecureTransport holds decrypted bytes the socket no longer has. */
#[os("apple")]
fn tls_buffered(ctx: i64) -> bool {
    processed_cell[0] = u64(0)
    return c_ssl_get_buffered_read_size(ctx, processed_cell) == NO_ERR &&
        processed_cell[0] != u64(0)
}

#[os("apple")]
fn tls_end(ctx: i64) {
    c_ssl_close(ctx)
}

#[os("apple")]
fn tls_free(ctx: i64) {
    c_cf_release(ctx)
}

/** *SecureTransport's read callback: `recv` into its buffer `data` up to */
/** *the `size_t` at `len_at`, which then holds what arrived. The socket */
/** *rides in the connection ref. A clean EOF is a graceful close. */
#[os("apple")]
fn tls_io_read(conn: i64, data: i64, len_at: i64) -> i32 {
    if data == i64(0) || len_at == i64(0) {
        return ERR_SSL_ILLEGAL_PARAM
    }
    c_load_words_u64(io_word, len_at, 8)
    let want = io_word[0]
    if want == u64(0) {
        return ERR_SSL_ILLEGAL_PARAM
    }
    while true {
        let n = c_recv_at(i32(conn), data, i64(want), 0)
        if n > i64(0) {
            return io_done(len_at, u64(n), NO_ERR)
        }
        if n == i64(0) {
            return io_done(len_at, u64(0), ERR_SSL_CLOSED_GRACEFUL)
        }
        let e = c_errno()
        if e != EINTR {
            return io_done(len_at, u64(0), io_status(e))
        }
    }
    return ERR_SSL_INTERNAL
}

/** *SecureTransport's write callback: one `send` of `data`, the count */
/** *written back through `len_at`. */
#[os("apple")]
fn tls_io_write(conn: i64, data: i64, len_at: i64) -> i32 {
    if data == i64(0) || len_at == i64(0) {
        return ERR_SSL_ILLEGAL_PARAM
    }
    c_load_words_u64(io_word, len_at, 8)
    let want = io_word[0]
    if want == u64(0) {
        return ERR_SSL_ILLEGAL_PARAM
    }
    while true {
        let n = c_send_at(i32(conn), data, i64(want), msg_nosignal())
        if n >= i64(0) {
            return io_done(len_at, u64(n), NO_ERR)
        }
        let e = c_errno()
        if e != EINTR {
            return io_done(len_at, u64(0), io_status(e))
        }
    }
    return ERR_SSL_INTERNAL
}

/** *Write `n` back through `len_at` and answer `status`. */
#[os("apple")]
fn io_done(len_at: i64, n: u64, status: i32) -> i32 {
    io_word[0] = n
    c_store_words_u64(len_at, io_word, 8)
    return status
}

/** *An I/O `errno` as SecureTransport's status: would-block; a reset or a */
/** *broken pipe as an aborted close (`ECONNRESET` 54, `EPIPE` 32 on Apple); */
/** *anything else internal. */
#[os("apple")]
fn io_status(e: i32) -> i32 {
    if e == e_again() {
        return ERR_SSL_WOULD_BLOCK
    }
    if e == 54 || e == 32 {
        return ERR_SSL_CLOSED_ABORT
    }
    return ERR_SSL_INTERNAL
}

#[os("apple")]
#[c("SSLCreateContext", "link -framework Security")]
fn c_ssl_create_context(allocator: i64, side: i32, kind: i32) -> i64 {}

/** *The read and write callbacks: `OSStatus (*)(SSLConnectionRef, void *, */
/** *size_t *)`, every argument an address-sized `i64`. */
#[os("apple")]
#[c("SSLSetIOFuncs", "link -framework Security")]
fn c_ssl_set_io_funcs(
    ctx: i64,
    read: fn(i64, i64, i64) -> i32,
    write: fn(i64, i64, i64) -> i32
) -> i32 {}

/** *The connection ref is the socket itself, as an address-sized value. */
#[os("apple")]
#[c("SSLSetConnection", "link -framework Security")]
fn c_ssl_set_connection(ctx: i64, conn: i64) -> i32 {}

#[os("apple")]
#[c("SSLSetPeerDomainName", "link -framework Security")]
fn c_ssl_set_peer_domain_name(ctx: i64, name: string, len: i64) -> i32 {}

#[os("apple")]
#[c("SSLSetProtocolVersionMin", "link -framework Security")]
fn c_ssl_set_protocol_version_min(ctx: i64, version: i32) -> i32 {}

#[os("apple")]
#[c("SSLHandshake", "link -framework Security")]
fn c_ssl_handshake(ctx: i64) -> i32 {}

#[os("apple")]
#[c("SSLRead", "link -framework Security")]
fn c_ssl_read(ctx: i64, into: &mut []u8, len: i64, processed: &mut []u64) -> i32 {}

#[os("apple")]
#[c("SSLWrite", "link -framework Security")]
fn c_ssl_write(ctx: i64, bytes: i64, len: i64, processed: &mut []u64) -> i32 {}

#[os("apple")]
#[c("SSLGetBufferedReadSize", "link -framework Security")]
fn c_ssl_get_buffered_read_size(ctx: i64, size: &mut []u64) -> i32 {}

#[os("apple")]
#[c("SSLClose", "link -framework Security")]
fn c_ssl_close(ctx: i64) -> i32 {}

#[os("apple")]
#[c("CFRelease", "link -framework CoreFoundation")]
fn c_cf_release(object: i64) {}

// --- TLS backend: OpenSSL (Linux) ----------------------------------------------------------
//
// libssl 1.1.1 or 3.x, linked only into a program that keeps a TLS call
// (each binding names its libraries). One client `SSL_CTX` for the
// process: peer verification against the system's default CA paths, TLS
// 1.2 at least, partial and moving writes (the `SSLWrite` contract the
// shared layer expects). Each connection is an `SSL` with SNI and the
// host name checked, over a BIO whose read and write are Loam callbacks,
// so every `send` carries `MSG_NOSIGNAL`: a reset peer is an error, never
// a `SIGPIPE`. `SSL_set_tlsext_host_name`, `SSL_CTX_set_min_proto_version`
// and `SSL_CTX_set_mode` are macros over `SSL_ctrl` / `SSL_CTX_ctrl`, so
// their codes are written here and checked by `c_layouts`.

const SSL_VERIFY_PEER: i32 = 1
const SSL_CTRL_MODE: i32 = 33
const SSL_CTRL_SET_TLSEXT_HOSTNAME: i32 = 55
const SSL_CTRL_SET_MIN_PROTO_VERSION: i32 = 123
const SSL_MODE_ENABLE_PARTIAL_WRITE: i64 = 1
const SSL_MODE_ACCEPT_MOVING_WRITE_BUFFER: i64 = 2
const TLSEXT_NAMETYPE_HOST_NAME: i64 = 0
const TLS1_2_VERSION: i64 = 771
const SSL_ERROR_WANT_READ: i32 = 2
const SSL_ERROR_WANT_WRITE: i32 = 3
const BIO_TYPE_SOURCE_SINK: i32 = 1024
const BIO_CTRL_FLUSH: i32 = 11
const BIO_FLAGS_READ: i32 = 1
const BIO_FLAGS_WRITE: i32 = 2
const BIO_FLAGS_RWS: i32 = 7
const BIO_FLAGS_SHOULD_RETRY: i32 = 8
/** *`SSL_write` takes an `int` length: a larger write goes in parts. */
const SSL_WRITE_MAX: int = 1073741824

/** *The process's client `SSL_CTX` and the socket `BIO_METHOD`, made on */
/** *the first TLS connect (`0` until then, or when OpenSSL failed). */
let mut openssl_ctx: i64 = i64(0)
let mut socket_bio_method: i64 = i64(0)

/** *The client context and BIO method, made once; `false` when OpenSSL */
/** *could not make them. */
#[os("linux")]
fn openssl_ready() -> bool {
    if openssl_ctx != i64(0) {
        return true
    }
    let method = c_bio_meth_new(c_bio_get_new_index() | BIO_TYPE_SOURCE_SINK, "loam socket")
    if method == i64(0) {
        return false
    }
    c_bio_meth_set_write(method, bio_write)
    c_bio_meth_set_read(method, bio_read)
    c_bio_meth_set_ctrl(method, bio_ctrl)
    let ctx = c_ssl_ctx_new(c_tls_client_method())
    if ctx == i64(0) {
        c_bio_meth_free(method)
        return false
    }
    c_ssl_ctx_set_verify(ctx, SSL_VERIFY_PEER, i64(0))
    c_ssl_ctx_set_default_verify_paths(ctx)
    if c_ssl_ctx_ctrl(ctx, SSL_CTRL_SET_MIN_PROTO_VERSION, TLS1_2_VERSION, i64(0)) != i64(1) {
        c_ssl_ctx_free(ctx)
        c_bio_meth_free(method)
        return false
    }
    let mode = SSL_MODE_ENABLE_PARTIAL_WRITE | SSL_MODE_ACCEPT_MOVING_WRITE_BUFFER
    c_ssl_ctx_ctrl(ctx, SSL_CTRL_MODE, mode, i64(0))
    socket_bio_method = method
    openssl_ctx = ctx
    return true
}

/** *A client `SSL` for `host` over socket `fd`: SNI, the certificate name */
/** *checked against `host`, I/O through the Loam BIO. `0` when OpenSSL */
/** *could not make one. */
#[os("linux")]
fn tls_new(host: string, fd: i32) -> i64 {
    if !openssl_ready() {
        return i64(0)
    }
    let ssl = c_ssl_new(openssl_ctx)
    if ssl == i64(0) {
        return i64(0)
    }
    let bio = c_bio_new(socket_bio_method)
    if bio == i64(0) {
        c_ssl_free(ssl)
        return i64(0)
    }
    c_bio_set_data(bio, i64(fd))
    c_bio_set_init(bio, 1)
    // The `SSL` owns the BIO from here: `SSL_free` frees it.
    c_ssl_set_bio(ssl, bio, bio)
    let sni = c_ssl_ctrl_text(ssl, SSL_CTRL_SET_TLSEXT_HOSTNAME, TLSEXT_NAMETYPE_HOST_NAME, host)
    if sni != i64(1) || c_ssl_set1_host(ssl, host) != 1 {
        c_ssl_free(ssl)
        return i64(0)
    }
    c_ssl_set_connect_state(ssl)
    return ssl
}

/** *1 when an OpenSSL call that answered `rc` only has to wait for the */
/** *socket. The error queue was cleared before the call. */
#[os("linux")]
fn openssl_would_block(ssl: i64, rc: i32) -> bool {
    let e = c_ssl_get_error(ssl, rc)
    return e == SSL_ERROR_WANT_READ || e == SSL_ERROR_WANT_WRITE
}

/** *One handshake step: 1 done, 0 would block, `-1` failed (a bad chain */
/** *or name included). */
#[os("linux")]
fn tls_shake(ssl: i64) -> int {
    c_err_clear_error()
    let rc = c_ssl_connect(ssl)
    if rc == 1 {
        return 1
    }
    return if openssl_would_block(ssl, rc) { 0 } else { -1 }
}

/** *One `SSL_write` of `data[off..]`: bytes taken, `TLS_WOULD_BLOCK`, or */
/** *`-1`. */
#[os("linux")]
fn tls_put(ssl: i64, data: string, off: int) -> int {
    let rest = data.len - off
    let len = if rest > SSL_WRITE_MAX { SSL_WRITE_MAX } else { rest }
    c_err_clear_error()
    let rc = c_openssl_write(ssl, string_bytes_at(data, off), i32(len))
    if rc > 0 {
        return int(rc)
    }
    return if openssl_would_block(ssl, rc) { TLS_WOULD_BLOCK } else { -1 }
}

/** *One `SSL_read` of up to `max` bytes into `read_cell`: bytes read (`0` */
/** *at the end or on an error), or `TLS_WOULD_BLOCK`. */
#[os("linux")]
fn tls_get(ssl: i64, max: int) -> int {
    c_err_clear_error()
    let rc = c_openssl_read(ssl, read_cell, i32(max))
    if rc > 0 {
        return int(rc)
    }
    return if openssl_would_block(ssl, rc) { TLS_WOULD_BLOCK } else { 0 }
}

/** *OpenSSL holds decrypted bytes the socket no longer has. */
#[os("linux")]
fn tls_buffered(ssl: i64) -> bool {
    return c_ssl_pending(ssl) > 0
}

/** *A best-effort `close_notify`; the peer's is not waited for. */
#[os("linux")]
fn tls_end(ssl: i64) {
    c_err_clear_error()
    c_ssl_shutdown(ssl)
}

#[os("linux")]
fn tls_free(ssl: i64) {
    c_ssl_free(ssl)
}

/** *The BIO's write: one `send` of `len` bytes at `data` C handed over, */
/** *retried on `EINTR`. A full socket asks OpenSSL to retry. */
#[os("linux")]
fn bio_write(bio: i64, data: i64, len: i32) -> i32 {
    c_bio_clear_flags(bio, BIO_FLAGS_RWS | BIO_FLAGS_SHOULD_RETRY)
    if data == i64(0) || len <= 0 {
        return 0
    }
    let sock = i32(c_bio_get_data(bio))
    while true {
        let n = c_send_at(sock, data, i64(len), msg_nosignal())
        if n >= i64(0) {
            return i32(n)
        }
        let e = c_errno()
        if e == EINTR {
            continue
        }
        if e == e_again() {
            c_bio_set_flags(bio, BIO_FLAGS_WRITE | BIO_FLAGS_SHOULD_RETRY)
        }
        return -1
    }
    return -1
}

/** *The BIO's read: one `recv` of up to `len` bytes into OpenSSL's buffer; */
/** *`0` at EOF. An empty socket asks OpenSSL to retry. */
#[os("linux")]
fn bio_read(bio: i64, data: i64, len: i32) -> i32 {
    c_bio_clear_flags(bio, BIO_FLAGS_RWS | BIO_FLAGS_SHOULD_RETRY)
    if data == i64(0) || len <= 0 {
        return 0
    }
    let sock = i32(c_bio_get_data(bio))
    while true {
        let n = c_recv_at(sock, data, i64(len), 0)
        if n >= i64(0) {
            return i32(n)
        }
        let e = c_errno()
        if e == EINTR {
            continue
        }
        if e == e_again() {
            c_bio_set_flags(bio, BIO_FLAGS_READ | BIO_FLAGS_SHOULD_RETRY)
        }
        return -1
    }
    return -1
}

/** *The BIO's control: a flush succeeds (every write went straight to the */
/** *socket); nothing else is supported. */
#[os("linux")]
fn bio_ctrl(bio: i64, cmd: i32, larg: i64, parg: i64) -> i64 {
    return if cmd == BIO_CTRL_FLUSH { i64(1) } else { i64(0) }
}

// libssl first: a static link resolves libssl's own libcrypto calls only
// when `-lcrypto` follows it.

