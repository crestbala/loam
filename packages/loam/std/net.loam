// --- the C below Loam ---------------------------------------------------------------------

/** *The address of `s`'s byte at `off` (`0` when `off` is outside it), for */
/** *a binding to read in the same call: Loam has no pointer into a string, */
/** *and a `#[c]` string argument would copy the rest on every resume. */
/** *Internal to this module's wrappers; the address is never kept. */
fn string_bytes_at(s: string, off: int) -> i64 {}

/** *One `send` of `data[off..]` (`off < data.len`): bytes sent or `-1`. */
#[os("posix", "windows")]
fn send_bytes(fd: int, data: string, off: int) -> int {
    return int(c_send_at(i32(fd), string_bytes_at(data, off), i64(data.len - off), msg_nosignal()))
}

