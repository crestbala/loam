#[os("posix")]
#[c("fcntl", "variadic after 2")]
fn c_fcntl_get(fd: i32, cmd: i32) -> i32 {}

/** *`fcntl(fd, cmd, arg)`: a set, its `arg` passed as C's `...` reads it. */
#[os("posix")]
#[c("fcntl", "variadic after 2")]
fn c_fcntl_set(fd: i32, cmd: i32, arg: i32) -> i32 {}

#[os("posix")]
