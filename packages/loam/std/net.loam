fn c_recv(fd: i32, into: &mut []u8, len: i64, flags: i32) -> i64 {}

/** *`poll(fds, n, ms)`: `nfds_t` is an `unsigned int` on Apple. */
#[os("apple")]
fn c_poll(fds: &mut []i32, n: int, ms: i32) -> i32 {
    return c_poll_apple(fds, u32(n), ms)
}

/** *`nfds_t` is an `unsigned long` on Linux. */
#[os("linux", "android", "other")]
fn c_poll(fds: &mut []i32, n: int, ms: i32) -> i32 {
    return c_poll_linux(fds, u64(n), ms)
}

#[os("windows", "wasm")]
fn c_poll(fds: &mut []i32, n: int, ms: i32) -> i32 {
    return -1
}

#[os("apple")]
#[c("poll")]
fn c_poll_apple(fds: &mut []i32, n: u32, ms: i32) -> i32 {}

#[os("linux", "android", "other")]
