// --- TLS backend: SChannel (Windows) -------------------------------------------------------
//
// SSPI over secur32. SChannel does no socket I/O: these ops send and
// receive, and SChannel turns bytes into records and back. Its structs hold
// pointers, so each connection is one zeroed C block (`calloc`), and its
// address is the context the shared layer keeps:
//
//   0    CtxtHandle (two words)            16  state
//   24   encrypted bytes in IN             32  OUT's first unsent byte
//   40   OUT bytes left to send            48  plaintext's address in IN
//   56   plaintext bytes left              64  SecPkgContext_StreamSizes
//   88   the socket                        96  1 once IN needs more bytes
//   104  bytes a parked record stands for  112 leftover ciphertext's address
//   120  leftover ciphertext bytes         128 input SecBufferDesc
//   144  output SecBufferDesc              160 four input SecBuffers
//   224  four output SecBuffers            288 the host name, NUL-terminated
//   544  IN (65,536 bytes)                 66080 OUT (20,480 bytes)
//
// One process-wide credential (`SCHANNEL_CRED`) checks the chain and the
// host name (`SCH_CRED_AUTO_CRED_VALIDATION`), TLS 1.2: the legacy struct
// cannot enable TLS 1.3. Layouts and codes are checked by `c_layouts`.

const SC_STATE: i64 = 16
const SC_IN_LEN: i64 = 24
const SC_OUT_OFF: i64 = 32
const SC_OUT_LEN: i64 = 40
const SC_PLAIN_AT: i64 = 48
const SC_PLAIN_LEN: i64 = 56
const SC_SIZES: i64 = 64
const SC_SOCKET: i64 = 88
const SC_NEED_MORE: i64 = 96
const SC_PARKED: i64 = 104
const SC_EXTRA_AT: i64 = 112
const SC_EXTRA_LEN: i64 = 120
const SC_IN_DESC: i64 = 128
const SC_OUT_DESC: i64 = 144
const SC_IN_BUFS: i64 = 160
const SC_OUT_BUFS: i64 = 224
const SC_HOST: i64 = 288
const SC_IN: i64 = 544
const SC_IN_CAP: i64 = 65536
const SC_OUT: i64 = 66080
const SC_OUT_CAP: i64 = 20480
const SC_BLOCK: i64 = 86560

/** *Block states. */
const SC_FIRST: i64 = 0
const SC_SHAKING: i64 = 1
const SC_READY: i64 = 2
const SC_CLOSED: i64 = 3
const SC_FAILED: i64 = 4

/** *`SECURITY_STATUS` codes. */
const SEC_E_OK: i32 = 0
const SEC_I_CONTINUE_NEEDED: i32 = 590610
const SEC_I_CONTEXT_EXPIRED: i32 = 590615
const SEC_E_INCOMPLETE_MESSAGE: i32 = -2146893032
/** *`SecBuffer` types. */
const SECBUFFER_EMPTY: i64 = 0
const SECBUFFER_DATA: i64 = 1
const SECBUFFER_TOKEN: i64 = 2
const SECBUFFER_EXTRA: i64 = 5
const SECBUFFER_STREAM_TRAILER: i64 = 6
const SECBUFFER_STREAM_HEADER: i64 = 7
/** *Sequence and replay detection, confidentiality, SSPI-allocated tokens, */
/** *extended errors, stream mode. */
const SC_ISC_FLAGS: u32 = 49436
const SECPKG_CRED_OUTBOUND: u32 = 2
const SECPKG_ATTR_STREAM_SIZES: u32 = 4
const SCHANNEL_CRED_VERSION: u32 = 4
const SP_PROT_TLS1_2_CLIENT: u32 = 2048
/** *`SCH_CRED_NO_DEFAULT_CREDS | SCH_CRED_AUTO_CRED_VALIDATION | */
/** *SCH_USE_STRONG_CRYPTO`. */
const SC_CRED_FLAGS: u32 = 4194352
const SCHANNEL_SHUTDOWN: u32 = 1

/** *The process's `CredHandle` (a 16-byte C block), `0` until the first */
/** *connect or when SChannel refused. */
let mut schannel_cred: i64 = i64(0)
/** *One word between C memory and Loam. */
let mut sc_word: []i64 = []i64 {}

#[os("windows")]
unsafe fn sc_get(at: i64) -> i64 {
    c_load_words(sc_word, at, 8)
    return sc_word[0]
}

#[os("windows")]
unsafe fn sc_set(at: i64, value: i64) {
    sc_word[0] = value
    c_store_words(at, sc_word, 8)
}

/** *A `SecBuffer` at `at`: its size and type in one word, then the address. */
#[os("windows")]
unsafe fn sc_buffer(at: i64, size: i64, kind: i64, address: i64) {
    sc_set(at, (size & i64(4294967295)) | (kind << 32))
    sc_set(at + i64(8), address)
}

#[os("windows")]
unsafe fn sc_buffer_size(at: i64) -> i64 {
    return sc_get(at) & i64(4294967295)
}

#[os("windows")]
unsafe fn sc_buffer_kind(at: i64) -> i64 {
    return (sc_get(at) >> 32) & i64(4294967295)
}

/** *A `SecBufferDesc` at `at` over `n` buffers at `buffers`. */
#[os("windows")]
unsafe fn sc_desc(at: i64, n: i64, buffers: i64) {
    sc_set(at, n << 32)
    sc_set(at + i64(8), buffers)
}

/** *The process credential, made once; `false` when SChannel refused. */
#[os("windows")]
fn schannel_ready() -> bool {
    unsafe {
        if sc_word.len == 0 {
            sc_word.push(i64(0))
        }
        if schannel_cred != i64(0) {
            return true
        }
        let cred = c_calloc(u64(1), u64(16))
        if cred == i64(0) {
            return false
        }
        // `SCHANNEL_CRED`: 80 bytes, its pointers null.
        let mut auth = []u32 {}
        for i in 0..20 {
            auth.push(u32(0))
        }
        auth[0] = SCHANNEL_CRED_VERSION
        auth[14] = SP_PROT_TLS1_2_CLIENT
        auth[18] = SC_CRED_FLAGS
        let mut expiry = []i64 { i64(0) }
        let st = c_acquire_credentials_handle(
            i64(0),
            "Microsoft Unified Security Protocol Provider",
            SECPKG_CRED_OUTBOUND,
            i64(0),
            auth,
            i64(0),
            i64(0),
            cred,
            expiry,
        )
        if st != SEC_E_OK {
            c_free(cred)
            return false
        }
        schannel_cred = cred
        return true
    }
}

/** *A connection block for `host` over socket `fd`, or `0`. */
#[os("windows")]
fn tls_new(host: string, fd: i32) -> i64 {
    unsafe {
        if !schannel_ready() {
            return i64(0)
        }
        let b = c_calloc(u64(1), u64(SC_BLOCK))
        if b == i64(0) {
            return i64(0)
        }
        sc_set(b + SC_SOCKET, i64(fd))
        // `host.len < 256` (checked by the caller); the block is zeroed, so the
        // name ends with a NUL.
        c_copy_at(b + SC_HOST, raw_addr(host), i64(host.len))
        return b
    }
}

/** *Send what OUT holds: 1 when it is all out, 0 when the socket is full, */
/** *`-1` on an error. */
#[os("windows")]
fn sc_flush(b: i64) -> int {
    unsafe {
        while sc_get(b + SC_OUT_LEN) > i64(0) {
            let off = sc_get(b + SC_OUT_OFF)
            let left = sc_get(b + SC_OUT_LEN)
            let n = c_send_at(i32(sc_get(b + SC_SOCKET)), b + SC_OUT + off, left, 0)
            if n < i64(0) {
                let e = c_errno()
                if e == EINTR {
                    continue
                }
                return if e == e_again() { 0 } else { -1 }
            }
            sc_set(b + SC_OUT_OFF, off + n)
            sc_set(b + SC_OUT_LEN, left - n)
        }
        sc_set(b + SC_OUT_OFF, i64(0))
        return 1
    }
}

/** *Receive into IN after what it holds: bytes read, `0` at EOF or on an */
/** *error (or IN full), `TLS_WOULD_BLOCK`. */
#[os("windows")]
fn sc_receive(b: i64) -> int {
    unsafe {
        let have = sc_get(b + SC_IN_LEN)
        if have >= SC_IN_CAP {
            return 0
        }
        while true {
            let n = c_recv_at(i32(sc_get(b + SC_SOCKET)), b + SC_IN + have, SC_IN_CAP - have, 0)
            if n > i64(0) {
                sc_set(b + SC_IN_LEN, have + n)
                sc_set(b + SC_NEED_MORE, i64(0))
                return int(n)
            }
            if n == i64(0) {
                return 0
            }
            let e = c_errno()
            if e != EINTR {
                return if e == e_again() { TLS_WOULD_BLOCK } else { 0 }
            }
        }
        return 0
    }
}

/** *Queue an SSPI-allocated token in OUT and free it; `false` if too big. */
#[os("windows")]
fn sc_queue_token(b: i64) -> bool {
    unsafe {
        let size = sc_buffer_size(b + SC_OUT_BUFS)
        let token = sc_get(b + SC_OUT_BUFS + i64(8))
        if token == i64(0) || size == i64(0) {
            return true
        }
        let fits = size <= SC_OUT_CAP
        if fits {
            c_copy_at(b + SC_OUT, token, size)
            sc_set(b + SC_OUT_OFF, i64(0))
            sc_set(b + SC_OUT_LEN, size)
        }
        c_free_context_buffer(token)
        return fits
    }
}

/** *After a call that read IN: keep only the bytes SChannel left over */
/** *(`SECBUFFER_EXTRA` in input buffer 1), at the front of IN. */
#[os("windows")]
fn sc_keep_extra(b: i64) {
    unsafe {
        let have = sc_get(b + SC_IN_LEN)
        if sc_buffer_kind(b + SC_IN_BUFS + i64(16)) == SECBUFFER_EXTRA {
            let extra = sc_buffer_size(b + SC_IN_BUFS + i64(16))
            c_move_at(b + SC_IN, b + SC_IN + have - extra, extra)
            sc_set(b + SC_IN_LEN, extra)
        } else {
            sc_set(b + SC_IN_LEN, i64(0))
        }
    }
}

/** *`sc_initialize` modes: the first call (no context, no input), a */
/** *handshake step (IN as input), the close_notify after a shutdown token */
/** *(the context, no input). */
const SC_CALL_FIRST: int = 0
const SC_CALL_SHAKE: int = 1
const SC_CALL_CLOSE: int = 2

/** *One `InitializeSecurityContextA` call, its token (if any) in output */
/** *buffer 0. */
#[os("windows")]
fn sc_initialize(b: i64, mode: int) -> i32 {
    unsafe {
        sc_buffer(b + SC_OUT_BUFS, i64(0), SECBUFFER_TOKEN, i64(0))
        sc_desc(b + SC_OUT_DESC, i64(1), b + SC_OUT_BUFS)
        let mut attrs = []u32 { u32(0) }
        let mut expiry = []i64 { i64(0) }
        if mode == SC_CALL_CLOSE {
            return c_initialize_security_context(
                schannel_cred, b, b + SC_HOST, SC_ISC_FLAGS, u32(0), u32(0),
                i64(0), u32(0), b, b + SC_OUT_DESC, attrs, expiry,
            )
        }
        if mode == SC_CALL_FIRST {
            return c_initialize_security_context(
                schannel_cred, i64(0), b + SC_HOST, SC_ISC_FLAGS, u32(0), u32(0),
                i64(0), u32(0), b, b + SC_OUT_DESC, attrs, expiry,
            )
        }
        sc_buffer(b + SC_IN_BUFS, sc_get(b + SC_IN_LEN), SECBUFFER_TOKEN, b + SC_IN)
        sc_buffer(b + SC_IN_BUFS + i64(16), i64(0), SECBUFFER_EMPTY, i64(0))
        sc_desc(b + SC_IN_DESC, i64(2), b + SC_IN_BUFS)
        return c_initialize_security_context(
            schannel_cred, b, b + SC_HOST, SC_ISC_FLAGS, u32(0), u32(0),
            b + SC_IN_DESC, u32(0), b, b + SC_OUT_DESC, attrs, expiry,
        )
    }
}

/** *One handshake step: 1 done, 0 would block, `-1` failed (a refused */
/** *certificate or host name included). */
#[os("windows")]
fn tls_shake(b: i64) -> int {
    unsafe {
        while true {
            let flushed = sc_flush(b)
            if flushed != 1 {
                if flushed < 0 {
                    sc_set(b + SC_STATE, SC_FAILED)
                }
                return flushed
            }
            let state = sc_get(b + SC_STATE)
            if state == SC_READY {
                return 1
            }
            if state != SC_FIRST && state != SC_SHAKING {
                return -1
            }
            let mut st = SEC_E_OK
            if state == SC_FIRST {
                st = sc_initialize(b, SC_CALL_FIRST)
            } else {
                if sc_get(b + SC_IN_LEN) == i64(0) || sc_get(b + SC_NEED_MORE) != i64(0) {
                    let got = sc_receive(b)
                    if got == TLS_WOULD_BLOCK {
                        return 0
                    }
                    if got <= 0 {
                        sc_set(b + SC_STATE, SC_FAILED)
                        return -1
                    }
                }
                st = sc_initialize(b, SC_CALL_SHAKE)
            }
            if st == SEC_E_INCOMPLETE_MESSAGE {
                sc_set(b + SC_NEED_MORE, i64(1))
                continue
            }
            if st != SEC_E_OK && st != SEC_I_CONTINUE_NEEDED {
                sc_set(b + SC_STATE, SC_FAILED)
                return -1
            }
            if !sc_queue_token(b) {
                sc_set(b + SC_STATE, SC_FAILED)
                return -1
            }
            if state != SC_FIRST {
                sc_keep_extra(b)
            }
            if st == SEC_I_CONTINUE_NEEDED {
                sc_set(b + SC_STATE, SC_SHAKING)
                continue
            }
            if c_query_context_attributes(b, SECPKG_ATTR_STREAM_SIZES, b + SC_SIZES) != SEC_E_OK {
                sc_set(b + SC_STATE, SC_FAILED)
                return -1
            }
            sc_set(b + SC_STATE, SC_READY)
        }
        return -1
    }
}

/** *`StreamSizes` field `k`: header, trailer, maximum message. */
#[os("windows")]
fn sc_size(b: i64, k: int) -> i64 {
    unsafe {
        let pair = sc_get(b + SC_SIZES + i64((k / 2) * 8))
        return if k % 2 == 0 { pair & i64(4294967295) } else { (pair >> 32) & i64(4294967295) }
    }
}

/** *Encrypt up to one record of `data[off..]` into OUT and send it: bytes */
/** *taken, `TLS_WOULD_BLOCK`, or `-1`. A record the socket would not take */
/** *whole is parked, and the caller's retry (the same bytes, as with */
/** *OpenSSL) finishes it and counts its bytes then. */
#[os("windows")]
fn tls_put(b: i64, data: string, off: int) -> int {
    unsafe {
        if sc_get(b + SC_STATE) != SC_READY {
            return -1
        }
        if sc_get(b + SC_OUT_LEN) > i64(0) {
            let flushed = sc_flush(b)
            if flushed == 0 {
                return TLS_WOULD_BLOCK
            }
            if flushed < 0 {
                return -1
            }
            let parked = sc_get(b + SC_PARKED)
            sc_set(b + SC_PARKED, i64(0))
            return int(parked)
        }
        let header = sc_size(b, 0)
        let trailer = sc_size(b, 1)
        let most = sc_size(b, 2)
        let mut take = i64(data.len - off)
        if take > most {
            take = most
        }
        if header + take + trailer > SC_OUT_CAP {
            take = SC_OUT_CAP - header - trailer
        }
        c_copy_at(b + SC_OUT + header, raw_addr(data) + i64(off), take)
        let bufs = b + SC_OUT_BUFS
        sc_buffer(bufs, header, SECBUFFER_STREAM_HEADER, b + SC_OUT)
        sc_buffer(bufs + i64(16), take, SECBUFFER_DATA, b + SC_OUT + header)
        sc_buffer(bufs + i64(32), trailer, SECBUFFER_STREAM_TRAILER, b + SC_OUT + header + take)
        sc_buffer(bufs + i64(48), i64(0), SECBUFFER_EMPTY, i64(0))
        sc_desc(b + SC_OUT_DESC, i64(4), bufs)
        if c_encrypt_message(b, u32(0), b + SC_OUT_DESC, u32(0)) != SEC_E_OK {
            return -1
        }
        let total = sc_buffer_size(bufs) + sc_buffer_size(bufs + i64(16)) + sc_buffer_size(bufs + i64(32))
        sc_set(b + SC_OUT_OFF, i64(0))
        sc_set(b + SC_OUT_LEN, total)
        let flushed = sc_flush(b)
        if flushed < 0 {
            return -1
        }
        if flushed == 0 {
            sc_set(b + SC_PARKED, take)
            return TLS_WOULD_BLOCK
        }
        return int(take)
    }
}

/** *Hand out up to `max` decrypted bytes into `read_cell`; when the last */
/** *are taken, the leftover ciphertext moves to the front of IN. */
#[os("windows")]
fn sc_take_plain(b: i64, max: int) -> int {
    unsafe {
        let at = sc_get(b + SC_PLAIN_AT)
        let left = sc_get(b + SC_PLAIN_LEN)
        let n = if left > i64(max) { i64(max) } else { left }
        c_load_bytes(read_cell, at, n)
        sc_set(b + SC_PLAIN_AT, at + n)
        sc_set(b + SC_PLAIN_LEN, left - n)
        if left == n {
            sc_drop_record(b)
        }
        return int(n)
    }
}

/** *The decrypted record is used up: its leftover ciphertext moves to the */
/** *front of IN. */
#[os("windows")]
fn sc_drop_record(b: i64) {
    unsafe {
        let extra = sc_get(b + SC_EXTRA_LEN)
        if extra > i64(0) {
            c_move_at(b + SC_IN, sc_get(b + SC_EXTRA_AT), extra)
        }
        sc_set(b + SC_IN_LEN, extra)
        sc_set(b + SC_EXTRA_LEN, i64(0))
        sc_set(b + SC_PLAIN_LEN, i64(0))
    }
}

/** *One read of up to `max` bytes into `read_cell`: bytes read (`0` at the */
/** *end or on an error), or `TLS_WOULD_BLOCK`. */
#[os("windows")]
fn tls_get(b: i64, max: int) -> int {
    unsafe {
        while true {
            if sc_get(b + SC_PLAIN_LEN) > i64(0) {
                return sc_take_plain(b, max)
            }
            if sc_get(b + SC_STATE) != SC_READY {
                return 0
            }
            if sc_get(b + SC_IN_LEN) == i64(0) || sc_get(b + SC_NEED_MORE) != i64(0) {
                let got = sc_receive(b)
                if got == TLS_WOULD_BLOCK {
                    return TLS_WOULD_BLOCK
                }
                if got <= 0 {
                    return 0
                }
            }
            let bufs = b + SC_IN_BUFS
            sc_buffer(bufs, sc_get(b + SC_IN_LEN), SECBUFFER_DATA, b + SC_IN)
            sc_buffer(bufs + i64(16), i64(0), SECBUFFER_EMPTY, i64(0))
            sc_buffer(bufs + i64(32), i64(0), SECBUFFER_EMPTY, i64(0))
            sc_buffer(bufs + i64(48), i64(0), SECBUFFER_EMPTY, i64(0))
            sc_desc(b + SC_IN_DESC, i64(4), bufs)
            let st = c_decrypt_message(b, b + SC_IN_DESC, u32(0), i64(0))
            if st == SEC_E_INCOMPLETE_MESSAGE {
                sc_set(b + SC_NEED_MORE, i64(1))
                continue
            }
            if st == SEC_I_CONTEXT_EXPIRED {
                // The peer's close_notify: the end.
                sc_set(b + SC_STATE, SC_CLOSED)
                return 0
            }
            if st != SEC_E_OK {
                sc_set(b + SC_STATE, SC_FAILED)
                return 0
            }
            sc_set(b + SC_PLAIN_LEN, i64(0))
            sc_set(b + SC_EXTRA_LEN, i64(0))
            for k in 0..4 {
                let at = bufs + i64(k * 16)
                let kind = sc_buffer_kind(at)
                if kind == SECBUFFER_DATA {
                    sc_set(b + SC_PLAIN_AT, sc_get(at + i64(8)))
                    sc_set(b + SC_PLAIN_LEN, sc_buffer_size(at))
                } else if kind == SECBUFFER_EXTRA {
                    sc_set(b + SC_EXTRA_AT, sc_get(at + i64(8)))
                    sc_set(b + SC_EXTRA_LEN, sc_buffer_size(at))
                }
            }
            if sc_get(b + SC_PLAIN_LEN) == i64(0) {
                sc_drop_record(b)
            }
        }
        return 0
    }
}

/** *Decrypted bytes wait, or IN holds ciphertext not yet tried. */
#[os("windows")]
fn tls_buffered(b: i64) -> bool {
    unsafe {
        return sc_get(b + SC_PLAIN_LEN) > i64(0) ||
            (sc_get(b + SC_IN_LEN) > i64(0) && sc_get(b + SC_NEED_MORE) == i64(0))
    }
}

/** *A best-effort close_notify: one send attempt, not waited for. */
#[os("windows")]
fn tls_end(b: i64) {
    unsafe {
        if sc_get(b + SC_STATE) != SC_READY {
            return
        }
        sc_set(b + SC_STATE, SC_CLOSED)
        // The `SCHANNEL_SHUTDOWN` DWORD lives in the parked-record word, which
        // a closing connection no longer needs.
        sc_set(b + SC_PARKED, i64(SCHANNEL_SHUTDOWN))
        let bufs = b + SC_OUT_BUFS
        sc_buffer(bufs, i64(4), SECBUFFER_TOKEN, b + SC_PARKED)
        sc_desc(b + SC_OUT_DESC, i64(1), bufs)
        if c_apply_control_token(b, b + SC_OUT_DESC) != SEC_E_OK {
            return
        }
        if sc_initialize(b, SC_CALL_CLOSE) == SEC_E_OK && sc_queue_token(b) {
            sc_flush(b)
        }
    }
}

#[os("windows")]
fn tls_free(b: i64) {
    unsafe {
        if sc_get(b) != i64(0) || sc_get(b + i64(8)) != i64(0) {
            c_delete_security_context(b)
        }
        c_free(b)
    }
}

/** *`AcquireCredentialsHandleA(principal, package, use, logon id, auth data, */
/** *key fn, key arg, credential, expiry)`. */
#[os("windows")]
#[c("AcquireCredentialsHandleA", "link -lsecur32")]
unsafe fn c_acquire_credentials_handle(
    principal: i64,
    package: string,
    use: u32,
    logon_id: i64,
    auth: &[]u32,
    key_fn: i64,
    key_arg: i64,
    credential: i64,
    expiry: &mut []i64
) -> i32 {}

/** *`InitializeSecurityContextA(credential, context, target, flags, 0, */
/** *data rep, input, 0, new context, output, attributes, expiry)`. */
#[os("windows")]
#[c("InitializeSecurityContextA", "link -lsecur32")]
unsafe fn c_initialize_security_context(
    credential: i64,
    context: i64,
    target: i64,
    flags: u32,
    reserved: u32,
    data_rep: u32,
    input: i64,
    reserved2: u32,
    new_context: i64,
    output: i64,
    attributes: &mut []u32,
    expiry: &mut []i64
) -> i32 {}

#[os("windows")]
#[c("QueryContextAttributesA", "link -lsecur32")]
unsafe fn c_query_context_attributes(context: i64, attribute: u32, into: i64) -> i32 {}

#[os("windows")]
#[c("EncryptMessage", "link -lsecur32")]
unsafe fn c_encrypt_message(context: i64, qop: u32, message: i64, sequence: u32) -> i32 {}

#[os("windows")]
#[c("DecryptMessage", "link -lsecur32")]
unsafe fn c_decrypt_message(context: i64, message: i64, sequence: u32, qop: i64) -> i32 {}

#[os("windows")]
#[c("ApplyControlToken", "link -lsecur32")]
unsafe fn c_apply_control_token(context: i64, input: i64) -> i32 {}

#[os("windows")]
#[c("FreeContextBuffer", "link -lsecur32")]
unsafe fn c_free_context_buffer(buffer: i64) -> i32 {}

#[os("windows")]
#[c("DeleteSecurityContext", "link -lsecur32")]
fn c_delete_security_context(context: i64) -> i32 {}

#[os("windows")]
#[c("calloc")]
unsafe fn c_calloc(count: u64, size: u64) -> i64 {}

#[os("windows")]
#[c("free")]
unsafe fn c_free(block: i64) {}

/** *`memcpy` and `memmove` between addresses in C memory this module made */
/** *(a connection block) or SSPI handed over, each with its exact size. */
#[os("windows")]
#[c("memcpy")]
unsafe fn c_copy_at(dst: i64, src: i64, n: i64) -> i64 {}

#[os("windows")]
#[c("memmove")]
unsafe fn c_move_at(dst: i64, src: i64, n: i64) -> i64 {}

#[os("windows")]
#[c("memcpy")]
unsafe fn c_load_bytes(dst: &mut []u8, src: i64, n: i64) -> i64 {}

#[os("windows")]
#[c("memcpy")]
unsafe fn c_store_words(dst: i64, src: &[]i64, n: i64) -> i64 {}


// --- TLS backend: Java's SSLEngine (Android) ------------------------------------------
//
// The engine lives in the Android host (`LoamTls`, driven from `android.c`).
// It never sees the socket. This side feeds it records and sends what it
// produces. A handle is 1..8, so a live context is never the failure `0`.
// Loam has no pointer into the middle of a `[]u8`, so a binding always reads
// the front of a buffer: leftovers slide to the front, and bytes the engine
// returns are copied into the slot.

const JT_SLOTS: int = 8
/** *Ciphertext held per connection, and the scratch a binding can see. */
const JT_IO: int = 65536
/** *Outbound records waiting for the socket. One flight can be larger than */
/** *`JT_IO` because the engine fills the caller's buffer and parks the tail. */
const JT_OUT: int = 262144
const JT_PLAIN: int = 65536
/** *The most plaintext one `tls_put` encrypts. */
const JT_RECORD: int = 16384
const JT_SHAKING: int = 1
const JT_READY: int = 2
const JT_CLOSED: int = 3
const JT_FAILED: int = 4
/** *What `wrap` / `unwrap` answer. A drain did not touch the engine. */
const JT_OVERFLOW: int = 1
const JT_UNDERFLOW: int = 2
const JT_CLOSED_IO: int = 3
const JT_DRAIN: int = 4
/** *What `status` answers. */
const JT_HS_DONE: int = 0
const JT_HS_WRAP: int = 1
const JT_HS_UNWRAP: int = 2
const JT_HS_AGAIN: int = 3

let mut jt_made: bool = false
let mut jt_fd: []i32 = []i32 {}
let mut jt_state: []int = []int {}
let mut jt_in_len: []int = []int {}
let mut jt_out_len: []int = []int {}
let mut jt_plain_len: []int = []int {}
let mut jt_plain_off: []int = []int {}
let mut jt_need: []int = []int {}
let mut jt_parked: []int = []int {}
let mut jt_in: []u8 = []u8 {}
let mut jt_out: []u8 = []u8 {}
let mut jt_plain: []u8 = []u8 {}
let mut jt_io_in: []u8 = []u8 {}
let mut jt_io_out: []u8 = []u8 {}
/** *consumed, produced, and bytes the engine still has staged. */
let mut jt_counts: []i32 = []i32 {}

#[os("android")]
fn jt_ensure() {
    if jt_made {
        return
    }
    jt_made = true
    for i in 0..JT_SLOTS {
        jt_fd.push(-1)
        jt_state.push(0)
        jt_in_len.push(0)
        jt_out_len.push(0)
        jt_plain_len.push(0)
        jt_plain_off.push(0)
        jt_need.push(0)
        jt_parked.push(0)
    }
    jt_in = buf.with_len(JT_SLOTS * JT_IO)
    jt_out = buf.with_len(JT_SLOTS * JT_OUT)
    jt_plain = buf.with_len(JT_SLOTS * JT_PLAIN)
    jt_io_in = buf.with_len(JT_IO)
    jt_io_out = buf.with_len(JT_IO)
    jt_counts.push(0)
    jt_counts.push(0)
    jt_counts.push(0)
}

#[os("android")]
fn jt_ix(ctx: i64) -> int {
    if ctx <= i64(0) || ctx > i64(JT_SLOTS) || jt_state.len == 0 {
        return -1
    }
    let ix = int(ctx) - 1
    if jt_state[ix] == 0 {
        return -1
    }
    return ix
}

#[os("android")]
fn jt_handle(ix: int) -> i32 {
    return i32(ix + 1)
}

#[os("android")]
fn jt_fail(ix: int) -> int {
    jt_state[ix] = JT_FAILED
    return -1
}

/** *Send what the slot has queued: 1 when it is all out, 0 when the socket */
/** *is full, `-1` on an error. */
#[os("android")]
fn jt_flush(ix: int) -> int {
    let base = ix * JT_OUT
    while jt_out_len[ix] > 0 {
        let mut n = jt_out_len[ix]
        if n > JT_IO {
            n = JT_IO
        }
        for i in 0..n {
            jt_io_out[i] = jt_out[base + i]
        }
        let sent = c_send_buf(jt_fd[ix], jt_io_out, i64(n), msg_nosignal())
        if sent < i64(0) {
            let e = c_errno()
            if e == EINTR {
                continue
            }
            return if e == e_again() { 0 } else { -1 }
        }
        if sent == i64(0) {
            return -1
        }
        let rest = jt_out_len[ix] - int(sent)
        let sent_n = int(sent)
        for i in 0..rest {
            jt_out[base + i] = jt_out[base + sent_n + i]
        }
        jt_out_len[ix] = rest
    }
    return 1
}

/** *Receive into the slot after what it holds: bytes read, `0` at the end */
/** *or on an error, `TLS_WOULD_BLOCK`. */
#[os("android")]
fn jt_receive(ix: int) -> int {
    let base = ix * JT_IO
    let have = jt_in_len[ix]
    if have >= JT_IO {
        return 0
    }
    let space = JT_IO - have
    while true {
        let n = c_recv(jt_fd[ix], jt_io_in, i64(space), 0)
        if n > i64(0) {
            let got = int(n)
            for i in 0..got {
                jt_in[base + have + i] = jt_io_in[i]
            }
            jt_in_len[ix] = have + got
            jt_need[ix] = 0
            return got
        }
        if n == i64(0) {
            return 0
        }
        let e = c_errno()
        if e != EINTR {
            return if e == e_again() { TLS_WOULD_BLOCK } else { 0 }
        }
    }
    return 0
}

#[os("android")]
fn jt_queue_out(ix: int, n: int) -> bool {
    if n <= 0 {
        return true
    }
    let base = ix * JT_OUT
    let at = jt_out_len[ix]
    if at + n > JT_OUT {
        return false
    }
    for i in 0..n {
        jt_out[base + at + i] = jt_io_out[i]
    }
    jt_out_len[ix] = at + n
    return true
}

#[os("android")]
fn jt_save_plain(ix: int, n: int) -> bool {
    if n <= 0 {
        return true
    }
    let base = ix * JT_PLAIN
    let at = jt_plain_len[ix]
    if at + n > JT_PLAIN {
        return false
    }
    for i in 0..n {
        jt_plain[base + at + i] = jt_io_out[i]
    }
    jt_plain_len[ix] = at + n
    return true
}

#[os("android")]
fn jt_drop_in(ix: int, consumed: int) {
    if consumed <= 0 {
        return
    }
    let base = ix * JT_IO
    let have = jt_in_len[ix]
    let dropn = if consumed > have { have } else { consumed }
    let rest = have - dropn
    for i in 0..rest {
        jt_in[base + i] = jt_in[base + dropn + i]
    }
    jt_in_len[ix] = rest
}

#[os("android")]
fn jt_stage_in(ix: int) -> int {
    let base = ix * JT_IO
    let n = jt_in_len[ix]
    for i in 0..n {
        jt_io_in[i] = jt_in[base + i]
    }
    return n
}

/** *`wrap` of `jt_io_in[0..n_in]`: bytes of plaintext the engine took, or */
/** *`-1`. Output is queued. A drain (`4`) retries the same plaintext; a */
/** *tail that did not fit is pulled with an empty wrap, which does not */
/** *encrypt again. */
#[os("android")]
fn jt_wrap_bytes(ix: int, n_in: int) -> int {
    let mut guard = 0
    let mut taken = 0
    let mut offer = n_in
    while guard < 8 {
        guard += 1
        let rc = int(c_jt_wrap(jt_handle(ix), jt_io_in, i32(offer), jt_io_out, i32(JT_IO), jt_counts))
        if rc < 0 || rc == JT_OVERFLOW {
            return -1
        }
        let took = int(jt_counts[0])
        let made = int(jt_counts[1])
        let staged = int(jt_counts[2])
        if made > 0 && !jt_queue_out(ix, made) {
            return -1
        }
        if took > 0 {
            taken = took
        }
        if rc == JT_DRAIN {
            if staged > 0 || (taken == 0 && offer > 0) {
                continue
            }
            return taken
        }
        if staged > 0 {
            offer = 0
            continue
        }
        if rc == JT_CLOSED_IO {
            return taken
        }
        if taken == 0 && offer > 0 {
            return -1
        }
        return taken
    }
    return -1
}

/** *`unwrap` of the slot's ciphertext into the plaintext buffer: `0` ok, */
/** *`JT_UNDERFLOW` need more, `JT_CLOSED_IO` the peer closed, `-1` failed. */
#[os("android")]
fn jt_unwrap_have(ix: int) -> int {
    let mut n = jt_stage_in(ix)
    let mut guard = 0
    let mut closed = false
    while guard < 8 {
        guard += 1
        let rc = int(c_jt_unwrap(jt_handle(ix), jt_io_in, i32(n), jt_io_out, i32(JT_IO), jt_counts))
        if rc < 0 || rc == JT_OVERFLOW {
            return -1
        }
        let took = int(jt_counts[0])
        let made = int(jt_counts[1])
        let staged = int(jt_counts[2])
        if took > 0 {
            jt_drop_in(ix, took)
        }
        if made > 0 && !jt_save_plain(ix, made) {
            return -1
        }
        if rc == JT_CLOSED_IO {
            closed = true
        }
        if rc == JT_DRAIN {
            if staged > 0 {
                n = 0
                continue
            }
            if n > 0 {
                continue
            }
            jt_need[ix] = 0
            return if closed { JT_CLOSED_IO } else { 0 }
        }
        if staged > 0 {
            n = 0
            continue
        }
        if rc == JT_UNDERFLOW {
            jt_need[ix] = 1
            return JT_UNDERFLOW
        }
        jt_need[ix] = 0
        return if closed { JT_CLOSED_IO } else { rc }
    }
    return -1
}

#[os("android")]
fn jt_take_plain(ix: int, max: int) -> int {
    let base = ix * JT_PLAIN
    let have = jt_plain_len[ix] - jt_plain_off[ix]
    let mut n = if have > max { max } else { have }
    if n > read_cell.len {
        n = read_cell.len
    }
    let off = jt_plain_off[ix]
    for i in 0..n {
        read_cell[i] = jt_plain[base + off + i]
    }
    jt_plain_off[ix] = off + n
    if jt_plain_off[ix] >= jt_plain_len[ix] {
        jt_plain_off[ix] = 0
        jt_plain_len[ix] = 0
    }
    return n
}

/** *A client engine for `host` over `fd`. The port was stored by */
/** *`note_tls_port` (the socket may not be connected yet). `0` on failure. */
#[os("android")]
fn tls_new(host: string, fd: i32) -> i64 {
    jt_ensure()
    let h = c_jt_open(host, i32(jt_port))
    if h <= 0 || int(h) > JT_SLOTS {
        return i64(0)
    }
    let ix = int(h) - 1
    if jt_state[ix] != 0 {
        c_jt_free(h)
        return i64(0)
    }
    jt_fd[ix] = fd
    jt_state[ix] = JT_SHAKING
    jt_in_len[ix] = 0
    jt_out_len[ix] = 0
    jt_plain_len[ix] = 0
    jt_plain_off[ix] = 0
    jt_need[ix] = 0
    jt_parked[ix] = 0
    return i64(h)
}

/** *One handshake step: 1 done, 0 would block, `-1` failed (a refused */
/** *certificate or host name included). */
#[os("android")]
fn tls_shake(ctx: i64) -> int {
    let ix = jt_ix(ctx)
    if ix < 0 {
        return -1
    }
    let mut spins = 0
    while spins < 64 {
        spins += 1
        let flushed = jt_flush(ix)
        if flushed == 0 {
            return 0
        }
        if flushed < 0 {
            return jt_fail(ix)
        }
        let st = int(c_jt_status(jt_handle(ix)))
        if st == JT_HS_DONE {
            jt_state[ix] = JT_READY
            return 1
        }
        if st < 0 {
            return jt_fail(ix)
        }
        if st == JT_HS_WRAP {
            if jt_wrap_bytes(ix, 0) < 0 {
                return jt_fail(ix)
            }
            continue
        }
        if st == JT_HS_UNWRAP || st == JT_HS_AGAIN {
            // NEED_UNWRAP_AGAIN already holds the record. Unwrap it before
            // reading the socket, including when the local buffer is empty.
            let have = jt_in_len[ix] > 0 && jt_need[ix] == 0
            if !have && st != JT_HS_AGAIN {
                let got = jt_receive(ix)
                if got == TLS_WOULD_BLOCK {
                    return 0
                }
                if got <= 0 {
                    return jt_fail(ix)
                }
            }
            let ur = jt_unwrap_have(ix)
            if ur == JT_UNDERFLOW {
                if st == JT_HS_AGAIN {
                    let got = jt_receive(ix)
                    if got == TLS_WOULD_BLOCK {
                        return 0
                    }
                    if got <= 0 {
                        return jt_fail(ix)
                    }
                }
                continue
            }
            if ur < 0 || ur == JT_CLOSED_IO {
                return jt_fail(ix)
            }
            continue
        }
        return jt_fail(ix)
    }
    return jt_fail(ix)
}

/** *Encrypt up to one record of `data[off..]` and send it: bytes taken, */
/** *`TLS_WOULD_BLOCK`, or `-1`. A record the socket would not take whole is */
/** *parked, and the caller's retry with the same bytes counts it. */
#[os("android")]
fn tls_put(ctx: i64, data: string, off: int) -> int {
    let ix = jt_ix(ctx)
    if ix < 0 || jt_state[ix] != JT_READY {
        return -1
    }
    if jt_out_len[ix] > 0 {
        let flushed = jt_flush(ix)
        if flushed == 0 {
            return TLS_WOULD_BLOCK
        }
        if flushed < 0 {
            return -1
        }
        let parked = jt_parked[ix]
        jt_parked[ix] = 0
        return parked
    }
    let mut take = data.len - off
    if take > JT_RECORD {
        take = JT_RECORD
    }
    if take <= 0 {
        return -1
    }
    for i in 0..take {
        jt_io_in[i] = u8(data[off + i])
    }
    let taken = jt_wrap_bytes(ix, take)
    if taken < 0 {
        return -1
    }
    let flushed = jt_flush(ix)
    if flushed < 0 {
        return -1
    }
    if flushed == 0 {
        jt_parked[ix] = taken
        return TLS_WOULD_BLOCK
    }
    return taken
}

/** *One read of up to `max` bytes into `read_cell`: bytes read (`0` at the */
/** *end or on an error), or `TLS_WOULD_BLOCK`. */
#[os("android")]
fn tls_get(ctx: i64, max: int) -> int {
    let ix = jt_ix(ctx)
    if ix < 0 || max <= 0 {
        return 0
    }
    let mut spins = 0
    while spins < 64 {
        spins += 1
        if jt_plain_len[ix] > jt_plain_off[ix] {
            return jt_take_plain(ix, max)
        }
        if jt_state[ix] != JT_READY && jt_state[ix] != JT_CLOSED {
            return 0
        }
        let pending = int(c_jt_pending(jt_handle(ix))) > 0
        let have = jt_in_len[ix] > 0 && jt_need[ix] == 0
        if !pending && !have {
            if jt_state[ix] == JT_CLOSED {
                return 0
            }
            let got = jt_receive(ix)
            if got == TLS_WOULD_BLOCK {
                return TLS_WOULD_BLOCK
            }
            if got <= 0 {
                return 0
            }
        }
        let ur = jt_unwrap_have(ix)
        if ur == JT_UNDERFLOW {
            continue
        }
        if ur < 0 {
            jt_state[ix] = JT_FAILED
            return 0
        }
        if ur == JT_CLOSED_IO {
            jt_state[ix] = JT_CLOSED
        }
    }
    jt_state[ix] = JT_FAILED
    return 0
}

/** *Decrypted bytes wait, Java still holds plaintext, or ciphertext is */
/** *here that has not been tried. */
#[os("android")]
fn tls_buffered(ctx: i64) -> bool {
    let ix = jt_ix(ctx)
    if ix < 0 {
        return false
    }
    if jt_plain_len[ix] > jt_plain_off[ix] {
        return true
    }
    if int(c_jt_pending(jt_handle(ix))) > 0 {
        return true
    }
    return jt_in_len[ix] > 0 && jt_need[ix] == 0
}

/** *A best-effort close_notify: one send attempt, not waited for. */
#[os("android")]
fn tls_end(ctx: i64) {
    let ix = jt_ix(ctx)
    if ix < 0 || jt_state[ix] != JT_READY {
        return
    }
    jt_state[ix] = JT_CLOSED
    c_jt_close(jt_handle(ix))
    jt_wrap_bytes(ix, 0)
    jt_flush(ix)
}

#[os("android")]
fn tls_free(ctx: i64) {
    if ctx == i64(0) {
        return
    }
    let ix = jt_ix(ctx)
    if ix < 0 {
        return
    }
    c_jt_free(jt_handle(ix))
    jt_state[ix] = 0
    jt_fd[ix] = -1
    jt_in_len[ix] = 0
    jt_out_len[ix] = 0
    jt_plain_len[ix] = 0
    jt_plain_off[ix] = 0
    jt_need[ix] = 0
    jt_parked[ix] = 0
}

/** *`SSLEngine` for `host`:`port`: a handle in `1..8`, or `-1`. */
#[os("android")]
#[c("loam_android_tls_open")]
fn c_jt_open(host: string, port: i32) -> i32 {}

/** *Handshake status after delegated tasks: 0 done, 1 wrap, 2 unwrap, */
/** *3 unwrap again, `-1` failed. */
#[os("android")]
#[c("loam_android_tls_status")]
fn c_jt_status(handle: i32) -> i32 {}

/** *One `wrap`. `counts` is consumed, produced, and bytes still staged. */
/** *0 ok, 1 overflow, 3 closed, 4 staged bytes only, `-1` failed. */
#[os("android")]
#[c("loam_android_tls_wrap")]
fn c_jt_wrap(handle: i32, src: &[]u8, src_len: i32, dst: &mut []u8, dst_cap: i32, counts: &mut []i32) -> i32 {}

/** *One `unwrap`. Same `counts` and codes as `c_jt_wrap`, plus 2 when the */
/** *ciphertext is short of a record. */
#[os("android")]
#[c("loam_android_tls_unwrap")]
fn c_jt_unwrap(handle: i32, src: &[]u8, src_len: i32, dst: &mut []u8, dst_cap: i32, counts: &mut []i32) -> i32 {}

/** *Plaintext the engine still holds for the caller. */
#[os("android")]
#[c("loam_android_tls_pending")]
fn c_jt_pending(handle: i32) -> i32 {}

#[os("android")]
#[c("loam_android_tls_close")]
fn c_jt_close(handle: i32) -> i32 {}

#[os("android")]
#[c("loam_android_tls_free")]
fn c_jt_free(handle: i32) {}

/** *`send` of the front of a Loam buffer. `ssize_t` here is 8 bytes. */
#[os("android")]
#[c("send")]
fn c_send_buf(fd: i32, bytes: &[]u8, len: i64, flags: i32) -> i64 {}


// --- name lookup and C memory, for every backend --------------------------------------

#[os("apple", "linux", "android")]
#[c("getaddrinfo")]
fn c_getaddrinfo(host: string, service: string, hints: &[]i32, list: &mut []i64) -> i32 {}

#[os("apple", "linux", "android")]
#[c("freeaddrinfo")]
fn c_freeaddrinfo(list: i64) {}

/** *Winsock's `getaddrinfo`, after `WSAStartup` (it may be the first */
/** *Winsock call). */
#[os("windows")]
fn c_getaddrinfo(host: string, service: string, hints: &[]i32, list: &mut []i64) -> i32 {
    if !start_winsock() {
        return -1
    }
    return c_wsa_getaddrinfo(host, service, hints, list)
}

#[os("windows")]
fn c_freeaddrinfo(list: i64) {
    c_wsa_freeaddrinfo(list)
}

#[os("windows")]
unsafe fn c_connect_at(fd: i32, addr: i64, len: u32) -> i32 {
    return c_wsa_connect_at(i64(fd), addr, i32(len))
}

#[os("windows")]
unsafe fn c_recv_at(fd: i32, into: i64, len: i64, flags: i32) -> i64 {
    let part = if len > i64(2147483647) { i64(2147483647) } else { len }
    return i64(c_wsa_recv_at(i64(fd), into, i32(part), flags))
}

#[os("windows")]
#[c("getaddrinfo", "link -lws2_32")]
fn c_wsa_getaddrinfo(host: string, service: string, hints: &[]i32, list: &mut []i64) -> i32 {}

#[os("windows")]
#[c("freeaddrinfo", "link -lws2_32")]
fn c_wsa_freeaddrinfo(list: i64) {}

#[os("windows")]
#[c("connect", "link -lws2_32")]
unsafe fn c_wsa_connect_at(sock: i64, addr: i64, len: i32) -> i32 {}

#[os("windows")]
#[c("recv", "link -lws2_32")]
unsafe fn c_wsa_recv_at(sock: i64, into: i64, len: i32, flags: i32) -> i32 {}

/** *`connect` to an address C handed over (an `addrinfo`'s `ai_addr`). */
#[os("apple", "linux", "android")]
#[c("connect")]
unsafe fn c_connect_at(fd: i32, addr: i64, len: u32) -> i32 {}

/** *`recv` into a buffer C handed over (the backend's own). */
#[os("apple", "linux")]
#[c("recv")]
unsafe fn c_recv_at(fd: i32, into: i64, len: i64, flags: i32) -> i64 {}

/** *`memcpy` between C's memory and a Loam cell: the `addrinfo` walk and */
/** *the callbacks' length word. Only this module's wrappers call them, each */
/** *with an address C just handed over and its exact size. */
#[os("apple", "linux", "windows", "android")]
#[c("memcpy")]
unsafe fn c_load_words(dst: &mut []i64, src: i64, n: i64) -> i64 {}

#[os("apple")]
#[c("memcpy")]
unsafe fn c_load_words_u64(dst: &mut []u64, src: i64, n: i64) -> i64 {}

#[os("apple")]
#[c("memcpy")]
unsafe fn c_store_words_u64(dst: i64, src: &[]u64, n: i64) -> i64 {}
