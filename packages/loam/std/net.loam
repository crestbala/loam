// --- TCP over Winsock (Windows) -----------------------------------------------------------
//
// The TCP logic above is shared with POSIX. Here the `c_*` calls it makes
// get Windows variants with the same Loam signatures, each over a Winsock
// binding: a send is offered at most 64 KiB, a `SOCKET` is 64 bits (it must fit an `int` handle below
// `TLS_BASE`, which Windows handles do), lengths are `int`, `close` is
// `closesocket`, the error is `WSAGetLastError` (`WSAEINTR` read as
// `EINTR`), a read timeout is a `DWORD` of ms, and a `WSAPOLLFD` is 16
// bytes (`SOCKET`, `events`, `revents`) with `POLLRDNORM` / `POLLWRNORM`,
// so `c_poll` copies the POSIX-shaped set in and the results back.
// Winsock starts on the first socket. Layouts and constants are checked by
// `nob integration c_layouts` (zig, `x86_64-windows-gnu`).

/** *Winsock 2.2, as `WSAStartup` asks for it. */
const WINSOCK_2_2: u16 = 514
/** *`WSADATA` is 408 bytes on 64-bit Windows; this cell has room. */
const WSADATA_BYTES: int = 512
const WSAEINTR: i32 = 10004
/** *The most one Winsock `send` is offered (see `c_send_at`). */
const WINSOCK_SEND_MAX: int = 65536
/** *`FIONBIO` as the `long` `ioctlsocket` takes. */
const FIONBIO: i32 = -2147195266
const HANDLE_FLAG_INHERIT: u32 = 1
const POLLRDNORM: i32 = 256
const POLLRDBAND: i32 = 512
const POLLWRNORM: i32 = 16
const WSA_POLLERR: i32 = 1
const WSA_POLLHUP: i32 = 2
const WSA_POLLNVAL: i32 = 4
/** *POSIX `revents` bits the shared code reads (any nonzero is ready). */
const POLLERR: i32 = 8
const POLLHUP: i32 = 16
const POLLNVAL: i32 = 32

/** *Winsock started (once a process). */
let mut winsock_started: bool = false
/** *`ioctlsocket`'s `u_long` argument. */
let mut ulong_cell: []u32 = []u32 {}
/** *The `WSAPOLLFD` set `c_poll` hands Winsock: two words a socket. */
let mut wsa_poll_set: []i64 = []i64 {}

/** *`WSAStartup` on the first socket; `false` when Winsock will not start. */
#[os("windows")]
fn start_winsock() -> bool {
    if !winsock_started {
        let mut data = buf.with_len(WSADATA_BYTES)
        if c_wsa_startup(WINSOCK_2_2, data) != 0 {
            return false
        }
        winsock_started = true
    }
    return true
}

/** *A Winsock `SOCKET` as a handle: `-1` (and closed) unless it fits below */
/** *`TLS_BASE`. */
#[os("windows")]
fn socket_handle(sock: i64) -> i32 {
    if sock < i64(0) {
        return -1
    }
    if sock >= i64(TLS_BASE) {
        c_closesocket(sock)
        return -1
    }
    return i32(sock)
}

/** *Not inherited: a child the program spawns must not hold the socket, */
/** *or a port stays bound after the server exits (POSIX close-on-exec). */
#[os("windows")]
fn set_cloexec(fd: i32) {
    c_set_handle_information(i64(fd), HANDLE_FLAG_INHERIT, u32(0))
}

/** *Non-blocking through `ioctlsocket(FIONBIO)`: `0`, or `-1`. */
#[os("windows")]
fn set_nonblock(fd: i32) -> int {
    if ulong_cell.len == 0 {
        ulong_cell.push(u32(0))
    }
    ulong_cell[0] = u32(1)
    return if c_ioctlsocket(i64(fd), FIONBIO, ulong_cell) == 0 { 0 } else { -1 }
}

#[os("windows")]
fn c_socket(domain: i32, kind: i32, protocol: i32) -> i32 {
    if !start_winsock() {
        return -1
    }
    return socket_handle(c_wsa_socket(domain, kind, protocol))
}

#[os("windows")]
fn c_connect(fd: i32, addr: &[]u8, len: u32) -> i32 {
    return c_wsa_connect(i64(fd), addr, i32(len))
}

#[os("windows")]
fn c_bind(fd: i32, addr: &[]u8, len: u32) -> i32 {
    return c_wsa_bind(i64(fd), addr, i32(len))
}

#[os("windows")]
fn c_listen(fd: i32, backlog: i32) -> i32 {
    return c_wsa_listen(i64(fd), backlog)
}

#[os("windows")]
fn c_accept(fd: i32, addr: i64, len: i64) -> i32 {
    return socket_handle(c_wsa_accept(i64(fd), addr, len))
}

#[os("windows")]
fn c_getsockname(fd: i32, addr: &mut []u8, len: &mut []u32) -> i32 {
    return c_wsa_getsockname(i64(fd), addr, len)
}

#[os("windows")]
fn c_setsockopt(fd: i32, level: i32, name: i32, value: &[]i32, len: u32) -> i32 {
    return c_wsa_setsockopt(i64(fd), level, name, value, i32(len))
}

/** *A `struct timeval` option as Winsock's `DWORD` of milliseconds. */
#[os("windows")]
fn c_setsockopt_time(fd: i32, level: i32, name: i32, value: &[]i64, len: u32) -> i32 {
    let ms = []i32 { i32(value[0] * i64(1000) + value[1] / i64(1000)) }
    return c_wsa_setsockopt(i64(fd), level, name, ms, 4)
}

#[os("windows")]
fn c_getsockopt(fd: i32, level: i32, name: i32, value: &mut []i32, len: &mut []u32) -> i32 {
    return c_wsa_getsockopt(i64(fd), level, name, value, len)
}

/** *One `recv`; Winsock takes an `int` length. */
#[os("windows")]
fn c_recv(fd: i32, into: &mut []u8, len: i64, flags: i32) -> i64 {
    return i64(c_wsa_recv(i64(fd), into, i32(len), flags))
}

/** *One `send` of at most 64 KiB; the caller sends the rest. A non-blocking */
/** *Winsock `send` takes a buffer of any size whenever the send buffer has */
/** *room (it overcommits), so an uncapped send would park a whole reply in */
/** *the kernel: a reader that stalls could never be noticed or dropped, and */
/** *each socket could pin megabytes. Capped, it takes about what fits, as */
/** *POSIX does. */
#[os("windows")]
fn c_send_at(fd: i32, bytes: i64, len: i64, flags: i32) -> i64 {
    let part = if len > i64(WINSOCK_SEND_MAX) { i64(WINSOCK_SEND_MAX) } else { len }
    return i64(c_wsa_send(i64(fd), bytes, i32(part), flags))
}

#[os("windows")]
fn c_close(fd: i32) -> i32 {
    return c_closesocket(i64(fd))
}

/** *The last Winsock error, `WSAEINTR` as `EINTR` for the shared retries. */
#[os("windows")]
fn c_errno() -> i32 {
    let e = c_wsa_get_last_error()
    return if e == WSAEINTR { EINTR } else { e }
}

/** *`poll` over `WSAPoll`: each `pollfd` (fd, then `events` and `revents` */
/** *as halves of one word) is copied to a `WSAPOLLFD` and its results */
/** *back. An empty set sleeps, as `poll` does (`WSAPoll` rejects it). */
#[os("windows")]
fn c_poll(fds: &mut []i32, n: int, ms: i32) -> i32 {
    if n == 0 {
        c_sleep(u32(if ms > 0 { ms } else { 0 }))
        return 0
    }
    while wsa_poll_set.len < n * 2 {
        wsa_poll_set.push(i64(0))
    }
    for i in 0..n {
        let events = fds[i * 2 + 1] & 65535
        let mut wsa_events = 0
        if (events & POLLIN) != 0 {
            wsa_events = wsa_events | POLLRDNORM
        }
        if (events & POLLOUT) != 0 {
            wsa_events = wsa_events | POLLWRNORM
        }
        wsa_poll_set[i * 2] = i64(fds[i * 2])
        wsa_poll_set[i * 2 + 1] = i64(wsa_events)
    }
    let rc = c_wsa_poll(wsa_poll_set, u32(n), ms)
    for i in 0..n {
        let got = i32((wsa_poll_set[i * 2 + 1] >> 16) & i64(65535))
        let mut back = 0
        if (got & (POLLRDNORM | POLLRDBAND)) != 0 {
            back = back | POLLIN
        }
        if (got & POLLWRNORM) != 0 {
            back = back | POLLOUT
        }
        if (got & WSA_POLLERR) != 0 {
            back = back | POLLERR
        }
        if (got & WSA_POLLHUP) != 0 {
            back = back | POLLHUP
        }
        if (got & WSA_POLLNVAL) != 0 {
            back = back | POLLNVAL
        }
        fds[i * 2 + 1] = (fds[i * 2 + 1] & 65535) | (back << 16)
    }
    return rc
}

