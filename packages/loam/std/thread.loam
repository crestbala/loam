//! `thread` — OS threads for CPU-bound work + Send-disciplined channels (std:thread).
//!
//! The UI thread is the only thread (§5.1), and Loam fns normally run on it —
//! module globals, arenas, and signals are single-threaded by design. A
//! *language thread* is a detached OS thread running one `fn()` for heavy
//! compute; the compile-time **Send discipline** keeps it honest:
//!
//! - `spawn(cb)` runs `cb` (a closure, or a plain fn name) on a new OS thread.
//!   A closure's captures must be **Send**: plain data — int / float / bool /
//!   string / `Chan<T>` / structs of those — never `[]T`, `fn`, `Box`, or
//!   `&T` (that bookkeeping is single-threaded by design).
//! - The spawned fn and everything it calls may not touch module state
//!   (globals, zeus arenas, async timers) or the C seam, except pure value
//!   helpers (`loam` rejects the rest at compile time). Values go **in** as
//!   captures; results come **out** through a `channel<T>`.
//! - `channel<T>` is a bounded FIFO of Send `T` guarded by the C runtime:
//!   `recv` blocks (workers pulling jobs), `try_recv` never blocks (the UI
//!   drain), `try_send` never blocks (the UI posting jobs), `ready` peeks.
//!   The UI thread drains, so results compose with signals.
//!
//! ```
//! import "std:thread"
//! import "std:async"
//! import "std:fmt"
//!
//! fn crunch(n: int) -> int {        // pure helper: no globals, no C seam
//!     return n * n
//! }
//!
//! fn main() {
//!     let results = thread.chan(4, 0)
//!     thread.spawn(|| {              // captures Chan<int>: Send
//!         results.send(crunch(4000))
//!     })
//!     while results.ready() == 0 {   // UI side: never blocks
//!         async.sleep(1)
//!     }
//!     let n = results.try_recv()
//!     fmt.println("crunched:", n)
//! }
//! ```
//!
//! A worker pool is the same shape with a job channel: one `jobs` chan + one
//! `done` chan, one `spawn(|| …)` per worker that loops `jobs.recv()`, sends
//! results on `done`, and exits on a sentinel job — every worker is a closure
//! capturing the two local handles, so no module state is involved.
//!
//! While any worker is running, `async.busy()` is true, so the zeus hosts keep
//! drawing frames and a UI drain (`async.interval(16, …)`) sees results the
//! frame they arrive. wasm has no threads: `spawn` is a no-op and channels are
//! inert (code compiles and runs single-threaded).

/// A bounded, thread-safe mailbox: `chan` creates it, `send` / `try_send`
/// fill it, `recv` / `try_recv` drain it. `T` must be Send (see the module
/// doc): int, float, bool, string, or a struct/array of Send fields. The
/// handle is Copy, so one channel may feed several workers.
struct Chan<T> {
    id: int,
}

/// Run `cb` on a new detached OS thread. `cb` must be a fn name or a closure
/// whose captures are Send, and its code (plus everything it calls) may not
/// touch module state or the C seam — `loam` checks all of that. Bodyless:
/// `loam_thread_spawn` (pthread, detached; results return via channels).
fn spawn(cb: fn()) {}

/// 1 while at least one spawned fn is still running. `async.busy()` reads
/// this so the UI keeps drawing frames until every worker is done. Bodyless:
/// `loam_thread_running`.
fn running() -> int {}

/// Create a bounded channel of `T` with `cap` slots. `init` is a dummy value
/// that pins `T` (like `async.future`), never sent. Capacity ≥ 1; `send`
/// blocks a full channel, `try_send` reports full instead.
fn chan<T>(cap: int, init: T) -> Chan<T> {
    return Chan { id: __ch_new(cap, init) }
}

/// Blocking send: waits while the channel is full. Workers use this to return
/// results; the UI thread should use `try_send` (never block the UI thread).
fn send<T>(c: Chan<T>, v: T) {
    __ch_send(c.id, v)
}

/// Non-blocking send: 1 when `v` was queued, 0 when the channel is full.
fn try_send<T>(c: Chan<T>, v: T) -> int {
    return __ch_try_send(c.id, v)
}

/// Blocking receive: waits while the channel is empty. Worker side only —
/// never call this on the UI thread; use `ready` + `try_recv` there.
fn recv<T>(c: Chan<T>) -> T {
    let v: T = __ch_recv(c.id)
    return v
}

/// Non-blocking receive. Only valid when `ready(c) > 0` (the value is zeroed
/// otherwise); a single UI drain loop owns the channel, so the peek-pop pair
/// cannot race. Workers pulling jobs use `recv`.
fn try_recv<T>(c: Chan<T>) -> T {
    let v: T = __ch_pop(c.id)
    return v
}

/// Number of messages waiting. The UI drain pattern:
/// `while ch.ready() > 0 { let v = ch.try_recv() ... }`.
fn ready<T>(c: Chan<T>) -> int {
    return __ch_ready(c.id)
}
