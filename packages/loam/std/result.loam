//! result — `Res<T>`, `Result<T>` and `Option<T>`: checked outcomes for
//! fallible APIs (§1.1).
//!
//! A value of any of these is marked `#[must_check]`: dropping one without
//! reading a field is a **compile error**, so a caller cannot silently ignore a
//! failure (`let r = http.call(...)` and then never touching `r`).
//!
//! `Result<T>` and `Option<T>` are *tagged* containers: `tag` is one of the
//! `ResultTag` / `OptionTag` enum variants, and the payload (`val`, `err`) is
//! read only on the right branch. The `?` operator propagates the failure: in a
//! function returning `Result<T>`, `expr?` returns the failure early and yields
//! the value otherwise.
//!
//! ```
//! import "std:result"
//!
//! fn half(n: int) -> Result<int> {
//!     if n % 2 != 0 {
//!         return result.res_err("odd", 0)
//!     }
//!     return result.res_ok(n / 2)
//! }
//!
//! fn quarter(n: int) -> Result<int> {
//!     let h = half(n)?          // early-returns on failure
//!     return result.res_ok(h / 2)
//! }
//! ```
//!
//! `Res<T>` (the older `{ ok, val, err }` shape) is kept for the HTTP/proto
//! edge; new code should prefer `Result<T>`.

/// The two outcomes of `Result<T>`.
enum ResultTag {
    Ok = 0,
    Err = 1,
}

/// The two outcomes of `Option<T>`.
enum OptionTag {
    Some = 0,
    None = 1,
}

/// A fallible outcome with a payload. Read `val` only when `tag == ResultTag.Ok`
/// and `err` only when `tag == ResultTag.Err`.
#[must_check]
struct Result<T> {
    tag: int,
    val: T,
    err: string,
}

/// An optional value. Read `val` only when `tag == OptionTag.Some`.
#[must_check]
struct Option<T> {
    tag: int,
    val: T,
}

/// A successful `Result` carrying `v`.
fn res_ok<T>(v: T) -> Result<T> {
    return Result { tag: ResultTag.Ok, val: v, err: "" }
}

/// A failed `Result` carrying `e`; `dflt` stands in for the absent payload.
fn res_err<T>(e: string, dflt: T) -> Result<T> {
    return Result { tag: ResultTag.Err, val: dflt, err: e }
}

/// An `Option` carrying `v`.
fn some<T>(v: T) -> Option<T> {
    return Option { tag: OptionTag.Some, val: v }
}

/// An empty `Option`; `dflt` stands in for the absent payload.
fn none<T>(dflt: T) -> Option<T> {
    return Option { tag: OptionTag.None, val: dflt }
}

fn is_ok<T>(r: Result<T>) -> bool {
    return r.tag == ResultTag.Ok
}

fn is_err<T>(r: Result<T>) -> bool {
    return r.tag == ResultTag.Err
}

fn is_some<T>(o: Option<T>) -> bool {
    return o.tag == OptionTag.Some
}

/// The value, or a trap naming the failure. Use when a failure is genuinely
/// unrecoverable at this call site.
fn unwrap<T>(r: Result<T>) -> T {
    if r.tag != ResultTag.Ok {
        panic(r.err)
    }
    return r.val
}

/// The value, or `dflt` when the result is a failure.
fn unwrap_or<T>(r: Result<T>, dflt: T) -> T {
    if r.tag == ResultTag.Ok {
        return r.val
    }
    return dflt
}

/// The value, or a trap. Use when an absent value is unrecoverable here.
fn unwrap_some<T>(o: Option<T>) -> T {
    if o.tag != OptionTag.Some {
        panic("unwrap_some on None")
    }
    return o.val
}

/// The value, or `dflt` when the option is `None`.
fn some_or<T>(o: Option<T>, dflt: T) -> T {
    if o.tag == OptionTag.Some {
        return o.val
    }
    return dflt
}

// --- `Res<T>`: the older `{ ok, val, err }` shape, kept for the C edge -------

/// A fallible outcome. Read `val` only when `ok` is true.
#[must_check]
struct Res<T> {
    ok: bool,
    val: T,
    err: string,
}

/// A successful result carrying `v`.
fn ok<T>(v: T) -> Res<T> {
    return Res { ok: true, val: v, err: "" }
}

/// A failed result carrying `e`; `dflt` stands in for a value that is absent.
fn err<T>(e: string, dflt: T) -> Res<T> {
    return Res { ok: false, val: dflt, err: e }
}

/// The value, or a trap when the operation failed. Use when a failure is
/// genuinely unrecoverable at this call site.
fn or_trap<T>(r: Res<T>) -> T {
    if !r.ok {
        panic(r.err)
    }
    return r.val
}

/// The value, or `dflt` when the operation failed.
fn or<T>(r: Res<T>, dflt: T) -> T {
    if r.ok {
        return r.val
    }
    return dflt
}
