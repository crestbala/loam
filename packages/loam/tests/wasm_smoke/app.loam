// Minimal app for the headless wasm smoke test: build a tree and stop. No
// assertions — under stubbed host imports the draw/measure calls are no-ops,
// so the point is only that the host entry points link and run.

import "zeus"
import "zui"

fn main() {
    let count = zeus.signal(5)
    zeus.snapshot(320, 200, fn() -> Node {
        zeus.Box(style = Style(direction = Direction.Column)) {
            zeus.Text("smoke")
            zui.Button(label = "Go")
        }
    })
}
