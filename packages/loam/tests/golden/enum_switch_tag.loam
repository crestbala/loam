// A `switch` over the tag of a `Result<T>`: the payload is read per case.

import "std:fmt"
import "std:result"

fn describe(r: Result<int>) -> string {
    switch r.tag {
        case ResultTag.Ok:
            if r.val > 0 {
                return "positive"
            }
            return "non-positive"
        case ResultTag.Err:
            return r.err
    }
}

fn main() {
    fmt.println(describe(result.res_ok(3)))
    fmt.println(describe(result.res_ok(-3)))
    fmt.println(describe(result.res_err("bad", 0)))
}
