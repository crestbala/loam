// In-language tests for `std:str` (byte-level string helpers).

import "std:test"
import "std:str"

#[test]
fn test_slice_clamps() {
    test.assert_eq_str(str.slice("hello", 1, 3), "el")
    test.assert_eq_str(str.slice("hello", -4, 2), "he")
    test.assert_eq_str(str.slice("hello", 3, 99), "lo")
    test.assert_eq_str(str.slice("hello", 4, 2), "")
    test.assert_eq_str(str.slice_from("hello", 2), "llo")
}

#[test]
fn test_search() {
    test.assert(str.starts_with("blob:abc", "blob:"))
    test.assert(!str.starts_with("bl", "blob:"))
    test.assert(str.ends_with("movie.mkv", ".mkv"))
    test.assert(!str.ends_with("mkv", ".mkv"))
    test.assert(str.starts_with("x", ""))
    test.assert(str.ends_with("x", ""))
    test.assert_eq_int(str.index_of("a/b/c", "/"), 1)
    test.assert_eq_int(str.index_from("a/b/c", "/", 2), 3)
    test.assert_eq_int(str.index_of("abc", "z"), -1)
    test.assert_eq_int(str.index_of("abc", ""), 0)
    test.assert_eq_int(str.last_index_of("a/b/c", "/"), 3)
    test.assert_eq_int(str.last_index_of("abc", ""), 3)
    test.assert_eq_int(str.last_index_of("abc", "abcd"), -1)
    test.assert_eq_int(str.index_of_byte("a.b.c", 46), 1)
    test.assert_eq_int(str.last_index_of_byte("a.b.c", 46), 3)
    test.assert_eq_int(str.last_index_of_byte("abc", 46), -1)
    test.assert(str.contains("hello world", "o w"))
    test.assert_eq_int(str.count("aaaa", "aa"), 2)
    test.assert_eq_int(str.count("abc", ""), 0)
}

#[test]
fn test_trim() {
    test.assert_eq_str(str.trim("  \t hi there \r\n"), "hi there")
    test.assert_eq_str(str.trim("   "), "")
    test.assert_eq_str(str.trim_start("  hi  "), "hi  ")
    test.assert_eq_str(str.trim_end("  hi  "), "  hi")
    test.assert(str.is_blank(" \n\t"))
    test.assert(!str.is_blank(" x "))
    test.assert_eq_str(str.strip_prefix("https://x", "https://"), "x")
    test.assert_eq_str(str.strip_prefix("x", "https://"), "x")
    test.assert_eq_str(str.strip_suffix("a.tmp", ".tmp"), "a")
    test.assert_eq_str(str.trim_end_byte("/tmp///", 47), "/tmp")
    test.assert_eq_str(str.trim_end_byte("/", 47), "/")
}

#[test]
fn test_case() {
    test.assert_eq_str(str.to_upper("mkv-1.é"), "MKV-1.é")
    test.assert_eq_str(str.to_lower("HeLLo"), "hello")
    test.assert(str.eq_fold("MP4", "mp4"))
    test.assert(!str.eq_fold("mp4", "mp3"))
}

#[test]
fn test_split_join() {
    let p = str.split("a,,b", ",")
    test.assert_eq_int(p.len, 3)
    test.assert_eq_str(p[0], "a")
    test.assert_eq_str(p[1], "")
    test.assert_eq_str(p[2], "b")
    test.assert_eq_int(str.split("", ",").len, 1)
    test.assert_eq_int(str.split("abc", "").len, 1)
    test.assert_eq_str(str.join(str.split("x--y--z", "--"), "+"), "x+y+z")
    test.assert_eq_str(str.join([]string {}, ","), "")
    let ls = str.lines("one\r\ntwo\nthree")
    test.assert_eq_int(ls.len, 3)
    test.assert_eq_str(ls[0], "one")
    test.assert_eq_str(ls[2], "three")
    test.assert_eq_str(str.replace_all("a.b.c", ".", "::"), "a::b::c")
    test.assert_eq_str(str.replace_all("abc", "", "x"), "abc")
}

#[test]
fn test_build() {
    test.assert_eq_str(str.repeat("ab", 3), "ababab")
    test.assert_eq_str(str.repeat("ab", 0), "")
    test.assert_eq_str(str.pad_start("7", 2, 48), "07")
    test.assert_eq_str(str.pad_start("123", 2, 48), "123")
    test.assert_eq_str(str.pad_end("ab", 4, 46), "ab..")
    test.assert_eq_str(str.shell_quote("it's"), "'it'\\''s'")
    test.assert_eq_str(str.shell_quote(""), "''")
}

#[test]
fn test_method_syntax() {
    let name = "  Movie.MKV "
    test.assert_eq_str(name.trim().to_lower(), "movie.mkv")
    test.assert(name.trim().ends_with(".MKV"))
    test.assert_eq_int("a/b".index_of("/"), 1)
}
