// In-language tests for the zeus design tokens.
//
// The §2 contrast requirement — "every text/background pair meets WCAG AA" —
// is a property, so it is checked rather than asserted in prose. The first
// cut of these tokens failed four pairs (white on the amber and green
// solids, the sunset accent's ink on neutral step 3, and a duplicate enum
// name that silently bound white text against a pale wash); all four were
// found here, not by eye.

import "std:test"
import "std:zeus"

/// Every ink the system can draw, against every surface it can draw it on,
/// for one appearance. Traps naming the offending pair.
fn check_all_pairs(label: string) {
    let surfaces = []int {
        zeus.role_rgb_now(zeus.ROLE.N1),
        zeus.role_rgb_now(zeus.ROLE.N2),
        zeus.role_rgb_now(zeus.ROLE.N3),
    }
    let inks = []int {
        zeus.role_rgb_now(zeus.ROLE.N11),
        zeus.role_rgb_now(zeus.ROLE.N12),
        zeus.role_rgb_now(zeus.ROLE.OkS11),
        zeus.role_rgb_now(zeus.ROLE.WarnS11),
        zeus.role_rgb_now(zeus.ROLE.DangerS11),
        zeus.role_rgb_now(zeus.ROLE.InfoS11),
        zeus.role_rgb_now(zeus.ROLE.A11),
    }
    for si in 0..surfaces.len {
        for ii in 0..inks.len {
            if zeus.meets_aa(inks[ii], surfaces[si]) == 0 {
                let r = zeus.contrast_ratio(inks[ii], surfaces[si])
                test.fail("{{label}}: ink {{ii}} on surface {{si}} is {{r}} (<450)")
            }
        }
    }
    // Text on a solid control fill is component text: AA's 3:1 applies.
    let fg = []int {
        zeus.role_rgb_now(zeus.ROLE.OnAccent),
        zeus.role_rgb_now(zeus.ROLE.OnOk),
        zeus.role_rgb_now(zeus.ROLE.OnWarn),
        zeus.role_rgb_now(zeus.ROLE.OnDanger),
        zeus.role_rgb_now(zeus.ROLE.OnInfo),
    }
    let bg = []int {
        zeus.role_rgb_now(zeus.ROLE.A9),
        zeus.role_rgb_now(zeus.ROLE.OkS9),
        zeus.role_rgb_now(zeus.ROLE.WarnS9),
        zeus.role_rgb_now(zeus.ROLE.DangerS9),
        zeus.role_rgb_now(zeus.ROLE.InfoS9),
    }
    for i in 0..fg.len {
        if zeus.meets_aa_large(fg[i], bg[i]) == 0 {
            let r = zeus.contrast_ratio(fg[i], bg[i])
            test.fail("{{label}}: on-fill {{i}} is {{r}} (<300)")
        }
    }
}

/// The contrast math itself, against hand-checkable references. Without this
/// the suite above could pass by being uniformly wrong.
#[test]
fn contrast_matches_known_ratios() {
    let white = 16777215
    let black = 0
    // The two ends of the scale.
    test.assert_eq_int(zeus.contrast_ratio(black, white), 2100)
    test.assert_eq_int(zeus.contrast_ratio(white, white), 100)
    // Symmetry: the ratio does not depend on argument order.
    test.assert_eq_int(zeus.contrast_ratio(black, white),
                       zeus.contrast_ratio(white, black))
    // The value the design audit flagged: the old `faint` on the old page
    // background, which is why captions and placeholders were illegible.
    test.assert_eq_int(zeus.contrast_ratio(zeus.parse_hex_color("#a9b2bc"), white), 214)
    // White on the brand orange, the reason `on_accent` is computed and not
    // assumed.
    test.assert_eq_int(zeus.contrast_ratio(white, zeus.parse_hex_color("#ff6308")), 298)
}

/// `best_on` must pick the ink that actually wins, not a fixed one.
#[test]
fn best_on_picks_the_passing_ink() {
    // Orange is light enough to need dark ink...
    test.assert(zeus.best_on(zeus.parse_hex_color("#ff6308")) != 16777215)
    // ...and indigo is dark enough to need white.
    test.assert_eq_int(zeus.best_on(zeus.parse_hex_color("#4f46e5")), 16777215)
}

/// Every accent, in both appearances.
#[test]
fn every_accent_meets_aa_in_both_appearances() {
    for a in 0..zeus.accent_count() {
        zeus.set_accent(a)
        zeus.appearance().set(0)
        check_all_pairs("{{zeus.accent_name(a)}}/light")
        zeus.appearance().set(1)
        check_all_pairs("{{zeus.accent_name(a)}}/dark")
    }
    zeus.set_accent(zeus.ACCENT.Blue)
    zeus.appearance().set(0)
}

/// Spacing is a 4pt grid. An off-grid step is the kind of thing that creeps
/// back in one careless edit at a time.
#[test]
fn spacing_is_on_a_four_point_grid() {
    let steps = []int {
        SPACE.None, SPACE.Exxxs, SPACE.Exxs, SPACE.Exs, SPACE.Xs, SPACE.Sm,
        SPACE.Md, SPACE.Lg, SPACE.Xl, SPACE.Xxl, SPACE.Xxxl, SPACE.Xxxxl,
    }
    for i in 0..steps.len {
        test.assert_eq_int(steps[i] % 4, 0)
    }
    // And it must stay monotonic, or "bigger name, bigger gap" stops holding.
    let mut prev = -1
    for i in 0..steps.len {
        test.assert(steps[i] >= prev)
        prev = steps[i]
    }
}

/// Motion has exactly three durations, ordered.
#[test]
fn motion_durations_are_ordered() {
    test.assert_eq_int(MOTION.Fast, 120)
    test.assert_eq_int(MOTION.Base, 200)
    test.assert_eq_int(MOTION.Slow, 320)
}
