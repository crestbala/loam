// DRAW-list golden: deterministic headless paint of common zeus chrome —
// buttons, the semantic alert tiers, role-backed native thumbs, badges, and
// the skeleton token. Any change that moves a pixel or a palette value shows
// up here first. Keep this file free of prints: stdout is the golden.

import "std:zeus"
import "std:zui"

fn main() {
    zeus.snapshot(560, 360, fn() -> Node {
        let load = zeus.signal(30)
        let on = zeus.signal(1)
        zui.Page() {
            zui.Row(SPACE.Sm) {
                zui.Button("Primary", look = zeus.LOOK.Solid, size = zeus.SIZE.Md)
                zui.Button("Soft", look = zeus.LOOK.Soft, size = zeus.SIZE.Md)
                zui.Button("Outline", look = zeus.LOOK.Outline, size = zeus.SIZE.Md)
                zui.Button("Danger", look = zeus.LOOK.Danger, size = zeus.SIZE.Md)
            }
            zui.Row(SPACE.Sm) {
                zui.Badge("ok", zeus.TINT.Ok)
                zui.Badge("warn", zeus.TINT.Warn)
                zui.Badge("bad", zeus.TINT.Danger)
                zui.Chip("busy", zeus.TINT.Warn)
            }
            zui.AlertWarning("Low disk", "The volume is almost full.")
            zui.Row(SPACE.Sm) {
                zui.Switch(on)
                zui.Progress(load)
            }
            zui.Row(SPACE.Sm) {
                zui.Skeleton(96, 24, 8)
            }
        }
    })
}
