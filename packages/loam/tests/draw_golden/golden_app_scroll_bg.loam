// DRAW-list golden: zeus.App paints the page background on its root
// scroller (theme-aware, like `Page`), so the viewport behind short
// content — and the strips revealed while content rubber-bands past an
// edge — stays paper, never the host's clear color (black on a dark
// window / wasm page). Byte-exact on deterministic metrics.
// Keep stdout as the golden; no extra prints.

import "std:zeus"
import "std:design"

fn main() {
    zeus.App("zeus-snap", fn() {
        design.Page() {
            design.Display("Short page")
            design.Body("Content ends here; the area below stays paper,")
            design.Body("and edge overscroll reveals paper, not black.")
        }
    }, 420, 320)
    zeus.engine_paint()
    zeus.dump_draw_list()
}
