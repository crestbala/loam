// DRAW-list golden: an open CommandPalette with its search field and two
// sectioned commands, the first highlighted. Keep this file free of prints:
// stdout is the golden.

import "zeus"
import "zui"

fn main() {
    let open = zeus.signal(true)
    zeus.snapshot(560, 420, fn() -> Node {
        zui.Page() {
            zui.CommandPalette(open, []CommandItem { CommandItem(label = "New file", section = "File"),
                                                     CommandItem(label = "Save", section = "File"),
                                                     CommandItem(label = "Toggle theme", section = "View") })
        }
    })
}
