// DRAW-list golden: the first frame of examples/zeus/dracula, its route table at
// the root path, without the host-side start-up (loaders, stores, servers).
// Keep this file free of prints: stdout is the golden.

import "zeus"
import "../../../../examples/zeus/dracula/app_routes.loam" as approutes

fn main() {
    zeus.App("dracula", fn() -> Node {
        return approutes.app()
    })
    zeus.engine_paint()
    zeus.dump_draw_list()
}
