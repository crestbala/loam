// DRAW-list golden: the ConfirmDialog preset, open, with a destructive
// confirm button. Keep this file free of prints: stdout is the golden.

import "std:zeus"
import "std:zui"

fn main() {
    let open = zeus.signal(true)
    zeus.snapshot(480, 360, fn() -> Node {
        zui.Page() {
            zui.ConfirmDialog(open, title = "Delete project?", body = "This cannot be undone.",
                              confirm = "Delete", danger = true)
        }
    })
}
