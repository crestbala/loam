// DRAW-list golden: in-tree text metrics from a bound external font.
//
// `zeus.use_font` binds packages/loam/tests/fonts/tiny.ttf. tiny.ttf's
// space is 250/1000 em where the headless fallback charges 0.6em per byte, so:
//   * `ABC` lands at a smaller x after `A A`, and
//   * `AB AB AB` fits one 65px line in-tree but wraps to two without the font.
// The following Box marks the wrapped height. If the fixture font is missing
// the bind fails and both revert — so this golden also guards the external-font
// path. Keep this file free of prints: stdout is the golden.

import "std:zeus"
import "std:design"

fn main() {
    zeus.use_font("packages/loam/tests/fonts/tiny.ttf")
    zeus.snapshot(320, 220, fn() -> Node {
        design.Page() {
            design.Row(0) {
                zeus.Text("A A", font = 16)
                zeus.Text("ABC", font = 16)
            }
            zeus.Box(width = 65) {
                zeus.Text("AB AB AB", font = 16, wrap = 1)
            }
            zeus.Box(width = 20, height = 10)
        }
    })
}
