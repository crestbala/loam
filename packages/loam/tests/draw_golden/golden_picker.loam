// DRAW-list golden: the lazy calendar picker with its panel open — one 7x6
// grid, dynamic month label, live year, selected day. The second list is the
// sheet after its fade has settled. Keep this file free of prints: stdout is
// the golden.

import "zeus"
import "zui"

fn main() {
    let y = zeus.signal(2026)
    let m = zeus.signal(9)
    let d = zeus.signal(15)
    zeus.snapshot(400, 420, fn() -> Node {
        zui.Page() {
            zui.DatePicker(y, m, d)
        }
    })
    zeus.engine_click_text("Pick a date")
    // The sheet fades in. Step past the track so the golden is the settled panel.
    let mut i = 0
    while i < 60 {
        zeus.engine_step_dt(16)
        zeus.engine_layout(400, 420)
        zeus.engine_paint()
        i = i + 1
    }
    zeus.dump_draw_list()
}
