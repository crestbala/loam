// DRAW-list golden: the first frame of examples/zeus/gallery's Components
// page, in its App frame. Two parts are left out because they are not the
// same on every machine: the navbar (its RAM chip shows live process memory)
// and the Forms section (its draft comes from std:kv on the user's disk).
// Everything else on the page is the gallery's own code, in its order. Keep
// this file free of prints: stdout is the golden.

import "zeus"
import "zui:spacing"
import "zui"
import "../../../../examples/zeus/gallery/screen.loam" as screen

fn main() {
    zeus.App("Zeus Gallery", fn() -> Node {
        return zui.Page() {
            zui.Column(spacing.SECTION) {
                screen.DateSection()
                screen.ButtonScale()
                screen.DisplayRow()
                screen.Choice()
                screen.Controls()
                screen.People()
                screen.Data()
                screen.Disclosure()
                screen.Menus()
                screen.States()
                screen.Catalogue()
                screen.Primitives()
            }
        }
    })
    zeus.engine_paint()
    zeus.dump_draw_list()
}
