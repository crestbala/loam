// DRAW-list golden: one raster Image (data URI). Dump omits src so the
// golden is stable; hosts decode PNG / JPEG / WebP / GIF themselves.

import "std:zeus"
import "std:zui"

fn main() {
    zeus.snapshot(120, 48, fn() -> Node {
        zeus.Box(style = Style(padding = edges(8), background = "#ffffff")) {
            zui.Image("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAADElEQVR42mO4o6YGAAMKASneDRr/AAAAAElFTkSuQmCC", style = Style(width = px(32), height = px(32), radius = corners(4)))
        }
    })
}
