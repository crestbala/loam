// DRAW-list golden: gallery chrome at UI scale 1.0 (the Phase 7 exit
// criterion). Components read the `tk` scale token; `set_scale(100)` is the
// identity point this fixture pins — the whole screen must render exactly as
// the untokenized constants did (byte-exact on deterministic metrics).
// Keep stdout as the golden; no extra prints.

import "std:zeus"
import "std:design"

fn main() {
    let on = zeus.signal(1)
    let tab = zeus.signal(0)
    let pick = zeus.signal(0)
    let cur = zeus.signal(2)
    let name = zeus.signal("Ada")
    let note = zeus.signal("")
    zeus.set_scale(100)
    zeus.appearance().set(0)
    zeus.snapshot(640, 820, fn() -> Node {
        design.Page() {
            design.Navbar("Zeus")
            design.Row(SPACE.Sm) {
                design.Button("Primary", look = zeus.LOOK.Solid, size = zeus.SIZE.Md,
                            on_click = fn() {})
                design.Button("Outline", look = zeus.LOOK.Outline, size = zeus.SIZE.Lg,
                            on_click = fn() {})
                design.Button("Ghost", look = zeus.LOOK.Ghost, size = zeus.SIZE.Sm,
                            on_click = fn() {})
            }
            design.Row(SPACE.Sm) {
                design.Checkbox("Agree", on)
                design.Switch(on)
                design.Chip("busy", zeus.TINT.Warn)
                design.Badge("ok", zeus.TINT.Ok)
                design.Kbd("S")
            }
            design.Tabs(tab, []string {"One", "Two", "Three"})
            design.Row(SPACE.Sm) {
                design.Segmented(pick, []string {"A", "B", "C"})
            }
            design.Row(SPACE.Sm) {
                design.RadioGroup(pick, []string {"First", "Second"})
                design.Column(SPACE.Exs) {
                    design.Field("Name", name, "Ada")
                    design.Field("Email", note, "ada@zeus.dev")
                }
            }
            design.TextArea(note, "Message")
            design.Pagination(cur, 5)
            design.Alert("Heads up", "Tokens stay identical at scale 1.0.")
        }
    })
}
