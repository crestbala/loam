// DRAW-list golden: gallery chrome at UI scale 1.0 (the Phase 7 exit
// criterion). Components read the `tk` scale token; `set_scale(100)` is the
// identity point this fixture pins — the whole screen must render exactly as
// the untokenized constants did (byte-exact on deterministic metrics).
// Keep stdout as the golden; no extra prints.

import "std:zeus"
import "std:zui"

fn main() {
    let on = zeus.signal(true)
    let tab = zeus.signal(0)
    let pick = zeus.signal(0)
    let cur = zeus.signal(2)
    let name = zeus.signal("Ada")
    let note = zeus.signal("")
    zeus.set_scale(100)
    zeus.appearance().set(0)
    zeus.snapshot(640, 820, fn() -> Node {
        zui.Page() {
            zui.Navbar("Zeus")
            zui.Row(Space.Sm) {
                zui.Button("Primary", look = zeus.Look.Solid, size = zeus.Size.Md,
                            on_click = fn() {})
                zui.Button("Outline", look = zeus.Look.Outline, size = zeus.Size.Lg,
                            on_click = fn() {})
                zui.Button("Ghost", look = zeus.Look.Ghost, size = zeus.Size.Sm,
                            on_click = fn() {})
            }
            zui.Row(Space.Sm) {
                zui.Checkbox("Agree", on)
                zui.Switch(on)
                zui.Chip("busy", zeus.Tint.Warn)
                zui.Badge("ok", zeus.Tint.Ok)
                zui.Kbd("S")
            }
            zui.Tabs(tab, []string {"One", "Two", "Three"})
            zui.Row(Space.Sm) {
                zui.Segmented(pick, []string {"A", "B", "C"})
            }
            zui.Row(Space.Sm) {
                zui.RadioGroup(pick, []string {"First", "Second"})
                zui.Column(Space.Exs) {
                    zui.Field("Name", name, "Ada")
                    zui.Field("Email", note, "ada@zeus.dev")
                }
            }
            zui.TextArea(note, "Message")
            zui.Pagination(cur, 5)
            zui.Alert("Heads up", "Tokens stay identical at scale 1.0.")
        }
    })
}
