// DRAW-list golden: an open bottom Sheet with its grip and title, settled on
// the first frame. Keep this file free of prints: stdout is the golden.

import "zeus"
import "zui"

fn main() {
    let open = zeus.signal(true)
    zeus.snapshot(420, 480, fn() -> Node {
        zui.Page() {
            zui.Title("Page")
            zui.Sheet(open, title = "Filters") {
                zui.Body("A bottom sheet with a grip.")
            }
        }
    })
}
