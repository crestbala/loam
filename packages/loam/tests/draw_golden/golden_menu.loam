// DRAW-list golden: the Menu surface. An open dropdown anchored below its
// trigger, with the elevation shadow, a group label, a highlighted command row
// (the active index), a separator, and a destructive row. `active` starts at 1
// so the highlight is settled on this first frame. Keep this file free of
// prints: stdout is the golden.

import "std:zeus"

fn main() {
    let active = zeus.signal(1)
    zeus.snapshot(420, 260, fn() -> Node {
        zeus.Page() {
            let trigger = zeus.Button("Actions", look = zeus.LOOK.Outline, size = zeus.SIZE.Md)
            zeus.Menu(trigger, active = active, place = zeus.PLACE.PlaceBelow, width = 180) {
                zeus.MenuLabel("File")
                zeus.MenuItem(active = active, index = 0, count = 3, label = "Rename")
                zeus.MenuItem(active = active, index = 1, count = 3, label = "Duplicate")
                zeus.MenuSeparator()
                zeus.MenuItem(active = active, index = 2, count = 3, label = "Delete",
                              danger = true)
            }
        }
    })
}
