// DRAW-list golden: the Menu surface. An open dropdown anchored below its
// trigger, with the elevation shadow, a group label, a highlighted command row
// (the active index), a separator, and a destructive row. `active` starts at 1
// so the highlight is settled on this first frame. Keep this file free of
// prints: stdout is the golden.

import "std:zeus"
import "std:zui"

fn main() {
    let active = zeus.signal(1)
    zeus.snapshot(420, 260, fn() -> Node {
        zui.Page() {
            let trigger = zui.Button("Actions", look = zeus.LOOK.Outline, size = zeus.SIZE.Md)
            let rows = []MenuRow {
                MenuRow(label = "Rename"),
                MenuRow(label = "Duplicate"),
                MenuRow(label = "Delete", is_separated = true, danger = true),
            }
            zui.Menu(trigger, active = active, items = rows, label = "File",
                      place = zui.PLACE.PlaceBelow, width = 180)
        }
    })
}
