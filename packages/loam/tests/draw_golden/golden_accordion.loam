// DRAW-list golden: a three-row Accordion with the middle item open. One
// `open` index signal drives every row, so exactly one body paints. Keep this
// file free of prints: stdout is the golden.

import "std:zeus"
import "std:zui"

fn main() {
    let open = zeus.signal(1)
    zeus.snapshot(360, 220, fn() -> Node {
        zui.Page() {
            let rows = []AccordionRow {
                AccordionRow { title: "Shipping", body: "Ships in 2-3 days." },
                AccordionRow { title: "Returns", body: "30-day return window." },
                AccordionRow { title: "Warranty", body: "Two years, parts and labor." },
            }
            zui.Accordion(open, items = rows)
        }
    })
}
