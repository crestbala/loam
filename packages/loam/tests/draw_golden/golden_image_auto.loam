// DRAW-list golden: an `Image` with no explicit size takes the decoded
// source's aspect ratio and shrinks to the container (device) width — web
// `max-width: 100%` — while a width-only `Image` derives its height from the
// same ratio. The host reports the intrinsic size (macOS ImageIO: a 400x200
// PNG below). Hosts that report nothing (0) leave the box empty instead.

import "std:zeus"
import "std:design"

fn main() {
    zeus.snapshot(200, 200, fn() -> Node {
        zeus.Box(padding = 16, spacing = 8) {
            design.Image("data:image/png;base64,")
            design.Image("data:image/png;base64,", width = 100)
        }
    })
}
