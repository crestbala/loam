// DRAW-list golden: the app shell. AppShell with a Sidebar (NavGroup and
// NavItems, one selected), a header, a MasterDetail body and a SplitPane. The
// second dump collapses the sidebar to its rail. Keep this file free of
// prints: stdout is the golden.

import "zeus"
import "zui:colors"
import "zui:spacing"
import "zui"

fn main() {
    let collapsed = zeus.signal(false)
    let nav = zeus.signal(0)
    zeus.snapshot(720, 560, fn() -> Node {
        zui.Page() {
            zui.AppShell(sidebar = fn() {
                zui.Sidebar(collapsed) {
                    zui.NavGroup("Work", collapsed = collapsed) {
                        zui.NavItem("Inbox", zeus.IC_INFO, nav, 0, collapsed)
                        zui.NavItem("Drafts", zeus.IC_COPY, nav, 1, collapsed)
                    }
                }
            }, header = fn() { zui.Note("Header") },
               style = Style(height = px(240), borderWidth = spacing.HAIRLINE, borderColor = colors.rule())) {
                zui.MasterDetail(master = fn() { zui.Body("Projects") }) {
                    zui.Body("The open project.")
                }
            }
            zui.SplitPane(first = fn() {
                zeus.Box(style = Style(padding = 12)) { zui.Body("Source") }
            }, initial = 180, size = 96,
               style = Style(borderWidth = spacing.HAIRLINE, borderColor = colors.rule())) {
                zeus.Box(style = Style(padding = 12)) { zui.Body("Preview") }
            }
        }
    })
    collapsed.set(true)
    let mut i = 0
    while i < 12 {
        zeus.pump_frame()
        zeus.engine_step_dt(64)
        i = i + 1
    }
    zeus.engine_layout(720, 560)
    zeus.engine_paint()
    zeus.dump_draw_list()
}
