// DRAW-list golden: the overlay family. An open Popover anchored below its
// trigger (edge-aware placement), and a Toast pinned to the window bottom.
// Tooltips / hover cards are hover-triggered, so they are closed on this
// settled first frame. Keep this file free of prints: stdout is the golden.

import "std:zeus"
import "std:colors"
import "std:spacing"
import "std:design"

fn main() {
    let open = zeus.signal(1)
    let toast = zeus.signal(1)
    zeus.snapshot(420, 320, fn() -> Node {
        design.Page() {
            let trigger = design.Button("Menu", look = zeus.LOOK.Outline, size = zeus.SIZE.Md)
            design.Popover(trigger, open = open, place = design.PLACE.PlaceBelow, width = 200) {
                zeus.Text("Rename", color = zeus.ink(), font = spacing.FONT_BODY)
                zeus.Text("Duplicate", color = zeus.ink(), font = spacing.FONT_BODY)
            }
            design.Toast(toast, width = 180) {
                zeus.Text("Saved", color = colors.on_ink(), font = spacing.FONT_BODY)
            }
        }
    })
}
