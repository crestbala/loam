// DRAW-list golden: the overlay family. An open Popover anchored below its
// trigger (edge-aware placement), and a Toast pinned to the window bottom.
// Tooltips / hover cards are hover-triggered, so they are closed on this
// settled first frame. Keep this file free of prints: stdout is the golden.

import "std:zeus"
import "std:colors"
import "std:spacing"
import "std:zui"

fn main() {
    let open = zeus.signal(true)
    let toast = zeus.signal(true)
    zeus.snapshot(420, 320, fn() -> Node {
        zui.Page() {
            zui.Popover(open = open,
                        place = zui.Place.PlaceBelow,
                        style = Style(width = px(200)),
                        trigger = || { zui.Button("Menu", look = zeus.Look.Outline, size = zeus.Size.Md) }) {
                zeus.Text("Rename", style = Style(font = spacing.FONT_BODY, color = zeus.ink()))
                zeus.Text("Duplicate", style = Style(font = spacing.FONT_BODY, color = zeus.ink()))
            }
            zui.Toast(toast, style = Style(width = px(180))) {
                zeus.Text("Saved", style = Style(font = spacing.FONT_BODY, color = colors.on_ink()))
            }
        }
    })
}
