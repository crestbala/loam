// DRAW-list golden: the Drawer surface. An end-edge panel over the scrim, with
// its elevation-4 shadow and content, settled on the first frame (the slide
// jumps to its final value at boot). Keep this file free of prints: stdout is
// the golden.

import "std:zeus"
import "std:colors"
import "std:spacing"
import "std:zui"

fn main() {
    let open = zeus.signal(1)
    zeus.snapshot(420, 260, fn() -> Node {
        zui.Page() {
            zui.Title("Page")
            zui.Drawer(open, side = zui.SIDE.SideEnd, size = 220) {
                zui.Title("Filters")
                zeus.Text("Body copy", color = colors.mute(), font = spacing.FONT_BODY)
            }
        }
    })
}
