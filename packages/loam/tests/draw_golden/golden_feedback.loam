// DRAW-list golden: the Phase 4 feedback primitives — the indeterminate
// Spinner (settled static at boot), the Empty state, and a paint-only transform
// (a scaled box emits save / xform / restore). Keep this file free of prints:
// stdout is the golden.

import "std:zeus"

fn main() {
    zeus.snapshot(420, 240, fn() -> Node {
        zeus.Page() {
            zeus.Row(SPACE.Md) {
                zeus.Spinner()
                zeus.Spinner(size = 24, color = zeus.ink())
                zeus.Empty(icon = zeus.IC_INFO, title = "No projects",
                           body = "Create one to get started.")
                zeus.Card(width = 120) {
                    zeus.Title("Elevated")
                }
                let scaled = zeus.Box(width = 40, height = 40, radius = 8,
                                      background = zeus.accent())
                zeus.animate_scale(scaled, 50, 0)
            }
        }
    })
}
