import "std:fmt"
import "std:sys"

// a messy fixture for loam-fmt
fn add(a: int, b: int) -> int {
    // inner comment
    return a+b
}

fn main() {
    let xs = []int {1, 2, 3}
    let mut t = 0
    for i in 0..xs.len {
        t+=xs[i]
    }
    if t>0 {
        fmt.println("sum", xs[0], t) // trailing comment
    } else {
        fmt.println("nope")
    }
}
