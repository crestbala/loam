// A module at the C ABI. `secret` is unsafe, so only this file may call it.
// `safe_len` is the wrapper other modules get.
#[c("strlen")]
fn c_strlen(s: string) -> i64 {}

unsafe fn secret() -> i64 {
    let mut x: i64 = i64(0)
    raw_read(i64(8), &mut x)
    return x
}

fn safe_len(s: string) -> i64 {
    return c_strlen(s)
}
