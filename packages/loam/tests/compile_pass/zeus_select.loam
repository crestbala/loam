// Select is an anchored floater now: it opens beside the trigger, arrows move
// the highlight, Enter picks, Escape or an outside click closes.
import "std:fmt"
import "std:sys"
import "std:zeus"

fn must(ok: bool, what: string) {
    if !ok {
        fmt.println("FAIL", what)
        sys.exit(1)
    }
}

fn main() {
    zeus.window("select", 360, 300)
    let value = zeus.signal(0)
    let tree = zeus.Page() {
        zeus.Select(value, []string { "Small", "Medium", "Large" })
    }
    zeus.root(tree)
    zeus.pump_frame()
    zeus.engine_layout(360, 300)

    // Closed: only the picked label is shown.
    must(zeus.text_visible("Small"), "trigger shows the picked label")
    must(!zeus.text_visible("Medium"), "menu starts closed")

    // The trigger opens it.
    zeus.engine_click_text("Small")
    zeus.engine_mouseup()
    zeus.engine_layout(360, 300)
    must(zeus.text_visible("Medium"), "trigger opened the menu")
    must(zeus.text_visible("Large"), "every option is listed")

    // Arrows move the highlight; Enter picks.
    zeus.engine_key_ev(1003, 0)
    zeus.engine_key_ev(1003, 0)
    zeus.engine_key_ev(13, 0)
    must(value.get() == 2, "enter picked the highlighted option")
    zeus.engine_layout(360, 300)
    must(!zeus.text_visible("Medium"), "menu closed after picking")
    must(zeus.text_visible("Large"), "trigger shows the new label")

    // Escape closes without picking.
    zeus.engine_click_text("Large")
    zeus.engine_mouseup()
    zeus.engine_layout(360, 300)
    must(zeus.text_visible("Medium"), "reopened")
    zeus.engine_key_ev(27, 0)
    must(value.get() == 2, "escape did not pick")
    zeus.engine_layout(360, 300)
    must(!zeus.text_visible("Medium"), "escape closed the menu")

    // Outside click closes through the scrim.
    zeus.engine_click_text("Large")
    zeus.engine_mouseup()
    zeus.engine_layout(360, 300)
    must(zeus.text_visible("Medium"), "reopened again")
    zeus.engine_click(5, 290)
    zeus.engine_mouseup()
    zeus.engine_layout(360, 300)
    must(!zeus.text_visible("Medium"), "outside click closed the menu")

    fmt.println("select ok")
}
