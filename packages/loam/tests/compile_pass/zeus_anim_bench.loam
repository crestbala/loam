// Phase 3 frame-time probe: with every bound widget animating, measure the
// engine's per-frame cost (layout + step + paint) headlessly. This is the same
// `scene.paint` / `engine_layout` work the Cocoa and wasm hosts run; it bounds
// the engine side of the frame. The GUI frame cost (CoreAnimation flush,
// Canvas2D) is a host concern and is measured on-device, not here.

import "std:async"
import "std:fmt"
import "std:sys"
import "std:zeus"
import "std:colors"
import "std:design"

const N: int = 40
const FRAMES: int = 300

fn main() {
    zeus.window("bench", 480, 320)
    let mut sigs = []Signal<int> {}
    let mut i = 0
    while i < N {
        push(sigs, zeus.signal(0))
        i = i + 1
    }
    let tree = zeus.Box(align_direction = DIRECTION.Column) {
        let mut j = 0
        while j < N {
            design.Progress(sigs[j])
            j = j + 1
        }
    }
    zeus.root(tree)
    zeus.pump_frame()

    // One long-lived track per widget: the whole run stays at 120 Hz-equivalent
    // work (a live track ticking, paint marked, layout skipped).
    i = 0
    while i < N {
        colors.animate(sigs[i], 100, 1000000)
        i = i + 1
    }
    // Warm up (buffer growth, first paint).
    let mut k = 0
    while k < 5 {
        zeus.engine_layout(480, 320)
        zeus.engine_step_dt(16)
        zeus.engine_paint()
        k = k + 1
    }

    let t0 = async.now_ms()
    k = 0
    while k < FRAMES {
        zeus.engine_layout(480, 320)
        zeus.engine_step_dt(16)
        zeus.engine_paint()
        k = k + 1
    }
    let el = async.now_ms() - t0
    let live = zeus.proof_anim_live()
    fmt.println("bench frames", FRAMES, "tracks", live, "total_ms", el,
                "per_frame_us", el * 1000 / i64(FRAMES))
    if live != N {
        sys.exit(1)
    }
}
