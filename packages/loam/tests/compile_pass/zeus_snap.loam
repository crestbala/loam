import "std:fmt"
import "std:sys"
import "std:zeus"
import "std:zui"

fn main() {
    let count = zeus.signal(0)
    zeus.snapshot(320, 200, fn() -> Node {
        zeus.Box(style = Style(direction = Direction.Column, gap = 12, padding = edges(16))) {
            zeus.Text("Hello", style = Style(font = 22))
            zui.Button("Click", on_click = fn() => count.set(count.get() + 1))
        }
    })
    if zeus.draw_count() < 1 {
        sys.exit(1)
    }
}
