// Tabs and RadioGroup take arrow keys (Menu / Select already did). Only the
// selected item is a tab stop (roving tabindex). Arrows clamp at both ends.
import "std:fmt"
import "std:sys"
import "std:zeus"
import "std:zui"

fn must(ok: bool, what: string) {
    if !ok {
        fmt.println("FAIL", what)
        sys.exit(1)
    }
}

fn main() {
    zeus.window("tabs-keys", 480, 280)
    let tab = zeus.signal(0)
    let pick = zeus.signal(0)
    let hits = zeus.signal(0)
    let tree = zeus.Box(align_direction = zeus.DIRECTION.Column, padding = 16, spacing = 12) {
        zui.Button("Before", look = zeus.LOOK.Outline, size = zeus.SIZE.Md,
                    on_click = fn() => hits.set(hits.get() + 1))
        zui.Tabs(tab, []string { "One", "Two", "Three" })
        zui.RadioGroup(pick, []string { "First", "Second", "Third" })
        zui.Button("After", look = zeus.LOOK.Outline, size = zeus.SIZE.Md)
    }
    zeus.root(tree)
    zeus.pump_frame()

    // Click the selected tab so it holds focus, then Right / Left move it.
    zeus.engine_click_text("One")
    zeus.engine_mouseup()
    zeus.engine_layout(480, 280)
    must(tab.get() == 0, "starts on One")
    zeus.engine_key_ev(1001, 0)
    must(tab.get() == 1, "right selects Two")
    zeus.engine_key_ev(1001, 0)
    must(tab.get() == 2, "right selects Three")
    zeus.engine_key_ev(1001, 0)
    must(tab.get() == 2, "right clamps at the last tab")
    zeus.engine_key_ev(1000, 0)
    must(tab.get() == 1, "left selects Two")
    zeus.engine_key_ev(1000, 0)
    zeus.engine_key_ev(1000, 0)
    must(tab.get() == 0, "left clamps at the first tab")

    // RadioGroup: Down / Up (and Right / Left) move the pick.
    zeus.engine_click_text("First")
    zeus.engine_mouseup()
    zeus.engine_layout(480, 280)
    must(pick.get() == 0, "starts on First")
    zeus.engine_key_ev(1003, 0)
    must(pick.get() == 1, "down selects Second")
    zeus.engine_key_ev(1001, 0)
    must(pick.get() == 2, "right selects Third")
    zeus.engine_key_ev(1003, 0)
    must(pick.get() == 2, "down clamps at the last radio")
    zeus.engine_key_ev(1002, 0)
    must(pick.get() == 1, "up selects Second")
    zeus.engine_key_ev(1000, 0)
    zeus.engine_key_ev(1000, 0)
    must(pick.get() == 0, "left clamps at the first radio")

    // Roving tabindex: of the three tabs, only the selected one is a stop.
    tab.set(1)
    zeus.engine_layout(480, 280)
    let t0 = zeus.engine_find_text("One")
    let t1 = zeus.engine_find_text("Two")
    let t2 = zeus.engine_find_text("Three")
    let mut tab_stops = 0
    zeus.engine_focus_step(0)
    zeus.engine_fill_focus()
    let start = zeus.engine_focus_node(0)
    let mut at = start
    let mut guard = 0
    while guard < 16 {
        if at == t0 || at == t1 || at == t2 {
            tab_stops = tab_stops + 1
        }
        zeus.engine_focus_step(0)
        zeus.engine_fill_focus()
        at = zeus.engine_focus_node(0)
        if at == start {
            break
        }
        guard = guard + 1
    }
    must(tab_stops == 1, "only the selected tab is a tab stop")

    fmt.println("tabs-keys ok")
}