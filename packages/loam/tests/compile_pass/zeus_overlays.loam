// Phase 4 batch 3: the overlay family. Popover anchors below its trigger and
// flips above when it would leave the viewport; outside click and Escape close
// it. Tooltip shows on hover after a delay and hides on leave. Toast rises and
// auto-dismisses. All are out-of-flow floaters.

import "std:fmt"
import "std:sys"
import "std:zeus"
import "std:colors"
import "std:colors"
import "std:spacing"
import "std:zui"

fn must(ok: bool, what: string) {
    if !ok {
        fmt.println("FAIL", what)
        sys.exit(1)
    }
}

fn main() {
    zeus.window("overlays", 360, 300)
    let open = zeus.signal(false)
    let toast = zeus.signal(false)
    let mut pop_id = 0
    let mut trig_id = 0
    let tree = zui.Page() {
        // Push the trigger near the bottom so the popover must flip above.
        zeus.Box(style = Style(height = px(220)))
        // One trigger, two floaters: the tooltip's trigger is the popover,
        // whose trigger is the button.
        zui.Tooltip(text = "Open the menu", delay = 0, trigger = || {
            let pop = zui.Popover(open = open,
                                  place = zui.Place.PlaceBelow,
                                  style = Style(width = px(180)),
                                  trigger = || {
                let trigger = zui.Button("Menu", look = zeus.Look.Outline, size = zeus.Size.Md)
                trig_id = trigger.id
            }) {
                zeus.Text("Rename", style = Style(font = spacing.FONT_BODY, color = zeus.ink()))
            }
            pop_id = zeus.child_at(pop, 2).id
        })
        zui.Toast(toast, style = Style(width = px(160)), ms = 0) {
            zeus.Text("Saved", style = Style(font = spacing.FONT_BODY, color = colors.on_ink()))
        }
    }
    zeus.root(tree)
    zeus.pump_frame()

    must(!zeus.text_visible("Rename"), "popover starts closed")

    // Open: the panel flips above a bottom-edge trigger.
    open.set(true)
    zeus.engine_layout(360, 300)
    must(zeus.text_visible("Rename"), "popover open")
    must(zeus.node_y(pop_id) < zeus.node_y(trig_id), "popover flipped above the trigger")

    // Outside click closes through the scrim.
    zeus.engine_click(5, 5)
    zeus.engine_layout(360, 300)
    must(!zeus.text_visible("Rename"), "outside click closed the popover")

    // Tooltip shows after hover (delay 0 -> next frame) and hides on leave.
    let cx = zeus.node_x(trig_id) + zeus.node_width(trig_id) / 2
    let cy = zeus.node_y(trig_id) + zeus.node_height(trig_id) / 2
    zeus.engine_hover(cx, cy)
    zeus.engine_layout(360, 300)
    zeus.engine_layout(360, 300)
    must(zeus.text_visible("Open the menu"), "tooltip shown on hover")
    zeus.engine_hover(cx, cy + 1000)
    zeus.engine_layout(360, 300)
    must(!zeus.text_visible("Open the menu"), "tooltip hidden on leave")

    // Toast is visible immediately when open, then auto-dismisses on its timer.
    toast.set(true)
    must(zeus.text_visible("Saved"), "toast visible")
    zeus.engine_layout(360, 300)
    zeus.engine_layout(360, 300)
    must(!zeus.text_visible("Saved"), "toast auto-dismissed")

    fmt.println("overlays ok")
}
