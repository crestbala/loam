// Phase 4: the raster scene pass — the SAME draw list `present()` hands to the
// host, rasterized by our own rasterizer into the one buffer we own.
//
// This is where the two halves of the project meet: `scene.paint` records
// resolution-independent primitives (logical units, no pixels), and this pass
// turns them into PHYSICAL pixels at the backing scale, generating the corner
// arcs at that resolution rather than scaling up a bitmap.
//
// The scene is a REAL one, built through the public API, and the assertions read
// the geometry back out of the draw list — so they say "whatever paint decided
// this card is, it came out with a round corner and a filled middle" instead of
// hard-coding a layout the test would then be measuring instead of the engine.

import "std:fmt"
import "std:sys"
import "std:zeus"

fn must(ok: bool, what: string) {
    if ok {
        return
    }
    fmt.println("FAIL", what)
    sys.exit(1)
}

/// Index of the first fill op (any of the three fill kinds — a node with a
/// radius is emitted as `fill4`) of the given LOGICAL size, or -1. Finding ops by
/// size rather than by colour keeps the test independent of the theme.
fn find_box(w: int, h: int) -> int {
    let n = zeus.draw_count()
    let mut i = 0
    while i < n {
        let k = zeus.draw_op(i)
        if k == 0 || k == 1 || k == 14 {
            if zeus.draw_w(i) == w {
                if zeus.draw_h(i) == h {
                    return i
                }
            }
        }
        i = i + 1
    }
    return -1
}

fn count_kind(kind: int) -> int {
    let n = zeus.draw_count()
    let mut c = 0
    let mut i = 0
    while i < n {
        if zeus.draw_op(i) == kind {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

fn red_of(rgb: int) -> int {
    return rgb / 65536 % 256
}

fn green_of(rgb: int) -> int {
    return rgb / 256 % 256
}

fn blue_of(rgb: int) -> int {
    return rgb % 256
}

fn main() {
    // --- a real scene, at backing scale 2 ---------------------------------
    zeus.window("zeus-raster-scene", 240, 200)
    zeus.root(zeus.Page() {
        zeus.Box(width = 80, height = 60, radius = 12, background = "#3366CC")
        zeus.Box(width = 60, height = 40, radius = 6, background = "#CC3366",
                 margin = 8)
    })
    zeus.engine_layout(240, 200)
    zeus.engine_paint()
    must(zeus.draw_count() > 0, "paint produced a draw list")

    zeus.raster_ensure(240, 200, 2)
    must(zeus.raster_width() == 480, "physical width is logical * scale")
    must(zeus.raster_height() == 400, "physical height is logical * scale")
    let drawn = zeus.scene_rasterize(2, 255, 255, 255)
    must(drawn > 0, "ops were rasterized")

    // --- the rounded card, in device pixels -------------------------------
    let card = find_box(80, 60)
    must(card >= 0, "the 80x60 card is in the list")
    must(zeus.draw_radius(card) % 65536 == 12, "it asked for a 12pt radius")
    must(zeus.draw_rgb(card) == 0x3366CC, "and its colour is the one we set")
    let cx = zeus.draw_x(card)
    let cy = zeus.draw_y(card)
    let rgb = zeus.draw_rgb(card)
    let fr = red_of(rgb)
    let fg = green_of(rgb)
    let fb = blue_of(rgb)
    // The middle of the card is the op's own colour, at device resolution.
    let mx = (cx + 40) * 2
    let my = (cy + 30) * 2
    must(zeus.raster_get(mx, my, 2) == fr, "card middle red channel")
    must(zeus.raster_get(mx, my, 1) == fg, "card middle green channel")
    must(zeus.raster_get(mx, my, 0) == fb, "card middle blue channel")
    // The very corner of the bounding box is OUTSIDE the rounded shape.
    must(zeus.raster_get(cx * 2 + 1, cy * 2 + 1, 2) == 255,
         "the corner arc leaves the background")
    must(zeus.raster_get(cx * 2 + 1, cy * 2 + 1, 1) == 255, "and it is untouched")
    // Where the arc meets the top edge the fill has started.
    must(zeus.raster_get(cx * 2 + 24, cy * 2, 2) == fr, "the arc meets the top edge")
    // The arc is generated AT 2x, so it is smooth rather than stair-stepped:
    // scanning the card's own device box finds pixels that are neither the
    // background nor the fill colour, i.e. partway covered. A nearest-sample
    // rasterizer would have none at all.
    let mut graded = 0
    let mut gy = cy * 2
    while gy < (cy + 60) * 2 {
        let mut gx = cx * 2
        while gx < (cx + 80) * 2 {
            let v = zeus.raster_get(gx, gy, 2)
            if v != 255 {
                if v != fr {
                    graded = graded + 1
                }
            }
            gx = gx + 1
        }
        gy = gy + 1
    }
    must(graded > 8, "the corner arc is antialiased, not stair-stepped")

    // --- a second, differently sized card is its own shape ----------------
    let small = find_box(60, 40)
    must(small >= 0, "the 60x40 card is in the list")
    must(zeus.draw_rgb(small) == 0xCC3366, "with the colour we set")
    let s2 = zeus.draw_rgb(small)
    let sx = (zeus.draw_x(small) + 30) * 2
    let sy = (zeus.draw_y(small) + 20) * 2
    must(zeus.raster_get(sx, sy, 2) == red_of(s2), "the small card is filled")
    must(zeus.raster_get(sx, sy, 1) == green_of(s2), "with its own colour")

    // --- and the surface's own corner is background -----------------------
    must(zeus.raster_get(479, 399, 0) == 255, "the corner of the surface is clear")

    // --- nothing in this scene was skipped --------------------------------
    must(zeus.scene_raster_unhandled_total() == 0, "a shapes-only scene skips nothing")

    // --- ops the pass cannot rasterize are counted, not silent ------------
    // Text is the kind this pass does not do yet. A scene WITH text must report
    // exactly those, per kind, rather than quietly drawing nothing.
    zeus.window("zeus-raster-scene-text", 240, 100)
    zeus.root(zeus.Page() {
        zeus.Text("hello")
    })
    zeus.engine_layout(240, 100)
    zeus.engine_paint()
    zeus.raster_ensure(240, 100, 2)
    zeus.scene_rasterize(2, 255, 255, 255)
    must(count_kind(2) > 0, "the scene has text ops")
    must(zeus.scene_raster_unhandled(2) == count_kind(2),
         "every text op is counted as unhandled")
    must(zeus.scene_raster_unhandled(0) == 0, "while fills are still handled")
    must(zeus.scene_raster_unhandled_total() > 0, "and the total says so")

    fmt.println("raster scene ok", drawn, zeus.scene_raster_unhandled_total())
}
