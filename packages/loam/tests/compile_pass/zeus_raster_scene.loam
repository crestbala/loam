// Phase 4: the raster scene pass — the SAME draw list `present()` hands to the
// host, rasterized by our own rasterizer into the one buffer we own.
//
// This is where the two halves of the project meet: `scene.paint` records
// resolution-independent primitives (logical units, no pixels), and this pass
// turns them into PHYSICAL pixels at the backing scale, generating the corner
// arcs at that resolution rather than scaling up a bitmap.
//
// The scene is a REAL one, built through the public API, and the assertions read
// the geometry back out of the draw list — so they say "whatever paint decided
// this card is, it came out with a round corner and a filled middle" instead of
// hard-coding a layout the test would then be measuring instead of the engine.

import "std:fmt"
import "std:sys"
import "std:zeus"
import "std:design"

fn must(ok: bool, what: string) {
    if ok {
        return
    }
    fmt.println("FAIL", what)
    sys.exit(1)
}

/// Index of the first fill op (any of the three fill kinds — a node with a
/// radius is emitted as `fill4`) of the given LOGICAL size, or -1. Finding ops by
/// size rather than by colour keeps the test independent of the theme.
fn find_box(w: int, h: int) -> int {
    let n = zeus.draw_count()
    let mut i = 0
    while i < n {
        let k = zeus.draw_op(i)
        if k == 0 || k == 1 || k == 14 {
            if zeus.draw_w(i) == w {
                if zeus.draw_h(i) == h {
                    return i
                }
            }
        }
        i = i + 1
    }
    return -1
}

fn count_kind(kind: int) -> int {
    let n = zeus.draw_count()
    let mut c = 0
    let mut i = 0
    while i < n {
        if zeus.draw_op(i) == kind {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

/// Index of the first op of `kind`, or -1.
fn find_kind(kind: int) -> int {
    let n = zeus.draw_count()
    let mut i = 0
    while i < n {
        if zeus.draw_op(i) == kind {
            return i
        }
        i = i + 1
    }
    return -1
}

fn red_of(rgb: int) -> int {
    return rgb / 65536 % 256
}

fn green_of(rgb: int) -> int {
    return rgb / 256 % 256
}

fn blue_of(rgb: int) -> int {
    return rgb % 256
}

fn main() {
    // --- a real scene, at backing scale 2 ---------------------------------
    zeus.window("zeus-raster-scene", 240, 200)
    zeus.root(design.Page() {
        zeus.Box(width = 80, height = 60, radius = 12, background = "#3366CC")
        zeus.Box(width = 60, height = 40, radius = 6, background = "#CC3366",
                 margin = 8)
    })
    zeus.engine_layout(240, 200)
    zeus.engine_paint()
    must(zeus.draw_count() > 0, "paint produced a draw list")

    zeus.raster_ensure(240, 200, 2)
    must(zeus.raster_width() == 480, "physical width is logical * scale")
    must(zeus.raster_height() == 400, "physical height is logical * scale")
    let drawn = zeus.scene_rasterize(2, 255, 255, 255)
    must(drawn > 0, "ops were rasterized")

    // --- the rounded card, in device pixels -------------------------------
    let card = find_box(80, 60)
    must(card >= 0, "the 80x60 card is in the list")
    must(zeus.draw_radius(card) % 65536 == 12, "it asked for a 12pt radius")
    must(zeus.draw_rgb(card) == 0x3366CC, "and its colour is the one we set")
    let cx = zeus.draw_x(card)
    let cy = zeus.draw_y(card)
    let rgb = zeus.draw_rgb(card)
    let fr = red_of(rgb)
    let fg = green_of(rgb)
    let fb = blue_of(rgb)
    // The middle of the card is the op's own colour, at device resolution.
    let mx = (cx + 40) * 2
    let my = (cy + 30) * 2
    must(zeus.raster_get(mx, my, 2) == fr, "card middle red channel")
    must(zeus.raster_get(mx, my, 1) == fg, "card middle green channel")
    must(zeus.raster_get(mx, my, 0) == fb, "card middle blue channel")
    // The very corner of the bounding box is OUTSIDE the rounded shape.
    must(zeus.raster_get(cx * 2 + 1, cy * 2 + 1, 2) == 255,
         "the corner arc leaves the background")
    must(zeus.raster_get(cx * 2 + 1, cy * 2 + 1, 1) == 255, "and it is untouched")
    // Where the arc meets the top edge the fill has started.
    must(zeus.raster_get(cx * 2 + 24, cy * 2, 2) == fr, "the arc meets the top edge")
    // The arc is generated AT 2x, so it is smooth rather than stair-stepped:
    // scanning the card's own device box finds pixels that are neither the
    // background nor the fill colour, i.e. partway covered. A nearest-sample
    // rasterizer would have none at all.
    let mut graded = 0
    let mut gy = cy * 2
    while gy < (cy + 60) * 2 {
        let mut gx = cx * 2
        while gx < (cx + 80) * 2 {
            let v = zeus.raster_get(gx, gy, 2)
            if v != 255 {
                if v != fr {
                    graded = graded + 1
                }
            }
            gx = gx + 1
        }
        gy = gy + 1
    }
    must(graded > 8, "the corner arc is antialiased, not stair-stepped")

    // --- a second, differently sized card is its own shape ----------------
    let small = find_box(60, 40)
    must(small >= 0, "the 60x40 card is in the list")
    must(zeus.draw_rgb(small) == 0xCC3366, "with the colour we set")
    let s2 = zeus.draw_rgb(small)
    let sx = (zeus.draw_x(small) + 30) * 2
    let sy = (zeus.draw_y(small) + 20) * 2
    must(zeus.raster_get(sx, sy, 2) == red_of(s2), "the small card is filled")
    must(zeus.raster_get(sx, sy, 1) == green_of(s2), "with its own colour")

    // --- and the surface's own corner is background -----------------------
    must(zeus.raster_get(479, 399, 0) == 255, "the corner of the surface is clear")

    // --- nothing in this scene was skipped --------------------------------
    must(zeus.scene_raster_unhandled_total() == 0, "a shapes-only scene skips nothing")

    // --- gradients: linear-space, even, and seam-free across tiles ---------
    // A gradient from black to white: lerping in the LINEAR domain puts the
    // perceptual midpoint at sRGB 188, where lerping the sRGB bytes would put
    // it at 128 -- the same gamma rule the compositor follows, applied to a
    // gradient instead of an alpha blend.
    zeus.raster_ensure(64, 512, 1)
    // The scene pass's clip is still in force; a direct fill wants the whole
    // surface. (The pass itself always sets its clip deterministically, so this
    // is a test-harness concern, not a renderer one.)
    zeus.raster_clip_reset()
    zeus.raster_fill_round_rect_gradient(0, 0, 64, 512, 0, 0x000000, 0xFFFFFF, 0, 255)
    must(zeus.raster_get(32, 0, 0) == 0, "the gradient starts at the first stop")
    // The second stop is reached at the bottom EDGE, so the last pixel centre is
    // t = 511/512 of the way there rather than exactly on it.
    must(zeus.raster_get(32, 511, 0) >= 250, "and ends at the second")
    must(zeus.raster_get(32, 256, 0) > 170, "the midpoint is even, not sRGB-lerped")
    must(zeus.raster_get(32, 256, 0) < 210, "and it is a gradient, not a jump")
    // Sampled every 32 pixels the trend must be strictly increasing; the dither
    // only moves a value by half a step, so it cannot invert a real climb.
    let mut mono = 1
    let mut py2 = 32
    while py2 < 512 {
        if zeus.raster_get(32, py2, 0) <= zeus.raster_get(32, py2 - 32, 0) {
            mono = 0
        }
        py2 = py2 + 32
    }
    must(mono == 1, "the gradient climbs monotonically")
    // 512 tall spans three 256px tiles. A gradient computed per tile instead of
    // against global geometry would RESTART at each tile edge — a jump of about
    // half the range at y=256. So the step across the boundary must be no larger
    // than the steps just around it. (Near black the sRGB curve is steep, so a
    // step of ~10 is normal there; mid-range it is under 2.)
    let mut max_local = 0
    let mut py3 = 224
    while py3 < 288 {
        if py3 != 256 {
            let d = zeus.raster_get(32, py3, 0) - zeus.raster_get(32, py3 - 1, 0)
            if d > max_local {
                max_local = d
            }
        }
        py3 = py3 + 1
    }
    let seam = zeus.raster_get(32, 256, 0) - zeus.raster_get(32, 255, 0)
    must(seam <= max_local + 2, "no seam at the tile boundary")
    must(0 - seam <= 2, "and no backward jump there")
    must(zeus.raster_get(32, 128, 0) < zeus.raster_get(32, 384, 0),
         "the gradient still climbs across the whole span")

    // --- and the pass rasterizes a gradient op ----------------------------
    // A node with both stops set paints a gradient (kind 11). Built with
    // `child()` rather than a trailing block so the second stop can be set on
    // the node before it is added.
    let grad = zeus.Box(width = 60, height = 30, radius = 0, background = "#000000")
    zeus.set_background_end(grad, 0xFFFFFF)
    let page = design.Page()
    zeus.child(page, grad)
    zeus.window("zeus-raster-scene-grad", 120, 160)
    zeus.root(page)
    zeus.engine_layout(120, 160)
    zeus.engine_paint()
    must(count_kind(11) > 0, "the scene has a gradient op")
    zeus.raster_ensure(120, 160, 2)
    zeus.scene_rasterize(2, 255, 255, 255)
    must(zeus.scene_raster_unhandled(11) == 0, "and the pass rasterized it")
    // The op's own box, in device pixels: dark at the top, light at the bottom.
    let gi = find_kind(11)
    must(gi >= 0, "the gradient op is in the list")
    let gx = (zeus.draw_x(gi) + 10) * 2
    let gtop = zeus.raster_get(gx, zeus.draw_y(gi) * 2 + 1, 0)
    let gbot = zeus.raster_get(gx, (zeus.draw_y(gi) + zeus.draw_h(gi)) * 2 - 2, 0)
    must(gtop < 40, "the gradient op starts dark")
    must(gbot > 215, "and ends light")

    // --- the counted fallback: no font, so text is reported, not dropped ----
    // This program never calls `scene_load_font`, and that IS the fallback
    // contract: with no font loaded the pass cannot draw text, so it counts the
    // ops per kind instead of quietly drawing nothing. (With a font loaded they
    // are drawn — see zeus_raster_text.loam.)
    zeus.window("zeus-raster-scene-text", 240, 100)
    zeus.root(design.Page() {
        zeus.Text("hello")
    })
    zeus.engine_layout(240, 100)
    zeus.engine_paint()
    zeus.raster_ensure(240, 100, 2)
    zeus.scene_rasterize(2, 255, 255, 255)
    must(count_kind(2) > 0, "the scene has text ops")
    must(zeus.scene_glyphs_drawn() == 0, "and no font means no glyphs")
    must(zeus.scene_raster_unhandled(2) == count_kind(2),
         "so every text op is counted, not dropped")
    must(zeus.scene_raster_unhandled(0) == 0, "while fills are still handled")
    must(zeus.scene_raster_unhandled_total() > 0, "and the total says so")

    fmt.println("raster scene ok", drawn, zeus.scene_raster_unhandled_total())
}
