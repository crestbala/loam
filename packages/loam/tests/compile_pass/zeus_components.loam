import "std:fmt"
import "std:sys"
import "std:zeus"
import "std:zui"

let mut labs: []string = []string {}
let mut cs: []string = []string {}
let mut cv: []int = []int {}

fn Picks(sel: Signal<int>) {
    zui.Tabs(sel, labs)
}

fn ChartSeed() {
    if labs.len == 0 {
        push(labs, "A")
        push(labs, "B")
        push(cs, "One")
        push(cs, "Two")
        push(cv, 12)
        push(cv, 8)
        push(cv, 20)
        push(cv, 14)
    }
}

fn main() {
    ChartSeed()
    let open = zeus.signal(1)
    let on = zeus.signal(1)
    let sel = zeus.signal(0)
    zeus.snapshot(320, 240, fn() -> Node {
        zui.Card() {
            zui.Heading("Hello")
            zui.Button("Go", look = zeus.LOOK.Solid, size = zeus.SIZE.Md)
            zui.Chip("live", zeus.TINT.Ok)
            zui.Checkbox("On", on)
            zui.Field("Name", zeus.signal(""), "Ada")
            zui.User("AP", "Ada", "Op")
            Picks(sel)
            zeus.Box(safe = 1, min_width = 40, wrap = 1) {
                zui.Note("safe")
            }
            zui.BarChart(labs, cs, cv, 260, 120)
            zui.LineChart(labs, cs, cv, 260, 120)
            zui.AreaChart(labs, cs, cv, 260, 120)
            zui.Dialog(open, title = "Hi") {
                zui.Button("Ok", look = zeus.LOOK.Solid, size = zeus.SIZE.Sm, on_click = fn() => open.set(0))
            }
        }
    })
    if zeus.draw_count() < 1 {
        fmt.println("FAIL zeus")
        sys.exit(1)
    }
    fmt.println("zeus components ok")
}
