// Phase 19 devtools: the inspector renders the tree (with layout boxes) and
// live signal values from the arena (§2.4).

import "std:fmt"
import "std:sys"
import "std:zeus"
import "std:zui"
import "std:devtools"

fn must(ok: bool, what: string) {
    if !ok {
        fmt.println("FAIL", what)
        sys.exit(1)
    }
}

fn has(hay: string, needle: string) -> int {
    if needle.len == 0 {
        return 1
    }
    if hay.len < needle.len {
        return 0
    }
    let last = hay.len - needle.len
    let mut i = 0
    while i <= last {
        let mut ok = 1
        let mut j = 0
        while j < needle.len {
            if hay[i + j] != needle[j] {
                ok = 0
            }
            j = j + 1
        }
        if ok == 1 {
            return 1
        }
        i = i + 1
    }
    return 0
}

fn has_any(lines: []string, needle: string) -> int {
    let mut i = 0
    while i < lines.len {
        if has(lines[i], needle) == 1 {
            return 1
        }
        i = i + 1
    }
    return 0
}

fn main() {
    let count = zeus.signal(7)
    zeus.snapshot(480, 320, fn() -> Node {
        zeus.Box(align_direction = DIRECTION.Column) {
            zeus.Text("hello panel")
            zui.Button(label = "Action")
            devtools.Panel()
        }
    })
    zeus.engine_layout(480, 320)

    // The tree view lists nodes with role, label, and layout box.
    let tl = devtools.tree_lines()
    must(has_any(tl, "hello panel") == 1, "tree lists text")
    must(has_any(tl, "Action") == 1, "tree lists button")
    must(has_any(tl, "button") == 1, "tree lists role")
    must(has_any(tl, "x") == 1, "tree lists geometry")

    // The signal view lists live values.
    let sl = devtools.signal_lines()
    must(has_any(sl, "= 7") == 1, "signals list value")

    // The panel itself renders into the tree.
    if zeus.engine_find_text("tree") == 0 {
        must(false, "panel header rendered")
    }
    if zeus.engine_find_text("signals") == 0 {
        must(false, "panel signals header rendered")
    }

    fmt.println("devtools ok")
}
