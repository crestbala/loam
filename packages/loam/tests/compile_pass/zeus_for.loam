import "std:fmt"
import "std:sys"
import "std:zeus"
import "std:zui"

fn RowOf(i: int, s: string) {
    zeus.Text(s)
}

fn main() {
    let names = zeus.signal([]string {})
    zui.push_item(names, "Ada")
    zui.push_item(names, "Bea")
    zeus.snapshot(240, 160, fn() -> Node {
        zeus.Box(align_direction = DIRECTION.Column) {
            zui.For(names, fn(s) => s, RowOf)
            zui.Button("Add", on_click = fn() => zui.push_item(names, "Cyd"))
            zui.Loop(names.get(), fn(i, s) {
                zeus.Text(s)
            })
        }
    })
    if zeus.draw_count() < 3 {
        fmt.println("FAIL for draw")
        sys.exit(1)
    }
    if zeus.engine_click_text("Add") == 0 {
        fmt.println("FAIL click Add")
        sys.exit(1)
    }
    zeus.engine_layout(240, 160)
    let after_add = names.get().len
    if after_add != 3 {
        fmt.println("FAIL len after add", after_add)
        sys.exit(1)
    }
    zui.pop_item(names)
    let after_pop = names.get().len
    if after_pop != 2 {
        fmt.println("FAIL len after pop", after_pop)
        sys.exit(1)
    }
    fmt.println("for ok")
}
