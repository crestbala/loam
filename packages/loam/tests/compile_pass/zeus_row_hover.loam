// Dropdown rows (Menu / Combobox / Select) must hover with the SAME fill the
// keyboard highlight paints. Before this, keyboard navigation used
// `highlight()` (a solid `raised()` fill) while mouse hover fell through to the
// engine's faint generic wash — so the two paths looked different.
//
// Each row now carries `hoverStyle = Style(background = raised())`, so the
// pointer and the keyboard agree. The test drives each widget twice — once by
// keyboard, once by mouse — and asserts `node_background_rgb` (the resolved
// fill) is identical both ways.

import "std:fmt"
import "std:sys"
import "std:zeus"
import "std:colors"
import "std:zui"

fn must(ok: bool, what: string) {
    if ok {
        return
    }
    fmt.println("FAIL", what)
    sys.exit(1)
}

// The row box (kind 1) carrying `label` — the node the fill lives on.
fn row(label: string) -> int {
    for id in 1..zeus.arena_nodes() {
        if zeus.node_kind(id) == 1 && zeus.node_label(id) == label {
            return id
        }
    }
    return 0
}

fn layout() {
    zeus.engine_layout(360, 460)
}

// Drive a selection highlight to rest (tween settles).
fn settle() {
    for _ in 0..40 {
        zeus.engine_step()
    }
    layout()
}

fn main() {
    zeus.window("row hover", 360, 460)
    let value = zeus.signal(2)
    let query = zeus.signal("")
    let active = zeus.signal(-1)
    let hits = zeus.signal(0)
    let mut trig_id = 0
    let rows = []MenuRow {
        MenuRow(label = "Rename"),
        MenuRow(label = "Duplicate", isSeparated = true),
        MenuRow(label = "Delete"),
    }

    zeus.root(zui.Page() {
        zui.Select(value, []string { "Small", "Medium", "Large" })
        zui.Combobox(query, []string { "Apple", "Apricot", "Banana" },
                     style = Style(width = px(200)))
        zui.Menu(active = active,
                 items = rows,
                 label = "File",
                 trigger = || {
            let trigger = zui.Button("Actions", look = zeus.Look.Outline, size = zeus.Size.Md)
            trig_id = trigger.id
        },
                 place = zui.Place.PlaceBelow,
                 style = Style(width = px(180)),
                 on_select = fn(i: int) => hits.set(hits.get() + i))
    })
    zeus.pump_frame()
    layout()

    // --- Menu: mouse hover fill == keyboard highlight fill --------------------
    let cx = zeus.node_x(trig_id) + zeus.node_width(trig_id) / 2
    let cy = zeus.node_y(trig_id) + zeus.node_height(trig_id) / 2
    zeus.engine_click(cx, cy)
    zeus.engine_mouseup()
    layout()
    must(zeus.text_visible("Rename"), "menu opened")

    // Keyboard: Down lands on Duplicate; capture its resolved fill.
    zeus.engine_key_ev(1003, 0)
    settle()
    must(active.get() == 1, "keyboard moved to Duplicate")
    let kb_menu_fill = zeus.node_background_rgb(row("Duplicate"))

    // Mouse: hover Delete; capture its resolved fill.
    zeus.engine_hover(4, 4)
    layout()
    let del = row("Delete")
    zeus.engine_hover(zeus.node_x(del) + 4, zeus.node_y(del) + 4)
    layout()
    must(active.get() == 2, "mouse moved to Delete")
    let mouse_menu_fill = zeus.node_background_rgb(del)
    must(mouse_menu_fill == kb_menu_fill, "menu: mouse hover fill == keyboard highlight fill")
    zeus.engine_hover(4, 4)
    layout()
    zeus.engine_key_ev(27, 0)
    layout()

    // --- Combobox: mouse hover fill == keyboard highlight fill ----------------
    zeus.engine_click_text("Search")
    zeus.engine_mouseup()
    layout()
    zeus.engine_insert("ap")
    layout()
    must(zeus.text_visible("Apple"), "combobox opened")
    // Keyboard: opening highlights the first match (Apple).
    settle()
    let kb_combo_fill = zeus.node_background_rgb(row("Apple"))
    // Mouse: hover the second match (Apricot).
    zeus.engine_hover(4, 4)
    layout()
    let ap = row("Apricot")
    zeus.engine_hover(zeus.node_x(ap) + 4, zeus.node_y(ap) + 4)
    layout()
    let mouse_combo_fill = zeus.node_background_rgb(ap)
    must(mouse_combo_fill == kb_combo_fill, "combobox: mouse hover fill == keyboard highlight fill")
    zeus.engine_hover(4, 4)
    layout()
    zeus.engine_key_ev(27, 0)
    layout()

    fmt.println("row hover ok")
}
