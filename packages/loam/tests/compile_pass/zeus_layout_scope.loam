// Phase 5: dependency-driven layout. A layout prop that lands inside a
// size-stable box re-solves only that subtree — the card's box is explicit, so
// nothing above it can move. A change with no size-stable ancestor re-solves
// from the root, whose box is the window: still not a whole-tree solve (clean
// subtrees keep their measure, and paint re-records only what moved).
//
// A box is not its own boundary when the write changed the size its parent
// lays it out from: widening the first box of a row must move the second, so
// that write reaches the row and, with nothing stable above it, the root.

import "std:fmt"
import "std:sys"
import "std:zeus"

fn must(ok: bool, what: string) {
    if ok {
        return
    }
    fmt.println("FAIL", what)
    sys.exit(1)
}

fn main() {
    zeus.window("layout-scope", 300, 200)
    let w = zeus.signal(40)
    let label = zeus.signal("aa")
    let first = zeus.signal(40)
    let mut inner_id = 0
    let mut text_id = 0
    let mut second_id = 0
    zeus.root(zeus.Box(style = Style(padding = edges(10))) {
        // Two explicit boxes in a row: a width write on the first moves the
        // second, so the first cannot be its own boundary.
        zeus.Box(style = Style(direction = Direction.Row)) {
            let a = zeus.Box(style = Style(width = px(40), height = px(20), background = "#0000ff"))
            zeus.styled(a, || { zeus.set_prop_int(a, zeus.SET.Width, first.get()) })
            let b = zeus.Box(style = Style(width = px(40), height = px(20), background = "#00ffff"))
            second_id = b.id
        }
        // Fixed-size card: explicit width and height, so a child's size change
        // cannot move anything above it.
        zeus.Box(style = Style(width = px(200), height = px(100), background = "#ffffff")) {
            let b = zeus.Box(style = Style(width = px(40), height = px(20), background = "#ff0000"))
            inner_id = b.id
            zeus.styled(b, || { zeus.set_prop_int(b, zeus.SET.Width, w.get()) })
        }
        // No size-stable ancestor: an auto-sized label in an auto-sized column.
        let t = zeus.Text("{{label.get()}}")
        text_id = t.id
    })
    zeus.pump_frame()
    must(zeus.layout_was_full() == 1, "the first frame solves the whole tree")
    must(zeus.node_width(inner_id) == 40, "inner starts at 40")

    // A width write inside the fixed-size card: subtree re-solve.
    w.set(90)
    zeus.engine_layout(300, 200)
    must(zeus.layout_was_full() == 0, "a change inside a fixed-size box is a subtree re-solve")
    must(zeus.node_width(inner_id) == 90, "the subtree re-solve landed the new width")

    // A text write with no size-stable ancestor: re-solved from the root.
    let roots0 = zeus.root_relayouts()
    label.set("aaaa")
    zeus.engine_layout(300, 200)
    must(zeus.layout_was_full() == 0, "a change with no size-stable ancestor is not a whole-tree solve")
    must(zeus.root_relayouts() == roots0 + 1, "it re-solves from the root")

    // The card is still laid out correctly after both.
    must(zeus.node_width(inner_id) == 90, "the card's child kept its width")

    // A width write on the first box of a row: its sibling must move with it.
    let bx0 = zeus.node_x(second_id)
    first.set(90)
    zeus.engine_layout(300, 200)
    must(zeus.layout_was_full() == 0, "widening a row's first box reaches above the box, not the whole tree")
    must(zeus.root_relayouts() == roots0 + 2, "it re-solves from the root")
    must(zeus.node_x(second_id) == bx0 + 50, "the row sibling moved by the width change")

    fmt.println("layout scope ok")
}
