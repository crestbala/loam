// `Signal<[]T>.set` releases the list it replaces. The store used to retain
// the old list once more before dropping it, so the cell's own reference
// leaked: here 1 MB per set, 60 times over.

import "std:fmt"
import "std:str"
import "std:sys"
import "std:zeus"

let rows = zeus.signal([]int {})
let names = zeus.signal([]string {})

fn big(n: int) -> []int {
    let mut v = []int {}
    for i in 0..n {
        push(v, i)
    }
    return v
}

fn rss_mb() -> int {
    let t = str.trim(sys.exec("ps -o rss= -p $PPID"))
    let mut n = 0
    for i in 0..t.len {
        let c = t[i]
        if c >= 48 && c <= 57 {
            n = n * 10 + (c - 48)
        }
    }
    return n / 1024
}

fn main() {
    for i in 0..5 {
        rows.set(big(250000 + i))
    }
    let r = rss_mb()
    for i in 0..60 {
        rows.set(big(250000 + i))
        let mut ns = []string {}
        for k in 0..2000 {
            push(ns, "name {{i}} {{k}}")
        }
        names.set(ns)
    }
    let d = rss_mb() - r
    if d > 24 {
        fmt.println("signal lists leaked: +{{d}} MB")
        sys.exit(1)
    } else {
        fmt.println("signal lists ok {{rows.peek().len}} {{names.peek().len}}")
    }
}
