// Qualified imports: `package:module` names the package outright, and the module
// may be a path inside the package (`zeus:zeuscore/arena`). `std:` is the
// language library. `zeus` is a package.
import "std:fmt"
import "std:sys"
import "zeus"
import "zeus:zeuscore/arena"

fn main() {
    let n: Node = Node { id: 7 }
    arena.ensure()
    fmt.println("qualified import ok", n.id)
    sys.exit(0)
}
