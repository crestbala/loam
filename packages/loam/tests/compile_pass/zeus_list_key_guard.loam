// An untouched list costs O(1) per layout. `kfor_refresh` used to walk every
// item on every layout — and the uniqueness pass over those keys is O(rows) —
// so a page with a list paid for the whole list on every frame, whether or
// not it had moved. The refresh now returns when the list signal's generation
// and the item count are unchanged. `each_scanned` counts the items walked.

import "std:fmt"
import "std:sys"
import "std:zeus"
import "std:zui"

fn must(ok: bool, what: string) {
    if ok {
        return
    }
    fmt.println("FAIL", what)
    sys.exit(1)
}

fn Row(i: int, s: string) -> Node {
    return zeus.Text(s)
}

fn main() {
    zeus.window("listkey", 240, 160)
    let items = zeus.signal([]string {})
    let mut host = 0
    zeus.root(zeus.Box(style = Style(direction = Direction.Column, padding = edges(8))) {
        let h = zui.Each(items.get(), Row)
        host = h.id
    })
    zui.push_item(items, "a")
    zui.push_item(items, "b")
    zeus.engine_layout(240, 160)
    must(zeus.engine_find_text("b") != 0, "the rows mounted")

    // Settle, then hold the list still: no layout may walk the items again.
    zeus.engine_layout(240, 160)
    let settled = zui.each_scanned()
    must(settled > 0, "the list was walked while it changed")
    let mut i = 0
    while i < 20 {
        zeus.engine_layout(240, 160)
        i = i + 1
    }
    must(zui.each_scanned() == settled, "an unchanged list walks no items")

    // A real change still reconciles, and only then.
    zui.push_item(items, "c")
    zeus.engine_layout(240, 160)
    must(zui.each_scanned() > settled, "a change walks the items again")
    must(zeus.engine_find_text("c") != 0, "and mounts the new row")
    must(zeus.engine_find_text("a") != 0, "keeping the old ones")

    fmt.println("list key guard ok")
}
