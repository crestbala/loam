// look = -1 is a plain clickable label (default look is Look.Solid / Primary).
import "std:zeus"
import "std:zui"
import "std:sys"

fn main() {
    zeus.snapshot(200, 80, fn() -> Node {
        zui.Button(label = "plain",
                    look = -1,
                    style = Style(background = "#111", color = "#fff"),
                    on_click = fn() {})
    })
    sys.exit(0)
}
