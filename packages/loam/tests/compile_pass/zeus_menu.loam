// Phase 4 batch 5: Menu is ONE `active` index signal (-1 = closed); rows are
// plain data (`MenuRow`), the menu builds the items and hands each its index
// and the count, and `on_select` is the one callback — no item owns state. The active row is the only focusable one and owns Up / Down /
// Enter, so the keyboard moves the highlight and activates it, and no key is
// written into the reactive graph per frame.

import "std:fmt"
import "std:sys"
import "std:zeus"

fn must(ok: bool, what: string) {
    if !ok {
        fmt.println("FAIL", what)
        sys.exit(1)
    }
}

fn main() {
    zeus.window("menu", 360, 300)
    let active = zeus.signal(-1)
    let hits = zeus.signal(0)
    let mut trig_id = 0
    let tree = zeus.Page() {
        zeus.Box(height = 40)
        let trigger = zeus.Button("Actions", look = zeus.LOOK.Outline, size = zeus.SIZE.Md)
        trig_id = trigger.id
        let rows = []MenuRow {
            MenuRow(label = "Rename"),
            MenuRow(label = "Duplicate"),
            MenuRow(label = "Delete", is_separated = true, danger = true),
        }
        zeus.Menu(trigger, active = active, items = rows, label = "File",
                  place = zeus.PLACE.PlaceBelow, width = 180,
                  on_select = fn(i: int) {
                      if i == 0 {
                          hits.set(hits.get() + 1)
                      } else if i == 1 {
                          hits.set(hits.get() + 10)
                      } else {
                          hits.set(hits.get() + 100)
                      }
                  })
    }
    zeus.root(tree)
    zeus.pump_frame()
    let sigs0 = zeus.arena_sigs()
    let closed_draws = zeus.draw_count()

    must(!zeus.text_visible("Rename"), "menu starts closed")
    must(!zeus.text_visible("Delete"), "closed means every item is hidden")

    // Clicking the trigger opens it, landing on the first item.
    let cx = zeus.node_x(trig_id) + zeus.node_width(trig_id) / 2
    let cy = zeus.node_y(trig_id) + zeus.node_height(trig_id) / 2
    zeus.engine_click(cx, cy)
    zeus.engine_mouseup()
    zeus.engine_layout(360, 300)
    must(zeus.text_visible("Rename"), "trigger opened the menu")
    must(zeus.text_visible("Delete"), "every item visible")
    must(active.get() == 0, "opened on the first item")

    // Arrow keys move the highlight, clamped at both ends.
    zeus.engine_key_ev(1003, 0)
    must(active.get() == 1, "down moves the highlight")
    zeus.engine_key_ev(1003, 0)
    must(active.get() == 2, "down again")
    zeus.engine_key_ev(1003, 0)
    must(active.get() == 2, "down clamps at the last item")
    zeus.engine_key_ev(1002, 0)
    must(active.get() == 1, "up moves back")
    zeus.engine_key_ev(1002, 0)
    zeus.engine_key_ev(1002, 0)
    must(active.get() == 0, "up clamps at the first item")

    // Enter runs the active item and closes.
    zeus.engine_key_ev(13, 0)
    must(hits.get() == 1, "enter ran the active item")
    must(active.get() == -1, "enter closed the menu")
    zeus.pump_frame()
    must(!zeus.text_visible("Rename"), "pick hid the items")
    must(zeus.draw_count() == closed_draws, "pick snaps the panel away")

    // Keys after a close are inert, even though the row still holds focus.
    zeus.engine_key_ev(13, 0)
    must(hits.get() == 1, "enter after close does nothing")
    zeus.engine_key_ev(1003, 0)
    must(active.get() == -1, "down after close does not reopen")

    // Reopen; Escape closes.
    zeus.engine_click(cx, cy)
    zeus.engine_mouseup()
    zeus.engine_layout(360, 300)
    must(active.get() == 0, "reopened")
    zeus.engine_key_ev(27, 0)
    must(active.get() == -1, "escape closed the menu")

    // Reopen; an outside click closes through the scrim.
    zeus.engine_click(cx, cy)
    zeus.engine_mouseup()
    zeus.engine_layout(360, 300)
    must(active.get() == 0, "reopened again")
    zeus.engine_click(5, 290)
    zeus.engine_mouseup()
    zeus.engine_layout(360, 300)
    must(active.get() == -1, "outside click closed the menu")

    // Opening, navigating, and closing never allocate a signal.
    must(zeus.arena_sigs() == sigs0, "no signal allocated per toggle")

    fmt.println("menu ok")
}
