// Selectable chrome (tabs, radios, toggles, nav, pagination) tracks its
// signal. The fill is a reactive `style` (one effect per element) — before
// that the first tab stayed highlighted no matter which one you clicked. Chart series colours are checked here too:
// series 0 must take the first brand colour, not the last.
import "std:fmt"
import "std:sys"
import "zeus"
import "zui:colors"
import "zui"

let mut labels: []string = []string {}

fn check(what: string, got: int, want: int) {
    if got != want {
        fmt.println("FAIL", what, "got", got, "want", want)
        sys.exit(1)
    }
}

fn main() {
    push(labels, "Foundations")
    push(labels, "Components")
    push(labels, "Patterns")
    let tab = zeus.signal(0)

    zeus.snapshot(400, 120, fn() -> Node {
        zui.Column(8) {
            zui.Tabs(tab, labels)
        }
    })

    let first = zeus.engine_find_role("tab")
    if first == 0 {
        fmt.println("FAIL no tab node")
        sys.exit(1)
    }
    // The selected trigger's label is ink; the rest are mute. Track that
    // colour so a click that does not repaint the old trigger fails here.
    let label = first + 1
    let on = zeus.node_color_rgb(label)

    // Selecting another tab must repaint the first one back to muted.
    tab.set(2)
    let off = zeus.node_color_rgb(label)
    if on == off {
        fmt.println("FAIL tab 0 kept its selected label colour after the selection moved")
        sys.exit(1)
    }

    tab.set(0)
    check("tab 0 selected again", zeus.node_color_rgb(label), on)

    // Series 0 and 1 are the first two strokes of the natural chart palette.
    if !fmt.eq(zui.chart_stroke_light(0), "#0f6cb2") {
        fmt.println("FAIL series 0 colour:", zui.chart_stroke_light(0))
        sys.exit(1)
    }
    if !fmt.eq(zui.chart_stroke_light(1), "#1b7a34") {
        fmt.println("FAIL series 1 colour:", zui.chart_stroke_light(1))
        sys.exit(1)
    }
    // ...and series 5 wraps back to series 0's colour.
    if !fmt.eq(zui.chart_stroke_light(5), zui.chart_stroke_light(0)) {
        fmt.println("FAIL series wrap")
        sys.exit(1)
    }
    fmt.println("zeus selection ok")
}
