import "std:fmt"
import "std:sys"
import "std:zeus"
import "std:zui"

let mut names: []string = []string {}

fn Files() -> Node {
    return Column(0) {
        zui.Loop(names, fn(i, s) {
            return zeus.Text(s)
        })
    }
}

fn main() {
    let open = zeus.signal(1)
    push(names, "a.loam")
    push(names, "b.loam")
    zeus.snapshot(240, 160, fn() -> Node {
        zeus.Box(style = Style(direction = Direction.Column, wrap = true, minWidth = 40)) {
            Files()
            zui.Show(when = open.get() == 1) {
                zeus.Text("shown")
            }
        }
    })
    if zeus.draw_count() < 3 {
        fmt.println("FAIL if/each")
        sys.exit(1)
    }
    fmt.println("if each wrap ok")
}
