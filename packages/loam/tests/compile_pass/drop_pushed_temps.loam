// A `[]T` pushed into a `[][]T`, or put in a struct beside a string, is
// retained by its new home and still dropped by its source. Each case here
// used to leak one reference per iteration: 1 MB each, 60 times over against a
// 24 MB allowance, so one leak per iteration fails even at half that size.
// `sys.read_file` hands back an owned string, freed on drop. Growth is the
// process's own peak RSS (`getrusage`), read in-process: a leak raises the
// peak by its size each round, while a case that frees keeps it where the
// first round left it.
// An element holding a `Box` is moved into the vec whole, and so is any
// temporary: the slot takes the strings it holds as they are. The push
// used to retain them on top, leaking a struct's string beside a `Box`.

import "std:fmt"
import "std:str"
import "std:sys"

struct Named {
    name: string,
    xs: []int,
}

fn big(n: int) -> []int {
    let mut v = []int {}
    for i in 0..n {
        push(v, i)
    }
    return v
}

struct Boxed {
    b: Box<int>,
    text: string,
}

fn push_boxed_local(i: int) -> int {
    let mut rows = []Boxed {}
    let row = Boxed { b: Box::new(i), text: str.repeat("x", 1000000) }
    push(rows, row)
    return rows.len + *rows[0].b
}

fn push_boxed_temp(i: int) -> int {
    let mut rows = []Boxed {}
    push(rows, Boxed { b: Box::new(i), text: str.repeat("x", 1000000) })
    return rows[0].text.len + *rows[0].b
}

/** *`getrusage(RUSAGE_SELF)`: 34 slots holds every libc's `struct rusage` */
/** *(musl's is the largest, 272 bytes); `ru_maxrss` is slot 4 on all of them. */
#[os("posix")]
#[c("getrusage")]
fn c_getrusage(who: i32, out: []i64) -> i32 {}

/** *Peak resident memory in MB: bytes on macOS, KiB on Linux. */
#[os("posix")]
fn rss_mb() -> int {
    let mut slots = []i64 {}
    for i in 0..34 {
        push(slots, i64(0))
    }
    c_getrusage(0, slots)
    let peak = slots[4]
    return int(if sys.os() == "macos" { peak / i64(1048576) } else { peak / i64(1024) })
}

/** *No `getrusage` on Windows: growth reads as none there, as `ps` did. */
#[os("windows", "wasm")]
fn rss_mb() -> int {
    return 0
}

fn grew(what: string, before: int) {
    let d = rss_mb() - before
    if d > 24 {
        fmt.println("{{what}} leaked: +{{d}} MB")
        sys.exit(1)
    } else {
        fmt.println("{{what}} ok")
    }
}

fn push_temp() -> int {
    let mut rows = [][]int {}
    push(rows, big(250000))
    return rows[0].len
}

fn push_local() -> int {
    let mut rows = [][]int {}
    let row = big(250000)
    push(rows, row)
    return rows.len + row.len
}

fn array_lit() -> int {
    let rows = [][]int { big(250000) }
    return rows[0].len
}

fn struct_lit(i: int) -> int {
    let s = Named { name: "n{{i}}", xs: big(250000) }
    return s.xs.len + s.name.len
}

fn main() {
    let path = "/tmp/loam_drop_pushed_temps.bin"
    sys.write_file(path, str.repeat("x", 1000000))
    // Warm up so allocator caching does not count as growth. Each case also
    // runs a first round before it is measured: on a loaded machine the
    // allocator keeps up to ~50 MB of freed 1 MB blocks resident, a bounded
    // amount the first round fills, while a leak grows by its size every round.
    for i in 0..5 {
        let n = push_temp() + push_local() + array_lit() + struct_lit(i) + push_boxed_local(i) + push_boxed_temp(i)
    }
    let mut r = 0
    for i in 0..60 {
        let n = push_temp()
    }
    r = rss_mb()
    for i in 0..60 {
        let n = push_temp()
    }
    grew("push(rows, f())", r)
    for i in 0..60 {
        let n = push_local()
    }
    r = rss_mb()
    for i in 0..60 {
        let n = push_local()
    }
    grew("push(rows, row)", r)
    for i in 0..60 {
        let n = array_lit()
    }
    r = rss_mb()
    for i in 0..60 {
        let n = array_lit()
    }
    grew("[][]int { f() }", r)
    for i in 0..60 {
        let n = struct_lit(i)
    }
    r = rss_mb()
    for i in 0..60 {
        let n = struct_lit(i)
    }
    grew("Named { name, xs: f() }", r)
    for i in 0..60 {
        let n = push_boxed_local(i)
    }
    r = rss_mb()
    for i in 0..60 {
        let n = push_boxed_local(i)
    }
    grew("push(rows, boxed)", r)
    for i in 0..60 {
        let n = push_boxed_temp(i)
    }
    r = rss_mb()
    for i in 0..60 {
        let n = push_boxed_temp(i)
    }
    grew("push(rows, Boxed { … })", r)
    for i in 0..60 {
        let s = sys.read_file(path)
        let n = s.len
    }
    r = rss_mb()
    for i in 0..60 {
        let s = sys.read_file(path)
        let n = s.len
    }
    grew("sys.read_file", r)
    sys.remove_path(path)
}
