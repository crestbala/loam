// Trailing commas after UI children and after the last named Box prop.
import "std:fmt"
import "std:sys"
import "std:zeus"

fn Kids() -> Node {
    return zeus.Box(
        style = Style(direction = Direction.Column, gap = 8, padding = edges(12))
    ) {
        zeus.Text("a"),
        zeus.Text("b"),
        zeus.Box(style = Style(width = px(4), height = px(4), background = "#89b4fa")),
    }
}

fn main() {
    zeus.snapshot(200, 120, fn() -> Node {
        zeus.Box(style = Style(direction = Direction.Column)) {
            Kids()
        }
    })
    if zeus.draw_count() < 2 {
        fmt.println("FAIL child comma")
        sys.exit(1)
    }
    fmt.println("child comma ok")
}
