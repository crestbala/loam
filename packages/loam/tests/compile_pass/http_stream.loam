// Server-streaming RPC (`app.stream` / `client.watch`). A server in this
// same process, stepped between the client's async ticks, serves a counter
// that steps every 300 ms up to 5, plus a plain RPC. The client must get each
// new value once, in order, over one request; a unary call must still be
// answered while the stream is open; an open, quiet stream must not keep the
// host busy (it would draw every frame); and stopping the server must end the
// stream. One process, so it runs the same everywhere (no `sh`, no `kill`).

import "std:async"
import "std:fmt"
import "http"
import "std:sys"

fn fail(what: string) {
    fmt.println("FAIL", what)
    sys.exit(1)
}

let mut srv_t0: i64 = 0

fn counter_app() -> App {
    srv_t0 = async.now_ms()
    let app = http.app()
    app.rpc("T.Ping", |body| { "pong" })
    app.stream("T.Count", |body| {
        let mut n = int(async.now_ms() - srv_t0) / 300
        if n > 5 {
            n = 5
        }
        "n{{n}}"
    })
    return app
}

fn text_int(s: string) -> int {
    let mut v = 0
    for i in 0..s.len {
        if s[i] >= 48 && s[i] <= 57 {
            v = v * 10 + s[i] - 48
        }
    }
    return v
}

let mut msgs: []string = []string {}
let mut ended: int = 0
let mut pong: string = ""

/** *Step the server (unless stopped) and the client's async work until */
/** *`done()` or `ms` pass. */
fn pump(srv: &mut Server, ms: int, done: fn() -> bool) -> bool {
    let mut left = ms
    while left > 0 {
        if srv.fd >= 0 {
            server_step(srv, 0)
        }
        async.tick()
        if done() {
            return true
        }
        async.sleep(5)
        left -= 5
    }
    return false
}

fn main() {
    let mut srv = server_start(counter_app(), 0, ListenProps {})
    if srv.fd < 0 {
        fail("server did not listen")
    }
    let c = http.client("127.0.0.1:{{srv.port}}")
    c.watch("T.Count", "", fn(m) { push(msgs, m) }, || { ended = 1 })

    if !pump(&mut srv, 3000, || { msgs.len > 0 }) {
        fail("no first message")
    }
    if async.busy() != 0 {
        fail("an open stream keeps the host busy (it would draw every frame)")
    }

    // A unary call while the stream is open.
    c.call_async("T.Ping", "", fn(out) { pong = out })
    if !pump(&mut srv, 3000, || { pong != "" }) {
        fail("a unary call was not answered while a stream was open")
    }
    if pong != "pong" {
        fail("unary reply {{pong}}")
    }

    if !pump(&mut srv, 6000, || { msgs.len > 0 && msgs[msgs.len - 1] == "n5" }) {
        fail("stream did not reach n5 (got {{msgs.len}} messages)")
    }
    for i in 1..msgs.len {
        if msgs[i] == msgs[i - 1] {
            fail("an unchanged value was pushed twice: {{msgs[i]}}")
        }
        if text_int(msgs[i]) < text_int(msgs[i - 1]) {
            fail("out of order: {{msgs[i - 1]}} then {{msgs[i]}}")
        }
    }
    if ended != 0 {
        fail("stream ended while the server was up")
    }

    server_stop(&mut srv)
    if !pump(&mut srv, 3000, || { ended == 1 }) {
        fail("stream did not end when the server stopped")
    }
    fmt.println("http stream ok · {{msgs.len}} messages")
}
