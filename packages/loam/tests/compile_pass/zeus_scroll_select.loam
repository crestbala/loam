// A Select inside a scroller. Its trigger is z-indexed (a floater), and a
// floater inside a scroller used to be painted twice: inline by the
// scroller, scrolled and clipped, and again in the floaters section at its
// unscrolled position, so scrolling showed a second trigger sliding away
// from the first. The scroller's inline copy also kept the look of the
// last full record, so the open menu froze mid-fade and a closed one stayed
// on screen. Each must be painted once, follow the scroll, and fade fully.

import "std:fmt"
import "std:sys"
import "std:zeus"
import "std:zui"

const W: int = 400
const H: int = 300

fn must(ok: bool, what: string) {
    if !ok {
        fmt.println("FAIL", what)
        sys.exit(1)
    }
}

fn tick() {
    zeus.engine_layout(W, H)
    zeus.engine_step()
    zeus.engine_paint()
}

/// Ops reading `text`, how many, and the y and alpha of the last one.
fn copies(text: string) -> int {
    let mut n = 0
    for i in 0..zeus.draw_count() {
        if zeus.draw_text(i) == text && zeus.draw_alpha(i) > 0 {
            n = n + 1
        }
    }
    return n
}

fn last_y(text: string) -> int {
    let mut y = -1
    for i in 0..zeus.draw_count() {
        if zeus.draw_text(i) == text {
            y = zeus.draw_y(i)
        }
    }
    return y
}

fn last_alpha(text: string) -> int {
    let mut a = -1
    for i in 0..zeus.draw_count() {
        if zeus.draw_text(i) == text {
            a = zeus.draw_alpha(i)
        }
    }
    return a
}

fn Page(v: Signal<int>) -> Node {
    return zeus.Box(style = Style(direction = Direction.Column, width = pct(100), height = pct(100))) {
        zui.Scroll(style = Style(grow = 1, shrink = 1)) {
            zeus.Box(style = Style(direction = Direction.Column, gap = 12, padding = 20)) {
                zeus.Box(style = Style(height = px(120)))
                zui.Select(v, []string { "Alpha", "Bravo", "Charlie" }, size = zeus.Size.Sm, label = "Pick",
                           style = Style(width = px(120)))
                zeus.Box(style = Style(height = px(200)))
            }
        }
    }
}

fn main() -> int {
    let v = zeus.signal(0)
    zeus.window("t", W, H)
    zeus.root(Page(v))
    tick()
    must(copies("Alpha") == 1, "the trigger is painted once")
    let y0 = last_y("Alpha")

    zeus.engine_scroll(100, 150, 0, 60)
    for i in 0..30 {
        tick()
    }
    must(copies("Alpha") == 1, "the trigger is painted once after a scroll")
    let y1 = last_y("Alpha")
    must(y1 < y0 && y1 > 0, "the trigger moves with the scroll and stays in view")

    // Open at the trigger as drawn (scrolled).
    zeus.engine_click(30, y1 + 4)
    zeus.engine_mouseup()
    tick()
    tick()
    let mid = last_alpha("Bravo")
    // A full record mid-fade (a resize) must not freeze the menu there.
    zeus.engine_layout(W + 1, H)
    zeus.engine_paint()
    for i in 0..40 {
        tick()
    }
    must(copies("Bravo") == 1, "the open menu is painted once")
    must(last_alpha("Bravo") == 255, "the menu fades all the way in")
    must(last_y("Bravo") > y1, "the menu opens under its scrolled trigger")

    zeus.engine_key_ev(27, 0)
    for i in 0..40 {
        tick()
    }
    must(copies("Bravo") == 0, "a closed menu leaves nothing behind")
    fmt.println("scroll select ok {{mid < 255}}")
    return 0
}
