// `#[c]` over a vendored source: scalars, strings, out pointers, and bytes with
// NULs in both directions. An unused binding links nothing, so `c_ffi_missing`
// has no definition anywhere.

#![c_source("vendor/c_ffi.c", "-DC_FFI_BASE=10")]
#![c_link("-lm")]

import "std:fmt"
import "std:sys"

#[c("c_ffi_add")]
fn add(a: i32, b: i32) -> i32 {}

#[c("c_ffi_open")]
fn open_handle(name: string, handle: []i64) {}

#[c("c_ffi_tail")]
fn tail(text: string) -> string {}

#[c("c_ffi_half")]
fn half(x: f64) -> f64 {}

#[c("c_ffi_quarter")]
fn quarter(x: float) -> float {}

#[c("c_ffi_even")]
fn even(n: i64) -> bool {}

#[c("c_ffi_sum")]
fn sum_bytes(bytes: []u8, n: i64) -> i64 {}

#[c("c_ffi_sum")]
fn sum_string(text: string, n: i64) -> i64 {}

#[c("c_ffi_blob")]
fn blob() -> i64 {}

#[c("c_ffi_addr")]
fn addr(bytes: []u8) -> i64 {}

#[c("c_ffi_tick")]
fn tick() {}

#[c("c_ffi_calls")]
fn calls() -> int {}

#[c("memcpy")]
fn copy_out(dst: []u8, src: i64, n: i64) -> i64 {}

#[c("floor")]
fn c_floor(x: f64) -> f64 {}

#[c("c_ffi_missing")]
fn missing() {}

/** *C's `CFfiRect`: four `float`s, passed by value. */
struct Rect {
    x: f32,
    y: f32,
    width: f32,
    height: f32,
}

/** *C's `CFfiRgba`: four bytes. */
struct Rgba {
    r: u8,
    g: u8,
    b: u8,
    a: u8,
}

/** *C's `CFfiItem`: nested structs, a bool, and padding before the `i64`. */
struct Item {
    rect: Rect,
    tint: Rgba,
    on: bool,
    id: i64,
    weight: f64,
}

#[c("c_ffi_area")]
fn area(r: Rect) -> f64 {}

#[c("c_ffi_rgba")]
fn rgba(c: Rgba) -> i64 {}

#[c("c_ffi_item")]
fn item_sum(base: i32, item: Item, after: i32) -> i64 {}

#[c("c_ffi_flip")]
fn flip(flags: []bool, n: i32) -> i32 {}

#[c("c_ffi_vsum", "variadic after 1")]
fn vsum3(count: i32, a: i64, b: i64, c: i64, x: f64, tail: string) -> i64 {}

/** *`fcntl(fd, F_GETFD)` and `fcntl(fd, F_SETFD, flags)`: libc's own */
/** *variadic fn, through two shapes of one binding (POSIX only). */
#[os("posix")]
#[c("fcntl", "variadic after 2")]
fn fcntl_get(fd: i32, cmd: i32) -> i32 {}

#[os("posix")]
#[c("fcntl", "variadic after 2")]
fn fcntl_set(fd: i32, cmd: i32, arg: i32) -> i32 {}

/** *Close-on-exec set and cleared on stdout. F_GETFD 1, F_SETFD 2 and */
/** *FD_CLOEXEC 1 on macOS and Linux alike. */
#[os("posix")]
fn fcntl_round_trip() -> bool {
    return fcntl_set(1, 2, 1) == 0 &&
        fcntl_get(1, 1) == 1 &&
        fcntl_set(1, 2, 0) == 0 &&
        fcntl_get(1, 1) == 0
}

/** *Windows has no `fcntl`. */
#[os("windows", "wasm")]
fn fcntl_round_trip() -> bool {
    return true
}

/** *Named like a runtime function: the wrapper has to be renamed, not collide. */
#[c("strlen")]
fn str_copy(s: string) -> i64 {}

fn expect(good: bool, what: string) {
    if !good {
        fmt.println("FAIL", what)
        sys.exit(1)
    }
}

fn main() {
    expect(add(2, 3) == 15, "scalars and compile flags")

    let handle = []i64 { 0 }
    open_handle("hello", handle)
    expect(handle[0] == 10, "out pointer")

    expect(tail("xyz") == "yz", "string result")
    expect(tail("") == "", "NULL string result")
    expect(half(5.0) == 2.5, "f64")
    expect(quarter(float(1)) == 0.25, "f32")
    expect(even(4) && !even(3), "bool")
    expect(c_floor(2.5) == 2.0, "c_link")
    expect(str_copy("four") == 4, "name shared with the runtime")

    let bytes = []u8 { 1, 0, 255 }
    expect(sum_bytes(bytes, i64(bytes.len)) == 256, "bytes into C")

    let out = []u8 { 0, 0, 0, 0, 0 }
    copy_out(out, blob(), 5)
    let text = string_from_bytes(out)
    expect(text.len == 5, "bytes out of C keep their NUL")
    expect(sum_string(text, i64(text.len)) == 394, "string into C keeps its NUL")

    // A reference the wrapper failed to release would make this pop copy.
    let mut buffer = []u8 {}
    buffer.push(u8(1))
    buffer.push(u8(2))
    let before = addr(buffer)
    let _ = buffer.pop()
    expect(addr(buffer) == before, "[]T argument released")

    let r = Rect { x: f32(3.0), y: f32(1.0), width: f32(2.5), height: f32(4.0) }
    expect(area(r) == 12.0, "struct by value")
    expect(
        rgba(Rgba { r: u8(1), g: u8(2), b: u8(3), a: u8(255) }) == 16909311,
        "byte struct by value",
    )
    let item = Item {
        rect: r,
        tint: Rgba { r: u8(0), g: u8(0), b: u8(3), a: u8(232) },
        on: true,
        id: i64(5000000000),
        weight: 0.75,
    }
    // 7 + 12 + 1000 % 1000 + 100 + 5000000000 + 3 + 9
    expect(item_sum(7, item, 9) == 5000000131, "nested struct with a bool, between scalars")
    expect(r.width == f32(2.5), "struct argument is a copy")

    let flags = []bool { true, false, false }
    expect(flip(flags, 3) == 2, "[]bool into C")
    expect(!flags[0] && flags[1] && flags[2], "[]bool written by C")

    expect(
        vsum3(3, i64(1), i64(20), i64(300), 0.5, "four") == 330,
        "variadic ints, a double and a string",
    )
    expect(fcntl_round_trip(), "variadic libc fcntl")

    let f = tick
    f()
    tick()
    expect(calls() == 2, "binding as a value")

    let mut total = 0
    for i in 0..200000 {
        let s = tail("loam")
        total += s.len
    }
    expect(total == 600000, "string results over many calls")

    fmt.println("c ffi ok")
}
