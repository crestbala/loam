// `for i in 0..xs.len` proves `xs[i]` in range only while `xs` keeps its
// length. Reassigning it in the body voids the proof: the read must trap.
import "std:fmt"

fn main() {
    let mut xs = []int { 1, 2, 3 }
    let mut total = 0
    for i in 0..xs.len {
        xs = []int { 9 }
        total += xs[i]
    }
    fmt.println(total)
}
