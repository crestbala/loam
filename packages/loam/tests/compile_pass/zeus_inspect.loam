// Phase 19 devtools: the inspector reads the arena — node tree with layout
// boxes, and live signal values (§2.4).

import "std:fmt"
import "std:sys"
import "std:zeus"
import "std:zui"

fn must(ok: bool, what: string) {
    if !ok {
        fmt.println("FAIL", what)
        sys.exit(1)
    }
}

fn has(hay: string, needle: string) -> int {
    if needle.len == 0 {
        return 1
    }
    if hay.len < needle.len {
        return 0
    }
    let last = hay.len - needle.len
    let mut i = 0
    while i <= last {
        let mut ok = 1
        let mut j = 0
        while j < needle.len {
            if hay[i + j] != needle[j] {
                ok = 0
            }
            j = j + 1
        }
        if ok == 1 {
            return 1
        }
        i = i + 1
    }
    return 0
}

fn main() {
    let count = zeus.signal(42)
    zeus.snapshot(300, 200, fn() -> Node {
        zeus.Box(align_direction = DIRECTION.Column) {
            zeus.Text("inspect me")
            zui.Button(label = "Go")
        }
    })
    zeus.engine_layout(300, 200)

    let tree = zeus.engine_tree_dump()
    must(has(tree, "inspect me") == 1, "tree lists text")
    must(has(tree, "Go") == 1, "tree lists button")
    must(has(tree, "button") == 1, "tree lists role")

    let sig = zeus.engine_signals_dump()
    must(has(sig, "\t42\n") == 1, "signals dump lists the value")

    fmt.println("inspect ok")
}
