// Golden layout checks: a handful of coordinates per widget, asserted from
// the headless layout instead of paint dumps, so row/grid/overlay regressions
// fail here and not in a desktop session.

import "std:fmt"
import "std:sys"
import "std:zeus"

fn expect(ok: bool, what: string) {
    if ok {
        return
    }
    fmt.println("FAIL", what)
    sys.exit(1)
}

fn main() {
    let open = zeus.signal(0)
    zeus.snapshot(480, 320, fn() -> Node {
        zeus.Page() {
            // Fixed-width buttons: row gap 8.
            zeus.Box(align_direction = DIRECTION.Row, spacing = 8) {
                zeus.Button("a", width = 80, height = 28, on_click = fn() {})
                zeus.Button("b", width = 120, height = 28, on_click = fn() {})
            }
            // Right-aligned row pins its trailing child to the content edge.
            zeus.Box(align_direction = DIRECTION.Row, justify = ALIGN.End, width = 416) {
                zeus.Button("c", width = 60, height = 24, on_click = fn() {})
            }
            // 2x2 grid of fixed cells: columns then rows at gap 8.
            zeus.Grid(config = zeus.GridConfig(columns = 2, gap = 8)) {
                zeus.Button("g1", width = 70, height = 40, on_click = fn() {})
                zeus.Button("g2", width = 70, height = 40, on_click = fn() {})
                zeus.Button("g3", width = 70, height = 40, on_click = fn() {})
                zeus.Button("g4", width = 70, height = 40, on_click = fn() {})
            }
            // Responsive grid: a 130 dp floor at gap 8 has room for three
            // cells across the 416 point content width, but `columns = 2` is
            // the cap, so two 204 wide cells and the rest wrap.
            zeus.Grid(config = zeus.GridConfig(columns = 2, auto_columns = 130, gap = 8)) {
                zeus.Button("a1", height = 20, on_click = fn() {})
                zeus.Button("a2", height = 20, on_click = fn() {})
                zeus.Button("a3", height = 20, on_click = fn() {})
                zeus.Button("a4", height = 20, on_click = fn() {})
            }
            // Same floor, no cap, half the width: the floor alone decides and
            // 200 points leaves a single column.
            zeus.Grid(config = zeus.GridConfig(auto_columns = 130, gap = 8), width = 200) {
                zeus.Button("b1", height = 20, on_click = fn() {})
                zeus.Button("b2", height = 20, on_click = fn() {})
            }
            zeus.Button("open", width = 60, height = 24, on_click = fn() => open.set(1))
            zeus.Dialog(open, title = "Golden") {
                zeus.Body("Fixed 440 wide card, centered over the dim.")
            }
        }
    })
    let b1 = zeus.engine_find_text("a")
    let b2 = zeus.engine_find_text("b")
    let c = zeus.engine_find_text("c")
    let g1 = zeus.engine_find_text("g1")
    let g2 = zeus.engine_find_text("g2")
    let g3 = zeus.engine_find_text("g3")
    let g4 = zeus.engine_find_text("g4")
    expect(b1 > 0 && b2 > 0 && c > 0 && g1 > 0 && g4 > 0, "widgets found")
    // Fixed row: same baseline; the gap between fixed widths is exactly 8.
    expect(zeus.node_y(b1) == zeus.node_y(b2), "row shares baseline")
    expect(zeus.node_width(b1) == 80 && zeus.node_width(b2) == 120, "button widths")
    expect(zeus.node_x(b2) - (zeus.node_x(b1) + zeus.node_width(b1)) == 8, "row gap is 8")
    // End-justified row: the trailing child ends at the page content edge
    // (Page pad is 32; the window is 480 wide).
    expect(zeus.node_x(c) + zeus.node_width(c) == 480 - 32, "end row touches content edge")
    // Grid: equal columns at gap 8 (cells stretch to the column width).
    let gw = zeus.node_width(g1)
    expect(zeus.node_x(g2) - zeus.node_x(g1) == gw + 8, "grid column pitch")
    expect(zeus.node_width(g2) == gw, "grid columns equal")
    expect(zeus.node_x(g3) == zeus.node_x(g1), "grid rows align left")
    expect(zeus.node_y(g3) - zeus.node_y(g1) == 48, "grid row pitch")
    expect(zeus.node_x(g4) == zeus.node_x(g2) && zeus.node_y(g4) == zeus.node_y(g3),
           "grid last cell lands")
    // Responsive grid: the floor is what fills the row, `columns` is only the
    // ceiling, and the gap is part of the cell the floor measures.
    let a1 = zeus.engine_find_text("a1")
    let a2 = zeus.engine_find_text("a2")
    let a3 = zeus.engine_find_text("a3")
    let a4 = zeus.engine_find_text("a4")
    expect(a1 > 0 && a4 > 0, "auto grid cells found")
    expect(zeus.node_width(a1) == 204, "auto grid cell divides the width")
    expect(zeus.node_x(a2) - zeus.node_x(a1) == 212, "auto grid column pitch")
    expect(zeus.node_y(a2) == zeus.node_y(a1), "auto grid cap holds two in the row")
    expect(zeus.node_y(a3) - zeus.node_y(a1) == 28, "auto grid wraps to a second row")
    expect(zeus.node_x(a3) == zeus.node_x(a1), "auto grid row starts at the content edge")
    expect(zeus.node_x(a4) == zeus.node_x(a2), "auto grid row fills both cells")
    // A narrower grid with no cap: one full-width column, stacked.
    let n1 = zeus.engine_find_text("b1")
    let n2 = zeus.engine_find_text("b2")
    expect(zeus.node_width(n1) == 200, "narrow auto grid is a full-width column")
    expect(zeus.node_x(n2) == zeus.node_x(n1), "narrow auto grid stacks")
    expect(zeus.node_y(n2) - zeus.node_y(n1) == 28, "narrow auto grid row pitch")
    // Dialog: opening centers the fixed 440 card over the dim.
    expect(zeus.engine_click_text("open") != 0, "open click")
    zeus.engine_layout(480, 320)
    let dlg = zeus.engine_find_role("dialog")
    expect(dlg > 0, "dialog shows after open")
    expect(zeus.node_width(dlg) == 440, "dialog card width")
    expect(zeus.node_x(dlg) == (480 - 440) / 2, "dialog centered x")
    let close = zeus.engine_find_text("Close")
    let title = zeus.engine_find_text("Golden")
    expect(close > 0, "dialog close")
    expect(title > 0, "dialog title")
    expect(zeus.node_width(close) == 28, "close is a fixed 28px slot")
    expect(zeus.node_x(title) < zeus.node_x(close), "title left of close")
    expect(zeus.node_y(close) < zeus.node_y(title) + 24, "title and close share the header row")
    expect(zeus.node_x(close) > zeus.node_x(dlg) + zeus.node_width(dlg) / 2,
           "close sits on the trailing half")
    fmt.println("golden ok")
}
