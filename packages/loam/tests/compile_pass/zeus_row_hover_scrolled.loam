// Dropdown rows (Menu / Combobox / Select) must hover inside a SCROLLED page.
// Their lists are anchored floaters, placed in window space; the pointer test
// (`ptr_in` / `hover_walk`) used to add the page scroller's offset anyway, so
// once the page had scrolled, hover hit the wrong rows (or none) and only the
// keyboard highlight ever painted. This drives each list by mouse after a
// scroll and asserts the hovered row is the one that is painted.

import "std:fmt"
import "std:sys"
import "std:zeus"
import "std:colors"
import "std:zui"

fn must(ok: bool, what: string) {
    if ok {
        return
    }
    fmt.println("FAIL", what)
    sys.exit(1)
}

// The row box (kind 1) carrying `label` — the node the fill lives on.
fn row(label: string) -> int {
    for id in 1..zeus.arena_nodes() {
        if zeus.node_kind(id) == 1 && zeus.node_label(id) == label {
            return id
        }
    }
    return 0
}

fn frame() {
    zeus.engine_layout(360, 460)
    zeus.engine_step()
    zeus.engine_paint()
}

fn settle() {
    for _ in 0..30 {
        frame()
    }
}

// A full-row fill was painted for `id` this frame.
fn painted(id: int) -> bool {
    let x = zeus.node_x(id)
    let y = zeus.node_y(id)
    for i in 0..zeus.draw_count() {
        if zeus.draw_x(i) == x && zeus.draw_y(i) == y &&
           zeus.draw_w(i) == zeus.node_width(id) && zeus.draw_h(i) == zeus.node_height(id) &&
           zeus.draw_rgb(i) == zeus.node_background_rgb(id) && zeus.draw_rgb(i) != 0 {
            return true
        }
    }
    return false
}

fn hover_row(id: int) {
    zeus.engine_hover(zeus.node_x(id) + 4, zeus.node_y(id) + 4)
    settle()
}

fn main() {
    zeus.window("row hover scrolled", 360, 460)
    let value = zeus.signal(0)
    let query = zeus.signal("")
    let active = zeus.signal(-1)
    let mut trig_id = 0
    let rows = []MenuRow {
        MenuRow(label = "Rename"),
        MenuRow(label = "Duplicate"),
        MenuRow(label = "Delete"),
    }
    let sc = zui.Scroll(style = Style(width = px(360), height = px(460))) {
        zui.Page() {
            Box(style = Style(height = px(300))) {}
            zui.Select(value, []string { "Small", "Medium", "Large" })
            zui.Combobox(query, []string { "Apple", "Apricot", "Banana" },
                         style = Style(width = px(200)))
            zui.Menu(active = active,
                     items = rows,
                     label = "File",
                     trigger = || {
                let trigger = zui.Button("Actions", look = zeus.Look.Outline, size = zeus.Size.Md)
                trig_id = trigger.id
            },
                     place = zui.Place.PlaceBelow,
                     style = Style(width = px(180)))
            Box(style = Style(height = px(900))) {}
        }
    }
    zeus.root(sc)
    settle()
    zeus.engine_scroll_step(100, 100, 0, 200)
    settle()
    must(zeus.node_scroll_y(sc.id) == 200, "page scrolled")

    // --- Menu ---------------------------------------------------------------
    zeus.click_id(trig_id)
    zeus.engine_mouseup()
    settle()
    must(active.get() == 0, "menu opened on the first item")
    let del = row("Delete")
    hover_row(del)
    must(active.get() == 2, "menu: hover moved the highlight to Delete")
    must(painted(del), "menu: hovered row painted")
    must(!painted(row("Rename")), "menu: previous row released")
    zeus.engine_hover(4, 4)
    zeus.engine_key_ev(27, 0)
    settle()

    // --- Combobox -----------------------------------------------------------
    zeus.engine_click_text("Search")
    zeus.engine_mouseup()
    settle()
    must(zeus.text_visible("Apricot"), "combobox opened")
    let ap = row("Apricot")
    hover_row(ap)
    must(painted(ap), "combobox: hovered row painted")
    must(!painted(row("Apple")), "combobox: one highlight, not two")
    zeus.engine_hover(4, 4)
    zeus.engine_key_ev(27, 0)
    settle()

    fmt.println("row hover scrolled ok")
}
