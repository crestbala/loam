// std:json — the Phase 16 exit cases: a malformed document, a 70-deep nesting
// bomb, a missing field, and an out-of-range integer all return an error
// naming the field path, and none of them trap.

import "std:fmt"
import "std:sys"
import "std:json"

fn fail(m: string) {
    fmt.println("FAIL", m)
    sys.exit(1)
}

fn main() {
    // 1. Malformed document.
    let bad = json.parse("{")
    if bad.ok != 0 {
        fail("malformed accepted")
    }
    if bad.err.len == 0 {
        fail("malformed has no message")
    }

    // 2. 70-deep nesting bomb: an error, not a stack overflow.
    let mut b = []int {}
    let mut i = 0
    while i < 70 {
        push(b, 91)
        i = i + 1
    }
    i = 0
    while i < 70 {
        push(b, 93)
        i = i + 1
    }
    let deep = json.parse(string_from_bytes(b))
    if deep.ok != 0 {
        fail("nesting bomb accepted")
    }

    // 3. Missing field names the field path.
    let d = json.parse("{\"user\":{\"name\":\"ada\"}}")
    if d.ok == 0 {
        fail("valid doc rejected")
    }
    let u = json.field(d.nodes, d.root, "user", "user")
    if u.ok == 0 {
        fail("user field")
    }
    let age = json.field(d.nodes, u.id, "age", "user.age")
    if age.ok != 0 {
        fail("missing field accepted")
    }
    if age.err != "user.age: missing" {
        fail("missing field path wrong")
    }

    // 4. Out-of-range integer names the field path.
    let big = json.parse("{\"n\":99999999999999999999}")
    let nid = json.field(big.nodes, big.root, "n", "n")
    if nid.ok == 0 {
        fail("n field")
    }
    let iv = json.as_int(big.nodes, nid.id, "n")
    if iv.ok != 0 {
        fail("overflow accepted")
    }
    if iv.err != "n: integer out of range" {
        fail("overflow path wrong")
    }

    // Happy path: kinds, indexing, stringify.
    let v = json.parse("{\"a\":[1,2,3],\"s\":\"hi\",\"t\":true}")
    let a = json.field(v.nodes, v.root, "a", "a")
    if json.kind(v.nodes, a.id) != JSON_KIND.Arr {
        fail("array kind")
    }
    if json.child_count(v.nodes, a.id) != 3 {
        fail("array length")
    }
    let e = json.index(v.nodes, a.id, 1, "a[1]")
    let n = json.as_int(v.nodes, e.id, "a[1]")
    if n.ok == 0 {
        fail("int access")
    }
    if n.n != 2 {
        fail("int value")
    }
    let sfield = json.field(v.nodes, v.root, "s", "s")
    let s = json.as_str(v.nodes, sfield.id, "s")
    if s.ok == 0 {
        fail("str access")
    }
    if s.s != "hi" {
        fail("str value")
    }
    let tfield = json.field(v.nodes, v.root, "t", "t")
    let t = json.as_bool(v.nodes, tfield.id, "t")
    if t.ok == 0 {
        fail("bool access")
    }
    if t.b == false {
        fail("bool value")
    }
    let rt = json.stringify(v.nodes, v.root)
    if rt != "{\"a\":[1,2,3],\"s\":\"hi\",\"t\":true}" {
        fail("stringify round-trip")
    }

    // Two live documents must not alias: the pool travels with the doc, so
    // reading `a` after parsing `b` still reads `a`'s tree.
    let t1 = json.parse("{\"x\":1}")
    let t2 = json.parse("{\"y\":2}")
    let fx = json.field(t1.nodes, t1.root, "x", "x")
    let fy = json.field(t2.nodes, t2.root, "y", "y")
    if fx.ok == 0 {
        fail("doc 1 read after doc 2 parsed (aliased pool)")
    }
    if fy.ok == 0 {
        fail("doc 2 read")
    }
    let nx = json.as_int(t1.nodes, fx.id, "x")
    if nx.ok == 0 {
        fail("doc 1 int after doc 2 parsed")
    }
    if nx.n != 1 {
        fail("doc 1 value after doc 2 parsed")
    }

    fmt.println("json ok")
}
