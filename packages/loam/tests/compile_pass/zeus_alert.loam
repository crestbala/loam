// Alert info/success tiers, dismiss (X sets the signal to 0), and a trailing
// action slot under the body.
import "std:fmt"
import "std:sys"
import "std:zeus"
import "std:zui"

fn must(ok: bool, what: string) {
    if !ok {
        fmt.println("FAIL", what)
        sys.exit(1)
    }
}

fn main() {
    zeus.window("alert", 480, 360)
    let shown = zeus.signal(true)
    let hits = zeus.signal(0)
    zeus.root(zeus.Box(style = Style(direction = zeus.Direction.Column, gap = 8, padding = edges(16))) {
        zui.Alert("Heads up", "Default is info.")
        zui.Alert("Saved", "Draft is on disk.", tone = Tone.Ok)
        zui.Alert("Note", "You can dismiss this.", dismiss = shown)
        zui.Alert("Failed", "Try again.", tone = Tone.Danger) {
            zui.Button("Retry", look = zeus.Look.Outline, size = zeus.Size.Sm,
                        on_click = fn() { hits.set(hits.get() + 1) })
        }
    })
    zeus.pump_frame()
    must(zeus.text_visible("Heads up"), "info title")
    must(zeus.text_visible("Saved"), "success title")
    must(zeus.text_visible("Draft is on disk."), "success body")
    must(zeus.engine_find_role("alert") != 0, "alert role")
    must(zeus.text_visible("Note"), "dismissible shown")
    must(zeus.engine_find_text("Dismiss") != 0, "dismiss control")
    must(zeus.text_visible("Retry"), "action slot")

    zeus.engine_click_text("Dismiss")
    zeus.engine_mouseup()
    zeus.engine_layout(480, 360)
    must(!shown.get(), "dismiss set the signal to 0")
    must(!zeus.text_visible("Note"), "dismissed alert is hidden")

    zeus.engine_click_text("Retry")
    zeus.engine_mouseup()
    must(hits.get() == 1, "action slot ran")

    fmt.println("alert ok")
}