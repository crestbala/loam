import "std:zeus"

fn main() {
    zeus.App("Tuple", fn() -> Node {
        return zeus.Box(style = Style(direction = Direction.Column, padding = edges(8))) {
            zeus.Text("a")
            zeus.Text("b")
            zeus.Box(style = Style(direction = Direction.Row, gap = 4)) {
                zeus.Text("c")
                zeus.Text("d")
            }
        }
    }, 320, 200)
}
