// Tabs indicator: a single plate box under the selected trigger, placed from
// measured geometry after the first layout, sliding on a selection change
// (layout-tweened pins; no component re-run) and re-placed on resize.
import "std:fmt"
import "std:sys"
import "std:zeus"
import "std:colors"
import "std:design"

fn must(ok: bool, what: string) {
    if !ok {
        fmt.println("FAIL", what)
        sys.exit(1)
    }
}

fn settle() {
    let mut i = 0
    while i < 30 {
        zeus.engine_layout(400, 200)
        zeus.engine_step_dt(16)
        zeus.engine_paint()
        i = i + 1
    }
}

fn main() {
    zeus.window("tabs", 400, 200)
    let sel = zeus.signal(0)
    zeus.root(zeus.Box(padding = 16) {
        design.Tabs(sel, []string { "Overview", "Metrics", "Logs" })
    })
    zeus.pump_frame()
    zeus.engine_layout(400, 200)
    let ind = zeus.engine_find_role("presentation")
    must(ind != 0, "indicator")
    let a = zeus.engine_find_text("Overview")
    let b = zeus.engine_find_text("Metrics")
    must(zeus.node_x(ind) == zeus.node_x(a), "under the first tab")
    must(zeus.node_width(ind) == zeus.node_width(a), "first tab width")
    must(zeus.node_height(ind) == zeus.node_height(a), "tab height")
    must(zeus.node_kind(ind) == 1, "indicator is a plain box")

    // Select Metrics: the pins tween (a track is live, the box is between
    // the two tabs mid-way), then land on Metrics.
    let c0 = zeus.proof_components()
    must(zeus.engine_click_text("Metrics") != 0, "click Metrics")
    zeus.engine_layout(400, 200)
    must(zeus.proof_anim_live() > 0, "slide on a track")
    zeus.engine_step_dt(60)
    zeus.engine_layout(400, 200)
    must(zeus.node_x(ind) > zeus.node_x(a), "moving right")
    must(zeus.node_x(ind) < zeus.node_x(b), "not there yet")
    settle()
    must(zeus.node_x(ind) == zeus.node_x(b), "landed under Metrics")
    must(zeus.node_width(ind) == zeus.node_width(b), "Metrics width")
    must(zeus.proof_components() == c0, "no component re-run")
    must(zeus.engine_step_dt(16) == 0, "idle after the slide")

    // Keyboard: Right arrow moves the selection and the indicator follows.
    zeus.engine_key_ev(1001, 0)
    settle()
    must(sel.get() == 2, "arrow moved selection")
    must(zeus.node_x(ind) == zeus.node_x(zeus.engine_find_text("Logs")), "under Logs")
    fmt.println("tabs indicator ok")
}
