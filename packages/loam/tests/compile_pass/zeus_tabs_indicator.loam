// Tabs selection is a fill on the selected trigger. Nothing is measured and
// nothing slides: a click moves the plate from one trigger to the next in
// the same frame, with no component re-run.
import "std:fmt"
import "std:sys"
import "std:zeus"
import "std:zui"

fn must(ok: bool, what: string) {
    if !ok {
        fmt.println("FAIL", what)
        sys.exit(1)
    }
}

fn main() {
    zeus.window("tabs", 400, 200)
    let sel = zeus.signal(0)
    zeus.root(zeus.Box(style = Style(padding = 16)) {
        zui.Tabs(sel, []string { "Overview", "Metrics", "Logs" })
    })
    zeus.pump_frame()
    zeus.engine_layout(400, 200)
    let a = zeus.engine_find_text("Overview")
    let b = zeus.engine_find_text("Metrics")
    must(a != 0 && b != 0, "tab triggers")
    let on = zeus.node_background_rgb(a)
    let off = zeus.node_background_rgb(b)
    must(on != off, "selected trigger is filled")
    must(on != 0, "selected fill is the plate")

    let c0 = zeus.proof_components()
    must(zeus.engine_click_text("Metrics") != 0, "click Metrics")
    zeus.engine_layout(400, 200)
    must(zeus.node_background_rgb(b) == on, "fill moved to Metrics")
    must(zeus.node_background_rgb(a) == off, "Overview lost the fill")
    must(sel.get() == 1, "selection followed the click")
    must(zeus.proof_components() == c0, "no component re-run")

    zeus.engine_key_ev(1001, 0)
    zeus.engine_layout(400, 200)
    let logs = zeus.engine_find_text("Logs")
    must(sel.get() == 2, "arrow moved selection")
    must(zeus.node_background_rgb(logs) == on, "fill followed the arrow")
    fmt.println("tabs indicator ok")
}
