// Selective imports: `import { A, B as C } from "path"` binds exactly the named
// declarations (renaming with `as`), instead of the whole module.
import "std:fmt"
import { Shade, LIMIT, twice as double, Box as Crate } from "../mod/named.loam"

fn main() {
    let shade: Shade = Shade.Blue
    let crate = Crate(width = 3, height = 4)
    let total = double(LIMIT) + crate.width + shade
    fmt.println(total)
}
