// Selective imports: `import { A, B as C } "path"` binds exactly the named
// declarations (renaming with `as`). There is no `export` and no `from`.
import "std:fmt"
import { Shade, LIMIT, twice as double, Box as Crate } "../mod/named.loam"

fn main() {
    let shade: Shade = Shade.Blue
    let crate = Crate(width = 3, height = 4)
    let total = double(LIMIT) + crate.width + shade
    fmt.println(total)
}
