import "std:fmt"

// An `if` expression whose arm ends in another `if` expression.
fn main() {
    let a = 1
    let b = 2
    let n = if a > 0 { if b > 5 { 10 } else { 20 } } else { 30 }
    fmt.println(n)
    let m = if a > 5 { 1 } else { if b > 1 { 2 } else { 3 } }
    fmt.println(m)
    let x = 7
    let y = 8
    let p = if a > 0 { if b > 1 { &x } else { &y } } else { &y }
    fmt.println(*p)
}
