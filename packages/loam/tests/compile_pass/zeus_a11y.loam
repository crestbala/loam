// Phase 18: the visible semantic tree serializes for an accessibility mirror
// (§2.3). Widgets already set a11y_role / a11y_label; this pins the data the
// web host relays to a visually-hidden DOM and native hosts to NSAccessibility.

import "std:fmt"
import "std:sys"
import "std:zeus"
import "std:zui"

fn must(ok: bool, what: string) {
    if !ok {
        fmt.println("FAIL", what)
        sys.exit(1)
    }
}

fn has(hay: string, needle: string) -> int {
    if needle.len == 0 {
        return 1
    }
    if hay.len < needle.len {
        return 0
    }
    let last = hay.len - needle.len
    let mut i = 0
    while i <= last {
        let mut ok = 1
        let mut j = 0
        while j < needle.len {
            if hay[i + j] != needle[j] {
                ok = 0
            }
            j = j + 1
        }
        if ok == 1 {
            return 1
        }
        i = i + 1
    }
    return 0
}

fn main() {
    zeus.snapshot(320, 200, fn() -> Node {
        zeus.Box(align_direction = DIRECTION.Column) {
            zeus.Text("hello world")
            zui.Button(label = "Save")
        }
    })
    let dump = zeus.engine_a11y_dump()
    must(has(dump, "button\tSave") == 1, "button role + label")
    must(has(dump, "text\thello world") == 1, "text content")
    fmt.println("a11y ok")
}
