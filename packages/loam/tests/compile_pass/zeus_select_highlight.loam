// Select's keyboard highlight is the raised fill on the active row. Opening
// lands it on the first row at once; an arrow moves it to the next row in
// the same frame; a reopen lands on the first row again.

import "std:fmt"
import "std:sys"
import "std:zeus"
import "std:zui"

fn must(ok: bool, what: string) {
    if !ok {
        fmt.println("FAIL", what)
        sys.exit(1)
    }
}

// The menu row for `label` (the trigger keeps its own text copies, so match
// the labelled row box rather than the text).
fn row(label: string) -> int {
    for id in 1..zeus.arena_nodes() {
        if zeus.node_kind(id) == 1 && zeus.node_label(id) == label {
            return id
        }
    }
    return 0
}

fn layout() {
    zeus.engine_layout(360, 420)
}

fn main() {
    zeus.window("select highlight", 360, 420)
    let value = zeus.signal(2)
    zeus.root(zui.Page() {
        zui.Select(value, []string { "Small", "Medium", "Large" })
    })
    zeus.pump_frame()
    layout()

    zeus.engine_click_text("Large")
    zeus.engine_mouseup()
    layout()
    let small = row("Small")
    let medium = row("Medium")
    must(small > 0 && medium > 0, "menu rows found")
    let on = zeus.node_background_rgb(small)
    let off = zeus.node_background_rgb(medium)
    must(on != off, "opening fills the first row")
    must(on != 0, "the fill is the raised plate")

    zeus.engine_key_ev(1003, 0)
    layout()
    must(zeus.node_background_rgb(medium) == on, "down fills the next row")
    must(zeus.node_background_rgb(small) == off, "the first row lost the fill")

    zeus.engine_key_ev(27, 0)
    layout()
    zeus.engine_click_text("Large")
    zeus.engine_mouseup()
    layout()
    must(zeus.node_background_rgb(small) == on, "reopening fills the first row")
    must(zeus.node_background_rgb(medium) == off, "reopening clears the next row")

    fmt.println("select highlight ok")
}
