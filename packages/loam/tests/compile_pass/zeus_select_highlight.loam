// Select's keyboard highlight is one sliding fill under the rows. Opening
// lands it on the first row at once; an arrow tweens it to the next row; a
// reopen lands on the first row again instead of sliding from the old spot.

import "std:fmt"
import "std:sys"
import "std:zeus"
import "std:zui"

fn must(ok: bool, what: string) {
    if !ok {
        fmt.println("FAIL", what)
        sys.exit(1)
    }
}

// The menu row for `label` (the trigger keeps its own text copies, so match
// the labelled row box rather than the text).
fn row(label: string) -> int {
    for id in 1..zeus.arena_nodes() {
        if zeus.node_kind(id) == 1 && zeus.node_label(id) == label {
            return id
        }
    }
    return 0
}

fn layout() {
    zeus.engine_layout(360, 420)
}

fn settle() {
    for _ in 0..30 {
        zeus.engine_step()
    }
    layout()
}

fn main() {
    zeus.window("select highlight", 360, 420)
    let value = zeus.signal(2)
    zeus.root(zui.Page() {
        zui.Select(value, []string { "Small", "Medium", "Large" })
    })
    zeus.pump_frame()
    layout()

    zeus.engine_click_text("Large")
    zeus.engine_mouseup()
    layout()
    let small = row("Small")
    let medium = row("Medium")
    // The highlight is the menu's first child, built just before the rows.
    let hl = small - 1
    must(small > 0 && medium > 0, "menu rows found")
    must(zeus.node_parent(hl) == zeus.node_parent(small), "highlight sits in the menu")
    must(zeus.node_y(hl) == zeus.node_y(small), "opening lands on the first row")
    must(zeus.node_height(hl) == zeus.node_height(small), "highlight is one row tall")

    // Down tweens: part-way after one frame, on the row once settled.
    zeus.engine_key_ev(1003, 0)
    zeus.engine_step()
    layout()
    let mid = zeus.node_y(hl)
    must(mid > zeus.node_y(small) && mid < zeus.node_y(medium), "down slides the highlight")
    settle()
    must(zeus.node_y(hl) == zeus.node_y(medium), "highlight settles on the next row")

    // Close, reopen: back on the first row without a slide.
    zeus.engine_key_ev(27, 0)
    layout()
    zeus.engine_click_text("Large")
    zeus.engine_mouseup()
    layout()
    must(zeus.node_y(hl) == zeus.node_y(small), "reopening lands on the first row")

    fmt.println("select highlight ok")
}
