// Phase 4 + 5: a paint-only property write marks exactly the node it wrote and
// skips layout; a layout property write re-solves a subtree when the box is
// size-stable, and the whole tree when it is not.

import "std:fmt"
import "std:sys"
import "std:zeus"

fn must(ok: bool, what: string) {
    if ok {
        return
    }
    fmt.println("FAIL", what)
    sys.exit(1)
}

fn main() {
    zeus.window("invalidation", 240, 160)
    let op = zeus.signal(100)
    let wd = zeus.signal(50)
    let mut box_id = 0
    zeus.root(zeus.Box(padding = 10) {
        let b = zeus.Box(width = 50, height = 20, background = "#ff0000")
        box_id = b.id
        zeus.styled(b, || { zeus.set_prop_int(b, zeus.SET.Opacity, op.get()) })
        zeus.styled(b, || { zeus.set_prop_int(b, zeus.SET.Width, wd.get()) })
    })
    zeus.pump_frame()
    must(zeus.damage_full() == 1, "a layout frame damages the whole surface")

    // Paint-only: opacity. The frame must not relayout, and must damage exactly
    // the node the property landed on.
    op.set(50)
    zeus.engine_layout(240, 160)
    must(zeus.damage_full() == 0, "a paint-only prop write is not a full repaint")
    zeus.engine_paint()
    must(zeus.damage_full() == 0, "paint stays local")
    must(zeus.damage_count() >= 1, "the written node contributed damage")
    must(zeus.node_width(box_id) == 50, "opacity left the width alone")

    // Layout: width. The box is explicit, so a width write re-solves its own
    // subtree (phase 5) and damages only it.
    wd.set(80)
    zeus.engine_layout(240, 160)
    must(zeus.layout_was_full() == 0, "a width write on a size-stable box re-solves a subtree")
    must(zeus.node_width(box_id) == 80, "the width landed")
    zeus.engine_paint()
    must(zeus.damage_full() == 0, "the subtree re-solve damages locally")

    // Paint-only again after a layout frame is still local.
    op.set(20)
    zeus.engine_layout(240, 160)
    must(zeus.damage_full() == 0, "paint-only again after a layout frame")
    zeus.engine_paint()
    must(zeus.damage_count() >= 1, "and it damages the node")

    fmt.println("invalidation ok")
}
