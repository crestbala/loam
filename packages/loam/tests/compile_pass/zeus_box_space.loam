// Box / Component: per-edge padding and margin take Space.* steps, and
// `gap` is the space between children on the main axis (row → x, column → y).
import "std:fmt"
import "std:sys"
import "std:zeus"
import "std:colors"
import "std:zui"

fn must(ok: bool, what: string) {
    if !ok {
        fmt.println("FAIL", what)
        sys.exit(1)
    }
}

fn main() {
    zeus.window("box-space", 480, 360)
    let mut pad_host = 0
    let mut pad_kid = 0
    let mut cas_host = 0
    let mut cas_kid = 0
    let mut mar_host = 0
    let mut mar_kid = 0
    let mut row_a = 0
    let mut row_b = 0
    let mut col_a = 0
    let mut col_b = 0
    let mut axis_a = 0
    let mut axis_b = 0
    let mut comp_host = 0
    let mut comp_kid = 0
    let tree = zeus.Box(style = Style(direction = zeus.Direction.Column)) {
        let host = zeus.Box(style = Style(width = px(200),
                                          height = px(80),
                                          padding = Edges(top = zeus.Space.Sm, left = zeus.Space.Xs))) {
            let kid = zeus.Box(style = Style(width = px(10), height = px(10)))
            pad_kid = kid.id
        }
        pad_host = host.id
        let ch = zeus.Box(style = Style(width = px(80),
                                        height = px(40),
                                        padding = Edges(top = zeus.Space.Exs, right = zeus.Space.Md, bottom = zeus.Space.Md, left = zeus.Space.Md))) {
            let kid = zeus.Box(style = Style(width = px(4), height = px(4)))
            cas_kid = kid.id
        }
        cas_host = ch.id
        let mh = zeus.Box(style = Style(width = px(200), height = px(40))) {
            let kid = zeus.Box(style = Style(width = px(10), height = px(10), margin = Edges(left = zeus.Space.Sm)))
            mar_kid = kid.id
        }
        mar_host = mh.id
        zeus.Box(style = Style(height = px(20), direction = zeus.Direction.Row, gap = zeus.Space.Sm)) {
            let a = zeus.Box(style = Style(width = px(20), height = px(10)))
            let b = zeus.Box(style = Style(width = px(20), height = px(10)))
            row_a = a.id
            row_b = b.id
        }
        zeus.Box(style = Style(width = px(40), direction = zeus.Direction.Column, gap = zeus.Space.Xs)) {
            let a = zeus.Box(style = Style(width = px(10), height = px(10)))
            let b = zeus.Box(style = Style(width = px(10), height = px(10)))
            col_a = a.id
            col_b = b.id
        }
        zeus.Box(style = Style(width = px(40),
                               direction = zeus.Direction.Column,
                               gap = zeus.Space.Xs,
                               rowGap = zeus.Space.Lg)) {
            let a = zeus.Box(style = Style(width = px(10), height = px(10)))
            let b = zeus.Box(style = Style(width = px(10), height = px(10)))
            axis_a = a.id
            axis_b = b.id
        }
        let cp = zui.Comp(style = Style(width = px(80), height = px(30), padding = Edges(left = zeus.Space.Sm))) {
            let kid = zeus.Box(style = Style(width = px(8), height = px(8)))
            comp_kid = kid.id
        }
        comp_host = cp.id
    }
    zeus.root(tree)
    zeus.pump_frame()

    must(zeus.node_x(pad_kid) - zeus.node_x(pad_host) == zeus.Space.Xs,
         "padding_left = SPACE.Xs")
    must(zeus.node_y(pad_kid) - zeus.node_y(pad_host) == zeus.Space.Sm,
         "padding_top = SPACE.Sm")
    must(zeus.node_x(cas_kid) - zeus.node_x(cas_host) == zeus.Space.Md,
         "padding shorthand sets left")
    must(zeus.node_y(cas_kid) - zeus.node_y(cas_host) == zeus.Space.Exs,
         "padding_top overrides the shorthand")
    must(zeus.node_x(mar_kid) - zeus.node_x(mar_host) == zeus.Space.Sm,
         "margin_left = SPACE.Sm")
    must(zeus.node_x(row_b) - zeus.node_x(row_a) == 20 + zeus.Space.Sm,
         "row gap is horizontal")
    must(zeus.node_y(col_b) - zeus.node_y(col_a) == 10 + zeus.Space.Xs,
         "column gap is vertical")
    must(zeus.node_y(axis_b) - zeus.node_y(axis_a) == 10 + zeus.Space.Lg,
         "gap_row overrides column gap")
    must(zeus.node_x(comp_kid) - zeus.node_x(comp_host) == zeus.Space.Sm,
         "Comp forwards padding_left")

    fmt.println("box-space ok")
}