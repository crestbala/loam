// A borrow of an indexed place (`ITEMS[root].children`) passed next to an
// argument that grows the same vec: the address is taken after the other
// arguments, so the reallocation cannot leave it dangling.
import "std:fmt"

struct Item {
    children: []int,
    value: int,
}

let mut ITEMS: []Item = []Item {}

fn new_item(value: int) -> int {
    push(ITEMS, Item { children: []int {}, value: value })
    return ITEMS.len - 1
}

fn append_child(children: &mut []int, child: int) {
    push(children, child)
}

fn main() {
    let root = new_item(0)
    for i in 0..3000 {
        push(ITEMS[root].children, new_item(i))
        append_child(&mut ITEMS[root].children, new_item(i))
    }
    ITEMS[root].value = new_item(7)
    fmt.println(ITEMS[root].children.len)
    fmt.println(ITEMS[root].value)
    fmt.println(ITEMS.len)
}
