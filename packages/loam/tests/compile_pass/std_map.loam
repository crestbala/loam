// `std:map` with int and string keys, and in-place mutation of a map value
// through its slot.
import "std:fmt"
import "std:map"

fn main() {
    let mut m = map.new(0 - 1)
    for i in 0..1000 { map.put(&mut m, map.key_int(i * 7 - 300), i) }
    fmt.println(
        m.len,
        map.get(&mut m, map.key_int(7 * 500 - 300)),
        map.get(&mut m, map.key_int(1)),
        map.has(&mut m, map.key_int(-300)),
    )
    for i in 0..500 { map.remove(&mut m, map.key_int(i * 7 - 300)) }
    fmt.println(m.len, map.get(&mut m, map.key_int(-300)), map.get(&mut m, map.key_int(999 * 7 - 300)))

    let mut lists = map.new([]int {})
    map.put(&mut lists, map.key_int(4), []int {})
    let s = map.find(&mut lists, map.key_int(4))
    push(lists.entries[s].value, 10)
    push(lists.entries[s].value, 20)
    fmt.println(map.get(&mut lists, map.key_int(4)).len)

    let mut sm = map.new([]int {})
    map.put(&mut sm, map.key_str("a"), []int { 1, 2 })
    let t = map.find(&mut sm, map.key_str("a"))
    push(sm.entries[t].value, 3)
    fmt.println(map.get(&mut sm, map.key_str("a")).len)
}
