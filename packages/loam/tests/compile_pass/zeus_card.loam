// Card slots (header / footer / media), the interactive variant (pointer
// target, hover lift on the paint track, press), and slot redirection: the
// trailing block lands between header and footer.
import "std:fmt"
import "std:sys"
import "std:zeus"
import "std:colors"
import "std:colors"
import "std:zui"

fn must(ok: bool, what: string) {
    if !ok {
        fmt.println("FAIL", what)
        sys.exit(1)
    }
}

fn main() {
    zeus.window("card", 480, 400)
    let clicks = zeus.signal(0)
    zeus.root(zui.Column(12) {
        zui.Card(title = "Plan", subtitle = "Monthly", footer = fn() {
            zeus.Text("Footer", color = colors.mute())
        }) {
            zeus.Text("Body")
        }
        zui.Card(interactive = true, on_click = fn() => clicks.set(clicks.get() + 1)) {
            zeus.Text("Tap")
        }
        zui.Card(media = "x.png") {
            zeus.Text("Under media")
        }
    })
    zeus.pump_frame()

    // Order inside the first card: heading, body column, separator, footer.
    let title = zeus.engine_find_text("Plan")
    let body = zeus.engine_find_text("Body")
    let foot = zeus.engine_find_text("Footer")
    must(title > 0 && body > 0 && foot > 0, "slots built")
    must(zeus.node_y(title) < zeus.node_y(body), "header above body")
    must(zeus.node_y(body) < zeus.node_y(foot), "body above footer")
    must(zeus.engine_find_role("contentinfo") != 0, "footer role")
    must(zeus.engine_find_role("heading") != 0, "header role")
    let shell = zeus.node_parent(zeus.node_parent(body))
    must(zeus.node_parent(zeus.engine_find_role("contentinfo")) == shell, "footer in the shell")

    // Interactive: role button, click fires, hover starts a track with no
    // component re-run.
    let tap = zeus.engine_find_text("Tap")
    let card = zeus.node_parent(tap)
    must(zeus.engine_click_text("Tap") != 0, "card hit")
    must(clicks.get() == 1, "card on_click")
    zeus.engine_mouseup()
    let c0 = zeus.proof_components()
    zeus.engine_hover(zeus.node_x(card) + 4, zeus.node_y(card) + 4)
    zeus.engine_layout(480, 400)
    must(zeus.state_hovered(zeus.node_handle(card)), "hovered")
    must(zeus.proof_anim_live() > 0, "lift on a track")
    must(zeus.proof_components() == c0, "no component on hover")

    // Media: an image strip sits above the body and bleeds to the edge.
    let under = zeus.engine_find_text("Under media")
    let strip = zeus.engine_find_role("img")
    must(strip != 0, "media strip")
    must(zeus.node_y(strip) < zeus.node_y(under), "media above body")
    must(zeus.node_x(strip) <= zeus.node_x(zeus.node_parent(under)) + 1, "media bleeds to the edge (inside the border)")
    fmt.println("card ok")
}
