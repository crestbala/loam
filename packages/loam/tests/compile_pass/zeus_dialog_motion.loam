// Dialog motion and sizing: the card springs up into place with the scrim, and
// falls away as it fades. Its width is 92% of a narrow window but capped at 440dp on a
// wide one.
import "std:fmt"
import "std:sys"
import "std:zeus"
import "std:colors"
import "std:zui"

fn must(ok: bool, what: string) {
    if !ok {
        fmt.println("FAIL", what)
        sys.exit(1)
    }
}

fn settle(w: int, h: int) {
    let mut i = 0
    while i < 30 {
        zeus.engine_layout(w, h)
        zeus.engine_step_dt(16)
        zeus.engine_paint()
        i = i + 1
    }
}

fn main() {
    zeus.window("dialog", 800, 600)
    let open = zeus.signal(false)
    zeus.root(zeus.Box(style = Style(padding = 16)) {
        zui.Button("Open", on_click = fn() => open.set(true))
        zui.Dialog(open, title = "Confirm") {
            zeus.Text("Inside")
        }
    })
    zeus.pump_frame()
    zeus.engine_layout(800, 600)

    // Open: the card starts small and low, on tracks. No component re-run.
    let c0 = zeus.proof_components()
    must(zeus.engine_click_text("Open") != 0, "open")
    zeus.engine_layout(800, 600)
    let panel = zeus.engine_find_role("dialog")
    must(panel != 0, "dialog shown")
    must(zeus.proof_anim_live() > 0, "motion on tracks")
    zeus.engine_paint()
    must(zeus.motion_scale(zeus.node_handle(panel)) < 100, "starts under full size")
    must(zeus.motion_y(zeus.node_handle(panel)) > 0, "starts below its place")
    settle(800, 600)
    must(zeus.motion_scale(zeus.node_handle(panel)) == 100, "settled at 100%")
    must(zeus.motion_y(zeus.node_handle(panel)) == 0, "settled in place")
    must(zeus.proof_components() == c0, "no component re-run")
    must(zeus.node_width(panel) == 440, "desktop width capped at 440")

    // Narrow window: 92% of the width.
    settle(320, 600)
    must(zeus.node_width(panel) == 320 * 92 / 100, "phone width is 92%")

    // Close: falls away, under full size.
    zeus.engine_key(27)
    zeus.engine_layout(320, 600)
    must(!open.get(), "escape closed")
    settle(320, 600)
    must(zeus.motion_scale(zeus.node_handle(panel)) < 100, "left under full size")
    must(zeus.motion_y(zeus.node_handle(panel)) > 0, "left below its place")
    fmt.println("dialog motion ok")
}
