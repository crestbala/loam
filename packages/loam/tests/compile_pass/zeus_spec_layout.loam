// Flexbox and grid through the declarative surface: one container, `Box`,
// with `align_direction`, and `Grid` taking a `GridConfig` struct.
import "std:fmt"
import "std:sys"
import "std:zeus"
import "std:zui"

fn DashboardLayout() -> Node {
    return Column(0) {
        zeus.Box(style = Style(direction = Direction.Row, gap = 16, align = Align.Center)) {
            zeus.Box(style = Style(grow = 1, padding = edges(12), background = "#313244")) {
                zeus.Text("Flexible Left Panel")
            }
            zeus.Box(style = Style(width = px(150), padding = edges(12), background = "#45475a")) {
                zeus.Text("Fixed Right Panel (150px)")
            }
        }
    
        zui.Grid(config = GridConfig(columns = 3, gap = 12, padding = 16)) {
            zeus.Box(style = Style(height = px(100), background = "#89b4fa")) { zeus.Text("Card 1") }
            zeus.Box(style = Style(height = px(100), background = "#a6e3a1")) { zeus.Text("Card 2") }
            zeus.Box(style = Style(height = px(100), background = "#f9e2af")) { zeus.Text("Card 3") }
        }
    }
}

fn main() {
    zeus.snapshot(640, 480, fn() -> Node {
        zeus.Box(style = Style(direction = Direction.Column)) {
            DashboardLayout()
        }
    })
    if zeus.draw_count() < 8 {
        fmt.println("FAIL layout")
        sys.exit(1)
    }
    fmt.println("layout ok")
}
