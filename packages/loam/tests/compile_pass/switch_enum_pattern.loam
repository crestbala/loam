// Case patterns accept `Enum.Member`, not just bare literals — switching on
// raw 0/1/2 would lose the names the enum exists to provide. Alternatives
// (`case A, B:`) and `default:` work the same as with literals.
import "std:fmt"
import "std:sys"

enum Look {
    Solid = 0,
    Soft = 1,
    Outline = 2,
    Ghost = 3,
}

fn name_of(look: int) -> string {
    switch look {
        case Look.Solid:
            return "solid"
        case Look.Soft, Look.Outline:
            return "layered"
        default:
            return "bare"
    }
}

fn check(got: string, want: string) {
    if !fmt.eq(got, want) {
        fmt.println("FAIL got", got, "want", want)
        sys.exit(1)
    }
}

fn main() {
    check(name_of(Look.Solid), "solid")
    check(name_of(Look.Soft), "layered")
    check(name_of(Look.Outline), "layered")
    check(name_of(Look.Ghost), "bare")
    check(name_of(99), "bare")
    fmt.println("match enum pattern ok")
}
