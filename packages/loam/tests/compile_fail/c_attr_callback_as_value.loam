// Called through a fn value, the callback argument would arrive as a
// `loam_fn` trampoline, which C cannot call: such a binding is only called
// directly.
#[c("qsort")]
fn c_qsort(base: []i32, n: i64, size: i64, compare: fn(i64, i64) -> i32) {}

fn same(a: i64, b: i64) -> i32 {
    return 0
}

fn main() {
    let sort = c_qsort
    sort([]i32 { 2, 1 }, 2, 4, same)
}
