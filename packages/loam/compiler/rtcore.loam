// rtcore — the C every generated unit starts with: the includes (a wasm
// unit's few libc declarations among them), the value layouts, panics,
// allocation, strings, and vec reserve and drop. It used to be a header file
// (`loam_rt.h`) the compiler read at run time; it is part of the compiler now
// (docs/runtime-in-loam.md, R6.6e), so no runtime directory ships. What a
// program calls beyond this core, codegen defines after it, only when called.
//
// `nob trusted` counts these lines as emitted C, with codegen's templates.

import "std:buf"

let mut CORE: []u8 = []u8 {}

fn w(s: string) {
    buf.push_str(&mut CORE, s)
}

/** *The core's C, built on first use. Typecheck reads it too: user C names */
/** *must avoid every `loam_*` name in it. */
fn core_c() -> string {
    if CORE.len == 0 {
        core_def()
    }
    return buf.to_string(&CORE)
}

fn core_def() {
    w("/* The core every unit starts with (codegen's `rtcore.loam`): panics,\n")
    w("   allocation, strings and vecs. What a program calls beyond it is defined\n")
    w("   after it, only when called (`int_helper_defs`, `core_op_defs`,\n")
    w("   `rt_verb_defs`, `vec_push_defs`, `vec_pop_defs`). */\n")
    w("#include <stdint.h>\n")
    w("#include <stddef.h>\n")
    w("#include <stdbool.h>\n")
    w("#include <limits.h>\n")
    w("#ifdef __wasm32__\n")
    w("/* wasm has no libc: clang's freestanding headers above, and these, which the\n")
    w("   unit defines itself (codegen's `wasm_libc_defs`). `memcpy`, `memmove` and\n")
    w("   `memset` are bulk-memory instructions, not calls. */\n")
    w("typedef long ssize_t;\n")
    w("#define STDOUT_FILENO 1\n")
    w("#define STDERR_FILENO 2\n")
    w("#define EINTR 4\n")
    w("extern int errno;\n")
    w("void *malloc(size_t n);\n")
    w("void *realloc(void *p, size_t n);\n")
    w("void free(void *p);\n")
    w("__attribute__((noreturn)) void abort(void);\n")
    w("int memcmp(const void *a, const void *b, size_t n);\n")
    w("size_t strlen(const char *s);\n")
    w("ssize_t write(int fd, const void *p, size_t n);\n")
    w("#define memcpy __builtin_memcpy\n")
    w("#define memmove __builtin_memmove\n")
    w("#define memset __builtin_memset\n")
    w("#else\n")
    w("#include <stdio.h>\n")
    w("#include <stdlib.h>\n")
    w("#include <unistd.h>\n")
    w("#include <errno.h>\n")
    w("#include <string.h>\n")
    w("#ifdef _WIN32\n")
    w("/* Windows host shim (MinGW-w64 / clang targeting *-windows-gnu). The runtime\n")
    w("   is written against POSIX; this block supplies the few pieces Windows lacks\n")
    w("   so the same CLI surface builds there. `/` works as a separator in every\n")
    w("   Win32 file API, so paths stay `/` on the Loam side. */\n")
    w("#include <io.h>\n")
    w("#include <direct.h>\n")
    w("#include <process.h>\n")
    w("#define lstat stat\n")
    w("#endif\n")
    w("#include <time.h>\n")
    w("#include <setjmp.h>\n")
    w("#endif\n")
    w("/* Recoverable traps. A panic that would abort instead winds the stack back to\n")
    w("   the innermost arm installed through `loam_panic_arm` (`std:panic`), and\n")
    w("   `loam_panic_message` reads why.\n")
    w("\n")
    w("   Exactly one translation unit defines the storage: the program's own (a\n")
    w("   shard build's `LOAM_SHARD_DEFS` unit), where `LOAM_RT_DEFINE_JMP` is set.\n")
    w("   On wasm there is no setjmp, so only the message exists: a panic records\n")
    w("   it and traps, the host (the web loader) catches the trap at the export\n")
    w("   boundary and asks the program to recover (`zeus_recover`), which reads it\n")
    w("   back. An arm leaves the state NULL, so a trap with no guard still aborts. */\n")
    w("#ifndef __wasm32__\n")
    w("typedef struct LoamJmp {\n")
    w("    jmp_buf jb;\n")
    w("    struct LoamJmp *prev;\n")
    w("} LoamJmp;\n")
    w("#endif\n")
    w("#ifdef LOAM_RT_DEFINE_JMP\n")
    w("#ifndef __wasm32__\n")
    w("LoamJmp *loam_jmp_top = NULL;\n")
    w("#endif\n")
    w("char loam_jmp_msg[512];\n")
    w("void loam_jmp_set_msg(const char *msg, int64_t len) {\n")
    w("    int64_t n = len;\n")
    w("    if (!msg) n = 0;\n")
    w("    if (n < 0) n = 0;\n")
    w("    if (n > (int64_t)sizeof(loam_jmp_msg) - 1) n = (int64_t)sizeof(loam_jmp_msg) - 1;\n")
    w("    if (n > 0) memcpy(loam_jmp_msg, msg, (size_t)n);\n")
    w("    loam_jmp_msg[n] = 0;\n")
    w("}\n")
    w("#else\n")
    w("#ifndef __wasm32__\n")
    w("extern LoamJmp *loam_jmp_top;\n")
    w("#endif\n")
    w("extern char loam_jmp_msg[512];\n")
    w("void loam_jmp_set_msg(const char *msg, int64_t len);\n")
    w("#endif\n")
    w("\n")
    w("/* The rest of the runtime's process-wide state (the command line, the last\n")
    w("   `sys.exec` status, the spawn, future and channel tables) has one definition\n")
    w("   too, in the same unit as the trap state. A shard build compiles the program\n")
    w("   as many translation units, and each would otherwise get its own copy of a\n")
    w("   `static`: `sys.arg(0)` read \"\" outside the unit holding `main`, and a spawn\n")
    w("   handle or a future made in one unit did not exist in the next.\n")
    w("   `LOAM_RT_STATE` declares, and `LOAM_RT_INIT(v)` gives the initial value only\n")
    w("   where the storage is defined. */\n")
    w("#ifdef LOAM_RT_DEFINE_JMP\n")
    w("#define LOAM_RT_STATE\n")
    w("#define LOAM_RT_INIT(...) = __VA_ARGS__\n")
    w("#else\n")
    w("#define LOAM_RT_STATE extern\n")
    w("#define LOAM_RT_INIT(...)\n")
    w("#endif\n")
    w("\n")
    w("typedef struct {\n")
    w("    const char *ptr;\n")
    w("    int64_t len;\n")
    w("    /* 1 when `ptr` is a heap buffer this value owns and must release; 0 when\n")
    w("       `ptr` aliases static storage (a literal), where release is a no-op.\n")
    w("       Every compound literal in the tree omits this field and so defaults to\n")
    w("       0, which is exactly the old (never-freed) behavior. Kept as a field\n")
    w("       rather than a header before `ptr` so `loam_str_release` never reads\n")
    w("       memory it does not own. */\n")
    w("    int64_t own;\n")
    w("} loam_str;\n")
    w("\n")
    w("typedef struct {\n")
    w("    void *fn;\n")
    w("    void *env;\n")
    w("    /* Byte size of `env` when it is a closure heap/stack record. intern_fn\n")
    w("       memcpy's this so the handler outlives the value that was interned. */\n")
    w("    size_t env_size;\n")
    w("} loam_fn;\n")
    w("\n")
    w("typedef struct {\n")
    w("    void *ptr;\n")
    w("    int64_t len;\n")
    w("    int64_t cap;\n")
    w("} loam_vec;\n")
    w("/* The two layouts `loam_abi.h` gives host C (it skips its own copy when\n")
    w("   both are in one unit, as in the `host_contract` check). */\n")
    w("#define LOAM_ABI_TYPES 1\n")
    w("\n")
    w("/* Length-based writes to a descriptor. No malloc, no printf, no NUL\n")
    w("   requirement. Stdout is `fmt.println`; stderr is `fmt.eprintln`. */\n")
    w("static inline void loam_write_fd(int fd, const char *p, size_t n) {\n")
    w("    while (n) {\n")
    w("        ssize_t w = write(fd, p, n);\n")
    w("        if (w < 0) {\n")
    w("            if (errno == EINTR) continue;\n")
    w("            return;\n")
    w("        }\n")
    w("        if (w == 0) return;\n")
    w("        p += (size_t)w;\n")
    w("        n -= (size_t)w;\n")
    w("    }\n")
    w("}\n")
    w("\n")
    w("static inline void loam_write_bytes(const char *p, size_t n) { loam_write_fd(STDOUT_FILENO, p, n); }\n")
    w("static inline void loam_ewrite_bytes(const char *p, size_t n) { loam_write_fd(STDERR_FILENO, p, n); }\n")
    w("\n")
    w("/* Panics never return; out of line, a check is just a compare and branch. */\n")
    w("#if defined(__GNUC__) || defined(__clang__)\n")
    w("#define LOAM_COLD __attribute__((noinline, noreturn, unused))\n")
    w("#else\n")
    w("#define LOAM_COLD\n")
    w("#endif\n")
    w("\n")
    w("/* The panic path is Loam (`std:panic`: flush, print, unwind or abort).\n")
    w("   These hand it C's strings as views; the hooks below are what it cannot\n")
    w("   do itself. */\n")
    w("void loam_panic_report(loam_str file, int32_t line, loam_str msg);\n")
    w("void loam_panic_trap(loam_str msg);\n")
    w("static inline loam_str loam_panic_view(const char *s) {\n")
    w("    loam_str v = {s ? s : \"\", s ? (int64_t)strlen(s) : 0, 0};\n")
    w("    return v;\n")
    w("}\n")
    w("\n")
    w("static LOAM_COLD void loam_panic(const char *file, int line, const char *msg) {\n")
    w("    loam_panic_report(loam_panic_view(file), line, loam_panic_view(msg));\n")
    w("    abort();\n")
    w("}\n")
    w("\n")
    w("/* `panic(msg)`: the message is a Loam string. */\n")
    w("static LOAM_COLD void loam_panic_str(const char *file, int line, loam_str msg) {\n")
    w("    loam_panic_report(loam_panic_view(file), line, msg);\n")
    w("    abort();\n")
    w("}\n")
    w("\n")
    w("static inline void loam_panic_record(loam_str msg) { loam_jmp_set_msg(msg.ptr, msg.len); }\n")
    w("#ifndef __wasm32__\n")
    w("static inline void loam_panic_unwind(void) { if (loam_jmp_top) longjmp(loam_jmp_top->jb, 1); }\n")
    w("#else\n")
    w("static inline void loam_panic_unwind(void) {}\n")
    w("static inline void loam_panic_wasm_abort(void) { abort(); }\n")
    w("#endif\n")
    w("\n")
    w("/* A web release has thousands of checked operations, and a file and line for\n")
    w("   each one's panic path came to a tenth of the download. They all share this\n")
    w("   instead, and the panic keeps its message. */\n")
    w("#ifdef LOAM_NO_TRAP_LOC\n")
    w("__attribute__((noinline, noreturn, cold)) static void loam_trap(const char *msg) {\n")
    w("    loam_panic_trap(loam_panic_view(msg));\n")
    w("    abort();\n")
    w("}\n")
    w("#define loam_panic(f, l, msg) loam_trap(msg)\n")
    w("#endif\n")
    w("\n")
    w("/* Checked, wrapping and saturating integer ops, narrowing conversions and the\n")
    w("   bounds check are not here: codegen defines each one a program calls, right\n")
    w("   after this core (`int_helper_defs`). */\n")
    w("\n")
    w("/* Allocation accounting for the animation proof harness. Only a Zeus program\n")
    w("   turns this on (`-DLOAM_ALLOC_TRACE`): `loam_alloc_note` counts, and\n")
    w("   `sys.alloc_count` reads it back. Every other program keeps the no-op. The\n")
    w("   unit that owns the trap state owns the counter (`LOAM_RT_DEFINE_ALLOC`). */\n")
    w("#ifdef LOAM_ALLOC_TRACE\n")
    w("#ifdef LOAM_RT_DEFINE_ALLOC\n")
    w("int64_t loam_alloc_count = 0;\n")
    w("#else\n")
    w("extern int64_t loam_alloc_count;\n")
    w("#endif\n")
    w("static inline void loam_alloc_note(size_t sz) {\n")
    w("    (void)sz;\n")
    w("    loam_alloc_count++;\n")
    w("}\n")
    w("#else\n")
    w("static inline void loam_alloc_note(size_t sz) { (void)sz; }\n")
    w("#endif\n")
    w("\n")
    w("static inline void *loam_new(size_t sz, const char *f, int l) {\n")
    w("    void *p = malloc(sz ? sz : 1);\n")
    w("    if (!p) loam_panic(f, l, \"out of memory\");\n")
    w("    loam_alloc_note(sz);\n")
    w("    return p;\n")
    w("}\n")
    w("\n")
    w("/* --- owned strings ------------------------------------------------------\n")
    w("   A heap `loam_str` carries an int64 refcount in the word before `ptr` and is\n")
    w("   freed when the last reference goes away. `own` marks a value that holds that\n")
    w("   header; a literal leaves it 0 and is immortal, so retain/release are no-ops\n")
    w("   and no header is ever read for static storage. Sharing is a counter bump,\n")
    w("   never a byte copy, so a `Signal<string>` read costs one atomic increment —\n")
    w("   the same deal `[]T` gets — and the user never writes `.clone()`. The counter\n")
    w("   is atomic because a string is still a Send payload: it may move to a worker,\n")
    w("   and whichever reference is freed last releases the buffer. */\n")
    w("static inline int64_t *loam_str_rc(const char *ptr) {\n")
    w("    return ptr ? ((int64_t *)ptr - 1) : NULL;\n")
    w("}\n")
    w("\n")
    w("/** Heap bytes for `n` characters, refcount 1, trailing NUL. */\n")
    w("static inline char *loam_str_bytes(int64_t n) {\n")
    w("    int64_t m = n > 0 ? n : 0;\n")
    w("    int64_t *blk = (int64_t *)loam_new(sizeof(int64_t) + (size_t)m + 1, \"str\", 0);\n")
    w("    blk[0] = 1;\n")
    w("    return (char *)(blk + 1);\n")
    w("}\n")
    w("\n")
    w("/* `.len` is a Loam `int` (i32), so no string or vec may hold more. */\n")
    w("#define LOAM_LEN_MAX INT32_MAX\n")
    w("\n")
    w("static inline loam_str loam_str_owned(char *p, int64_t n) {\n")
    w("    if (n > LOAM_LEN_MAX) loam_panic(\"string\", 0, \"longer than an int can index\");\n")
    w("    loam_str s;\n")
    w("    s.ptr = p;\n")
    w("    s.len = n;\n")
    w("    s.own = 1;\n")
    w("    return s;\n")
    w("}\n")
    w("\n")
    w("/** An owned copy of `n` bytes at `src`. Every runtime fn that hands Loam\n")
    w(" *  bytes it produced goes through here (or `loam_str_bytes`): a bare\n")
    w(" *  `(loam_str){malloc'd, n}` has `own == 0`, so the drop the compiler emits\n")
    w(" *  is a no-op and the buffer leaks. Empty for `n <= 0`. */\n")
    w("static inline loam_str loam_str_copy(const char *src, int64_t n) {\n")
    w("    char *p;\n")
    w("    if (n <= 0 || !src) return (loam_str){\"\", 0, 0};\n")
    w("    p = loam_str_bytes(n);\n")
    w("    memcpy(p, src, (size_t)n);\n")
    w("    p[n] = 0;\n")
    w("    return loam_str_owned(p, n);\n")
    w("}\n")
    w("\n")
    w("/* gcc follows the literal path (`own == 0`) into the refcount update and the\n")
    w("   free after inlining, and warns that it writes before a literal or frees\n")
    w("   one. The `own` test makes that path dead; clang does not warn. Silenced\n")
    w("   here only, for release (codegen's `loam_str_retain` does the same). */\n")
    w("#if defined(__GNUC__) && !defined(__clang__)\n")
    w("#pragma GCC diagnostic push\n")
    w("#pragma GCC diagnostic ignored \"-Wstringop-overflow\"\n")
    w("#pragma GCC diagnostic ignored \"-Wfree-nonheap-object\"\n")
    w("#endif\n")
    w("\n")
    w("/** Drop one reference; the last one frees the buffer. */\n")
    w("static inline void loam_str_release(loam_str *s) {\n")
    w("    if (!s) return;\n")
    w("    if (s->own && s->ptr) {\n")
    w("        if (__atomic_sub_fetch(loam_str_rc(s->ptr), 1, __ATOMIC_ACQ_REL) == 0)\n")
    w("            free(loam_str_rc(s->ptr));\n")
    w("    }\n")
    w("    s->ptr = NULL;\n")
    w("    s->len = 0;\n")
    w("    s->own = 0;\n")
    w("}\n")
    w("#if defined(__GNUC__) && !defined(__clang__)\n")
    w("#pragma GCC diagnostic pop\n")
    w("#endif\n")
    w("\n")
    w("static inline loam_vec loam_vec_new(void) {\n")
    w("    loam_vec v;\n")
    w("    v.ptr = NULL;\n")
    w("    v.len = 0;\n")
    w("    v.cap = 0;\n")
    w("    return v;\n")
    w("}\n")
    w("\n")
    w("static inline int64_t *loam_vec_rc(void *ptr) {\n")
    w("    return ptr ? ((int64_t *)ptr - 1) : NULL;\n")
    w("}\n")
    w("\n")
    w("static inline void loam_vec_unique(loam_vec *v, size_t esz, const char *f, int l) {\n")
    w("    int64_t *rc;\n")
    w("    void *raw;\n")
    w("    size_t bytes;\n")
    w("    if (!v || !v->ptr) return;\n")
    w("    rc = loam_vec_rc(v->ptr);\n")
    w("    if (*rc <= 1) return;\n")
    w("    bytes = sizeof(int64_t) + (esz ? (size_t)v->cap * esz : 1);\n")
    w("    raw = malloc(bytes);\n")
    w("    if (!raw) loam_panic(f, l, \"out of memory\");\n")
    w("    loam_alloc_note(bytes);\n")
    w("    *(int64_t *)raw = 1;\n")
    w("    if (v->len > 0 && esz)\n")
    w("        memcpy((char *)raw + sizeof(int64_t), v->ptr, (size_t)v->len * esz);\n")
    w("    (*rc)--;\n")
    w("    v->ptr = (char *)raw + sizeof(int64_t);\n")
    w("}\n")
    w("\n")
    w("/* The capacity a vec of `cap` slots grows to so it holds `n`. A push that\n")
    w("   overflows a full buffer of 256 KB or more grows it 4x, not 2x: a big\n")
    w("   table (a compiler's AST, a log) is copied about half as many times on its\n")
    w("   way up, and its spare room stays under 3/4 of what it holds. Any other\n")
    w("   request (a first buffer, an exact size, a small vec) doubles up to `n`. */\n")
    w("#define LOAM_VEC_GROW4_BYTES ((int64_t)256 * 1024)\n")
    w("static inline int64_t loam_vec_grown_cap(int64_t cap, int64_t n, size_t esz, const char *f, int l) {\n")
    w("    /* Capacity stops at the limit too: a push into spare room skips this. */\n")
    w("    if (n > LOAM_LEN_MAX) loam_panic(f, l, \"more elements than an int can index\");\n")
    w("    if (cap > 0 && n == cap + 1 && esz && cap >= LOAM_VEC_GROW4_BYTES / (int64_t)esz &&\n")
    w("        cap <= INT64_MAX / 4)\n")
    w("        cap = cap * 4;\n")
    w("    else {\n")
    w("        if (cap <= 0) cap = 8;\n")
    w("        while (cap < n) cap *= 2;\n")
    w("    }\n")
    w("    return cap < LOAM_LEN_MAX ? cap : LOAM_LEN_MAX;\n")
    w("}\n")
    w("\n")
    w("static inline void loam_vec_reserve(loam_vec *v, int64_t n, size_t esz, const char *f, int l) {\n")
    w("    int64_t cap;\n")
    w("    void *raw;\n")
    w("    if (!v) return;\n")
    w("    /* Whoever reserves writes past `len` next, so it must own the buffer even\n")
    w("       when it has room: a copy-on-write sibling with the same spare capacity\n")
    w("       would otherwise see (and overwrite) the same slots. */\n")
    w("    loam_vec_unique(v, esz, f, l);\n")
    w("    if (n <= v->cap) return;\n")
    w("    cap = loam_vec_grown_cap(v->cap, n, esz, f, l);\n")
    w("    if (!v->ptr) {\n")
    w("        raw = malloc(sizeof(int64_t) + (esz ? (size_t)cap * esz : 1));\n")
    w("        if (!raw) loam_panic(f, l, \"out of memory\");\n")
    w("        loam_alloc_note((size_t)cap * esz);\n")
    w("        *(int64_t *)raw = 1;\n")
    w("        v->ptr = (char *)raw + sizeof(int64_t);\n")
    w("        v->cap = cap;\n")
    w("        return;\n")
    w("    }\n")
    w("    raw = realloc((char *)v->ptr - sizeof(int64_t),\n")
    w("                  sizeof(int64_t) + (esz ? (size_t)cap * esz : 1));\n")
    w("    if (!raw) loam_panic(f, l, \"out of memory\");\n")
    w("    loam_alloc_note((size_t)cap * esz);\n")
    w("    v->ptr = (char *)raw + sizeof(int64_t);\n")
    w("    v->cap = cap;\n")
    w("}\n")
    w("\n")
    w("/* Vec push (`loam_vec_push`, `_owned`, `_take`), vec pop (`loam_vec_pop`,\n")
    w("   `_owned`), and the moves, retains and drops of owning values\n")
    w("   (`loam_vec_move`, `loam_vec_retain`, `loam_vec_drop_owned`, `loam_vec_of`,\n")
    w("   `loam_vec_unique_owned`, `loam_vec_reserve_owned`, `loam_move_ptr`,\n")
    w("   `loam_drop`, `loam_str_retain`) are not here: codegen defines each one a\n")
    w("   program calls, right after this core (`vec_push_defs`, `vec_pop_defs`,\n")
    w("   `core_op_defs`). A fn value is copy and never dropped, so it has no move\n")
    w("   or drop. */\n")
    w("\n")
    w("/* --- container element lifetime -----------------------------------------\n")
    w("   A `[]T` buffer owns one reference to each element that itself owns a string.\n")
    w("   So a copy (a bumped refcount) shares the buffer and its element references\n")
    w("   unchanged, a copy-on-write reallocation must retain every element it\n")
    w("   duplicates, and the elements are released exactly once — when the buffer's\n")
    w("   last reference goes, never per handle. The `_owned` variants take the\n")
    w("   element retain/release hook the compiler emits for `T`;\n")
    w("   `loam_vec_drop_owned` is what a shared vec parameter must use, so dropping\n")
    w("   it does not zero slots the caller still reads. */\n")
    w("typedef void (*loam_elem_fn)(void *elem);\n")
    w("\n")
    w("static inline void loam_vec_drop(loam_vec *v) {\n")
    w("    int64_t *rc;\n")
    w("    if (!v) return;\n")
    w("    if (!v->ptr) {\n")
    w("        v->len = 0;\n")
    w("        v->cap = 0;\n")
    w("        return;\n")
    w("    }\n")
    w("    rc = loam_vec_rc(v->ptr);\n")
    w("    if (--(*rc) > 0) {\n")
    w("        v->ptr = NULL;\n")
    w("        v->len = 0;\n")
    w("        v->cap = 0;\n")
    w("        return;\n")
    w("    }\n")
    w("    free(rc);\n")
    w("    v->ptr = NULL;\n")
    w("    v->len = 0;\n")
    w("    v->cap = 0;\n")
    w("}\n")
    w("\n")
    w("\n")
    w("#if !defined(__wasm32__) && !defined(_WIN32)\n")
    w("#include <sys/wait.h>\n")
    w("#endif\n")
    w("#ifndef __wasm32__\n")
    w("#include <sys/stat.h>\n")
    w("#include <dirent.h>\n")
    w("#endif\n")
    w("\n")
    w("/* The fmt writers, `str.slice`, `string_from_bytes`, the `buf` / `decimal` /\n")
    w("   `conv` / `floattext` bridges, `sys`'s argv, read and C shims, the trap arm,\n")
    w("   the allocation count, the wasm clock and async bridges, and threads and\n")
    w("   channels are not here: codegen defines each group a program calls, right\n")
    w("   after this core (`rt_verb_defs`). */\n")
}
