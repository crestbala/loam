// codegen — the IR written out as one gnu99 C translation unit. A port
// of the C compiler's codegen_c.c, which it matched byte for byte.
//
// Layout of the generated file:
//   1. loam_rt.h pasted in, then zeus_rt.h / net_rt.h when those modules
//      are loaded, then the integer helpers, core ops (moves, retains, drops)
//      and vec pushes and pops the unit calls, the runtime verbs it calls,
//      then (wasm32) the C library
//   2. struct typedefs, then definitions in by-value dependency order
//   3. element hook and ownership helper prototypes, globals, prototypes,
//      closure envs, `#[c]` bindings, fn-value trampolines
//   4. fn bodies, from the IR (blocks and gotos)
//   5. element hook bodies and literal default templates
//
// Every fn body comes from the IR: ir.loam lowers everything typecheck
// accepts, so a fn it did not lower is an internal error. The output is built
// in `OUT` and written once at the end, to stdout or to the file `SINK`
// names: the integer helpers come before the code that calls them, and which
// ones is known only when the unit is built.

import "std:buf"
import "std:conv"
import "std:fmt"
import "std:map"
import "std:result"
import "std:str"
import "std:sys"
import "ast.loam"
import "types.loam"
import "lexer.loam"
import "typecheck.loam"
import "dce.loam"
import "ir.loam"

const NONE: int = -1
const NO_TYPE: int = -1

// --- output ------------------------------------------------------------------------

let mut OUT: []u8 = []u8 {}

/** *Where `emit_c` writes: `""` is stdout, in pieces; a path gets the whole */
/** *unit in one write when it is done. */
let mut SINK: string = ""
/** *`loam test`: the program's `main` is left out and a runner calls every */
/** *kept `#[test]` fn instead. */
let mut TEST_MODE: bool = false
/** *`LOAM_SHARD`: the unit is cut into pieces the driver compiles apart, so */
/** *each definition starts with a marker (`shard_mark`), what one unit defines */
/** *and others use is `extern` rather than `static`, and the runtime's and */
/** *the globals' storage sits under `LOAM_SHARD_DEFS` (one unit defines it). */
let mut SHARD: bool = false
/** *`LOAM_BATCH`: the program holds many fixtures (`import … as case<N>`) and */
/** *runs the one `LOAM_CASE` names; only that case's modules initialize. */
let mut BATCH: bool = false
/** *Client build of a split program (`LOAM_SERVER_SPLIT`, and wasm): a */
/** *`#[server]` fn keeps its signature but its body is a trap, so the body and */
/** *its literals never reach the client. */
let mut SERVER_SPLIT: bool = false

/** *One definition starts here, for the driver to cut on. The newline keeps */
/** *the marker at the start of a line, where a string literal cannot put one. */
fn shard_mark(name: string) {
    if SHARD {
        w("\n/*@S {{name}}*/\n")
    }
}

/** *`static ` in a whole-unit build; nothing when shards share the symbol. */
fn unit_static() -> string {
    return if SHARD { "" } else { "static " }
}

/** *A kept fn of a `std` module (`LOAM_STD_DIR`, not a package's `src`, */
/** *whose fns separately built hosts and `zeus_plat.c` call) is private to */
/** *the unit (`static `) when only the unit calls it: a whole-unit build, */
/** *after DCE, and not one of the module's C roots. Then `cc` may inline it */
/** *into its callers, as it did the runtime header's `static inline` C. */
fn fn_linkage(m: int, d: int) -> string {
    if SHARD || !dce.RAN || dce.SKIP || m < 0 || !typecheck.MODS[m].is_std ||
        typecheck.user_seam_mod(typecheck.MODS[m].path) {
        return ""
    }
    let x = ast.ex(d)
    if !ast.EXTRA[x].has_sname || (ast.NODES[d].op & dce.FN_TEST) != 0 {
        return ""
    }
    let roots = dce.c_roots(typecheck.MODS[m].name)
    for r in 0..roots.len {
        if ast.EXTRA[x].sname == "loam_{{typecheck.MODS[m].name}}_{{roots[r]}}" {
            return ""
        }
    }
    return "static "
}

fn w(s: string) {
    buf.push_str(&mut OUT, s)
}

fn wc(c: int) {
    push(OUT, u8(c))
}

fn wi(n: int) {
    buf.push_int(&mut OUT, n)
}

fn wl(n: i64) {
    buf.push_i64(&mut OUT, n)
}

/** *The runtime header, set aside while the rest of the unit is built: the */
/** *integer helpers, core ops, vec pushes and vec pops go between the two, */
/** *and which ones is known only at the end (`int_helper_defs`, */
/** *`core_op_defs`, `vec_push_defs`, `vec_pop_defs`). */
let mut PRELUDE: []u8 = []u8 {}

fn flush() {
    if SINK.len == 0 && OUT.len > 0 {
        fmt.write(buf.to_string(&OUT))
        OUT = []u8 {}
    }
}

fn indent(n: int) {
    for i in 0..n {
        w("    ")
    }
}

/** *Stop with `msg`. The unit is not written: part of one is no C. */
fn fatal(msg: string) {
    OUT = []u8 {}
    fmt.eprintln("loam: {{msg}}")
    sys.exit(1)
}

// --- names -----------------------------------------------------------------------------

let RESERVED: []string = []string {
    "_Alignas", "_Alignof", "_Atomic", "_Bool", "_Complex", "_Generic", "_Imaginary",
    "_Noreturn", "_Static_assert", "_Thread_local", "asm", "auto", "bool", "break",
    "case", "char", "const", "continue", "default", "do", "double", "else", "enum",
    "errno", "extern", "false", "float", "for", "goto", "if", "inline", "int", "long",
    "NULL", "register", "restrict", "return", "short", "signed", "sizeof", "static",
    "stderr", "stdin", "stdout", "struct", "switch", "true", "typedef", "typeof",
    "union", "unsigned", "void", "volatile", "while",
}

let mut RESERVED_SET: Map<int> = map.new(0)

/** *A Loam name as a C identifier: one C reserves gets a `loam_kw_` prefix. */
fn cid(name: string) -> string {
    if RESERVED_SET.len == 0 {
        for i in 0..RESERVED.len {
            map.put(&mut RESERVED_SET, map.key_str(RESERVED[i]), 1)
        }
    }
    if map.has(&mut RESERVED_SET, map.key_str(name)) {
        return "loam_kw_{{name}}"
    }
    return name
}

/** *The bytes C sees of `s`: up to its first NUL. */
fn c_len(s: string) -> int {
    for i in 0..s.len {
        if s[i] == 0 {
            return i
        }
    }
    return s.len
}

/** *Path safe to embed: an absolute path (`/x`, or `C:/x` on Windows) */
/** *contributes its final component. */
/** *Wasm is what gets published: a path under this prefix (the directory the */
/** *compiler ran in) is written relative to it. Empty: no prefix. */
let mut PATH_STRIP: string = ""

/** *A path safe to embed. Under `PATH_STRIP`, the relative tail; any other */
/** *absolute path, only its final component. */
fn public_file(file: string) -> string {
    if file.len == 0 {
        return "loam"
    }
    let n = PATH_STRIP.len
    if n > 0 && file.len >= n && starts_with(file, PATH_STRIP) && (file.len == n || file[n] == '/') {
        if file.len == n {
            return "loam"
        }
        let mut tail = []u8 {}
        for i in n + 1..file.len {
            push(tail, u8(file[i]))
        }
        return buf.to_string(&tail)
    }
    if sys.is_abs(file) {
        let mut slash = file.len - 1
        while slash >= 0 && file[slash] != '/' && file[slash] != '\\' {
            slash = slash - 1
        }
        if slash + 1 < file.len {
            let mut b = []u8 {}
            for i in slash + 1..file.len {
                push(b, u8(file[i]))
            }
            return buf.to_string(&b)
        }
    }
    return file
}

fn path_of(file: int) -> string {
    if file < 0 || file >= typecheck.MODS.len {
        return ""
    }
    return typecheck.MODS[file].path
}

fn w_escaped_path(p: string) {
    let n = c_len(p)
    for i in 0..n {
        if p[i] == '\\' || p[i] == '"' {
            wc('\\')
        }
        wc(p[i])
    }
}

// `#line` directives, only where the (file, line) changes.
let mut LINE_FILE: int = NONE
let mut LINE_NO: int = 0

fn line_directive(file: int, line: int) {
    if file < 0 || line <= 0 {
        return
    }
    let same_file = LINE_FILE != NONE && LINE_FILE == file
    if same_file && LINE_NO == line {
        return
    }
    if same_file {
        w("#line ")
        wi(line)
        wc('\n')
    } else {
        w("#line ")
        wi(line)
        w(" \"")
        w_escaped_path(public_file(path_of(file)))
        w("\"\n")
        LINE_FILE = file
    }
    LINE_NO = line
}

/** *An integer literal; the most negative value has no C spelling of its own. */
fn int_lit(v: i64) {
    if v == i64(-9223372036854775807) - i64(1) {
        w("INT64_MIN")
    } else {
        wl(v)
    }
}

fn c_string_body(s: string) {
    let n = c_len(s)
    for i in 0..n {
        let c = s[i]
        if c == '\\' || c == '"' {
            wc('\\')
            wc(c)
        } else if c == '\n' {
            w("\\n")
        } else if c == '\r' {
            w("\\r")
        } else if c == '\t' {
            w("\\t")
        } else {
            wc(c)
        }
    }
}

fn has_byte(s: string, c: int) -> bool {
    for i in 0..s.len {
        if s[i] == c {
            return true
        }
    }
    return false
}

fn float_lit(f: f64, is_f32: bool) {
    let s = conv.f64_to_g17(f)
    w(s)
    let need_dot = !has_byte(s, '.') && !has_byte(s, 'e') && !has_byte(s, 'E')
    if need_dot {
        w(".0")
    }
    if is_f32 {
        wc('f')
    }
}

/** *A `loam_str` compound literal with its length known at compile time. */
fn str_lit(s: string) {
    w("((loam_str){(const char *)\"")
    c_string_body(s)
    w("\", ")
    wi(c_len(s))
    w("})")
}

// --- types ---------------------------------------------------------------------------

fn tkind(t: int) -> int {
    return types.kind_of(t)
}

fn elem_of(t: int) -> int {
    if t == NO_TYPE {
        return NO_TYPE
    }
    return types.TYPES[t].elem
}

/** *The generic instance being emitted: its type parameters and arguments, */
/** *and its C name ("" when not an instance). */
let mut SUBST_NAMES: []string = []string {}
let mut SUBST_ARGS: []int = []int {}
let mut CNAME_OVERRIDE: string = ""

/** *`t` with the instance's parameters substituted. Only a type that names a */
/** *parameter is rebuilt: substituting any other gives an equal type. */
fn resolve(t: int) -> int {
    if t == NO_TYPE || SUBST_NAMES.len == 0 || !typecheck.type_has_param(t) {
        return t
    }
    let s = typecheck.subst_type(t, SUBST_NAMES, SUBST_ARGS)
    if s != NO_TYPE && types.TYPES[s].kind == TK.Param && types.TYPES[s].has_name {
        let n = if SUBST_NAMES.len < SUBST_ARGS.len { SUBST_NAMES.len } else { SUBST_ARGS.len }
        for i in 0..n {
            if SUBST_NAMES[i] == types.TYPES[s].name && SUBST_ARGS[i] != NO_TYPE {
                return resolve(SUBST_ARGS[i])
            }
        }
    }
    return s
}

/** *`&T` / `&mut T` over an already spelled `inner`. A shared ref to a */
/** *pointer is `T * const *`. */
fn ptr_ctype(inner: string, is_mut: bool) -> string {
    if is_mut {
        return "{{inner}} *"
    }
    if inner.len > 0 && inner[inner.len - 1] == '*' {
        return "{{inner}} const *"
    }
    return "const {{inner}} *"
}

// The C spelling of each type id, outside a generic instance.
let mut CTYPE_MEMO: []string = []string {}
let mut CTYPE_READY: []bool = []bool {}

/** *The C type of a Loam type (`int32_t`, `loam_str`, `Pair__int`, `T *`). */
fn ctype(t0: int) -> string {
    let t = resolve(t0)
    if t == NO_TYPE {
        return "int64_t"
    }
    if t < CTYPE_READY.len && CTYPE_READY[t] {
        return CTYPE_MEMO[t]
    }
    let kind = types.TYPES[t].kind
    let e = types.TYPES[t].elem
    let mut s = "int64_t"
    switch kind {
        case TK.Int, TK.Float:
            s = types.c_scalar(t)
            break
        case TK.Bool:
            s = "bool"
            break
        case TK.String:
            s = "loam_str"
            break
        case TK.Void:
            s = "void"
            break
        case TK.Struct:
            s = types.type_c_name(t)
            break
        case TK.Vec:
            s = "loam_vec"
            break
        case TK.Proc:
            s = "loam_fn"
            break
        case TK.Ptr:
            s = ptr_ctype(ctype(e), types.TYPES[t].is_mut != 0)
            break
        case TK.Box:
            s = "{{ctype(e)}} *"
            break
        case TK.Array:
            s = ctype(e)
            break
        default:
            s = "int64_t"
            break
    }
    // Memoized only where no substitution could reach inside it.
    if SUBST_NAMES.len == 0 {
        while CTYPE_READY.len < types.TYPES.len {
            push(CTYPE_READY, false)
            push(CTYPE_MEMO, "")
        }
        CTYPE_READY[t] = true
        CTYPE_MEMO[t] = s
    }
    return s
}

fn w_ctype(t: int) {
    w(ctype(t))
}

// Typed handle cells (loam_rt.h): a channel, future or signal cell records the
// key of its value type, and every access passes the key it expects. The key
// is FNV-1a over the type's spelling: its C type, with what C erases spelled in
// (the element of `[]T`, `[N]T` and `Box<T>`, a fn's signature, a handle's
// `T`), resolved once in the current generic instance. Never 0, which marks
// a cell no bind has reached. Memoized per type id, as `ctype` is.
let mut HKEY_MEMO: []i64 = []i64 {}

fn key_feed(h: i64, s: string) -> i64 {
    let mut x = h
    for i in 0..s.len {
        x = ((x ^ i64(s[i])) * 16777619) & 4294967295
    }
    return x
}

fn is_typed_handle(t: int) -> bool {
    let n = types.TYPES[t].name
    return types.TYPES[t].has_name && (n == "Signal" || n == "Future" || n == "Chan")
}

/** *Walks a resolved type. Its parts are not resolved again: an argument can */
/** *name a parameter of the same name (`T` bound to `[]T`), and substituting */
/** *at each level would unroll that forever. */
fn key_walk(h0: i64, t: int) -> i64 {
    let kind = tkind(t)
    let mut h = h0
    if kind == TK.Vec {
        return key_walk(key_feed(h, "[]"), types.TYPES[t].elem)
    }
    if kind == TK.Array {
        return key_walk(key_feed(h, "[{{types.TYPES[t].array_len}}]"), types.TYPES[t].elem)
    }
    if kind == TK.Box {
        return key_feed(key_walk(key_feed(h, "Box<"), types.TYPES[t].elem), ">")
    }
    if kind == TK.Proc {
        h = key_feed(h, "fn(")
        // Indexed afresh each time: resolving a parameter may grow `TYPES`.
        let n = types.TYPES[t].params.len
        for i in 0..n {
            if i > 0 {
                h = key_feed(h, ",")
            }
            h = key_walk(h, types.TYPES[t].params[i])
        }
        h = key_feed(h, ")")
        let r = types.TYPES[t].ret
        if r != NO_TYPE && tkind(r) != TK.Void {
            return key_walk(h, r)
        }
        return key_feed(h, "void")
    }
    h = key_feed(h, ctype(t))
    if kind == TK.Struct && is_typed_handle(t) && types.TYPES[t].params.len > 0 {
        h = key_feed(key_walk(key_feed(h, "<"), types.TYPES[t].params[0]), ">")
    }
    return h
}

fn handle_key(t: int) -> i64 {
    let memo = SUBST_NAMES.len == 0 && t >= 0
    if memo && t < HKEY_MEMO.len && HKEY_MEMO[t] != 0 {
        return HKEY_MEMO[t]
    }
    let mut h = key_walk(2166136261, resolve(t))
    if h == 0 {
        h = 1
    }
    if memo {
        while HKEY_MEMO.len < types.TYPES.len {
            push(HKEY_MEMO, i64(0))
        }
        HKEY_MEMO[t] = h
    }
    return h
}

/** *`T name`, with `[N]` after the name for a fixed array. */
fn var_decl(t: int, name: string) {
    w(ctype(t))
    wc(' ')
    w(name)
    if tkind(t) == TK.Array {
        wc('[')
        wl(types.TYPES[t].array_len)
        wc(']')
    }
}

fn is_ptrish(t: int) -> bool {
    let k = tkind(t)
    return k == TK.Ptr || k == TK.Box
}

fn is_copy_vec(t: int) -> bool {
    return tkind(t) == TK.Vec && types.is_copy(t)
}

/** *A Copy handle whose refcount the backend manages: a Copy `[]T`, and an */
/** *owned `string`. */
fn is_refcounted(t: int) -> bool {
    if is_copy_vec(t) {
        return true
    }
    return types.string_owns && tkind(t) == TK.String
}

/** *`types.needs_drop`, memoized per type id. */
let mut DROP_MEMO: []int = []int {}

fn needs_drop(t: int) -> bool {
    if t == NO_TYPE {
        return false
    }
    while DROP_MEMO.len < types.TYPES.len {
        push(DROP_MEMO, 0)
    }
    if DROP_MEMO[t] == 0 {
        DROP_MEMO[t] = if types.needs_drop(t) { 2 } else { 1 }
    }
    return DROP_MEMO[t] == 2
}

/** *A type argument names a type parameter anywhere inside it. A fn type is */
/** *one C handle whatever its signature, so it is not looked inside. */
fn targ_concrete(t: int) -> bool {
    if t == NO_TYPE || types.TYPES[t].kind == TK.Param {
        return false
    }
    if types.TYPES[t].kind == TK.Proc {
        return true
    }
    let e = types.TYPES[t].elem
    if e != NO_TYPE && !targ_concrete(e) {
        return false
    }
    let ps = &types.TYPES[t].params
    for i in 0..ps.len {
        if !targ_concrete(ps[i]) {
            return false
        }
    }
    return true
}

fn struct_targs_concrete(t: int) -> bool {
    if t == NO_TYPE {
        return false
    }
    let ps = &types.TYPES[t].params
    for i in 0..ps.len {
        if !targ_concrete(ps[i]) {
            return false
        }
    }
    return true
}

// --- element hooks ----------------------------------------------------------------------

/** *One retain/release hook pair per element type that owns something; the */
/** *prototypes are emitted for every id up front, so the table is fixed. */
const ELEM_HOOK_MAX: int = 256
let mut ELEM_HOOK_TYPES: []int = []int {}

fn elem_hook_id(t: int) -> int {
    if t == NO_TYPE {
        return 0
    }
    for i in 0..ELEM_HOOK_TYPES.len {
        if types.type_eq(ELEM_HOOK_TYPES[i], t) {
            return i + 1
        }
    }
    if ELEM_HOOK_TYPES.len >= ELEM_HOOK_MAX {
        fatal("more than {{ELEM_HOOK_MAX}} owning element types in one program")
    }
    push(ELEM_HOOK_TYPES, t)
    return ELEM_HOOK_TYPES.len
}

/** *The hook id for elements of type `e`, 0 when they own nothing. */
fn elem_hook(e: int) -> int {
    if e != NO_TYPE && needs_drop(e) {
        return elem_hook_id(e)
    }
    return 0
}

/** *C's pool: every type `type_new` made, after the scalars, at most 4096. */
const SCALAR_COUNT: int = 13
const POOL_MAX: int = 4096

fn collect_elem_hooks() {
    let mut end = types.TYPES.len
    if end > SCALAR_COUNT + POOL_MAX {
        end = SCALAR_COUNT + POOL_MAX
    }
    for t in SCALAR_COUNT..end {
        if types.TYPES[t].kind != TK.Vec {
            continue
        }
        let e = types.TYPES[t].elem
        if e != NO_TYPE && needs_drop(e) && struct_targs_concrete(e) {
            elem_hook_id(e)
        }
    }
}

// The signal byte store is Loam (`zeus/src/zeuscore/sigcells.loam`, R4.1b):
// these ask it for an offset, then move the bytes with one `memcpy`, reading
// `loam_sigcells_bytes.ptr` with no Loam call in between (as `__fut_*` does
// with `std:async`'s arena). The kinds match `sigcells.KIND_*`.
const SIG_KIND_PLAIN: int = 0
const SIG_KIND_STR: int = 1
const SIG_KIND_LIST: int = 2
const SIG_KIND_OWNED: int = 3

/** *Bind the lvalue `val` (of type `vt`) in signal cell `id`; `kind`, `esz` */
/** *and `hook` tell the cell what its bytes own, for `sigcells.free`. */
fn sig_put(vt: int, id: string, val: string, kind: int, esz: string, hook: int) {
    w("{ int32_t _so = loam_sigcells_bind_at({{id}}, (int32_t)sizeof({{val}}), {{handle_key(vt)}}, {{kind}}, {{esz}}, {{hook}}); ")
    w("if (_so >= 0) memcpy((char *)loam_sigcells_bytes.ptr + _so, &{{val}}, sizeof({{val}})); }")
}

/** *Load cell `id` into the lvalue `dst` (of type `t`): zeros when the cell */
/** *holds no such value. The S0 key check is `sigcells.load_at`'s. */
fn sig_get(t: int, id: string, dst: string) {
    w("{ int32_t _so = loam_sigcells_load_at({{id}}, (int32_t)sizeof({{dst}}), {{handle_key(t)}}); ")
    w("if (_so >= 0) memcpy(&{{dst}}, (char *)loam_sigcells_bytes.ptr + _so, sizeof({{dst}})); ")
    w("else memset(&{{dst}}, 0, sizeof({{dst}})); }")
}

fn sig_bind_vec(vt: int, id: string, val: string) {
    let e = elem_of(vt)
    let cn = if vt != NO_TYPE && e != NO_TYPE { ctype(e) } else { "char" }
    sig_put(vt, id, val, SIG_KIND_LIST, "(int32_t)sizeof({{cn}})", elem_hook(e))
}

fn sig_bind_owned(vt: int, id: string, val: string) {
    sig_put(vt, id, val, SIG_KIND_OWNED, "0", elem_hook(vt))
}

/** *Module binding `gv` is never written and holds a literal number or bool: */
/** *emitted `const`. */
fn gvar_folds(gv: int) -> bool {
    if ast.NODES[gv].kind != Kind.Var || ast.NODES[gv].op != 0 || !ir.static_data(ast.NODES[gv].b) {
        return false
    }
    let k = tkind(ast.NODES[gv].ty)
    return k == TK.Int || k == TK.Float || k == TK.Bool
}

/** *The program links Zeus's signal store (`sigcells.free` is kept). */
fn sig_store_linked() -> bool {
    if dce.RAN && !dce.SKIP {
        return dce.kept_cname("loam_sigcells_payload_drop")
    }
    for m in 0..typecheck.MODS.len {
        if typecheck.MODS[m].name == "sigcells" && typecheck.MODS[m].root != NONE {
            return true
        }
    }
    return false
}

/** *The generated half of `sigcells.free`: release an owned payload by its */
/** *recorded kind and hook id, so no C function pointer is kept in Loam. */
/** *Emitted after every release hook exists; only a program that keeps the */
/** *signal store has it. */
fn sig_payload_drop_def() {
    if !sig_store_linked() {
        return
    }
    shard_mark("loam_sigcells_payload_drop")
    w("void loam_sigcells_payload_drop(int32_t kind, int32_t esz, int32_t hook, int32_t off) {\n")
    w("    void *p = (char *)loam_sigcells_bytes.ptr + off;\n")
    w("    loam_elem_fn rel = NULL;\n")
    w("    switch (hook) {\n")
    for h in 0..ELEM_HOOK_TYPES.len {
        w("    case {{h + 1}}: rel = loam_elem_release_{{h + 1}}; break;\n")
    }
    w("    default: break;\n")
    w("    }\n")
    w("    if (kind == {{SIG_KIND_STR}}) loam_str_release((loam_str *)p);\n")
    w("    else if (kind == {{SIG_KIND_LIST}}) {{core_op(CoreOp.VecDropOwned)}}((loam_vec *)p, (size_t)esz, rel);\n")
    w("    else if (kind == {{SIG_KIND_OWNED}} && rel) rel(p);\n")
    w("}\n")
}

// --- value keys and value equality --------------------------------------------------------

// `__value_key(x)`: a string that matches iff the value matches. A cycle (a
// struct that holds a vec of itself) stops at `~`.
let mut VK_STACK: []int = []int {}
let mut VK_TMP: int = 0

fn vk_resolve(t: int) -> int {
    return resolve(t)
}

fn vk_seen(t: int) -> bool {
    for i in 0..VK_STACK.len {
        if VK_STACK[i] == t {
            return true
        }
    }
    return false
}

fn int_bits(t: int) -> int {
    let b = types.TYPES[t].bits
    return if b != 0 { b } else { 64 }
}

/** *`"a {{n}} b"`: every part's bytes, then one exact allocation they are */
/** *copied into. An integer's digits go onto the stack through */
/** *`std:decimal`'s `fill`; a float is a temporary `std:floattext` text, released */
/** *after the copy; a bool is `true` / `false`. */
fn interp(x: &Inst) {
    let n = x.nargs
    // A lone bool is a literal (nothing allocated); a lone float its text.
    let t0 = resolve(local_ty(arg_of(x, 0)))
    if n == 1 && t0 != NO_TYPE && types.TYPES[t0].kind == TK.Bool {
        w("{{lv(x.dst)}} = ({{lv(arg_of(x, 0))}}) ? ")
        str_lit("true")
        w(" : ")
        str_lit("false")
        w(";\n")
        return
    }
    if n == 1 && t0 != NO_TYPE && types.TYPES[t0].kind == TK.Float {
        w("{{lv(x.dst)}} = loam_floattext_of_float((double)({{lv(arg_of(x, 0))}}));\n")
        return
    }
    let mut ptrs = []string {}
    let mut lens = []string {}
    w("{ ")
    for k in 0..n {
        let v = lv(arg_of(x, k))
        let t = resolve(local_ty(arg_of(x, k)))
        let kind = if t == NO_TYPE { TK.String } else { types.TYPES[t].kind }
        if kind == TK.Int {
            if types.TYPES[t].is_unsigned != 0 {
                w("uint8_t _id{{k}}[20]; int32_t _if{{k}} = loam_decimal_fill(_id{{k}}, (uint64_t)({{v}}), false); ")
            } else {
                w("uint8_t _id{{k}}[20]; int32_t _if{{k}} = loam_decimal_fill(_id{{k}}, loam_decimal_magnitude_of((int64_t)({{v}})), (int64_t)({{v}}) < 0); ")
            }
            push(ptrs, "(const char *)_id{{k}} + _if{{k}}")
            push(lens, "(int64_t)(20 - _if{{k}})")
        } else if kind == TK.Float {
            w("loam_str _is{{k}} = loam_floattext_of_float((double)({{v}})); ")
            push(ptrs, "_is{{k}}.ptr")
            push(lens, "_is{{k}}.len")
        } else if kind == TK.Bool {
            push(ptrs, "(({{v}}) ? \"true\" : \"false\")")
            push(lens, "(int64_t)(({{v}}) ? 4 : 5)")
        } else {
            push(ptrs, "{{v}}.ptr")
            push(lens, "{{v}}.len")
        }
    }
    w("int64_t _in = 0")
    for k in 0..n {
        w(" + {{lens[k]}}")
    }
    w("; char *_ip = loam_str_bytes(_in); int64_t _io = 0; ")
    for k in 0..n {
        w("if ({{lens[k]}} > 0) { memcpy(_ip + _io, {{ptrs[k]}}, (size_t){{lens[k]}}); _io += {{lens[k]}}; } ")
    }
    w("_ip[_in] = 0; {{lv(x.dst)}} = loam_str_owned(_ip, _in); ")
    for k in 0..n {
        let t = resolve(local_ty(arg_of(x, k)))
        if t != NO_TYPE && types.TYPES[t].kind == TK.Float {
            w("loam_str_release(&_is{{k}}); ")
        }
    }
    w("}\n")
}

/** *Append literal `s` to the key buffer `b`. */
fn vk_lit(b: string, s: string) {
    rt_note_name("loam_buf_push_str")
    w("loam_buf_push_str({{b}}, ")
    str_lit(s)
    w("); ")
}

/** *Statements appending `place`'s key (type `t0`) to the `[]u8` at `b` */
/** *through `std:key`'s `push_*`: one buffer for the whole key. */
fn value_key(t0: int, place: string, b: string) {
    let t = vk_resolve(t0)
    if t == NO_TYPE {
        vk_lit(b, "~")
        return
    }
    let k = types.TYPES[t].kind
    let compound = k == TK.Struct || k == TK.Vec || k == TK.Array
    if compound && (VK_STACK.len >= 24 || vk_seen(t)) {
        vk_lit(b, "~")
        return
    }
    if compound {
        push(VK_STACK, t)
    }
    let id = VK_TMP
    VK_TMP = VK_TMP + 1
    switch k {
        case TK.String:
            w("loam_key_push_str({{b}}, {{place}}); ")
            break
        case TK.Bool:
            rt_note_name("loam_buf_push_str")
            w("loam_buf_push_str({{b}}, ({{place}}) ? ")
            str_lit("b1")
            w(" : ")
            str_lit("b0")
            w("); ")
            break
        case TK.Int:
            // Width and signedness are the type's: a literal prefix, then
            // `std:decimal` appends the value.
            if types.TYPES[t].is_unsigned != 0 {
                vk_lit(b, "i{{int_bits(t)}}u:")
                w("loam_decimal_push_u64({{b}}, (uint64_t)({{place}})); ")
            } else {
                vk_lit(b, "i{{int_bits(t)}}s:")
                w("loam_decimal_push_int({{b}}, (int64_t)({{place}})); ")
            }
            break
        case TK.Float:
            if int_bits(t) <= 32 {
                w("loam_key_push_f32({{b}}, {{place}}); ")
            } else {
                w("loam_key_push_f64({{b}}, {{place}}); ")
            }
            break
        case TK.Ptr:
            w("loam_key_push_addr({{b}}, (uint64_t)(uintptr_t)({{place}}), 112); ")
            break
        case TK.Box:
            w("loam_key_push_addr({{b}}, (uint64_t)(uintptr_t)({{place}}), 120); ")
            break
        case TK.Proc:
            w("loam_key_push_addr({{b}}, (uint64_t)(uintptr_t)({{place}}).fn, 70); ")
            break
        case TK.Struct:
            let names = types.TYPES[t].field_names
            let fts = types.TYPES[t].field_types
            vk_lit(b, "R{{names.len}}{")
            for fi in 0..names.len {
                value_key(fts[fi], "{{place}}.{{cid(names[fi])}}", b)
            }
            vk_lit(b, "}")
            break
        case TK.Vec, TK.Array:
            let e = types.TYPES[t].elem
            let is_vec = k == TK.Vec
            let alen = if types.TYPES[t].array_len > i64(0) { types.TYPES[t].array_len } else { i64(0) }
            let ename = "_e{{id}}"
            if is_vec {
                w("loam_key_push_vec_tag({{b}}, {{place}}.len); { int64_t _i{{id}}; ")
                w("for (_i{{id}} = 0; _i{{id}} < {{place}}.len; _i{{id}}++) { ")
            } else {
                vk_lit(b, "A{{alen}}[")
                w("{ int64_t _i{{id}}; ")
                w("for (_i{{id}} = 0; _i{{id}} < {{alen}}; _i{{id}}++) { ")
            }
            var_decl(e, ename)
            w(" = {0}; ")
            if is_vec {
                w("if ({{place}}.ptr) memcpy(&{{ename}}, (const char *){{place}}.ptr + (size_t)_i{{id}} * sizeof({{ename}}), sizeof({{ename}})); ")
            } else {
                w("memcpy(&{{ename}}, &({{place}})[_i{{id}}], sizeof({{ename}})); ")
            }
            value_key(e, ename, b)
            w("} } ")
            vk_lit(b, "]")
            break
        default:
            vk_lit(b, "~")
            break
    }
    if compound {
        pop(VK_STACK)
    }
}

/** *Whether equality of `t` must look past its bytes (a string, a vec, or */
/** *something holding one). */
fn ve_deep(t0: int) -> bool {
    let t = vk_resolve(t0)
    if t == NO_TYPE {
        return false
    }
    let k = types.TYPES[t].kind
    if k == TK.String || k == TK.Vec {
        return true
    }
    if vk_seen(t) {
        return false
    }
    if k == TK.Array {
        push(VK_STACK, t)
        let r = ve_deep(types.TYPES[t].elem)
        pop(VK_STACK)
        return r
    }
    if k == TK.Struct {
        if VK_STACK.len >= 24 {
            return false
        }
        push(VK_STACK, t)
        let fts = types.TYPES[t].field_types
        for i in 0..fts.len {
            if ve_deep(fts[i]) {
                pop(VK_STACK)
                return true
            }
        }
        pop(VK_STACK)
    }
    return false
}

fn memcmp_eq(a: string, b: string) {
    w("(memcmp(&({{a}}), &({{b}}), sizeof({{a}})) == 0)")
}

/** *By-value equality of two lvalues of type `t`, as a C expression. */
fn value_eq(t0: int, a: string, b: string) {
    let t = vk_resolve(t0)
    if t == NO_TYPE || !ve_deep(t) || VK_STACK.len >= 24 || vk_seen(t) {
        memcmp_eq(a, b)
        return
    }
    let id = VK_TMP
    VK_TMP = VK_TMP + 1
    let k = types.TYPES[t].kind
    switch k {
        case TK.String:
            w("(({{a}}).len == ({{b}}).len && (({{a}}).ptr == ({{b}}).ptr || ({{a}}).len == 0 || ")
            w("memcmp(({{a}}).ptr, ({{b}}).ptr, (size_t)({{a}}).len) == 0))")
            break
        case TK.Struct:
            push(VK_STACK, t)
            w("(1")
            let names = types.TYPES[t].field_names
            let fts = types.TYPES[t].field_types
            for fi in 0..names.len {
                w(" && ")
                let f = cid(names[fi])
                value_eq(fts[fi], "{{a}}.{{f}}", "{{b}}.{{f}}")
            }
            w(")")
            pop(VK_STACK)
            break
        case TK.Vec, TK.Array:
            let e = types.TYPES[t].elem
            let is_vec = k == TK.Vec
            let ea = "_qa{{id}}"
            let eb = "_qb{{id}}"
            let alen = if types.TYPES[t].array_len > i64(0) { types.TYPES[t].array_len } else { i64(0) }
            let len = if is_vec { "({{a}}).len" } else { "{{alen}}" }
            push(VK_STACK, t)
            w("({ int _qr{{id}} = 1; int64_t _qi{{id}}; ")
            if is_vec {
                w("_qr{{id}} = ({{a}}).len == ({{b}}).len; if (_qr{{id}} && ({{a}}).ptr != ({{b}}).ptr) ")
            }
            w("for (_qi{{id}} = 0; _qr{{id}} && _qi{{id}} < {{len}}; _qi{{id}}++) { ")
            var_decl(e, ea)
            w(" = {0}; ")
            var_decl(e, eb)
            w(" = {0}; ")
            if is_vec {
                w("memcpy(&{{ea}}, (const char *)({{a}}).ptr + (size_t)_qi{{id}} * sizeof({{ea}}), sizeof({{ea}})); ")
                w("memcpy(&{{eb}}, (const char *)({{b}}).ptr + (size_t)_qi{{id}} * sizeof({{eb}}), sizeof({{eb}})); ")
            } else {
                w("memcpy(&{{ea}}, &({{a}})[_qi{{id}}], sizeof({{ea}})); ")
                w("memcpy(&{{eb}}, &({{b}})[_qi{{id}}], sizeof({{eb}})); ")
            }
            w("_qr{{id}} = ")
            value_eq(e, ea, eb)
            w("; } _qr{{id}}; })")
            pop(VK_STACK)
            break
        default:
            memcmp_eq(a, b)
            break
    }
}

/** *1 when writing `val` moves signal `id`: no value of its width is bound, */
/** *or the bytes differ, refined by value for a type whose bytes name storage */
/** *(two equal strings in different buffers are the same state). */
fn sig_changed(t: int, id: string, val: string) {
    let k = VK_TMP
    VK_TMP = VK_TMP + 1
    w("({ int32_t _sc{{k}} = loam_sigcells_cmp_at({{id}}, (int32_t)sizeof({{val}}), {{handle_key(t)}}); ")
    w("int64_t _chg{{k}} = _sc{{k}} < 0 || memcmp((char *)loam_sigcells_bytes.ptr + _sc{{k}}, &{{val}}, sizeof({{val}})) != 0; ")
    if ve_deep(t) {
        w("if (_chg{{k}} && _sc{{k}} >= 0) { ")
        let cur = "_cur{{k}}"
        var_decl(t, cur)
        w("; memcpy(&{{cur}}, (char *)loam_sigcells_bytes.ptr + _sc{{k}}, sizeof({{cur}})); _chg{{k}} = !")
        value_eq(t, cur, val)
        w("; } ")
    }
    w("_chg{{k}}; })")
}

// --- integer helpers ---------------------------------------------------------------------
//
// Checked, wrapping and saturating integer ops, narrowing conversions and the
// bounds check are small `static inline` C fns. They used to sit in the
// runtime header, all of them in every program; now codegen notes each one
// as it writes a call to it and defines only those, after the runtime
// header and before anything that calls them (`int_helper_defs`), so a
// program carries only the integer ops it uses.

// Helper families, in the order their definitions are written.
enum IntHelper {
    Add = 0,
    Sub = 1,
    Mul = 2,
    Div = 3,
    Mod = 4,
    Neg = 5,
    Shl = 6,
    Shr = 7,
    WrapAdd = 8,
    WrapSub = 9,
    WrapMul = 10,
    WrapNeg = 11,
    WrapShl = 12,
    WrapShr = 13,
    WrapAnd = 14,
    WrapOr = 15,
    WrapXor = 16,
    SatAdd = 17,
    SatSub = 18,
    SatMul = 19,
    Conv = 20,
    Convf = 21,
    Sat = 22,
    Convu = 23,
    Satu = 24,
}
const IH_FAMILIES: int = 25
/** *Widths: i8 i16 i32 i64, then u8 u16 u32 u64. */
const IH_WIDTHS: int = 8

/** *`family * IH_WIDTHS + width`: a call to that helper was written. */
let mut INT_HELPER_USED: []bool = []bool {}
/** *A bounds check (`loam_idx`) was written. */
let mut BOUNDS_HELPER_USED: bool = false

fn int_helpers_reset() {
    INT_HELPER_USED = []bool {}
    for i in 0..IH_FAMILIES * IH_WIDTHS {
        push(INT_HELPER_USED, false)
    }
    BOUNDS_HELPER_USED = false
}

fn int_family_name(family: int) -> string {
    switch family {
        case IntHelper.Add:
            return "add"
        case IntHelper.Sub:
            return "sub"
        case IntHelper.Mul:
            return "mul"
        case IntHelper.Div:
            return "div"
        case IntHelper.Mod:
            return "mod"
        case IntHelper.Neg:
            return "neg"
        case IntHelper.Shl:
            return "shl"
        case IntHelper.Shr:
            return "shr"
        case IntHelper.WrapAdd:
            return "wrapping_add"
        case IntHelper.WrapSub:
            return "wrapping_sub"
        case IntHelper.WrapMul:
            return "wrapping_mul"
        case IntHelper.WrapNeg:
            return "wrapping_neg"
        case IntHelper.WrapShl:
            return "wrapping_shl"
        case IntHelper.WrapShr:
            return "wrapping_shr"
        case IntHelper.WrapAnd:
            return "wrapping_and"
        case IntHelper.WrapOr:
            return "wrapping_or"
        case IntHelper.WrapXor:
            return "wrapping_xor"
        case IntHelper.SatAdd:
            return "saturating_add"
        case IntHelper.SatSub:
            return "saturating_sub"
        case IntHelper.SatMul:
            return "saturating_mul"
        case IntHelper.Conv:
            return "conv"
        case IntHelper.Convf:
            return "convf"
        case IntHelper.Sat:
            return "sat"
        case IntHelper.Convu:
            return "convu"
        default:
            return "satu"
    }
}

/** *Bits of width `k`. */
fn int_width_bits(k: int) -> string {
    return if k % 4 == 0 { "8" } else if k % 4 == 1 { "16" } else if k % 4 == 2 { "32" } else { "64" }
}

/** *Width `k` as `types.int_suffix` names it (`i32`, `u8`). */
fn int_width_name(k: int) -> string {
    return if k >= 4 { "u{{int_width_bits(k)}}" } else { "i{{int_width_bits(k)}}" }
}

/** *The C name of helper `family` at width `sfx` (`loam_add_i32`), noted as */
/** *used so its definition is written. */
fn int_helper(family: int, sfx: string) -> string {
    let mut width = -1
    for k in 0..IH_WIDTHS {
        if int_width_name(k) == sfx {
            width = k
            break
        }
    }
    if family < 0 || family >= IH_FAMILIES || width < 0 {
        fatal("internal: no integer helper {{family}} for {{sfx}}")
    }
    if INT_HELPER_USED.len == 0 {
        int_helpers_reset()
    }
    INT_HELPER_USED[family * IH_WIDTHS + width] = true
    return "loam_{{int_family_name(family)}}_{{sfx}}"
}

/** *A numeric builtin's call, `loam_<family>_<width>` as ir.loam named it. */
fn note_numeric_builtin(cname: string) {
    let cut = str.last_index_of(cname, "_")
    let family = str.slice(cname, 5, cut)
    for f in IntHelper.WrapAdd..IntHelper.Conv {
        if int_family_name(f) == family {
            int_helper(f, str.slice(cname, cut + 1, cname.len))
            return
        }
    }
    fatal("internal: no integer helper {{cname}}")
}

/** *Write `template` with its placeholders filled in: `@N` the helper's */
/** *name, `@T` its C type, `@U` the unsigned type of that width, `@L` / `@H` */
/** *the least and greatest value, `@O` `op` and `@V` `cond`. */
fn w_int_template(template: string, name: string, k: int, op: string, cond: string) {
    let bits = int_width_bits(k)
    let mut i = 0
    while i < template.len {
        if template[i] != '@' || i + 1 >= template.len {
            wc(template[i])
            i = i + 1
            continue
        }
        let tag = template[i + 1]
        if tag == 'N' {
            w(name)
        } else if tag == 'T' || tag == 'U' {
            w(if k >= 4 || tag == 'U' { "uint" } else { "int" })
            w(bits)
            w("_t")
        } else if tag == 'L' {
            if k >= 4 {
                w("0")
            } else {
                w("INT")
                w(bits)
                w("_MIN")
            }
        } else if tag == 'H' {
            w(if k >= 4 { "UINT" } else { "INT" })
            w(bits)
            w("_MAX")
        } else if tag == 'O' {
            w(op)
        } else {
            w(cond)
        }
        i = i + 2
    }
}

/** *The definition of helper `family` at width `k`. Overflow is found by */
/** *`__builtin_*_overflow`, which computes in infinite precision and reports */
/** *whether the result fits the type exactly, so C's promotions never decide */
/** *a result. Shifts go through the unsigned type, so a signed left shift is */
/** *never UB, and a count at or past the width traps. */
fn int_helper_def(family: int, k: int) {
    let name = "loam_{{int_family_name(family)}}_{{int_width_name(k)}}"
    let is_signed = k < 4
    let is_i64 = k == 3
    let is_u64 = k == 7
    switch family {
        case IntHelper.Add, IntHelper.Sub, IntHelper.Mul:
            w_int_template("static inline @T @N(@T a, @T b, const char *f, int l) {\n    @T r; if (__builtin_@O_overflow(a, b, &r)) loam_panic(f, l, \"integer overflow\");\n    return r;\n}\n", name, k, int_family_name(family), "")
            break
        case IntHelper.Div:
            if is_signed {
                w_int_template("static inline @T @N(@T a, @T b, const char *f, int l) {\n    if (b == 0) loam_panic(f, l, \"division by zero\");\n    if (a == (@T)(@L) && b == (@T)-1) loam_panic(f, l, \"integer overflow\");\n    return (@T)(a / b);\n}\n", name, k, "", "")
            } else {
                w_int_template("static inline @T @N(@T a, @T b, const char *f, int l) {\n    if (b == 0) loam_panic(f, l, \"division by zero\");\n    return (@T)(a / b);\n}\n", name, k, "", "")
            }
            break
        case IntHelper.Mod:
            if is_signed {
                w_int_template("static inline @T @N(@T a, @T b, const char *f, int l) {\n    if (b == 0) loam_panic(f, l, \"division by zero\");\n    if (a == (@T)(@L) && b == (@T)-1) return (@T)0;\n    return (@T)(a % b);\n}\n", name, k, "", "")
            } else {
                w_int_template("static inline @T @N(@T a, @T b, const char *f, int l) {\n    if (b == 0) loam_panic(f, l, \"division by zero\");\n    return (@T)(a % b);\n}\n", name, k, "", "")
            }
            break
        case IntHelper.Neg:
            w_int_template("static inline @T @N(@T a, const char *f, int l) {\n    @T r; if (__builtin_sub_overflow((@T)0, a, &r)) loam_panic(f, l, \"integer overflow\");\n    return r;\n}\n", name, k, "", "")
            break
        case IntHelper.Shl, IntHelper.Shr:
            w_int_template("static inline @T @N(@T a, uint64_t n, const char *f, int l) {\n    if (n >= (uint64_t)(sizeof(@T) * 8)) loam_panic(f, l, \"shift amount out of range\");\n    return (@T)(@O);\n}\n", name, k, if family == IntHelper.Shl { "(uint{{int_width_bits(k)}}_t)a << n" } else { "a >> n" }, "")
            break
        case IntHelper.WrapAdd, IntHelper.WrapSub, IntHelper.WrapMul:
            let op = if family == IntHelper.WrapAdd { "+" } else if family == IntHelper.WrapSub { "-" } else { "*" }
            w_int_template("static inline @T @N(@T a, @T b) { return (@T)((@U)a @O (@U)b); }\n", name, k, op, "")
            break
        case IntHelper.WrapNeg:
            w_int_template("static inline @T @N(@T a) { return (@T)((@U)0 - (@U)a); }\n", name, k, "", "")
            break
        case IntHelper.WrapShl, IntHelper.WrapShr:
            w_int_template("static inline @T @N(@T a, @U n) {\n    return n >= (@U)(sizeof(@T) * 8) ? (@T)0 : (@T)((@U)a @O n);\n}\n", name, k, if family == IntHelper.WrapShl { "<<" } else { ">>" }, "")
            break
        case IntHelper.WrapAnd, IntHelper.WrapOr, IntHelper.WrapXor:
            let op = if family == IntHelper.WrapAnd { "&" } else if family == IntHelper.WrapOr { "|" } else { "^" }
            w_int_template("static inline @T @N(@T a, @T b) { return (@T)(a @O b); }\n", name, k, op, "")
            break
        case IntHelper.SatAdd, IntHelper.SatSub, IntHelper.SatMul:
            let op = if family == IntHelper.SatAdd { "add" } else if family == IntHelper.SatSub { "sub" } else { "mul" }
            let high = if family == IntHelper.SatAdd { "b > 0" } else if family == IntHelper.SatSub { "b < 0" } else { "(a > 0) == (b > 0)" }
            w_int_template("static inline @T @N(@T a, @T b) {\n    @T r; if (!__builtin_@O_overflow(a, b, &r)) return r;\n    return (@V) ? (@T)(@H) : (@T)(@L);\n}\n", name, k, op, high)
            break
        case IntHelper.Conv:
            if is_i64 {
                w_int_template("static inline int64_t @N(int64_t v, const char *f, int l) {\n    (void)f; (void)l; return v;\n}\n", name, k, "", "")
            } else if is_u64 {
                w_int_template("static inline uint64_t @N(int64_t v, const char *f, int l) {\n    if (v < 0) loam_panic(f, l, \"integer conversion out of range\");\n    return (uint64_t)v;\n}\n", name, k, "", "")
            } else {
                w_int_template("static inline @T @N(int64_t v, const char *f, int l) {\n    if (v < (int64_t)(@L) || v > (int64_t)(@H)) loam_panic(f, l, \"integer conversion out of range\");\n    return (@T)v;\n}\n", name, k, "", "")
            }
            break
        case IntHelper.Convf:
            let range = if is_i64 { "v >= -9223372036854775808.0 && v < 9223372036854775808.0" } else if is_u64 { "v >= 0.0 && v < 18446744073709551616.0" } else { "v >= (double)(@L) && v <= (double)(@H)" }
            w_int_template("static inline @T @N(double v, const char *f, int l) {\n    if (!(", name, k, "", "")
            w_int_template(range, name, k, "", "")
            w_int_template(")) loam_panic(f, l, \"float conversion out of range\");\n    return (@T)v;\n}\n", name, k, "", "")
            break
        case IntHelper.Sat:
            if is_i64 {
                w_int_template("static inline int64_t @N(int64_t v) { return v; }\n", name, k, "", "")
            } else if is_u64 {
                w_int_template("static inline uint64_t @N(int64_t v) { return v < 0 ? (uint64_t)0 : (uint64_t)v; }\n", name, k, "", "")
            } else {
                w_int_template("static inline @T @N(int64_t v) {\n    if (v < (int64_t)(@L)) return (@T)(@L);\n    if (v > (int64_t)(@H)) return (@T)(@H);\n    return (@T)v;\n}\n", name, k, "", "")
            }
            break
        case IntHelper.Convu:
            w_int_template("static inline @T @N(uint64_t v, const char *f, int l) {\n    if (v > (uint64_t)(@H)) loam_panic(f, l, \"integer conversion out of range\");\n    return (@T)v;\n}\n", name, k, "", "")
            break
        default:
            w_int_template("static inline @T @N(uint64_t v) { return v > (uint64_t)(@H) ? (@T)(@H) : (@T)v; }\n", name, k, "", "")
            break
    }
}

/** *Define every integer helper a call was written to, in a fixed order, so */
/** *the output does not depend on where each was first used. */
fn int_helper_defs() {
    if INT_HELPER_USED.len == 0 {
        int_helpers_reset()
    }
    for f in 0..IH_FAMILIES {
        for k in 0..IH_WIDTHS {
            if INT_HELPER_USED[f * IH_WIDTHS + k] {
                int_helper_def(f, k)
            }
        }
    }
    if BOUNDS_HELPER_USED {
        w("static inline int64_t loam_idx(int64_t i, int64_t n, const char *f, int l) {\n")
        w("    if (i < 0 || i >= n) loam_panic(f, l, \"index out of bounds\");\n    return i;\n}\n")
    }
}

// --- vec push ----------------------------------------------------------------------------
//
// `loam_vec_push`, `_owned` and `_take` used to sit in the runtime header,
// in every program. Codegen notes each variant as it writes a call and
// defines only those, after the header and before anything that calls them.
// The bodies are the header's C: the fast path is still `static inline`, the
// grow and un-share path is still the out-of-line call into `loam_vec_reserve`
// (which stays in the header, with the refcount word and copy-on-write).

let mut VEC_PUSH_PLAIN: bool = false
let mut VEC_PUSH_OWNED: bool = false
let mut VEC_PUSH_TAKE: bool = false

fn vec_push_reset() {
    VEC_PUSH_PLAIN = false
    VEC_PUSH_OWNED = false
    VEC_PUSH_TAKE = false
}

/** *The suffix just written (`""`, `_owned`, `_take`), noted so its definition */
/** *is emitted. A moved element is `_take`; any other owning element is */
/** *`_owned`; a plain element is `loam_vec_push`. */
fn w_vec_push_name(h: int, moved: bool) {
    w("loam_vec_push")
    if h > 0 && moved {
        w("_take")
        VEC_PUSH_TAKE = true
        note_core_op(CoreOp.VecReserveOwned)
    } else if h > 0 {
        w("_owned")
        VEC_PUSH_OWNED = true
        note_core_op(CoreOp.VecReserveOwned)
    } else {
        VEC_PUSH_PLAIN = true
    }
}

fn vec_push_defs() {
    if !VEC_PUSH_PLAIN && !VEC_PUSH_OWNED && !VEC_PUSH_TAKE {
        return
    }
    w("#if defined(__GNUC__) || defined(__clang__)\n")
    w("#define LOAM_NOINLINE __attribute__((noinline, unused))\n")
    w("#define LOAM_LIKELY(x) __builtin_expect(!!(x), 1)\n")
    w("#else\n")
    w("#define LOAM_NOINLINE\n")
    w("#define LOAM_LIKELY(x) (x)\n")
    w("#endif\n")
    if VEC_PUSH_PLAIN {
        w("/* The push that grows or un-shares the buffer: out of line, so the common\n")
        w("   push below stays small enough to inline with its element size known. */\n")
        w("static LOAM_NOINLINE void loam_vec_push_slow(loam_vec *v, const void *elem, size_t esz,\n")
        w("                                             const char *f, int l) {\n")
        w("    if (!v) loam_panic(f, l, \"push on null array\");\n")
        w("    loam_vec_reserve(v, v->len + 1, esz, f, l);\n")
        w("    if (esz && elem) memcpy((char *)v->ptr + (size_t)v->len * esz, elem, esz);\n")
        w("    v->len++;\n")
        w("}\n")
        w("static inline void loam_vec_push(loam_vec *v, const void *elem, size_t esz, const char *f, int l) {\n")
        w("    /* An owned buffer with room: one element copy. */\n")
        w("    if (LOAM_LIKELY(v && v->ptr && v->len < v->cap && *loam_vec_rc(v->ptr) == 1)) {\n")
        w("        if (esz && elem) memcpy((char *)v->ptr + (size_t)v->len * esz, elem, esz);\n")
        w("        v->len++;\n")
        w("        return;\n")
        w("    }\n")
        w("    loam_vec_push_slow(v, elem, esz, f, l);\n")
        w("}\n")
    }
    if VEC_PUSH_OWNED || VEC_PUSH_TAKE {
        w("static LOAM_NOINLINE void loam_vec_push_owned_slow(loam_vec *v, const void *elem, size_t esz,\n")
        w("                                                   loam_elem_fn retain, const char *f, int l) {\n")
        w("    loam_vec_reserve_owned(v, v->len + 1, esz, retain, f, l);\n")
        w("    if (esz && elem) memcpy((char *)v->ptr + (size_t)v->len * esz, elem, esz);\n")
        w("    v->len++;\n")
        w("}\n")
    }
    if VEC_PUSH_OWNED {
        w("static inline void loam_vec_push_owned(loam_vec *v, const void *elem, size_t esz,\n")
        w("                                       loam_elem_fn retain, const char *f, int l) {\n")
        w("    if (!v) loam_panic(f, l, \"push on null array\");\n")
        w("    if (retain) retain((void *)elem);\n")
        w("    /* An owned buffer with room: one element copy (see loam_vec_push). */\n")
        w("    if (LOAM_LIKELY(v->ptr && v->len < v->cap && *loam_vec_rc(v->ptr) == 1)) {\n")
        w("        if (esz && elem) memcpy((char *)v->ptr + (size_t)v->len * esz, elem, esz);\n")
        w("        v->len++;\n")
        w("        return;\n")
        w("    }\n")
        w("    loam_vec_push_owned_slow(v, elem, esz, retain, f, l);\n")
        w("}\n")
    }
    if VEC_PUSH_TAKE {
        w("/* As loam_vec_push_owned, for an element handed over whole (a temporary or\n")
        w("   a moved value): the slot takes the references it holds, so nothing is\n")
        w("   retained. `retain` still copies the elements if the buffer is shared. */\n")
        w("static inline void loam_vec_push_take(loam_vec *v, const void *elem, size_t esz,\n")
        w("                                      loam_elem_fn retain, const char *f, int l) {\n")
        w("    if (!v) loam_panic(f, l, \"push on null array\");\n")
        w("    if (LOAM_LIKELY(v->ptr && v->len < v->cap && *loam_vec_rc(v->ptr) == 1)) {\n")
        w("        if (esz && elem) memcpy((char *)v->ptr + (size_t)v->len * esz, elem, esz);\n")
        w("        v->len++;\n")
        w("        return;\n")
        w("    }\n")
        w("    loam_vec_push_owned_slow(v, elem, esz, retain, f, l);\n")
        w("}\n")
    }
}

// --- vec pop -----------------------------------------------------------------------------
//
// `loam_vec_pop` and `_owned` left the runtime header the same way push did.
// The body calls `loam_vec_unique` (in the header, beside `loam_vec_reserve`)
// or `loam_vec_unique_owned` (a core op, noted with the pop).

let mut VEC_POP_PLAIN: bool = false
let mut VEC_POP_OWNED: bool = false

fn vec_pop_reset() {
    VEC_POP_PLAIN = false
    VEC_POP_OWNED = false
}

/** *`loam_vec_pop` or `loam_vec_pop_owned`, noted so its definition is emitted. */
fn w_vec_pop_name(h: int) {
    w("loam_vec_pop")
    if h > 0 {
        w("_owned")
        VEC_POP_OWNED = true
        note_core_op(CoreOp.VecUniqueOwned)
    } else {
        VEC_POP_PLAIN = true
    }
}

fn vec_pop_defs() {
    if VEC_POP_PLAIN {
        w("static inline void loam_vec_pop(loam_vec *v, void *out, size_t esz, const char *f, int l) {\n")
        w("    if (!v || v->len <= 0) loam_panic(f, l, \"pop from empty array\");\n")
        w("    loam_vec_unique(v, esz, f, l);\n")
        w("    v->len--;\n")
        w("    if (esz && out) memcpy(out, (char *)v->ptr + (size_t)v->len * esz, esz);\n")
        w("}\n")
    }
    if VEC_POP_OWNED {
        w("/* Pop an element that owns a string. The copy-on-write reallocation retains\n")
        w("   every element it duplicates, so the popped slot's own reference transfers to\n")
        w("   `out` (the slot is now past `len`, so the buffer never releases it) and the\n")
        w("   remaining elements stay owned by the buffer. Without the retain hook the\n")
        w("   shared element is released by both buffers. */\n")
        w("static inline void loam_vec_pop_owned(loam_vec *v, void *out, size_t esz, loam_elem_fn retain,\n")
        w("                                      const char *f, int l) {\n")
        w("    if (!v || v->len <= 0) loam_panic(f, l, \"pop from empty array\");\n")
        w("    loam_vec_unique_owned(v, esz, retain, f, l);\n")
        w("    v->len--;\n")
        w("    if (esz && out) memcpy(out, (char *)v->ptr + (size_t)v->len * esz, esz);\n")
        w("}\n")
    }
}

// --- moves, copies and drops of owning values ---------------------------------------------
//
// Box and vec moves, the Box free, the string and vec retains, the owned-vec
// drop, copy-on-write and reserve of owning elements, and the constant table
// used to sit in the runtime header, in every program. Codegen notes each one
// as it writes a call (`core_op`) and defines only those, after the header.
// The bodies are the header's C. They call only what stays there
// (`loam_vec_new`, `loam_vec_rc`, `loam_vec_reserve`, `loam_vec_grown_cap`,
// `loam_str_rc`, `loam_alloc_note`, `loam_panic`) and each other
// (`loam_vec_reserve_owned` calls `loam_vec_unique_owned`, defined first).
// A fn value is copy and never dropped (its env is borrowed), so it has no
// move or drop op at all.

enum CoreOp {
    MovePtr = 0,
    VecMove = 1,
    VecRetain = 2,
    VecDropOwned = 3,
    VecOf = 4,
    Drop = 5,
    StrRetain = 6,
    VecUniqueOwned = 7,
    VecReserveOwned = 8,
}
const CORE_OPS: int = 9

/** *`CORE_OP_USED[op]`: a call to that op was written. */
let mut CORE_OP_USED: []bool = []bool {}

fn core_ops_reset() {
    CORE_OP_USED = []bool {}
    for i in 0..CORE_OPS {
        push(CORE_OP_USED, false)
    }
}

fn core_op_name(op: int) -> string {
    switch op {
        case CoreOp.MovePtr:
            return "loam_move_ptr"
        case CoreOp.VecMove:
            return "loam_vec_move"
        case CoreOp.VecRetain:
            return "loam_vec_retain"
        case CoreOp.VecDropOwned:
            return "loam_vec_drop_owned"
        case CoreOp.VecOf:
            return "loam_vec_of"
        case CoreOp.Drop:
            return "loam_drop"
        case CoreOp.StrRetain:
            return "loam_str_retain"
        case CoreOp.VecUniqueOwned:
            return "loam_vec_unique_owned"
        case CoreOp.VecReserveOwned:
            return "loam_vec_reserve_owned"
    }
    fatal("internal: no core op {{op}}")
    return ""
}

/** *Note `op` (and the op its body calls) so its definition is emitted. */
fn note_core_op(op: int) {
    if CORE_OP_USED.len == 0 {
        core_ops_reset()
    }
    CORE_OP_USED[op] = true
    if op == CoreOp.VecReserveOwned {
        CORE_OP_USED[CoreOp.VecUniqueOwned] = true
    }
}

/** *The C name of `op`, noted so its definition is emitted. */
fn core_op(op: int) -> string {
    note_core_op(op)
    return core_op_name(op)
}

fn core_op_def(op: int) {
    switch op {
        case CoreOp.MovePtr:
            w("static inline void *loam_move_ptr(void **src) {\n")
            w("    void *p = src ? *src : NULL;\n")
            w("    if (src) *src = NULL;\n")
            w("    return p;\n")
            w("}\n")
            break
        case CoreOp.VecMove:
            w("static inline loam_vec loam_vec_move(loam_vec *src) {\n")
            w("    loam_vec v;\n")
            w("    v.ptr = NULL;\n")
            w("    v.len = 0;\n")
            w("    v.cap = 0;\n")
            w("    if (src) {\n")
            w("        v = *src;\n")
            w("        src->ptr = NULL;\n")
            w("        src->len = 0;\n")
            w("        src->cap = 0;\n")
            w("    }\n")
            w("    return v;\n")
            w("}\n")
            break
        case CoreOp.VecRetain:
            w("static inline loam_vec loam_vec_retain(const loam_vec *src) {\n")
            w("    loam_vec v = loam_vec_new();\n")
            w("    if (!src) return v;\n")
            w("    v = *src;\n")
            w("    if (v.ptr) (*loam_vec_rc(v.ptr))++;\n")
            w("    return v;\n")
            w("}\n")
            break
        case CoreOp.VecDropOwned:
            w("/* Drop one reference to a buffer whose elements own strings: only the\n")
            w("   last reference releases them, so a shared parameter's drop leaves the\n")
            w("   slots its caller still reads. */\n")
            w("static inline void loam_vec_drop_owned(loam_vec *v, size_t esz, loam_elem_fn release) {\n")
            w("    int64_t *rc;\n")
            w("    int64_t i, n;\n")
            w("    if (!v) return;\n")
            w("    if (!v->ptr) {\n")
            w("        v->len = 0;\n")
            w("        v->cap = 0;\n")
            w("        return;\n")
            w("    }\n")
            w("    rc = loam_vec_rc(v->ptr);\n")
            w("    if (--(*rc) > 0) {\n")
            w("        v->ptr = NULL;\n")
            w("        v->len = 0;\n")
            w("        v->cap = 0;\n")
            w("        return;\n")
            w("    }\n")
            w("    n = v->len;\n")
            w("    if (release)\n")
            w("        for (i = 0; i < n; i++) release((char *)v->ptr + (size_t)i * esz);\n")
            w("    free(rc);\n")
            w("    v->ptr = NULL;\n")
            w("    v->len = 0;\n")
            w("    v->cap = 0;\n")
            w("}\n")
            break
        case CoreOp.VecOf:
            w("/* A fresh list holding a copy of `n` plain elements, for a constant table. */\n")
            w("static inline loam_vec loam_vec_of(const void *src, int64_t n, size_t esz, const char *f, int l) {\n")
            w("    loam_vec v = loam_vec_new();\n")
            w("    loam_vec_reserve(&v, n, esz, f, l);\n")
            w("    memcpy(v.ptr, src, (size_t)n * esz);\n")
            w("    v.len = n;\n")
            w("    return v;\n")
            w("}\n")
            break
        case CoreOp.Drop:
            w("static inline void loam_drop(void **p) {\n")
            w("    if (p && *p) {\n")
            w("        free(*p);\n")
            w("        *p = NULL;\n")
            w("    }\n")
            w("}\n")
            break
        case CoreOp.StrRetain:
            // gcc follows the literal path (`own == 0`) after inlining and
            // warns; the `own` test makes it dead (see `loam_str_release`).
            w("#if defined(__GNUC__) && !defined(__clang__)\n")
            w("#pragma GCC diagnostic push\n")
            w("#pragma GCC diagnostic ignored \"-Wstringop-overflow\"\n")
            w("#endif\n")
            w("/** Take another reference to `s` (no-op for a literal). */\n")
            w("static inline void loam_str_retain(loam_str s) {\n")
            w("    if (s.own && s.ptr)\n")
            w("        __atomic_add_fetch(loam_str_rc(s.ptr), 1, __ATOMIC_RELAXED);\n")
            w("}\n")
            w("#if defined(__GNUC__) && !defined(__clang__)\n")
            w("#pragma GCC diagnostic pop\n")
            w("#endif\n")
            break
        case CoreOp.VecUniqueOwned:
            w("/* Un-share a buffer whose elements own strings: the copy retains every\n")
            w("   element it duplicates. */\n")
            w("static inline void loam_vec_unique_owned(loam_vec *v, size_t esz, loam_elem_fn retain,\n")
            w("                                         const char *f, int l) {\n")
            w("    int64_t *rc;\n")
            w("    void *raw;\n")
            w("    size_t bytes;\n")
            w("    int64_t i;\n")
            w("    if (!v || !v->ptr) return;\n")
            w("    rc = loam_vec_rc(v->ptr);\n")
            w("    if (*rc <= 1) return;\n")
            w("    bytes = sizeof(int64_t) + (esz ? (size_t)v->cap * esz : 1);\n")
            w("    raw = malloc(bytes);\n")
            w("    if (!raw) loam_panic(f, l, \"out of memory\");\n")
            w("    loam_alloc_note(bytes);\n")
            w("    *(int64_t *)raw = 1;\n")
            w("    if (v->len > 0 && esz) {\n")
            w("        memcpy((char *)raw + sizeof(int64_t), v->ptr, (size_t)v->len * esz);\n")
            w("        if (retain)\n")
            w("            for (i = 0; i < v->len; i++)\n")
            w("                retain((char *)raw + sizeof(int64_t) + (size_t)i * esz);\n")
            w("    }\n")
            w("    (*rc)--;\n")
            w("    v->ptr = (char *)raw + sizeof(int64_t);\n")
            w("}\n")
            break
        case CoreOp.VecReserveOwned:
            w("static inline void loam_vec_reserve_owned(loam_vec *v, int64_t n, size_t esz,\n")
            w("                                          loam_elem_fn retain, const char *f, int l) {\n")
            w("    int64_t cap;\n")
            w("    void *raw;\n")
            w("    if (!v) return;\n")
            w("    /* As loam_vec_reserve: a writer past `len` must own the buffer. */\n")
            w("    loam_vec_unique_owned(v, esz, retain, f, l);\n")
            w("    if (n <= v->cap) return;\n")
            w("    cap = loam_vec_grown_cap(v->cap, n, esz, f, l);\n")
            w("    if (!v->ptr) {\n")
            w("        raw = malloc(sizeof(int64_t) + (esz ? (size_t)cap * esz : 1));\n")
            w("        if (!raw) loam_panic(f, l, \"out of memory\");\n")
            w("        loam_alloc_note((size_t)cap * esz);\n")
            w("        *(int64_t *)raw = 1;\n")
            w("        v->ptr = (char *)raw + sizeof(int64_t);\n")
            w("        v->cap = cap;\n")
            w("        return;\n")
            w("    }\n")
            w("    raw = realloc((char *)v->ptr - sizeof(int64_t),\n")
            w("                  sizeof(int64_t) + (esz ? (size_t)cap * esz : 1));\n")
            w("    if (!raw) loam_panic(f, l, \"out of memory\");\n")
            w("    loam_alloc_note((size_t)cap * esz);\n")
            w("    v->ptr = (char *)raw + sizeof(int64_t);\n")
            w("    v->cap = cap;\n")
            w("}\n")
            break
    }
}

/** *A definition for every op the unit called, in `CoreOp` order. */
fn core_op_defs() {
    if CORE_OP_USED.len == 0 {
        return
    }
    for op in 0..CORE_OPS {
        if CORE_OP_USED[op] {
            core_op_def(op)
        }
    }
}

// --- wasm32: the C library ----------------------------------------------------------------
//
// A wasm32 program has no libc. What it needs (the heap, `abort`, `memcmp`,
// `strlen`, `write` to the host, the 128-bit multiply a checked i64 multiply
// lowers to) is written here into its own unit, so no runtime file ships for
// it. `memcpy`, `memmove` and `memset` are not functions at all: they are
// bulk-memory instructions (`wasm_inc/string.h`). In a shard build the head
// is every unit's precompiled header, so only the unit that owns the
// program's storage (`LOAM_SHARD_DEFS`) defines these.

/** *This unit is for `--target wasm32`. */
let mut WASM: bool = false

fn wasm_libc_defs() {
    if !WASM {
        return
    }
    if SHARD {
        w("#ifdef LOAM_SHARD_DEFS\n")
    }
    w("/* --- wasm32: the C library a program needs (no WASI, no libc) -------------\n")
    w("   Text goes out through the `zeus.write` import and an abort through\n")
    w("   `zeus.panic`. The heap starts at `__heap_base` (after the stack and the\n")
    w("   data) and grows the memory as it fills, so a program's memory is what it\n")
    w("   uses, not a fixed reservation. Free blocks live on a doubly linked list\n")
    w("   (payload[0] = next, payload[1] = prev); every block carries a footer\n")
    w("   duplicating its header, so `free` coalesces with the previous block\n")
    w("   without walking the heap, and `malloc` walks free blocks only. */\n")
    w("__attribute__((import_module(\"zeus\"), import_name(\"write\")))\n")
    w("void zeus_js_write(const char *p, int32_t n);\n")
    w("__attribute__((import_module(\"zeus\"), import_name(\"panic\")))\n")
    w("void zeus_js_panic(const char *p, int32_t n);\n")
    w("int errno;\n")
    w("extern unsigned char __heap_base;\n")
    w("\n")
    w("#define LOAM_HEAP_HDR 8u\n")
    w("#define LOAM_HEAP_FTR 8u\n")
    w("#define LOAM_HEAP_FREE ((size_t)1)\n")
    w("#define LOAM_PAGE ((size_t)65536)\n")
    w("/* At least 1 MB per grow, so a run of small allocations grows rarely. */\n")
    w("#define LOAM_GROW_MIN_PAGES ((size_t)16)\n")
    w("\n")
    w("static unsigned char *loamw_heap;  /* offsets count from here; the first block is at 8 */\n")
    w("static size_t loamw_heap_off;      /* end of the last block, from loamw_heap */\n")
    w("static size_t loamw_heap_cap;      /* bytes of memory after loamw_heap */\n")
    w("static size_t loamw_free_head;     /* offset of the first free block; 0 = none */\n")
    w("\n")
    w("static size_t loamw_align8(size_t n) { return (n + 7u) & ~(size_t)7u; }\n")
    w("static size_t loamw_pay(size_t bits) { return bits & ~LOAM_HEAP_FREE; }\n")
    w("static size_t *loamw_hdr_at(size_t off) { return (size_t *)(loamw_heap + off); }\n")
    w("static size_t *loamw_ftr_at(size_t off) {\n")
    w("    return (size_t *)(loamw_heap + off + LOAM_HEAP_HDR + loamw_pay(*loamw_hdr_at(off)));\n")
    w("}\n")
    w("static void *loamw_payload(size_t off) { return loamw_heap + off + LOAM_HEAP_HDR; }\n")
    w("static size_t loamw_fl_next(size_t o) { return ((size_t *)loamw_payload(o))[0]; }\n")
    w("static size_t loamw_fl_prev(size_t o) { return ((size_t *)loamw_payload(o))[1]; }\n")
    w("static void loamw_fl_set_next(size_t o, size_t v) { ((size_t *)loamw_payload(o))[0] = v; }\n")
    w("static void loamw_fl_set_prev(size_t o, size_t v) { ((size_t *)loamw_payload(o))[1] = v; }\n")
    w("\n")
    w("static void loamw_fl_unlink(size_t o) {\n")
    w("    size_t p = loamw_fl_prev(o), nx = loamw_fl_next(o);\n")
    w("    if (p) loamw_fl_set_next(p, nx);\n")
    w("    else loamw_free_head = nx;\n")
    w("    if (nx) loamw_fl_set_prev(nx, p);\n")
    w("}\n")
    w("\n")
    w("/* Mark a free block (header and footer) of `pay` bytes and list it. */\n")
    w("static void loamw_free_make(size_t off, size_t pay) {\n")
    w("    *loamw_hdr_at(off) = pay | LOAM_HEAP_FREE;\n")
    w("    *loamw_ftr_at(off) = pay | LOAM_HEAP_FREE;\n")
    w("    loamw_fl_set_next(off, loamw_free_head);\n")
    w("    loamw_fl_set_prev(off, 0);\n")
    w("    if (loamw_free_head) loamw_fl_set_prev(loamw_free_head, off);\n")
    w("    loamw_free_head = off;\n")
    w("}\n")
    w("\n")
    w("static void loamw_heap_init(void) {\n")
    w("    loamw_heap = (unsigned char *)loamw_align8((size_t)&__heap_base);\n")
    w("    loamw_heap_off = LOAM_HEAP_HDR; /* offset 0 means \"no block\" */\n")
    w("    loamw_heap_cap = __builtin_wasm_memory_size(0) * LOAM_PAGE - (size_t)loamw_heap;\n")
    w("}\n")
    w("\n")
    w("/* Room for `end` bytes after loamw_heap, growing the memory. 0 when the\n")
    w("   memory cannot grow. */\n")
    w("static int loamw_heap_reserve(size_t end) {\n")
    w("    size_t base = (size_t)loamw_heap, need, pages;\n")
    w("    loamw_heap_cap = __builtin_wasm_memory_size(0) * LOAM_PAGE - base;\n")
    w("    if (end <= loamw_heap_cap) return 1;\n")
    w("    need = (end - loamw_heap_cap + LOAM_PAGE - 1) / LOAM_PAGE;\n")
    w("    pages = need > LOAM_GROW_MIN_PAGES ? need : LOAM_GROW_MIN_PAGES;\n")
    w("    if (__builtin_wasm_memory_grow(0, pages) == (size_t)-1 &&\n")
    w("        (pages == need || __builtin_wasm_memory_grow(0, need) == (size_t)-1))\n")
    w("        return 0;\n")
    w("    loamw_heap_cap = __builtin_wasm_memory_size(0) * LOAM_PAGE - base;\n")
    w("    return 1;\n")
    w("}\n")
    w("\n")
    w("void *malloc(size_t n) {\n")
    w("    size_t off, pay, leftover, end;\n")
    w("    if (!n) n = 1;\n")
    w("    if (n > ((size_t)-1) / 2) return NULL;\n")
    w("    n = loamw_align8(n);\n")
    w("    if (n < 16) n = 16; /* a free block keeps two list links in its payload */\n")
    w("    if (!loamw_heap) loamw_heap_init();\n")
    w("    off = loamw_free_head;\n")
    w("    while (off) {\n")
    w("        if (off < LOAM_HEAP_HDR || off >= loamw_heap_off) { /* corrupt list: drop it */\n")
    w("            loamw_free_head = 0;\n")
    w("            break;\n")
    w("        }\n")
    w("        pay = loamw_pay(*loamw_hdr_at(off));\n")
    w("        if (pay >= n) {\n")
    w("            loamw_fl_unlink(off);\n")
    w("            leftover = pay - n;\n")
    w("            if (leftover >= LOAM_HEAP_HDR + 16 + LOAM_HEAP_FTR) { /* a new free block fits */\n")
    w("                *loamw_hdr_at(off) = n;\n")
    w("                *loamw_ftr_at(off) = n;\n")
    w("                loamw_free_make(off + LOAM_HEAP_HDR + n + LOAM_HEAP_FTR,\n")
    w("                               leftover - LOAM_HEAP_HDR - LOAM_HEAP_FTR);\n")
    w("            } else {\n")
    w("                *loamw_hdr_at(off) = pay;\n")
    w("                *loamw_ftr_at(off) = pay;\n")
    w("            }\n")
    w("            return loamw_payload(off);\n")
    w("        }\n")
    w("        off = loamw_fl_next(off);\n")
    w("    }\n")
    w("    off = loamw_heap_off;\n")
    w("    end = off + LOAM_HEAP_HDR + n + LOAM_HEAP_FTR;\n")
    w("    if (end > loamw_heap_cap && !loamw_heap_reserve(end)) return NULL;\n")
    w("    *loamw_hdr_at(off) = n;\n")
    w("    *loamw_ftr_at(off) = n;\n")
    w("    loamw_heap_off = end;\n")
    w("    return loamw_payload(off);\n")
    w("}\n")
    w("\n")
    w("void free(void *p) {\n")
    w("    size_t off, pay, nx, f;\n")
    w("    if (!p) return;\n")
    w("    off = (size_t)((unsigned char *)p - loamw_heap) - LOAM_HEAP_HDR;\n")
    w("    pay = loamw_pay(*loamw_hdr_at(off));\n")
    w("    /* Coalesce with the following block if it is free. */\n")
    w("    nx = off + LOAM_HEAP_HDR + pay + LOAM_HEAP_FTR;\n")
    w("    if (nx < loamw_heap_off && (*loamw_hdr_at(nx) & LOAM_HEAP_FREE)) {\n")
    w("        loamw_fl_unlink(nx);\n")
    w("        pay += LOAM_HEAP_HDR + loamw_pay(*loamw_hdr_at(nx)) + LOAM_HEAP_FTR;\n")
    w("    }\n")
    w("    /* Coalesce with the previous block, found through its footer. */\n")
    w("    if (off > LOAM_HEAP_HDR) { /* not the first block */\n")
    w("        f = *(size_t *)(loamw_heap + off - LOAM_HEAP_FTR);\n")
    w("        if (f & LOAM_HEAP_FREE) {\n")
    w("            size_t prev = off - LOAM_HEAP_FTR - loamw_pay(f) - LOAM_HEAP_HDR;\n")
    w("            loamw_fl_unlink(prev);\n")
    w("            pay += LOAM_HEAP_HDR + loamw_pay(f) + LOAM_HEAP_FTR;\n")
    w("            off = prev;\n")
    w("        }\n")
    w("    }\n")
    w("    loamw_free_make(off, pay);\n")
    w("}\n")
    w("\n")
    w("void *realloc(void *p, size_t n) {\n")
    w("    void *q;\n")
    w("    size_t old;\n")
    w("    if (!p) return malloc(n);\n")
    w("    old = loamw_pay(*(size_t *)((unsigned char *)p - LOAM_HEAP_HDR));\n")
    w("    if (n <= old) return p;\n")
    w("    q = malloc(n);\n")
    w("    if (!q) return NULL;\n")
    w("    memcpy(q, p, old);\n")
    w("    free(p);\n")
    w("    return q;\n")
    w("}\n")
    w("\n")
    w("/* Heap bytes in use (live), not the watermark: the blocks so far minus those\n")
    w("   on the free list. The wasm side of the RAM chip. */\n")
    w("int32_t zeus_heap_used(void) {\n")
    w("    size_t o = loamw_free_head, free_bytes = 0;\n")
    w("    if (!loamw_heap) return 0;\n")
    w("    while (o) {\n")
    w("        free_bytes += LOAM_HEAP_HDR + loamw_pay(*loamw_hdr_at(o)) + LOAM_HEAP_FTR;\n")
    w("        o = loamw_fl_next(o);\n")
    w("    }\n")
    w("    return (int32_t)(loamw_heap_off - LOAM_HEAP_HDR - free_bytes);\n")
    w("}\n")
    w("\n")
    w("__attribute__((noreturn)) void abort(void) {\n")
    w("    zeus_js_panic(\"abort\", 5);\n")
    w("    /* The import throws; if it returns, trap rather than spin. */\n")
    w("    __builtin_trap();\n")
    w("}\n")
    w("\n")
    w("int memcmp(const void *a, const void *b, size_t n) {\n")
    w("    const unsigned char *x = (const unsigned char *)a, *y = (const unsigned char *)b;\n")
    w("    size_t i;\n")
    w("    for (i = 0; i < n; i++)\n")
    w("        if (x[i] != y[i]) return (int)x[i] - (int)y[i];\n")
    w("    return 0;\n")
    w("}\n")
    w("\n")
    w("size_t strlen(const char *s) {\n")
    w("    size_t n = 0;\n")
    w("    if (!s) return 0;\n")
    w("    while (s[n]) n++;\n")
    w("    return n;\n")
    w("}\n")
    w("\n")
    w("ssize_t write(int fd, const void *p, size_t n) {\n")
    w("    (void)fd;\n")
    w("    if (p && n) zeus_js_write((const char *)p, (int32_t)n);\n")
    w("    return (ssize_t)n;\n")
    w("}\n")
    w("\n")
    w("/* compiler-rt's 128-bit multiply, which a checked i64 multiply lowers to on\n")
    w("   wasm32 and no wasm toolchain here ships. Never multiply `__int128` in it:\n")
    w("   that is a call to itself. */\n")
    w("static void loamw_mulu64(uint64_t a, uint64_t b, uint64_t *lo, uint64_t *hi) {\n")
    w("    uint64_t a0 = (uint32_t)a, a1 = a >> 32, b0 = (uint32_t)b, b1 = b >> 32;\n")
    w("    uint64_t p0 = a0 * b0, p1 = a0 * b1, p2 = a1 * b0, p3 = a1 * b1;\n")
    w("    uint64_t mid = (p0 >> 32) + (uint32_t)p1 + (uint32_t)p2;\n")
    w("    *lo = (p0 & 0xffffffffu) | (mid << 32);\n")
    w("    *hi = p3 + (p1 >> 32) + (p2 >> 32) + (mid >> 32);\n")
    w("}\n")
    w("\n")
    w("void __multi3(uint64_t out[2], uint64_t a_lo, uint64_t a_hi, uint64_t b_lo, uint64_t b_hi) {\n")
    w("    uint64_t lo, hi, t, t_hi;\n")
    w("    loamw_mulu64(a_lo, b_lo, &lo, &hi);\n")
    w("    loamw_mulu64(a_lo, b_hi, &t, &t_hi);\n")
    w("    hi += t;\n")
    w("    loamw_mulu64(a_hi, b_lo, &t, &t_hi);\n")
    w("    hi += t;\n")
    w("    out[0] = lo;\n")
    w("    out[1] = hi;\n")
    w("}\n")
    if SHARD {
        w("#endif\n")
    }
}

// --- runtime verbs ---------------------------------------------------------------------
//
// The C under std's bodyless fns (`buf`, `decimal`, `conv`, `floattext`,
// `str.slice`, `sys`, `thread`, the wasm `async` bridges), the `fmt` writers
// IR calls by name, and the `sys` shims `#[c]` bindings name. They used to sit
// in the runtime header, in every program. Codegen notes a group when it
// writes a call to one of its names, keeps a bodyless std fn, or keeps a
// binding to one, and defines only those groups, after the header. The bodies
// are the header's C, with its `#if` guards.

let RT_VERB_NAMES: []string = []string {
    "loam_fmt_write",
    "loam_fmt_ewrite",
    "loam_fmt_eq",
    "loam_str_slice",
    "loam_string_from_bytes",
    "loam_string_from_u8",
    "loam_buf_push_str",
    "loam_buf_push_bytes",
    "loam_buf_to_string",
    "loam_buf_prefix_to_string",
    "loam_buf_with_len",
    "loam_decimal_digits_len",
    "loam_decimal_text_of_digits",
    "loam_decimal_push_digits",
    "loam_decimal_write_digits",
    "loam_conv_f32_bits",
    "loam_floattext_bits_of",
    "loam_floattext_of_bits",
    "loam_floattext_text_len",
    "loam_floattext_text_of",
    "loam_floattext_write_text",
    "loam_argv_set",
    "loam_sys_argc",
    "loam_sys_arg",
    "loam_sys_wasm_exit",
    "loam_sys_strerror",
    "loam_sys_stat",
    "loam_dir_names",
    "loam_dir_name_at",
    "loam_dir_free",
    "loam_sys_lstat",
    "loam_sys_argv_fill",
    "loam_sys_errno",
    "loam_sys_spawnp",
    "loam_sys_read_fd",
    "loam_async_wasm_now_ms",
    "loam_async_wasm_sleep",
    "loam_ch_tab_lock",
    "loam_ch_tab_unlock",
    "loam_ch_block_alloc",
    "loam_ch_do_send",
    "loam_ch_do_try_send",
    "loam_ch_do_recv",
    "loam_ch_do_pop",
    "loam_ch_do_send_owned",
    "loam_ch_do_try_send_owned",
    "loam_ch_do_ready",
    "loam_thread_spawn",
    "loam_thread_running"
}

/** *`RT_VERB_GROUP[i]`: the group that defines `RT_VERB_NAMES[i]`. */
let RT_VERB_GROUP: []int = []int { 0, 0, 0, 1, 2, 2, 3, 3, 3, 3, 3, 4, 4, 4, 4, 5, 6, 6, 6, 6, 6, 7, 7, 7, 8, 9, 10, 11, 11, 11, 12, 13, 14, 15, 16, 17, 17, 18, 18, 18, 18, 18, 18, 18, 18, 18, 18, 18, 18 }
const RT_VERB_GROUPS: int = 19

let mut RT_GROUP_USED: []bool = []bool {}
/** *Per IR text id: 0 not looked up yet, 1 no verb, else the group + 2. */
let mut RT_TEXT_GROUP: []int = []int {}

fn rt_verbs_reset() {
    RT_GROUP_USED = []bool {}
    for i in 0..RT_VERB_GROUPS {
        push(RT_GROUP_USED, false)
    }
    RT_TEXT_GROUP = []int {}
}

/** *The group defining C name `name`, or -1. */
fn rt_verb_group(name: string) -> int {
    if !str.starts_with(name, "loam_") {
        return -1
    }
    for i in 0..RT_VERB_NAMES.len {
        if RT_VERB_NAMES[i] == name {
            return RT_VERB_GROUP[i]
        }
    }
    return -1
}

/** *A call to, or a kept declaration of, C name `name` was written. */
fn rt_note_name(name: string) {
    let gi = rt_verb_group(name)
    if gi >= 0 {
        if RT_GROUP_USED.len == 0 {
            rt_verbs_reset()
        }
        RT_GROUP_USED[gi] = true
    }
}

/** *As `rt_note_name`, for an IR call's interned name: one lookup per text. */
fn rt_note_text(t: int) {
    if t < 0 {
        return
    }
    if RT_GROUP_USED.len == 0 {
        rt_verbs_reset()
    }
    while RT_TEXT_GROUP.len <= t {
        push(RT_TEXT_GROUP, 0)
    }
    if RT_TEXT_GROUP[t] == 0 {
        RT_TEXT_GROUP[t] = rt_verb_group(ir.TEXTS[t]) + 2
    }
    if RT_TEXT_GROUP[t] >= 2 {
        RT_GROUP_USED[RT_TEXT_GROUP[t] - 2] = true
    }
}

fn rt_verb_def(gi: int) {
    switch gi {
        case 0: // fmt
            w("static inline void loam_fmt_write(loam_str s) {\n")
            w("    if (!s.ptr || s.len <= 0) return;\n")
            w("    loam_write_bytes(s.ptr, (size_t)s.len);\n")
            w("}\n")
            w("\n")
            w("/* The stderr twins of the writers above, for `fmt.eprintln` / `fmt.ewrite`:\n")
            w("   diagnostics must not mix with output a program sends to stdout. */\n")
            w("static inline void loam_fmt_ewrite(loam_str s) {\n")
            w("    if (!s.ptr || s.len <= 0) return;\n")
            w("    loam_ewrite_bytes(s.ptr, (size_t)s.len);\n")
            w("}\n")
            w("\n")
            w("static inline bool loam_fmt_eq(loam_str a, loam_str b) {\n")
            w("    if (a.len != b.len) return false;\n")
            w("    if (a.len <= 0) return true;\n")
            w("    if (!a.ptr || !b.ptr) return a.ptr == b.ptr;\n")
            w("    return memcmp(a.ptr, b.ptr, (size_t)a.len) == 0;\n")
            w("}\n")
            break
        case 1: // str_slice
            w("/** std:str `slice`: `s[a..b]`, bounds clamped to the string, in one copy. */\n")
            w("static inline loam_str loam_str_slice(loam_str s, int32_t a, int32_t b) {\n")
            w("    int64_t lo = a < 0 ? 0 : a;\n")
            w("    int64_t hi = b > s.len ? s.len : b;\n")
            w("    if (lo >= hi) return (loam_str){\"\", 0, 0};\n")
            w("    return loam_str_copy(s.ptr + lo, hi - lo);\n")
            w("}\n")
            break
        case 2: // string_from
            w("/* Takes ownership of `b` (IR_CALL steals []int). Trailing NUL for C hosts. */\n")
            w("static inline loam_str loam_string_from_bytes(loam_vec b) {\n")
            w("    int64_t n = b.len > 0 ? b.len : 0;\n")
            w("    char *p = loam_str_bytes(n);\n")
            w("    int32_t *el = (int32_t *)b.ptr;\n")
            w("    int64_t i;\n")
            w("    for (i = 0; i < n; i++)\n")
            w("        p[i] = (char)(el ? (el[i] & 255) : 0);\n")
            w("    p[n] = 0;\n")
            w("    loam_vec_drop(&b);\n")
            w("    return loam_str_owned(p, n);\n")
            w("}\n")
            w("\n")
            w("/** `string_from_bytes` for a `[]u8`. A vec and a string share a layout, so\n")
            w(" *  an unshared buffer with room for the NUL becomes the string: no copy. */\n")
            w("static inline loam_str loam_string_from_u8(loam_vec b) {\n")
            w("    if (b.ptr && b.cap > b.len && *loam_vec_rc(b.ptr) == 1) {\n")
            w("        ((char *)b.ptr)[b.len] = 0;\n")
            w("        return loam_str_owned((char *)b.ptr, b.len);\n")
            w("    }\n")
            w("    int64_t n = b.len > 0 ? b.len : 0;\n")
            w("    char *p = loam_str_bytes(n);\n")
            w("    if (n) memcpy(p, b.ptr, (size_t)n);\n")
            w("    p[n] = 0;\n")
            w("    loam_vec_drop(&b);\n")
            w("    return loam_str_owned(p, n);\n")
            w("}\n")
            break
        case 3: // buf
            w("/* --- std:buf — byte builders over `[]u8` ----------------------------------\n")
            w("   One memcpy per append, amortized O(1) growth from loam_vec_reserve: N pieces\n")
            w("   cost O(total bytes), not the O(N^2) of re-concatenating strings. */\n")
            w("static inline void loam_buf_push_str(loam_vec *b, loam_str s) {\n")
            w("    if (!b || !s.ptr || s.len <= 0) return;\n")
            w("    loam_vec_reserve(b, b->len + s.len, 1, \"buf.push_str\", 0);\n")
            w("    memcpy((char *)b->ptr + b->len, s.ptr, (size_t)s.len);\n")
            w("    b->len += s.len;\n")
            w("}\n")
            w("\n")
            w("static inline void loam_buf_push_bytes(loam_vec *b, const loam_vec *src) {\n")
            w("    /* The borrow rules keep `src` from being `b`; a copy-on-write sibling of\n")
            w("       `b` keeps its own reference, so its bytes outlive the reserve below. */\n")
            w("    if (!b || !src || !src->ptr || src->len <= 0) return;\n")
            w("    int64_t n = src->len;\n")
            w("    loam_vec_reserve(b, b->len + n, 1, \"buf.push_bytes\", 0);\n")
            w("    memcpy((char *)b->ptr + b->len, src->ptr, (size_t)n);\n")
            w("    b->len += n;\n")
            w("}\n")
            w("\n")
            w("/** A string copy of the bytes; the buffer stays usable. */\n")
            w("static inline loam_str loam_buf_to_string(const loam_vec *b) {\n")
            w("    if (!b || !b->ptr || b->len <= 0) return (loam_str){\"\", 0};\n")
            w("    return loam_str_copy((const char *)b->ptr, b->len);\n")
            w("}\n")
            w("\n")
            w("/* `buf.prefix_to_string(b, n)`: the first `n` bytes (clamped to the length)\n")
            w("   as a string, one exact copy. For a buffer the kernel filled part of. */\n")
            w("static inline loam_str loam_buf_prefix_to_string(const loam_vec *b, int64_t n) {\n")
            w("    if (!b || !b->ptr || n <= 0) return (loam_str){\"\", 0};\n")
            w("    return loam_str_copy((const char *)b->ptr, n < b->len ? n : b->len);\n")
            w("}\n")
            w("\n")
            w("/* `buf.with_len(n)`: one allocation of `n` zeroed bytes, for a buffer C fills\n")
            w("   (`fread`, `getcwd`), instead of a push loop's check per byte. The spare\n")
            w("   byte keeps `string_from_bytes` copy-free when `n` is a power of two. */\n")
            w("static inline loam_vec loam_buf_with_len(int64_t n) {\n")
            w("    loam_vec v = loam_vec_new();\n")
            w("    if (n > 0) {\n")
            w("        loam_vec_reserve(&v, n + 1, 1, \"buf.with_len\", 0);\n")
            w("        memset(v.ptr, 0, (size_t)n);\n")
            w("        v.len = n;\n")
            w("    }\n")
            w("    return v;\n")
            w("}\n")
            break
        case 4: // decimal
            w("/* std:decimal hands on `d[first..20]`, digits it made on the stack. */\n")
            w("static inline int64_t loam_decimal_digits_len(int32_t first) {\n")
            w("    if (first < 0 || first > 20) loam_panic(\"decimal\", 0, \"digits out of range\");\n")
            w("    return 20 - (int64_t)first;\n")
            w("}\n")
            w("\n")
            w("static inline loam_str loam_decimal_text_of_digits(const uint8_t *d, int32_t first) {\n")
            w("    return loam_str_copy((const char *)d + first, loam_decimal_digits_len(first));\n")
            w("}\n")
            w("\n")
            w("static inline void loam_decimal_push_digits(loam_vec *b, const uint8_t *d, int32_t first) {\n")
            w("    int64_t n = loam_decimal_digits_len(first);\n")
            w("    if (!b) return;\n")
            w("    loam_vec_reserve(b, b->len + n, 1, \"buf.push_int\", 0);\n")
            w("    memcpy((char *)b->ptr + b->len, d + first, (size_t)n);\n")
            w("    b->len += n;\n")
            w("}\n")
            w("\n")
            w("static inline void loam_decimal_write_digits(const uint8_t *d, int32_t first, bool to_err) {\n")
            w("    int64_t n = loam_decimal_digits_len(first);\n")
            w("    if (to_err) loam_ewrite_bytes((const char *)d + first, (size_t)n);\n")
            w("    else loam_write_bytes((const char *)d + first, (size_t)n);\n")
            w("}\n")
            break
        case 5: // conv
            w("/* `std:key` reads a float's bytes for its content key. A value conversion\n")
            w("   would round (`1.5 as u32` is 1); only `memcpy` sees the raw bytes. */\n")
            w("static inline uint32_t loam_conv_f32_bits(float v) {\n")
            w("    uint32_t out = 0;\n")
            w("    memcpy(&out, &v, sizeof out);\n")
            w("    return out;\n")
            w("}\n")
            break
        case 6: // floattext
            w("/* std:floattext: a double's bits both ways, and the text it made on the\n")
            w("   stack, `d[0..len]`. */\n")
            w("static inline uint64_t loam_floattext_bits_of(double v) {\n")
            w("    uint64_t out = 0;\n")
            w("    memcpy(&out, &v, sizeof out);\n")
            w("    return out;\n")
            w("}\n")
            w("static inline double loam_floattext_of_bits(uint64_t u) {\n")
            w("    double out = 0;\n")
            w("    memcpy(&out, &u, sizeof out);\n")
            w("    return out;\n")
            w("}\n")
            w("static inline int64_t loam_floattext_text_len(int32_t len) {\n")
            w("    if (len < 0 || len > 32) loam_panic(\"floattext\", 0, \"text out of range\");\n")
            w("    return (int64_t)len;\n")
            w("}\n")
            w("static inline loam_str loam_floattext_text_of(const uint8_t *d, int32_t len) {\n")
            w("    return loam_str_copy((const char *)d, loam_floattext_text_len(len));\n")
            w("}\n")
            w("static inline void loam_floattext_write_text(const uint8_t *d, int32_t len, bool to_err) {\n")
            w("    int64_t n = loam_floattext_text_len(len);\n")
            w("    if (to_err) loam_ewrite_bytes((const char *)d, (size_t)n);\n")
            w("    else loam_write_bytes((const char *)d, (size_t)n);\n")
            w("}\n")
            break
        case 7: // argv
            w("#ifdef __wasm32__\n")
            w("/* No process and no command line in wasm: the host calls the entry with no\n")
            w("   arguments, so `sys.argc()` is 0 and `sys.arg(i)` is empty. */\n")
            w("static inline void loam_argv_set(int argc, char **argv) {\n")
            w("    (void)argc;\n")
            w("    (void)argv;\n")
            w("}\n")
            w("static inline int64_t loam_sys_argc(void) { return 0; }\n")
            w("static inline loam_str loam_sys_arg(int64_t i) {\n")
            w("    (void)i;\n")
            w("    return (loam_str){\"\", 0};\n")
            w("}\n")
            w("#else\n")
            w("/* The process's command line, handed over by the generated entry before any\n")
            w("   other statement runs (`emit_main_args` in codegen_c.c). Zero on iOS and\n")
            w("   Android, where the host owns `main` and passes nothing. */\n")
            w("LOAM_RT_STATE int loam_argc;\n")
            w("LOAM_RT_STATE char **loam_argv;\n")
            w("\n")
            w("static inline void loam_argv_set(int argc, char **argv) {\n")
            w("    loam_argc = argc;\n")
            w("    loam_argv = argv;\n")
            w("#ifdef _WIN32\n")
            w("    /* Bytes out are the bytes written: text mode would turn every `\\n` into\n")
            w("       `\\r\\n`, and generated C must be identical on every platform. */\n")
            w("    _setmode(1, 0x8000 /* _O_BINARY */);\n")
            w("    _setmode(2, 0x8000);\n")
            w("#endif\n")
            w("}\n")
            w("\n")
            w("static inline int64_t loam_sys_argc(void) { return (int64_t)loam_argc; }\n")
            w("\n")
            w("/* Points straight into the process's own argument vector: it lives exactly as\n")
            w("   long as the process does, so there is nothing to copy and nothing to free. */\n")
            w("static inline loam_str loam_sys_arg(int64_t i) {\n")
            w("    if (i < 0 || i >= (int64_t)loam_argc || !loam_argv || !loam_argv[i])\n")
            w("        return (loam_str){\"\", 0};\n")
            w("    return (loam_str){loam_argv[i], (int64_t)strlen(loam_argv[i])};\n")
            w("}\n")
            w("#endif\n")
            break
        case 8: // wasm_exit
            w("#ifdef __wasm32__\n")
            w("/* `sys.env` / `sys.env_set` / `sys.exit` live in `std/sys.loam` (R2.3c);\n")
            w("   wasm's `exit` traps through this hook. */\n")
            w("static inline void loam_sys_wasm_exit(void) { abort(); }\n")
            w("#endif\n")
            break
        case 9: // strerror
            w("#ifndef __wasm32__\n")
            w("/* `strerror(errno)` for the `sys` Loam bindings: the error is always the\n")
            w("   current one, so the binding takes no argument and C reads `errno` itself.\n")
            w("   A `const char *`, the `#[c]` string-return ABI: the wrapper copies it (a\n")
            w("   `loam_str` return would come back through a struct-return slot the wrapper\n")
            w("   never passes). Declared here, defined once in the owning unit (the\n")
            w("   `LOAM_RT_DEFINE_JMP` block below), like the trap state: the `#[c]` wrapper\n")
            w("   references it as a symbol. */\n")
            w("const char *loam_sys_strerror(void);\n")
            w("#ifdef LOAM_RT_DEFINE_JMP\n")
            w("const char *loam_sys_strerror(void) {\n")
            w("    return strerror(errno);\n")
            w("}\n")
            w("#endif\n")
            w("#endif\n")
            break
        case 10: // stat
            w("#ifndef __wasm32__\n")
            w("/* One `stat(2)` for the `sys` Loam bindings: the layout differs per OS, so\n")
            w("   Loam cannot read the struct itself. `out` takes five slots\n")
            w("   (mtime-sec, mtime-nsec, size, is-regular, is-dir); `1` when the path\n")
            w("   stats, else `0`. The sub-second field is per target (macOS `st_mtimespec`,\n")
            w("   Linux `st_mtim`, elsewhere whole seconds); the type tests use `S_ISREG` /\n")
            w("   `S_ISDIR`, which are macros Loam cannot name. Declared here, defined once\n")
            w("   in the owning unit (see `loam_sys_strerror` above): the `#[c]` wrapper\n")
            w("   references it as a symbol. */\n")
            w("int loam_sys_stat(const char *path, int64_t *out);\n")
            w("#ifdef LOAM_RT_DEFINE_JMP\n")
            w("int loam_sys_stat(const char *path, int64_t *out) {\n")
            w("    struct stat st;\n")
            w("    if (!path || !out || stat(path, &st) != 0) return 0;\n")
            w("#if defined(__APPLE__)\n")
            w("    out[0] = (int64_t)st.st_mtimespec.tv_sec;\n")
            w("    out[1] = (int64_t)st.st_mtimespec.tv_nsec;\n")
            w("#elif defined(__linux__)\n")
            w("    out[0] = (int64_t)st.st_mtim.tv_sec;\n")
            w("    out[1] = (int64_t)st.st_mtim.tv_nsec;\n")
            w("#else\n")
            w("    out[0] = (int64_t)st.st_mtime;\n")
            w("    out[1] = 0;\n")
            w("#endif\n")
            w("    out[2] = (int64_t)st.st_size;\n")
            w("    out[3] = S_ISREG(st.st_mode) ? 1 : 0;\n")
            w("    out[4] = S_ISDIR(st.st_mode) ? 1 : 0;\n")
            w("    return 1;\n")
            w("}\n")
            w("#endif\n")
            w("#endif\n")
            break
        case 11: // dir
            w("#ifndef __wasm32__\n")
            w("/**\n")
            w(" * Names in `dirpath`, `.` and `..` excluded, *unsorted*: sorting moved to\n")
            w(" * Loam (`sys.list_dir`, R2.2), over a raw `strcmp` binding. Each name and the\n")
            w(" * array belong to the caller (see `loam_dir_free`); `*out` is NULL when the\n")
            w(" * directory cannot be read, which is not an error worth reporting — an\n")
            w(" * unreadable directory is an empty one as far as a walk is concerned.\n")
            w(" * Declared here, defined once in the owning unit (see `loam_sys_strerror`\n")
            w(" * above): the `#[c]` wrappers reference these as symbols.\n")
            w(" */\n")
            w("int64_t loam_dir_names(const char *dirpath, char ***out);\n")
            w("const char *loam_dir_name_at(char **names, int64_t i);\n")
            w("void loam_dir_free(char **names, int64_t n);\n")
            w("#ifdef LOAM_RT_DEFINE_JMP\n")
            w("int64_t loam_dir_names(const char *dirpath, char ***out) {\n")
            w("    DIR *d = opendir(dirpath);\n")
            w("    struct dirent *e;\n")
            w("    char **names = NULL;\n")
            w("    int64_t n = 0, cap = 0;\n")
            w("    if (!d) {\n")
            w("        *out = NULL;\n")
            w("        return 0;\n")
            w("    }\n")
            w("    while ((e = readdir(d)) != NULL) {\n")
            w("        size_t len;\n")
            w("        if (e->d_name[0] == '.' &&\n")
            w("            (e->d_name[1] == 0 || (e->d_name[1] == '.' && e->d_name[2] == 0)))\n")
            w("            continue;\n")
            w("        if (n == cap) {\n")
            w("            cap = cap ? cap * 2 : 32;\n")
            w("            names = (char **)realloc(names, (size_t)cap * sizeof *names);\n")
            w("            if (!names) {\n")
            w("                closedir(d);\n")
            w("                *out = NULL;\n")
            w("                return 0;\n")
            w("            }\n")
            w("        }\n")
            w("        len = strlen(e->d_name);\n")
            w("        names[n] = (char *)malloc(len + 1);\n")
            w("        if (!names[n]) break;\n")
            w("        memcpy(names[n], e->d_name, len + 1);\n")
            w("        n++;\n")
            w("    }\n")
            w("    closedir(d);\n")
            w("    *out = names;\n")
            w("    return n;\n")
            w("}\n")
            w("\n")
            w("const char *loam_dir_name_at(char **names, int64_t i) {\n")
            w("    return names ? names[i] : \"\";\n")
            w("}\n")
            w("\n")
            w("void loam_dir_free(char **names, int64_t n) {\n")
            w("    int64_t i;\n")
            w("    for (i = 0; i < n; i++) free(names[i]);\n")
            w("    free(names);\n")
            w("}\n")
            w("#endif\n")
            w("#endif\n")
            break
        case 12: // lstat
            w("#ifndef __wasm32__\n")
            w("/* One `lstat(2)` for `remove_path`: like `loam_sys_stat` (same gate) but a\n")
            w("   symlink stays a link — `stat` would follow it into its target's tree. */\n")
            w("int loam_sys_lstat(const char *path, int64_t *out);\n")
            w("#ifdef LOAM_RT_DEFINE_JMP\n")
            w("int loam_sys_lstat(const char *path, int64_t *out) {\n")
            w("    struct stat st;\n")
            w("    if (!path || !out || lstat(path, &st) != 0) return 0;\n")
            w("    out[0] = 1;\n")
            w("    out[1] = S_ISDIR(st.st_mode) ? 1 : 0;\n")
            w("    return 1;\n")
            w("}\n")
            w("#endif\n")
            w("#endif\n")
            break
        case 13: // argv_fill
            w("#ifndef __wasm32__\n")
            w("/* `sys.spawn` lays a `char **` over Loam-owned slots (8 bytes each, so any\n")
            w("   pointer width fits). */\n")
            w("void loam_sys_argv_fill(char *block, const int64_t *offsets, int64_t n, int64_t *slots);\n")
            w("#ifdef LOAM_RT_DEFINE_JMP\n")
            w("void loam_sys_argv_fill(char *block, const int64_t *offsets, int64_t n, int64_t *slots) {\n")
            w("    char **av = (char **)slots;\n")
            w("    for (int64_t i = 0; i < n; i++) av[i] = block + offsets[i];\n")
            w("    av[n] = NULL;\n")
            w("}\n")
            w("#endif\n")
            w("#endif\n")
            break
        case 14: // errno
            w("#ifndef __wasm32__\n")
            w("/* `errno` is a macro no binding can name; `waitpid` retries on `EINTR`. */\n")
            w("int loam_sys_errno(void);\n")
            w("#ifdef LOAM_RT_DEFINE_JMP\n")
            w("int loam_sys_errno(void) { return errno; }\n")
            w("#endif\n")
            w("#endif\n")
            break
        case 15: // spawnp
            w("#if !defined(__wasm32__) && !defined(_WIN32)\n")
            w("/* `environ` is a variable, which no binding can name. */\n")
            w("#include <spawn.h>\n")
            w("extern char **environ;\n")
            w("int loam_sys_spawnp(int32_t *pid, const char *file, int64_t *argv);\n")
            w("#ifdef LOAM_RT_DEFINE_JMP\n")
            w("int loam_sys_spawnp(int32_t *pid, const char *file, int64_t *argv) {\n")
            w("    pid_t p = 0;\n")
            w("    int r = posix_spawnp(&p, file, NULL, NULL, (char **)argv, environ);\n")
            w("    *pid = (int32_t)p;\n")
            w("    return r;\n")
            w("}\n")
            w("#endif\n")
            w("#endif\n")
            break
        case 16: // read_fd
            w("#ifndef __wasm32__\n")
            w("/* `sys.read_stdin` / `sys.read_line` live in `std/sys.loam` (R2.4), over\n")
            w("   this one hook and raw `read`. `sys.read_fd(fd, n)`: up to `n` bytes of\n")
            w("   `fd` into a fresh buffer whose length is what `read` returned, retried on\n")
            w("   `EINTR`; no byte is unwritten and none is zeroed first. */\n")
            w("static inline loam_vec loam_sys_read_fd(int64_t fd, int64_t n) {\n")
            w("    loam_vec v = loam_vec_new();\n")
            w("    if (n <= 0) return v;\n")
            w("    loam_vec_reserve(&v, n + 1, 1, \"sys.read_fd\", 0);\n")
            w("    while (v.len < n) {\n")
            w("        ssize_t r = read((int)fd, (char *)v.ptr + v.len, (size_t)(n - v.len));\n")
            w("        if (r < 0 && errno == EINTR) continue;\n")
            w("        if (r <= 0) break;\n")
            w("        v.len += r;\n")
            w("    }\n")
            w("    return v;\n")
            w("}\n")
            w("#endif\n")
            break
        case 17: // async_wasm
            w("#ifdef __wasm32__\n")
            w("/* `std:async` binds `clock_gettime` / `nanosleep` itself on native (`#[c]`);\n")
            w("   wasm binds no libc, so the two wasm bridges live here (like `sys.wasm_exit`\n")
            w("   bridges `abort`): the clock is the `zeus_js_now_ms` host import\n")
            w("   (`loam_now_ms`, above), and the sleep is its spin. */\n")
            w("static inline int64_t loam_async_wasm_now_ms(void) { return loam_now_ms(); }\n")
            w("static inline void loam_async_wasm_sleep(int64_t ms) {\n")
            w("    int64_t t0 = loam_now_ms();\n")
            w("    while (loam_now_ms() - t0 < ms) {\n")
            w("    }\n")
            w("}\n")
            w("#endif\n")
            break
        case 18: // thread
            w("/* --- thread + channel: std/thread.loam. The ABI is a detached pthread and a ---\n")
            w("   --- bounded FIFO of byte payloads guarded by a mutex + two condvars. All ---\n")
            w("   --- queue/dispatch policy lives in Loam; this is only the synchronization. --- */\n")
            w("\n")
            w("#ifndef __wasm32__\n")
            w("#include <pthread.h>\n")
            w("\n")
            w("LOAM_RT_STATE int64_t loam_thread_live;          /* detached workers still running */\n")
            w("LOAM_RT_STATE pthread_mutex_t loam_thread_mtx LOAM_RT_INIT(PTHREAD_MUTEX_INITIALIZER);\n")
            w("LOAM_RT_STATE pthread_mutex_t loam_ch_tab_mtx LOAM_RT_INIT(PTHREAD_MUTEX_INITIALIZER);\n")
            w("\n")
            w("/* The table lock for `std:thread`'s Loam id table: held across every table\n")
            w("   read and write there, so a worker fetching a cookie races nothing. Plain\n")
            w("   C functions (not `static inline`): the `#[c]` wrappers reference them as\n")
            w("   symbols, like `loam_sys_stat` below. */\n")
            w("int loam_ch_tab_lock(void);\n")
            w("int loam_ch_tab_unlock(void);\n")
            w("#ifdef LOAM_RT_DEFINE_JMP\n")
            w("int loam_ch_tab_lock(void) {\n")
            w("    return pthread_mutex_lock(&loam_ch_tab_mtx);\n")
            w("}\n")
            w("int loam_ch_tab_unlock(void) {\n")
            w("    return pthread_mutex_unlock(&loam_ch_tab_mtx);\n")
            w("}\n")
            w("#endif\n")
            w("\n")
            w("/* --- channel: std/thread.loam. The ABI is a detached pthread and a bounded\n")
            w("   FIFO of byte payloads guarded by a mutex + two condvars. R3.2: the id\n")
            w("   table and S0 keys live in Loam (`ch_slots`); C owns one sync block per\n")
            w("   channel (below), named by an opaque cookie, plus one atomic section per\n")
            w("   op. A 0 cookie names nothing: the section no-ops, as a dead id did. */\n")
            w("\n")
            w("typedef struct {\n")
            w("    unsigned char *buf;     /* cap * esz ring */\n")
            w("    size_t esz;             /* payload byte size (sizeof T) */\n")
            w("    int64_t cap;            /* slots */\n")
            w("    int64_t head;           /* first live slot */\n")
            w("    int64_t count;          /* live slots */\n")
            w("    pthread_mutex_t mtx;\n")
            w("    pthread_cond_t has_data, has_space;\n")
            w("} loam_ch;\n")
            w("\n")
            w("/* The sync block for `cap` slots of `esz` bytes. The cookie is the block\n")
            w("   address; Loam files it in its id table under the payload type's key.\n")
            w("   Declared here, defined once in the owning unit (like `loam_sys_stat`):\n")
            w("   the `#[c]` wrapper references it as a symbol. */\n")
            w("int64_t loam_ch_block_alloc(int64_t cap, size_t esz);\n")
            w("#ifdef LOAM_RT_DEFINE_JMP\n")
            w("int64_t loam_ch_block_alloc(int64_t cap, size_t esz) {\n")
            w("    loam_ch *c;\n")
            w("    if (cap < 1) cap = 1;\n")
            w("    if (esz < 1) esz = 1;\n")
            w("    c = (loam_ch *)loam_new(sizeof(loam_ch), \"channel\", 0);\n")
            w("    c->buf = (unsigned char *)loam_new((size_t)cap * esz, \"channel\", 0);\n")
            w("    c->esz = esz;\n")
            w("    c->cap = cap;\n")
            w("    c->head = 0;\n")
            w("    c->count = 0;\n")
            w("    pthread_mutex_init(&c->mtx, NULL);\n")
            w("    pthread_cond_init(&c->has_data, NULL);\n")
            w("    pthread_cond_init(&c->has_space, NULL);\n")
            w("    return (int64_t)(intptr_t)c;\n")
            w("}\n")
            w("#endif\n")
            w("\n")
            w("static inline loam_ch *loam_ch_from_cookie(int64_t cookie) {\n")
            w("    if (!cookie) return NULL;\n")
            w("    return (loam_ch *)(intptr_t)cookie;\n")
            w("}\n")
            w("\n")
            w("static inline void loam_ch_do_send(int64_t cookie, const void *val, size_t sz) {\n")
            w("    loam_ch *c = loam_ch_from_cookie(cookie);\n")
            w("    if (!c || !val) return;\n")
            w("    pthread_mutex_lock(&c->mtx);\n")
            w("    while (c->count == c->cap) pthread_cond_wait(&c->has_space, &c->mtx);\n")
            w("    if (sz > c->esz) sz = c->esz;\n")
            w("    if (sz)\n")
            w("        memcpy(c->buf + (size_t)((c->head + c->count) % c->cap) * c->esz, val, sz);\n")
            w("    c->count++;\n")
            w("    pthread_cond_signal(&c->has_data);\n")
            w("    pthread_mutex_unlock(&c->mtx);\n")
            w("}\n")
            w("\n")
            w("static inline int64_t loam_ch_do_try_send(int64_t cookie, const void *val, size_t sz) {\n")
            w("    loam_ch *c = loam_ch_from_cookie(cookie);\n")
            w("    if (!c || !val) return 0;\n")
            w("    pthread_mutex_lock(&c->mtx);\n")
            w("    if (c->count == c->cap) {\n")
            w("        pthread_mutex_unlock(&c->mtx);\n")
            w("        return 0;\n")
            w("    }\n")
            w("    if (sz > c->esz) sz = c->esz;\n")
            w("    if (sz)\n")
            w("        memcpy(c->buf + (size_t)((c->head + c->count) % c->cap) * c->esz, val, sz);\n")
            w("    c->count++;\n")
            w("    pthread_cond_signal(&c->has_data);\n")
            w("    pthread_mutex_unlock(&c->mtx);\n")
            w("    return 1;\n")
            w("}\n")
            w("\n")
            w("static inline void loam_ch_do_recv(int64_t cookie, void *out, size_t sz) {\n")
            w("    loam_ch *c = loam_ch_from_cookie(cookie);\n")
            w("    if (!c || !out) return;\n")
            w("    pthread_mutex_lock(&c->mtx);\n")
            w("    while (c->count == 0) pthread_cond_wait(&c->has_data, &c->mtx);\n")
            w("    if (sz > c->esz) sz = c->esz;\n")
            w("    if (sz) memcpy(out, c->buf + (size_t)c->head * c->esz, sz);\n")
            w("    c->head = (c->head + 1) % c->cap;\n")
            w("    c->count--;\n")
            w("    pthread_cond_signal(&c->has_space);\n")
            w("    pthread_mutex_unlock(&c->mtx);\n")
            w("}\n")
            w("\n")
            w("static inline int64_t loam_ch_do_pop(int64_t cookie, void *out, size_t sz) {\n")
            w("    loam_ch *c = loam_ch_from_cookie(cookie);\n")
            w("    if (!c || !out) return 0;\n")
            w("    pthread_mutex_lock(&c->mtx);\n")
            w("    if (c->count == 0) {\n")
            w("        pthread_mutex_unlock(&c->mtx);\n")
            w("        return 0;\n")
            w("    }\n")
            w("    if (sz > c->esz) sz = c->esz;\n")
            w("    if (sz) memcpy(out, c->buf + (size_t)c->head * c->esz, sz);\n")
            w("    c->head = (c->head + 1) % c->cap;\n")
            w("    c->count--;\n")
            w("    pthread_cond_signal(&c->has_space);\n")
            w("    pthread_mutex_unlock(&c->mtx);\n")
            w("    return 1;\n")
            w("}\n")
            w("\n")
            w("/* --- channels with owning payloads --------------------------------------\n")
            w("   A queued slot aliases the payload bytes, so the channel takes a reference\n")
            w("   when it enqueues one; `recv`/`pop` copy the slot out and with it the\n")
            w("   reference (the head advances past the slot, so the channel never releases\n")
            w("   it). A payload still queued when the channel dies is not released — bounded,\n")
            w("   and only when a producer enqueues what no consumer drains. */\n")
            w("static inline void loam_ch_do_send_owned(int64_t cookie, const void *val, size_t sz,\n")
            w("                                         loam_elem_fn retain) {\n")
            w("    loam_ch *c = loam_ch_from_cookie(cookie);\n")
            w("    if (!c || !val) return;\n")
            w("    pthread_mutex_lock(&c->mtx);\n")
            w("    while (c->count == c->cap) pthread_cond_wait(&c->has_space, &c->mtx);\n")
            w("    if (retain) retain((void *)val);\n")
            w("    if (sz > c->esz) sz = c->esz;\n")
            w("    if (sz)\n")
            w("        memcpy(c->buf + (size_t)((c->head + c->count) % c->cap) * c->esz, val, sz);\n")
            w("    c->count++;\n")
            w("    pthread_cond_signal(&c->has_data);\n")
            w("    pthread_mutex_unlock(&c->mtx);\n")
            w("}\n")
            w("\n")
            w("static inline int64_t loam_ch_do_try_send_owned(int64_t cookie, const void *val, size_t sz,\n")
            w("                                                loam_elem_fn retain) {\n")
            w("    loam_ch *c = loam_ch_from_cookie(cookie);\n")
            w("    if (!c || !val) return 0;\n")
            w("    pthread_mutex_lock(&c->mtx);\n")
            w("    if (c->count == c->cap) {\n")
            w("        pthread_mutex_unlock(&c->mtx);\n")
            w("        return 0;\n")
            w("    }\n")
            w("    if (retain) retain((void *)val);\n")
            w("    if (sz > c->esz) sz = c->esz;\n")
            w("    if (sz)\n")
            w("        memcpy(c->buf + (size_t)((c->head + c->count) % c->cap) * c->esz, val, sz);\n")
            w("    c->count++;\n")
            w("    pthread_cond_signal(&c->has_data);\n")
            w("    pthread_mutex_unlock(&c->mtx);\n")
            w("    return 1;\n")
            w("}\n")
            w("\n")
            w("static inline int64_t loam_ch_do_ready(int64_t cookie) {\n")
            w("    loam_ch *c = loam_ch_from_cookie(cookie);\n")
            w("    int64_t r;\n")
            w("    if (!c) return 0;\n")
            w("    pthread_mutex_lock(&c->mtx);\n")
            w("    r = c->count;\n")
            w("    pthread_mutex_unlock(&c->mtx);\n")
            w("    return r;\n")
            w("}\n")
            w("\n")
            w("typedef struct {\n")
            w("    loam_fn cb;\n")
            w("} loam_thread_arg;\n")
            w("\n")
            w("static void *loam_thread_entry(void *p) {\n")
            w("    loam_thread_arg *a = (loam_thread_arg *)p;\n")
            w("    loam_fn cb = a->cb;\n")
            w("    free(a);\n")
            w("    ((void (*)(void *))cb.fn)(cb.env);\n")
            w("    pthread_mutex_lock(&loam_thread_mtx);\n")
            w("    loam_thread_live--;\n")
            w("    pthread_mutex_unlock(&loam_thread_mtx);\n")
            w("    return NULL;\n")
            w("}\n")
            w("\n")
            w("/* Bodyless `thread.spawn(cb: fn())`. Detached: results come back through\n")
            w("   channel<T>, never through join. The fn env is leaked by design (fn values\n")
            w("   are never freed), so the worker outlives the spawn callsite safely. */\n")
            w("static inline void loam_thread_spawn(loam_fn cb) {\n")
            w("    pthread_t t;\n")
            w("    loam_thread_arg *a;\n")
            w("    if (!cb.fn) return;\n")
            w("    a = (loam_thread_arg *)loam_new(sizeof(loam_thread_arg), \"thread.spawn\", 0);\n")
            w("    a->cb = cb;\n")
            w("    if (pthread_create(&t, NULL, loam_thread_entry, a) != 0) {\n")
            w("        free(a);\n")
            w("        loam_panic(__FILE__, __LINE__, \"thread.spawn: pthread_create failed\");\n")
            w("    }\n")
            w("    pthread_detach(t);\n")
            w("    pthread_mutex_lock(&loam_thread_mtx);\n")
            w("    loam_thread_live++;\n")
            w("    pthread_mutex_unlock(&loam_thread_mtx);\n")
            w("}\n")
            w("\n")
            w("static inline int64_t loam_thread_running(void) {\n")
            w("    int64_t n;\n")
            w("    pthread_mutex_lock(&loam_thread_mtx);\n")
            w("    n = loam_thread_live;\n")
            w("    pthread_mutex_unlock(&loam_thread_mtx);\n")
            w("    return n;\n")
            w("}\n")
            w("#else /* __wasm32__: no threads; channel ops are inert so std:thread compiles */\n")
            w("/* The cookies name nothing: the Loam table still hands out ids and checks\n")
            w("   keys, but no bytes ever move. */\n")
            w("static inline void loam_ch_do_send(int64_t cookie, const void *val, size_t sz) {\n")
            w("    (void)cookie;\n")
            w("    (void)val;\n")
            w("    (void)sz;\n")
            w("}\n")
            w("static inline int64_t loam_ch_do_try_send(int64_t cookie, const void *val, size_t sz) {\n")
            w("    (void)cookie;\n")
            w("    (void)val;\n")
            w("    (void)sz;\n")
            w("    return 0;\n")
            w("}\n")
            w("static inline void loam_ch_do_send_owned(int64_t cookie, const void *val, size_t sz,\n")
            w("                                         loam_elem_fn retain) {\n")
            w("    (void)retain;\n")
            w("    loam_ch_do_send(cookie, val, sz);\n")
            w("}\n")
            w("static inline int64_t loam_ch_do_try_send_owned(int64_t cookie, const void *val, size_t sz,\n")
            w("                                                loam_elem_fn retain) {\n")
            w("    (void)retain;\n")
            w("    return loam_ch_do_try_send(cookie, val, sz);\n")
            w("}\n")
            w("static inline void loam_ch_do_recv(int64_t cookie, void *out, size_t sz) {\n")
            w("    (void)cookie;\n")
            w("    if (out) memset(out, 0, sz);\n")
            w("}\n")
            w("static inline int64_t loam_ch_do_pop(int64_t cookie, void *out, size_t sz) {\n")
            w("    (void)cookie;\n")
            w("    if (out) memset(out, 0, sz);\n")
            w("    return 0;\n")
            w("}\n")
            w("static inline int64_t loam_ch_do_ready(int64_t cookie) {\n")
            w("    (void)cookie;\n")
            w("    return 0;\n")
            w("}\n")
            w("static inline void loam_thread_spawn(loam_fn cb) {\n")
            w("    (void)cb; /* wasm has no threads; spawn is a no-op */\n")
            w("}\n")
            w("static inline int64_t loam_thread_running(void) { return 0; }\n")
            w("#endif\n")
            break
    }
}

/** *A definition for every group the unit called, in header order. */
fn rt_verb_defs() {
    if RT_GROUP_USED.len == 0 {
        return
    }
    for gi in 0..RT_VERB_GROUPS {
        if RT_GROUP_USED[gi] {
            rt_verb_def(gi)
        }
    }
}

// --- operators and casts ---------------------------------------------------------------

/** *Trapping arithmetic helper for integer type `t` (`loam_add_i32`), "" */
/** *for a non-integer type or another operator. */
fn arith_fn(t: int, op: int) -> string {
    let sfx = types.int_suffix(t)
    if sfx.len == 0 {
        return ""
    }
    let mut family = IntHelper.Add
    if op == Tok.Plus || op == Tok.PlusEq {
        family = IntHelper.Add
    } else if op == Tok.Minus || op == Tok.MinusEq {
        family = IntHelper.Sub
    } else if op == Tok.Star || op == Tok.StarEq {
        family = IntHelper.Mul
    } else if op == Tok.Slash || op == Tok.SlashEq {
        family = IntHelper.Div
    } else if op == Tok.Percent || op == Tok.PercentEq {
        family = IntHelper.Mod
    } else {
        return ""
    }
    return int_helper(family, sfx)
}

fn shift_fn(t: int, op: int) -> string {
    let sfx = types.int_suffix(t)
    if sfx.len == 0 {
        return ""
    }
    return int_helper(if op == Tok.Shr { IntHelper.Shr } else { IntHelper.Shl }, sfx)
}

fn neg_fn(t: int) -> string {
    let sfx = types.int_suffix(t)
    if sfx.len == 0 {
        return "(null)"
    }
    return int_helper(IntHelper.Neg, sfx)
}

fn c_binop(op: int) -> string {
    switch op {
        case Tok.Plus:
            return "+"
        case Tok.Minus:
            return "-"
        case Tok.Star:
            return "*"
        case Tok.Slash:
            return "/"
        case Tok.Percent:
            return "%"
        case Tok.EqEq:
            return "=="
        case Tok.BangEq:
            return "!="
        case Tok.Lt:
            return "<"
        case Tok.Gt:
            return ">"
        case Tok.LtEq:
            return "<="
        case Tok.GtEq:
            return ">="
        case Tok.AmpAmp:
            return "&&"
        case Tok.PipePipe:
            return "||"
        case Tok.Amp:
            return "&"
        case Tok.Pipe:
            return "|"
        case Tok.Caret:
            return "^"
        case Tok.Shl:
            return "<<"
        case Tok.Shr:
            return ">>"
        default:
            return "?"
    }
}

/** *`op=` for the non-arithmetic compound assignments, "" for any other. */
fn c_assignop(op: int) -> string {
    switch op {
        case Tok.AmpEq:
            return "&="
        case Tok.PipeEq:
            return "|="
        case Tok.CaretEq:
            return "^="
        case Tok.ShlEq:
            return "<<="
        case Tok.ShrEq:
            return ">>="
        default:
            return ""
    }
}

// How a numeric conversion is emitted.
const CAST_PLAIN: int = 0
/** *`fn((int64_t)(src), f, l)` */
const CAST_CONV: int = 1
/** *`fn((uint64_t)(src), f, l)` */
const CAST_CONVU: int = 2
/** *`fn((double)(src), f, l)` */
const CAST_CONVF: int = 3
/** *`fn((int64_t)(src))` */
const CAST_SAT: int = 4
/** *`fn((uint64_t)(src))` */
const CAST_SATU: int = 5

struct CastPlan {
    shape: int,
    helper: string,
}

fn cast_plan(from: int, to: int, mode: int) -> CastPlan {
    let plain = CastPlan { shape: CAST_PLAIN, helper: "" }
    if from == NO_TYPE || to == NO_TYPE || types.TYPES[to].kind != TK.Int {
        return plain
    }
    let sfx = types.int_suffix(to)
    if sfx.len == 0 {
        return plain
    }
    let fk = types.TYPES[from].kind
    if fk == TK.Float {
        if mode != 0 {
            return plain
        }
        return CastPlan { shape: CAST_CONVF, helper: int_helper(IntHelper.Convf, sfx) }
    }
    if fk != TK.Int || mode == 1 {
        return plain
    }
    let f = &types.TYPES[from]
    let tt = &types.TYPES[to]
    if f.bits == tt.bits && f.is_unsigned == tt.is_unsigned {
        return plain
    }
    let from_u64 = f.bits == 64 && f.is_unsigned != 0
    let to_u64 = tt.bits == 64 && tt.is_unsigned != 0
    if from_u64 && !to_u64 {
        if mode == 2 {
            return CastPlan { shape: CAST_SATU, helper: int_helper(IntHelper.Satu, sfx) }
        }
        return CastPlan { shape: CAST_CONVU, helper: int_helper(IntHelper.Convu, sfx) }
    }
    if mode == 2 {
        return CastPlan { shape: CAST_SAT, helper: int_helper(IntHelper.Sat, sfx) }
    }
    return CastPlan { shape: CAST_CONV, helper: int_helper(IntHelper.Conv, sfx) }
}

// --- structs ----------------------------------------------------------------------------

/** *Struct definitions in by-value dependency order: every definition goes */
/** *through this list, and its inline field structs are emitted before it. */
let mut SE_TYPES: []int = []int {}
let mut SE_NAMES: []string = []string {}
/** *0 pending, 1 emitting, 2 emitted. */
let mut SE_STATE: []int = []int {}
let mut SE_INDEX: Map<int> = map.new(-1)

fn se_find(cn: string) -> int {
    return map.get(&mut SE_INDEX, map.key_str(cn))
}

fn se_add(t: int) {
    let cn = types.type_c_name(t)
    if se_find(cn) >= 0 {
        return
    }
    push(SE_TYPES, t)
    push(SE_NAMES, cn)
    push(SE_STATE, 0)
    map.put(&mut SE_INDEX, map.key_str(cn), SE_TYPES.len - 1)
}

fn struct_body(t: int) {
    let cn = types.type_c_name(t)
    w("struct {{cn}} {\n")
    let names = types.TYPES[t].field_names
    let fts = types.TYPES[t].field_types
    for i in 0..fts.len {
        w("    ")
        var_decl(fts[i], cid(names[i]))
        w(";\n")
    }
    w("};\n\n")
}

/** *A field stores a struct inline when it is one, or a fixed array of one. */
fn se_emit_dep(ft0: int) {
    let mut ft = ft0
    while ft != NO_TYPE && types.TYPES[ft].kind == TK.Array {
        ft = types.TYPES[ft].elem
    }
    if ft == NO_TYPE || types.TYPES[ft].kind != TK.Struct {
        return
    }
    let j = se_find(types.type_c_name(ft))
    if j >= 0 {
        se_emit(j)
    }
}

fn se_emit(i: int) {
    if SE_STATE[i] != 0 {
        return
    }
    SE_STATE[i] = 1
    let t = SE_TYPES[i]
    let fts = types.TYPES[t].field_types
    for f in 0..fts.len {
        se_emit_dep(fts[f])
    }
    struct_body(t)
    SE_STATE[i] = 2
}

fn struct_decl(st: int) {
    let name = ast.INFO[st].name
    if ast.INFO[st].has_name && name == "Future" {
        w("typedef struct Future {\n    int64_t id;\n} Future;\n\n")
        return
    }
    if ast.INFO[st].has_name && name == "Chan" {
        w("typedef struct Chan {\n    int64_t id;\n} Chan;\n\n")
        return
    }
    if ast.EXTRA[ast.ex(st)].strs.len > 0 {
        return
    }
    if ast.NODES[st].ty != NO_TYPE {
        se_add(ast.NODES[st].ty)
    }
}

/** *Modules that declare the Zeus handle types, which zeus_rt.h defines. */
fn zeus_handle_mod(name: string) -> bool {
    return name == "zeus" || name == "zeusbase" || name == "structs"
}

fn is_handle_struct(d: int) -> bool {
    let n = ast.INFO[d].name
    return ast.INFO[d].has_name && (n == "Node" || n == "Signal")
}

fn uses_zeus_handles() -> bool {
    for i in 0..typecheck.MODS.len {
        let root = typecheck.MODS[i].root
        if !zeus_handle_mod(typecheck.MODS[i].name) || root == NONE {
            continue
        }
        let decls = &ast.NODES[root].kids
        for k in 0..decls.len {
            if ast.NODES[decls[k]].kind == Kind.Struct && is_handle_struct(decls[k]) {
                return true
            }
        }
    }
    return false
}

fn mods_use(name: string) -> bool {
    for m in 0..typecheck.MODS.len {
        if typecheck.MODS[m].name == name {
            return true
        }
    }
    return false
}

// --- fn signatures ---------------------------------------------------------------------

fn fn_cname(d: int) -> string {
    if CNAME_OVERRIDE.len > 0 {
        return CNAME_OVERRIDE
    }
    let x = ast.ex(d)
    if ast.EXTRA[x].has_sname {
        return ast.EXTRA[x].sname
    }
    return ast.INFO[d].name
}

fn param_type(ft: int, i: int) -> int {
    if ft != NO_TYPE && i < types.TYPES[ft].params.len {
        return types.TYPES[ft].params[i]
    }
    return types.ty_int()
}

fn ret_type(ft: int) -> int {
    if ft != NO_TYPE && types.TYPES[ft].ret != NO_TYPE {
        return types.TYPES[ft].ret
    }
    return types.ty_void()
}

fn param_name(d: int, i: int) -> string {
    return ast.INFO[ast.NODES[d].kids[i]].name
}

fn fn_sig(d: int, is_main: bool) {
    if is_main {
        w("#if defined(LOAM_IOS) || defined(LOAM_ANDROID)\n")
        w("int loam_app_main(void)\n")
        w("#elif defined(__wasm32__)\n")
        w("int main(void)\n")
        w("#else\n")
        w("int main(int argc, char **argv)\n")
        w("#endif\n")
        return
    }
    let ft = ast.NODES[d].ty
    w_ctype(ret_type(ft))
    wc(' ')
    w(fn_cname(d))
    wc('(')
    let np = ast.NODES[d].kids.len
    if np == 0 {
        w("void")
    }
    for i in 0..np {
        if i > 0 {
            w(", ")
        }
        var_decl(param_type(ft, i), cid(param_name(d, i)))
    }
    wc(')')
}

// --- the fn being emitted ----------------------------------------------------------------

/** *Its `ir.FNS` index (`NONE` outside a body), where its locals start, and */
/** *each local's C spelling. */
let mut CF: int = NONE
let mut CF_LOCALS: int = 0
let mut LV: []string = []string {}

fn lv(id: int) -> string {
    if CF == NONE || id < 0 || id >= LV.len {
        return "/*err*/"
    }
    return LV[id]
}

fn spell_local(f: int, id: int) -> string {
    let l = &ir.LOCALS[ir.FNS[f].locals + id]
    if (l.flags & ir.L_GLOBAL) != 0 && l.gvar != NONE {
        return typecheck.GVARS[l.gvar].cname
    }
    if (l.flags & ir.L_PARAM) != 0 && l.has_name {
        return cid(l.name)
    }
    return "_l{{id}}"
}

fn local_ty(id: int) -> int {
    if CF == NONE || id < 0 || id >= LV.len {
        return NO_TYPE
    }
    return ir.LOCALS[CF_LOCALS + id].ty
}

fn ir_loc(file: int, line: int) {
    wc('"')
    w_escaped_path(public_file(if file >= 0 { path_of(file) } else { "loam" }))
    w("\", ")
    wi(line)
}

/** *The C name of a closure's environment struct: per instance for a */
/** *closure in a generic fn (`loam_env_<id>_<inst>`). */
fn env_tag(id: int, cname: string) -> string {
    let pre = "loam_clos_{{id}}_"
    if cname.len > pre.len && starts_with(cname, pre) {
        let mut b = []u8 {}
        buf.push_str(&mut b, "loam_env_{{id}}_")
        for i in pre.len..cname.len {
            push(b, u8(cname[i]))
        }
        return buf.to_string(&b)
    }
    return "loam_env_{{id}}"
}

fn starts_with(s: string, pre: string) -> bool {
    if s.len < pre.len {
        return false
    }
    for i in 0..pre.len {
        if s[i] != pre[i] {
            return false
        }
    }
    return true
}

fn place(p: int) {
    if p == NONE {
        w("/*place*/")
        return
    }
    let x = &ir.PLACES[p]
    switch x.kind {
        case PlaceKind.Local:
            w(lv(x.local))
            break
        case PlaceKind.Field:
            let f = &ir.FNS[CF]
            let base = x.base
            if f.clos_id != 0 && f.env_local >= 0 && base != NONE && ir.PLACES[base].kind == PlaceKind.Local &&
                ir.PLACES[base].local == f.env_local {
                w("((struct {{env_tag(f.clos_id, f.cname)}} *){{lv(f.env_local)}})->{{cid(x.field)}}")
            } else if base != NONE && is_ptrish(ir.PLACES[base].ty) {
                wc('(')
                place(base)
                w(")->{{cid(x.field)}}")
            } else {
                place(base)
                w(".{{cid(x.field)}}")
            }
            break
        case PlaceKind.Index:
            let bt = if x.base != NONE { ir.PLACES[x.base].ty } else { NO_TYPE }
            let mut vt = bt
            if is_ptrish(vt) {
                vt = types.TYPES[vt].elem
            }
            let vk = tkind(vt)
            if vk == TK.Vec {
                w("((")
                w_ctype(types.TYPES[vt].elem)
                w(" *)(")
                place(x.base)
                if is_ptrish(bt) {
                    w(")->ptr)[{{lv(x.index)}}]")
                } else {
                    w(".ptr))[{{lv(x.index)}}]")
                }
            } else if vk == TK.String {
                w("((int64_t)(unsigned char)(")
                place(x.base)
                if is_ptrish(bt) {
                    w(")->ptr[{{lv(x.index)}}]))")
                } else {
                    w(".ptr[{{lv(x.index)}}]))")
                }
            } else {
                place(x.base)
                w("[{{lv(x.index)}}]")
            }
            break
        default:
            w("(*")
            place(x.base)
            wc(')')
            break
    }
}

// --- ownership: steal, drop, keep, transfer ----------------------------------------------

/** *Structs with out-of-line `loam_keep__T` / `loam_rel__T` / */
/** *`loam_steal__T` helpers, by C name; at most 4095, as C's table. */
let mut OWN_HELPERS: Map<int> = map.new(0)
let mut OWN_HELPER_COUNT: int = 0
const OWN_HELPER_LIMIT: int = 4095

fn own_helper_add(cn: string) -> bool {
    if map.has(&mut OWN_HELPERS, map.key_str(cn)) {
        return true
    }
    if OWN_HELPER_COUNT >= OWN_HELPER_LIMIT {
        return false
    }
    map.put(&mut OWN_HELPERS, map.key_str(cn), 1)
    OWN_HELPER_COUNT = OWN_HELPER_COUNT + 1
    return true
}

/** *Owning leaves (string, vec, box, fn) a value of `t` holds inline. */
fn own_leaves(t: int) -> int {
    if t == NO_TYPE || !needs_drop(t) {
        return 0
    }
    let k = types.TYPES[t].kind
    if k == TK.Struct {
        let mut n = 0
        let fts = types.TYPES[t].field_types
        for i in 0..fts.len {
            n = n + own_leaves(fts[i])
        }
        return n
    }
    if k == TK.Array {
        return 2
    }
    return 1
}

/** *`t`'s C name when it has ownership helpers, else "". */
fn own_helper_for(t: int) -> string {
    if tkind(t) != TK.Struct || OWN_HELPER_COUNT == 0 {
        return ""
    }
    let cn = types.type_c_name(t)
    if map.has(&mut OWN_HELPERS, map.key_str(cn)) {
        return cn
    }
    return ""
}

fn steal(pl: string, t: int, ind: int) {
    if t == NO_TYPE {
        return
    }
    let cn = own_helper_for(t)
    if cn.len > 0 {
        indent(ind)
        w("loam_steal__{{cn}}(&{{pl}});\n")
        return
    }
    let k = types.TYPES[t].kind
    if k == TK.Box {
        indent(ind)
        w("{{pl}} = NULL;\n")
        return
    }
    if k == TK.String {
        if !types.string_owns {
            return
        }
        indent(ind)
        w("{{pl}}.ptr = NULL; {{pl}}.len = 0; {{pl}}.own = 0;\n")
        return
    }
    if k == TK.Proc {
        indent(ind)
        w("{{pl}}.fn = NULL; {{pl}}.env = NULL;\n")
        return
    }
    if k == TK.Vec {
        indent(ind)
        w("{{pl}}.ptr = NULL; {{pl}}.len = 0; {{pl}}.cap = 0;\n")
        return
    }
    if k == TK.Array {
        let e = types.TYPES[t].elem
        if e != NO_TYPE && needs_drop(e) {
            let n = types.TYPES[t].array_len
            let mut i = i64(0)
            while i < n {
                steal("{{pl}}[{{i}}]", e, ind)
                i = i + i64(1)
            }
        }
        return
    }
    if k == TK.Struct {
        let names = types.TYPES[t].field_names
        let fts = types.TYPES[t].field_types
        for i in 0..fts.len {
            if needs_drop(fts[i]) {
                steal("{{pl}}.{{cid(names[i])}}", fts[i], ind)
            }
        }
    }
}

fn drop_place(pl: string, t: int, ind: int) {
    if !needs_drop(t) {
        return
    }
    let cn = own_helper_for(t)
    if cn.len > 0 {
        indent(ind)
        w("loam_rel__{{cn}}(&{{pl}});\n")
        return
    }
    let k = types.TYPES[t].kind
    if k == TK.Box {
        // The box owns its value: release it first, through the element hook
        // so a type that holds itself through a box is not expanded forever.
        let h = elem_hook(types.TYPES[t].elem)
        if h > 0 {
            indent(ind)
            w("if ({{pl}}) loam_elem_release_{{h}}({{pl}});\n")
        }
        indent(ind)
        w("{{core_op(CoreOp.Drop)}}((void **)&{{pl}});\n")
        return
    }
    if k == TK.String {
        indent(ind)
        w("loam_str_release(&{{pl}});\n")
        return
    }
    if k == TK.Vec {
        let e = types.TYPES[t].elem
        let h = elem_hook(e)
        if h > 0 {
            // The buffer owns its elements: they go only when this handle
            // frees it.
            indent(ind)
            w("{{core_op(CoreOp.VecDropOwned)}}(&{{pl}}, sizeof({{ctype(e)}}), loam_elem_release_{{h}});\n")
            return
        }
        if e != NO_TYPE && needs_drop(e) {
            let cn2 = ctype(e)
            indent(ind)
            w("{ int64_t _di; for (_di = 0; _di < {{pl}}.len; _di++) {\n")
            drop_place("(({{cn2}} *){{pl}}.ptr)[_di]", e, ind + 1)
            indent(ind)
            w("} }\n")
        }
        indent(ind)
        w("loam_vec_drop(&{{pl}});\n")
        return
    }
    if k == TK.Array {
        let e = types.TYPES[t].elem
        if e != NO_TYPE && needs_drop(e) {
            indent(ind)
            w("{ int64_t _di; for (_di = 0; _di < {{types.TYPES[t].array_len}}; _di++) {\n")
            drop_place("{{pl}}[_di]", e, ind + 1)
            indent(ind)
            w("} }\n")
        }
        return
    }
    if k == TK.Struct {
        let names = types.TYPES[t].field_names
        let fts = types.TYPES[t].field_types
        for i in 0..fts.len {
            if needs_drop(fts[i]) {
                drop_place("{{pl}}.{{cid(names[i])}}", fts[i], ind)
            }
        }
    }
}

/** *Take a reference for every owning leaf of `pl` the callee or the new */
/** *owner will drop. */
fn nested_keeps(pl: string, t: int, ind: int) {
    if t == NO_TYPE || !needs_drop(t) {
        return
    }
    let cn = own_helper_for(t)
    if cn.len > 0 {
        indent(ind)
        w("loam_keep__{{cn}}(&{{pl}});\n")
        return
    }
    let k = types.TYPES[t].kind
    if k == TK.String {
        indent(ind)
        w("{{core_op(CoreOp.StrRetain)}}({{pl}});\n")
        return
    }
    if k == TK.Vec {
        indent(ind)
        w("{{core_op(CoreOp.VecRetain)}}(&{{pl}});\n")
        let e = types.TYPES[t].elem
        // Elements belong to the buffer, so a copy shares them.
        if elem_hook(e) > 0 {
            return
        }
        if e != NO_TYPE && needs_drop(e) {
            let cn2 = ctype(e)
            indent(ind)
            w("{ int64_t _di; for (_di = 0; _di < {{pl}}.len; _di++) {\n")
            nested_keeps("(({{cn2}} *){{pl}}.ptr)[_di]", e, ind + 1)
            indent(ind)
            w("} }\n")
        }
        return
    }
    if k == TK.Array {
        let e = types.TYPES[t].elem
        if e != NO_TYPE && needs_drop(e) {
            indent(ind)
            w("{ int64_t _ai; for (_ai = 0; _ai < {{types.TYPES[t].array_len}}; _ai++) {\n")
            nested_keeps("{{pl}}[_ai]", e, ind + 1)
            indent(ind)
            w("} }\n")
        }
        return
    }
    if k == TK.Struct {
        let names = types.TYPES[t].field_names
        let fts = types.TYPES[t].field_types
        for i in 0..fts.len {
            if needs_drop(fts[i]) {
                nested_keeps("{{pl}}.{{cid(names[i])}}", fts[i], ind)
            }
        }
    }
}

/** *Clear the `Box` / fn leaves a call adopted, so the caller's own drop */
/** *does not release them again; a retained `[]T` leaf stays. */
fn nested_transfers(pl: string, t: int, ind: int) {
    if t == NO_TYPE || !needs_drop(t) {
        return
    }
    let k = types.TYPES[t].kind
    if k == TK.Box {
        indent(ind)
        w("{{pl}} = NULL;\n")
        return
    }
    if k == TK.Proc {
        indent(ind)
        w("{{pl}}.fn = NULL; {{pl}}.env = NULL;\n")
        return
    }
    if k == TK.Vec {
        return
    }
    if k == TK.Array {
        let e = types.TYPES[t].elem
        if e != NO_TYPE && needs_drop(e) {
            indent(ind)
            w("{ int64_t _ti; for (_ti = 0; _ti < {{types.TYPES[t].array_len}}; _ti++) {\n")
            nested_transfers("{{pl}}[_ti]", e, ind + 1)
            indent(ind)
            w("} }\n")
        }
        return
    }
    if k == TK.Struct {
        let names = types.TYPES[t].field_names
        let fts = types.TYPES[t].field_types
        for i in 0..fts.len {
            if needs_drop(fts[i]) {
                nested_transfers("{{pl}}.{{cid(names[i])}}", fts[i], ind)
            }
        }
    }
}

fn array_copy(dst: int, src: int, t: int) {
    let n = if tkind(t) == TK.Array { types.TYPES[t].array_len } else { i64(0) }
    w("    { int64_t _ci; for (_ci = 0; _ci < {{n}}; _ci++) {{lv(dst)}}[_ci] = {{lv(src)}}[_ci]; }\n")
}

// --- instructions -------------------------------------------------------------------------

fn callee_of(x: &Inst) -> string {
    if x.text == NONE {
        return "unknown"
    }
    return ir.TEXTS[x.text]
}

fn is_callee(x: &Inst, name: string) -> bool {
    return x.op == Op.Call && x.text != NONE && ir.TEXTS[x.text] == name
}

fn arg_of(x: &Inst, k: int) -> int {
    return ir.ARGS[x.args + k]
}

/** *The type an argument has at a call: its local's, or for an indirect call */
/** *to a fn value, the fn type's parameter. */
fn call_arg_type(x: &Inst, k: int) -> int {
    let a = arg_of(x, k)
    let mut at = local_ty(a)
    if x.op == Op.CallVal && at == NO_TYPE {
        let ft = local_ty(x.a)
        if tkind(ft) == TK.Proc && k < types.TYPES[ft].params.len {
            at = types.TYPES[ft].params[k]
        }
    }
    return at
}

/** *An argument the caller keeps a reference for across the call. */
fn arg_kept(at: int) -> bool {
    let k = tkind(at)
    return at != NO_TYPE && needs_drop(at) && k != TK.Box && k != TK.Proc && k != TK.String
}

fn hook_suffix(h: int) {
    if h > 0 {
        w("), loam_elem_retain_{{h}}, ")
    } else {
        w("), ")
    }
}

fn store(x: &Inst) {
    let op = x.binop
    let is_shift = op == Tok.ShlEq || op == Tok.ShrEq
    let mut cf = ""
    if types.is_int_kind(x.ty) {
        cf = if is_shift { shift_fn(x.ty, if op == Tok.ShrEq { Tok.Shr } else { Tok.Shl }) } else { arith_fn(x.ty, op) }
    }
    let arith = op == Tok.PlusEq || op == Tok.MinusEq || op == Tok.StarEq || op == Tok.SlashEq || op == Tok.PercentEq
    if cf.len > 0 && (arith || is_shift) {
        place(x.place)
        w(" = {{cf}}(")
        place(x.place)
        w(", {{lv(x.a)}}, ")
        ir_loc(x.file, x.line)
        w(");\n")
        return
    }
    if arith {
        let mut sym = "+="
        if op == Tok.MinusEq {
            sym = "-="
        } else if op == Tok.StarEq {
            sym = "*="
        } else if op == Tok.SlashEq {
            sym = "/="
        } else if op == Tok.PercentEq {
            sym = "%="
        }
        place(x.place)
        w(" {{sym}} {{lv(x.a)}};\n")
        return
    }
    let aop = c_assignop(op)
    let k = tkind(x.ty)
    if aop.len > 0 {
        place(x.place)
        w(" {{aop}} {{lv(x.a)}};\n")
    } else if k == TK.Vec && types.is_copy(x.ty) {
        w("{\n        loam_vec _repl = ")
        place(x.place)
        w(";\n        ")
        place(x.place)
        w(" = {{core_op(CoreOp.VecRetain)}}(&{{lv(x.a)}});\n")
        drop_place("_repl", x.ty, 1)
        w("    }\n")
    } else if k == TK.String && types.string_owns {
        w("{\n        loam_str _repl = ")
        place(x.place)
        w(";\n        ")
        place(x.place)
        w(" = {{lv(x.a)}};\n        ")
        indent(1)
        w("{{core_op(CoreOp.StrRetain)}}(")
        place(x.place)
        w(");\n")
        drop_place("_repl", x.ty, 1)
        w("    }\n")
    } else if x.ty != NO_TYPE && needs_drop(x.ty) && k != TK.Array {
        w("{\n        {{ctype(x.ty)}} _repl = ")
        place(x.place)
        w(";\n        ")
        place(x.place)
        w(" = {{lv(x.a)}};\n")
        steal(lv(x.a), x.ty, 1)
        drop_place("_repl", x.ty, 1)
        w("    }\n")
    } else {
        place(x.place)
        w(" = {{lv(x.a)}};\n")
    }
}

fn move_inst(x: &Inst) {
    let ty = if x.ty != NO_TYPE { x.ty } else { local_ty(x.dst) }
    let k = tkind(ty)
    let d = lv(x.dst)
    let a = lv(x.a)
    if k == TK.Box {
        w("{{d}} = (")
        w_ctype(ty)
        w("){{core_op(CoreOp.MovePtr)}}((void **)&{{a}});\n")
    } else if k == TK.Proc {
        // A fn value is copy: its env is a borrowed record, never owned.
        w("{{d}} = {{a}};\n")
    } else if k == TK.Vec {
        if types.is_copy(ty) && (x.bits & ir.I_MOVED) == 0 {
            w("{{d}} = {{core_op(CoreOp.VecRetain)}}(&{{a}});\n")
        } else {
            w("{{d}} = {{core_op(CoreOp.VecMove)}}(&{{a}});\n")
        }
    } else if k == TK.String {
        w("{{d}} = {{a}};\n")
        if types.string_owns {
            indent(1)
            w("{{core_op(CoreOp.StrRetain)}}({{d}});\n")
        }
    } else if k == TK.Array {
        w("\n")
        array_copy(x.dst, x.a, ty)
    } else if ty != NO_TYPE && needs_drop(ty) && k == TK.Struct {
        w("{{d}} = {{a}};\n")
        if types.is_copy(ty) {
            nested_keeps(d, ty, 1)
        } else {
            steal(a, ty, 1)
        }
    } else {
        w("{{d}} = {{a}};\n")
    }
}

/** *The signal / future / channel / vec builtins; false when `x` is none. */
fn builtin_call(x: &Inst) -> bool {
    if x.op != Op.Call || x.text == NONE {
        return false
    }
    let name = ir.TEXTS[x.text]
    let has_dst = x.dst >= 0
    if name == "loam_interp" && has_dst {
        interp(x)
        return true
    }
    // The raw memory ops of `unsafe` code. An address is an `int64_t`; a
    // value is copied with `memcpy`, so an unaligned address is no UB.
    if name == "__loam_raw_addr" && x.nargs == 1 {
        let a = lv(arg_of(x, 0))
        let via = if tkind(call_arg_type(x, 0)) == TK.Ptr { "->" } else { "." }
        if has_dst {
            w("{{lv(x.dst)}} = (int64_t)(intptr_t)({{a}}){{via}}ptr;\n")
        }
        return true
    }
    if (name == "__loam_raw_read" || name == "__loam_raw_write") && x.nargs == 2 {
        let addr = lv(arg_of(x, 0))
        let place = lv(arg_of(x, 1))
        if name == "__loam_raw_read" {
            w("memcpy({{place}}, (const void *)(intptr_t){{addr}}, sizeof(*{{place}}));\n")
        } else {
            w("memcpy((void *)(intptr_t){{addr}}, {{place}}, sizeof(*{{place}}));\n")
        }
        return true
    }
    if name == "loam_value_key" && x.nargs >= 1 && has_dst {
        // A string alone is its own key: the rows of one `Each` share a
        // type, so no tag or length is needed (inside a compound, `push_str`
        // still length-prefixes it so the pieces cannot run together).
        let vt = vk_resolve(x.ty)
        if vt != NO_TYPE && types.TYPES[vt].kind == TK.String {
            w("{{lv(x.dst)}} = {{lv(arg_of(x, 0))}}; {{core_op(CoreOp.StrRetain)}}({{lv(x.dst)}});\n")
            return true
        }
        w("{ loam_vec _vk = {0}; ")
        value_key(x.ty, lv(arg_of(x, 0)), "&_vk")
        rt_note_name("loam_string_from_u8")
        w("{{lv(x.dst)}} = loam_string_from_u8(_vk); }\n")
        return true
    }
    if name == "loam_sig_push" && x.nargs >= 1 && has_dst {
        let vt = x.ty
        let d = lv(x.dst)
        let a0 = lv(arg_of(x, 0))
        w("loam_arena_ensure();\n")
        indent(1)
        if tkind(vt) == TK.Int && types.TYPES[vt].bits == 32 {
            // The id recycles through `arena.sig_reserve` (R4.1a); an
            // `int` binds its mirror and cell in Loam, and returns.
            w("{{d}} = loam_arena_sig_new_int(loam_arena_sig_reserve(), {{a0}});\n")
            return true
        }
        w("{{d}} = loam_arena_sig_new_zero(loam_arena_sig_reserve());\n")
        indent(1)
        if is_copy_vec(vt) {
            w("{ loam_vec _sigv = {{core_op(CoreOp.VecRetain)}}(&{{a0}}); ")
            sig_bind_vec(vt, d, "_sigv")
            w(" }\n")
        } else if is_refcounted(vt) {
            w("{ loam_str _sigv = {{a0}}; {{core_op(CoreOp.StrRetain)}}(_sigv); ")
            sig_put(vt, d, "_sigv", SIG_KIND_STR, "0", 0)
            w(" }\n")
        } else if tkind(vt) == TK.Struct && needs_drop(vt) {
            w("{ ")
            w_ctype(vt)
            w(" _sigv = {{a0}};\n")
            nested_keeps("_sigv", vt, 2)
            indent(2)
            sig_bind_owned(vt, d, "_sigv")
            w(" }\n")
        } else {
            sig_put(vt, d, a0, SIG_KIND_PLAIN, "0", 0)
            wc('\n')
        }
        return true
    }
    if name == "loam_sig_load" && x.nargs >= 1 && has_dst {
        let d = lv(x.dst)
        sig_get(x.ty, lv(arg_of(x, 0)), d)
        wc('\n')
        if is_copy_vec(x.ty) {
            indent(1)
            w("{{d}} = {{core_op(CoreOp.VecRetain)}}(&{{d}});\n")
        } else if is_refcounted(x.ty) {
            indent(1)
            w("{{core_op(CoreOp.StrRetain)}}({{d}});\n")
        } else if tkind(x.ty) == TK.Struct && needs_drop(x.ty) {
            nested_keeps(d, x.ty, 1)
        }
        return true
    }
    if name == "loam_sig_store" && x.nargs >= 2 {
        let mut vt = x.ty
        let a1 = arg_of(x, 1)
        if tkind(vt) == TK.Void && a1 >= 0 && a1 < LV.len {
            vt = local_ty(a1)
        }
        let s = lv(arg_of(x, 0))
        let v = lv(a1)
        if tkind(vt) == TK.Int && types.TYPES[vt].bits == 32 {
            w("loam_arena_store_sig({{s}}, {{v}});\n")
        } else if is_copy_vec(vt) {
            w("if (")
            sig_changed(vt, s, v)
            w(") {\n")
            indent(2)
            w("loam_vec _old; ")
            sig_get(vt, s, "_old")
            wc('\n')
            indent(2)
            w("loam_vec _new = {{core_op(CoreOp.VecRetain)}}(&{{v}}); ")
            sig_bind_vec(vt, s, "_new")
            w("\n")
            drop_place("_old", vt, 2)
            indent(2)
            w("loam_arena_note_write({{s}});\n")
            indent(1)
            w("}\n")
        } else if is_refcounted(vt) {
            w("if (")
            sig_changed(vt, s, v)
            w(") {\n")
            indent(2)
            w("loam_str _old; ")
            sig_get(vt, s, "_old")
            wc('\n')
            indent(2)
            w("loam_str _new = {{v}}; {{core_op(CoreOp.StrRetain)}}(_new); ")
            sig_put(vt, s, "_new", SIG_KIND_STR, "0", 0)
            wc('\n')
            indent(2)
            w("loam_str_release(&_old); loam_arena_note_write({{s}});\n")
            indent(1)
            w("}\n")
        } else if tkind(vt) == TK.Struct && needs_drop(vt) {
            w("if (")
            sig_changed(vt, s, v)
            w(") {\n")
            indent(2)
            w_ctype(vt)
            w(" _old; ")
            sig_get(vt, s, "_old")
            wc('\n')
            indent(2)
            w_ctype(vt)
            w(" _new = {{v}};\n")
            nested_keeps("_new", vt, 2)
            indent(2)
            sig_bind_owned(vt, s, "_new")
            w("\n")
            drop_place("_old", vt, 2)
            indent(2)
            w("loam_arena_note_write({{s}});\n")
            indent(1)
            w("}\n")
        } else {
            w("if (")
            sig_changed(vt, s, v)
            w(") { ")
            sig_put(vt, s, v, SIG_KIND_PLAIN, "0", 0)
            w(" loam_arena_note_write({{s}}); }\n")
        }
        return true
    }
    if name == "loam_fut_push" && x.nargs >= 1 && has_dst {
        let a0 = lv(arg_of(x, 0))
        // The table lives in `std:async` (R3.1): alloc the slot in Loam,
        // then move the bytes. `memcpy` is libc, always linked.
        if is_copy_vec(x.ty) {
            w("{ loam_vec _fv = {{core_op(CoreOp.VecRetain)}}(&{{a0}}); {{lv(x.dst)}} = loam_async_fut_alloc(sizeof(_fv), {{handle_key(x.ty)}}); ")
            w("{ loam_vec _ar = loam_async_fut_arena(); memcpy((char *)_ar.ptr + loam_async_fut_off({{lv(x.dst)}}), &_fv, sizeof(_fv)); loam_vec_drop(&_ar); } }\n")
        } else {
            w("{{lv(x.dst)}} = loam_async_fut_alloc(sizeof(")
            w_ctype(x.ty)
            w("), {{handle_key(x.ty)}});\n")
            indent(1)
            w("{ loam_vec _ar = loam_async_fut_arena(); memcpy((char *)_ar.ptr + loam_async_fut_off({{lv(x.dst)}}), &{{a0}}, sizeof(")
            w_ctype(x.ty)
            w(")); loam_vec_drop(&_ar); }\n")
        }
        return true
    }
    if name == "loam_fut_load" && x.nargs >= 1 && has_dst {
        let d = lv(x.dst)
        // Dead ids read zeroed, as the C table did; live ones check S0 first.
        w("{ if (loam_async_fut_live({{lv(arg_of(x, 0))}})) { loam_async_fut_check({{lv(arg_of(x, 0))}}, {{handle_key(x.ty)}}); ")
        w("{ loam_vec _ar = loam_async_fut_arena(); memcpy(&{{d}}, (char *)_ar.ptr + loam_async_fut_off({{lv(arg_of(x, 0))}}), sizeof(")
        w_ctype(x.ty)
        w(")); loam_vec_drop(&_ar); } } else { memset(&{{d}}, 0, sizeof(")
        w_ctype(x.ty)
        w(")); } }\n")
        if is_copy_vec(x.ty) {
            indent(1)
            w("{{d}} = {{core_op(CoreOp.VecRetain)}}(&{{d}});\n")
        }
        return true
    }
    if name == "loam_fut_store" && x.nargs >= 2 {
        let mut vt = x.ty
        let a1 = arg_of(x, 1)
        if tkind(vt) == TK.Void && a1 >= 0 && a1 < LV.len {
            vt = local_ty(a1)
        }
        let s = lv(arg_of(x, 0))
        let v = lv(a1)
        // A dead id is a no-op (as before); a live one checks S0, moves the
        // bytes, and marks ready.
        if is_copy_vec(vt) {
            let key = handle_key(vt)
            w("{ if (loam_async_fut_live({{s}})) { loam_async_fut_check({{s}}, {{key}}); ")
            w("loam_vec _old; { loam_vec _ar = loam_async_fut_arena(); memcpy(&_old, (char *)_ar.ptr + loam_async_fut_off({{s}}), sizeof(_old)); loam_vec_drop(&_ar); } ")
            w("loam_vec _new = {{core_op(CoreOp.VecRetain)}}(&{{v}}); { loam_vec _ar = loam_async_fut_arena(); memcpy((char *)_ar.ptr + loam_async_fut_off({{s}}), &_new, sizeof(_new)); loam_vec_drop(&_ar); } ")
            w("loam_vec_drop(&_old); loam_async_fut_mark_ready({{s}}); } }\n")
        } else {
            w("{ if (loam_async_fut_live({{s}})) { loam_async_fut_check({{s}}, {{handle_key(vt)}}); ")
            w("{ loam_vec _ar = loam_async_fut_arena(); memcpy((char *)_ar.ptr + loam_async_fut_off({{s}}), &{{v}}, sizeof(")
            w_ctype(vt)
            w(")); loam_vec_drop(&_ar); } loam_async_fut_mark_ready({{s}}); } }\n")
        }
        return true
    }
    if name == "loam_fut_ready" && x.nargs >= 1 && has_dst {
        w("{{lv(x.dst)}} = loam_async_fut_is_ready({{lv(arg_of(x, 0))}});\n")
        return true
    }
    if name == "loam_fut_clear" && x.nargs >= 1 {
        w("loam_async_fut_unready({{lv(arg_of(x, 0))}});\n")
        return true
    }
    if name == "loam_ch_alloc" && x.nargs >= 1 && has_dst {
        // The table lives in `std:thread` (R3.2): the id comes from Loam,
        // the cookie from one C sync-block alloc.
        w("{{lv(x.dst)}} = loam_thread_ch_alloc({{lv(arg_of(x, 0))}}, sizeof(")
        w_ctype(x.ty)
        w("), {{handle_key(x.ty)}});\n")
        return true
    }
    if (name == "loam_ch_send" && x.nargs >= 2) || (name == "loam_ch_try_send" && x.nargs >= 2 && has_dst) {
        // S0 + cookie in Loam (`ch_begin` panics on a forged id, returns 0
        // on a dead one); the bytes move in one atomic C section.
        let h = elem_hook(x.ty)
        w("{ int64_t _ck = loam_thread_ch_begin({{lv(arg_of(x, 0))}}, {{handle_key(x.ty)}}); ")
        if name == "loam_ch_try_send" {
            w("{{lv(x.dst)}} = ")
        }
        w("loam_ch_do")
        w((if name == "loam_ch_try_send" { "_try_send" } else { "_send" }))
        if h > 0 {
            w("_owned")
        }
        w("(_ck, &{{lv(arg_of(x, 1))}}, sizeof(")
        w_ctype(x.ty)
        if h > 0 {
            w("), loam_elem_retain_{{h}});\n")
        } else {
            w("));\n")
        }
        w("}\n")
        return true
    }
    if (name == "loam_ch_recv" || name == "loam_ch_pop") && x.nargs >= 1 && has_dst {
        // `recv` on a dead id leaves the caller's zeroed value (as before);
        // the `if` keeps the atomic section off dead cookies.
        w("{ int64_t _ck = loam_thread_ch_begin({{lv(arg_of(x, 0))}}, {{handle_key(x.ty)}}); ")
        w("if (_ck) loam_ch_do")
        w(if name == "loam_ch_recv" { "_recv" } else { "_pop" })
        w("(_ck, &{{lv(x.dst)}}, sizeof(")
        w_ctype(x.ty)
        w(")); }\n")
        return true
    }
    if name == "loam_ch_ready" && x.nargs >= 1 && has_dst {
        rt_note_name("loam_ch_do_ready")
        w("{{lv(x.dst)}} = loam_ch_do_ready(loam_thread_ch_begin({{lv(arg_of(x, 0))}}, 0));\n")
        return true
    }
    if name == "loam_vec_push" && x.nargs >= 2 {
        let a0 = arg_of(x, 0)
        // The vec may arrive by value or by address (`let mut v`).
        let amp = if tkind(local_ty(a0)) == TK.Vec { "&" } else { "" }
        let h = elem_hook(x.ty)
        // A moved element's references go to the slot as they are.
        w_vec_push_name(h, (x.bits & ir.I_MOVED) != 0)
        w("({{amp}}{{lv(a0)}}, &{{lv(arg_of(x, 1))}}, sizeof(")
        w_ctype(x.ty)
        hook_suffix(h)
        ir_loc(x.file, x.line)
        w(");\n")
        return true
    }
    if name == "loam_vec_pop" && x.nargs >= 1 && has_dst {
        let a0 = arg_of(x, 0)
        let raw = local_ty(a0)
        let amp = if tkind(raw) == TK.Vec { "&" } else { "" }
        let mut vt = raw
        if is_ptrish(vt) {
            vt = types.TYPES[vt].elem
        }
        let et = if tkind(vt) == TK.Vec && types.TYPES[vt].elem != NO_TYPE { types.TYPES[vt].elem } else { x.ty }
        let h = elem_hook(et)
        w_vec_pop_name(h)
        w("({{amp}}{{lv(a0)}}, &{{lv(x.dst)}}, sizeof(")
        w_ctype(x.ty)
        hook_suffix(h)
        ir_loc(x.file, x.line)
        w(");\n")
        return true
    }
    return false
}

fn call_inst(x: &Inst) {
    if x.op == Op.Call {
        rt_note_text(x.text)
    }
    if builtin_call(x) {
        return
    }
    // Owning arguments share storage with the caller, but the callee drops its
    // params on exit: keep them alive across the call.
    // An argument handed over whole (`I_MOVED`) is the callee's already.
    let handed_over = (x.bits & ir.I_MOVED) != 0
    let mut nkeep = 0
    for k in 0..x.nargs {
        if arg_kept(call_arg_type(x, k)) && !handed_over {
            nkeep = nkeep + 1
        }
    }
    if nkeep > 0 {
        indent(1)
        w("{\n")
        for k in 0..x.nargs {
            let at = call_arg_type(x, k)
            if arg_kept(at) {
                nested_keeps(lv(arg_of(x, k)), at, 2)
            }
        }
        indent(1)
    }
    if x.dst >= 0 {
        w("{{lv(x.dst)}} = ")
    }
    if x.op == Op.Call {
        w(callee_of(x))
        wc('(')
        for k in 0..x.nargs {
            if k > 0 {
                w(", ")
            }
            w(lv(arg_of(x, k)))
        }
        w(");\n")
    } else {
        let ft = local_ty(x.a)
        let is_proc = tkind(ft) == TK.Proc
        let ret = if is_proc && types.TYPES[ft].ret != NO_TYPE { types.TYPES[ft].ret } else { types.ty_void() }
        let fv = lv(x.a)
        w("((")
        w_ctype(ret)
        w("(*)(void *")
        if is_proc {
            let ps = types.TYPES[ft].params
            for k in 0..ps.len {
                w(", ")
                w_ctype(ps[k])
            }
        }
        w(")){{fv}}.fn)({{fv}}.env")
        for k in 0..x.nargs {
            w(", ")
            w(lv(arg_of(x, k)))
        }
        w(");\n")
    }
    if nkeep > 0 {
        // After the call: the callee owns the handles it adopted.
        for k in 0..x.nargs {
            let at = call_arg_type(x, k)
            if at == NO_TYPE || !needs_drop(at) {
                continue
            }
            if !types.arg_transfers(at) {
                nested_transfers(lv(arg_of(x, k)), at, 2)
            }
        }
        w("    }\n")
    }
}

fn struct_lit(x: &Inst) {
    let t = x.ty
    let is_struct = tkind(t) == TK.Struct
    let cn = if is_struct { types.type_c_name(t) } else if t != NO_TYPE && types.TYPES[t].has_name { types.TYPES[t].name } else { "struct" }
    let d = lv(x.dst)
    let names = if t != NO_TYPE { types.TYPES[t].field_names } else { []string {} }
    if x.dflt != NONE {
        // Start from the struct's default template and store only the fields
        // it does not supply.
        lit_template_use(x, cn)
        w("{{d}} = loam_dflt_{{cn}};\n")
        for k in 0..x.nargs {
            let a = arg_of(x, k)
            if a < 0 {
                continue
            }
            indent(1)
            w("{{d}}.{{cid(names[k])}} = {{lv(a)}};\n")
        }
    } else {
        w("{{d}} = ({{cn}}){ ")
        for k in 0..x.nargs {
            if k > 0 {
                w(", ")
            }
            if k < names.len {
                w(".{{cid(names[k])}} = {{lv(arg_of(x, k))}}")
            } else {
                w(lv(arg_of(x, k)))
            }
        }
        w(" };\n")
    }
    // A struct that owns a string retains every refcounted leaf it was given.
    if types.string_owns && is_struct && types.owns_string(t) {
        if x.dflt != NONE {
            let fts = types.TYPES[t].field_types
            for k in 0..x.nargs {
                if arg_of(x, k) < 0 {
                    continue
                }
                nested_keeps("{{d}}.{{cid(names[k])}}", fts[k], 1)
            }
        } else {
            nested_keeps(d, t, 1)
        }
    }
}

fn array_lit(x: &Inst) {
    let d = lv(x.dst)
    if x.nints > 0 {
        w("{\n")
        indent(2)
        w("static const ")
        w_ctype(types.TYPES[x.ty].elem)
        w(" _t[] = {")
        for k in 0..x.nints {
            if k > 0 {
                wc(',')
            }
            wl(ir.INTS[x.ints + k])
        }
        w("};\n")
        indent(2)
        w("{{d}} = {{core_op(CoreOp.VecOf)}}(_t, {{x.nints}}, sizeof _t[0], ")
        ir_loc(x.file, x.line)
        w(");\n")
        indent(1)
        w("}\n")
    } else if tkind(x.ty) == TK.Vec {
        let e = types.TYPES[x.ty].elem
        let h = elem_hook(e)
        w("{{d}} = loam_vec_new();\n")
        for k in 0..x.nargs {
            let a = arg_of(x, k)
            indent(1)
            w_vec_push_name(h, false)
            w("(&{{d}}, &{{lv(a)}}, sizeof(")
            w_ctype(e)
            hook_suffix(h)
            ir_loc(x.file, x.line)
            w(");\n")
            // An owning element's source keeps its own reference (the push
            // took one for the slot); a plain element is moved.
            if h == 0 && a >= 0 && a < LV.len && needs_drop(local_ty(a)) {
                steal(lv(a), local_ty(a), 1)
            }
        }
    } else {
        for k in 0..x.nargs {
            if k > 0 {
                indent(1)
            }
            w("{{d}}[{{k}}] = {{lv(arg_of(x, k))}};\n")
        }
        if x.nargs == 0 {
            w("(void){{d}};\n")
        }
    }
}

fn clos_inst(x: &Inst) {
    let d = lv(x.dst)
    let callee = callee_of(x)
    if x.nargs == 0 {
        w("{{d}} = ((loam_fn){(void *){{callee}}, NULL, 0});\n")
        return
    }
    let id = int(x.imm)
    let cf = find_ir_fn(if x.text == NONE { "" } else { callee })
    let tag = env_tag(id, callee)
    w("{\n")
    indent(2)
    w("struct {{tag}} *_ce = (struct {{tag}} *)loam_new(sizeof(struct {{tag}}), ")
    ir_loc(x.file, x.line)
    w(");\n")
    for k in 0..x.nargs {
        let mut fnm = "f"
        let mut ct = NO_TYPE
        if cf != NONE {
            let caps = &ir.FNS[cf].caps
            if k < caps.len {
                fnm = cid(caps[k])
                if k < ir.FNS[cf].cap_types.len {
                    ct = ir.FNS[cf].cap_types[k]
                }
            }
        }
        let a = lv(arg_of(x, k))
        indent(2)
        if is_copy_vec(ct) {
            w("_ce->{{fnm}} = {{core_op(CoreOp.VecRetain)}}(&{{a}});\n")
        } else if ct != NO_TYPE && !types.is_copy(ct) && needs_drop(ct) {
            // A non-Copy owned capture is moved into the env.
            w("_ce->{{fnm}} = {{a}};\n")
            steal(a, ct, 2)
        } else {
            w("_ce->{{fnm}} = {{a}};\n")
            // The env outlives the frame that captured it: its own reference
            // to every []T the capture reaches.
            if ct != NO_TYPE && needs_drop(ct) && !types.arg_transfers(ct) {
                nested_keeps("_ce->{{fnm}}", ct, 2)
            }
        }
    }
    indent(2)
    w("{{d}} = ((loam_fn){(void *){{callee}}, _ce, sizeof(struct {{tag}})});\n")
    indent(1)
    w("}\n")
}

fn inst(i: int) {
    let x = &ir.INSTS[i]
    indent(1)
    switch x.op {
        case Op.ConstInt:
            w("{{lv(x.dst)}} = ")
            int_lit(x.imm)
            w(";\n")
            break
        case Op.ConstFloat:
            w("{{lv(x.dst)}} = ")
            float_lit(x.fimm, tkind(x.ty) == TK.Float && types.TYPES[x.ty].bits == 32)
            w(";\n")
            break
        case Op.ConstBool:
            w(lv(x.dst))
            w(if x.imm != i64(0) { " = true;\n" } else { " = false;\n" })
            break
        case Op.ConstStr:
            w("{{lv(x.dst)}} = ")
            str_lit(if x.text == NONE { "" } else { ir.TEXTS[x.text] })
            w(";\n")
            break
        case Op.Load:
            w("{{lv(x.dst)}} = ")
            place(x.place)
            w(";\n")
            // A read of an owning value is an owned copy, unless it is only
            // compared (borrowed).
            if x.ty != NO_TYPE && needs_drop(x.ty) && (x.bits & ir.I_BORROWED) == 0 {
                nested_keeps(lv(x.dst), x.ty, 1)
            }
            break
        case Op.Store:
            store(x)
            break
        case Op.Addr:
            // A borrowed fixed array is a pointer to its first element (how
            // `&[N]T` is typed in C), so the array itself decays to it.
            let borrows_array = x.place != NONE && tkind(ir.PLACES[x.place].ty) == TK.Array
            w(if borrows_array { "{{lv(x.dst)}} = " } else { "{{lv(x.dst)}} = &" })
            place(x.place)
            w(";\n")
            break
        case Op.Move:
            move_inst(x)
            break
        case Op.Bin:
            let at = local_ty(x.a)
            let mut cf = ""
            if (x.binop == Tok.Shl || x.binop == Tok.Shr) && types.is_int_kind(x.ty) {
                cf = shift_fn(x.ty, x.binop)
            } else if (x.bits & ir.I_CHECKED) != 0 {
                cf = arith_fn(x.ty, x.binop)
            }
            if (x.binop == Tok.EqEq || x.binop == Tok.BangEq) && tkind(at) == TK.String {
                let neg = if x.binop == Tok.BangEq { "!" } else { "" }
                rt_note_name("loam_fmt_eq")
                w("{{lv(x.dst)}} = {{neg}}loam_fmt_eq({{lv(x.a)}}, {{lv(x.b)}});\n")
            } else if cf.len > 0 {
                w("{{lv(x.dst)}} = {{cf}}({{lv(x.a)}}, {{lv(x.b)}}, ")
                ir_loc(x.file, x.line)
                w(");\n")
            } else {
                w("{{lv(x.dst)}} = ({{lv(x.a)}} {{c_binop(x.binop)}} {{lv(x.b)}});\n")
            }
            break
        case Op.Un:
            let at = local_ty(x.a)
            if x.binop == Tok.Tilde && types.is_int_kind(at) {
                w("{{lv(x.dst)}} = (")
                w_ctype(x.ty)
                w(")(~{{lv(x.a)}});\n")
            } else if x.binop != Tok.Bang && x.binop != Tok.Tilde && types.is_int_kind(at) &&
                (x.bits & ir.I_NO_TRAP) == 0 {
                w("{{lv(x.dst)}} = {{neg_fn(x.ty)}}({{lv(x.a)}}, ")
                ir_loc(x.file, x.line)
                w(");\n")
            } else {
                let sym = if x.binop == Tok.Bang { "!" } else if x.binop == Tok.Tilde { "~" } else { "-" }
                w("{{lv(x.dst)}} = ({{sym}}{{lv(x.a)}});\n")
            }
            break
        case Op.Cast:
            let plan = cast_plan(local_ty(x.a), x.ty, x.conv)
            if plan.shape == CAST_PLAIN {
                w("{{lv(x.dst)}} = (")
                w_ctype(x.ty)
                w("){{lv(x.a)}};\n")
            } else {
                w("{{lv(x.dst)}} = {{plan.helper}}(")
                if plan.shape == CAST_CONV || plan.shape == CAST_SAT {
                    w("(int64_t)")
                } else if plan.shape == CAST_CONVU || plan.shape == CAST_SATU {
                    w("(uint64_t)")
                } else {
                    w("(double)")
                }
                w(lv(x.a))
                if plan.shape == CAST_CONV || plan.shape == CAST_CONVU || plan.shape == CAST_CONVF {
                    w(", ")
                    ir_loc(x.file, x.line)
                }
                w(");\n")
            }
            break
        case Op.Sizeof:
            let at = x.ty
            let is_arr = tkind(at) == TK.Array
            let nel = if is_arr && types.TYPES[at].array_len > i64(0) { types.TYPES[at].array_len } else { i64(1) }
            w("{{lv(x.dst)}} = (int32_t)(sizeof(")
            w_ctype(if is_arr { types.TYPES[at].elem } else { at })
            w(") * {{nel}});\n")
            break
        case Op.Panic:
            w("loam_panic_str(")
            ir_loc(x.file, x.line)
            w(", {{lv(x.a)}});\n")
            break
        case Op.Call, Op.CallVal:
            if (x.bits & ir.I_NUMERIC_BUILTIN) != 0 {
                note_numeric_builtin(ir.TEXTS[x.text])
            }
            call_inst(x)
            break
        case Op.Alloc:
            let et = if tkind(x.ty) == TK.Box { types.TYPES[x.ty].elem } else { types.ty_int() }
            let ec = ctype(et)
            w("{{lv(x.dst)}} = ({{ec}} *)loam_new(sizeof({{ec}}), ")
            ir_loc(x.file, x.line)
            w(");\n")
            if x.a >= 0 {
                indent(1)
                w("*{{lv(x.dst)}} = {{lv(x.a)}};\n")
                // The box gets its own references, as a move does: kept for a
                // Copy value, stolen from the source otherwise.
                if needs_drop(et) {
                    if types.is_copy(et) {
                        nested_keeps("(*{{lv(x.dst)}})", et, 1)
                    } else {
                        steal(lv(x.a), et, 1)
                    }
                }
            }
            break
        case Op.Drop:
            let ty = local_ty(x.a)
            if ty != NO_TYPE && needs_drop(ty) {
                drop_place(lv(x.a), ty, 0)
            } else {
                w("{{core_op(CoreOp.Drop)}}((void **)&{{lv(x.a)}});\n")
            }
            break
        case Op.Bound:
            BOUNDS_HELPER_USED = true
            if x.b >= 0 {
                w("(void)loam_idx({{lv(x.a)}}, {{lv(x.b)}}, ")
            } else {
                w("(void)loam_idx({{lv(x.a)}}, {{x.imm}}, ")
            }
            ir_loc(x.file, x.line)
            w(");\n")
            break
        case Op.StructLit:
            struct_lit(x)
            break
        case Op.ArrayLit:
            array_lit(x)
            break
        case Op.FnVal:
            if x.imm == i64(1) {
                // Only ever an argument to a `#[c]` binding, which hands `.fn`
                // to C: the fn itself, called with the C ABI.
                w("{{lv(x.dst)}} = ((loam_fn){(void *){{callee_of(x)}}, NULL, 0});\n")
            } else {
                w("{{lv(x.dst)}} = ((loam_fn){(void *){{callee_of(x)}}__as_fn, NULL, 0});\n")
            }
            break
        case Op.Clos:
            clos_inst(x)
            break
        default:
            break
    }
}

// --- terminators and bodies -----------------------------------------------------------------

fn zero_ret(t: int) {
    let k = tkind(t)
    if t == NO_TYPE || k == TK.Void {
        w("return;\n")
        return
    }
    w("return ")
    switch k {
        case TK.Bool:
            w("false")
            break
        case TK.Float:
            w("0.0")
            break
        case TK.String:
            w("((loam_str){0})")
            break
        case TK.Ptr, TK.Box:
            w("NULL")
            break
        case TK.Struct:
            let nm = if types.TYPES[t].has_name { types.TYPES[t].name } else { "struct" }
            w("({{nm}}){0}")
            break
        case TK.Proc:
            w("((loam_fn){0})")
            break
        default:
            w("0")
            break
    }
    w(";\n")
}

fn term(b: int, is_main: bool) {
    let bb = &ir.BLOCKS[b]
    indent(1)
    switch bb.term {
        case Term.Ret:
            let v = bb.term_val
            // Returning a borrowed string parameter hands the caller an owned
            // reference.
            if v >= 0 && v < LV.len && (ir.LOCALS[CF_LOCALS + v].flags & ir.L_PARAM) != 0 && types.string_owns &&
                tkind(local_ty(v)) == TK.String {
                w("{{core_op(CoreOp.StrRetain)}}({{lv(v)}});\n")
                indent(1)
            }
            if is_main && v < 0 {
                w("return 0;\n")
            } else if v >= 0 {
                w("return {{lv(v)}};\n")
            } else {
                let sig = ir.FNS[CF].sig
                let ret = if tkind(sig) == TK.Proc && types.TYPES[sig].ret != NO_TYPE { types.TYPES[sig].ret } else { types.ty_void() }
                zero_ret(if is_main { types.ty_int() } else { ret })
            }
            break
        case Term.Jmp:
            w("goto bb{{bb.succ0}};\n")
            break
        case Term.Br:
            w("if ({{lv(bb.term_val)}}) goto bb{{bb.succ0}}; else goto bb{{bb.succ1}};\n")
            break
        case Term.Switch:
            let cast = if tkind(local_ty(bb.term_val)) == TK.Bool { "(int)" } else { "" }
            w("switch ({{cast}}{{lv(bb.term_val)}}) {\n")
            for c in 0..bb.sw_n {
                indent(1)
                w("case ")
                int_lit(ir.SW_VALS[bb.sw + c])
                w(": goto bb{{ir.SW_BLOCKS[bb.sw + c]}};\n")
            }
            indent(1)
            w("default: goto bb{{bb.succ0}};\n")
            indent(1)
            w("}\n")
            break
        case Term.Unreachable:
            w("loam_panic(\"loam\", 0, \"unreachable\");\n")
            break
        default:
            break
    }
}

/** *The first IR fn with each C name. */
let mut IR_FN_BY_NAME: Map<int> = map.new(-1)
let mut IR_FN_INDEXED: bool = false

fn find_ir_fn(cname: string) -> int {
    if !IR_FN_INDEXED {
        IR_FN_INDEXED = true
        for f in 0..ir.FNS.len {
            if ir.FNS[f].has_cname && !map.has(&mut IR_FN_BY_NAME, map.key_str(ir.FNS[f].cname)) {
                map.put(&mut IR_FN_BY_NAME, map.key_str(ir.FNS[f].cname), f)
            }
        }
    }
    if cname.len == 0 {
        return NONE
    }
    return map.get(&mut IR_FN_BY_NAME, map.key_str(cname))
}

fn is_init_fn(f: int) -> bool {
    return ir.FNS[f].has_name && ir.FNS[f].name == "__init"
}

/** *`loam test`'s `main`: name each test through `test.begin`, call it, and */
/** *leave the report to `test.ok` / `test.summary`. Naming the test before the */
/** *call means a trap (which aborts without unwinding) still says which test */
/** *was running. The program's own `main` would run the module inits, so the */
/** *runner calls them too. */
fn test_runner() {
    w("\nint main(void) {\n")
    init_calls()
    let nmods = typecheck.MODS.len
    for m in 0..nmods {
        let root = typecheck.MODS[m].root
        if root == NONE {
            continue
        }
        let module_name = typecheck.MODS[m].name
        let decls = ast.NODES[root].kids
        for i in 0..decls.len {
            let d = decls[i]
            if !is_fn(d) || (ast.NODES[d].op & dce.FN_TEST) == 0 || !dce.keep(d) {
                continue
            }
            let fn_name = ast.INFO[d].name
            let label = if m == 0 || module_name.len == 0 { fn_name } else { "{{module_name}}.{{fn_name}}" }
            w("    loam_test_begin(")
            str_lit(label)
            w(");\n")
            w("    {{fn_cname(d)}}();\n")
            w("    loam_test_ok();\n")
        }
    }
    w("    return loam_test_summary();\n}\n")
}

/** *`case<N>`, as a batch program imports fixture N; -1 for any other alias. */
fn batch_case_of(alias: string) -> int {
    if alias.len <= 4 || !starts_with(alias, "case") {
        return NONE
    }
    let mut n = 0
    for i in 4..alias.len {
        let c = int(alias[i])
        if c < '0' || c > '9' {
            return NONE
        }
        n = n * 10 + (c - '0')
    }
    return n
}

/** *The module an import resolved to, by path; -1 when none. */
fn batch_import_mod(im: int) -> int {
    let x = ast.ex(im)
    if !ast.EXTRA[x].has_sname {
        return NONE
    }
    let path = ast.EXTRA[x].sname
    for k in 0..typecheck.MODS.len {
        if typecheck.MODS[k].path == path {
            return k
        }
    }
    return NONE
}

/** *The import nodes of module `m` (none when it did not parse). */
fn import_nodes(m: int) -> []int {
    let mut out = []int {}
    let root = typecheck.MODS[m].root
    if root == NONE {
        return out
    }
    let kids = ast.NODES[root].kids
    for k in 0..kids.len {
        if ast.NODES[kids[k]].kind == Kind.Import {
            push(out, kids[k])
        }
    }
    return out
}

/** *Mark `m` and everything it imports. The batch program's own imports of */
/** *its cases are left out of `edges`: those are what the table tells apart. */
fn batch_mark(edges: &[][]int, m: int, seen: &mut []bool) {
    if m < 0 || m >= seen.len || seen[m] {
        return
    }
    seen[m] = true
    let next = edges[m]
    for i in 0..next.len {
        batch_mark(edges, next[i], seen)
    }
}

/** *A batch program holds many fixtures but runs one per process, chosen by */
/** *`LOAM_CASE`. That case must start up as it would alone, so only the */
/** *modules it can reach run their initializers: another fixture's globals */
/** *would otherwise take arena slots and signal ids this one's output depends */
/** *on. Emits the table and returns the number of cases. */
fn batch_table() -> int {
    let nmods = typecheck.MODS.len
    if nmods == 0 {
        return 0
    }
    let entry_imports = import_nodes(0)
    let mut cases = 0
    for i in 0..entry_imports.len {
        let c = batch_case_of(ast.INFO[entry_imports[i]].name)
        if c >= cases {
            cases = c + 1
        }
    }
    if cases == 0 {
        return 0
    }
    let mut edges = [][]int {}
    for m in 0..nmods {
        let ims = import_nodes(m)
        let mut row = []int {}
        for i in 0..ims.len {
            if m == 0 && batch_case_of(ast.INFO[ims[i]].name) >= 0 {
                continue
            }
            push(row, batch_import_mod(ims[i]))
        }
        push(edges, row)
    }
    let bytes = nmods / 8 + 1
    // `std:batch.serve`, which the batch program imports (nob's suite source).
    w("    extern int32_t loam_batch_serve(void);\n")
    w("    const int loam_served = loam_batch_serve();\n")
    w("    if (loam_served >= 0) return loam_served;\n")
    w("    const char *loam_case_env = getenv(\"LOAM_CASE\");\n")
    w("    const int loam_case = loam_case_env ? atoi(loam_case_env) : 0;\n")
    w("    if (loam_case < 0 || loam_case >= {{cases}}) {\n")
    w("        fprintf(stderr, \"loam: no case %d\\n\", loam_case);\n")
    w("        return 2;\n    }\n")
    w("    static const unsigned char loam_case_mods[{{cases}}][{{bytes}}] = {\n")
    for c in 0..cases {
        let mut seen = []bool {}
        for m in 0..nmods {
            push(seen, false)
        }
        batch_mark(&edges, 0, &mut seen)
        for i in 0..entry_imports.len {
            if batch_case_of(ast.INFO[entry_imports[i]].name) == c {
                batch_mark(&edges, batch_import_mod(entry_imports[i]), &mut seen)
            }
        }
        w("        {")
        for b in 0..bytes {
            let mut v = 0
            let mut m = b * 8
            while m < (b + 1) * 8 && m < nmods {
                if seen[m] {
                    v = v | (1 << (m % 8))
                }
                m = m + 1
            }
            w("{{v}},")
        }
        w("},\n")
    }
    w("    };\n")
    return cases
}

/** *Every module's `__init`, each after the inits of everything it imports. */
fn init_calls() {
    let cases = if BATCH { batch_table() } else { 0 }
    let nmods = typecheck.MODS.len
    for r in 0..nmods {
        for f in 0..ir.FNS.len {
            if !is_init_fn(f) || !ir.FNS[f].has_cname {
                continue
            }
            let m = ir.FNS[f].init_mod
            if m < 0 || m >= nmods || typecheck.MODS[m].rank != r {
                continue
            }
            if cases > 0 {
                w("    if (loam_case_mods[loam_case][{{m / 8}}] & {{1 << (m % 8)}}) {{ir.FNS[f].cname}}();\n")
            } else {
                w("    {{ir.FNS[f].cname}}();\n")
            }
        }
    }
}

fn fn_body(f: int, is_main: bool) {
    CF = f
    let fx = &ir.FNS[f]
    CF_LOCALS = fx.locals
    LV = []string {}
    for l in 0..fx.nlocals {
        push(LV, spell_local(f, l))
    }
    w(" {\n")
    if fx.is_main {
        w("#if !defined(LOAM_IOS) && !defined(LOAM_ANDROID) && !defined(__wasm32__)\n")
        rt_note_name("loam_argv_set")
        w("    loam_argv_set(argc, argv);\n")
        w("#endif\n")
    }
    if fx.clos_id != 0 && fx.caps.len == 0 {
        w("    (void)_env;\n")
    }
    if fx.is_main {
        init_calls()
    }
    for l in 0..fx.nlocals {
        let lo = &ir.LOCALS[fx.locals + l]
        if (lo.flags & (ir.L_PARAM | ir.L_GLOBAL)) != 0 {
            continue
        }
        indent(1)
        var_decl(lo.ty, LV[l])
        // An owning local some read or drop may reach before it is surely
        // assigned starts empty.
        if (needs_drop(lo.ty) && (lo.flags & ir.L_NEEDS_ZERO) != 0) || (lo.flags & ir.L_ZERO_INIT) != 0 {
            w(" = {0}")
        }
        w(";\n")
    }
    for b in 0..fx.nblocks {
        let blk = fx.blocks + b
        w("bb{{b}}:;\n")
        let first = ir.BLOCKS[blk].first
        for k in 0..ir.BLOCKS[blk].count {
            line_directive(ir.INSTS[first + k].file, ir.INSTS[first + k].line)
            inst(first + k)
        }
        term(blk, is_main || fx.is_main)
    }
    w("}\n\n")
    CF = NONE
    LV = []string {}
}

/** *The IR fn lowered from declaration `d`: by its C name, unless `d` is */
/** *an `#[os]` variant, which shares that name with the others. */
fn ir_fn_of(d: int) -> int {
    if typecheck.os_mask(d) == 0 {
        return find_ir_fn(fn_cname(d))
    }
    for f in 0..ir.FNS.len {
        if ir.FNS[f].decl == d {
            return f
        }
    }
    return NONE
}

/** *The C condition an `#[os]` / `#[arch]` mask stands for (`ast.OS_*` and */
/** *`ast.ARCH_*` bits). A mask naming macOS and iOS, or Linux and Android, */
/** *tests the plain `__APPLE__` / `__linux__` macro. */
fn os_condition(mask: int) -> string {
    let os = mask & ast.OS_ALL
    let arch = mask & ast.ARCH_ALL
    let os_text = if os == 0 { "" } else { os_terms(os) }
    if arch == 0 {
        return os_text
    }
    let arch_text = arch_terms(arch)
    return if os == 0 { arch_text } else { "({{os_text}}) && ({{arch_text}})" }
}

fn os_terms(os: int) -> string {
    let apple = ast.OS_MACOS | ast.OS_IOS
    let linux = ast.OS_LINUX | ast.OS_ANDROID
    if os == (apple | linux | ast.OS_OTHER) {
        return "!defined(_WIN32) && !defined(__wasm32__)"
    }
    let mut terms = []string {}
    if (os & apple) == apple {
        push(terms, "defined(__APPLE__)")
    } else if (os & ast.OS_MACOS) != 0 {
        push(terms, "(defined(__APPLE__) && !defined(LOAM_IOS))")
    } else if (os & ast.OS_IOS) != 0 {
        push(terms, "(defined(__APPLE__) && defined(LOAM_IOS))")
    }
    if (os & linux) == linux {
        push(terms, "defined(__linux__)")
    } else if (os & ast.OS_LINUX) != 0 {
        push(terms, "(defined(__linux__) && !defined(__ANDROID__) && !defined(LOAM_ANDROID))")
    } else if (os & ast.OS_ANDROID) != 0 {
        push(terms, "(defined(__ANDROID__) || defined(LOAM_ANDROID))")
    }
    if (os & ast.OS_WINDOWS) != 0 {
        push(terms, "defined(_WIN32)")
    }
    if (os & ast.OS_WASM) != 0 {
        push(terms, "defined(__wasm32__)")
    }
    if (os & ast.OS_OTHER) != 0 {
        push(terms, "(!defined(__APPLE__) && !defined(__linux__) && !defined(_WIN32) && !defined(__wasm32__))")
    }
    return or_join(terms)
}

fn arch_terms(arch: int) -> string {
    let mut terms = []string {}
    if (arch & ast.ARCH_X86_64) != 0 {
        push(terms, "defined(__x86_64__) || defined(_M_X64)")
    }
    if (arch & ast.ARCH_AARCH64) != 0 {
        push(terms, "defined(__aarch64__) || defined(_M_ARM64)")
    }
    if (arch & ast.ARCH_WASM32) != 0 {
        push(terms, "defined(__wasm32__)")
    }
    if (arch & ast.ARCH_OTHER) != 0 {
        push(terms, "(!defined(__x86_64__) && !defined(_M_X64) && !defined(__aarch64__) && !defined(_M_ARM64) && !defined(__wasm32__))")
    }
    return or_join(terms)
}

fn or_join(terms: []string) -> string {
    let mut out = ""
    for i in 0..terms.len {
        out = if i == 0 { terms[i] } else { "{{out}} || {{terms[i]}}" }
    }
    return out
}

/** *Open `d`'s `#[os]` condition, if it has one; `os_end` closes it. */
fn os_begin(d: int) {
    let mask = typecheck.os_mask(d)
    if mask != 0 {
        w("#if {{os_condition(mask)}}\n")
    }
}

fn os_end(d: int) {
    if typecheck.os_mask(d) != 0 {
        w("#endif\n")
    }
}

fn emit_fn(d: int, is_main: bool, linkage: string) {
    let cn = fn_cname(d)
    let f = ir_fn_of(d)
    // An `#[os]` variant was marked before its `#if` (see the module loop):
    // a cut between the two would split the conditional across units.
    if typecheck.os_mask(d) == 0 {
        shard_mark(cn)
    }
    line_directive(ast.INFO[d].loc.file, ast.INFO[d].loc.line)
    w(linkage)
    fn_sig(d, is_main)
    if f == NONE || !ir.FNS[f].lowered {
        fatal("internal: fn '{{cn}}' was not lowered to IR")
    }
    fn_body(f, is_main)
}

// --- closures ------------------------------------------------------------------------------

/** *Closures of the kept fn bodies and module-level inits. */
let mut CLOS_NODES: []int = []int {}
let mut CLOS_IDS: Map<int> = map.new(0)

fn collect_list(nodes: &[]int) {
    for i in 0..nodes.len {
        collect_clos(nodes[i])
    }
}

fn collect_clos(n: int) {
    if n == NONE {
        return
    }
    let x = &ast.NODES[n]
    switch x.kind {
        case Kind.Closure:
            push(CLOS_NODES, n)
            map.put(&mut CLOS_IDS, map.key_str("{{ast.EXTRA[ast.ex(n)].clos_id}}"), 1)
            collect_clos(x.b)
            break
        case Kind.Program, Kind.Block, Kind.StructLit, Kind.ArrayLit, Kind.Tuple:
            collect_list(&x.kids)
            break
        case Kind.Fn:
            if ast.EXTRA[ast.ex(n)].strs.len == 0 {
                collect_clos(x.b)
            }
            break
        case Kind.If:
            collect_clos(x.a)
            collect_clos(x.b)
            collect_clos(x.c)
            break
        case Kind.For, Kind.While, Kind.Assign, Kind.Binary, Kind.Index:
            collect_clos(x.a)
            collect_clos(x.b)
            break
        case Kind.Switch, Kind.Call:
            collect_clos(x.a)
            collect_list(&x.kids)
            break
        case Kind.Case:
            collect_list(&x.kids)
            collect_clos(x.a)
            break
        case Kind.Return, Kind.ExprStmt, Kind.Var, Kind.Unary, Kind.IncDec, Kind.Cast, Kind.Try, Kind.Field,
            Kind.Deref, Kind.Addr:
            if x.kind == Kind.Var {
                collect_clos(x.b)
            } else {
                collect_clos(x.a)
            }
            break
        default:
            break
    }
}

fn clos_sig(n: int, proto: bool) {
    let ft = ast.NODES[n].ty
    w_ctype(ret_type(ft))
    w(" loam_clos_{{ast.EXTRA[ast.ex(n)].clos_id}}(void *_env")
    let np = ast.NODES[n].kids.len
    for i in 0..np {
        w(", ")
        var_decl(param_type(ft, i), cid(param_name(n, i)))
    }
    wc(')')
    if proto {
        w(";\n")
    }
}

fn clos_env(n: int) {
    let x = ast.ex(n)
    let caps = ast.EXTRA[x].caps
    if caps.len == 0 {
        return
    }
    w("struct loam_env_{{ast.EXTRA[x].clos_id}} {\n")
    let cts = ast.EXTRA[x].cap_types
    for i in 0..caps.len {
        w("    ")
        var_decl(if i < cts.len { cts[i] } else { NO_TYPE }, cid(caps[i]))
        w(";\n")
    }
    w("};\n")
}

fn closure_fn(n: int) {
    let cn = "loam_clos_{{ast.EXTRA[ast.ex(n)].clos_id}}"
    let f = find_ir_fn(cn)
    shard_mark(cn)
    clos_sig(n, false)
    if f == NONE || !ir.FNS[f].lowered {
        fatal("internal: closure '{{cn}}' was not lowered to IR")
    }
    fn_body(f, false)
}

/** *A closure lowered from a generic instance: `loam_clos_<id>_<mono>`. */
fn is_mono_clos(f: int) -> bool {
    if !ir.FNS[f].has_cname {
        return false
    }
    let cn = ir.FNS[f].cname
    if !starts_with(cn, "loam_clos_") {
        return false
    }
    let mut p = 10
    while p < cn.len && cn[p] >= '0' && cn[p] <= '9' {
        p = p + 1
    }
    return p < cn.len && cn[p] == '_'
}

fn mono_clos_env(f: int, seen: &mut Map<int>) {
    let fx = &ir.FNS[f]
    if fx.caps.len == 0 {
        return
    }
    let tag = env_tag(fx.clos_id, fx.cname)
    // Only a shared env (`loam_env_<id>`) can already exist.
    if tag == "loam_env_{{fx.clos_id}}" {
        let key = "{{fx.clos_id}}"
        if map.has(&mut CLOS_IDS, map.key_str(key)) || map.has(seen, map.key_str(key)) {
            return
        }
        map.put(seen, map.key_str(key), 1)
    }
    w("struct {{tag}} {\n")
    for k in 0..fx.caps.len {
        w("    ")
        var_decl(if k < fx.cap_types.len { fx.cap_types[k] } else { types.ty_int() }, cid(fx.caps[k]))
        w(";\n")
    }
    w("};\n")
}

fn mono_clos_sig(f: int, proto: bool) {
    let fx = &ir.FNS[f]
    let sig = fx.sig
    let ret = if tkind(sig) == TK.Proc && types.TYPES[sig].ret != NO_TYPE { types.TYPES[sig].ret } else { types.ty_void() }
    w_ctype(ret)
    w(" {{fx.cname}}(void *_env")
    for l in 0..fx.nlocals {
        let lo = &ir.LOCALS[fx.locals + l]
        if (lo.flags & ir.L_PARAM) == 0 || lo.name == "_env" {
            continue
        }
        w(", ")
        var_decl(lo.ty, lo.name)
    }
    wc(')')
    if proto {
        w(";\n")
    }
}

// --- constants and literal templates ------------------------------------------------------

/** *A constant default (`ir.static_const`) as a C static initializer. */
fn const_init(e: int) {
    let fnv = ir.const_fn_val(e)
    if fnv.len > 0 {
        w("{(void *){{fnv}}__as_fn, NULL, 0}")
        return
    }
    if ir.const_empty_vec(e) {
        w("{0}")
        return
    }
    switch ast.NODES[e].kind {
        case Kind.Number:
            int_lit(ast.INFO[e].num)
            break
        case Kind.Float:
            w(conv.f64_to_g17(ast.EXTRA[ast.ex(e)].fnum))
            break
        case Kind.Bool:
            w(if ast.NODES[e].op != 0 { "1" } else { "0" })
            break
        case Kind.String:
            let s = ast.EXTRA[ast.ex(e)].text
            w("{(const char *)\"")
            c_string_body(s)
            w("\", {{c_len(s)}}}")
            break
        case Kind.StructLit:
            let kids = ast.NODES[e].kids
            if kids.len == 0 {
                w("{0}")
                break
            }
            w("{ ")
            for k in 0..kids.len {
                if k > 0 {
                    w(", ")
                }
                w(".{{cid(ast.init_name(e, k))}} = ")
                const_init(kids[k])
            }
            w(" }")
            break
        case Kind.ArrayLit:
            let elems = ast.NODES[e].kids
            w("{ ")
            for k in 0..elems.len {
                if k > 0 {
                    w(", ")
                }
                const_init(elems[k])
            }
            w(" }")
            break
        default:
            wc('0')
            break
    }
}

// One `static const T loam_dflt_T` per struct whose literals start from a
// default template: the union of the constant defaults of the sites emitted.
let mut LT_NAMES: []string = []string {}
let mut LT_TYPES: []int = []int {}
/** *Per template, each field's default node (`NONE` none), or empty when no */
/** *emitted site used it. */
let mut LT_DEFAULTS: [][]int = [][]int {}
let mut LT_INDEX: Map<int> = map.new(-1)

fn lit_tmpl_add(t: int, cn: string) -> int {
    let j = map.get(&mut LT_INDEX, map.key_str(cn))
    if j >= 0 {
        return j
    }
    push(LT_NAMES, cn)
    push(LT_TYPES, t)
    push(LT_DEFAULTS, []int {})
    map.put(&mut LT_INDEX, map.key_str(cn), LT_NAMES.len - 1)
    return LT_NAMES.len - 1
}

fn lit_template_use(x: &Inst, cn: string) {
    let j = lit_tmpl_add(x.ty, cn)
    let nf = types.TYPES[x.ty].field_types.len
    if LT_DEFAULTS[j].len == 0 {
        for k in 0..nf {
            push(LT_DEFAULTS[j], NONE)
        }
    }
    let mut k = 0
    while k < x.nargs && k < nf {
        let dv = ir.DFLT[x.dflt + k]
        if dv != NONE && LT_DEFAULTS[j][k] == NONE {
            LT_DEFAULTS[j][k] = dv
        }
        k = k + 1
    }
}

fn lit_template_decls() {
    for f in 0..ir.FNS.len {
        if !ir.FNS[f].lowered {
            continue
        }
        let b0 = ir.FNS[f].blocks
        for b in b0..b0 + ir.FNS[f].nblocks {
            let first = ir.BLOCKS[b].first
            for i in first..first + ir.BLOCKS[b].count {
                if ir.INSTS[i].op != Op.StructLit || ir.INSTS[i].dflt == NONE {
                    continue
                }
                let t = ir.INSTS[i].ty
                let cn = types.type_c_name(t)
                if map.get(&mut LT_INDEX, map.key_str(cn)) >= 0 {
                    continue
                }
                lit_tmpl_add(t, cn)
                let storage = if SHARD { "extern" } else { "static" }
                w("__attribute__((unused)) {{storage}} const {{cn}} loam_dflt_{{cn}};\n")
            }
        }
    }
    if LT_NAMES.len > 0 {
        wc('\n')
    }
}

fn lit_template_defs() {
    for j in 0..LT_NAMES.len {
        let d = LT_DEFAULTS[j]
        let cn = LT_NAMES[j]
        // A template no emitted site used keeps its tentative zero (a shard
        // build has no tentative definition, so it defines the zero).
        if d.len == 0 {
            if SHARD {
                w("const {{cn}} loam_dflt_{{cn}} = {};\n")
            }
            continue
        }
        w("{{unit_static()}}const {{cn}} loam_dflt_{{cn}} = { ")
        let names = types.TYPES[LT_TYPES[j]].field_names
        let mut first = true
        for k in 0..names.len {
            if k >= d.len || d[k] == NONE {
                continue
            }
            if !first {
                w(", ")
            }
            w(".{{cid(names[k])}} = ")
            const_init(d[k])
            first = false
        }
        w(" };\n")
    }
}

// --- ownership helpers ---------------------------------------------------------------------

/** *Prototypes, then bodies, of the ownership helpers of every emitted struct */
/** *with two or more owning leaves. */
fn own_helpers() {
    OWN_HELPERS = map.new(0)
    OWN_HELPER_COUNT = 0
    let mut want = []bool {}
    for i in 0..SE_TYPES.len {
        let ok = SE_STATE[i] == 2 && own_leaves(SE_TYPES[i]) >= 2 && own_helper_add(SE_NAMES[i])
        push(want, ok)
        if !ok {
            continue
        }
        let cn = SE_NAMES[i]
        w("static void loam_keep__{{cn}}({{cn}} *p);\n")
        w("static void loam_rel__{{cn}}({{cn}} *p);\n")
        w("static void loam_steal__{{cn}}({{cn}} *p);\n")
    }
    for i in 0..SE_TYPES.len {
        if !want[i] {
            continue
        }
        let t = SE_TYPES[i]
        let cn = SE_NAMES[i]
        let names = types.TYPES[t].field_names
        let fts = types.TYPES[t].field_types
        for k in 0..3 {
            let what = if k == 0 { "keep" } else if k == 1 { "rel" } else { "steal" }
            w("__attribute__((unused)) static void loam_{{what}}__{{cn}}({{cn}} *p) {\n")
            for f in 0..fts.len {
                if !needs_drop(fts[f]) {
                    continue
                }
                let pl = "p->{{cid(names[f])}}"
                if k == 0 {
                    nested_keeps(pl, fts[f], 1)
                } else if k == 1 {
                    drop_place(pl, fts[f], 1)
                } else {
                    steal(pl, fts[f], 1)
                }
            }
            w("}\n")
        }
    }
    if SE_TYPES.len > 0 {
        wc('\n')
    }
}

// --- `#[c]` bindings and fn-value trampolines --------------------------------------------

/** *`&[]T` / `&mut []T`: the Loam parameter is a pointer to the `loam_vec`, */
/** *and C receives that vec's element pointer. */
fn c_borrowed_buf(t: int) -> bool {
    if tkind(t) != TK.Ptr {
        return false
    }
    return tkind(types.TYPES[t].elem) == TK.Vec
}

fn c_abi_type(t: int) {
    let k = tkind(t)
    if k == TK.String {
        w("const char *")
    } else if k == TK.Vec || k == TK.Proc || c_borrowed_buf(t) {
        w("void *")
    } else {
        w_ctype(t)
    }
}

fn c_sym_of(d: int) -> string {
    let x = ast.ex(d)
    if ast.EXTRA[x].has_text {
        return ast.EXTRA[x].text
    }
    return ""
}

fn c_bindings() {
    let mut any = false
    for m in 0..typecheck.MODS.len {
        let root = typecheck.MODS[m].root
        if root == NONE {
            continue
        }
        let decls = ast.NODES[root].kids
        for i in 0..decls.len {
            let d = decls[i]
            if ast.NODES[d].kind != Kind.Fn || c_sym_of(d).len == 0 || !dce.keep(d) {
                continue
            }
            rt_note_name(c_sym_of(d))
            if !any {
                any = true
                w("#define LOAM_CSYM_S2(x) #x\n")
                w("#define LOAM_CSYM_S(x) LOAM_CSYM_S2(x)\n")
                w("#define LOAM_CSYM(s) __asm__(LOAM_CSYM_S(__USER_LABEL_PREFIX__) s)\n")
                // A string argument C needs NUL-terminated: copied into the
                // wrapper's own stack buffer when it fits, so a path or a
                // name costs no malloc. The long case stays out of line, so
                // the short one inlines and a literal's copy folds away.
                w("static __attribute__((noinline, cold)) char *loam_csym_cstr_heap(loam_str s) {\n")
                w("    char *b = (char *)malloc((size_t)s.len + 1);\n")
                w("    if (!b) abort();\n")
                w("    memcpy(b, s.ptr, (size_t)s.len);\n")
                w("    b[s.len] = 0;\n")
                w("    return b;\n")
                w("}\n")
                w("static inline char *loam_csym_cstr(loam_str s, char *buf, size_t cap) {\n")
                w("    if ((size_t)s.len >= cap) return loam_csym_cstr_heap(s);\n")
                w("    if (s.len) memcpy(buf, s.ptr, (size_t)s.len);\n")
                w("    buf[s.len] = 0;\n")
                w("    return buf;\n")
                w("}\n")
                w("static inline loam_str loam_csym_str(const char *p) {\n")
                w("    if (!p) return (loam_str){\"\", 0, 0};\n")
                w("    int64_t n = (int64_t)strlen(p);\n")
                w("    char *b = loam_str_bytes(n);\n")
                w("    memcpy(b, p, (size_t)n);\n")
                w("    b[n] = 0;\n")
                w("    return loam_str_owned(b, n);\n")
                w("}\n")
            }
            let cn = fn_cname(d)
            let ft = ast.NODES[d].ty
            let ret = ret_type(ft)
            let rk = tkind(ret)
            let np = ast.NODES[d].kids.len
            // The declared name is this Loam fn's, so two bindings of one C
            // symbol (fcntl, memcpy, send, poll) each keep their own
            // prototype and share the asm label.
            // A variadic binding declares C's `(fixed, ...)` shape, so `cc`
            // passes the rest as varargs (on the stack on Apple arm64, where
            // a fixed-arity call would put them in registers the callee
            // never reads).
            let fixed = ast.c_variadic_fixed(d)
            let declared = if fixed >= 0 { fixed } else { np }
            os_begin(d)
            w("extern ")
            c_abi_type(ret)
            w(" {{cn}}__csym(")
            if declared == 0 {
                w("void")
            }
            for k in 0..declared {
                if k > 0 {
                    w(", ")
                }
                c_abi_type(param_type(ft, k))
            }
            if fixed >= 0 {
                w(", ...")
            }
            w(") LOAM_CSYM(\"{{c_sym_of(d)}}\");\n")
            w("static ")
            fn_sig(d, false)
            w(" {\n")
            for k in 0..np {
                if tkind(param_type(ft, k)) == TK.String {
                    w("    char _cb{{k}}[256];\n")
                    w("    char *_cs{{k}} = loam_csym_cstr({{cid(param_name(d, k))}}, _cb{{k}}, sizeof _cb{{k}});\n")
                }
            }
            w("    ")
            if rk == TK.String {
                w("const char *_p = ")
            } else if rk != TK.Void {
                w_ctype(ret)
                w(" _r = ")
            }
            w("{{cn}}__csym(")
            for k in 0..np {
                if k > 0 {
                    w(", ")
                }
                let pt = param_type(ft, k)
                let pk = tkind(pt)
                if pk == TK.String {
                    w("_cs{{k}}")
                } else if pk == TK.Vec {
                    w("{{cid(param_name(d, k))}}.ptr")
                } else if c_borrowed_buf(pt) {
                    // No retain on the way in: the caller still owns the buffer.
                    w("{{cid(param_name(d, k))}}->ptr")
                } else if pk == TK.Proc {
                    w("{{cid(param_name(d, k))}}.fn")
                } else {
                    w(cid(param_name(d, k)))
                }
            }
            w(");\n")
            if rk == TK.String {
                w("    loam_str _r = loam_csym_str(_p);\n")
            }
            for k in 0..np {
                let pk = tkind(param_type(ft, k))
                if pk == TK.String {
                    w("    if (_cs{{k}} != _cb{{k}}) free(_cs{{k}});\n")
                } else if pk == TK.Vec {
                    // An owned buffer was retained by the caller. A borrowed
                    // one (`&[]T` / `&mut []T`) is not: C only saw `->ptr`.
                    w("    loam_vec_drop(&{{cid(param_name(d, k))}});\n")
                }
            }
            if rk != TK.Void {
                w("    return _r;\n")
            }
            w("}\n")
            os_end(d)
        }
    }
    if any {
        wc('\n')
    }
}

/** *Adapter so a named fn can be stored in a `loam_fn` (env unused). An */
/** *`#[os]` variant's adapter is inside the variant's own `#if` (the caller */
/** *places the shard mark before it, so no cut splits the conditional). */
fn as_fn_tramp(d: int, proto: bool) {
    let ft = ast.NODES[d].ty
    let ret = ret_type(ft)
    let x = ast.ex(d)
    let cn = if ast.EXTRA[x].has_sname { ast.EXTRA[x].sname } else { ast.INFO[d].name }
    if !proto && typecheck.os_mask(d) == 0 {
        shard_mark(cn)
    }
    w_ctype(ret)
    w(" {{cn}}__as_fn(void *_env")
    let np = ast.NODES[d].kids.len
    for i in 0..np {
        w(", ")
        var_decl(param_type(ft, i), cid(param_name(d, i)))
    }
    if proto {
        w(");\n")
        return
    }
    w(") {\n    (void)_env;\n    ")
    if tkind(ret) != TK.Void {
        w("return ")
    }
    w("{{cn}}(")
    for i in 0..np {
        if i > 0 {
            w(", ")
        }
        w(cid(param_name(d, i)))
    }
    w(");\n}\n\n")
}

fn set_mono_subst(i: int) {
    let f = typecheck.MONOS[i].fn_
    SUBST_NAMES = if f != NONE { ast.EXTRA[ast.ex(f)].strs } else { []string {} }
    SUBST_ARGS = typecheck.MONOS[i].args
    CNAME_OVERRIDE = typecheck.MONOS[i].cname
}

fn clear_subst() {
    SUBST_NAMES = []string {}
    SUBST_ARGS = []int {}
    CNAME_OVERRIDE = ""
}

// --- the translation unit -----------------------------------------------------------------

fn is_fn(d: int) -> bool {
    return ast.NODES[d].kind == Kind.Fn
}

fn is_generic(d: int) -> bool {
    return ast.EXTRA[ast.ex(d)].strs.len > 0
}

fn is_intrinsic(d: int) -> bool {
    return (ast.INFO[d].marks & ast.M_INTRINSIC) != 0
}

fn copy_runtime() {
    // Exactly one unit owns the runtime's storage.
    if SHARD {
        w("#ifdef LOAM_SHARD_DEFS\n")
    }
    w("#define LOAM_RT_DEFINE_JMP 1\n")
    w("#define LOAM_RT_DEFINE_ALLOC 1\n")
    if SHARD {
        w("#endif\n")
    }
    let r = if typecheck.RT_PATH.len > 0 { sys.read(typecheck.RT_PATH) } else { res_err("no runtime", "") }
    if r.tag == ResultTag.Ok {
        w(r.val)
        wc('\n')
        return
    }
    w("#include <stdio.h>\n#include <stdint.h>\n#include <stdlib.h>\n#include <stdbool.h>\n\n")
}

/** *Write the whole C translation unit to stdout, or to `SINK`. Dead-code */
/** *elimination (unless `dce.SKIP`) and IR lowering (unless `ir.LOWERED`) */
/** *run first. */
fn emit_c() {
    if !dce.SKIP {
        dce.run()
    }
    // Lowering appends to the IR tables, so a caller that lowered already
    // (`--emit-ir`, `--cost`) must not lower twice.
    if !ir.LOWERED {
        ir.lower_modules()
    }
    collect_elem_hooks()
    let nmods = typecheck.MODS.len

    w("/* Generated by loam */\n")
    copy_runtime()
    if uses_zeus_handles() {
        w("#include \"zeus_rt.h\"\n")
    }
    if mods_use("net") {
        w("#include \"net_rt.h\"\n")
    }
    int_helpers_reset()
    vec_push_reset()
    vec_pop_reset()
    core_ops_reset()
    rt_verbs_reset()
    PRELUDE = OUT
    OUT = []u8 {}
    wc('\n')

    // Closures only from kept fn bodies, plus module-level inits.
    for m in 0..nmods {
        let root = typecheck.MODS[m].root
        if root == NONE {
            continue
        }
        let decls = ast.NODES[root].kids
        for i in 0..decls.len {
            let d = decls[i]
            if is_fn(d) {
                if is_generic(d) || !dce.keep(d) {
                    continue
                }
                // A client build keeps nothing of a `#[server]` body.
                if SERVER_SPLIT && (ast.NODES[d].op & dce.FN_SERVER) != 0 {
                    continue
                }
                collect_clos(ast.NODES[d].b)
            } else if ast.NODES[d].kind == Kind.Var {
                collect_clos(ast.NODES[d].b)
            }
        }
    }

    for m in 0..nmods {
        let root = typecheck.MODS[m].root
        if root == NONE {
            continue
        }
        let mod_name = typecheck.MODS[m].name
        let decls = ast.NODES[root].kids
        for i in 0..decls.len {
            let d = decls[i]
            if ast.NODES[d].kind != Kind.Struct {
                continue
            }
            // Zeus's handle types live in its runtime header.
            if zeus_handle_mod(mod_name) && is_handle_struct(d) {
                continue
            }
            struct_decl(d)
        }
    }
    for i in 0..typecheck.STRUCT_INSTS.len {
        let t = typecheck.STRUCT_INSTS[i]
        if t == NO_TYPE {
            continue
        }
        if types.TYPES[t].has_name {
            let n = types.TYPES[t].name
            if n == "Signal" || n == "Future" || n == "Chan" {
                continue
            }
        }
        if struct_targs_concrete(t) {
            se_add(t)
        }
    }
    // Every struct name first, so a field may point at a struct defined later.
    for i in 0..SE_NAMES.len {
        w("typedef struct {{SE_NAMES[i]}} {{SE_NAMES[i]}};\n")
    }
    if SE_NAMES.len > 0 {
        wc('\n')
    }
    for i in 0..SE_NAMES.len {
        se_emit(i)
    }

    // A prototype per possible hook id: monomorphized bodies can register an
    // element type after this point.
    for i in 1..ELEM_HOOK_MAX + 1 {
        w("{{unit_static()}}void loam_elem_retain_{{i}}(void *p);\n{{unit_static()}}void loam_elem_release_{{i}}(void *p);\n")
    }
    if sig_store_linked() {
        w("void loam_sigcells_payload_drop(int32_t kind, int32_t esz, int32_t hook, int32_t off);\n")
    }
    wc('\n')
    own_helpers()

    for i in 0..typecheck.GVARS.len {
        let gv = typecheck.GVARS[i].var
        if gv == NONE {
            continue
        }
        let init = ast.NODES[gv].b
        // An immutable scalar with a literal value is a C `const`, so `cc`
        // folds it where it is read (a `const STRIDE: int = 11` stays 11 in
        // index math instead of a load and a checked multiply by a variable).
        let ro = if gvar_folds(gv) { "const " } else { "" }
        if SHARD {
            w("extern {{ro}}")
            var_decl(ast.NODES[gv].ty, typecheck.GVARS[i].cname)
            w(";\n#ifdef LOAM_SHARD_DEFS\n")
        }
        w(ro)
        var_decl(ast.NODES[gv].ty, typecheck.GVARS[i].cname)
        if ir.static_data(init) {
            w(" = ")
            const_init(init)
        }
        w(";\n")
        if SHARD {
            w("#endif\n")
        }
    }
    if typecheck.GVARS.len > 0 {
        wc('\n')
    }
    for f in 0..ir.FNS.len {
        if is_init_fn(f) && ir.FNS[f].has_cname {
            w("void {{ir.FNS[f].cname}}(void);\n")
        }
    }

    for m in 0..nmods {
        let root = typecheck.MODS[m].root
        if root == NONE {
            continue
        }
        // std seams are declared by the runtime headers; a bodyless fn in a
        // user module is an app C seam and gets an extern prototype.
        let std_mod = typecheck.MODS[m].is_std
        let decls = ast.NODES[root].kids
        for i in 0..decls.len {
            let d = decls[i]
            if !is_fn(d) || is_generic(d) || !dce.keep(d) {
                continue
            }
            if is_intrinsic(d) {
                if std_mod {
                    rt_note_name(fn_cname(d))
                }
                if std_mod || c_sym_of(d).len > 0 {
                    continue
                }
                os_begin(d)
                fn_sig(d, false)
                w(";\n")
                os_end(d)
                continue
            }
            if m == 0 && ast.INFO[d].name == "main" {
                continue
            }
            os_begin(d)
            w(fn_linkage(m, d))
            fn_sig(d, false)
            w(";\n")
            os_end(d)
        }
    }
    for i in 0..CLOS_NODES.len {
        clos_env(CLOS_NODES[i])
    }
    for i in 0..CLOS_NODES.len {
        clos_sig(CLOS_NODES[i], true)
    }
    let mut seen_envs: Map<int> = map.new(0)
    for f in 0..ir.FNS.len {
        if !is_mono_clos(f) {
            continue
        }
        mono_clos_env(f, &mut seen_envs)
        mono_clos_sig(f, true)
    }
    for i in 0..typecheck.MONOS.len {
        let f = typecheck.MONOS[i].fn_
        if f == NONE || !dce.keep(f) {
            continue
        }
        set_mono_subst(i)
        fn_sig(f, false)
        w(";\n")
        clear_subst()
    }
    wc('\n')
    c_bindings()

    // The trampolines are the first definitions, so a shard build finishes
    // the header before them: the literal templates, and the trampolines' own
    // prototypes, since one unit's trampoline is what another unit stores.
    if SHARD {
        lit_template_decls()
    }
    let mut pass = if SHARD { 2 } else { 1 }
    while pass > 0 {
        pass = pass - 1
        let proto = pass == 1
        for m in 0..nmods {
            let root = typecheck.MODS[m].root
            if root == NONE {
                continue
            }
            let std_mod = typecheck.MODS[m].is_std
            let decls = ast.NODES[root].kids
            for i in 0..decls.len {
                let d = decls[i]
                // A user seam has a prototype above, so it can be a value too.
                // Each `#[os]` variant gets its adapter under its own `#if`
                // (a value names the primary, which holds the mark), so a
                // target without the fn has no adapter calling it.
                if !is_fn(d) {
                    continue
                }
                let primary = typecheck.os_primary(d)
                if (ast.INFO[primary].marks & ast.M_AS_VALUE) != 0 &&
                    (!is_intrinsic(d) || c_sym_of(d).len > 0 || !std_mod) && !is_generic(d) && dce.keep(d) {
                    if !proto && typecheck.os_mask(d) != 0 && primary == d {
                        shard_mark("{{fn_cname(d)}}__as_fn")
                    }
                    os_begin(d)
                    as_fn_tramp(d, proto)
                    os_end(d)
                }
            }
        }
    }

    if !SHARD {
        lit_template_decls()
    }

    for i in 0..CLOS_NODES.len {
        closure_fn(CLOS_NODES[i])
    }
    for f in 0..ir.FNS.len {
        if !is_mono_clos(f) || !ir.FNS[f].lowered {
            continue
        }
        shard_mark(ir.FNS[f].cname)
        mono_clos_sig(f, false)
        fn_body(f, false)
    }

    for i in 0..typecheck.MONOS.len {
        let f = typecheck.MONOS[i].fn_
        if f == NONE || !dce.keep(f) {
            continue
        }
        set_mono_subst(i)
        emit_fn(f, false, "")
        clear_subst()
    }

    for f in 0..ir.FNS.len {
        if !is_init_fn(f) || !ir.FNS[f].lowered {
            continue
        }
        shard_mark(ir.FNS[f].cname)
        w("void {{ir.FNS[f].cname}}(void)")
        fn_body(f, false)
    }

    let mut m = nmods - 1
    while m >= 0 {
        let root = typecheck.MODS[m].root
        if root != NONE {
            let decls = ast.NODES[root].kids
            for i in 0..decls.len {
                let d = decls[i]
                if !is_fn(d) || is_intrinsic(d) || is_generic(d) || !dce.keep(d) {
                    continue
                }
                let is_main = m == 0 && ast.INFO[d].name == "main"
                // The runner owns `main`.
                if is_main && TEST_MODE {
                    continue
                }
                if SERVER_SPLIT && (ast.NODES[d].op & dce.FN_SERVER) != 0 {
                    // Client build: the signature with a trap body. The real
                    // body is never emitted, so its literals are absent.
                    let x = ast.ex(d)
                    shard_mark(if ast.EXTRA[x].has_sname { ast.EXTRA[x].sname } else { "" })
                    fn_sig(d, false)
                    w(" { loam_panic(\"<server>\", 0, \"server function excluded from client build\"); __builtin_unreachable(); }\n")
                    continue
                }
                if typecheck.os_mask(d) != 0 {
                    shard_mark(fn_cname(d))
                }
                os_begin(d)
                emit_fn(d, is_main, if is_main { "" } else { fn_linkage(m, d) })
                os_end(d)
            }
        }
        m = m - 1
    }

    // Container element hooks: retain / release the owning leaves of one
    // element, for the buffer-scoped vec calls above.
    let mut h = 0
    while h < ELEM_HOOK_TYPES.len {
        let ht = ELEM_HOOK_TYPES[h]
        let hcn = ctype(ht)
        let id = h + 1
        shard_mark("loam_elem_{{id}}")
        w("{{unit_static()}}void loam_elem_retain_{{id}}(void *p) {\n")
        w("    {{hcn}} *_e = ({{hcn}} *)p;\n")
        nested_keeps("(*_e)", ht, 1)
        w("}\n")
        w("{{unit_static()}}void loam_elem_release_{{id}}(void *p) {\n")
        w("    {{hcn}} *_e = ({{hcn}} *)p;\n")
        drop_place("(*_e)", ht, 1)
        w("}\n")
        h = h + 1
    }
    sig_payload_drop_def()
    if SHARD {
        w("\n/*@D*/\n#ifdef LOAM_SHARD_DEFS\n")
    }
    lit_template_defs()
    if SHARD {
        w("#endif\n")
    }
    if TEST_MODE {
        test_runner()
    }
    // The header, the integer helpers, core ops and vec pushes and pops the
    // unit calls, then the unit.
    let body = OUT
    OUT = PRELUDE
    PRELUDE = []u8 {}
    int_helper_defs()
    core_op_defs()
    rt_verb_defs()
    vec_push_defs()
    vec_pop_defs()
    wasm_libc_defs()
    buf.push_bytes(&mut OUT, &body)
    flush()
    if SINK.len > 0 {
        if sys.write_bytes(SINK, OUT) != 0 {
            fatal("cannot write '{{SINK}}'")
        }
        OUT = []u8 {}
    }
}
