// dump — the diagnostics as text (`file:line:col: error: msg`), and the module
// paths they name.
import "std:buf"
import "std:fmt"
import "ast.loam"

/** *Module paths, by `Loc.file`: where a diagnostic or a declaration lives. */
let mut PATHS: []string = []string {}

fn path_of(file: int) -> string {
    if file >= 0 && file < PATHS.len {
        return PATHS[file]
    }
    return "-"
}

/** *Every diagnostic, in order: `file:line:col: error: msg`, the message cut */
/** *at 1023 bytes as C's 1024-byte buffer does. */
fn diags_text() -> string {
    let mut e = []u8 {}
    for k in 0..ast.DIAGS.len {
        let g = ast.DIAGS[k]
        buf.push_str(&mut e, path_of(g.loc.file))
        push(e, u8(':'))
        buf.push_int(&mut e, g.loc.line)
        push(e, u8(':'))
        buf.push_int(&mut e, g.loc.col)
        buf.push_str(&mut e, ": error: ")
        let m = g.msg
        if m.len > 1023 {
            for i in 0..1023 {
                push(e, u8(m[i]))
            }
        } else {
            buf.push_str(&mut e, m)
        }
        push(e, u8('\n'))
    }
    return buf.to_string(&e)
}

/** *Every diagnostic, in order, on stderr (`diags_text`). */
fn print_diags() {
    let e = diags_text()
    if e.len > 0 {
        fmt.ewrite(e)
    }
}
