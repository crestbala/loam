// astdump — parse a .loam file and print its tree in the format of
// `loamc --dump-ast` (src/ast_dump.c has the format). Diagnostics go to
// stderr as `file:line:col: error: msg`; after a parse error nothing is
// printed and the exit status is 1. `nob integration selfhost_parse` diffs
// the two over every .loam file in the repo.
import "std:buf"
import "std:fmt"
import "std:result"
import "std:sys"
import "ast.loam"
import "parser.loam"
import "dump.loam"

fn main() {
    if sys.argc() != 2 {
        fmt.eprintln("usage: astdump file.loam")
        sys.exit(2)
    }
    let path = sys.arg(1)
    let r = sys.read(path)
    if r.tag == ResultTag.Err {
        fmt.eprintln("loam: cannot read", path)
        sys.exit(1)
    }
    let mut p = parser.parser_new(r.val)
    let root = parser.parse_program(&mut p)
    dump.PATHS = []string { path }
    dump.print_diags()
    if p.had_error {
        sys.exit(1)
    }
    let mut b = []u8 {}
    dump.dump(&mut b, root, 0, "root")
    fmt.write(buf.to_string(&b))
}
