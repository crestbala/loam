// irdump — the IR as `loamc --dump-ir` prints it (`ir_dump` in src/ir.c):
// per fn its header, captures and locals, then each block's instructions and
// terminator, every field codegen reads. Types and strings are spelled as in
// the checked-tree dump (dump.loam). A line's source file is printed only
// where it changes within a fn.

import "std:buf"
import "std:conv"
import "ast.loam"
import "types.loam"
import "dump.loam"
import "ir.loam"

let OP_NAMES: []string = []string {
    "const.int", "const.bool", "const.str", "const.float", "load", "store", "addr", "move", "bin", "un",
    "call", "call.val", "alloc", "drop", "bound", "struct", "array", "fnval", "clos", "cast", "sizeof",
    "panic",
}

let TERM_NAMES: []string = []string { "ret", "jmp", "br", "switch", "unreachable" }

/** *The file of the last line printed in this fn; none yet when false. */
let mut LAST_FILE: string = ""
let mut HAS_LAST_FILE: bool = false

fn sp_int(b: &mut []u8, v: int) {
    push(b, u8(' '))
    buf.push_int(b, v)
}

fn put_line(b: &mut []u8, file: int, line: int) {
    buf.push_str(b, " @")
    buf.push_int(b, line)
    let f = if file >= 0 && file < dump.PATHS.len { dump.PATHS[file] } else { "" }
    if !HAS_LAST_FILE || LAST_FILE != f {
        buf.push_str(b, " file=")
        dump.put_str(b, f)
        LAST_FILE = f
        HAS_LAST_FILE = true
    }
}

fn put_place(b: &mut []u8, p: int) {
    if p == ir.NONE {
        push(b, u8('-'))
        return
    }
    let x = ir.PLACES[p]
    if x.kind == PlaceKind.Local {
        push(b, u8('%'))
        buf.push_int(b, x.local)
    } else if x.kind == PlaceKind.Field {
        put_place(b, x.base)
        push(b, u8('.'))
        buf.push_str(b, x.field)
    } else if x.kind == PlaceKind.Index {
        put_place(b, x.base)
        buf.push_str(b, "[%")
        buf.push_int(b, x.index)
        push(b, u8(']'))
    } else {
        buf.push_str(b, "*(")
        put_place(b, x.base)
        push(b, u8(')'))
    }
    push(b, u8('{'))
    dump.put_type(b, x.ty)
    push(b, u8('}'))
}

fn put_inst(b: &mut []u8, i: int) {
    let x = &ir.INSTS[i]
    buf.push_str(b, "    ")
    buf.push_str(b, OP_NAMES[x.op])
    sp_int(b, x.dst)
    sp_int(b, x.a)
    sp_int(b, x.b)
    put_line(b, x.file, x.line)
    if x.place != ir.NONE {
        buf.push_str(b, " place=")
        put_place(b, x.place)
    }
    if x.imm != i64(0) {
        buf.push_str(b, " imm=")
        buf.push_i64(b, x.imm)
    }
    if x.fimm != 0.0 {
        buf.push_str(b, " f=")
        buf.push_str(b, conv.f64_to_str(x.fimm))
    }
    if x.has_text {
        if x.op == Op.ConstStr {
            buf.push_str(b, " str=")
            dump.put_str(b, x.text)
        } else {
            buf.push_str(b, " callee=")
            buf.push_str(b, x.text)
        }
    }
    if x.nargs > 0 {
        buf.push_str(b, " args=")
        for k in 0..x.nargs {
            if k > 0 {
                push(b, u8(','))
            }
            buf.push_int(b, ir.ARGS[x.args + k])
        }
    }
    if x.binop != 0 {
        buf.push_str(b, " op=")
        buf.push_int(b, x.binop)
    }
    if (x.bits & ir.I_MUT) != 0 {
        buf.push_str(b, " mut=1")
    }
    if x.conv != 0 {
        buf.push_str(b, " conv=")
        buf.push_int(b, x.conv)
    }
    if (x.bits & ir.I_CHECKED) != 0 {
        buf.push_str(b, " chk=1")
    }
    if (x.bits & ir.I_BORROWED) != 0 {
        buf.push_str(b, " borrowed=1")
    }
    if x.nints > 0 {
        buf.push_str(b, " ints=")
        for k in 0..x.nints {
            if k > 0 {
                push(b, u8(','))
            }
            buf.push_i64(b, ir.INTS[x.ints + k])
        }
    }
    if x.dflt != ir.NONE {
        buf.push_str(b, " dflt=")
        let mut first = true
        for k in 0..x.nargs {
            if ir.DFLT[x.dflt + k] != ir.NONE {
                if !first {
                    push(b, u8(','))
                }
                buf.push_int(b, k)
                first = false
            }
        }
    }
    if x.ty != types.NO_TYPE {
        buf.push_str(b, " ty=")
        dump.put_type(b, x.ty)
    }
    push(b, u8('\n'))
}

fn put_fn(b: &mut []u8, f: int) {
    let fx = &ir.FNS[f]
    HAS_LAST_FILE = false
    buf.push_str(b, "fn ")
    buf.push_str(b, if fx.has_cname { fx.cname } else { "-" })
    if fx.has_name {
        buf.push_str(b, " name=")
        dump.put_str(b, fx.name)
    }
    buf.push_str(b, " sig=")
    dump.put_type(b, fx.sig)
    buf.push_str(b, " params=")
    buf.push_int(b, fx.nparams)
    if fx.is_main {
        buf.push_str(b, " main=1")
    }
    if !fx.lowered {
        buf.push_str(b, " partial=1")
    }
    if fx.clos_id != 0 {
        buf.push_str(b, " clos=")
        buf.push_int(b, fx.clos_id)
        buf.push_str(b, " env=")
        buf.push_int(b, fx.env_local)
    }
    if fx.init_mod != 0 {
        buf.push_str(b, " init_mod=")
        buf.push_int(b, fx.init_mod)
    }
    push(b, u8('\n'))
    for c in 0..fx.caps.len {
        buf.push_str(b, "  cap ")
        dump.put_str(b, fx.caps[c])
        push(b, u8(' '))
        dump.put_type(b, if c < fx.cap_types.len { fx.cap_types[c] } else { types.NO_TYPE })
        push(b, u8('\n'))
    }
    for l in 0..fx.nlocals {
        let lo = &ir.LOCALS[fx.locals + l]
        buf.push_str(b, "  local ")
        buf.push_int(b, l)
        if lo.has_name {
            buf.push_str(b, " name=")
            dump.put_str(b, lo.name)
        }
        buf.push_str(b, " ty=")
        dump.put_type(b, lo.ty)
        if (lo.flags & ir.L_PARAM) != 0 {
            buf.push_str(b, " param=1")
        }
        if (lo.flags & ir.L_GLOBAL) != 0 {
            buf.push_str(b, " global=1")
        }
        if lo.has_cname {
            buf.push_str(b, " cname=")
            buf.push_str(b, lo.cname)
        }
        if (lo.flags & ir.L_DROP) != 0 {
            buf.push_str(b, " drop=1")
        }
        if (lo.flags & ir.L_ZERO_INIT) != 0 {
            buf.push_str(b, " zero_init=1")
        }
        if (lo.flags & ir.L_NEEDS_ZERO) != 0 {
            buf.push_str(b, " needs_zero=1")
        }
        push(b, u8('\n'))
    }
    for bi in 0..fx.nblocks {
        let blk = ir.BLOCKS[fx.blocks + bi]
        buf.push_str(b, "  bb")
        buf.push_int(b, bi)
        push(b, u8('\n'))
        for k in 0..blk.count {
            put_inst(b, blk.first + k)
        }
        buf.push_str(b, "    ")
        buf.push_str(b, TERM_NAMES[blk.term])
        sp_int(b, blk.term_val)
        sp_int(b, blk.succ0)
        sp_int(b, blk.succ1)
        for c in 0..blk.sw_n {
            buf.push_str(b, if c == 0 { " cases=" } else { "," })
            buf.push_i64(b, ir.SW_VALS[blk.sw + c])
            push(b, u8(':'))
            buf.push_int(b, ir.SW_BLOCKS[blk.sw + c])
        }
        if blk.term != Term.Unreachable {
            put_line(b, blk.term_file, blk.term_line)
        }
        push(b, u8('\n'))
        dump.flush_big(b)
    }
}

/** *Print every fn into `b` (flushed to stdout as it grows). */
fn dump_ir(b: &mut []u8) {
    for f in 0..ir.FNS.len {
        put_fn(b, f)
        dump.flush_big(b)
    }
}
