// moddump — load a program from its entry file and print the module list in
// the format of `loamc --dump-modules` (src/ast_dump.c): the runtime header
// and std paths, then per module its name, load rank, std flag and path, and
// each import's alias, spec and resolved path. After a load or parse error
// only the diagnostics are printed (stderr) and the exit status is 1.
// `nob integration selfhost_load` diffs the two over every .loam file.
import "std:buf"
import "std:fmt"
import "std:sys"
import "dump.loam"
import "loader.loam"

fn main() {
    if sys.argc() != 2 {
        fmt.eprintln("usage: moddump main.loam")
        sys.exit(2)
    }
    if !loader.load(sys.arg(1)) {
        dump.print_diags()
        sys.exit(1)
    }
    let mut b = []u8 {}
    loader.dump_modules(&mut b)
    fmt.write(buf.to_string(&b))
}
