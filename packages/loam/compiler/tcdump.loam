// tcdump — typecheck a session and print it in the format of
// `loamc --dump-typed` (src/ast_dump.c). The input is the module list of
// `loamc --dump-modules`: module loading and package resolution stay C until
// the driver is ported, so this starts from what the C loader resolved, parses
// each module itself, and replays the loader's edits to the tree (module
// names, the implicit `http` / `std:json` imports, resolved import paths).
//
// With `--checked`, the passes after typecheck run too (`loamc
// --dump-checked`): threadcheck, borrowck, boundscheck. `--ir` and `--dce`
// print the IR and the fns dead-code elimination keeps; `--c` the whole C
// translation unit (`loamc --dump-c`). `--all <dir>` writes all five from one
// run, as `loamc --dump-all <dir>` does: in `dir`, `typecheck`, `check`, `ir`,
// `dce` and `codegen` hold what each mode prints (stdout and stderr), and
// `<name>.exit` its exit status ("exit N").
//
// Exit status: 0 typed, 1 a parse error, 2 a type error (diagnostics on
// stderr, as C), 3 an error from a later pass, 4 a bad module list.
import "std:buf"
import "std:fmt"
import "std:result"
import "std:str"
import "std:sys"
import "ast.loam"
import "types.loam"
import "parser.loam"
import "dump.loam"
import "typecheck.loam"
import "threadcheck.loam"
import "borrowck.loam"
import "dce.loam"
import "codegen.loam"
import "loader.loam"
import "ir.loam"
import "irdump.loam"
import "boundscheck.loam"

/** *An import line of the module list. */
struct ListImport {
    alias: string,
    spec: string,
    resolved: string,
}

fn fail(msg: string) {
    fmt.eprintln("tcdump:", msg)
    sys.exit(4)
}

/** *The quoted value of `key="..."` in `line` (ast_dump.c's escapes undone). */
fn attr(line: string, key: string) -> string {
    let at = str.index_of(line, " {{key}}=\"")
    if at < 0 {
        fail("no {{key}} in: {{line}}")
    }
    let mut b = []u8 {}
    let mut i = at + key.len + 3
    while i < line.len && line[i] != '"' {
        if line[i] == '\\' && i + 1 < line.len {
            i = i + 1
            let c = line[i]
            if c == 'n' {
                push(b, u8('\n'))
            } else if c == 't' {
                push(b, u8('\t'))
            } else if c == 'r' {
                push(b, u8('\r'))
            } else {
                push(b, u8(c))
            }
        } else {
            push(b, u8(line[i]))
        }
        i = i + 1
    }
    return buf.to_string(&b)
}

fn int_attr(line: string, key: string) -> int {
    let at = str.index_of(line, " {{key}}=")
    if at < 0 {
        fail("no {{key}} in: {{line}}")
    }
    let mut v = 0
    let mut i = at + key.len + 2
    while i < line.len && line[i] >= '0' && line[i] <= '9' {
        v = v * 10 + line[i] - '0'
        i = i + 1
    }
    return v
}

fn import_node(alias: string, spec: string, loc: Loc) -> int {
    let mut n = ast.node(Kind.Import, loc)
    n.name = alias
    n.has_name = true
    n.text = spec
    n.has_text = true
    return ast.add(n)
}

/** *compile.c's `load_module` edits after the parse: the module name, and */
/** *outside `http` an implicit import for `#[proto]` / `#[json]` structs. */
fn loader_edits(root: int, name: string) {
    ast.EXTRA[ast.ex_mut(root)].sname = name
    ast.EXTRA[ast.ex_mut(root)].has_sname = true
    if name == "http" {
        return
    }
    let kids = ast.NODES[root].kids
    let mut has_proto = false
    let mut has_json = false
    let mut has_http = false
    let mut has_std_json = false
    for k in 0..kids.len {
        let d = ast.full(kids[k])
        if d.kind == Kind.Struct && (d.op & parser.ST_PROTO) != 0 {
            has_proto = true
        }
        if d.kind == Kind.Struct && (d.op & parser.ST_JSON) != 0 {
            has_json = true
        }
        if d.kind == Kind.Import {
            if d.text == "http" || d.text == "std:http" || d.text == "pkg:http" {
                has_http = true
            }
            if d.text == "std:json" {
                has_std_json = true
            }
        }
    }
    let loc = ast.INFO[root].loc
    if has_proto && !has_http {
        let im = import_node("http", "http", loc)
        push(ast.NODES[root].kids, im)
    }
    if has_json && !has_std_json {
        let im = import_node("json", "std:json", loc)
        push(ast.NODES[root].kids, im)
    }
}

fn main() {
    // `--checked`: also the passes after typecheck, as `loamc --dump-checked`.
    // `--ir`: then lowered to IR and printed, as `loamc --dump-ir`.
    // `--dce`: then the fns dead-code elimination keeps, as `loamc --dump-dce`.
    // `--c`: then the C a default build emits, as `loamc --dump-c`.
    let lower_ir = sys.argc() == 3 && sys.arg(1) == "--ir"
    let run_dce = sys.argc() == 3 && sys.arg(1) == "--dce"
    let emit_c = sys.argc() == 3 && sys.arg(1) == "--c"
    let list_modules = sys.argc() == 3 && sys.arg(1) == "--modules"
    let all_dir = if sys.argc() == 4 && sys.arg(1) == "--all" { sys.arg(2) } else { "" }
    let run_later_passes = sys.argc() == 3 && (sys.arg(1) == "--checked" || lower_ir || run_dce || emit_c)
    if sys.argc() != 2 && !run_later_passes && !list_modules && all_dir.len == 0 {
        fmt.eprintln("usage: tcdump [--modules | --checked | --ir | --dce | --c | --all <dir>] (main.loam | modules.txt)")
        fmt.eprintln("  modules.txt: from loamc --dump-modules main.loam")
        sys.exit(2)
    }
    let input = sys.arg(sys.argc() - 1)
    // A source file is loaded by the Loam loader; a module list replays C's.
    if str.ends_with(input, ".loam") || str.ends_with(input, ".loa") {
        if !loader.load(input) {
            dump.print_diags()
            sys.exit(1)
        }
        if list_modules {
            let mut lb = []u8 {}
            loader.dump_modules(&mut lb)
            fmt.write(buf.to_string(&lb))
            sys.exit(0)
        }
        check_and_dump(all_dir, run_later_passes, run_dce, lower_ir, emit_c)
        return
    }
    if list_modules {
        fail("--modules takes a .loam file")
    }
    let module_list_path = input
    let lr = sys.read(module_list_path)
    if lr.tag == ResultTag.Err {
        fail("cannot read {{module_list_path}}")
    }
    let lines = str.lines(lr.val)
    let mut imports: [][]ListImport = [][]ListImport {}
    for i in 0..lines.len {
        let line = lines[i]
        if str.starts_with(line, "rt ") {
            typecheck.RT_PATH = attr(" x={{str.slice_from(line, 3)}}", "x")
        } else if str.starts_with(line, "std ") {
            typecheck.STD_DIR = attr(" x={{str.slice_from(line, 4)}}", "x")
        } else if str.starts_with(line, "module ") {
            push(typecheck.MODS, Module {
                name: attr(line, "name"),
                path: attr(line, "path"),
                rank: int_attr(line, "rank"),
                root: ast.NONE,
                is_std: int_attr(line, "std") != 0,
            })
            push(imports, []ListImport {})
        } else if str.starts_with(line, "  import ") {
            if imports.len == 0 {
                fail("import before any module")
            }
            push(imports[imports.len - 1], ListImport {
                alias: attr(line, "alias"),
                spec: attr(line, "spec"),
                resolved: attr(line, "resolved"),
            })
        } else if line.len > 0 {
            fail("unexpected line: {{line}}")
        }
    }
    if typecheck.MODS.len == 0 {
        fail("no modules")
    }
    let mut paths = []string {}
    for m in 0..typecheck.MODS.len {
        push(paths, typecheck.MODS[m].path)
    }
    dump.PATHS = paths

    let mut p = parser.parser_new("")
    for m in 0..typecheck.MODS.len {
        let path = typecheck.MODS[m].path
        let r = sys.read(path)
        if r.tag == ResultTag.Err {
            fail("cannot read {{path}}")
        }
        parser.parser_load(&mut p, r.val, m)
        let root = parser.parse_program(&mut p)
        if p.had_error {
            dump.print_diags()
            sys.exit(1)
        }
        typecheck.MODS[m].root = root
        loader_edits(root, typecheck.MODS[m].name)
        // The resolved path of each import, in the loader's order.
        let kids = ast.NODES[root].kids
        let want = imports[m]
        let mut j = 0
        for k in 0..kids.len {
            let im = kids[k]
            if ast.NODES[im].kind != Kind.Import {
                continue
            }
            if j >= want.len || want[j].alias != ast.INFO[im].name || want[j].spec != ast.EXTRA[ast.ex(im)].text {
                fail("module {{m}}: imports differ from the list")
            }
            ast.EXTRA[ast.ex_mut(im)].sname = want[j].resolved
            ast.EXTRA[ast.ex_mut(im)].has_sname = true
            j = j + 1
        }
        if j != want.len {
            fail("module {{m}}: the list has more imports")
        }
    }

    check_and_dump(all_dir, run_later_passes, run_dce, lower_ir, emit_c)
}

/** *The passes after typecheck: threadcheck, borrowck, boundscheck. The */
/** *number of errors threadcheck and borrowck found. */
fn run_later_passes_count() -> int {
    let mut module_names = []string {}
    let mut module_roots = []int {}
    for m in 0..typecheck.MODS.len {
        push(module_names, typecheck.MODS[m].name)
        push(module_roots, typecheck.MODS[m].root)
    }
    let mut later_errors = threadcheck.threadcheck_modules(module_names, module_roots)
    later_errors = later_errors + borrowck.borrowck_modules()
    boundscheck.boundscheck_modules(module_roots)
    return later_errors
}

/** *Typecheck the loaded modules, run the later passes if asked, and print */
/** *what the mode asks for (or, with `all_dir`, write every mode's output). */
fn check_and_dump(all_dir: string, run_later_passes: bool, run_dce: bool, lower_ir: bool, emit_c: bool) {
    types.types_init()
    let errors = typecheck.typecheck_modules()
    if all_dir.len > 0 {
        dump_all(all_dir, errors)
        sys.exit(0)
    }
    dump.print_diags()
    if errors > 0 {
        sys.exit(2)
    }
    if run_later_passes {
        if run_later_passes_count() > 0 {
            dump.print_diags()
            sys.exit(3)
        }
    }
    if emit_c {
        codegen.emit_c()
        sys.exit(0)
    }
    dump.TYPED = true
    let mut b = []u8 {}
    if run_dce {
        put_dce(&mut b)
        fmt.write(buf.to_string(&b))
        sys.exit(0)
    }
    if lower_ir {
        let bad = put_ir(&mut b)
        fmt.write(buf.to_string(&b))
        sys.exit(if bad { 1 } else { 0 })
    }
    put_typed(&mut b)
    fmt.write(buf.to_string(&b))
    // Exit now: tearing down the ~300k-node arena one release at a time costs
    // more than the dump (the OS frees the pages at once).
    sys.exit(0)
}

/** *Run dead-code elimination and put the fns it keeps, per module. */
fn put_dce(b: &mut []u8) {
    dce.run()
    for m in 0..typecheck.MODS.len {
        buf.push_str(b, "module ")
        buf.push_int(b, m)
        dump.attr_str(b, "name", true, typecheck.MODS[m].name)
        push(*b, u8('\n'))
        let root = typecheck.MODS[m].root
        if root == ast.NONE {
            continue
        }
        let decls = ast.NODES[root].kids
        for i in 0..decls.len {
            if ast.NODES[decls[i]].kind == Kind.Fn && dce.keep(decls[i]) {
                buf.push_str(b, "  keep")
                dump.put_ref(b, "fn", decls[i])
                push(*b, u8('\n'))
            }
        }
    }
}

/** *Lower to IR and put it with the verifier's verdict; true when bad. */
fn put_ir(b: &mut []u8) -> bool {
    ir.lower_modules()
    irdump.dump_ir(b)
    let bad = ir.verify()
    buf.push_str(b, if bad { "verify bad\n" } else { "verify ok\n" })
    return bad
}

/** *Put the typed trees and typecheck's tables (monos, struct instances, */
/** *globals). */
fn put_typed(b: &mut []u8) {
    for m in 0..typecheck.MODS.len {
        buf.push_str(b, "module ")
        buf.push_int(b, m)
        dump.attr_str(b, "name", true, typecheck.MODS[m].name)
        push(*b, u8('\n'))
        dump.dump(b, typecheck.MODS[m].root, 1, "root")
    }
    for i in 0..typecheck.MONOS.len {
        let mo = typecheck.MONOS[i]
        buf.push_str(b, "mono")
        dump.attr_str(b, "cname", true, mo.cname)
        dump.put_ref(b, "fn", mo.fn_)
        buf.push_str(b, " args=")
        for k in 0..mo.args.len {
            if k > 0 {
                push(*b, u8(','))
            }
            dump.put_type(b, mo.args[k])
        }
        push(*b, u8('\n'))
        dump.flush_big(b)
    }
    for i in 0..typecheck.STRUCT_INSTS.len {
        buf.push_str(b, "struct_inst ")
        dump.put_type(b, typecheck.STRUCT_INSTS[i])
        push(*b, u8('\n'))
        dump.flush_big(b)
    }
    for i in 0..typecheck.GVARS.len {
        let g = typecheck.GVARS[i]
        buf.push_str(b, "global")
        dump.attr_str(b, "cname", true, g.cname)
        buf.push_str(b, " mod=")
        buf.push_int(b, g.mod)
        dump.put_ref(b, "var", g.var)
        push(*b, u8('\n'))
        dump.flush_big(b)
    }
}

/** *`text` as the start of a fresh output buffer. */
fn bytes_of(text: string) -> []u8 {
    let mut b = []u8 {}
    buf.push_str(&mut b, text)
    return b
}

/** *`<dir>/<name>` and `<dir>/<name>.exit` for one mode of `--all`. */
fn write_stage(dir: string, name: string, b: &[]u8, status: int) {
    if sys.write_bytes("{{dir}}/{{name}}", b) != 0 {
        fail("cannot write {{dir}}/{{name}}")
    }
    write_stage_exit(dir, name, status)
}

fn write_stage_exit(dir: string, name: string, status: int) {
    if sys.write_file("{{dir}}/{{name}}.exit", "exit {{status}}\n") != 0 {
        fail("cannot write {{dir}}/{{name}}.exit")
    }
}

/** *`--all <dir>`: what each of the five modes prints, from this one run. */
/** *Each mode prints the diagnostics so far and then its dump, so every file */
/** *starts with the same diagnostic text. The IR is lowered before DCE runs, */
/** *as `--ir` lowers it, and codegen reuses that IR (`ir.LOWERED`). */
fn dump_all(dir: string, typecheck_errors: int) {
    let typecheck_diags = dump.diags_text()
    let after_typecheck = []string { "check", "ir", "dce", "codegen" }
    if typecheck_errors > 0 {
        let b = bytes_of(typecheck_diags)
        write_stage(dir, "typecheck", &b, 2)
        for i in 0..after_typecheck.len {
            write_stage(dir, after_typecheck[i], &b, 2)
        }
        return
    }
    dump.HOLD = true
    dump.TYPED = true
    let mut typed = bytes_of(typecheck_diags)
    put_typed(&mut typed)
    write_stage(dir, "typecheck", &typed, 0)
    typed = []u8 {}
    let later_errors = run_later_passes_count()
    // A later error prints every diagnostic again, as `print_diags` does.
    let diags = "{{typecheck_diags}}{{dump.diags_text()}}"
    if later_errors > 0 {
        let b = bytes_of(diags)
        for i in 0..after_typecheck.len {
            write_stage(dir, after_typecheck[i], &b, 3)
        }
        return
    }
    let mut checked = bytes_of(diags)
    put_typed(&mut checked)
    write_stage(dir, "check", &checked, 0)
    checked = []u8 {}
    let mut lowered = bytes_of(diags)
    let bad = put_ir(&mut lowered)
    write_stage(dir, "ir", &lowered, if bad { 1 } else { 0 })
    lowered = []u8 {}
    let mut kept = bytes_of(diags)
    put_dce(&mut kept)
    write_stage(dir, "dce", &kept, 0)
    kept = []u8 {}
    codegen.OUT = bytes_of(diags)
    codegen.SINK = "{{dir}}/codegen"
    codegen.emit_c()
    write_stage_exit(dir, "codegen", 0)
}
