// dce — which fn declarations codegen emits: reachability over the resolved
// call graph. A port of the C compiler's dce.c.
//
// Roots: every fn of the entry module (but a `#[c]` one, kept by its
// callers), every `#[test]` fn, every module `let` initializer (codegen runs
// them all from `__init`), the fns the C runtime and hosts call by name, and
// every fn of a user package the entry imports whole. Then a worklist walks
// each kept fn's body and parameter defaults, keeping what a name resolves to.
// A generic fn with instances has its body walked even when the generic
// itself is not kept: the instances are emitted from the IR and call what it
// calls.
//
// Sets are flags per node, not lists searched: the C keeps them as arrays and
// scans them on every insert.

import "std:map"
import "ast.loam"
import "typecheck.loam"

const NONE: int = -1

// `Fn` node `op` bits (parser.loam).
const FN_TEST: int = 2
const FN_SERVER: int = 4

/** *The `loam test` runner calls the `test` module's fns from C. */
let mut TEST_MODE: bool = false
/** *`#[server]` bodies are dropped from this build, so what only they call */
/** *is not reachable. */
let mut SERVER_SPLIT: bool = false
/** *`LOAM_NO_DCE`: `emit_c` skips the pass and every fn is kept. */
let mut SKIP: bool = false
/** *`run` has filled `KEPT`; until then `keep` keeps everything. */
let mut RAN: bool = false

/** *Per node: kept (its C is emitted), and its body already walked. */
let mut KEPT: []bool = []bool {}
let mut DONE: []bool = []bool {}
/** *Kept fns, in the order they were kept: the worklist. */
let mut TODO: []int = []int {}

/** *What the runtime and hosts call, by module: `loam_<module>_<name>`. */
fn c_roots(module_name: string) -> []string {
    if module_name == "zeus" {
        return []string {
            "engine_layout", "engine_paint", "engine_step", "engine_step_dt", "engine_set_reduced_motion",
            "engine_next_ms", "engine_fonts_changed", "engine_click", "engine_grab", "engine_scroll",
            "engine_scroll_latch", "engine_scroll_step", "engine_scroll_smooth", "engine_drag", "engine_hover",
            "engine_mouseup", "engine_over_button", "engine_cursor", "engine_a11y_dump", "engine_a11y_bytes",
            "engine_layout_gen", "engine_signals_dump", "engine_state_load", "engine_a11y_activate",
            "engine_a11y_focus", "engine_focus_id", "engine_focus_captures_text", "engine_key",
            "engine_key_ev", "engine_key_up", "engine_set_mods", "engine_insert", "engine_marked",
            "engine_picked_image", "engine_media_picked", "engine_context_click",
            "engine_window_drag_at", "engine_recover",
            "engine_trap_seq", "get", "set", "signal",
        }
    }
    if module_name == "maya" {
        return []string {
            "engine_cam_orbit", "engine_cam_pan", "engine_cam_reset", "engine_fixed_update", "engine_frame",
            "engine_hud", "engine_input_key", "engine_cam_zoom", "engine_fb_at", "engine_fb_h", "engine_fb_w",
            "engine_is_map", "engine_note_present", "engine_set_viewport", "engine_sprite_count",
            "engine_sprite_is_sun", "engine_sprite_name", "engine_sprite_orbit_r", "engine_sprite_r",
            "engine_sprite_rgb", "engine_sprite_x", "engine_sprite_y",
        }
    }
    // A `LOAM_BATCH` main calls the fork-per-case runner, `loam_batch_serve`.
    if module_name == "batch" {
        return []string { "serve" }
    }
    // The web host binds fonts through `loam_metrics_bind`.
    if module_name == "metrics" {
        return []string { "bind" }
    }
    // Hosts deliver deep links, the OS back button and chunk loads.
    // `zeus_boundary_preset_add` calls this before `main`. Nothing in Loam does.
    if module_name == "runtime" {
        return []string { "preset_store" }
    }
    if module_name == "router" {
        return []string { "engine_open_url", "engine_history_back", "engine_chunks_done", "engine_chunks_slow" }
    }
    return []string {}
}

fn kind(n: int) -> int {
    if n == NONE {
        return -1
    }
    return ast.NODES[n].kind
}

fn mark_fn(f: int) {
    if kind(f) != Kind.Fn || KEPT[f] {
        return
    }
    KEPT[f] = true
    push(TODO, f)
    // Calls name an `#[os]` fn's first variant; the build keeps each one,
    // and the C compiler picks the target's.
    if typecheck.os_mask(f) != 0 {
        let p = typecheck.os_primary(f)
        for i in 0..typecheck.OS_DECLS.len {
            let v = typecheck.OS_DECLS[i]
            if typecheck.os_primary(v) == p {
                mark_fn(v)
            }
        }
    }
}

fn walk_list(nodes: &[]int) {
    for i in 0..nodes.len {
        walk(nodes[i])
    }
}

/** *Each parameter's default value. */
fn walk_params(f: int) {
    let params = &ast.NODES[f].kids
    for i in 0..params.len {
        walk(ast.NODES[params[i]].b)
    }
}

/** *Loam fns by their C name, for builtins implemented in Loam: a call the */
/** *checker gave a C name (`"{{n}}"` is `loam_decimal_of_int`) keeps the fn. */
let mut BY_CNAME: Map<int> = map.new(-1)

/** *Keep the Loam fn whose C name is `cname`, if there is one. */
fn mark_cname(cname: string) {
    let f = map.get(&mut BY_CNAME, map.key_str(cname))
    if f >= 0 {
        mark_fn(f)
    }
}

fn walk(n: int) {
    if n == NONE {
        return
    }
    let x = &ast.NODES[n]
    if x.kind == Kind.Call {
        let cx = ast.ex(n)
        if ast.EXTRA[cx].has_cbuiltin {
            mark_cname(ast.EXTRA[cx].cbuiltin)
        }
        // `println(n)` / `eprintln(n)` write an integer with `std:decimal`.
        if (ast.INFO[n].marks & ast.M_PRINTLN) != 0 {
            mark_cname("loam_decimal_write_int")
            mark_cname("loam_decimal_write_u64")
            mark_cname("loam_decimal_ewrite_int")
            mark_cname("loam_decimal_ewrite_u64")
            mark_cname("loam_fmt_write_bool")
            mark_cname("loam_fmt_ewrite_bool")
            mark_cname("loam_fmt_writeln")
            mark_cname("loam_fmt_ewriteln")
            // A float, with `std:floattext` (loaded when floats appear).
            mark_cname("loam_floattext_write")
            mark_cname("loam_floattext_ewrite")
        }
        // `__value_key(x)` appends with the `std:key` fns; each keeps itself
        // and what it calls (`decimal`, `buf`, `conv` bits) through the
        // ordinary call walk.
        // An interpolation formats its integers with `std:decimal`'s `fill`.
        if ast.EXTRA[ast.ex(n)].has_cbuiltin && ast.EXTRA[ast.ex(n)].cbuiltin == "loam_interp" {
            mark_cname("loam_decimal_fill")
            mark_cname("loam_decimal_magnitude_of")
            mark_cname("loam_floattext_of_float")
        }
        if (ast.INFO[n].marks & ast.M_VALUE_KEY) != 0 {
            mark_cname("loam_key_push_vec_tag")
            mark_cname("loam_key_push_str")
            mark_cname("loam_decimal_push_int")
            mark_cname("loam_decimal_push_u64")
            mark_cname("loam_key_push_f32")
            mark_cname("loam_key_push_f64")
            mark_cname("loam_key_push_addr")
        }
        // A `__fut_*` builtin lowers in codegen to the Loam table in
        // `std:async` (R3.1) plus an inline `memcpy`: keep the table fns.
        // What they call (`panic`, vec growth) follows the ordinary walk.
        if ast.EXTRA[ast.ex(n)].fut != 0 {
            mark_cname("loam_async_fut_alloc")
            mark_cname("loam_async_fut_arena")
            mark_cname("loam_async_fut_off")
            mark_cname("loam_async_fut_live")
            mark_cname("loam_async_fut_check")
            mark_cname("loam_async_fut_is_ready")
            mark_cname("loam_async_fut_unready")
            mark_cname("loam_async_fut_mark_ready")
        }
        // A `__ch_*` builtin lowers in codegen to the Loam table in
        // `std:thread` (R3.2) plus one atomic C section: keep the table fns.
        // The lock calls order them against workers (TSan sees the pthread
        // calls); what they call follows the ordinary walk.
        if ast.EXTRA[ast.ex(n)].ch != 0 {
            mark_cname("loam_thread_ch_alloc")
            mark_cname("loam_thread_ch_begin")
        }
        // The `__sig_*` builtins lower in codegen to the Loam signal store
        // (R4.1b: `arena` reserves the id, `sigcells` keeps the bytes) plus
        // one `memcpy` per access: keep the fns the generated C names.
        let sig_op = ast.EXTRA[ast.ex(n)].sig
        if sig_op == 1 {
            mark_cname("loam_arena_sig_reserve")
            mark_cname("loam_arena_sig_new_int")
            mark_cname("loam_arena_sig_new_zero")
        }
        if sig_op != 0 {
            mark_cname("loam_sigcells_bind_at")
            mark_cname("loam_sigcells_load_at")
            mark_cname("loam_sigcells_cmp_at")
            mark_cname("loam_arena_store_sig")
            mark_cname("loam_arena_note_write")
        }
    }
    // Captured-`let mut` state signals lower to calls of these `arena` fns.
    if x.kind == Kind.Var && (ast.NODES[n].flags & typecheck.ASTF_STATE) != 0 {
        mark_cname("loam_arena_sig_reserve")
        mark_cname("loam_arena_sig_new_int")
        mark_cname("loam_arena_state_get")
        mark_cname("loam_arena_store_sig")
    }
    switch x.kind {
        case Kind.Ident:
            mark_fn(x.res)
            break
        case Kind.Field:
            mark_fn(x.res)
            walk(x.a)
            break
        case Kind.Fn, Kind.Closure:
            walk(x.b)
            walk_params(n)
            break
        case Kind.Block, Kind.StructLit, Kind.ArrayLit, Kind.Tuple:
            walk_list(&x.kids)
            break
        case Kind.If:
            walk(x.a)
            walk(x.b)
            walk(x.c)
            break
        case Kind.For, Kind.While, Kind.Assign, Kind.Binary, Kind.Index:
            walk(x.a)
            walk(x.b)
            break
        case Kind.Switch, Kind.Call:
            walk(x.a)
            walk_list(&x.kids)
            break
        case Kind.Case:
            walk_list(&x.kids)
            walk(x.a)
            break
        case Kind.Return, Kind.ExprStmt, Kind.Unary, Kind.Cast, Kind.Try, Kind.Deref, Kind.Addr:
            walk(x.a)
            break
        case Kind.Var:
            walk(x.b)
            break
        default:
            // Types, literals, enums, structs: nothing to call. (`++` / `--`
            // are not walked, as in dce.c: their operand is a place.)
            return
    }
}

/** *A generic fn some instance was recorded for. */
fn has_mono_instance(f: int) -> bool {
    for i in 0..typecheck.MONOS.len {
        if typecheck.MONOS[i].fn_ == f {
            return true
        }
    }
    return false
}

/** *A bare package spec: `wide`, not `wide.loam`, `./wide` or `zeus:router`. */
fn entry_full_package(spec: string) -> bool {
    if spec.len == 0 {
        return false
    }
    for i in 0..spec.len {
        let c = spec[i]
        if c == '/' || c == '\\' || c == ':' {
            return false
        }
    }
    if spec.len >= 5 && str_suffix(spec, ".loam") {
        return false
    }
    if spec.len >= 4 && str_suffix(spec, ".loa") {
        return false
    }
    return true
}

fn str_suffix(s: string, suffix: string) -> bool {
    let off = s.len - suffix.len
    for k in 0..suffix.len {
        if s[off + k] != suffix[k] {
            return false
        }
    }
    return true
}

/** *Keep every fn of a user (non-std) package the entry imported whole. */
fn root_full_package_imports() {
    if typecheck.MODS.len == 0 || typecheck.MODS[0].root == NONE {
        return
    }
    let entry_kids = ast.NODES[typecheck.MODS[0].root].kids
    for i in 0..entry_kids.len {
        let im = entry_kids[i]
        if kind(im) != Kind.Import || ast.NODES[im].kids.len != 0 {
            continue
        }
        let x = ast.ex(im)
        if !ast.EXTRA[x].has_text || !entry_full_package(ast.EXTRA[x].text) || !ast.EXTRA[x].has_sname {
            continue
        }
        let resolved = ast.EXTRA[x].sname
        for m in 1..typecheck.MODS.len {
            if typecheck.MODS[m].path != resolved {
                continue
            }
            let root = typecheck.MODS[m].root
            if typecheck.MODS[m].is_std || root == NONE {
                break
            }
            let decls = ast.NODES[root].kids
            for d in 0..decls.len {
                mark_fn(decls[d])
            }
            break
        }
    }
}

/** *Find what codegen keeps; then `keep(f)` answers per fn declaration. */
fn run() {
    RAN = true
    KEPT = []bool {}
    DONE = []bool {}
    for i in 0..ast.NODES.len {
        push(KEPT, false)
        push(DONE, false)
    }
    TODO = []int {}
    BY_CNAME = map.new(-1)
    let nmods = typecheck.MODS.len
    for m in 0..nmods {
        let root = typecheck.MODS[m].root
        if root == NONE {
            continue
        }
        let decls = ast.NODES[root].kids
        for i in 0..decls.len {
            let d = decls[i]
            if kind(d) == Kind.Fn && ast.EXTRA[ast.ex(d)].has_sname {
                map.put(&mut BY_CNAME, map.key_str(ast.EXTRA[ast.ex(d)].sname), d)
            }
        }
    }
    for m in 0..nmods {
        let root = typecheck.MODS[m].root
        if root == NONE {
            continue
        }
        let module_name = typecheck.MODS[m].name
        let test_mod = TEST_MODE && module_name == "test"
        let roots = c_roots(module_name)
        let decls = ast.NODES[root].kids
        for i in 0..decls.len {
            let d = decls[i]
            let k = kind(d)
            if test_mod && k == Kind.Fn {
                mark_fn(d)
                continue
            }
            if k == Kind.Var {
                walk(ast.NODES[d].b)
                continue
            }
            if k != Kind.Fn {
                continue
            }
            // A `#[test]` fn is called by the generated runner, in any module.
            if (ast.NODES[d].op & FN_TEST) != 0 {
                mark_fn(d)
                continue
            }
            let x = ast.ex(d)
            // A `#[c]` fn is kept by its callers: it decides what C gets linked.
            if m == 0 && !ast.EXTRA[x].has_text {
                mark_fn(d)
                continue
            }
            if !ast.EXTRA[x].has_sname {
                continue
            }
            for r in 0..roots.len {
                if ast.EXTRA[x].sname == "loam_{{module_name}}_{{roots[r]}}" {
                    mark_fn(d)
                    break
                }
            }
        }
    }
    root_full_package_imports()
    // An instantiated generic that is not kept: its instances are emitted
    // from the IR, so what its body calls must be kept.
    for m in 0..nmods {
        let root = typecheck.MODS[m].root
        if root == NONE {
            continue
        }
        let decls = ast.NODES[root].kids
        for i in 0..decls.len {
            let d = decls[i]
            if kind(d) != Kind.Fn || ast.EXTRA[ast.ex(d)].strs.len == 0 || KEPT[d] || !has_mono_instance(d) {
                continue
            }
            walk(ast.NODES[d].b)
            walk_params(d)
        }
    }
    // Each kept fn's body once, to a fixed point (the list grows as it goes).
    let mut i = 0
    while i < TODO.len {
        let f = TODO[i]
        i = i + 1
        if DONE[f] {
            continue
        }
        DONE[f] = true
        if !(SERVER_SPLIT && (ast.NODES[f].op & FN_SERVER) != 0) {
            walk(ast.NODES[f].b)
        }
        walk_params(f)
    }
}

/** *The fn declared with C name `cname` is not emitted: DCE dropped it. A */
/** *name no declaration has (an instance, a closure) is never dropped here. */
fn dropped(cname: string) -> bool {
    if !RAN {
        return false
    }
    let f = map.get(&mut BY_CNAME, map.key_str(cname))
    return f >= 0 && !keep(f)
}

/** *The fn declared with C name `cname` is emitted: it exists and DCE kept */
/** *it (every declared fn, when DCE did not run). */
fn kept_cname(cname: string) -> bool {
    let f = map.get(&mut BY_CNAME, map.key_str(cname))
    return f >= 0 && keep(f)
}

fn keep(f: int) -> bool {
    if !RAN {
        return f != NONE
    }
    return f != NONE && f < KEPT.len && KEPT[f]
}
