// ast — the syntax tree as an arena. A port of the C compiler's
// ast.h (the C compiler is gone; `C` below means that original).
//
// Every node lives in one `[]Node`, and a node names another by its index, so
// the tree holds no references (Loam keeps them out of data structures). A node
// is one wide struct: `kind` says which of its slots mean what (the table at
// `Node`). Pieces that are structs inside a C node (a parameter, a field, an
// enum variant, a selective-import name, a `#![c_*]` directive) are nodes of
// their own kind here, listed in their parent's `kids`. A struct literal's
// fields are not: its `kids` are the values and `LIT_NAMES` the names, as C's
// `FieldInit` array keeps them in the literal.
//
// `NONE` (-1) is an absent child. A parse error yields an `Error` node, never
// an invalid index, so the parser can keep going without checking every slot.

/** *An absent child. */
const NONE: int = -1

enum Kind {
    Program = 0,
    Import = 1,
    Fn = 2,
    Struct = 3,
    Enum = 4,
    Var = 5,
    Block = 6,
    If = 7,
    For = 8,
    While = 9,
    Switch = 10,
    Case = 11,
    Return = 12,
    Break = 13,
    Continue = 14,
    ExprStmt = 15,
    Assign = 16,
    Binary = 17,
    Unary = 18,
    Cast = 19,
    Call = 20,
    Index = 21,
    Field = 22,
    Ident = 23,
    Number = 24,
    Float = 25,
    String = 26,
    Bool = 27,
    StructLit = 28,
    ArrayLit = 29,
    Tuple = 30,
    Deref = 31,
    Addr = 32,
    Type = 33,
    Closure = 34,
    IncDec = 35,
    Try = 36,
    // Parts of a node, not expressions or statements.
    Param = 37,
    FieldDecl = 38,
    // 39 was `Init`, one node per struct-literal field (see `LIT_NAMES`).
    Variant = 40,
    ImportName = 41,
    CDir = 42,
    // What a failed parse returns.
    Error = 43,
}

// `flags`, as C's ast.h.
const F_AWAIT: int = 32
const F_WRAPPED_LIT: int = 128

/** *A source span: the module it is in (an index into the session's module */
/** *list; C's `SourceLoc.file`), and 1-based line and byte column, start and */
/** *end. */
struct Loc {
    file: int,
    line: int,
    col: int,
    end_line: int,
    end_col: int,
}

/** *One node. What the slots hold, by kind (anything unlisted is unused): */
/** * */
/** *- Program: `kids` the `CDir`s, `Import`s and decls in source order (their */
/** *  kinds tell them apart), `text` the module doc. */
/** *- Import: `name` alias, `text` path, `kids` `ImportName`s. */
/** *- ImportName: `name` source name, `text` local name. */
/** *- Fn / Closure: `name` (fn only), `strs` type params, `kids` `Param`s, */
/** *  `a` return type, `b` body, `text` C symbol; `op` bits 1 async, 2 test, */
/** *  4 server. */
/** *- Param: `name`, `a` type, `b` default. */
/** *- Struct: `name`, `strs` type params, `kids` `FieldDecl`s; `op` bits 1 */
/** *  proto, 2 json, 4 must_check, 8 no_send. */
/** *- FieldDecl: `name`, `a` type, `b` default, doc. */
/** *- Enum: `name`, `kids` `Variant`s. Variant: `name`, `num` value. */
/** *- Var: `name`, `op` mut, `a` type, `b` init. */
/** *- Block: `kids` statements. */
/** *- If / While: `a` cond, `b` then, `c` else. For: `name` var, `a` iter, */
/** *  `b` body. */
/** *- Switch: `a` scrutinee, `kids` cases. Case: `op` default, `kids` */
/** *  labels, `a` body. */
/** *- Return / ExprStmt / Try: `a` expr. */
/** *- Assign / Binary: `op` token kind, `a` left, `b` right. Unary: `op`, `a`. */
/** *- Cast: `a` expr, `b` type. Call: `a` callee, `kids` args. */
/** *- Index: `a` target, `b` index. Field: `name`, `op` via `::`, `a` target. */
/** *- Deref: `a`. Addr: `op` mut, `a`. */
/** *- Ident: `name`. Number: `num`. Float: `fnum`. String: `text`. Bool: `op`. */
/** *- StructLit: `name` (absent for named arguments), `kids2` type args, */
/** *  `kids` the field values, `c` their names' list in `LIT_NAMES` (same */
/** *  order). */
/** *- ArrayLit: `num` length (-1 for `[]T`), `a` element type, `kids` elems. */
/** *  Tuple: `kids` elems. */
/** *- Type: `op` tag (0 `&T`, 1 `&mut T`, 2 named, 3 array, 4 `Box<T>`, 5 */
/** *  `fn(...)`), `name` when named, `num` array length, `a` element / return */
/** *  type, `kids` fn params, `kids2` type args. */
/** *- IncDec: `op` dec, `aux` post, `a` operand. */
/** *- CDir: `op` link, `strs` args. */
/** *A whole node as it is built (`node`, then fields set) and as `full` */
/** *reassembles one; `add` stores it split into `NODES` and `INFO`. */
struct NodeBuild {
    kind: int,
    loc: Loc,
    flags: int,
    op: int,
    aux: int,
    /** *Whether `name` / `text` / `doc` are present (C's non-NULL). */
    has_name: bool,
    has_text: bool,
    has_doc: bool,
    name: string,
    text: string,
    doc: string,
    num: i64,
    fnum: f64,
    a: int,
    b: int,
    c: int,
    kids: []int,
    kids2: []int,
    strs: []string,
    // What typecheck sets (C's ast.h fields of the same names).
    /** *The node's type, an index into `types.TYPES`, or -1. */
    ty: int,
    place_mut: int,
    /** *The declaration a name or field resolved to, or `NONE`. */
    res: int,
    /** *Ident: where the definition is (`def_loc`), 0 when unknown. */
    def_line: int,
    def_col: int,
    /** *Fn / Closure: C name. Program: module name. Import: resolved path. */
    /** *Try: the fn's return type name. Call: the resolved callee's C name. */
    sname: string,
    has_sname: bool,
    /** *Call: the C symbol a builtin emits. */
    cbuiltin: string,
    has_cbuiltin: bool,
    /** *`M_*` bits below. */
    marks: int,
    /** *Call: `NumericBuiltin`, signal / future / channel cell ops. */
    numb: int,
    sig: int,
    fut: int,
    ch: int,
    /** *Closure id; Cast conversion mode. */
    clos_id: int,
    conv: int,
    /** *Closure captures: names and types. */
    caps: []string,
    cap_types: []int,
}

/** *The part of a node every pass walks: kind, children, resolution, type. */
/** *Kept to 56 bytes so a walk touches one cache line per node; the rest of */
/** *the node is `NodeInfo` in `INFO`, at the same index (see `add`). */
struct Node {
    kind: int,
    flags: int,
    a: int,
    b: int,
    c: int,
    // What typecheck sets (C's ast.h fields of the same names).
    /** *The node's type, an index into `types.TYPES`, or -1. */
    ty: int,
    /** *The declaration a name or field resolved to, or `NONE`. */
    res: int,
    op: int,
    kids: []int,
}

/** *The rest of a node: location, text, names, and what only some kinds use. */
struct NodeInfo {
    loc: Loc,
    aux: int,
    /** *Whether `name` / `text` / `doc` are present (C's non-NULL). */
    has_name: bool,
    name: string,
    num: i64,
    place_mut: int,
    /** *Ident: where the definition is (`def_loc`), 0 when unknown. */
    def_line: int,
    def_col: int,
    /** *`M_*` bits below. */
    marks: int,
    /** *Index of this node's `NodeExtra` in `EXTRA`; 0 (the shared empty */
    /** *one) when it sets none of those fields. */
    extra: int,
}

/** *The fields only some kinds set (text, docs, C names, call cells, */
/** *captures): stored only for a node that sets one, so the rest pay 4 bytes. */
struct NodeExtra {
    has_text: bool,
    has_doc: bool,
    text: string,
    doc: string,
    fnum: f64,
    kids2: []int,
    strs: []string,
    /** *Fn / Closure: C name. Program: module name. Import: resolved path. */
    /** *Try: the fn's return type name. Call: the resolved callee's C name. */
    sname: string,
    has_sname: bool,
    /** *Call: the C symbol a builtin emits. */
    cbuiltin: string,
    has_cbuiltin: bool,
    /** *Call: `NumericBuiltin`, signal / future / channel cell ops. */
    numb: int,
    sig: int,
    fut: int,
    ch: int,
    /** *Closure id; Cast conversion mode. */
    clos_id: int,
    conv: int,
    /** *Closure captures: names and types. */
    caps: []string,
    cap_types: []int,
}

// `marks` bits: the typecheck booleans of C's ast.h.
const M_PRINTLN: int = 1
const M_BOX_NEW: int = 2
const M_VEC_PUSH: int = 4
const M_VEC_POP: int = 8
const M_SIZEOF: int = 16
const M_PANIC: int = 32
const M_FN_VAL: int = 64
const M_VALUE_KEY: int = 128
const M_INTRINSIC: int = 256
const M_AS_VALUE: int = 512
const M_ZERO_REST: int = 1024
/** *With `M_PRINTLN`: `fmt.eprintln` (C's `is_println == 2`). */
const M_EPRINTLN: int = 2048
/** *On a module `let`: it is in typecheck's `GVARS` (static storage, never */
/** *captured). A mark, so the test is one load, not a scan of every global. */
const M_GLOBAL_VAR: int = 4096

/** *A diagnostic: where, and what. */
struct Diag {
    loc: Loc,
    msg: string,
}

/** *Every node of the session, all modules: the walked part, and the rest at */
/** *the same index. */
let mut NODES: []Node = []Node {}
let mut INFO: []NodeInfo = []NodeInfo {}
/** *`EXTRA[0]` is the empty one every node without extras reads; nothing */
/** *writes it (`ex_mut` gives a node its own first). */
let mut EXTRA: []NodeExtra = []NodeExtra { empty_extra() }
/** *Struct-literal field names, every literal's in one pool: the value */
/** *`NODES[lit].kids[k]` is named `LIT_NAMES[NODES[lit].c + k]`. A literal's */
/** *names are contiguous and no two literals share any (`append_inits` moves */
/** *a literal's names to the end before it appends, `copy_node` gives the */
/** *copy its own). One pool, not a list per literal: a small `[]string` */
/** *starts at 8 slots (200 bytes), more than most literals' fields. */
let mut LIT_NAMES: []string = []string {}
/** *Diagnostics in the order they were reported. */
let mut DIAGS: []Diag = []Diag {}

fn node(kind: int, loc: Loc) -> NodeBuild {
    return NodeBuild {
        kind: kind,
        loc: loc,
        flags: 0,
        op: 0,
        aux: 0,
        has_name: false,
        has_text: false,
        has_doc: false,
        name: "",
        text: "",
        doc: "",
        num: i64(0),
        fnum: 0.0,
        a: NONE,
        b: NONE,
        c: NONE,
        kids: []int {},
        kids2: []int {},
        strs: []string {},
        ty: -1,
        place_mut: 0,
        res: NONE,
        def_line: 0,
        def_col: 0,
        sname: "",
        has_sname: false,
        cbuiltin: "",
        has_cbuiltin: false,
        marks: 0,
        numb: 0,
        sig: 0,
        fut: 0,
        ch: 0,
        clos_id: 0,
        conv: 0,
        caps: []string {},
        cap_types: []int {},
    }
}

fn empty_extra() -> NodeExtra {
    return NodeExtra {
        has_text: false,
        has_doc: false,
        text: "",
        doc: "",
        fnum: 0.0,
        kids2: []int {},
        strs: []string {},
        sname: "",
        has_sname: false,
        cbuiltin: "",
        has_cbuiltin: false,
        numb: 0,
        sig: 0,
        fut: 0,
        ch: 0,
        clos_id: 0,
        conv: 0,
        caps: []string {},
        cap_types: []int {},
    }
}

/** *Store a built node; returns its index. */
fn add(n: NodeBuild) -> int {
    let mut extra = 0
    if n.has_text ||
        n.has_doc ||
        n.text.len > 0 ||
        n.doc.len > 0 ||
        n.fnum != 0.0 ||
        n.kids2.len > 0 ||
        n.strs.len > 0 ||
        n.sname.len > 0 ||
        n.has_sname ||
        n.cbuiltin.len > 0 ||
        n.has_cbuiltin ||
        n.numb != 0 ||
        n.sig != 0 ||
        n.fut != 0 ||
        n.ch != 0 ||
        n.clos_id != 0 ||
        n.conv != 0 ||
        n.caps.len > 0 ||
        n.cap_types.len > 0 {
        push(EXTRA, NodeExtra {
            has_text: n.has_text,
            has_doc: n.has_doc,
            text: n.text,
            doc: n.doc,
            fnum: n.fnum,
            kids2: n.kids2,
            strs: n.strs,
            sname: n.sname,
            has_sname: n.has_sname,
            cbuiltin: n.cbuiltin,
            has_cbuiltin: n.has_cbuiltin,
            numb: n.numb,
            sig: n.sig,
            fut: n.fut,
            ch: n.ch,
            clos_id: n.clos_id,
            conv: n.conv,
            caps: n.caps,
            cap_types: n.cap_types,
        })
        extra = EXTRA.len - 1
    }
    push(NODES, Node {
        kind: n.kind,
        flags: n.flags,
        a: n.a,
        b: n.b,
        c: n.c,
        ty: n.ty,
        res: n.res,
        op: n.op,
        kids: n.kids,
    })
    push(INFO, NodeInfo {
        loc: n.loc,
        aux: n.aux,
        has_name: n.has_name,
        name: n.name,
        num: n.num,
        place_mut: n.place_mut,
        def_line: n.def_line,
        def_col: n.def_col,
        marks: n.marks,
        extra: extra,
    })
    return NODES.len - 1
}

/** *Store a node that sets none of `NodeExtra`'s fields straight into the */
/** *arena. Going through `NodeBuild` costs a retain and a release of its ten */
/** *owning fields per copy (the build, the pass, the drop); this touches only */
/** *what it stores. The other fields are `node`'s defaults. */
fn add_plain(kind: int, loc: Loc, flags: int, op: int, a: int, b: int, kids: []int, name: string, has_name: bool, num: i64) -> int {
    push(NODES, Node { kind: kind, flags: flags, a: a, b: b, c: NONE, ty: -1, res: NONE, op: op, kids: kids })
    push(INFO, NodeInfo {
        loc: loc,
        aux: 0,
        has_name: has_name,
        name: name,
        num: num,
        place_mut: 0,
        def_line: 0,
        def_col: 0,
        marks: 0,
        extra: 0,
    })
    return NODES.len - 1
}

/** *`add_plain` for a node with no children, name or number: an operator, */
/** *up to three child nodes, and `aux`. */
fn add_ops(kind: int, loc: Loc, op: int, a: int, b: int, c: int, aux: int) -> int {
    push(NODES, Node { kind: kind, flags: 0, a: a, b: b, c: c, ty: -1, res: NONE, op: op, kids: []int {} })
    push(INFO, NodeInfo {
        loc: loc,
        aux: aux,
        has_name: false,
        name: "",
        num: i64(0),
        place_mut: 0,
        def_line: 0,
        def_col: 0,
        marks: 0,
        extra: 0,
    })
    return NODES.len - 1
}

/** *Where node `i`'s rare fields are, for reading (the empty one if none). */
fn ex(i: int) -> int {
    return INFO[i].extra
}

/** *Where node `i`'s rare fields are, for writing: its own, made on first use. */
fn ex_mut(i: int) -> int {
    if INFO[i].extra == 0 {
        push(EXTRA, empty_extra())
        INFO[i].extra = EXTRA.len - 1
    }
    return INFO[i].extra
}

/** *A copy of node `i`, whole. */
fn full(i: int) -> NodeBuild {
    let x = INFO[i].extra
    return NodeBuild {
        kind: NODES[i].kind,
        loc: INFO[i].loc,
        flags: NODES[i].flags,
        op: NODES[i].op,
        aux: INFO[i].aux,
        has_name: INFO[i].has_name,
        has_text: EXTRA[x].has_text,
        has_doc: EXTRA[x].has_doc,
        name: INFO[i].name,
        text: EXTRA[x].text,
        doc: EXTRA[x].doc,
        num: INFO[i].num,
        fnum: EXTRA[x].fnum,
        a: NODES[i].a,
        b: NODES[i].b,
        c: NODES[i].c,
        kids: NODES[i].kids,
        kids2: EXTRA[x].kids2,
        strs: EXTRA[x].strs,
        ty: NODES[i].ty,
        place_mut: INFO[i].place_mut,
        res: NODES[i].res,
        def_line: INFO[i].def_line,
        def_col: INFO[i].def_col,
        sname: EXTRA[x].sname,
        has_sname: EXTRA[x].has_sname,
        cbuiltin: EXTRA[x].cbuiltin,
        has_cbuiltin: EXTRA[x].has_cbuiltin,
        marks: INFO[i].marks,
        numb: EXTRA[x].numb,
        sig: EXTRA[x].sig,
        fut: EXTRA[x].fut,
        ch: EXTRA[x].ch,
        clos_id: EXTRA[x].clos_id,
        conv: EXTRA[x].conv,
        caps: EXTRA[x].caps,
        cap_types: EXTRA[x].cap_types,
    }
}

/** *Node `dst` becomes a copy of node `src` (its extras and literal field */
/** *names copied, not shared). */
fn copy_node(dst: int, src: int) {
    NODES[dst] = NODES[src]
    INFO[dst] = INFO[src]
    if INFO[src].extra != 0 {
        push(EXTRA, EXTRA[INFO[src].extra])
        INFO[dst].extra = EXTRA.len - 1
    }
    if NODES[src].kind == Kind.StructLit {
        NODES[dst].c = new_lit_names(lit_names(src))
    }
}

/** *Put a struct literal's field names in the pool; returns what its `c` */
/** *holds. */
fn new_lit_names(names: []string) -> int {
    let start = LIT_NAMES.len
    for k in 0..names.len {
        push(LIT_NAMES, names[k])
    }
    return start
}

/** *The name of struct literal `lit`'s `k`th field. */
fn init_name(lit: int, k: int) -> string {
    return LIT_NAMES[NODES[lit].c + k]
}

/** *A copy of struct literal `lit`'s field names, in order. */
fn lit_names(lit: int) -> []string {
    let mut names = []string {}
    let start = NODES[lit].c
    for k in 0..NODES[lit].kids.len {
        push(names, LIT_NAMES[start + k])
    }
    return names
}

/** *Struct literal `lit` becomes `names[k]: values[k]`. */
fn set_inits(lit: int, names: []string, values: []int) {
    NODES[lit].c = new_lit_names(names)
    NODES[lit].kids = values
}

/** *Append fields `names[k]: values[k]` to struct literal `lit`. Its names */
/** *move to the end of the pool first unless they are there already, so */
/** *append a literal's fields in one call, not one at a time around code */
/** *that makes other literals (each call would move them again). */
fn append_inits(lit: int, names: []string, values: []int) {
    let start = NODES[lit].c
    let count = NODES[lit].kids.len
    if start + count != LIT_NAMES.len {
        // Another literal's names follow these: move these to the end.
        let moved = LIT_NAMES.len
        for k in 0..count {
            push(LIT_NAMES, LIT_NAMES[start + k])
        }
        NODES[lit].c = moved
    }
    for k in 0..names.len {
        push(LIT_NAMES, names[k])
        push(NODES[lit].kids, values[k])
    }
}

/** *Empty the arena and the diagnostics, for a long-lived process (the */
/** *language server) that checks a program again. */
fn reset() {
    NODES = []Node {}
    INFO = []NodeInfo {}
    EXTRA = []NodeExtra { empty_extra() }
    LIT_NAMES = []string {}
    DIAGS = []Diag {}
}
