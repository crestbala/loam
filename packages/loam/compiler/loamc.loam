// loamc — the self-hosted compiler: load, check, emit C, and run the C
// compiler, in one process. The twin of src/driver.c for native host builds.
//
//   loamc [build] [options] file.loam    build <dir>/build/<stem> (or -o PATH)
//   loamc check file.loam                the frontend only
//   loamc --emit-c [-o out.c] file.loam  the C translation unit only
//
// stdout, stderr, exit status and the C written match the seed compiler's
// (`nob integration selfhost_driver`). The C compiler is `CC` (split on
// spaces, so `zig cc` works), else the first of `cc`, `clang`, `gcc` on
// `PATH`. It runs through `sys.spawn` with an argument list, never a shell.
// Runtime objects (the Zeus platform layer, its hosts, `#![c_source]` files)
// compile once into `<runtime>/.obj/` and are rebuilt when a source is newer.
//
// Not here yet (the seed has them; each is refused by name, never ignored):
// iOS and Android targets and `--dump-*`.
//
// `LOAM_BATCH` builds a program of many fixtures that runs the one `LOAM_CASE`
// names; `LOAM_SHARD=<dir>` compiles a Zeus program as cached units in
// parallel (see "shard builds"); `LOAM_HOST` builds a `zeli serve` host;
// `LOAM_SERVER_SPLIT` gives `#[server]` fns trap bodies, as a client build does.
//
// A native build with `-o` records what it read in `<output>.fresh`, and the
// same command run again reuses the output while nothing in it changed (see
// "build cache" below; `LOAM_NO_FRESH=1` turns it off).

import "std:async"
import "std:buf"
import "std:conv"
import "std:map"
import "std:fmt"
import "std:result"
import "std:str"
import "std:sys"
import "ast.loam"
import "types.loam"
import "typecheck.loam"
import "threadcheck.loam"
import "borrowck.loam"
import "boundscheck.loam"
import "dce.loam"
import "codegen.loam"
import "loader.loam"
import "dump.loam"
import "ir.loam"
import "irprint.loam"

// --- environment -------------------------------------------------------------------

/** *Set, non-empty, and not `"0"`. */
fn env_on(name: string) -> bool {
    let v = sys.env(name)
    return v.len > 0 && v != "0"
}

fn want_headless() -> bool {
    return env_on("ZEUS_HEADLESS") || env_on("LOAM_HEADLESS")
}

/** *A development GUI build (`zeli serve`): no optimizer, no dead-strip. */
fn want_dev() -> bool {
    return env_on("LOAM_DEV")
}

fn on_mac() -> bool {
    return sys.os() == "macos"
}

fn zeus_dir() -> string {
    return "{{loader.home()}}/packages/zeus"
}

fn raygui_dir() -> string {
    return "{{loader.home()}}/packages/raygui"
}

/** *Refuse a mode only the seed compiler has. */
fn not_here(what: string) {
    fmt.eprintln("loam: {{what}} is not in the self-hosted compiler yet; build with the seed loamc")
    sys.exit(1)
}

/** *Seconds as `%.3f`, from milliseconds. */
fn secs(ms: i64) -> string {
    let frac = ms % i64(1000)
    let pad = if frac < i64(10) { "00" } else if frac < i64(100) { "0" } else { "" }
    return "{{ms / i64(1000)}}.{{pad}}{{frac}}"
}

/** *`LOAM_PROGRESS=<file>`: one line per build step appended to that file, */
/** *for a tool drawing progress while this runs. */
fn progress(line: string) {
    let path = sys.env("LOAM_PROGRESS")
    if path.len == 0 {
        return
    }
    let r = sys.read(path)
    let old = if r.tag == ResultTag.Ok { r.val } else { "" }
    sys.write_file(path, "{{old}}{{line}}\n")
}

// --- paths -------------------------------------------------------------------------

/** *64-bit FNV-1a of `s`, continuing from `h`. */
fn fnv(s: string, h: u64) -> u64 {
    let prime: u64 = 1099511628211
    let mut x = h
    for i in 0..s.len {
        x = wrapping_mul(x ^ u64(s[i]), prime)
    }
    return x
}

const FNV_BASIS: u64 = 14695981039346656037

/** *`h` as 16 hex digits. */
fn hex16(h: u64) -> string {
    let s = conv.u64_to_radix(h, 16)
    let mut pad = ""
    for i in s.len..16 {
        pad = "{{pad}}0"
    }
    return "{{pad}}{{s}}"
}

/** *Where the temporary C goes: `TMPDIR` or `/tmp`; on Windows `TEMP` or */
/** *`TMP` (an MSYS-style `/tmp` means nothing to a native program), else */
/** *the current directory. */
fn tmp_dir() -> string {
    let mut d = ""
    if sys.os() == "windows" {
        let names = []string { "TEMP", "TMP" }
        for i in 0..names.len {
            let v = sys.env(names[i])
            if d.len == 0 && sys.is_abs(v) && v[0] != '/' {
                d = v
            }
        }
        if d.len == 0 {
            d = "."
        }
    } else {
        d = sys.env("TMPDIR")
        if d.len == 0 {
            d = "/tmp"
        }
    }
    while d.len > 1 && d[d.len - 1] == '/' {
        d = str.slice(d, 0, d.len - 1)
    }
    return d
}

fn absolute(p: string) -> string {
    return if sys.is_abs(p) { p } else { "{{sys.cwd()}}/{{p}}" }
}

/** *`mkdir -p` of the directory holding `file`. `true` on success. */
fn ensure_parent_dir(file: string) -> bool {
    let d = loader.parent_dir(file)
    return d == "." || sys.is_dir(d) == 1 || sys.mkdir(d) == 0
}

/** *The built program to start: `./name` when it has no directory, and on */
/** *Windows with the `.exe` the C compiler added. */
fn runnable(path: string) -> string {
    let mut p = path
    if sys.os() == "windows" && !str.ends_with(p, ".exe") && sys.exists("{{p}}.exe") == 1 {
        p = "{{p}}.exe"
    }
    if sys.is_abs(p) || str.starts_with(p, "./") {
        return p
    }
    return "./{{p}}"
}

// --- the C compiler ----------------------------------------------------------------

let mut CC: []string = []string {}

/** *An executable named `name` on `PATH`. */
fn on_path(name: string) -> bool {
    let sep = if sys.os() == "windows" { ";" } else { ":" }
    let dirs = str.split(sys.env("PATH"), sep)
    for i in 0..dirs.len {
        if dirs[i].len == 0 {
            continue
        }
        if sys.exists("{{dirs[i]}}/{{name}}") == 1 || sys.exists("{{dirs[i]}}/{{name}}.exe") == 1 {
            return true
        }
    }
    return false
}

/** *The words of `s`, split on spaces and tabs. */
fn words(s: string) -> []string {
    let mut out = []string {}
    let mut start = 0
    for i in 0..s.len + 1 {
        if i == s.len || s[i] == ' ' || s[i] == '\t' {
            if i > start {
                push(out, str.slice(s, start, i))
            }
            start = i + 1
        }
    }
    return out
}

/** *The C compiler's command words: `CC`, else `cc`, `clang`, `gcc`. */
fn cc() -> []string {
    if CC.len == 0 {
        CC = words(sys.env("CC"))
        if CC.len == 0 {
            let names = []string { "cc", "clang", "gcc" }
            for i in 0..names.len {
                if on_path(names[i]) {
                    push(CC, names[i])
                    break
                }
            }
            if CC.len == 0 {
                push(CC, "cc")
            }
        }
    }
    return CC
}

/** *`cc()` then `args`, without the empty ones. */
fn cc_argv(args: &[]string) -> []string {
    let mut argv = cc()
    for i in 0..args.len {
        if args[i].len > 0 {
            push(argv, args[i])
        }
    }
    return argv
}

/** *Run the C compiler on `args`. `true` when it exits 0. */
fn run_cc(args: &[]string) -> bool {
    let argv = cc_argv(args)
    return sys.run(&argv) == 0
}

fn push_all(to: &mut []string, from: &[]string) {
    for i in 0..from.len {
        push(to, from[i])
    }
}

/** *`push_all` of a list written in place. */
fn push_list(to: &mut []string, from: []string) {
    push_all(to, &from)
}

// --- runtime objects ---------------------------------------------------------------

/** *A name for this build's temporary files that a concurrent build of */
/** *another output does not share. */
let mut BUILD_TAG: string = ""

/** *`src` or `dst` is missing, or `src` is not older than `dst` (to the */
/** *millisecond, or the second where the file system has no finer time). An */
/** *edit in the same tick as the object's build counts as newer, so it is never */
/** *missed; the cost is at most one extra compile. */
fn src_newer(src: string, dst: string) -> bool {
    let d = sys.mtime(dst)
    let s = sys.mtime(src)
    return d < i64(0) || s < i64(0) || s >= d
}

/** *Compile `src` to `obj` (with `extra` flags) when the object is missing or */
/** *a dependency is newer. The object is written beside its name and renamed */
/** *into place, so a concurrent build sees the old one or the new one. */
fn ensure_obj(src: string, obj: string, extra: &[]string, deps: &[]string) -> bool {
    if sys.exists(obj) == 1 {
        let mut stale = false
        for i in 0..deps.len {
            if src_newer(deps[i], obj) {
                stale = true
                break
            }
        }
        if !stale {
            return true
        }
    }
    if !ensure_parent_dir(obj) {
        return false
    }
    let tmp = "{{obj}}.{{BUILD_TAG}}.tmp"
    let mut args = []string { "-std=gnu99", "-O1", "-I{{loader.runtime_dir()}}" }
    push_all(&mut args, extra)
    push(args, src)
    push(args, "-c")
    push(args, "-o")
    push(args, tmp)
    if env_on("LOAM_TIME") {
        fmt.eprintln("loam: cc {{src}}")
    }
    if !run_cc(&args) || sys.rename(tmp, obj) != 0 {
        sys.remove_path(tmp)
        return false
    }
    return true
}

// --- build cache (`<output>.fresh`) ------------------------------------------------
//
// The stamp file holds a key line, the output's stamp, and one line per file the
// build read: every module, and every C source, header beside it, and
// `LOAM_LINK_EXTRA` file that went into the link.
//
//   K <key>
//   O <sec> <nsec> <size> <output>
//   F <sec> <nsec> <size> <path>
//
// The key hashes the command line, the environment that changes a build, the
// compiler binary, and the runtime and host directories. A run with the same
// key whose output and files all still have their stamps is fresh.

/** *Files besides the modules that this build read: C sources and headers */
/** *(`c_source_obj`) and `LOAM_LINK_EXTRA` inputs. */
let mut FRESH_DEPS: []string = []string {}

/** *`LOAM_NO_FRESH=1`: build every time. */
fn fresh_off() -> bool {
    return env_on("LOAM_NO_FRESH")
}

/** *This compiler's own file: `argv[0]` when it names a path, else the first */
/** *match on `PATH` (a compiler run as `loamc` is still keyed by its binary). */
fn self_path() -> string {
    let a0 = sys.arg(0)
    if str.index_of_byte(a0, '/') >= 0 ||
        (sys.os() == "windows" && str.index_of_byte(a0, '\\') >= 0) {
        return a0
    }
    let sep = if sys.os() == "windows" { ";" } else { ":" }
    let dirs = str.split(sys.env("PATH"), sep)
    for i in 0..dirs.len {
        if dirs[i].len == 0 {
            continue
        }
        let cand = "{{dirs[i]}}/{{a0}}"
        if sys.stamp(cand).len > 0 {
            return cand
        }
        if sys.os() == "windows" && sys.stamp("{{cand}}.exe").len > 0 {
            return "{{cand}}.exe"
        }
    }
    return a0
}

/** *Fold the regular files directly in `dir` (name and stamp) into `h`, */
/** *independent of listing order. */
fn dir_fingerprint(dir: string, h: u64) -> u64 {
    let x = fnv(dir, h)
    if sys.is_dir(dir) != 1 {
        return fnv("0", x)
    }
    let names = sys.list_dir(dir)
    let mut sum: u64 = 0
    for i in 0..names.len {
        let st = sys.stamp("{{dir}}/{{names[i]}}")
        if st.len > 0 {
            sum = wrapping_add(sum, fnv(st, fnv(names[i], FNV_BASIS)))
        }
    }
    return fnv(hex16(sum), x)
}

/** *Everything outside the modules that decides what a build of `in_path` */
/** *produces, as 16 hex digits. */
fn fresh_key(in_path: string) -> string {
    let mut h = fnv("loam-fresh-1", FNV_BASIS)
    for i in 1..sys.argc() {
        h = fnv(sys.arg(i), fnv("\n", h))
    }
    let envs = []string {
        "ZEUS_HEADLESS", "LOAM_HEADLESS", "MAYA_HEADLESS", "LOAM_DEV", "LOAM_DEBUG",
        "ZEUS_MEM_STATS", "LOAM_LINK_EXTRA", "CC", "RAYLIB_PREFIX",
        "LOAM_BATCH", "LOAM_SHARD", "LOAM_HOST", "LOAM_SERVER_SPLIT", "LOAM_WASM_CC", "LOAM_NO_DCE",
    }
    for i in 0..envs.len {
        h = fnv(sys.env(envs[i]), fnv("\n", fnv(envs[i], fnv("\n", h))))
    }
    h = fnv(sys.stamp(self_path()), fnv("\n", h))
    let rt = loader.runtime_dir()
    h = dir_fingerprint(rt, h)
    h = dir_fingerprint("{{rt}}/wasm_inc", h)
    h = dir_fingerprint("{{zeus_dir()}}/hosts/web", h)
    h = dir_fingerprint("{{zeus_dir()}}/hosts/desktop", h)
    h = dir_fingerprint("{{zeus_dir()}}/hosts/apple", h)
    h = dir_fingerprint("{{loader.parent_dir(in_path)}}/runtime", h)
    return hex16(h)
}

/** *`out` was built from these exact inputs: its stamp file has `key`, and */
/** *the output and every file it lists still have the stamps recorded. */
fn fresh_match(out: string, key: string) -> bool {
    let body = sys.read_file("{{out}}.fresh")
    let rows = str.lines(body)
    if rows.len < 3 || rows[0] != "K {{key}}" {
        return false
    }
    let mut saw_out = false
    let mut saw_file = false
    for r in 1..rows.len {
        let row = rows[r]
        if row.len == 0 {
            continue
        }
        if row.len < 3 || (row[0] != 'O' && row[0] != 'F') || row[1] != ' ' {
            return false
        }
        // The stamp is three numbers; the path is the rest (it may hold spaces).
        let s1 = str.index_from(row, " ", 2)
        let s2 = if s1 >= 0 { str.index_from(row, " ", s1 + 1) } else { -1 }
        let s3 = if s2 >= 0 { str.index_from(row, " ", s2 + 1) } else { -1 }
        if s3 < 0 {
            return false
        }
        let recorded = str.slice(row, 2, s3)
        let path = if row[0] == 'O' { out } else { str.slice_from(row, s3 + 1) }
        if path.len == 0 || sys.stamp(path) != recorded {
            return false
        }
        if row[0] == 'O' {
            saw_out = true
        } else {
            saw_file = true
        }
    }
    return saw_out && saw_file
}

/** *Record what built `out`. Written beside its name and renamed into place; */
/** *any file that cannot be stamped leaves no stamp (the next run rebuilds). */
fn fresh_save(out: string, key: string) {
    let stamp = "{{out}}.fresh"
    let own = sys.stamp(out)
    if own.len == 0 {
        return
    }
    let mut b = []u8 {}
    buf.push_str(&mut b, "K {{key}}\nO {{own}} {{out}}\n")
    for i in 0..typecheck.MODS.len {
        let p = typecheck.MODS[i].path
        let st = if p.len > 0 { sys.stamp(p) } else { "" }
        if st.len == 0 {
            return
        }
        buf.push_str(&mut b, "F {{st}} {{p}}\n")
    }
    for i in 0..FRESH_DEPS.len {
        let st = sys.stamp(FRESH_DEPS[i])
        if st.len == 0 {
            return
        }
        buf.push_str(&mut b, "F {{st}} {{FRESH_DEPS[i]}}\n")
    }
    let tmp = "{{stamp}}.{{BUILD_TAG}}.tmp"
    if sys.write_bytes(tmp, &b) != 0 || sys.rename(tmp, stamp) != 0 {
        sys.remove_path(tmp)
    }
}

// --- C sources (`#![c_source]`, `#![c_link]`) ---------------------------------------

/** *Module `m` still has a `#[c]` fn after dead code removal. */
fn module_uses_c(m: int) -> bool {
    let root = typecheck.MODS[m].root
    if root == ast.NONE {
        return false
    }
    let decls = ast.NODES[root].kids
    for i in 0..decls.len {
        let d = decls[i]
        if ast.NODES[d].kind == Kind.Fn && codegen.c_sym_of(d).len > 0 && dce.keep(d) {
            return true
        }
    }
    return false
}

/** *`arg` quoted for the shell, as the seed keys objects by it. */
fn shell_quoted(arg: string) -> string {
    let mut b = []u8 {}
    buf.push_str(&mut b, " '")
    for i in 0..arg.len {
        if arg[i] == '\'' {
            buf.push_str(&mut b, "'\\''")
        } else {
            push(b, u8(arg[i]))
        }
    }
    push(b, u8('\''))
    return buf.to_string(&b)
}

/** *Relative, inside its directory, and nothing a shell would read. */
fn c_source_path_ok(p: string) -> bool {
    if p.len == 0 || p[0] == '/' || str.contains(p, "..") {
        return false
    }
    for i in 0..p.len {
        let c = p[i]
        let ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') ||
            c == '.' || c == '_' || c == '/' || c == '+' || c == '-'
        if !ok {
            return false
        }
    }
    return true
}

fn cdir_error(path: string, loc_line: int, msg: string) -> bool {
    fmt.eprintln("{{path}}:{{loc_line}}: error: {{msg}}")
    return false
}

/** *Compile one `#![c_source]` if stale and add its object to `link`. The */
/** *headers beside it are dependencies; the object's name hashes the path */
/** *and flags, so two flag sets never share an object. */
fn c_source_obj(loam_path: string, d: int, link: &mut []string) -> bool {
    let args = ast.EXTRA[ast.ex(d)].strs
    let line = ast.INFO[d].loc.line
    let slash = str.last_index_of_byte(loam_path, '/')
    let srcdir = if slash >= 0 { str.slice(loam_path, 0, slash) } else { "." }
    let src = "{{srcdir}}/{{args[0]}}"
    if !c_source_path_ok(args[0]) {
        return cdir_error(loam_path, line, "#![c_source] path '{{args[0]}}' must be relative and stay inside this directory")
    }
    if sys.exists(src) != 1 || sys.is_dir(src) == 1 {
        return cdir_error(loam_path, line, "cannot read C source '{{src}}'")
    }
    let cut = str.last_index_of_byte(src, '/')
    let include = str.slice(src, 0, cut)
    let base = str.slice_from(src, cut + 1)
    let mut flags = ""
    let mut extra = []string { "-I{{include}}" }
    for k in 1..args.len {
        flags = "{{flags}}{{shell_quoted(args[k])}}"
        push(extra, args[k])
    }
    let key = fnv(src, fnv(flags, FNV_BASIS))
    let dot = str.index_of_byte(base, '.')
    let stem = if dot >= 0 { str.slice(base, 0, dot) } else { base }
    let obj = "{{loader.runtime_dir()}}/.obj/c_{{stem}}_{{hex16(key)}}.o"
    let mut deps = []string { src }
    let names = sys.list_dir(include)
    for i in 0..names.len {
        if names[i].len >= 3 && str.ends_with(names[i], ".h") && deps.len < 64 {
            push(deps, "{{include}}/{{names[i]}}")
        }
    }
    if !ensure_obj(src, obj, &extra, &deps) {
        return cdir_error(loam_path, line, "failed to compile C source '{{src}}'")
    }
    push_all(&mut FRESH_DEPS, &deps)
    push(link, obj)
    return true
}

/** *The objects and flags the modules that use C add to the native link: */
/** *every module's sources first, then every module's link flags. */
fn c_inputs(link: &mut []string) -> bool {
    let mut any = false
    for pass in 0..2 {
        for m in 0..typecheck.MODS.len {
            let root = typecheck.MODS[m].root
            if root == ast.NONE || !module_uses_c(m) {
                continue
            }
            let kids = ast.NODES[root].kids
            for i in 0..kids.len {
                let d = kids[i]
                if ast.NODES[d].kind != Kind.CDir || ast.NODES[d].op != pass {
                    continue
                }
                if !any {
                    // The link line may still be reading its inputs as `-x c`.
                    push(link, "-x")
                    push(link, "none")
                    any = true
                }
                if pass == 0 {
                    if !c_source_obj(typecheck.MODS[m].path, d, link) {
                        return false
                    }
                    continue
                }
                let args = ast.EXTRA[ast.ex(d)].strs
                push_all(link, &args)
            }
        }
    }
    return true
}

// --- hosts -------------------------------------------------------------------------

fn mods_use(name: string) -> bool {
    for i in 0..typecheck.MODS.len {
        if typecheck.MODS[i].name == name {
            return true
        }
    }
    return false
}

/** *raylib's compile and link flags: `RAYLIB_PREFIX`, then pkg-config, then */
/** *the Homebrew prefixes. Empty when raylib is missing (the link then fails */
/** *with the C compiler's own message). */
/** *Links the Zeus platform layer: a Zeus program, or a `zeli serve` host */
/** *(`LOAM_HOST`), whose own source is a shim but whose loaded images call */
/** *into that layer. */
fn uses_zeus() -> bool {
    return mods_use("zeus") || env_on("LOAM_HOST")
}

fn raylib_flags() -> []string {
    let p = sys.env("RAYLIB_PREFIX")
    if p.len > 0 {
        return []string { "-I{{p}}/include", "-L{{p}}/lib", "-lraylib" }
    }
    let out = sys.exec("pkg-config --cflags --libs raylib 2>/dev/null")
    if sys.exec_status() == 0 && out.len > 0 {
        return words(str.trim(out))
    }
    let prefixes = []string { "/opt/homebrew/opt/raylib", "/usr/local/opt/raylib" }
    for i in 0..prefixes.len {
        if sys.exists("{{prefixes[i]}}/include/raylib.h") == 1 {
            return []string { "-I{{prefixes[i]}}/include", "-L{{prefixes[i]}}/lib", "-lraylib" }
        }
    }
    return []string {}
}

/** *The Zeus platform layer and key state, and on a GUI build the desktop */
/** *host, compiled if stale; their objects, or an empty list on failure */
/** *(`ok` false). */
fn zeus_objects(headless: bool, ok: &mut bool) -> []string {
    let rt = loader.runtime_dir()
    let zd = zeus_dir()
    let mem = env_on("ZEUS_MEM_STATS")
    // A host build (`LOAM_HOST`) compiles the platform layer and the desktop
    // host against the loaded image's dispatch table (`LOAM_HOST_BUILD`), into
    // objects of their own, so the next app build does not link them.
    let host = env_on("LOAM_HOST")
    let host_tag = if host { ".host" } else { "" }
    let mem_tag = if mem { ".mem" } else { "" }
    let tag = "{{host_tag}}{{mem_tag}}"
    let mut host_flags = []string {}
    if host {
        push(host_flags, "-DLOAM_HOST_BUILD")
    }
    push(host_flags, "-DLOAM_ALLOC_TRACE")
    if mem {
        push(host_flags, "-DZEUS_MEM_STATS")
    }
    let rt_h = "{{rt}}/zeus_rt.h"
    let key_h = "{{rt}}/zeus_key.h"
    let plat_c = "{{rt}}/zeus_plat.c"
    let key_c = "{{rt}}/zeus_key.c"
    let plat_o = "{{rt}}/.obj/zeus_plat{{tag}}.o"
    let key_o = "{{rt}}/.obj/zeus_key{{tag}}.o"
    let plat_deps = []string { plat_c, rt_h, key_h }
    let key_deps = []string { key_c, key_h }
    if !ensure_obj(plat_c, plat_o, &host_flags, &plat_deps) || !ensure_obj(key_c, key_o, &host_flags, &key_deps) {
        fmt.eprintln("loam: failed to compile zeus runtime")
        *ok = false
        return []string {}
    }
    let mut objs = []string { plat_o, key_o }
    if headless {
        return objs
    }
    if on_mac() {
        // The Cocoa host is mac.m and the two files it shares with iOS.
        let apple_h = "{{zd}}/hosts/apple/zeus_apple.h"
        let mac_m = "{{zd}}/hosts/desktop/mac.m"
        let draw_m = "{{zd}}/hosts/apple/apple_draw.m"
        let media_m = "{{zd}}/hosts/apple/apple_media.m"
        let mac_o = "{{rt}}/.obj/zeus_mac{{tag}}.o"
        let draw_o = "{{rt}}/.obj/zeus_apple_draw{{tag}}.o"
        let media_o = "{{rt}}/.obj/zeus_apple_media{{tag}}.o"
        let mut mac_flags = []string { "-x", "objective-c" }
        if host {
            push(mac_flags, "-DLOAM_HOST_BUILD")
        }
        push(mac_flags, "-I{{zd}}/hosts/apple")
        let mac_deps = []string { mac_m, rt_h, key_h, apple_h }
        let draw_deps = []string { draw_m, rt_h, apple_h }
        let media_deps = []string { media_m, rt_h, apple_h }
        if !ensure_obj(mac_m, mac_o, &mac_flags, &mac_deps) ||
            !ensure_obj(draw_m, draw_o, &mac_flags, &draw_deps) ||
            !ensure_obj(media_m, media_o, &mac_flags, &media_deps) {
            fmt.eprintln("loam: failed to compile the Cocoa host")
            *ok = false
            return []string {}
        }
        push(objs, mac_o)
        push(objs, draw_o)
        push(objs, media_o)
        return objs
    }
    let linux_c = "{{zd}}/hosts/desktop/linux.c"
    let linux_o = "{{rt}}/.obj/zeus_linux{{tag}}.o"
    let linux_deps = []string { linux_c, rt_h, key_h }
    if !ensure_obj(linux_c, linux_o, &host_flags, &linux_deps) {
        fmt.eprintln("loam: failed to compile {{linux_c}} (need libx11)")
        *ok = false
        return []string {}
    }
    push(objs, linux_o)
    return objs
}

/** *The Cocoa frameworks a Zeus GUI build links. */
fn cocoa_frameworks() -> []string {
    let mut out = []string {}
    let fws = []string {
        "Cocoa", "QuartzCore", "IOSurface", "Security", "CoreText", "ImageIO",
        "AVFoundation", "CoreMedia", "CoreVideo", "VideoToolbox", "AudioToolbox",
    }
    for i in 0..fws.len {
        push(out, "-framework")
        push(out, fws[i])
    }
    push(out, "-weak_framework")
    push(out, "SoundAnalysis")
    push(out, "-framework")
    push(out, "CoreFoundation")
    push(out, "-lm")
    return out
}

/** *What the C compiler gets for a host build: the optimizer and string */
/** *flags, then output and inputs. `false` when a host object failed. */
fn link_args(cpath: string, binpath: string, copt: &[]string, ld: string, extra_link: &[]string, app_in: &[]string, args: &mut []string) -> bool {
    let rt = loader.runtime_dir()
    let owns = []string { if types.string_owns { "-DLOAM_STRING_OWNS" } else { "" } }
    let net_c = "{{rt}}/net.c"
    push_all(args, copt)
    if uses_zeus() {
        let headless = want_headless()
        let mut ok = true
        let objs = zeus_objects(headless, &mut ok)
        if !ok {
            return false
        }
        if on_mac() && !headless {
            push(args, ld)
        }
        push_list(args, []string { "-o", binpath, "-I{{rt}}" })
        push_all(args, app_in)
        push_list(args, []string { "-x", "none" })
        push_all(args, &objs)
        if mods_use("http") || mods_use("net") {
            push(args, net_c)
        }
        push_all(args, extra_link)
        if on_mac() && !headless {
            let fws = cocoa_frameworks()
            push_all(args, &fws)
        } else if on_mac() {
            push_list(args, []string { "-framework", "Security", "-framework", "CoreFoundation", "-lm" })
        } else if !headless {
            push_list(args, []string { "-lX11", "-lm" })
        } else {
            push(args, "-lm")
        }
        return true
    }
    if mods_use("maya") {
        let src_c = "{{rt}}/maya_plat.c"
        let src_h = "{{rt}}/maya_rt.h"
        let otag = if types.string_owns { ".owns" } else { "" }
        let obj_c = "{{rt}}/.obj/maya_plat{{otag}}.o"
        let deps = []string { src_c, src_h }
        let mut ok = ensure_obj(src_c, obj_c, &owns, &deps)
        let mut objs = []string { obj_c }
        if on_mac() && ok {
            let src_m = "{{rt}}/maya_mac.m"
            let obj_m = "{{rt}}/.obj/maya_mac{{otag}}.o"
            let mac_flags = []string { "-x", "objective-c", "-fobjc-arc", owns[0] }
            let mac_deps = []string { src_m, src_h }
            ok = ensure_obj(src_m, obj_m, &mac_flags, &mac_deps)
            push(objs, obj_m)
        }
        if !ok {
            fmt.eprintln("loam: failed to compile the maya host")
            return false
        }
        push_list(args, []string { ld, "-o", binpath, "-I{{rt}}", "-x", "c", cpath, "-x", "none" })
        push_all(args, &objs)
        if on_mac() {
            push_list(args, []string { "-framework", "Cocoa" })
        }
        push(args, "-lm")
        push_all(args, extra_link)
        return true
    }
    if mods_use("http") || mods_use("net") {
        push_list(args, []string { ld, "-o", binpath, "-I{{rt}}", "-x", "c", cpath, net_c })
        if on_mac() {
            push_list(args, []string { "-framework", "Security", "-framework", "CoreFoundation" })
        }
        push_all(args, extra_link)
        return true
    }
    if mods_use("raygui") {
        let rlib = raylib_flags()
        let src_c = "{{rt}}/raygui_plat.c"
        let src_h = "{{rt}}/raygui_rt.h"
        let otag = if types.string_owns { ".owns" } else { "" }
        let obj_c = "{{rt}}/.obj/raygui_plat{{otag}}.o"
        let mut flags = []string { "-I{{raygui_dir()}}/vendor" }
        push_all(&mut flags, &rlib)
        push(flags, owns[0])
        let deps = []string { src_c, src_h }
        if !ensure_obj(src_c, obj_c, &flags, &deps) {
            fmt.eprintln("loam: failed to compile the raygui host")
            return false
        }
        push_list(args, []string { ld, "-o", binpath, "-I{{rt}}", "-I{{raygui_dir()}}/vendor" })
        push_all(args, &rlib)
        push_list(args, []string { "-x", "c", cpath, "-x", "none", obj_c, "-lm" })
        push_all(args, extra_link)
        return true
    }
    push_list(args, []string { ld, "-x", "c", cpath, "-o", binpath })
    push_all(args, extra_link)
    return true
}

/** *The optimizer and define flags every build of the program shares. */
fn copt_flags() -> []string {
    let mut f = []string { "-std=gnu99" }
    if want_headless() || want_dev() {
        push_list(&mut f, []string { "-O0", "-fno-asynchronous-unwind-tables", "-ffp-contract=off" })
        // clang's arm64 -O0 picks instructions with GlobalISel, a third slower
        // than FastISel for nothing an unoptimized build wants.
        if on_mac() && sys.arch() == "aarch64" {
            push_list(&mut f, []string { "-mllvm", "-global-isel=false" })
        }
    } else {
        push_list(&mut f, []string { "-O1", "-fno-asynchronous-unwind-tables", "-fomit-frame-pointer", "-ffp-contract=off" })
    }
    if env_on("LOAM_DEBUG") {
        push(f, "-g")
    }
    if uses_zeus() {
        push(f, "-DLOAM_ALLOC_TRACE")
    }
    if env_on("ZEUS_MEM_STATS") {
        push(f, "-DZEUS_MEM_STATS")
    }
    if types.string_owns {
        push(f, "-DLOAM_STRING_OWNS")
    }
    return f
}

// --- shard builds ------------------------------------------------------------------
//
// A development build has one job, which is to be fast the second time. The
// generated program is one large C file, so one compiler on one core, and the
// same work again after an edit that changed two lines of it. `LOAM_SHARD=<dir>`
// cuts it along the markers codegen left (`codegen.SHARD`) into units that
// compile in parallel and are kept in <dir> under a hash of their text, so an
// edit compiles only what it changed. The shared header goes through a
// precompiled header, which keeps each unit's cost close to its own code.
//
// When the link list is written, every file in <dir> this compile did not use
// is removed, so a unit whose text changed leaves no old object behind. One
// directory is one compile at a time.
//
// Units are cut where a fn's name hashes a certain way, not every N bytes: a
// fixed size would move every later boundary when one fn grows, and every unit
// after the edit would miss.

const SHARD_MIN: int = 96000
const SHARD_MAX: int = 384000
const SHARD_CUT: u64 = 8

/** *One unit still to compile: its source, its object, and the command */
/** *(compiler first). */
struct ShardJob {
    cfile: string,
    obj: string,
    args: []string,
}

/** *Every object of the shard build, and the compiles still needed. */
let mut SHARD_OBJS: []string = []string {}
let mut SHARD_JOBS: []ShardJob = []ShardJob {}
/** *`app_input` left only a link to do. */
let mut SHARD_LINKED: bool = false

/** *Add one unit whose text is `text`. Its object is reused if `key` was */
/** *built before; otherwise the text is written out and a compile queued. */
/** *`cc_args` is the compile command up to its input, compiler first. */
fn shard_unit(cc_args: &[]string, dir: string, key: u64, text: string) -> bool {
    let obj = "{{dir}}/{{hex16(key)}}.o"
    push(SHARD_OBJS, obj)
    if sys.exists(obj) == 1 {
        return true
    }
    let cfile = "{{dir}}/{{hex16(key)}}.c"
    if sys.write_file(cfile, text) != 0 {
        return false
    }
    let mut args = []string {}
    push_all(&mut args, cc_args)
    push_list(&mut args, []string { "-x", "c", cfile, "-c", "-o", "{{obj}}.{{BUILD_TAG}}.tmp" })
    push(SHARD_JOBS, ShardJob { cfile: cfile, obj: obj, args: args })
    return true
}

/** *Finish one compile: its object renamed into place (a unit that exists */
/** *is whole), its source removed. */
fn shard_done(job: &ShardJob, status: int) -> bool {
    let tmp = "{{job.obj}}.{{BUILD_TAG}}.tmp"
    let ok = status == 0 && sys.rename(tmp, job.obj) == 0
    if !ok {
        sys.remove_path(tmp)
    }
    sys.remove_path(job.cfile)
    return ok
}

/** *Run the queued compiles, one per core at a time. `true` if all passed. */
fn shard_run_jobs() -> bool {
    let total = SHARD_OBJS.len
    let cores = sys.cpu_count()
    let mut done = total - SHARD_JOBS.len
    let mut ok = true
    let mut running = []int {}
    let mut running_jobs = []int {}
    progress("units {{done}} {{total}}")
    let mut next = 0
    while next < SHARD_JOBS.len || running.len > 0 {
        if next < SHARD_JOBS.len && running.len < cores {
            let h = sys.spawn(&SHARD_JOBS[next].args)
            if h < 0 {
                shard_done(&SHARD_JOBS[next], 1)
                ok = false
            } else {
                push(running, h)
                push(running_jobs, next)
            }
            next += 1
            continue
        }
        // Wait for the oldest; the others keep running meanwhile.
        let status = sys.wait(running[0])
        if !shard_done(&SHARD_JOBS[running_jobs[0]], status) {
            ok = false
        }
        let mut rest = []int {}
        let mut rest_jobs = []int {}
        for i in 1..running.len {
            push(rest, running[i])
            push(rest_jobs, running_jobs[i])
        }
        running = rest
        running_jobs = rest_jobs
        done += 1
        progress("units {{done}} {{total}}")
    }
    return ok
}

/** *The file name after the last `/`. */
fn base_name(p: string) -> string {
    let slash = str.last_index_of_byte(p, '/')
    return if slash < 0 { p } else { str.slice_from(p, slash + 1) }
}

/** *Drop every file in `dir` this compile did not just link. The header stays */
/** *though its mtime is never refreshed: the compiler checks that file */
/** *against the precompiled header. */
fn shard_prune(dir: string, hpath: string, rsp: string) {
    let mut keep: Map<int> = map_new(0)
    map_put(&mut keep, base_name(hpath), 1)
    map_put(&mut keep, "{{base_name(hpath)}}.pch", 1)
    map_put(&mut keep, base_name(rsp), 1)
    for i in 0..SHARD_OBJS.len {
        map_put(&mut keep, base_name(SHARD_OBJS[i]), 1)
    }
    let names = sys.list_dir(dir)
    for i in 0..names.len {
        if map_has(&mut keep, names[i]) {
            continue
        }
        let path = "{{dir}}/{{names[i]}}"
        if sys.is_dir(path) == 0 {
            sys.remove_path(path)
        }
    }
}

/** *Compile `cpath` as units under `dir`, and leave the object list in */
/** *`<dir>/<key>.rsp` for the link to read as `@rsp`. The path of that list, */
/** *or `""` on failure (the caller still has the whole program in `cpath`). */
fn shard_compile(cpath: string, cc_args: &[]string, dir: string, extra: &[]string) -> string {
    SHARD_OBJS = []string {}
    SHARD_JOBS = []ShardJob {}
    let r = sys.read(cpath)
    if r.tag != ResultTag.Ok {
        return ""
    }
    let src = r.val
    let first = str.index_of(src, "\n/*@S ")
    let defs = str.index_of(src, "\n/*@D*/\n")
    if first < 0 || defs < 0 || sys.mkdir(dir) != 0 {
        return ""
    }
    let head = str.slice(src, 0, first)
    let rt = loader.runtime_dir()
    let mut base = fnv(str.join(*cc_args, " "), FNV_BASIS)
    base = dir_fingerprint(rt, base)
    base = dir_fingerprint("{{rt}}/wasm_inc", base)
    let hkey = fnv(head, base)

    // The precompiled header. Its .h is never touched once written: the
    // compiler checks that file's time against the PCH.
    let hpath = "{{dir}}/{{hex16(hkey)}}.h"
    let pch = "{{hpath}}.pch"
    if sys.exists(pch) == 0 {
        progress("pch")
        if sys.write_file(hpath, "{{head}}\n") != 0 {
            return ""
        }
        let t0 = async.now_ms()
        let tmp = "{{pch}}.{{BUILD_TAG}}.tmp"
        let mut args = []string {}
        push_all(&mut args, cc_args)
        push_list(&mut args, []string { "-x", "c-header", hpath, "-o", tmp })
        if sys.run(&args) != 0 || sys.rename(tmp, pch) != 0 {
            sys.remove_path(tmp)
            return ""
        }
        if env_on("LOAM_TIME") {
            fmt.eprintln("loam: pch {{secs(async.now_ms() - t0)}}s")
        }
    }

    let mut pch_args = []string {}
    push_all(&mut pch_args, cc_args)
    push_list(&mut pch_args, []string { "-include-pch", pch })
    // Cut the bodies between the first marker and the data into units.
    let mut start = first
    let mut p = first
    while p < defs {
        let mut next = str.index_from(src, "\n/*@S ", p + 1)
        if next < 0 || next > defs {
            next = defs
        }
        let close = str.index_from(src, "*/", p + 6)
        let name = if close >= 0 && close <= next { str.slice(src, p + 6, close) } else { "" }
        let size = next - start
        if next == defs || size >= SHARD_MAX || (size >= SHARD_MIN && fnv(name, FNV_BASIS) % SHARD_CUT == u64(0)) {
            let text = str.slice(src, start, next)
            if !shard_unit(&pch_args, dir, fnv(text, hkey), text) {
                return ""
            }
            start = next
        }
        p = next
    }
    // The one unit that owns the program's storage: the header, then the data.
    let whole = "#define LOAM_SHARD_DEFS 1\n{{head}}"
    let data = str.slice_from(src, defs)
    if !shard_unit(cc_args, dir, fnv(data, fnv(whole, base)), "{{whole}}{{data}}") {
        return ""
    }
    // Files that never change between edits (a target's runtime and host),
    // compiled from the cache too, so each needs its own directory on the path.
    for i in 0..extra.len {
        let er = sys.read(extra[i])
        if er.tag != ResultTag.Ok {
            return ""
        }
        let mut ecc = []string {}
        push_all(&mut ecc, cc_args)
        push(ecc, "-I{{loader.parent_dir(extra[i])}}")
        if !shard_unit(&ecc, dir, fnv(er.val, base), "#line 1 \"{{extra[i]}}\"\n{{er.val}}") {
            return ""
        }
    }

    if env_on("LOAM_TIME") {
        fmt.eprintln("loam: units {{SHARD_OBJS.len}}, compiling {{SHARD_JOBS.len}}")
    }
    if !shard_run_jobs() {
        return ""
    }
    let rsp = "{{dir}}/{{hex16(hkey)}}.rsp"
    let mut list = []u8 {}
    for i in 0..SHARD_OBJS.len {
        buf.push_str(&mut list, "\"{{SHARD_OBJS[i]}}\"\n")
    }
    if sys.write_bytes(rsp, &list) != 0 {
        return ""
    }
    shard_prune(dir, hpath, rsp)
    return rsp
}

/** *The app's C as link inputs: the cached objects of a shard build, or the */
/** *file itself. A shard build that failed falls back to the file, which is */
/** *still one whole program given the macro that turns its definitions on. */
fn app_input(shard_dir: string, cpath: string, cc_args: &[]string, extra: &[]string) -> []string {
    if shard_dir.len > 0 {
        let rsp = shard_compile(cpath, cc_args, shard_dir, extra)
        if rsp.len > 0 {
            SHARD_LINKED = true
            return []string { "-x", "none", "@{{rsp}}" }
        }
        fmt.eprintln("loam: shard build failed; compiling the whole program")
        return []string { "-DLOAM_SHARD_DEFS", "-x", "c", cpath }
    }
    return []string { "-x", "c", cpath }
}

// --- wasm32 (the browser canvas host) ----------------------------------------------

/** *C runs on native builds only: a client build must not reach any `#[c]` */
/** *fn. Prints one error per reachable one; `true` when there are none. */
fn client_c_ok() -> bool {
    let mut ok = true
    for m in 0..typecheck.MODS.len {
        let root = typecheck.MODS[m].root
        if root == ast.NONE {
            continue
        }
        let decls = ast.NODES[root].kids
        for i in 0..decls.len {
            let d = decls[i]
            if ast.NODES[d].kind != Kind.Fn || codegen.c_sym_of(d).len == 0 || !dce.keep(d) {
                continue
            }
            fmt.eprintln("{{typecheck.MODS[m].path}}:{{ast.INFO[d].loc.line}}: error: #[c] fn '{{ast.INFO[d].name}}' is reachable, and C runs only on native builds. Keep it behind #[server] or out of this target")
            ok = false
        }
    }
    return ok
}

/** *`cc` can compile for wasm32. A probe compile, its output discarded (the */
/** *one shell use here: `sys.spawn` cannot silence a child). */
fn wasm_cc_ok(cc_path: string) -> bool {
    if cc_path.len == 0 {
        return false
    }
    let probe = "{{tmp_dir()}}/loam_wasm_probe_{{BUILD_TAG}}.c"
    if sys.write_file(probe, "void loam_wasm_probe(void){}\n") != 0 {
        return false
    }
    let null = if sys.os() == "windows" { "NUL" } else { "/dev/null" }
    sys.exec("\"{{cc_path}}\" --target=wasm32 -c -x c \"{{probe}}\" -o {{null}} >{{null}} 2>&1")
    let ok = sys.exec_status() == 0
    sys.remove_path(probe)
    return ok
}

/** *A clang with the wasm32 backend: `LOAM_WASM_CC`, then the usual places. */
/** *`""` when there is none (Apple's /usr/bin/clang has no wasm32). */
fn find_wasm_cc() -> string {
    let env = sys.env("LOAM_WASM_CC")
    if env.len > 0 && wasm_cc_ok(env) {
        return env
    }
    let cands = []string { "clang", "/opt/homebrew/opt/llvm/bin/clang", "/usr/local/opt/llvm/bin/clang", "emcc" }
    for i in 0..cands.len {
        if wasm_cc_ok(cands[i]) {
            return cands[i]
        }
    }
    return ""
}

/** *A directory a `-ffile-prefix-map` can name as is. */
fn plain_abs_dir(p: string) -> bool {
    if p.len == 0 || p[0] != '/' {
        return false
    }
    for i in 0..p.len {
        let c = p[i]
        let ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') ||
            c == '/' || c == '_' || c == '.' || c == '-' || c == '+'
        if !ok {
            return false
        }
    }
    return true
}

/** *Remap `__FILE__` in the wasm build: the working dir, the temp dir, /tmp. */
fn wasm_file_maps() -> []string {
    let mut out = []string {}
    let dirs = []string { sys.cwd(), sys.env("TMPDIR"), "/tmp" }
    for i in 0..dirs.len {
        let d = dirs[i]
        if !plain_abs_dir(d) {
            continue
        }
        let trimmed = if d.len > 1 && str.ends_with(d, "/") { str.slice(d, 0, d.len - 1) } else { d }
        push(out, "-ffile-prefix-map={{trimmed}}/=")
    }
    return out
}

/** *Copy a file whole. `true` on success. */
fn copy_file(from: string, to: string) -> bool {
    let r = sys.read(from)
    return r.tag == ResultTag.Ok && sys.write_file(to, r.val) == 0
}

/** *Build the wasm module from `cpath` (and the Canvas2D loader beside it). */
/** *`false` after printing why not. */
fn wasm_build(in_path: string, cpath: string, binpath: string, shard_dir: string, release: bool, split_input: bool) -> bool {
    let rt = loader.runtime_dir()
    let loader_src = "{{zeus_dir()}}/hosts/web/loader.js"
    let loader_dst = "{{loader.parent_dir(binpath)}}/loader.js"
    if !copy_file(loader_src, loader_dst) {
        fmt.eprintln("loam: warning: could not copy {{loader_src}}")
    }
    let wcc = find_wasm_cc()
    if wcc.len == 0 {
        let keep = "{{binpath}}.c"
        copy_file(cpath, keep)
        fmt.eprintln("loam: no clang with wasm32 (Apple /usr/bin/clang cannot).\n  ./install.sh          # Homebrew LLVM, puts clang on PATH\n  or: brew install llvm\n  LOAM_WASM_CC=/opt/homebrew/opt/llvm/bin/clang ./bin/loamc --target=wasm32 {{in_path}} -o {{binpath}}\n  generated C kept at {{keep}} ; Canvas2D loader at {{loader_dst}}")
        sys.remove_path(cpath)
        return false
    }
    let maps = wasm_file_maps()
    let owns = if types.string_owns { "-DLOAM_STRING_OWNS" } else { "" }
    let net_c = if mods_use("http") || mods_use("net") { "{{rt}}/net.c" } else { "" }
    // The allocation proof is a test harness, and a release is what visitors
    // download.
    let rel_flags = if release { []string { "-DLOAM_NO_TRAP_LOC", "-DLOAM_WEB_RELEASE" } } else { []string { "-DLOAM_ALLOC_TRACE" } }
    let mut args = []string { wcc }
    push_all(&mut args, &maps)
    push_list(&mut args, []string { "--target=wasm32", "-nostdlib", "-ffreestanding", "-fno-stack-protector" })
    if uses_zeus() {
        // The runtime and the web host never change between edits, so a
        // shard build keeps them as objects too.
        let w_libc = "{{rt}}/zeus_wasm_libc.c"
        let w_host = "{{zeus_dir()}}/hosts/web/wasm.c"
        let w_plat = "{{rt}}/zeus_plat.c"
        let w_key = "{{rt}}/zeus_key.c"
        let mut wasm_in = []string { "-x", "c", cpath }
        if shard_dir.len > 0 {
            let mut unit_cc = []string { wcc }
            push_all(&mut unit_cc, &maps)
            push_list(&mut unit_cc, []string { "--target=wasm32", "-nostdlib", "-ffreestanding", "-fno-stack-protector", "-Oz", "-ffp-contract=off" })
            push_all(&mut unit_cc, &rel_flags)
            push_list(&mut unit_cc, []string { owns, "-I{{rt}}/wasm_inc", "-I{{rt}}" })
            let mut unit_cc_set = []string {}
            for i in 0..unit_cc.len {
                if unit_cc[i].len > 0 {
                    push(unit_cc_set, unit_cc[i])
                }
            }
            let mut extra = []string { w_libc, w_host, w_plat, w_key }
            if net_c.len > 0 {
                push(extra, net_c)
            }
            wasm_in = app_input(shard_dir, cpath, &unit_cc_set, &extra)
        }
        // clang runs wasm-opt after any link it sees -O for, which strips the
        // names the splitter needs, and most of a dev build's link is that
        // pass; -Oz on the compile step alone keeps the optimized code.
        if split_input || want_dev() {
            push_list(&mut args, []string { "-Xclang", "-Oz" })
        } else {
            push(args, "-Oz")
        }
        push(args, "-ffp-contract=off")
        push_all(&mut args, &rel_flags)
        push_list(&mut args, []string { owns, "-I{{rt}}/wasm_inc", "-I{{rt}}" })
        // --fatal-warnings: wasm-ld downgrades a prototype that disagrees with
        // its definition to a warning and links a trapping stub. The loader
        // resets the shadow stack after a trap (`__stack_pointer`). A 4 MB
        // stack placed first: an overflow runs below 0 and traps cleanly
        // instead of overwriting globals.
        push_list(&mut args, []string { "-Wl,--no-entry", "-Wl,--export-dynamic", "-Wl,--fatal-warnings", "-Wl,--export=__stack_pointer", "-Wl,-z,stack-size=4194304", "-Wl,--stack-first" })
        push_all(&mut args, &wasm_in)
        if !SHARD_LINKED {
            push_list(&mut args, []string { "-x", "none", w_libc, w_host, w_plat, w_key, net_c })
        }
    } else {
        push_list(&mut args, []string { "-Oz", "-ffp-contract=off", owns, "-I{{rt}}/wasm_inc", "-I{{rt}}" })
        push_list(&mut args, []string { "-Wl,--no-entry", "-Wl,--export-dynamic", "-Wl,--export=main", "-Wl,--fatal-warnings", "-Wl,-z,stack-size=4194304", "-Wl,--stack-first" })
        push_list(&mut args, []string { "-x", "c", cpath, "-x", "none", "{{rt}}/zeus_wasm_libc.c", net_c })
    }
    push_list(&mut args, []string { "-o", binpath })
    let mut argv = []string {}
    for i in 0..args.len {
        if args[i].len > 0 {
            push(argv, args[i])
        }
    }
    let t0 = async.now_ms()
    if env_on("LOAM_TIME") {
        fmt.eprintln("loam: cc {{wcc}}")
    }
    progress(if SHARD_LINKED { "link" } else { "cc" })
    if sys.run(&argv) != 0 {
        fmt.eprintln("loam: wasm compile failed (C: {{cpath}})")
        return false
    }
    if env_on("LOAM_TIME") {
        fmt.eprintln("loam: cc {{secs(async.now_ms() - t0)}}s")
    }
    if split_input && !copy_file(cpath, "{{binpath}}.c") {
        fmt.eprintln("loam: could not keep the C for splitting")
    }
    sys.remove_path(cpath)
    return true
}

// --- `--cost`: a static cost report for the whole program -------------------------
//
// The counts come from the lowering the backend already does: every box
// allocation, drop, bounds check and checked (trap-carrying) arithmetic is an
// explicit IR instruction, so they report what the emitted C will do. The C
// byte count is the size of the real translation unit, from the same codegen a
// build runs, minus `cc`.

/** *`n` right-aligned in `width` columns (C's `%8ld`). */
fn pad_left(n: i64, width: int) -> string {
    let t = "{{n}}"
    let mut out = ""
    for i in t.len..width {
        out = "{{out}} "
    }
    return "{{out}}{{t}}"
}

/** *`s` left-aligned in `width` columns (C's `%-14s`). */
fn pad_right(s: string, width: int) -> string {
    let mut out = s
    for i in s.len..width {
        out = "{{out}} "
    }
    return out
}

/** *The module a `loam_<mod>_<fn>` C name belongs to (the longest module */
/** *name that fits), or -1 for an entry fn. */
fn cname_mod_index(cname: string) -> int {
    if !str.starts_with(cname, "loam_") {
        return -1
    }
    let mut best = -1
    let mut best_len = 0
    for i in 0..typecheck.MODS.len {
        let name = typecheck.MODS[i].name
        let n = name.len
        if n == 0 || n <= best_len || cname.len <= 5 + n {
            continue
        }
        if str.slice(cname, 5, 5 + n) == name && cname[5 + n] == '_' {
            best = i
            best_len = n
        }
    }
    return best
}

/** *The package a fn's code is billed to: `std`, a package's name, or */
/** *`(entry)` for the program's own modules. */
fn cost_bucket(f: int) -> string {
    let fx = &ir.FNS[f]
    let mut idx = -1
    if fx.has_name && fx.name == "__init" {
        idx = fx.init_mod
        if idx < 0 || idx >= typecheck.MODS.len {
            return "(entry)"
        }
    } else {
        idx = if fx.has_cname { cname_mod_index(fx.cname) } else { -1 }
        if idx < 0 {
            return "(entry)"
        }
    }
    if idx == 0 {
        return "(entry)"
    }
    let label = loader.package_label(typecheck.MODS[idx].path)
    return if label.len > 0 { label } else { "(entry)" }
}

/** *Lower, count, size the C, and print the report. */
fn cost_report() {
    // The same reachability pruning a real build does, so the report counts
    // the code that would ship.
    if !dce.SKIP {
        dce.run()
    }
    ir.lower_modules()
    ir.verify()
    let mut fns: i64 = i64(0)
    let mut blocks: i64 = i64(0)
    let mut insts: i64 = i64(0)
    let mut allocs: i64 = i64(0)
    let mut drops: i64 = i64(0)
    let mut moves: i64 = i64(0)
    let mut bounds: i64 = i64(0)
    let mut checked: i64 = i64(0)
    let mut calls: i64 = i64(0)
    let mut closures: i64 = i64(0)
    let mut strings: i64 = i64(0)
    let mut widest: i64 = i64(0)
    let mut widest_name = ""
    let mut bucket_names = []string {}
    let mut bucket_insts = []i64 {}
    let mut total: i64 = i64(0)
    for f in 0..ir.FNS.len {
        let fx = &ir.FNS[f]
        let mut n: i64 = i64(0)
        for b in fx.blocks..fx.blocks + fx.nblocks {
            let first = ir.BLOCKS[b].first
            n = n + i64(ir.BLOCKS[b].count)
            for i in first..first + ir.BLOCKS[b].count {
                let op = ir.INSTS[i].op
                if op == Op.Alloc {
                    allocs = allocs + i64(1)
                } else if op == Op.Drop {
                    drops = drops + i64(1)
                } else if op == Op.Move {
                    moves = moves + i64(1)
                } else if op == Op.Bound {
                    bounds = bounds + i64(1)
                } else if op == Op.Clos {
                    closures = closures + i64(1)
                } else if op == Op.ConstStr {
                    strings = strings + i64(1)
                } else if op == Op.Call || op == Op.CallVal {
                    calls = calls + i64(1)
                } else if op == Op.Bin && (ir.INSTS[i].bits & ir.I_CHECKED) != 0 {
                    checked = checked + i64(1)
                }
            }
        }
        blocks = blocks + i64(fx.nblocks)
        insts = insts + n
        fns = fns + i64(1)
        if n > widest {
            widest = n
            widest_name = if fx.has_name { fx.name } else { fx.cname }
        }
        total = total + n
        let bucket = cost_bucket(f)
        let mut k = 0
        while k < bucket_names.len && bucket_names[k] != bucket {
            k += 1
        }
        if k == bucket_names.len {
            if bucket_names.len < 72 {
                push(bucket_names, bucket)
                push(bucket_insts, n)
            }
        } else {
            bucket_insts[k] = bucket_insts[k] + n
        }
    }
    // Size the real translation unit: codegen into a temp file.
    let sink = "{{tmp_dir()}}/loam_cost_{{BUILD_TAG}}.c"
    codegen.SINK = sink
    codegen.emit_c()
    let c_bytes = i64(sys.read_file(sink).len)
    sys.remove_path(sink)
    fmt.println("loam: cost report")
    fmt.println("  functions      {{pad_left(fns, 8)}}")
    fmt.println("  blocks         {{pad_left(blocks, 8)}}")
    fmt.println("  IR insts       {{pad_left(insts, 8)}}")
    fmt.println("  allocs (malloc){{pad_left(allocs, 8)}}")
    fmt.println("  drops (frees)  {{pad_left(drops, 8)}}")
    fmt.println("  moves          {{pad_left(moves, 8)}}")
    fmt.println("  bounds checks  {{pad_left(bounds, 8)}}")
    fmt.println("  overflow traps {{pad_left(checked, 8)}}")
    fmt.println("  calls          {{pad_left(calls, 8)}}")
    fmt.println("  closures       {{pad_left(closures, 8)}}")
    fmt.println("  string literals{{pad_left(strings, 8)}}")
    fmt.println("  C bytes        {{pad_left(c_bytes, 8)}}")
    for k in 0..bucket_names.len {
        let share = if total > i64(0) { c_bytes * bucket_insts[k] / total } else { i64(0) }
        fmt.println("  package {{pad_right(bucket_names[k], 14)}} {{pad_left(share, 8)}} bytes")
    }
    let wn = if widest_name.len > 0 { widest_name } else { "-" }
    fmt.println("  largest fn     {{wn}} ({{widest}} IR insts)")
}

// --- the frontend ------------------------------------------------------------------

/** *Load, typecheck, and run the later passes. Every diagnostic is printed */
/** *in order; `false` on any. */
fn check(path: string) -> bool {
    let loaded = loader.load(path)
    for i in 0..loader.WARNINGS.len {
        fmt.eprintln(loader.WARNINGS[i])
    }
    if !loaded {
        dump.print_diags()
        return false
    }
    types.types_init()
    if typecheck.typecheck_modules() > 0 {
        dump.print_diags()
        return false
    }
    let mut module_names = []string {}
    let mut module_roots = []int {}
    for m in 0..typecheck.MODS.len {
        push(module_names, typecheck.MODS[m].name)
        push(module_roots, typecheck.MODS[m].root)
    }
    threadcheck.threadcheck_modules(module_names, module_roots)
    borrowck.borrowck_modules()
    boundscheck.boundscheck_modules(module_roots)
    dump.print_diags()
    return ast.DIAGS.len == 0
}

fn usage() {
    fmt.ewrite("usage: loam [build] [options] <file.loam>\n  build       compile (optional; same as omitting it)\n  test        compile a runner for every `#[test]` fn and run it\n  check       typecheck only: no codegen, no cc, no output file\n  -o PATH     output binary (or .c/.ir with --emit-c/--emit-ir)\n  --emit-c    emit C99 (gnu99) instead of a binary\n  --emit-ir   emit backend-neutral IR instead of a binary\n  --target native  desktop GUI: Cocoa on macOS, X11 on Linux (default)\n  --target wasm32  Canvas2D GUI .wasm (alias: wasm; needs clang wasm32).\n  --wasm-release  with wasm32: drop the file and line from panics\n  --wasm-split-input  with wasm32: keep symbol names, skip wasm-opt, and\n              write the C beside the output, for `zeli build` to split.\n                   This is the browser *canvas host*, not a CLI target:\n                   a future CLI/WASI build is a separate target.\n  --target ios     iOS Simulator .app (same Zeus paint as Cocoa; needs Xcode)\n  --target android Gradle + JNI Canvas host (needs Android SDK/NDK to build APK)\n  --run       compile and run (Simulator for --target=ios; gradle+adb for android)\n  --int64-compat  `int` = i64 and `float` = f64 (pre-Phase-10 behavior)\n  --string-owns   `string` is owned and refcounted (default)\n  --no-string-owns  restore never-freed strings (bisecting a bug)\n  --cost      print a cost report (fns, allocs, copies, traps, C bytes,\n              bytes per imported package) and stop\nDefault output: <source-dir>/build/<name> (.app on ios; Gradle tree on android)\n")
}

// --- main --------------------------------------------------------------------------

fn main() {
    let mut in_path = ""
    let mut out_path = ""
    let mut emit_c = false
    let mut run = false
    let mut check_only = false
    let mut test_mode = false
    let mut emit_ir = false
    let mut cost = false
    let mut target_wasm = false
    let mut wasm_release = false
    let mut wasm_split_input = false
    let n = sys.argc()
    let mut i = 1
    while i < n {
        let a = sys.arg(i)
        if a == "-h" || a == "--help" {
            usage()
            return
        } else if a == "-o" && i + 1 < n {
            i += 1
            out_path = sys.arg(i)
        } else if a == "--emit-c" || a == "-S" {
            emit_c = true
        } else if str.starts_with(a, "--target=") || (a == "--target" && i + 1 < n) {
            let mut t = ""
            if str.starts_with(a, "--target=") {
                t = str.slice_from(a, 9)
            } else {
                i += 1
                t = sys.arg(i)
            }
            if t == "wasm" || t == "wasm32" {
                target_wasm = true
            } else if t == "ios" || t == "android" {
                not_here("--target {{t}}")
            } else if t == "native" {
                target_wasm = false
            } else {
                fmt.eprintln("unknown target {{t}} (want native, wasm32, ios, or android)")
                sys.exit(1)
            }
        } else if a == "--run" {
            run = true
        } else if a == "test" {
            // Build a runner for every `#[test]` fn and run it.
            test_mode = true
            run = true
        } else if a == "--emit-ir" {
            emit_ir = true
        } else if a == "--wasm-release" {
            wasm_release = true
        } else if a == "--wasm-split-input" {
            wasm_split_input = true
        } else if a == "--cost" {
            cost = true
        } else if str.starts_with(a, "--dump-") {
            not_here(a)
        } else if a == "check" {
            check_only = true
        } else if a == "--int64-compat" {
            types.int64_compat = true
        } else if a == "--string-owns" {
            types.string_owns = true
        } else if a == "--no-string-owns" {
            types.string_owns = false
        } else if a == "build" {
            // `loam build app.loam`: the same as omitting `build`.
        } else if a.len > 0 && a[0] == '-' {
            fmt.eprintln("unknown option {{a}}")
            usage()
            sys.exit(1)
        } else {
            in_path = a
        }
        i += 1
    }
    if in_path.len == 0 {
        usage()
        sys.exit(1)
    }
    // LOAM_NO_DCE: emit every declaration (debug and size comparisons).
    dce.SKIP = sys.env("LOAM_NO_DCE").len > 0
    let show_time = env_on("LOAM_TIME")

    // A build with `-o` whose inputs have not changed since the last one
    // reuses its output. `--emit-c` and `check` never use the cache.
    let mut key = ""
    if out_path.len > 0 && !check_only && !cost && !emit_c && !fresh_off() {
        key = fresh_key(in_path)
        if fresh_match(out_path, key) {
            if show_time {
                fmt.eprintln("loam: fresh")
            }
            if emit_ir {
                return
            }
            if !test_mode {
                let what = if target_wasm { " (Canvas2D wasm)" } else { "" }
                fmt.println("loam: {{in_path}} -> {{out_path}}{{what}}")
            }
            if run {
                let argv = []string { runnable(out_path) }
                if sys.run(&argv) != 0 {
                    sys.exit(1)
                }
            }
            return
        }
    }

    let mut t0 = async.now_ms()
    progress("check")
    loader.RELEASE_IMPORTS = wasm_release
    if !check(in_path) {
        sys.exit(1)
    }
    if show_time {
        fmt.eprintln("loam: check {{secs(async.now_ms() - t0)}}s")
    }
    progress("modules {{typecheck.MODS.len}}")
    if cost {
        if BUILD_TAG.len == 0 {
            BUILD_TAG = hex16(fnv("{{absolute(in_path)}}:{{async.now_ms()}}", FNV_BASIS))
        }
        cost_report()
        return
    }
    if check_only {
        fmt.println("loam: {{in_path}} ok")
        return
    }
    // The generated runner calls test.begin / ok / summary.
    if test_mode && !mods_use("test") {
        fmt.eprintln("loam test: {{in_path}} must import \"std:test\"")
        sys.exit(1)
    }
    // The IR as text, to `-o` or stdout; exit 1 if the verifier objects.
    if emit_ir {
        ir.lower_modules()
        let bad = ir.verify()
        let mut text = []u8 {}
        irprint.print_ir(&mut text)
        if out_path.len > 0 {
            if !ensure_parent_dir(out_path) {
                fmt.eprintln("error: cannot create directory for output")
                sys.exit(1)
            }
            if sys.write_bytes(out_path, &text) != 0 {
                fmt.eprintln("error: cannot write '{{out_path}}'")
                sys.exit(1)
            }
            if !bad && key.len > 0 {
                fresh_save(out_path, key)
            }
        } else {
            fmt.write(buf.to_string(&text))
        }
        if bad {
            sys.exit(1)
        }
        return
    }

    let stem = loader.stem_of(in_path)
    let srcdir = loader.parent_dir(in_path)
    let mut cpath = ""
    let mut binpath = ""
    if emit_c {
        cpath = if out_path.len > 0 { out_path } else { "{{srcdir}}/build/{{stem}}.c" }
    } else {
        let ext = if target_wasm { ".wasm" } else { "" }
        binpath = if out_path.len > 0 { out_path } else { "{{srcdir}}/build/{{stem}}{{ext}}" }
        // A test runner without `-o` is a throwaway: never in the app's build/.
        if test_mode && out_path.len == 0 {
            let run_key = "{{absolute(in_path)}}:{{async.now_ms()}}"
            let run_tag = hex16(fnv(run_key, FNV_BASIS))
            binpath = "{{tmp_dir()}}/loam_test_{{stem}}_{{run_tag}}"
        }
        BUILD_TAG = hex16(fnv(absolute(binpath), FNV_BASIS))
        cpath = "{{tmp_dir()}}/loam_{{stem}}_{{BUILD_TAG}}.c"
    }
    // `LOAM_SHARD=<cache dir>`: a development build in units, for the Zeus
    // link, the one that goes through `app_input`.
    let mut shard_dir = sys.env("LOAM_SHARD")
    if !uses_zeus() || emit_c || test_mode || str.ends_with(binpath, ".dylib") {
        shard_dir = ""
    }
    // App-owned C seam: `runtime/<stem>_runtime.c` beside the entry file.
    let mut app_rt = ""
    if !emit_c && !target_wasm {
        let cand = "{{srcdir}}/runtime/{{stem}}_runtime.c"
        if sys.exists(cand) == 1 {
            app_rt = cand
        }
    }
    if !ensure_parent_dir(if emit_c { cpath } else { binpath }) {
        fmt.eprintln("error: cannot create directory for output")
        sys.exit(1)
    }
    if sys.write_file(cpath, "") != 0 {
        fmt.eprintln("error: cannot write '{{cpath}}'")
        sys.exit(1)
    }

    t0 = async.now_ms()
    progress("codegen")
    codegen.SINK = cpath
    dce.TEST_MODE = test_mode
    codegen.TEST_MODE = test_mode
    codegen.SHARD = shard_dir.len > 0
    codegen.BATCH = env_on("LOAM_BATCH")
    // `#[server]` bodies are left out of client targets; `LOAM_SERVER_SPLIT`
    // forces it so the exclusion can be checked from a native build.
    let server_split = target_wasm || sys.env("LOAM_SERVER_SPLIT").len > 0
    dce.SERVER_SPLIT = server_split
    codegen.SERVER_SPLIT = server_split
    // Wasm is published: Loam locations are written relative to where the
    // compiler ran, and any other absolute path as its file name only.
    codegen.PATH_STRIP = if target_wasm { sys.cwd() } else { "" }
    codegen.emit_c()
    if show_time {
        fmt.eprintln("loam: codegen {{secs(async.now_ms() - t0)}}s")
    }
    if target_wasm && !client_c_ok() {
        sys.remove_path(cpath)
        sys.exit(1)
    }
    if emit_c {
        fmt.println("loam: {{in_path}} -> {{cpath}}")
        return
    }

    let rt = loader.runtime_dir()
    let mut extra_link = []string {}
    if app_rt.len > 0 {
        push_list(&mut extra_link, []string { "-I{{rt}}", "-x", "c", app_rt })
    }
    if !c_inputs(&mut extra_link) {
        sys.remove_path(cpath)
        sys.exit(1)
    }
    // LOAM_LINK_EXTRA: more .c/.o inputs or flags for the link, space-separated.
    let le = words(sys.env("LOAM_LINK_EXTRA"))
    if le.len > 0 {
        push(extra_link, "-I{{rt}}")
        push_all(&mut extra_link, &le)
        for i in 0..le.len {
            if sys.stamp(le[i]).len > 0 {
                push(FRESH_DEPS, le[i])
            }
        }
    }

    if target_wasm {
        if !wasm_build(in_path, cpath, binpath, shard_dir, wasm_release, wasm_split_input) {
            sys.exit(1)
        }
        if key.len > 0 {
            fresh_save(binpath, key)
        }
        fmt.println("loam: {{in_path}} -> {{binpath}} (Canvas2D wasm)")
        return
    }

    let copt = copt_flags()
    let headless = want_headless() || want_dev()
    let ld = if headless { "" } else if on_mac() { "-Wl,-dead_strip" } else { "-Wl,--gc-sections" }
    let mut args = []string {}
    if str.ends_with(binpath, ".dylib") {
        // A loadable image for `zeli serve`: no host objects, symbols left for
        // the loader to supply.
        push_all(&mut args, &copt)
        if on_mac() {
            push_list(&mut args, []string { "-dynamiclib", "-undefined", "dynamic_lookup" })
        } else {
            push(args, "-shared")
        }
        push_list(&mut args, []string { "-o", binpath, "-I{{rt}}", "-x", "c", cpath })
        push_all(&mut args, &extra_link)
        if !run_cc(&args) {
            fmt.eprintln("loam: shared object compile failed (temp source: {{cpath}})")
            sys.exit(1)
        }
        fmt.println("loam: {{in_path}} -> {{binpath}} (loadable)")
        sys.remove_path(cpath)
        return
    }

    if env_on("LOAM_BATCH") {
        // The fork-per-case runner (`-x none`: the link may still be reading
        // its inputs as C).
        let run_c = "{{rt}}/batch_run.c"
        let run_o = "{{rt}}/.obj/batch_run.o"
        let no_flags = []string {}
        let run_deps = []string { run_c }
        if !ensure_obj(run_c, run_o, &no_flags, &run_deps) {
            fmt.eprintln("loam: failed to compile the batch runner")
            sys.remove_path(cpath)
            sys.exit(1)
        }
        push_list(&mut extra_link, []string { "-x", "none", run_o })
    }

    t0 = async.now_ms()
    let mut unit_args = cc()
    push_all(&mut unit_args, &copt)
    push(unit_args, "-I{{rt}}")
    let no_extra = []string {}
    let app_in = app_input(shard_dir, cpath, &unit_args, &no_extra)
    if !link_args(cpath, binpath, &copt, ld, &extra_link, &app_in, &mut args) {
        sys.remove_path(cpath)
        sys.exit(1)
    }
    progress(if SHARD_LINKED { "link" } else { "cc" })
    let ok = run_cc(&args)
    if show_time {
        fmt.eprintln("loam: cc {{secs(async.now_ms() - t0)}}s")
    }
    if !ok {
        fmt.eprintln("loam: C compile failed (temp source: {{cpath}})")
        sys.exit(1)
    }
    sys.remove_path(cpath)
    if key.len > 0 {
        fresh_save(binpath, key)
    }
    if !test_mode {
        fmt.println("loam: {{in_path}} -> {{binpath}}")
    }
    if run {
        let argv = []string { runnable(binpath) }
        let status = sys.run(&argv)
        if test_mode && out_path.len == 0 {
            sys.remove_path(binpath)
        }
        if status != 0 {
            sys.exit(1)
        }
    }
}
