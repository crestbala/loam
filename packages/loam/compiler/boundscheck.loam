// boundscheck — mark `a[k]` safe when the compiler can prove k in range. A
// port of the C compiler's boundscheck.c, function for function.
//
// Two proofs:
//   - `a[LITERAL]` with `0 <= LITERAL < N` for `[N]T`.
//   - `for i in 0..C.len { ... C[i] ... }`: the loop variable indexes the same
//     container the range bounds, so `i` is in `[0, C.len)` on every iteration.
//     `C` is a place (a local, then fields, through derefs; no index), and
//     `C[i]` must name that same place. The body must not be able to shrink
//     it: no whole or field assignment to its root, no `&mut` of it, no `pop`
//     of it, and, when the root is a reference, no passing it on. A global
//     root never counts, since any call may shrink it.
//
// Everything else keeps a run-time trap. The pass never fails the compile: a
// miss is a redundant check, never a wrong answer.

import "ast.loam"
import "types.loam"
import "lexer.loam"

const INDEX_SAFE: int = 1

/** *The identifier node a `<expr>.len` is rooted at, or `ast.NONE`. */
fn len_container_ident(n: int) -> int {
    if n == ast.NONE || ast.NODES[n].kind != Kind.Field || ast.INFO[n].name != "len" {
        return ast.NONE
    }
    let mut base = ast.NODES[n].a
    while base != ast.NONE && ast.NODES[base].kind != Kind.Ident {
        let base_kind = ast.NODES[base].kind
        if base_kind == Kind.Field || base_kind == Kind.Index || base_kind == Kind.Deref {
            base = ast.NODES[base].a
        } else {
            return ast.NONE
        }
    }
    return base
}

/** *The identifier node a place expression is rooted at, or `ast.NONE`. */
fn root_ident_node(place: int) -> int {
    let mut n = place
    while n != ast.NONE {
        let place_kind = ast.NODES[n].kind
        if place_kind == Kind.Ident {
            return n
        }
        if place_kind == Kind.Field || place_kind == Kind.Index || place_kind == Kind.Deref {
            n = ast.NODES[n].a
        } else {
            return ast.NONE
        }
    }
    return ast.NONE
}

/** *A `for`-loop in-range proof in force for the current subtree: the `For` */
/** *node the loop variable resolves to, and the identifier whose `.len` */
/** *bounds the loop (`ast.NONE` when the range is not `0..C.len`). Both match */
/** *by resolution, so a shadowing `let i` or a rebound `xs` cannot fool it. */
struct LoopProof {
    loop_node: int,
    container: int,
    /** *The place `.len` is read from (`C` in `C.len`), or `ast.NONE`. */
    bound: int,
}

let mut PROOFS: []LoopProof = []LoopProof {}

/** *`a` and `b` are the same place: the same resolved root, then the same */
/** *fields and derefs. A path through an index is never the same place. */
fn same_place(a: int, b: int) -> bool {
    if a == ast.NONE || b == ast.NONE || ast.NODES[a].kind != ast.NODES[b].kind {
        return false
    }
    let place_kind = ast.NODES[a].kind
    if place_kind == Kind.Ident {
        return ast.NODES[a].res != ast.NONE && ast.NODES[a].res == ast.NODES[b].res
    }
    if place_kind == Kind.Field {
        return ast.INFO[a].name == ast.INFO[b].name && same_place(ast.NODES[a].a, ast.NODES[b].a)
    }
    if place_kind == Kind.Deref {
        return same_place(ast.NODES[a].a, ast.NODES[b].a)
    }
    return false
}

/** *`n` is a place without an index: an identifier, then fields and derefs. */
fn is_plain_place(n: int) -> bool {
    let mut at = n
    while at != ast.NONE {
        let place_kind = ast.NODES[at].kind
        if place_kind == Kind.Ident {
            return true
        }
        if place_kind != Kind.Field && place_kind != Kind.Deref {
            return false
        }
        at = ast.NODES[at].a
    }
    return false
}

/** *`n` is a place rooted at the identifier resolving to `root_res`. */
fn rooted_at(n: int, root_res: int) -> bool {
    let root = root_ident_node(n)
    return root != ast.NONE && ast.NODES[root].res == root_res
}

/** *Could anything in `n` shrink or replace what the root `root_res` holds? */
/** *`by_ref`: the root is a reference, so passing it on lends it out. */
fn may_shrink(n: int, root_res: int, by_ref: bool) -> bool {
    if n == ast.NONE {
        return false
    }
    let node_kind = ast.NODES[n].kind
    if node_kind == Kind.Assign {
        let target = ast.NODES[n].a
        // An element write keeps the length; anything else may not.
        if target != ast.NONE && ast.NODES[target].kind != Kind.Index && rooted_at(target, root_res) {
            return true
        }
    }
    if node_kind == Kind.Addr && ast.NODES[n].op != 0 && rooted_at(ast.NODES[n].a, root_res) {
        return true
    }
    if node_kind == Kind.Call {
        let args = ast.NODES[n].kids
        let pops = (ast.INFO[n].marks & ast.M_VEC_POP) != 0
        for i in 0..args.len {
            let arg = args[i]
            if arg == ast.NONE {
                continue
            }
            let place = if ast.NODES[arg].kind == Kind.Addr { ast.NODES[arg].a } else { arg }
            if (pops || by_ref) && is_plain_place(place) && rooted_at(place, root_res) {
                return true
            }
        }
    }
    if may_shrink(ast.NODES[n].a, root_res, by_ref) || may_shrink(ast.NODES[n].b, root_res, by_ref) ||
        may_shrink(ast.NODES[n].c, root_res, by_ref) {
        return true
    }
    for i in 0..ast.NODES[n].kids.len {
        if may_shrink(ast.NODES[n].kids[i], root_res, by_ref) {
            return true
        }
    }
    return false
}

/** *`index` is exactly the loop variable of a proof in force whose bounded */
/** *place `target` names. */
fn is_proven_index(index: int, target: int) -> bool {
    if index == ast.NONE || ast.NODES[index].kind != Kind.Ident || ast.NODES[index].res == ast.NONE {
        return false
    }
    let mut i = PROOFS.len
    while i > 0 {
        i = i - 1
        let proof = PROOFS[i]
        if proof.loop_node != ast.NONE && proof.bound != ast.NONE && ast.NODES[index].res == proof.loop_node &&
            same_place(proof.bound, target) {
            return true
        }
    }
    return false
}

/** *Each child of `parent`, read in place (no copy of the kids vec). */
fn walk_list(parent: int) {
    for i in 0..ast.NODES[parent].kids.len {
        walk(ast.NODES[parent].kids[i])
    }
}

/** *Depth-first walk; sets `INDEX_SAFE` on proven-in-range indexes. */
fn walk(n: int) {
    if n == ast.NONE {
        return
    }
    let node_kind = ast.NODES[n].kind
    switch node_kind {
        case Kind.Program:
            for i in 0..ast.NODES[n].kids.len {
                let decl = ast.NODES[n].kids[i]
                let decl_kind = ast.NODES[decl].kind
                if decl_kind != Kind.Import && decl_kind != Kind.CDir {
                    walk(decl)
                }
            }
            break
        case Kind.Fn, Kind.Closure:
            walk(ast.NODES[n].b)
            break
        case Kind.Block:
            walk_list(n)
            break
        case Kind.If:
            walk(ast.NODES[n].a)
            walk(ast.NODES[n].b)
            walk(ast.NODES[n].c)
            break
        case Kind.For:
            walk(ast.NODES[n].a)
            // `for i in 0..C.len` proves every `C[i]` in the body in range.
            let iter = ast.NODES[n].a
            let mut container = ast.NONE
            let mut bound = ast.NONE
            if iter != ast.NONE && ast.NODES[iter].kind == Kind.Binary && ast.NODES[iter].op == Tok.DotDot {
                let low = ast.NODES[iter].a
                if low != ast.NONE && ast.NODES[low].kind == Kind.Number && ast.INFO[low].num == 0 {
                    let bounded = len_container_ident(ast.NODES[iter].b)
                    let place = ast.NODES[ast.NODES[iter].b].a
                    if bounded != ast.NONE && ast.NODES[bounded].res != ast.NONE && is_plain_place(place) &&
                        (ast.INFO[ast.NODES[bounded].res].marks & ast.M_GLOBAL_VAR) == 0 {
                        let root_type = ast.NODES[bounded].ty
                        let by_ref = root_type != types.NO_TYPE && types.kind_of(root_type) == TK.Ptr
                        if !may_shrink(ast.NODES[n].b, ast.NODES[bounded].res, by_ref) {
                            container = bounded
                            bound = place
                        }
                    }
                }
            }
            push(PROOFS, LoopProof { loop_node: n, container: container, bound: bound })
            walk(ast.NODES[n].b)
            pop(PROOFS)
            break
        case Kind.While:
            walk(ast.NODES[n].a)
            walk(ast.NODES[n].b)
            break
        case Kind.Switch:
            walk(ast.NODES[n].a)
            walk_list(n)
            break
        case Kind.Case:
            walk_list(n)
            walk(ast.NODES[n].a)
            break
        case Kind.Return, Kind.ExprStmt, Kind.Unary, Kind.Try:
            walk(ast.NODES[n].a)
            break
        case Kind.Var:
            walk(ast.NODES[n].b)
            break
        case Kind.Assign, Kind.Binary:
            walk(ast.NODES[n].a)
            walk(ast.NODES[n].b)
            break
        case Kind.Cast:
            walk(ast.NODES[n].a)
            break
        case Kind.Call:
            walk(ast.NODES[n].a)
            walk_list(n)
            break
        case Kind.Index:
            walk(ast.NODES[n].a)
            walk(ast.NODES[n].b)
            mark_index(n)
            break
        case Kind.Field, Kind.Deref, Kind.Addr:
            walk(ast.NODES[n].a)
            break
        case Kind.StructLit, Kind.ArrayLit, Kind.Tuple:
            walk_list(n)
            break
        default:
            return
    }
}

/** *`a[k]`: a literal in range of a fixed array, or the proven loop index. */
fn mark_index(n: int) {
    let target = ast.NODES[n].a
    let index = ast.NODES[n].b
    let mut target_type = if target != ast.NONE { ast.NODES[target].ty } else { types.NO_TYPE }
    if target_type != types.NO_TYPE && (types.kind_of(target_type) == TK.Ptr || types.kind_of(target_type) == TK.Box) {
        target_type = types.TYPES[target_type].elem
    }
    if target_type == types.NO_TYPE {
        return
    }
    let container_kind = types.kind_of(target_type)
    if container_kind == TK.Array && index != ast.NONE && ast.NODES[index].kind == Kind.Number {
        let literal = ast.INFO[index].num
        if literal >= 0 && literal < types.TYPES[target_type].array_len {
            ast.NODES[n].flags = ast.NODES[n].flags | INDEX_SAFE
        }
    }
    if (ast.NODES[n].flags & INDEX_SAFE) == 0 &&
        (container_kind == TK.Vec || container_kind == TK.Array || container_kind == TK.String) {
        if is_proven_index(index, target) {
            ast.NODES[n].flags = ast.NODES[n].flags | INDEX_SAFE
        }
    }
}

/** *Mark safe indexes in every module, given each module's `Program` node. */
fn boundscheck_modules(roots: []int) {
    for i in 0..roots.len {
        walk(roots[i])
    }
}

/** *Forget the last run's loop proofs (see `ast.reset`). */
fn reset() {
    PROOFS = []LoopProof {}
}
