//! enums — the shared enums of the widget API: layout direction, alignment,
//! spacing, sizing, appearance, the reactive-prop setter keys, and host key
//! codes. Leaf module with no imports of its own, so every layer above —
//! `zeusbase`, the components, `zeus` itself — can name them without importing
//! back down into `zeus`.
//!
//! This file exists because enum *variables* are not module-global the way
//! struct type names are: an enum is reachable only through the import graph,
//! so the ones the primitives and the components share have to sit below both.
//! Values follow the codes the layout solver and the hosts already use.

/// Button variants, named after the fill they carry. `Solid` is the
/// `default` (primary) variant, `Soft` is `secondary`, `Danger` is
/// `destructive`, and `Link` is text-only. Gallery rows read
/// Primary / Secondary / Outline / Ghost / Destructive / Link.
enum LOOK {
    Solid = 0,
    Soft = 1,
    Outline = 2,
    Ghost = 3,
    Danger = 4,
    Link = 5,
}

/// Button sizes, by control height: Sm 32px, Md 36px, Lg 40px.
enum SIZE {
    Sm = 0,
    Md = 1,
    Lg = 2,
}

/// Status tints for chips, badges, stats, meters.
enum TINT {
    Ink = 0,
    Ok = 1,
    Mute = 2,
    Dim = 3,
    Danger = 4,
    Warn = 5,
    Info = 6,
}

/// Layout direction for `align_direction`.
enum DIRECTION {
    Row = 0,
    Column = 1,
}

/// Cross-axis and main-axis alignment. Same codes the layout solver uses.
enum ALIGN {
    Start = 0,
    Center = 1,
    End = 2,
    Between = 3,
    Around = 4,
    Evenly = 5,
    Stretch = 6,
}

/// How `Image` maps the bitmap into its layout box: Stretch (default, may
/// distort), Contain (letterbox), Cover (crop to fill), None (intrinsic size).
enum IMAGE_FIT {
    Stretch = 0,
    Contain = 1,
    Cover = 2,
    None = 3,
}

/// The spacing scale, in points.
/// Spacing, on a 4pt grid. Every step is a multiple of 4 — the three that
/// were not (`Exxxs` 2, `Exxs` 6, `Xxxl` 62) are snapped to the nearest
/// multiple, which is the whole of the change. `Exxs` and `Exs` both land on
/// 8: the old 6/8 pair was a distinction the grid does not make, and keeping
/// both names means no call site has to move.
enum SPACE {
    None = 0,
    Exxxs = 4,
    Exxs = 8,
    Exs = 8,
    Xs = 12,
    Sm = 16,
    Md = 20,
    Lg = 24,
    Xl = 32,
    Xxl = 48,
    Xxxl = 64,
    Xxxxl = 72
}

/// Key codes as delivered by the hosts. `e.key == Key.K` is the spell.
enum Key {
    Backspace = 8,
    Tab = 9,
    Enter = 13,
    Escape = 27,
    Space = 32,
    A = 97,
    B = 98,
    C = 99,
    D = 100,
    E = 101,
    F = 102,
    G = 103,
    H = 104,
    I = 105,
    J = 106,
    K = 107,
    L = 108,
    M = 109,
    N = 110,
    O = 111,
    P = 112,
    Q = 113,
    R = 114,
    S = 115,
    T = 116,
    U = 117,
    V = 118,
    W = 119,
    X = 120,
    Y = 121,
    Z = 122,
    Left = 1000,
    Right = 1001,
    Up = 1002,
    Down = 1003,
    Home = 1004,
    End = 1005,
}

/// Which node attribute a reactive prop writes. One effect per member, so a
/// signal change repaints exactly that attribute.
enum SET {
    Width = 1,
    Height = 2,
    Padding = 3,
    PaddingX = 4,
    PaddingY = 5,
    Spacing = 6,
    Radius = 7,
    Border = 8,
    Grow = 9,
    AlignItems = 10,
    Justify = 11,
    Font = 12,
    Opacity = 13,
    Direction = 14,
    Background = 15,
    Color = 16,
    BorderColor = 17,
    MinWidth = 18,
    MaxWidth = 19,
    MinHeight = 20,
    MaxHeight = 21,
    Wrap = 22,
    Safe = 23,
    Position = 24,
    Left = 25,
    Top = 26,
    Right = 27,
    Bottom = 28,
    ZIndex = 29,
    Shrink = 30,
    ShowOn = 31,
    SvgFit = 32,
    SvgLazy = 33,
    Elevation = 34,
    PaddingTop = 35,
    PaddingRight = 36,
    PaddingBottom = 37,
    PaddingLeft = 38,
    Margin = 39,
    MarginX = 40,
    MarginY = 41,
    MarginTop = 42,
    MarginRight = 43,
    MarginBottom = 44,
    MarginLeft = 45,
    GapRow = 46,
    GapCol = 47,
    RadiusTop = 48,
    RadiusBottom = 49,
    Text = 100,
    A11yLabel = 101,
    A11yRole = 102,
    Cursor = 103,
}
/// Theme slots. A widget stores the *role*, not a resolved color, so the
/// paint pass resolves it against `appearance()` every frame — that is how
/// a theme switch repaints a retained tree with no effects and no rebuild.
enum ROLE {
    Paper = 1,
    Plate = 2,
    Raised = 3,
    Ink = 4,
    Mute = 5,
    Dim = 6,
    Rule = 7,
    Hard = 8,
    Wash = 9,
    OnInk = 10,
    Accent = 11,
    AccentSoft = 12,
    Danger = 13,
    DangerSolid = 14,
    DangerEdge = 15,
    OkSolid = 16,
    Ok = 17,
    OkFill = 18,
    Warn = 19,
    WarnFill = 20,
    WarnEdge = 21,
    OnFill = 22,
    Scrim = 23,
    ChartEdge = 24,
    Chart1 = 25,
    Chart2 = 26,
    Chart3 = 27,
    Chart4 = 28,
    Chart5 = 29,
    Fill1 = 30,
    Fill2 = 31,
    Fill3 = 32,
    Fill4 = 33,
    Fill5 = 34,
    Bone = 35,
    // 36 is baked into `arena.focus_ring_rgb`: the keyboard focus ring is
    // the foreground color in both appearances.
    FocusRing = 36,

    // --- scales (design-system phase 2) ---
    // A 12-step ramp in the Radix sense, not a Tailwind swatch list: the
    // step number is a *role*, so a widget asks for "the border step" and
    // gets a value that stays correct in both appearances and under any
    // accent. 1-2 backgrounds, 3-5 component fills (rest / hover / active),
    // 6-8 borders (subtle / default / strong), 9-10 solid fills, 11-12 text.
    // Steps 11 and 12 are the only ones text is ever drawn in, and both are
    // checked against steps 1-3 by `tokens_contrast_report`.
    N1 = 40, N2 = 41, N3 = 42, N4 = 43, N5 = 44, N6 = 45,
    N7 = 46, N8 = 47, N9 = 48, N10 = 49, N11 = 50, N12 = 51,
    A1 = 52, A2 = 53, A3 = 54, A4 = 55, A5 = 56, A6 = 57,
    A7 = 58, A8 = 59, A9 = 60, A10 = 61, A11 = 62, A12 = 63,
    // Text on the accent's solid step (9/10). Recomputed per accent by
    // `best_on`, because a light accent needs dark text and vice versa —
    // hard-coding white here is what makes an orange primary button fail AA.
    OnAccent = 64,

    // Semantic tiers. Five slots each is what components actually consume:
    // a wash to sit on, a border, a solid fill, that fill's hover, and a
    // text ink that clears AA on the page background.
    // Named by step, not by word: `OkFill` and `WarnFill` already exist above
    // (slots 18 and 20) with different meanings, and Loam accepts duplicate
    // enum names silently — the first cut of this collided and bound white
    // text against a pale wash without any error.
    OkS3 = 65, OkS6 = 66, OkS9 = 67, OkS10 = 68, OkS11 = 69,
    WarnS3 = 70, WarnS6 = 71, WarnS9 = 72, WarnS10 = 73, WarnS11 = 74,
    DangerS3 = 75, DangerS6 = 76, DangerS9 = 77, DangerS10 = 78, DangerS11 = 79,
    InfoS3 = 80, InfoS6 = 81, InfoS9 = 82, InfoS10 = 83, InfoS11 = 84,
    // Text on a semantic solid fill, one per tier. Not a single shared
    // white: white on the amber solid is 2.14:1 and on the green 2.27:1,
    // both under AA's 3:1 for component text. Each is `best_on` of its own
    // fill, so amber badges get dark ink and blue ones get white — which is
    // what the ratio demands, not a stylistic preference.
    OnOk = 85, OnWarn = 87, OnDanger = 88, OnInfo = 89,
    // Elevation shadow color: near-black in light, true black in dark
    // (a dark UI needs a darker, tighter shadow to read as lift at all).
    Shadow = 86,
}
