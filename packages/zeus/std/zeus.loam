//! `zeus` — UI toolkit. Native Cocoa and WASM/Canvas2D run the same source.
//!
//! Widgets are `Box` / `Text` / `Button` / `Input` / `Grid` / `Overlay` /
//! `Scroll` / `Svg` / `If` / `Each` / `For` / `VirtualList` / `VirtualTable` /
//! `App`. Hierarchy is a trailing block. Lists: `zeus.signal([]T {})` +
//! `For` / `VirtualList` + `push_item` / `insert_item`. Windowed lists
//! (`VirtualList`, `For(..., row_h)`, `VirtualTable`) render visible rows
//! only; table rows and columns are structs.
//!
//! Reactivity is fine-grained, and the whole model is five rules:
//!
//!   1. A `signal` is a value with `get` / `set`. Reading one inside a
//!      reactive scope subscribes that scope to it — dependencies are
//!      discovered, never declared. `peek` reads without subscribing.
//!   2. An `effect` runs once, then re-runs whenever a signal it read
//!      changes. Effects are the edges of the graph.
//!   3. A `computed` (`computed_str` / `computed_bool`) is a cached
//!      derivation: it recalculates only when its own inputs change, and
//!      because `set` is change-gated, a recompute landing on the same
//!      value propagates no further.
//!   4. Components disappear. A widget fn is a *setup* function: it runs
//!      once, wires bindings to signals, and is never called again. There
//!      is no render loop and no component re-execution.
//!   5. Updates are surgical. Every dynamic prop (`Text("n = {{n.get()}}")`,
//!      `Image(photo.get())`) is its own effect over one node attribute, so a
//!      `set` repaints exactly the attributes that read it — no virtual
//!      DOM, no diffing, no tree walk.
//!
//! Every widget is a `Component`: `slot` (parent stack), `bind`, `visible`,
//! press, then attach. Trailing blocks are `slot`. Recipes extend `Comp` /
//! `Box` — they do not call `ui_push` / `bind` / `show` themselves.
//! Named props fill a last-param struct. Restyle without forking by passing
//! the style prop straight to the widget — `Button("Go", radius = 4)`,
//! `Card(padding = 12)`, `Chip("pill", TINT.Ok, radius = 6)`. `Button` /
//! `Card` / `Chip` / `Comp` / `IconButton` / `Badge` / `Alert` / `Field` /
//! `TextInput` all take the same twelve: `background`, `color`, `radius`,
//! `padding`, `padding_x`, `padding_y`, `width`, `height`, `font`, `border`,
//! `border_color`, `spacing`. Write them as plain data — `radius = 4`,
//! `background = paper()`. Text is a thunk: write `Text("n = {{n.get()}}")`
//! and the compiler lifts the expression, so a signal read inside it
//! repaints just that label. (`Text(|| "{{n.get()}}")` says the same
//! thing by hand.) Closures are for events: `on_click = fn() => ...`.
//! Omit a prop and the recipe's own value stands.
//! `Comp` is the function-widget primitive (`bind` / `visible` / `press` /
//! slot). No `View` trait — write `fn MyThing(p: MyProps)` and call `Comp`.
//! One UI-scale knob (`set_scale` percent) scales type and control chrome.
//! It is applied centrally, where a prop lands on a node, so widgets and
//! callers alike write plain design px — nothing calls a scale helper.
//! It is the identity at 100, so goldens hold at 1.0.
//! `Button` paints the themed chrome when you pass `look = LOOK.*` and
//! `size = SIZE.*`; without them it is a plain clickable label whose
//! background / color / width / height / `enabled` / `on_click` come from
//! the props. Keyboard: every click target is a tab stop; Tab walks the
//! focus ring in document order (Shift-Tab back), Enter/Space activate, and
//! the focused control paints a 2px ring (keyboard focus only — pointer
//! clicks clear it).
//!
//! Example:
//! ```
//! import "std:zeus"
//!
//! fn main() {
//!     let n = zeus.signal(0)
//!     zeus.App("Count", fn() {
//!         zeus.Box(align_direction = DIRECTION.Column, padding = 16, spacing = 8) {
//!             zeus.Text("Count", font = 22)
//!             zeus.Text("{{n.get()}}", font = 28)
//!             zeus.Box(align_direction = DIRECTION.Row, spacing = 8) {
//!                 zeus.Button("-", look = zeus.LOOK.Ghost, size = zeus.SIZE.Md,
//!                             on_click = fn() => n.set(n.get() - 1))
//!                 zeus.Button("+", look = zeus.LOOK.Solid, size = zeus.SIZE.Md,
//!                             on_click = fn() => n.set(n.get() + 1))
//!             }
//!         }
//!     })
//! }
//! ```
//!
//! `zeus.App(title, build)` is the entry: retained tree, view size from
//! the host (`window_size`); pass trailing `width`/`height` only to pin a
//! macOS/wasm window. Per-frame rebuild is `zeus.view` / `zeus.app`.
//! Hide live nodes with `If` / `show` (`Signal<int>` 0/1). `Box.show` is
//! the bool-thunk form of the same flag. Internals: `packages/zeus/std/zeuscore/*.loam`.
//! C is host FFI (`platform.loam`). `Node` is `{ id: int }`.
//! See `docs/boundary.md`. `ZEUS_HEADLESS=1` layouts once and exits.

import "zeuscore/geometry.loam"
import "zeuscore/platform.loam"
import "zeuscore/arena.loam"
import "zeuscore/layout.loam"
import "zeuscore/metrics.loam"
import "zeuscore/scene.loam"
import "zeuscore/input.loam"
import "zeuscore/track.loam"
import "std:async"
import "std:fmt"

/// Button variants, named after the fill they carry. `Solid` is the
/// `default` (primary) variant, `Soft` is `secondary`, `Danger` is
/// `destructive`, and `Link` is text-only. Gallery rows read
/// Primary / Secondary / Outline / Ghost / Destructive / Link.
enum LOOK {
    Solid = 0,
    Soft = 1,
    Outline = 2,
    Ghost = 3,
    Danger = 4,
    Link = 5,
}

/// Button sizes, by control height: Sm 32px, Md 36px, Lg 40px.
enum SIZE {
    Sm = 0,
    Md = 1,
    Lg = 2,
}

/// Status tints for chips, badges, stats, meters.
enum TINT {
    Ink = 0,
    Ok = 1,
    Mute = 2,
    Dim = 3,
    Danger = 4,
    Warn = 5,
}

fn tint_of(kind: int) -> string {
    match kind {
        TINT.Ok => { return ok() }
        TINT.Mute => { return mute() }
        TINT.Dim => { return dim() }
        TINT.Danger => { return danger() }
        TINT.Warn => { return warn() }
        _ => { return ink() }
    }
}

/// A widget in the tree. Copy handle (`id`).
struct Node {
    /// Slot in the engine arena. Do not construct by hand; use `Box` / `Text`.
    id: int,
}

/// Opaque reactive cell. Copy handle (`id`). `T` must be Copy (`int`,
/// `string`, `float`, `bool`, `[]U` when `U` is Copy, or a Copy struct).
///
/// ```
/// let n = zeus.signal(0)
/// n.set(n.get() + 1)
/// ```
struct Signal<T> {
    id: int,
}

fn empty_view() -> Node {
    return Node { id: 0 }
}

let mut has_view: int = 0
let mut view_fn: fn() -> Node = empty_view

/// Wrap a raw arena slot as a `Node`. Ids are the only thing the engine
/// stores, so every allocator hands one back through here rather than
/// letting callers build a `Node` literal and desync from the arena.
fn node_handle(id: int) -> Node {
    return Node { id: id }
}

/// Wrap a raw arena slot as a `Signal<int>`. Same reason as `node_handle`:
/// the engine speaks ids, the API speaks handles.
fn signal_handle(id: int) -> Signal<int> {
    return Signal { id: id }
}

fn raw_init() {
    arena.ensure()
}

fn open_window(title: string, width: int, height: int) {
    arena.ensure()
    arena.win_w = width
    arena.win_h = height
    platform.plat_set_window(title, width, height)
}

fn raw_run() {
    arena.ensure()
    if platform.plat_headless() != 0 {
        engine_layout(arena.win_w, arena.win_h)
        return
    }
    platform.plat_run()
}

fn init() {
    raw_init()
    // Theme slots must exist before anything paints: a node stores a role,
    // and the paint pass resolves it against the palette registered here.
    ensure_role_colors()
}

/// Open a native window. Sizes are CSS-like points, not pixels.
/// Prefer `zeus.App(...)` over calling this alone.
fn window(title: string, width: int, height: int) {
    init()
    open_window(title, width, height)
}

/// Host view size in points: browser canvas, or the native content view.
struct WindowSize {
    width: int,
    height: int,
}

fn window_size() -> WindowSize {
    return WindowSize {
        width: platform.plat_view_width(),
        height: platform.plat_view_height(),
    }
}

/// Host process memory in KB for diagnostics UI: Apple phys_footprint
/// (Xcode's memory-gauge number), Linux/Android resident set, live wasm
/// heap on the web host (0 = unknown).
fn memory_kb() -> int {
    arena.ensure()
    return platform.plat_mem_kb()
}

/// Enter the event loop with `node` as the tree root.
/// `ZEUS_HEADLESS=1` layouts once and exits (tests). Prefer `zeus.App`.
fn run(node: Node) {
    init()
    arena.root_id = node.id
    raw_run()
}

/// GPUI-style: each frame rebuilds the element tree from signals.
/// Omit this and the tree stays retained (the `App` mode).
fn view(build: fn() -> Node) {
    init()
    view_fn = build
    has_view = 1
}

/// Open a window, install `build` as the per-frame view, and run.
/// Rebuilds the tree every layout. Prefer `zeus.App` for a retained tree.
///
/// Example:
/// ```
/// zeus.app("Demo", 400, 300, || {
///     zeus.Text("frame")
/// })
/// ```
fn app(title: string, width: int, height: int, build: fn() -> Node) {
    window(title, width, height)
    view(build)
    init()
    raw_run()
}

// --- signals (live Copy state) ---

/// Allocate a live cell. `T` is inferred from `value`.
///
/// Example:
/// ```
/// let count = zeus.signal(0)
/// zeus.Button("+", on_click = fn() => count.set(count.get() + 1))
/// ```
/// Allocations made while a `For` / `refit` rebuild is running are owned by
/// that host (the C alloc hook records them) and are freed when the host
/// rebuilds or is torn down, so builders that create state do not grow the
/// signal arena.
fn signal<T>(value: T) -> Signal<T> {
    arena.ensure()
    Signal { id: __sig_push(value) }
}

/// Read the current value of `sig`. Reading inside a reactive scope (an
/// `effect`, a `computed`, or the thunk behind any widget prop) records
/// `sig` as a dependency of that scope, so a later `set` re-runs it.
/// Call as `sig.get()`.
fn get<T>(sig: Signal<T>) -> T {
    arena.ensure()
    track.note_read(sig.id)
    __sig_load(sig.id)
}
/// Write `value` into `sig`, then re-run every reactive scope that read it.
/// Writing the value it already holds is a no-op: nothing is notified, so
/// derivations built on `sig` do not recompute. Call as `sig.set(value)`.
fn set<T>(sig: Signal<T>, value: T) {
    arena.ensure()
    __sig_store(sig.id, value)
}

/// Read `sig` *without* subscribing the enclosing scope to it. Use when an
/// effect needs the current value but must not re-run when it changes —
/// notably read-modify-write (`c.set(c.peek() + 1)` inside an effect).
fn peek<T>(sig: Signal<T>) -> T {
    arena.ensure()
    __sig_load(sig.id)
}

/// Run `body` with dependency tracking suspended: signals read inside it
/// become dependencies of nothing. Writes still notify as usual.
fn untrack(body: fn()) {
    track.mute_begin()
    body()
    track.mute_end()
}

// --- unstyled allocators ---
/// Kinds: 1 box/row/col, 2 grid, 3 label, 4 button, 5 spacer, 6 progress,
/// 7 toggle, 8 check, 9 overlay, 10 input, 11 scroll, 12 svg, 13 slider.

fn raw_row() -> Node {
    let id = arena.alloc_node(1)
    arena.nodes[id].dir = 0
    return node_handle(id)
}
fn raw_col() -> Node {
    let id = arena.alloc_node(1)
    arena.nodes[id].dir = 1
    return node_handle(id)
}
fn raw_box() -> Node {
    return node_handle(arena.alloc_node(1))
}
fn raw_label(text: string) -> Node {
    let id = arena.alloc_node(3)
    arena.nodes[id].text = text
    return node_handle(id)
}
fn raw_button(text: string) -> Node {
    let id = arena.alloc_node(4)
    arena.nodes[id].text = text
    return node_handle(id)
}
fn raw_spacer() -> Node {
    return node_handle(arena.alloc_node(5))
}
fn raw_progress() -> Node {
    return node_handle(arena.alloc_node(6))
}
fn raw_slider() -> Node {
    return node_handle(arena.alloc_node(13))
}
fn raw_toggle() -> Node {
    return node_handle(arena.alloc_node(7))
}
fn raw_check(markup: string) -> Node {
    let id = arena.alloc_node(8)
    arena.nodes[id].text = markup
    return node_handle(id)
}
fn raw_overlay() -> Node {
    let id = arena.alloc_node(9)
    arena.nodes[id].pos = 1
    arena.nodes[id].enter_fade = 1
    return node_handle(id)
}
fn raw_input(placeholder: string) -> Node {
    let id = arena.alloc_node(10)
    arena.nodes[id].text = placeholder
    arena.nodes[id].focusable = 1
    arena.nodes[id].capture_text = 1
    return node_handle(id)
}
fn raw_scroll() -> Node {
    let id = arena.alloc_node(11)
    arena.nodes[id].dir = 1
    arena.nodes[id].overflow = 2
    return node_handle(id)
}
fn raw_svg(markup: string) -> Node {
    let id = arena.alloc_node(12)
    arena.nodes[id].text = markup
    return node_handle(id)
}
fn raw_image(src: string) -> Node {
    let id = arena.alloc_node(14)
    arena.nodes[id].text = src
    return node_handle(id)
}
fn raw_grid(columns: int, gap: int) -> Node {
    let id = arena.alloc_node(2)
    arena.nodes[id].grid_cols = u16(columns)
    arena.nodes[id].gap = u16(gap)
    return node_handle(id)
}
fn raw_hover(node: Node, sig: Signal<int>) -> Node {
    arena.nodes[node.id].hover_sig = sig.id
    return node
}

/// Text currently in an input (typed buffer, else placeholder).
fn input_value(node: Node) -> string {
    return arena.input_shown(node.id)
}

/// Replace the typed buffer for `node`. No-op if it is not an input.
fn set_input(node: Node, text: string) -> Node {
    let mut slot = arena.nodes[node.id].edit_slot
    if slot < 0 {
        arena.stamp_edits()
        slot = arena.nodes[node.id].edit_slot
    }
    if slot >= 0 {
        platform.plat_edit_set(slot, text)
    }
    return node
}

// --- tree ---

/// Intern a handler or thunk, and record it as owned by the open rebuild
/// scope if there is one. A `For`/`refit` rebuild interns fresh closures per
/// row; when the host is torn down the recorded ids are freed and recycled,
/// so streaming lists do not leak handler envs.
fn intern_fn(h: fn()) -> int {
    let id = platform.plat_intern_fn(h)
    arena.record_intern(id, arena.scope_node)
    return id
}

fn intern_int(h: fn() -> int) -> int {
    let id = platform.plat_intern_int_fn(h)
    arena.record_intern(id, arena.scope_node)
    return id
}

fn intern_bool(h: fn() -> bool) -> int {
    let id = platform.plat_intern_bool_fn(h)
    arena.record_intern(id, arena.scope_node)
    return id
}

fn intern_str(h: fn() -> string) -> int {
    let id = platform.plat_intern_str_fn(h)
    arena.record_intern(id, arena.scope_node)
    return id
}

/// Attach `node` under `parent`. Used by `ui_emit` for trailing blocks.
fn child(parent: Node, node: Node) -> Node {
    arena.ensure()
    push(arena.nodes[parent.id].kids, node.id)
    arena.nodes[node.id].parent = parent.id
    return parent
}

/// Run `handler` now and again whenever a `Signal` it `get`s changes.
/// The closure only updates paint state on existing nodes — it must not
/// call `child` or rebuild the tree.
fn styled(node: Node, handler: fn()) -> Node {
    arena.ensure()
    let eid = track.alloc(intern_fn(handler), node.id)
    track.run(eid)
    return node
}

fn root(node: Node) -> Node {
    arena.ensure()
    arena.root_id = node.id
    return node
}

// --- style ---
/// Field writers used by `Box` / `apply_int`. Not app-facing.

fn grow(node: Node, weight: int) -> Node {
    arena.nodes[node.id].grow = weight
    return node
}
fn shrink(node: Node, weight: int) -> Node {
    arena.nodes[node.id].shrink = weight
    return node
}

/// Inset all four edges. Padding lives on the node rather than on a wrapper
/// box so a widget stays one node and layout stays one pass.
fn set_padding(node: Node, all: int) -> Node {
    arena.nodes[node.id].pad = u16(all)
    arena.nodes[node.id].pad_t = u16(all)
    arena.nodes[node.id].pad_r = u16(all)
    arena.nodes[node.id].pad_b = u16(all)
    arena.nodes[node.id].pad_l = u16(all)
    return node
}
/// Inset left and right only — the common case for control chrome, where
/// horizontal breathing room is set independently of height.
fn set_padding_x(node: Node, px: int) -> Node {
    arena.nodes[node.id].pad_l = u16(px)
    arena.nodes[node.id].pad_r = u16(px)
    return node
}
/// Inset top and bottom only, the vertical half of `set_padding_x`.
fn set_padding_y(node: Node, py: int) -> Node {
    arena.nodes[node.id].pad_t = u16(py)
    arena.nodes[node.id].pad_b = u16(py)
    return node
}
/// Inset one edge. The per-edge setters exist so a recipe can override a
/// single side without restating the other three.
fn set_padding_top(node: Node, px: int) -> Node {
    arena.nodes[node.id].pad_t = u16(px)
    return node
}
/// Inset one edge; see `set_padding_top`.
fn set_padding_right(node: Node, px: int) -> Node {
    arena.nodes[node.id].pad_r = u16(px)
    return node
}
/// Inset one edge; see `set_padding_top`.
fn set_padding_bottom(node: Node, px: int) -> Node {
    arena.nodes[node.id].pad_b = u16(px)
    return node
}
/// Inset one edge; see `set_padding_top`.
fn set_padding_left(node: Node, px: int) -> Node {
    arena.nodes[node.id].pad_l = u16(px)
    return node
}
fn margin(node: Node, all: int) -> Node {
    arena.nodes[node.id].m_t = all
    arena.nodes[node.id].m_r = all
    arena.nodes[node.id].m_b = all
    arena.nodes[node.id].m_l = all
    return node
}
fn marginX(node: Node, px: int) -> Node {
    arena.nodes[node.id].m_l = px
    arena.nodes[node.id].m_r = px
    return node
}
fn marginY(node: Node, py: int) -> Node {
    arena.nodes[node.id].m_t = py
    arena.nodes[node.id].m_b = py
    return node
}
fn marginTop(node: Node, px: int) -> Node {
    arena.nodes[node.id].m_t = px
    return node
}
fn marginRight(node: Node, px: int) -> Node {
    arena.nodes[node.id].m_r = px
    return node
}
fn marginBottom(node: Node, px: int) -> Node {
    arena.nodes[node.id].m_b = px
    return node
}
fn marginLeft(node: Node, px: int) -> Node {
    arena.nodes[node.id].m_l = px
    return node
}
fn border(node: Node, width: int) -> Node {
    // A negative width is the "unset" sentinel; a non-positive width means no
    // border, so it maps to 0 rather than a u16 trap.
    if width > 0 {
        arena.nodes[node.id].border_w = u16(width)
    } else {
        arena.nodes[node.id].border_w = 0
    }
    return node
}
fn border_color(node: Node, rgb: int) -> Node {
    arena.nodes[node.id].border_c = rgb
    return node
}

/// Space between children. Gap belongs to the parent, not to each child's
/// margin, so adding or removing a child cannot leave a stray edge gap.
fn set_spacing(node: Node, g: int) -> Node {
    arena.nodes[node.id].gap = u16(g)
    return node
}
/// Row-axis gap for wrapped and grid layouts, where the two axes need
/// different spacing and one `set_spacing` cannot express it.
fn set_spacing_row(node: Node, g: int) -> Node {
    arena.nodes[node.id].gap_row = u16(g)
    return node
}
/// Column-axis gap; the other half of `set_spacing_row`.
fn set_spacing_col(node: Node, g: int) -> Node {
    arena.nodes[node.id].gap_col = u16(g)
    return node
}

/// Default node width is 100% of the parent. `.set_width(px)` pins a pixel width
/// and clears the percentage. `.set_width(-1)` restores the 100% default.
fn set_width(node: Node, px: int) -> Node {
    if px < 0 {
        arena.nodes[node.id].ew = -1
        arena.nodes[node.id].w_pct = 100
    } else {
        arena.nodes[node.id].ew = px
        arena.nodes[node.id].w_pct = -1
    }
    return node
}
/// Pin a pixel height, clearing any percentage. The chaining form of the
/// `height` prop, for code that already holds a `Node` (recipes, engine
/// paths) and cannot go back through a props struct.
fn set_height(node: Node, px: int) -> Node {
    arena.nodes[node.id].eh = px
    return node
}

/// Zero basis: the node's measured content no longer sets its row slot width;
/// `grow` then divides the whole free line evenly. This is the table recipe —
/// header labels and row cells all use `set_flex_basis_zero(...).grow(1)`, so every column
/// boundary comes from the row width alone, not from text lengths. Cells that
/// must keep a fixed pixel width use `.set_width(px)` instead.
fn set_flex_basis_zero(node: Node) -> Node {
    arena.nodes[node.id].w_pct = 0
    return node
}
/// `.set_width(px).set_height(px)` in one call. Named `size_px`, not `size`: themed widgets
/// expose `.size()` for the sm/md/lg token, and two chain methods sharing a
/// name and a `(Node, int)` shape resolve by import order — which is how
/// `.size(ui.sm())` once silently became a 0x0 box. The `_px` suffix also
/// keeps the unit at the call site, next to the themed token form.
fn size_px(node: Node, px: int) -> Node {
    return node.set_width(px).set_height(px)
}
fn width_pct(node: Node, pct: int) -> Node {
    arena.nodes[node.id].ew = -1
    arena.nodes[node.id].w_pct = i8(pct)
    return node
}
fn height_pct(node: Node, pct: int) -> Node {
    arena.nodes[node.id].h_pct = i8(pct)
    return node
}
/// Floor the width. Min/max bounds are how a flexible child stays readable
/// when its parent shrinks, without giving up `grow`.
fn set_min_width(node: Node, px: int) -> Node {
    arena.nodes[node.id].min_w = px
    return node
}
/// Cap the width, so a growing child cannot run past a comfortable measure.
fn set_max_width(node: Node, px: int) -> Node {
    arena.nodes[node.id].max_w = px
    return node
}
/// Floor the height; the vertical counterpart of `set_min_width`.
fn set_min_height(node: Node, px: int) -> Node {
    arena.nodes[node.id].min_h = px
    return node
}
/// Cap the height, so scrollable content clips instead of stretching.
fn set_max_height(node: Node, px: int) -> Node {
    arena.nodes[node.id].max_h = px
    return node
}
fn aspect(node: Node, aw: int, ah: int) -> Node {
    arena.nodes[node.id].aspect_w = aw
    arena.nodes[node.id].aspect_h = ah
    return node
}

fn flex_row(node: Node) -> Node {
    if int(arena.nodes[node.id].kind) != 2 {
        if int(arena.nodes[node.id].kind) != 9 {
            if int(arena.nodes[node.id].kind) != 11 {
                arena.nodes[node.id].kind = 1
            }
        }
    }
    arena.nodes[node.id].dir = 0
    arena.nodes[node.id].reverse = 0
    return node
}
fn flex_col(node: Node) -> Node {
    if int(arena.nodes[node.id].kind) != 2 {
        if int(arena.nodes[node.id].kind) != 9 {
            if int(arena.nodes[node.id].kind) != 11 {
                arena.nodes[node.id].kind = 1
            }
        }
    }
    arena.nodes[node.id].dir = 1
    arena.nodes[node.id].reverse = 0
    return node
}
fn flex_row_reverse(node: Node) -> Node {
    arena.nodes[node.id].dir = 0
    arena.nodes[node.id].reverse = 1
    return node
}
fn flex_col_reverse(node: Node) -> Node {
    arena.nodes[node.id].dir = 1
    arena.nodes[node.id].reverse = 1
    return node
}
fn flex_wrap(node: Node) -> Node {
    arena.nodes[node.id].wrap = 1
    return node
}
fn align_self(node: Node, mode: int) -> Node {
    arena.nodes[node.id].align_self = i8(mode)
    return node
}
fn span(node: Node, columns: int) -> Node {
    arena.nodes[node.id].span = u16(columns)
    return node
}

fn justify(node: Node, mode: int) -> Node {
    arena.nodes[node.id].justify = u8(mode)
    return node
}
fn align(node: Node, mode: int) -> Node {
    arena.nodes[node.id].align = u8(mode)
    return node
}

fn position(node: Node, mode: int) -> Node {
    arena.nodes[node.id].pos = u8(mode)
    return node
}
fn top(node: Node, px: int) -> Node {
    arena.nodes[node.id].pin_t = px
    return node
}
fn right(node: Node, px: int) -> Node {
    arena.nodes[node.id].pin_r = px
    return node
}
fn bottom(node: Node, px: int) -> Node {
    arena.nodes[node.id].pin_b = px
    return node
}
fn left(node: Node, px: int) -> Node {
    arena.nodes[node.id].pin_l = px
    return node
}
fn z_index(node: Node, z: int) -> Node {
    arena.nodes[node.id].z_index = i16(z)
    return node
}

/// Fill color as a packed rgb int. Takes an int, not a string, because it
/// is the post-parse form the scene writes — call sites pass `"#rrggbb"`
/// through the `background` prop and `parse_hex_color` converts once.
fn set_background(node: Node, rgb: int) -> Node {
    arena.nodes[node.id].bg = rgb
    return node
}

/// Second stop of a vertical gradient (`bg` → `bg2`). Solid fill when unset.
fn set_background_end(node: Node, rgb: int) -> Node {
    arena.nodes[node.id].bg2 = rgb
    return node
}
/// Foreground (text and glyph) color as a packed rgb int; the `color` prop
/// is the string-facing form.
fn set_color(node: Node, rgb: int) -> Node {
    arena.nodes[node.id].fg = rgb
    return node
}
fn radius(node: Node, px: int) -> Node {
    arena.nodes[node.id].radius = u16(px)
    return node
}
fn opacity(node: Node, pct: int) -> Node {
    arena.nodes[node.id].opacity = i16(pct)
    return node
}
fn overflow(node: Node, mode: int) -> Node {
    arena.nodes[node.id].overflow = u8(mode)
    return node
}
fn font(node: Node, px: int) -> Node {
    arena.nodes[node.id].font = u16(px)
    return node
}

/// Rotate a text node `deg` clockwise on screen around its top-left corner
/// (0 = horizontal). Used for chart axis labels that must not collide.
fn text_rot(node: Node, deg: int) -> Node {
    arena.nodes[node.id].text_rot = u16(deg)
    return node
}

// --- reactivity ---
/// `show` / `show_eq` / `show_ne` / `show_ge` / `show_le` hide a node from
/// layout when the predicate is false.

fn bind(label: Node, sig: Signal<int>) -> Node {
    arena.nodes[label.id].bind_sig = sig.id
    return label
}

fn click() -> int {
    return 1
}

/// Attach a handler for an engine event code. The generic form behind
/// `on_click`; event codes keep the arena free of per-event fields.
fn on_event(node: Node, event: int, handler: fn()) -> Node {
    if event == 1 {
        arena.nodes[node.id].click_fn = intern_fn(handler)
    }
    return node
}

/// Click handler. `n.on_click(h)` is `n.on(zeus.click(), h)`.
fn on_click(node: Node, handler: fn()) -> Node {
    return on_event(node, click(), handler)
}

fn show(node: Node, sig: Signal<int>) -> Node {
    arena.nodes[node.id].show_sig = sig.id
    arena.nodes[node.id].show_mode = 0
    return node
}
fn show_eq(node: Node, sig: Signal<int>, value: int) -> Node {
    arena.nodes[node.id].show_sig = sig.id
    arena.nodes[node.id].show_mode = 1
    arena.nodes[node.id].show_val = value
    return node
}
fn show_ne(node: Node, sig: Signal<int>, value: int) -> Node {
    arena.nodes[node.id].show_sig = sig.id
    arena.nodes[node.id].show_mode = 2
    arena.nodes[node.id].show_val = value
    return node
}
// --- keyboard ---
/// A chord on a focused node resolves to a named action; a handler on that
/// same node writes a signal. App remaps (`map_key` / `remap_key`) still use
/// the action name, so a shortcut can move without the Component changing.
/// Context is the family of the first action (`button.press` → `button`).
///
/// mode: 0 inc, 1 toggle, 2 set, 3 add — the same codes on_click_* uses.

/// Action name for a `key` prop: the caller's, else one derived from the
/// chord. The `key.` family becomes the keymap context, so every
/// prop-bound shortcut shares one context and the innermost focused node
/// wins — which is what "the same chord on two widgets" should do.
fn key_action_name(spec: string, action: string) -> string {
    if action.len > 0 {
        return action
    }
    return "key.{{spec}}"
}

/// Install a `key` prop: map the chord to an action, then bind the action to
/// `handler_fn` (an interned id). Node-scoped unless `is_global`.
fn install_key(node: Node, spec: string, action: string, handler_fn: int,
               is_global: bool) -> Node {
    if spec.len == 0 {
        return node
    }
    if handler_fn <= 0 {
        return node
    }
    let act = key_action_name(spec, action)
    match is_global {
        true => {
            // ctx 0 = matches whatever holds focus.
            platform.plat_map_key(spec, act, 0)
            on_action_global(act, signal_handle(0), 5, handler_fn)
        }
        _ => {
            key(node, spec, act)
            on_action(node, act, signal_handle(0), 5, handler_fn)
        }
    }
    return node
}

/// Repaint selectable chrome as `is_on` flips. Style props are plain data,
/// evaluated once at build, so a fill that tracks a selection has to be an
/// effect — this is the shared one, so every selectable widget (tab, radio,
/// toggle, nav item, page number) behaves identically. `label` may be
/// `empty_view()` when there is no text to re-ink. The colors are role
/// tokens, so light/dark still resolves at paint.
fn selected_chrome(node: Node, label: Node, is_on: fn() -> bool,
                   on_bg: string, off_bg: string,
                   on_fg: string, off_fg: string) -> Node {
    let fid = intern_bool(is_on)
    let nid = node.id
    let lid = label.id
    styled(node, || {
        let mut bg = off_bg
        let mut fg = off_fg
        if platform.plat_invoke_bool_fn(fid) != 0 {
            bg = on_bg
            fg = on_fg
        }
        if bg.len > 0 {
            apply_str(nid, SET.Background, bg)
        }
        if lid > 0 {
            if fg.len > 0 {
                apply_str(lid, SET.Color, fg)
            }
        }
    })
    return node
}

/// Install a widget's `key` prop. Every recipe calls this on the node it
/// just built, which is what makes a shortcut available on any widget
/// instead of only the ones that shipped a bespoke helper.
fn apply_key(node: Node, spec: string, action: string, handler: fn(),
             handler_set: bool, is_global: bool) -> Node {
    if spec.len == 0 {
        return node
    }
    let mut kfn = 0
    match handler_set {
        true => { kfn = intern_fn(handler) }
        _ => { kfn = arena.nodes[node.id].click_fn }
    }
    return install_key(node, spec, action, kfn, is_global)
}

fn key_context(node: Node, name: string) -> Node {
    arena.nodes[node.id].key_ctx = platform.plat_key_intern(name)
    return node
}
fn focusable(node: Node) -> Node {
    arena.nodes[node.id].focusable = 1
    return node
}
fn capture_text(node: Node) -> Node {
    arena.nodes[node.id].capture_text = 1
    arena.nodes[node.id].focusable = 1
    return node
}
fn on_action(node: Node, action: string, sig: Signal<int>, mode: int, value: int) -> Node {}
fn on_action_global(action: string, sig: Signal<int>, mode: int, value: int) {}

/// Step `sig` by `delta`, clamped to lo..hi — arrow navigation over a range.
fn on_range(node: Node, action: string, sig: Signal<int>, delta: int, lo: int, hi: int) -> Node {}
fn map_key(spec: string, action: string, ctx: string) {}
fn remap_key(spec: string, action: string, ctx: string) {}

/// Chord → action on this node. The action family (`button.press` → `button`)
/// is the keymap context; `key_context` is only needed to override that name.
/// Implies `.focusable()` — a node with a key binding needs focus to receive
/// it, so components don't chain both.
fn key(node: Node, spec: string, action: string) -> Node {
    let mut ctx = arena.nodes[node.id].key_ctx
    if ctx == 0 {
        ctx = platform.plat_key_intern_action(action)
        arena.nodes[node.id].key_ctx = ctx
    }
    if ctx != 0 {
        platform.plat_map_key(spec, action, ctx)
    }
    arena.nodes[node.id].focusable = 1
    return node
}

fn on_key_set(node: Node, action: string, sig: Signal<int>, value: int) -> Node {
    return on_action(node, action, sig, 2, value)
}

fn on_key_add(node: Node, action: string, sig: Signal<int>, delta: int) -> Node {
    return on_action(node, action, sig, 3, delta)
}

fn on_key_toggle(node: Node, action: string, sig: Signal<int>) -> Node {
    return on_action(node, action, sig, 1, 0)
}

fn on_key_fn(node: Node, action: string) -> Node {
    return on_action(node, action, signal_handle(0), 5, arena.nodes[node.id].click_fn)
}

fn global_key_set(action: string, sig: Signal<int>, value: int) {
    on_action_global(action, sig, 2, value)
}

fn show_ge(node: Node, sig: Signal<int>, value: int) -> Node {
    arena.nodes[node.id].show_sig = sig.id
    arena.nodes[node.id].show_mode = 3
    arena.nodes[node.id].show_val = value
    return node
}
fn show_le(node: Node, sig: Signal<int>, value: int) -> Node {
    arena.nodes[node.id].show_sig = sig.id
    arena.nodes[node.id].show_mode = 4
    arena.nodes[node.id].show_val = value
    return node
}

fn hover(node: Node, sig: Signal<int>) -> Node {
    return raw_hover(node, sig)
}

fn pulse(node: Node) -> Node {
    arena.nodes[node.id].pulse = 1
    return node
}

fn hover_fade(node: Node) -> Node {
    arena.nodes[node.id].hover_fade = 1
    return node
}

fn hover_off(node: Node) -> Node {
    arena.nodes[node.id].hover_fade = -1
    return node
}

fn enter_fade(node: Node) -> Node {
    arena.nodes[node.id].enter_fade = 1
    return node
}
fn keys(node: Node, sig: Signal<int>, lo: int, hi: int) -> Node {
    return node.key("right", "slider.inc").key("left", "slider.dec").focusable().on_range("slider.inc", sig, 1, lo, hi).on_range("slider.dec", sig, -1, lo, hi)
}
fn keys_page(node: Node, sig: Signal<int>) -> Node {
    return node.key("right", "page.next").key("left", "page.prev").focusable().on_key_add("page.next", sig, 1).on_key_add("page.prev", sig, -1)
}

// --- flex constants (public; implemented in geometry) ---

fn flex_start() -> int {
    return geometry.flex_start()
}
fn flex_center() -> int {
    return geometry.flex_center()
}
fn flex_end() -> int {
    return geometry.flex_end()
}
fn flex_between() -> int {
    return geometry.flex_between()
}
fn flex_around() -> int {
    return geometry.flex_around()
}
fn flex_evenly() -> int {
    return geometry.flex_evenly()
}
fn flex_stretch() -> int {
    return geometry.flex_stretch()
}
fn pos_relative() -> int {
    return geometry.pos_relative()
}
fn pos_absolute() -> int {
    return geometry.pos_absolute()
}
fn overflow_visible() -> int {
    return geometry.overflow_visible()
}
fn overflow_hidden() -> int {
    return geometry.overflow_hidden()
}
fn overflow_scroll() -> int {
    return geometry.overflow_scroll()
}
fn overflow_auto() -> int {
    return geometry.overflow_auto()
}
fn rgb(r: int, g: int, b: int) -> int {
    return geometry.rgb(r, g, b)
}

fn center(node: Node) -> Node {
    return node.justify(flex_center()).align(flex_center())
}

fn appearance() -> Signal<int> {
    arena.ensure()
    if arena.appearance_sid == 0 {
        let s = signal(0)
        arena.appearance_sid = s.id
    }
    return signal_handle(arena.appearance_sid)
}

fn theme(slot: int, light: int, dark: int) {
    arena.ensure()
    if slot < 0 {
        return
    }
    arena.theme_grow(slot)
    if slot < arena.theme_l.len {
        arena.theme_l[slot] = light
        arena.theme_d[slot] = dark
    }
}

/// Encode a theme role slot as a sentinel color. Widgets store the *role*,
/// not a resolved value, so flipping light/dark repaints without rebuilding
/// the tree — the paint pass resolves the slot each frame.
fn role_color(slot: int) -> int {
    if slot < 0 {
        return 0
    }
    return 2130706432 + slot
}

fn engine_key_apply(sid: int, mode: int, value: int, lo: int, hi: int) {
    arena.ensure()
    if mode == 5 {
        platform.plat_invoke_fn(value)
        return
    }
    if sid <= 0 {
        return
    }
    if sid >= arena.sigs.len {
        return
    }
    let mut next = arena.sigs[sid]
    if mode == 1 {
        if next == 0 {
            next = 1
        } else {
            next = 0
        }
    } else if mode == 2 {
        next = value
    } else if mode == 3 {
        next = next + value
    } else if mode == 4 {
        let mut vlo = lo
        let mut vhi = hi
        if vhi < vlo {
            let t = vlo
            vlo = vhi
            vhi = t
        }
        next = next + value
        if next < vlo {
            next = vlo
        }
        if next > vhi {
            next = vhi
        }
    } else {
        next = next + 1
    }
    arena.store_sig(sid, next)
}

fn refresh_lists() {
    let n = arena.nodes.len
    for i in 1..n {
        if arena.nodes[i].list_fn > 0 {
            platform.plat_invoke_fn(arena.nodes[i].list_fn)
        }
    }
}

fn virt_stale() -> int {
    let n = arena.nodes.len
    for i in 1..n {
        if arena.nodes[i].row_h > 0 {
            if arena.nodes[i].list_fn > 0 {
                let w = virt_window(i, arena.nodes[i].list_n, arena.nodes[i].row_h)
                if w.first != arena.nodes[i].list_lo {
                    return 1
                }
                if w.last != arena.nodes[i].list_hi {
                    return 1
                }
            }
        }
    }
    return 0
}

/// A refit host (chart, plot) whose measured width moved since its last
/// rebuild. Checked after the layout that measured it, so the refresh pass
/// rebuilds it with the width it will paint this very frame — no one-frame
/// lag and no empty band while a window is being resized.
fn refit_stale() -> int {
    let n = arena.nodes.len
    for i in 1..n {
        if arena.nodes[i].list_fn > 0 {
            if arena.nodes[i].w != arena.nodes[i].list_gen {
                return 1
            }
        }
    }
    return 0
}

fn engine_layout(width: int, height: int) {
    ensure_role_colors()
    // One frame of the async world first: steppers advance in-flight socket
    // state machines, then spawns and due timers fire. Callbacks set signals;
    // the rebuild and layout below paint their effect this very frame. Hosts
    // call this per frame (mac drawRect, web rAF, headless pump).
    async.tick()
    arena.physics_step()
    if has_view != 0 {
        arena.snapshot_focus()
        arena.snapshot_scroll()
        arena.reset_tree()
        platform.plat_key_reset()
        track.reset()
        let n = view_fn()
        arena.root_id = n.id
        arena.restore_scroll()
        arena.restore_focus()
        arena.stamp_edits()
    } else {
        arena.stamp_edits()
    }
    layout.layout(width, height)
    // Windowed lists size their window from the scroller's laid-out height,
    // and refit hosts (charts) rebuild when this frame's layout moved their
    // width. One refresh pass after layout covers both; the second pass
    // re-lays-out with the new rows / fresh chart width.
    if (virt_stale() != 0) || (refit_stale() != 0) {
        refresh_lists()
        layout.layout(width, height)
    }
}

fn engine_fill_focus() {
    arena.fill_focus_chain()
}

fn engine_focus_depth() -> int {
    return arena.chain_nodes.len
}

fn engine_focus_node(i: int) -> int {
    if i < 0 {
        return 0
    }
    if i >= arena.chain_nodes.len {
        return 0
    }
    return arena.chain_nodes[i]
}

fn engine_focus_ctx(i: int) -> int {
    if i < 0 {
        return 0
    }
    if i >= arena.chain_ctxs.len {
        return 0
    }
    return arena.chain_ctxs[i]
}

fn engine_focus_step(back: int) -> int {
    return arena.focus_step(back)
}

fn engine_focus_captures_text() -> int {
    return arena.focus_captures_text()
}

/// Node id that currently holds focus (0 = none). Stable across a keyed
/// reorder, because the row's node is moved rather than rebuilt.
fn engine_focus_id() -> int {
    return arena.focus_id
}

fn engine_key(key: int) -> int {
    return input.key(key)
}

/// Insert UTF-8 into the focused input (IME commit, paste). Headless tests
/// can call this instead of synthesizing one key per byte.
fn engine_insert(text: string) -> int {
    return input.insert_text(text)
}

/// IME composition overlay on the focused input. Empty clears the mark.
fn engine_marked(text: string) -> int {
    return input.mark_text(text)
}

fn engine_set_mods(mods: int) {
    arena.ev_mods = mods
}

fn engine_key_ev(key: int, mods: int) -> int {
    arena.ensure()
    arena.ev_mods = mods
    return platform.plat_key_ev(key, mods)
}

/// Key release, from hosts that deliver it. Runs the focused node's
/// `on_key_up`, then `on_key_press` — the down→up cycle.
fn engine_key_up(key: int, mods: int) -> int {
    arena.ensure()
    return input.key_handlers(key, mods, 1)
}

// --- engine trampolines ---
/// Cocoa calls these through zeus_plat.c (`yuga_zeus_engine_*`). Do not use
/// from app code; use `App`, clicks, and signals instead.

fn engine_paint() {
    scene.paint()
}

fn engine_step() -> int {
    let d = scene.step()
    // While an async op is in flight or a spawn waits, hosts must keep
    // drawing frames: only a frame's tick advances them. Coasting scroll
    // is the same: keep frames until velocity and overscroll settle.
    if async.busy() != 0 {
        return 1
    }
    if arena.phys_live() != 0 {
        return 1
    }
    if arena.anim_step() != 0 {
        return 1
    }
    return d
}

/// Milliseconds until the next async timer is due (0 = none; -1 = a spawn
/// waits). Native hosts that stop drawing when idle use this to schedule the
/// next frame exactly at the deadline. Coasts at ~60 fps while a scroller
/// is in motion.
fn engine_next_ms() -> int {
    if arena.phys_live() != 0 {
        return 16
    }
    if arena.anim_live() != 0 {
        return 16
    }
    return async.next_due()
}

/// Tween `sig` toward `to` over `ms` (60 fps steps). Anything bound to the
/// signal repaints each frame; `ms == 0` jumps. A new call retargets an
/// in-flight tween. While it runs the engine keeps producing frames (§2.8).
fn animate(sig: Signal<int>, to: int, ms: int) {
    arena.anim_to(sig.id, to, ms)
}

/// One headless host frame: async tick, rebuild + layout, then paint. Tests
/// use this instead of calling `engine_layout` by hand.
fn pump_frame() {
    engine_layout(arena.win_w, arena.win_h)
    engine_paint()
}

fn engine_click(px: int, py: int) -> int {
    return input.click(px, py)
}

fn click_id(id: int) -> int {
    let mut i = id
    while i > 0 {
        if arena.nodes[i].click_fn > 0 {
            let x = arena.nodes[i].x + arena.nodes[i].w / 2
            let y = arena.nodes[i].y + arena.nodes[i].h / 2
            return input.click(x, y)
        }
        i = arena.nodes[i].parent
    }
    let x = arena.nodes[id].x + arena.nodes[id].w / 2
    let y = arena.nodes[id].y + arena.nodes[id].h / 2
    return input.click(x, y)
}

/// Node id whose `text` or `a11y_label` equals `label` (tests, headless
/// hosts). 0 when nothing visible matches. Hidden nodes are skipped.
fn engine_find_text(label: string) -> int {
    let n = arena.nodes.len
    for i in 1..n {
        if arena.want_show(i) == 0 {
            continue
        }
        if fmt.eq(arena.nodes[i].text, label) {
            return i
        }
        if fmt.eq(arena.nodes[i].a11y_label, label) {
            return i
        }
    }
    return 0
}

/// Node id whose `a11y_role` equals `role` (tests, headless hosts); the
/// first match in tree order, 0 when none is visible.
fn engine_find_role(role: string) -> int {
    let n = arena.nodes.len
    for i in 1..n {
        if arena.want_show(i) == 0 {
            continue
        }
        if fmt.eq(arena.nodes[i].a11y_role, role) {
            return i
        }
    }
    return 0
}

let mut A11Y_out: []int = []int {}

fn a11y_push(s: string) {
    let mut i = 0
    while i < s.len {
        push(A11Y_out, s[i])
        i = i + 1
    }
}

fn a11y_num(v: int) {
    let mut x = v
    if x < 0 {
        push(A11Y_out, 45)
        x = 0 - x
    }
    if x == 0 {
        push(A11Y_out, 48)
        return
    }
    let mut buf = []int {}
    while x > 0 {
        push(buf, 48 + x % 10)
        x = x / 10
    }
    let mut k = buf.len
    while k > 0 {
        k = k - 1
        push(A11Y_out, buf[k])
    }
}

/// Serialize the visible **semantic tree** for an accessibility mirror (§2.3):
/// one `depth<TAB>role<TAB>label<TAB>x<TAB>y<TAB>w<TAB>h` line per node
/// carrying a role, a label, or visible text. Geometry lets a native host
/// place accessible frames; the web mirror uses role and label only. The UI
/// stays canvas — hosts relay this to a visually-hidden DOM on web, or to
/// `NSAccessibility` on native. A node with a label but no role is a `text`
/// node; the label falls back to its visible text.
fn engine_a11y_dump() -> string {
    A11Y_out = []int {}
    let n = arena.nodes.len
    let mut i = 1
    while i < n {
        if arena.want_show(i) != 0 {
            let role = arena.nodes[i].a11y_role
            let label = arena.nodes[i].a11y_label
            let txt = arena.nodes[i].text
            if role.len > 0 || label.len > 0 || txt.len > 0 {
                let mut r = role
                let mut l = label
                if l.len == 0 {
                    l = txt
                }
                if r.len == 0 {
                    r = "text"
                }
                let mut d = 0
                let mut p = arena.nodes[i].parent
                while p > 0 {
                    d = d + 1
                    p = arena.nodes[p].parent
                }
                a11y_num(d)
                push(A11Y_out, 9)
                a11y_push(r)
                push(A11Y_out, 9)
                a11y_push(l)
                push(A11Y_out, 9)
                a11y_num(arena.nodes[i].x)
                push(A11Y_out, 9)
                a11y_num(arena.nodes[i].y)
                push(A11Y_out, 9)
                a11y_num(arena.nodes[i].w)
                push(A11Y_out, 9)
                a11y_num(arena.nodes[i].h)
                push(A11Y_out, 10)
            }
        }
        i = i + 1
    }
    return string_from_bytes(A11Y_out)
}

/// Inspector dump of the retained tree (devtools §2.4): one
/// `id<TAB>parent<TAB>x<TAB>y<TAB>w<TAB>h<TAB>role<TAB>label` line per visible
/// node, in tree order. Geometry is what the last layout pass produced.
fn engine_tree_dump() -> string {
    A11Y_out = []int {}
    let n = arena.nodes.len
    let mut i = 1
    while i < n {
        if arena.want_show(i) != 0 {
            a11y_num(i)
            push(A11Y_out, 9)
            a11y_num(arena.nodes[i].parent)
            push(A11Y_out, 9)
            a11y_num(arena.nodes[i].x)
            push(A11Y_out, 9)
            a11y_num(arena.nodes[i].y)
            push(A11Y_out, 9)
            a11y_num(arena.nodes[i].w)
            push(A11Y_out, 9)
            a11y_num(arena.nodes[i].h)
            push(A11Y_out, 9)
            a11y_push(arena.nodes[i].a11y_role)
            push(A11Y_out, 9)
            let l = arena.nodes[i].a11y_label
            if l.len > 0 {
                a11y_push(l)
            } else {
                a11y_push(arena.nodes[i].text)
            }
            push(A11Y_out, 10)
        }
        i = i + 1
    }
    return string_from_bytes(A11Y_out)
}

/// Inspector dump of live signal values (devtools §2.4): one `id<TAB>value`
/// line per int-mirrored signal slot.
fn engine_signals_dump() -> string {
    A11Y_out = []int {}
    let n = arena.sigs.len
    let mut i = 0
    while i < n {
        a11y_num(i)
        push(A11Y_out, 9)
        a11y_num(arena.sigs[i])
        push(A11Y_out, 10)
        i = i + 1
    }
    return string_from_bytes(A11Y_out)
}

/// Restore signal values from an `engine_signals_dump()` snapshot. Returns how
/// many slots were applied. This is the hot-reload primitive (§2.5): save the
/// arena before a rebuild, restore after. Ids are positional, so the dev loop
/// should only restore when the new build's signal set still lines up.
fn engine_state_load(s: string) -> int {
    let mut i = 0
    let mut applied = 0
    while i < s.len {
        let mut id = 0
        let mut have_id = 0
        while i < s.len {
            let b = s[i]
            i = i + 1
            if b == 9 {
                break
            }
            if b == 10 {
                break
            }
            if b >= 48 {
                if b <= 57 {
                    id = id * 10 + (b - 48)
                    have_id = 1
                }
            }
        }
        let mut v = 0
        let mut vhave = 0
        let mut neg = 0
        while i < s.len {
            let b = s[i]
            if b == 10 {
                i = i + 1
                break
            }
            if b == 45 {
                neg = 1
            } else if b >= 48 {
                if b <= 57 {
                    v = v * 10 + (b - 48)
                    vhave = 1
                }
            }
            i = i + 1
        }
        if have_id == 1 {
            if vhave == 1 {
                if neg == 1 {
                    v = 0 - v
                }
                arena.store_sig(id, v)
                applied = applied + 1
            }
        }
    }
    return applied
}

/// Whether a node is currently shown by its own show binding (tests).
/// Hidden ancestors still hide it from paint and hit tests.
fn node_visible(id: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= arena.nodes.len {
        return 0
    }
    return arena.want_show(id)
}

/// Click the control whose label or `a11y_label` is `label`. Tests use this
/// instead of pixel coordinates.
fn engine_click_text(label: string) -> int {
    let id = engine_find_text(label)
    if id <= 0 {
        return 0
    }
    return click_id(id)
}

fn engine_scroll(px: int, py: int, dx: int, dy: int) -> int {
    return input.scroll(px, py, dx, dy)
}

/// Discrete scroll step (mouse wheel notch / web line wheel): applies the
/// delta with no momentum. Tests and hosts use this for input that must stop
/// exactly where it lands.
fn engine_scroll_step(px: int, py: int, dx: int, dy: int) -> int {
    return input.scroll_step(px, py, dx, dy)
}

fn engine_drag(px: int, py: int) -> int {
    return input.drag(px, py)
}

fn engine_mouseup() {
    input.mouseup()
}

fn engine_hover(px: int, py: int) -> int {
    return input.hover(px, py)
}

fn engine_over_button() -> int {
    return input.over_button()
}

/// CSS cursor name under the pointer: the most recently created node with an
/// explicit `cursor` wins (children outrank parents). "" = default arrow.
fn engine_cursor() -> string {
    return input.cursor_at()
}

/// Set a cursor name directly on any node (native thumbs have no props).
fn cursor(n: Node, s: string) -> Node {
    arena.nodes[n.id].cursor = s
    return n
}

fn draw_count() -> int {
    return scene.draws.len
}

/// Layout results for tests: the box of the node that matched
/// `engine_find_text`. Positions are window-space after the last layout.
fn node_x(id: int) -> int {
    return arena.nodes[id].x
}

/// A node's fill as the paint pass sees it: a stored role token resolved
/// against the current appearance. Tests use it to prove a theme switch
/// repaints without re-running any prop.
fn node_background_rgb(id: int) -> int {
    arena.ensure()
    return arena.paint_rgb(arena.nodes[id].bg)
}

/// Laid-out top edge of a node id. The id-based accessors exist for tests
/// and engine code that hold an id rather than a `Node`.
fn node_y(id: int) -> int {
    return arena.nodes[id].y
}

/// Laid-out width of a node id; see `node_y`.
fn node_width(id: int) -> int {
    return arena.nodes[id].w
}

/// Laid-out height of a node id; see `node_y`.
fn node_height(id: int) -> int {
    return arena.nodes[id].h
}

/// Parent id in the retained tree (0 = root). Tests walk scroll chains with this.
fn node_parent(id: int) -> int {
    return arena.nodes[id].parent
}

/// Engine kind: 11 is a scroll pane.
fn node_kind(id: int) -> int {
    return int(arena.nodes[id].kind)
}

/// Current vertical scroll offset of node `id` (tests, `scroll_to`).
fn node_scroll_y(id: int) -> int {
    return arena.nodes[id].scroll_y
}

/// Current horizontal scroll offset of node `id`.
fn node_scroll_x(id: int) -> int {
    return arena.nodes[id].scroll_x
}

/// Max vertical scroll of node `id` (`content - viewport`, 0 if no overflow).
fn node_scroll_max(id: int) -> int {
    return arena.scroll_max(id)
}

/// Live slot counts (diagnostics for tests). `nodes` includes dead slots
/// waiting to be recycled; `sigs` is the same for signals. A streaming `For`
/// that rebuilds without growing the tree keeps both constant.
fn arena_nodes() -> int {
    return arena.nodes.len
}

fn arena_sigs() -> int {
    return arena.sigs.len
}

/// Byte size of one arena node record (diagnostics for the Phase 11 layout
/// steps).
fn node_bytes() -> int {
    if arena.nodes.len == 0 {
        return 0
    }
    return __sizeof(arena.nodes[0])
}

/// Total bytes held by live arena node records.
fn arena_bytes() -> i64 {
    if arena.nodes.len == 0 {
        return 0
    }
    return i64(arena.nodes.len) * i64(__sizeof(arena.nodes[0]))
}

/// Byte size of one draw-list record (diagnostics for the Phase 11 layout
/// steps).
fn draw_op_bytes() -> int {
    if scene.draws.len == 0 {
        return 0
    }
    return __sizeof(scene.draws[0])
}

/// Total bytes held by the draw list at paint time.
fn draw_bytes() -> i64 {
    if scene.draws.len == 0 {
        return 0
    }
    return i64(scene.draws.len) * i64(__sizeof(scene.draws[0]))
}

/// Print the current draw list. The DRAW goldens diff this text, which is
/// why the format is stable and why paint order is deterministic.
fn dump_draw_list() {
    let n = scene.draws.len
    fmt.println("DRAW", n)
    for i in 0..n {
        let d = scene.draws[i]
        if d.kind == 0 {
            fmt.println("fill", d.x, d.y, d.w, d.h, d.rgb, d.radius)
        } else if d.kind == 1 {
            fmt.println("fill_a", d.x, d.y, d.w, d.h, d.rgb, d.alpha)
        } else if d.kind == 2 {
            fmt.println("text", d.x, d.y, d.rgb, d.font, d.text)
        } else if d.kind == 3 {
            fmt.println("text_int", d.x, d.y, d.value, d.rgb, d.font)
        } else if d.kind == 4 {
            fmt.println("text_wrap", d.x, d.y, d.w, d.text)
        } else if d.kind == 5 {
            fmt.println("svg", d.x, d.y, d.w, d.h, d.rgb)
        } else if d.kind == 6 {
            fmt.println("save")
        } else if d.kind == 7 {
            fmt.println("clip", d.x, d.y, d.w, d.h)
        } else if d.kind == 8 {
            fmt.println("restore")
        } else if d.kind == 9 {
            fmt.println("text_rot", d.x, d.y, d.rgb, d.font, d.w, d.text)
        } else if d.kind == 10 {
            fmt.println("image", d.x, d.y, d.w, d.h, d.alpha, d.radius, d.value)
        } else if d.kind == 11 {
            fmt.println("grad", d.x, d.y, d.w, d.h, d.rgb, d.value, d.radius)
        }
    }
}

fn snapshot(width: int, height: int, build: fn() -> Node) {
    window("zeus-snap", width, height)
    let n = build()
    root(n)
    engine_layout(width, height)
    engine_paint()
    dump_draw_list()
}


// --- declarative layer ---
//
// Components are plain `fn`s, hierarchy comes from trailing blocks, props are
// named arguments on a props struct, and every style prop is a thunk so a
// signal read inside it re-applies just that prop.

/// Layout direction for `align_direction`.
enum DIRECTION {
    Row = 0,
    Column = 1,
}

/// Cross-axis and main-axis alignment. Same codes the layout solver uses.
enum ALIGN {
    Start = 0,
    Center = 1,
    End = 2,
    Between = 3,
    Around = 4,
    Evenly = 5,
    Stretch = 6,
}

/// How `Image` maps the bitmap into its layout box: Stretch (default, may
/// distort), Contain (letterbox), Cover (crop to fill), None (intrinsic size).
enum IMAGE_FIT {
    Stretch = 0,
    Contain = 1,
    Cover = 2,
    None = 3,
}

/// The spacing scale, in points.
enum SPACE {
    None = 0,
    Exxxs = 2,
    Exxs = 6,
    Exs = 8,
    Xs = 12,
    Sm = 16,
    Md = 20,
    Lg = 24,
    Xl = 32,
    Xxl = 48,
    Xxxl = 62,
    Xxxxl = 72
}

/// Key codes as delivered by the hosts. `e.key == Key.K` is the spell.
enum Key {
    Backspace = 8,
    Tab = 9,
    Enter = 13,
    Escape = 27,
    Space = 32,
    A = 97,
    B = 98,
    C = 99,
    D = 100,
    E = 101,
    F = 102,
    G = 103,
    H = 104,
    I = 105,
    J = 106,
    K = 107,
    L = 108,
    M = 109,
    N = 110,
    O = 111,
    P = 112,
    Q = 113,
    R = 114,
    S = 115,
    T = 116,
    U = 117,
    V = 118,
    W = 119,
    X = 120,
    Y = 121,
    Z = 122,
    Left = 1000,
    Right = 1001,
    Up = 1002,
    Down = 1003,
    Home = 1004,
    End = 1005,
}

/// Pointer payload, staged by the engine and read inside a handler.
struct MouseEvent {
    x: int,
    y: int,
    button: int,
}

/// Keyboard payload, staged by the engine and read inside a handler.
struct KeyEvent {
    key: int,
    ctrl: bool,
    shift: bool,
    alt: bool,
}

/// Multi-value box sizing, passed as one `style =` prop.
struct BoxStyle {
    width: int = -1,
    height: int = -1,
    background: string = "",
    padding: int = 0,
    grow: int = 0,
}

/// `v` when the caller set it (>= 0), else the recipe's `fallback`. Both
/// sides stay thunks, so a themed default repaints on a palette switch just
/// like a caller-supplied one. This is how a recipe widget layers its own
/// look under whatever the caller passed.
fn px_or_default(v: int, fallback: int) -> int {
    if v >= 0 {
        return v
    }
    return fallback
}

/// `px_or` for colors and other strings: a non-empty `v` wins.
fn str_or_default(v: string, fallback: string) -> string {
    if v.len > 0 {
        return v
    }
    return fallback
}

/// 2D grid configuration.
struct GridConfig {
    columns: int = 1,
    gap: int = 0,
    padding: int = 0,
}

/// The event payload for the handler now running. A handler is invoked with
/// no arguments, so `fn(e: MouseEvent)` is lowered to a `let` of this.
fn current_mouse() -> MouseEvent {
    return MouseEvent { x: arena.ev_x, y: arena.ev_y, button: arena.ev_button }
}

fn current_key() -> KeyEvent {
    return KeyEvent {
        key: arena.ev_key,
        ctrl: arena.ev_mods % 4 >= 2,
        shift: arena.ev_mods % 2 == 1,
        alt: arena.ev_mods % 8 >= 4,
    }
}

/// Default for the text/label thunks: an unset text prop reads as empty.
fn empty_text() -> string {
    return ""
}

/// Default for an unset handler prop. Never installed: `on_x__set` says
/// whether the caller passed one.
fn noop() {
    return
}

/// Shared props for `Component` / `Box`. Every widget passes these.
struct BoxProps {
    width: int = -1,
    height: int = -1,
    padding: int = -1,
    padding_x: int = -1,
    padding_y: int = -1,
    spacing: int = -1,
    radius: int = -1,
    border: int = -1,
    border_color: string = "",
    background: string = "",
    color: string = "",
    font: int = -1,
    opacity: int = -1,
    grow: int = -1,
    shrink: int = -1,
    show: bool = true,
    align_direction: int = 1,
    align_items: int = -1,
    justify: int = -1,
    wrap: int = 0,
    min_width: int = -1,
    max_width: int = -1,
    min_height: int = -1,
    max_height: int = -1,
    position: int = -1,
    left: int = -1,
    top: int = -1,
    right: int = -1,
    bottom: int = -1,
    z_index: int = -1,
    safe: int = 0,
    hover_off: bool = true,
    cursor: string = "",
    visible: Signal<int> = Signal { id: 0 },
    visible__set: bool = false,
    bind: Signal<int> = Signal { id: 0 },
    bind__set: bool = false,
    press: bool = false,
    /// Label text. A thunk so a signal read inside it repaints just this
    /// attribute; the compiler lifts a plain expression passed here —
    /// `text = "n = {{count.get()}}"` — into that thunk. Nothing at the
    /// call site is a closure unless the caller wants one.
    text: fn() -> string = empty_text,
    text__set: bool = false,
    enabled: bool = true,
    multiline: int = 0,
    fit: int = 0,
    lazy: int = 0,
    edit: Signal<string> = Signal { id: 0 },
    edit__set: bool = false,
    row_h: int = 0,
    rebuild: fn() = noop,
    rebuild__set: bool = false,
    a11y_label: string = "",
    a11y_role: string = "",
    style: BoxStyle = BoxStyle {},
    style__set: bool = false,
    on_click: fn() = noop,
    on_click__set: bool = false,
    on_mouse_down: fn() = noop,
    on_mouse_down__set: bool = false,
    on_mouse_up: fn() = noop,
    on_mouse_up__set: bool = false,
    /// Chord that activates this node: `"cmd+s"`, `"ctrl+shift+p"`, or a
    /// sequence like `"g d"`. Every widget takes it, because `Component`
    /// installs it — nothing here is specific to buttons or sliders.
    key: string = "",
    /// Name the chord resolves to, so an app can remap the shortcut with
    /// `remap_key` without touching the widget. Defaults to `"key.<chord>"`.
    key_action: string = "",
    /// Handler for the chord. Omit it and the chord runs `on_click`, which
    /// is what a button with a shortcut wants.
    on_key: fn() = noop,
    on_key__set: bool = false,
    /// true = the chord fires wherever focus is. Default is node-scoped:
    /// it fires only while this node (or a descendant) holds focus.
    key_global: bool = false,
    on_key_down: fn() = noop,
    on_key_down__set: bool = false,
    on_key_up: fn() = noop,
    on_key_up__set: bool = false,
    on_key_press: fn() = noop,
    on_key_press__set: bool = false,
}

/// `#rrggbb` / `#rgb` to packed RGB. -1 for empty or malformed, which every
/// style setter reads as "leave unset".
fn parse_hex_color(s: string) -> int {
    let n = s.len
    if n == 0 {
        return -1
    }
    // `@N` is a theme role (see `role_token`): keep it symbolic so the paint
    // pass can resolve it per appearance.
    if s[0] == 64 {
        let mut slot = 0
        for i in 1..n {
            let d = s[i] - 48
            if d < 0 || d > 9 {
                return -1
            }
            slot = slot * 10 + d
        }
        return role_color(slot)
    }
    if s[0] != 35 {
        return -1
    }
    let mut v = 0
    if n == 7 {
        for i in 1..7 {
            let d = hex_digit_value(s[i])
            if d < 0 {
                return -1
            }
            v = v * 16 + d
        }
        return v
    }
    if n == 4 {
        for i in 1..4 {
            let d = hex_digit_value(s[i])
            if d < 0 {
                return -1
            }
            v = v * 256 + d * 17
        }
        return v
    }
    return -1
}

/// One hex nibble, or -1 when the byte is not a hex digit — the -1 is what
/// lets `parse_hex_color` reject malformed colors instead of guessing.
fn hex_digit_value(c: int) -> int {
    if c >= 48 {
        if c <= 57 {
            return c - 48
        }
    }
    if c >= 97 {
        if c <= 102 {
            return c - 87
        }
    }
    if c >= 65 {
        if c <= 70 {
            return c - 55
        }
    }
    return -1
}

// --- Component ---
// Every widget is `Component(node, props)`: style thunks, events, bind,
// visible, press, then attach to the current slot parent. Trailing blocks
// lower to `slot`. Recipes allocate a raw node (or call Box) and pass
// props — they do not intern, write arena fields, or call prop_int.

let mut ui_parents: []int = []int {}

fn ui_push(id: int) {
    push(ui_parents, id)
}

fn ui_pop() {
    if ui_parents.len > 0 {
        pop(ui_parents)
    }
}

/// `show` as the 0/1 the arena stores. A plain bool prop, so it is read once
/// at build; reactive hiding goes through the `visible` Signal instead.
fn show_on(show: bool) -> int {
    match show {
        true => { return 1 }
        _ => { return 0 }
    }
}

/// An explicit `shrink` wins; otherwise anything that grows may also shrink.
/// Keeps a growing child from overflowing its row without the caller having
/// to set both.
fn shrink_weight(grow: int, shrink: int) -> int {
    if shrink >= 0 {
        return shrink
    }
    if grow > 0 {
        return 1
    }
    return 0
}

/// A disabled widget paints at 40% so "not available" reads without every
/// recipe hand-dimming its own colors.
fn enabled_opacity(enabled: bool, opacity: int) -> int {
    match enabled {
        false => { return 40 }
        _ => { return opacity }
    }
}

// --- reactive props ---
// A style prop is a thunk. Interning it yields an int id, which a plain `||`
// effect closure can capture — a `fn` value is not Copy and cannot be. The
// effect calls the thunk and re-applies one setter, so setting a signal
// repaints exactly the props that read it.

/// Which node attribute a reactive prop writes. One effect per member, so a
/// signal change repaints exactly that attribute.
enum SET {
    Width = 1,
    Height = 2,
    Padding = 3,
    PaddingX = 4,
    PaddingY = 5,
    Spacing = 6,
    Radius = 7,
    Border = 8,
    Grow = 9,
    AlignItems = 10,
    Justify = 11,
    Font = 12,
    Opacity = 13,
    Direction = 14,
    Background = 15,
    Color = 16,
    BorderColor = 17,
    MinWidth = 18,
    MaxWidth = 19,
    MinHeight = 20,
    MaxHeight = 21,
    Wrap = 22,
    Safe = 23,
    Position = 24,
    Left = 25,
    Top = 26,
    Right = 27,
    Bottom = 28,
    ZIndex = 29,
    Shrink = 30,
    ShowOn = 31,
    SvgFit = 32,
    SvgLazy = 33,
    Text = 100,
    A11yLabel = 101,
    A11yRole = 102,
    Cursor = 103,
}

/// Does this write carry no value? Most props use -1 for "the caller did not
/// pass this", so one rule here replaces the same `if v >= 0` repeated in
/// every arm below. The flag-like setters opt out: they mean something at 0
/// and -1, so they always apply. `SET.Border` is deliberately not one of them:
/// its width is additive in `content_x`/`content_y`, so applying the unset `-1`
/// shifted every container's content by one pixel.
fn skip_unset(setter: int, v: int) -> bool {
    match setter {
        SET.Direction | SET.Wrap | SET.Safe | SET.ShowOn => { return false }
        // A 0px glyph is not a size, so font rejects 0 as well.
        SET.Font => { return v <= 0 }
        _ => { return v < 0 }
    }
}

fn apply_int(nid: int, setter: int, v: int) {
    if skip_unset(setter, v) {
        return
    }
    let n = node_handle(nid)
    // The UI-scale knob is applied here, once, so recipes and callers both
    // write plain design px and never call `scaled` themselves. Only
    // geometry and type scale; weights, flags, colors and z-order do not —
    // so `scaled` is called in those arms only (scaling a packed color would
    // overflow the 32-bit default).
    match setter {
        SET.Width => { set_width(n, scaled(v)) }
        SET.Height => { set_height(n, scaled(v)) }
        SET.Padding => { set_padding(n, scaled(v)) }
        SET.PaddingX => { set_padding_x(n, scaled(v)) }
        SET.PaddingY => { set_padding_y(n, scaled(v)) }
        SET.Spacing => { set_spacing(n, scaled(v)) }
        SET.Radius => { radius(n, scaled(v)) }
        SET.Border => { arena.nodes[nid].border_w = u16(v) }
        SET.Grow => { grow(n, v) }
        SET.AlignItems => { align(n, v) }
        SET.Justify => { justify(n, v) }
        SET.Font => { font(n, scaled(v)) }
        SET.Opacity => { opacity(n, v) }
        SET.Direction => {
            match v {
                1 => { flex_col(n) }
                _ => { flex_row(n) }
            }
        }
        SET.Background => { set_background(n, v) }
        SET.Color => { set_color(n, v) }
        SET.BorderColor => { border_color(n, v) }
        SET.MinWidth => { set_min_width(n, scaled(v)) }
        SET.MaxWidth => { set_max_width(n, scaled(v)) }
        SET.MinHeight => { set_min_height(n, scaled(v)) }
        SET.MaxHeight => { set_max_height(n, scaled(v)) }
        SET.Wrap => {
            match v {
                0 => { }
                _ => { flex_wrap(n) }
            }
        }
        SET.Safe => {
            match v {
                0 => { arena.nodes[nid].safe = u8(0) }
                _ => { arena.nodes[nid].safe = u8(1) }
            }
        }
        SET.Position => { arena.nodes[nid].pos = u8(v) }
        SET.Left => { arena.nodes[nid].pin_l = scaled(v) }
        SET.Top => { arena.nodes[nid].pin_t = scaled(v) }
        SET.Right => { arena.nodes[nid].pin_r = scaled(v) }
        SET.Bottom => { arena.nodes[nid].pin_b = scaled(v) }
        SET.ZIndex => { arena.nodes[nid].z_index = i16(v) }
        SET.Shrink => { shrink(n, v) }
        SET.ShowOn => {
            match v {
                0 | 1 => { arena.nodes[nid].show_on = u8(v) }
                _ => { }
            }
        }
        SET.SvgFit => { arena.nodes[nid].font = u16(v) }
        SET.SvgLazy => { arena.nodes[nid].wrap = u8(v) }
        _ => { }
    }
}

fn apply_str(nid: int, setter: int, v: string) {
    match setter {
        SET.Text => { arena.nodes[nid].text = v }
        SET.A11yLabel => { arena.nodes[nid].a11y_label = v }
        SET.A11yRole => { arena.nodes[nid].a11y_role = v }
        SET.Cursor => { arena.nodes[nid].cursor = v }
        _ => { apply_int(nid, setter, parse_hex_color(v)) }
    }
}

/// Write a plain prop value straight onto the node. Style props are data, so
/// there is nothing to re-run: one assignment at build time.
fn set_prop_int(node: Node, setter: int, v: int) -> Node {
    apply_int(node.id, setter, v)
    return node
}

/// `set_prop_int` for string props (colors, labels, a11y).
fn set_prop_str(node: Node, setter: int, v: string) -> Node {
    apply_str(node.id, setter, v)
    return node
}

fn prop_int(node: Node, setter: int, thunk: fn() -> int) -> Node {
    let fid = intern_int(thunk)
    let nid = node.id
    return styled(node, || { apply_int(nid, setter, platform.plat_invoke_int_fn(fid)) })
}

fn prop_str(node: Node, setter: int, thunk: fn() -> string) -> Node {
    let fid = intern_str(thunk)
    let nid = node.id
    return styled(node, || { apply_str(nid, setter, platform.plat_invoke_str_fn(fid)) })
}

// --- effects and derivations ---
// `styled` is the node-scoped effect every prop above is built from. The two
// below are the free-standing forms: `effect` for a side effect, `computed`
// for a cached value. Both are ordinary reactive scopes — they read signals
// through `get`, so their dependencies are discovered, not declared.

/// Owner for a free-standing reactive scope: the `slot` parent currently
/// being built. An effect created inside a component therefore dies with
/// that component's subtree. 0 at top level — those live for the process.
fn effect_owner() -> int {
    if ui_parents.len > 0 {
        return ui_parents[ui_parents.len - 1]
    }
    return 0
}

/// Run `body` once now, then again whenever a signal it read changes.
/// Effects are the edges of the graph: `body` writes a signal, an arena
/// field, or the outside world — it never rebuilds the tree. Prefer a text
/// thunk (`Text("{{n.get()}}")`) for anything a widget can express; reach
/// for `effect` for the rest (logging, sync, imperative host calls).
///
/// ```
/// let n = zeus.signal(0)
/// zeus.effect(|| { fmt.println("n is now", n.get()) })
/// ```
fn effect(body: fn()) {
    arena.ensure()
    let eid = track.alloc(intern_fn(body), effect_owner())
    track.run(eid)
}

/// A cached derivation. `calc` runs now, and re-runs only when one of the
/// signals *it* read changes — not on every read, and not when some
/// unrelated signal moves. The result is a plain `Signal<int>`, so a reader
/// subscribes to the derivation rather than to its inputs, and because `set`
/// is change-gated a recompute that lands on the same value propagates no
/// further.
///
/// ```
/// let first = zeus.signal("Ada")
/// let last = zeus.signal("Lovelace")
/// let full = zeus.computed_str(|| { "{{first.get()}} {{last.get()}}" })
/// zeus.Text("{{full.get()}}")
/// ```
fn computed(calc: fn() -> int) -> Signal<int> {
    arena.ensure()
    let fid = intern_int(calc)
    let out = signal(0)
    effect(|| { set(out, platform.plat_invoke_int_fn(fid)) })
    return out
}

/// `computed` for a string derivation.
fn computed_str(calc: fn() -> string) -> Signal<string> {
    arena.ensure()
    let fid = intern_str(calc)
    let out = signal("")
    effect(|| { set(out, platform.plat_invoke_str_fn(fid)) })
    return out
}

/// `computed` for a bool derivation.
fn computed_bool(calc: fn() -> bool) -> Signal<bool> {
    arena.ensure()
    let fid = intern_bool(calc)
    let out = signal(false)
    effect(|| { set(out, platform.plat_invoke_bool_fn(fid) != 0) })
    return out
}

/// Apply every style, event, bind, visible, and press prop, then attach
/// `node` to the current `slot` parent. Kind-specific chrome (native
/// thumbs, overlay float, text-input edit, list rebuild) is handled here
/// so widgets stay data.
fn Component(node: Node, p: BoxProps) -> Node {
    arena.ensure()
    shrink(node, 0)
    let k = int(arena.nodes[node.id].kind)
    if p.style__set {
        if p.style.width >= 0 {
            set_width(node, p.style.width)
        }
        if p.style.height >= 0 {
            set_height(node, p.style.height)
        }
        if p.style.padding > 0 {
            set_padding(node, p.style.padding)
        }
        if p.style.grow > 0 {
            grow(node, p.style.grow)
        }
        let sbg = parse_hex_color(p.style.background)
        if sbg >= 0 {
            set_background(node, sbg)
        }
    }
    if k == 1 {
        set_prop_int(node, SET.Direction, p.align_direction)
        set_prop_int(node, SET.Border, p.border)
    }
    if k == 4 {
        set_prop_int(node, SET.Border, p.border)
    }
    if k == 9 {
        set_prop_int(node, SET.Direction, p.align_direction)
    }
    if k == 11 {
        set_prop_int(node, SET.Direction, p.align_direction)
    }
    set_prop_int(node, SET.Width, p.width)
    set_prop_int(node, SET.Height, p.height)
    set_prop_int(node, SET.Padding, p.padding)
    set_prop_int(node, SET.PaddingX, p.padding_x)
    set_prop_int(node, SET.PaddingY, p.padding_y)
    set_prop_int(node, SET.Spacing, p.spacing)
    set_prop_int(node, SET.Radius, p.radius)
    set_prop_int(node, SET.Grow, p.grow)
    let sw = shrink_weight(p.grow, p.shrink)
    set_prop_int(node, SET.Shrink, sw)
    set_prop_int(node, SET.AlignItems, p.align_items)
    set_prop_int(node, SET.Justify, p.justify)
    set_prop_int(node, SET.Wrap, p.wrap)
    set_prop_int(node, SET.MinWidth, p.min_width)
    set_prop_int(node, SET.MaxWidth, p.max_width)
    set_prop_int(node, SET.MinHeight, p.min_height)
    set_prop_int(node, SET.MaxHeight, p.max_height)
    set_prop_int(node, SET.Safe, p.safe)
    set_prop_int(node, SET.Position, p.position)
    set_prop_int(node, SET.Left, p.left)
    set_prop_int(node, SET.Top, p.top)
    set_prop_int(node, SET.Right, p.right)
    set_prop_int(node, SET.Bottom, p.bottom)
    set_prop_int(node, SET.ZIndex, p.z_index)
    let shown = show_on(p.show)
    set_prop_int(node, SET.ShowOn, shown)
    if k == 14 {
        set_prop_int(node, SET.SvgFit, p.fit)
        set_prop_int(node, SET.SvgLazy, p.lazy)
    } else {
        set_prop_int(node, SET.Font, p.font)
    }
    let dim = enabled_opacity(p.enabled, p.opacity)
    set_prop_int(node, SET.Opacity, dim)
    if k == 10 {
        set_prop_int(node, SET.Wrap, p.multiline)
    }
    set_prop_str(node, SET.Background, p.background)
    set_prop_str(node, SET.Color, p.color)
    set_prop_str(node, SET.BorderColor, p.border_color)
    set_prop_str(node, SET.A11yLabel, p.a11y_label)
    set_prop_str(node, SET.A11yRole, p.a11y_role)
    set_prop_str(node, SET.Cursor, p.cursor)
    if p.text__set {
        prop_str(node, SET.Text, p.text)
    }
    if p.on_click__set {
        arena.nodes[node.id].click_fn = intern_fn(p.on_click)
        arena.nodes[node.id].focusable = 1
    }
    if p.on_mouse_down__set {
        arena.nodes[node.id].down_fn = intern_fn(p.on_mouse_down)
    }
    if p.on_mouse_up__set {
        arena.nodes[node.id].up_fn = intern_fn(p.on_mouse_up)
    }
    // A `key` prop works on every widget: the chord runs `on_key`, or
    // `on_click` when no separate handler was given. Installed after the
    // click handler so that fallback has something to call.
    if p.key.len > 0 {
        let mut kfn = 0
        if p.on_key__set {
            kfn = intern_fn(p.on_key)
        } else {
            kfn = arena.nodes[node.id].click_fn
        }
        install_key(node, p.key, p.key_action, kfn, p.key_global)
    }
    if p.on_key_down__set {
        arena.nodes[node.id].kdown_fn = intern_fn(p.on_key_down)
        arena.nodes[node.id].focusable = 1
    }
    if p.on_key_up__set {
        arena.nodes[node.id].kup_fn = intern_fn(p.on_key_up)
        arena.nodes[node.id].focusable = 1
    }
    if p.on_key_press__set {
        arena.nodes[node.id].kpress_fn = intern_fn(p.on_key_press)
        arena.nodes[node.id].focusable = 1
    }
    // `hover_off` is a plain bool field, so interning a thunk here only to
    // invoke it on the next line allocated a closure env capturing the whole
    // BoxProps (624 B) on every Component — and the env outlives the interned
    // copy, so it leaked once per node build. Read the field directly.
    if p.hover_off {
        hover_off(node)
    }
    if p.bind__set {
        bind(node, p.bind)
    }
    if p.visible__set {
        show(node, p.visible)
    }
    if p.press {
        arena.nodes[node.id].press = 1
    }
    if p.edit__set {
        if p.edit.id > 0 {
            let sig = p.edit
            let nid = node.id
            arena.nodes[nid].edit_sig = sig.id
            arena.nodes[nid].bind_fn = intern_fn(|| { set(sig, arena.input_committed(nid)) })
        }
    }
    if p.row_h != 0 {
        arena.nodes[node.id].row_h = p.row_h
    }
    if p.rebuild__set {
        arena.nodes[node.id].list_fn = intern_fn(p.rebuild)
    }
    if k == 7 {
        ensure_role_colors()
        set_background(node, role_color(ROLE.Rule))
        set_color(node, role_color(ROLE.Ink))
        border_color(node, role_color(ROLE.Plate))
        arena.nodes[node.id].focusable = 1
    }
    if k == 13 {
        ensure_role_colors()
        set_background(node, role_color(ROLE.Hard))
        set_color(node, role_color(ROLE.Ink))
        border_color(node, role_color(ROLE.Plate))
        if p.bind__set {
            keys(node, p.bind, 0, 100)
        }
    }
    if k == 6 {
        ensure_role_colors()
        set_background(node, role_color(ROLE.Hard))
        set_color(node, role_color(ROLE.Ink))
        border_color(node, role_color(ROLE.Plate))
    }
    if k == 9 {
        arena.nodes[node.id].dir = 1
        center(node)
        z_index(node, 50)
    }
    if k == 11 {
        if p.bind__set {
            let nid = node.id
            let sid = p.bind.id
            styled(node, || {
                let y = signal_handle(sid).get()
                if arena.nodes[nid].scroll_y != y {
                    arena.nodes[nid].vel_y = 0
                    arena.nodes[nid].scroll_y = y
                    arena.clamp_scroll(nid)
                }
            })
        }
    }
    if ui_parents.len > 0 {
        let pid = ui_parents[ui_parents.len - 1]
        if pid > 0 {
            child(node_handle(pid), node)
        }
    }
    return node
}

/// Run `build` with `host` as the parent. Trailing blocks lower to this.
fn slot(host: Node, build: fn()) -> Node {
    ui_push(host.id)
    build()
    ui_pop()
    return host
}

/// Compiler trailing-block sugar until `slot` is the emitted name.
fn __ui_scope(node: Node, build: fn()) -> Node {
    return slot(node, build)
}

fn ui_emit(node: Node) -> Node {
    return Component(node)
}


// --- widgets ---
// Every prop is optional; an omitted one takes its declared default. A
// `foo__set` companion records whether the caller passed `foo`.

struct TextProps {
    color: string = "",
    font: int = -1,
    padding: int = -1,
    opacity: int = -1,
    // grow / shrink / show: as BoxProps. `grow = 1` text fills leftover row
    // space and narrows before the row wraps; `show` hides without
    // rebuilding.
    grow: int = -1,
    shrink: int = -1,
    show: bool = true,
    wrap: int = 0,
    // position / left / top / right / bottom / z_index: as BoxProps. Pinned
    // labels are how axis ticks and rotated chart text place themselves.
    position: int = -1,
    left: int = -1,
    top: int = -1,
    right: int = -1,
    bottom: int = -1,
    z_index: int = -1,
    a11y_label: string = "",
    a11y_role: string = "",
    /// Chord that activates this node: `"cmd+s"`, `"ctrl+shift+p"`, or a
    /// sequence like `"g d"`. Every widget takes it — key binding is a prop,
    /// not something a particular widget hard-codes.
    key: string = "",
    /// Name the chord resolves to, so an app can remap it with `remap_key`
    /// without touching the widget. Defaults to `"key.<chord>"`.
    key_action: string = "",
    /// Handler for the chord; omit it and the chord runs `on_click`.
    on_key: fn() = noop,
    on_key__set: bool = false,
    /// true = fires wherever focus is, instead of only on this node.
    key_global: bool = false,
}

/// Options for `Button`. Default `look = LOOK.Solid` (gallery "Primary")
/// paints themed chrome. `look = -1` is a plain clickable label styled by
/// `background` / `color` / `font` / `padding` / `radius` / `width` /
/// `height` / `enabled` (dims when false). `on_click` fires it.
struct ButtonProps {
    /// Label of the Button. A thunk, so `"n = {{count.get()}}"` keeps
    /// updating; the compiler lifts a plain expression into it.
    label: fn() -> string = empty_text,
    /// `LOOK` token for themed chrome; `-1` = raw (props below decide the look).
    look: int = LOOK.Solid,
    /// `SIZE` token for themed chrome.
    size: int = SIZE.Md,
    /// Style props. Plain data — `radius = 4`, `background = paper()`. Each
    /// is re-evaluated by the effect that owns that attribute, so it follows
    /// a theme switch. `-1` / `""` keep the recipe's own value.
    background: string = "",
    color: string = "",
    radius: int = -1,
    padding: int = -1,
    padding_x: int = -1,
    padding_y: int = -1,
    width: int = -1,
    height: int = -1,
    font: int = -1,
    border: int = -1,
    border_color: string = "",
    spacing: int = -1,
    // position / left / top / right / bottom / z_index: as BoxProps.
    position: int = -1,
    left: int = -1,
    top: int = -1,
    right: int = -1,
    bottom: int = -1,
    z_index: int = -1,
    /// Visible when the thunk is true (signal shows win, as BoxProps).
    show: bool = true,
    /// `enabled = form_valid.get()` dims and disables reactively.
    enabled: bool = true,
    /// 1 silences the gray hover wash (the default: flat chrome).
    /// Set `hover_off = false` to let the button wash on hover.
    hover_off: bool = false,
    /// CSS cursor under the pointer (default `""` = arrow).
    cursor: string = "",
    on_click: fn() = noop,
    on_click__set: bool = false,
    /// Chord that activates this node: `"cmd+s"`, `"ctrl+shift+p"`, or a
    /// sequence like `"g d"`. Every widget takes it — key binding is a prop,
    /// not something a particular widget hard-codes.
    key: string = "",
    /// Name the chord resolves to, so an app can remap it with `remap_key`
    /// without touching the widget. Defaults to `"key.<chord>"`.
    key_action: string = "",
    /// Handler for the chord; omit it and the chord runs `on_click`.
    on_key: fn() = noop,
    on_key__set: bool = false,
    /// true = fires wherever focus is, instead of only on this node.
    key_global: bool = false,
}

struct InputProps {
    placeholder: string = "",
    width: int = -1,
    height: int = -1,
    // position / left / top / right / bottom / z_index: as BoxProps.
    position: int = -1,
    left: int = -1,
    top: int = -1,
    right: int = -1,
    bottom: int = -1,
    z_index: int = -1,
    /// Visible when the thunk is true (signal shows win, as BoxProps).
    show: bool = true,
    color: string = "",
    background: string = "",
    font: int = -1,
    padding: int = -1,
    grow: int = -1,
    bind: Signal<string> = Signal { id: 0 },
    bind__set: bool = false,
    /// CSS cursor under the pointer (default `""` = arrow; inputs usually
    /// want `"text"` on their frame).
    cursor: string = "",
    a11y_label: string = "",
    /// 1 = multiline (Enter inserts a newline, wrap + caret up/down).
    multiline: int = 0,
    on_key_down: fn() = noop,
    on_key_down__set: bool = false,
    on_key_up: fn() = noop,
    on_key_up__set: bool = false,
    on_key_press: fn() = noop,
    on_key_press__set: bool = false,
    /// Chord that activates this node: `"cmd+s"`, `"ctrl+shift+p"`, or a
    /// sequence like `"g d"`. Every widget takes it — key binding is a prop,
    /// not something a particular widget hard-codes.
    key: string = "",
    /// Name the chord resolves to, so an app can remap it with `remap_key`
    /// without touching the widget. Defaults to `"key.<chord>"`.
    key_action: string = "",
    /// Handler for the chord; omit it and the chord runs `on_click`.
    on_key: fn() = noop,
    on_key__set: bool = false,
    /// true = fires wherever focus is, instead of only on this node.
    key_global: bool = false,
}

struct GridProps {
    config: GridConfig = GridConfig {},
    width: int = -1,
    background: string = "",
    padding: int = -1,
    // position / left / top / right / bottom / z_index: as BoxProps.
    position: int = -1,
    left: int = -1,
    top: int = -1,
    right: int = -1,
    bottom: int = -1,
    z_index: int = -1,
    /// Visible when the thunk is true (signal shows win, as BoxProps).
    show: bool = true,
    /// Chord that activates this node: `"cmd+s"`, `"ctrl+shift+p"`, or a
    /// sequence like `"g d"`. Every widget takes it — key binding is a prop,
    /// not something a particular widget hard-codes.
    key: string = "",
    /// Name the chord resolves to, so an app can remap it with `remap_key`
    /// without touching the widget. Defaults to `"key.<chord>"`.
    key_action: string = "",
    /// Handler for the chord; omit it and the chord runs `on_click`.
    on_key: fn() = noop,
    on_key__set: bool = false,
    /// true = fires wherever focus is, instead of only on this node.
    key_global: bool = false,
}

struct OverlayProps {
    background: string = "",
    opacity: int = -1,
    /// Visible when the thunk is true (signal shows win, as BoxProps).
    show: bool = true,
    /// Signal hide: `visible = open` is `show(node, open)`.
    visible: Signal<int> = Signal { id: 0 },
    visible__set: bool = false,
    on_click: fn() = noop,
    on_click__set: bool = false,
    /// Chord that activates this node: `"cmd+s"`, `"ctrl+shift+p"`, or a
    /// sequence like `"g d"`. Every widget takes it — key binding is a prop,
    /// not something a particular widget hard-codes.
    key: string = "",
    /// Name the chord resolves to, so an app can remap it with `remap_key`
    /// without touching the widget. Defaults to `"key.<chord>"`.
    key_action: string = "",
    /// Handler for the chord; omit it and the chord runs `on_click`.
    on_key: fn() = noop,
    on_key__set: bool = false,
    /// true = fires wherever focus is, instead of only on this node.
    key_global: bool = false,
}

/// Options for `Scroll`. `bind` is a two-way `scroll_y` signal: writing it
/// calls `scroll_to`, and wheel / pan / physics write the live offset back.
struct ScrollProps {
    width: int = -1,
    height: int = -1,
    grow: int = -1,
    bind: Signal<int> = Signal { id: 0 },
    bind__set: bool = false,
    /// Chord that activates this node: `"cmd+s"`, `"ctrl+shift+p"`, or a
    /// sequence like `"g d"`. Every widget takes it — key binding is a prop,
    /// not something a particular widget hard-codes.
    key: string = "",
    /// Name the chord resolves to, so an app can remap it with `remap_key`
    /// without touching the widget. Defaults to `"key.<chord>"`.
    key_action: string = "",
    /// Handler for the chord; omit it and the chord runs `on_click`.
    on_key: fn() = noop,
    on_key__set: bool = false,
    /// true = fires wherever focus is, instead of only on this node.
    key_global: bool = false,
}

/// One column of a `VirtualTable`. `width` 0 means the column takes an equal
/// share of the row (pair cells with `set_flex_basis_zero(...).grow(1)`); a positive value
/// is a pixel width. `title` is the header cell.
struct TableCol {
    title: string,
    width: int,
}

/// Geometry for `Svg` layers: explicit size plus absolute placement
/// (`position` / `left` / `top` / `right` / `bottom` / `z_index`, as
/// `BoxProps`). Without `width`/`height` an svg is measured like a label.
struct SvgProps {
    width: int = -1,
    height: int = -1,
    position: int = -1,
    left: int = -1,
    top: int = -1,
    right: int = -1,
    bottom: int = -1,
    z_index: int = -1,
    /// Visible when the thunk is true (signal shows win, as BoxProps).
    show: bool = true,
    /// Chord that activates this node: `"cmd+s"`, `"ctrl+shift+p"`, or a
    /// sequence like `"g d"`. Every widget takes it — key binding is a prop,
    /// not something a particular widget hard-codes.
    key: string = "",
    /// Name the chord resolves to, so an app can remap it with `remap_key`
    /// without touching the widget. Defaults to `"key.<chord>"`.
    key_action: string = "",
    /// Handler for the chord; omit it and the chord runs `on_click`.
    on_key: fn() = noop,
    on_key__set: bool = false,
    /// true = fires wherever focus is, instead of only on this node.
    key_global: bool = false,
}

/// Options for `Image`. Hosts decode PNG / JPEG / WebP / GIF from a path,
/// data URI, or URL and cache by `src`. With no `width`/`height` the box
/// takes the decoded source size: it keeps the source aspect ratio and fills
/// the container (device) width without growing past the source — web
/// `max-width: 100%`. Give `width` and the height follows the aspect ratio;
/// give `height` and the width is the container width. Set both to pin a box
/// that `fit` then maps the bitmap into. `fit` is `IMAGE_FIT` (stretch /
/// contain / cover / none).
struct ImageProps {
    width: int = -1,
    height: int = -1,
    radius: int = -1,
    /// `IMAGE_FIT.Stretch` (default), `.Contain`, `.Cover`, or `.None`.
    fit: int = 0,
    /// 1 = decode only once the node intersects the view (skip off-screen).
    lazy: int = 0,
    opacity: int = -1,
    grow: int = -1,
    shrink: int = -1,
    min_width: int = -1,
    max_width: int = -1,
    min_height: int = -1,
    max_height: int = -1,
    position: int = -1,
    left: int = -1,
    top: int = -1,
    right: int = -1,
    bottom: int = -1,
    z_index: int = -1,
    /// Visible when the thunk is true (signal shows win, as BoxProps).
    show: bool = true,
    a11y_label: string = "",
    /// Chord that activates this node: `"cmd+s"`, `"ctrl+shift+p"`, or a
    /// sequence like `"g d"`. Every widget takes it — key binding is a prop,
    /// not something a particular widget hard-codes.
    key: string = "",
    /// Name the chord resolves to, so an app can remap it with `remap_key`
    /// without touching the widget. Defaults to `"key.<chord>"`.
    key_action: string = "",
    /// Handler for the chord; omit it and the chord runs `on_click`.
    on_key: fn() = noop,
    on_key__set: bool = false,
    /// true = fires wherever focus is, instead of only on this node.
    key_global: bool = false,
}

/// A flex container. Trailing block is the slot.
fn Box(p: BoxProps) -> Node {
    return Component(raw_box(), p)
}

/// Static or reactive text. The label is a thunk, so a signal read inside it
/// is recorded against this label's own effect: setting the signal repaints
/// this one node. The compiler lifts a plain expression —
/// `Text("n={{count.get()}}")` — into that thunk, so callers write data.
fn Text(label: fn() -> string, p: TextProps) -> Node {
    let __n = Component(raw_label(""), text = label, color = p.color, font = p.font,
        padding = p.padding, opacity = p.opacity, grow = p.grow, shrink = p.shrink,
        show = p.show, wrap = p.wrap, position = p.position, left = p.left,
        top = p.top, right = p.right, bottom = p.bottom, z_index = p.z_index,
        a11y_label = p.a11y_label, a11y_role = p.a11y_role)
    return apply_key(__n, p.key, p.key_action, p.on_key, p.on_key__set, p.key_global)
}

/// Action button. Default `look = LOOK.Solid`. `look = -1` is a plain label.
fn Button(p: ButtonProps) -> Node {
    if p.look >= 0 {
        return btn_look(p)
    }
    let __n = Component(raw_button(""), text = p.label, color = p.color,
        background = p.background, font = p.font, padding = p.padding,
        radius = p.radius, width = p.width, height = p.height,
        position = p.position, left = p.left, top = p.top, right = p.right,
        bottom = p.bottom, z_index = p.z_index, show = p.show,
        enabled = p.enabled, cursor = p.cursor, on_click = p.on_click,
        hover_off = p.hover_off, a11y_role = "button", a11y_label = p.label(),
        press = p.on_click__set)
    if p.hover_off == false {
        hover_fade(__n)
    }
    return apply_key(__n, p.key, p.key_action, p.on_key, p.on_key__set, p.key_global)
}

/// Themed chrome branch of `Button`.
fn btn_look(p: ButtonProps) -> Node {
    let look = p.look
    let size = p.size
    let n = Box(
        align_direction = DIRECTION.Row,
        align_items = ALIGN.Center,
        justify = ALIGN.Center,
        spacing = px_or_default(p.spacing, SPACE.Exs),
        background = str_or_default(p.background, button_background(look)),
        color = str_or_default(p.color, button_color(look)),
        width = p.width,
        height = px_or_default(p.height, button_height(size)),
        padding_x = px_or_default(p.padding_x, px_or_default(p.padding, button_padding_x(size))),
        radius = px_or_default(p.radius, button_radius(size)),
        border = px_or_default(p.border, button_border_width(look)),
        border_color = str_or_default(p.border_color, button_border_color(look)),
        on_click = p.on_click,
        on_click__set = p.on_click__set,
        a11y_role = "button",
        a11y_label = p.label(),
        show = p.show,
        enabled = p.enabled,
        padding_y = p.padding_y,
        hover_off = p.hover_off,
        cursor = "pointer",
        press = true
    ) {
        Text(p.label, color = str_or_default(p.color, button_color(look)),
             font = px_or_default(p.font, button_font(size)))
    }
    // Chrome hover is explicit: a themed button stays a hover target even
    // when it has no click handler (`is_hot` would otherwise require one).
    if p.hover_off == false {
        hover_fade(n)
    }
    return n
}

/// Text field. `multiline = 1` wraps and lets Enter insert a newline.
/// `bind = sig` writes the committed buffer into a `Signal<string>` on every
/// edit; the store notifies only on a real change.
fn Input(p: InputProps) -> Node {
    let __n = Component(raw_input(p.placeholder), width = p.width, height = p.height,
        position = p.position, left = p.left, top = p.top, right = p.right,
        bottom = p.bottom, z_index = p.z_index, show = p.show, color = p.color,
        background = p.background, font = p.font, padding = p.padding,
        grow = p.grow, a11y_label = p.a11y_label, cursor = p.cursor,
        multiline = p.multiline, a11y_role = "textbox", edit = p.bind,
        on_key_down = p.on_key_down, on_key_down__set = p.on_key_down__set,
        on_key_up = p.on_key_up, on_key_up__set = p.on_key_up__set,
        on_key_press = p.on_key_press, on_key_press__set = p.on_key_press__set)
    return apply_key(__n, p.key, p.key_action, p.on_key, p.on_key__set, p.key_global)
}

/// 2D grid. `config = GridConfig(columns = 3, gap = 12, padding = 16)`.
fn Grid(p: GridProps) -> Node {
    let __n = Component(raw_grid(p.config.columns, p.config.gap), width = p.width,
        padding = p.config.padding, position = p.position, left = p.left,
        top = p.top, right = p.right, bottom = p.bottom, z_index = p.z_index,
        show = p.show, background = p.background)
    return apply_key(__n, p.key, p.key_action, p.on_key, p.on_key__set, p.key_global)
}

/// Full-window floater. Kind 9 is out of flow. Children are centred.
fn Overlay(p: OverlayProps) -> Node {
    let __n = Component(raw_overlay(), background = p.background, opacity = p.opacity,
        show = p.show, visible = p.visible, on_click = p.on_click)
    return apply_key(__n, p.key, p.key_action, p.on_key, p.on_key__set, p.key_global)
}

/// A column that skips layout while `visible` is 0. Trailing block is the body.
/// The subtree is built once (retained), unlike a build-time `if`.
fn If(visible: Signal<int>) -> Node {
    return Box(align_direction = DIRECTION.Column, visible = visible)
}

/// Run `build(i, item)` for each element. `[]T` is Copy when `T` is Copy, so
/// this is safe inside a trailing block.
fn Each<T>(items: []T, build: fn(int, T)) {
    let n = items.len
    for i in 0..n {
        build(i, items[i])
    }
}

/// Append `v` to a live list signal and notify. Use with `For` / `VirtualList`.
/// A windowed list only rebuilds the visible window, not every row.
fn push_item<T>(sig: Signal<[]T>, v: T) {
    let mut xs = sig.get()
    push(xs, v)
    sig.set(xs)
}

/// Insert `v` at index `i` (clamped to `0..len`). Use with `For` / `VirtualList`.
fn insert_item<T>(sig: Signal<[]T>, i: int, v: T) {
    let xs = sig.get()
    let n = xs.len
    let mut at = i
    if at < 0 {
        at = 0
    }
    if at > n {
        at = n
    }
    let mut out = []T {}
    let mut j = 0
    while j < at {
        push(out, xs[j])
        j = j + 1
    }
    push(out, v)
    while j < n {
        push(out, xs[j])
        j = j + 1
    }
    sig.set(out)
}

/// Remove the item at index `i`. No-op if `i` is out of range.
fn remove_item<T>(sig: Signal<[]T>, i: int) {
    let xs = sig.get()
    let n = xs.len
    if i < 0 {
        return
    }
    if i >= n {
        return
    }
    let mut out = []T {}
    let mut j = 0
    while j < n {
        if j != i {
            push(out, xs[j])
        }
        j = j + 1
    }
    sig.set(out)
}

/// Remove the last item from a live list signal. No-op if empty.
fn pop_item<T>(sig: Signal<[]T>) {
    let mut xs = sig.get()
    if xs.len > 0 {
        pop(xs)
        sig.set(xs)
    }
}

const VIRT_OVERSCAN: int = 4

struct VirtWin {
    first: int,
    last: int,
}

fn find_scroller(id: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= arena.nodes.len {
        return 0
    }
    if int(arena.nodes[id].kind) == 11 {
        return id
    }
    let mut p = arena.nodes[id].parent
    while p > 0 {
        if int(arena.nodes[p].kind) == 11 {
            return p
        }
        p = arena.nodes[p].parent
    }
    return 0
}

/// Visible index window for a windowed list. `row_h` is the fixed row height
/// used to turn `scroll_y` into indices; overscan keeps a few extra rows
/// mounted so a small flick does not rebuild.
fn virt_window(nid: int, n: int, row_h: int) -> VirtWin {
    let mut first = 0
    let mut last = n
    if row_h <= 0 {
        return VirtWin { first: first, last: last }
    }
    let sid = find_scroller(nid)
    let mut view_h = 240
    let mut local = 0
    if sid > 0 {
        if arena.nodes[sid].h > 0 {
            view_h = arena.nodes[sid].h
        }
        if nid == sid {
            local = arena.nodes[sid].scroll_y
        } else {
            local = arena.nodes[sid].scroll_y - (arena.nodes[nid].y - arena.nodes[sid].y)
        }
    } else if arena.nodes[nid].h > 0 {
        view_h = arena.nodes[nid].h
    }
    if local < 0 {
        local = 0
    }
    first = local / row_h - VIRT_OVERSCAN
    last = (local + view_h) / row_h + VIRT_OVERSCAN + 1
    if first < 0 {
        first = 0
    }
    if last > n {
        last = n
    }
    if last < first {
        last = first
    }
    return VirtWin { first: first, last: last }
}

fn virt_refresh<T>(nid: int, items: Signal<[]T>, build: fn(int, T), row_h: int) {
    let xs = items.get()
    let m = xs.len
    let gen = platform.plat_sig_gen(items.id)
    let mut first = 0
    let mut last = m
    if row_h > 0 {
        let w = virt_window(nid, m, row_h)
        first = w.first
        last = w.last
    }
    if gen == arena.nodes[nid].list_gen {
        if first == arena.nodes[nid].list_lo {
            if last == arena.nodes[nid].list_hi {
                if arena.nodes[nid].kids.len > 0 {
                    return
                }
                if m == 0 {
                    arena.nodes[nid].list_n = 0
                    return
                }
            }
        }
    }
    arena.nodes[nid].list_gen = gen
    arena.nodes[nid].list_lo = first
    arena.nodes[nid].list_hi = last
    arena.nodes[nid].list_n = m
    arena.nodes[nid].row_h = row_h
    // Everything the builder allocated last time is owned by this host:
    // signals and interned handlers are freed (and their ids recycled) on
    // the next rebuild, so streaming data does not grow the arena. A
    // windowed list only (re)builds the visible rows — append / insert
    // outside the window is a spacer resize, not O(n) widgets.
    let prev = arena.rebuild_begin(nid)
    ui_push(nid)
    if row_h > 0 {
        if first > 0 {
            let top = raw_spacer()
            set_height(top, first * row_h)
            Component(top)
        }
    }
    let mut i = first
    while i < last {
        build(i, xs[i])
        i = i + 1
    }
    if row_h > 0 {
        if last < m {
            let bot = raw_spacer()
            set_height(bot, (m - last) * row_h)
            Component(bot)
        }
    }
    ui_pop()
    arena.rebuild_end(prev)
}

fn virt_row_h(heights: []int, i: int, fallback: int) -> int {
    if i >= 0 {
        if i < heights.len {
            if heights[i] > 0 {
                return heights[i]
            }
        }
    }
    return fallback
}

fn virt_prefix(heights: []int, n: int, fallback: int) -> int {
    let mut y = 0
    let mut i = 0
    while i < n {
        y = y + virt_row_h(heights, i, fallback)
        i = i + 1
    }
    return y
}

fn virt_window_var(nid: int, n: int, heights: []int, fallback: int) -> VirtWin {
    if heights.len == 0 {
        return virt_window(nid, n, fallback)
    }
    let sid = find_scroller(nid)
    let mut view_h = 240
    let mut local = 0
    if sid > 0 {
        if arena.nodes[sid].h > 0 {
            view_h = arena.nodes[sid].h
        }
        if nid == sid {
            local = arena.nodes[sid].scroll_y
        } else {
            local = arena.nodes[sid].scroll_y - (arena.nodes[nid].y - arena.nodes[sid].y)
        }
    } else if arena.nodes[nid].h > 0 {
        view_h = arena.nodes[nid].h
    }
    if local < 0 {
        local = 0
    }
    let mut acc = 0
    let mut first = n
    let mut last = n
    let mut i = 0
    while i < n {
        let rh = virt_row_h(heights, i, fallback)
        if acc + rh > local {
            first = i
            break
        }
        acc = acc + rh
        i = i + 1
    }
    first = first - VIRT_OVERSCAN
    if first < 0 {
        first = 0
    }
    acc = virt_prefix(heights, first, fallback)
    last = first
    while last < n {
        if acc >= local + view_h {
            last = last + VIRT_OVERSCAN
            if last > n {
                last = n
            }
            return VirtWin { first: first, last: last }
        }
        acc = acc + virt_row_h(heights, last, fallback)
        last = last + 1
    }
    return VirtWin { first: first, last: last }
}

fn virt_refresh_var<T>(nid: int, items: Signal<[]T>, build: fn(int, T), fallback: int,
                       heights: Signal<[]int>) {
    let xs = items.get()
    let hs = heights.get()
    let m = xs.len
    let gen = platform.plat_sig_gen(items.id) + platform.plat_sig_gen(heights.id)
    let w = virt_window_var(nid, m, hs, fallback)
    let first = w.first
    let last = w.last
    if gen == arena.nodes[nid].list_gen {
        if first == arena.nodes[nid].list_lo {
            if last == arena.nodes[nid].list_hi {
                if arena.nodes[nid].kids.len > 0 {
                    return
                }
                if m == 0 {
                    arena.nodes[nid].list_n = 0
                    return
                }
            }
        }
    }
    arena.nodes[nid].list_gen = gen
    arena.nodes[nid].list_lo = first
    arena.nodes[nid].list_hi = last
    arena.nodes[nid].list_n = m
    arena.nodes[nid].row_h = fallback
    let prev = arena.rebuild_begin(nid)
    ui_push(nid)
    if first > 0 {
        let top = raw_spacer()
        set_height(top, virt_prefix(hs, first, fallback))
        Component(top)
    }
    let mut i = first
    while i < last {
        build(i, xs[i])
        i = i + 1
    }
    if last < m {
        let bot = raw_spacer()
        set_height(bot, virt_prefix(hs, m, fallback) - virt_prefix(hs, last, fallback))
        Component(bot)
    }
    ui_pop()
    arena.rebuild_end(prev)
}

/// Positional list. `items` is `zeus.signal([]T {})` (`T` Copy). Rows are
/// rebuilt in place on every change; use `For` when a row must keep its state
/// across a reorder.
fn Index<T>(items: Signal<[]T>, build: fn(int, T)) -> Node {
    let n = raw_box()
    let nid = n.id
    virt_refresh(nid, items, build, 0)
    return Component(n, align_direction = DIRECTION.Column,
        rebuild = || { virt_refresh(nid, items, build, 0) })
}

fn kfor_unique<T>(xs: []T, key: fn(T) -> string, m: int) -> int {
    let mut i = 0
    while i < m {
        let mut j = i + 1
        while j < m {
            if key(xs[i]) == key(xs[j]) {
                return 0
            }
            j = j + 1
        }
        i = i + 1
    }
    return 1
}

/// Keyed list. `items` is `zeus.signal([]T {})` (`T` Copy); `key(item)` must
/// return a stable, unique string. Rows are mounted once per key and **moved**
/// on reorder, so focus and per-row state survive and a pure reorder allocates
/// nothing. A changed key set (insert / remove) rebuilds the host and recycles
/// every row. `build(i, item)` runs at mount; for content that follows the
/// item, read a signal inside the row instead of `i`.
fn For<T>(items: Signal<[]T>, key: fn(T) -> string, build: fn(int, T)) -> Node {
    let n = raw_box()
    let nid = n.id
    kfor_refresh(nid, items, key, build)
    return Component(n, align_direction = DIRECTION.Column,
        rebuild = || { kfor_refresh(nid, items, key, build) })
}

fn kfor_refresh<T>(nid: int, items: Signal<[]T>, key: fn(T) -> string, build: fn(int, T)) {
    let xs = items.get()
    let m = xs.len
    // Fast path: the key set is unchanged, so move the existing rows into the
    // new order. Node ids, focus, scroll and row state all survive; nothing is
    // allocated. A changed key set (or duplicate keys) falls through.
    if arena.key_count(nid) == m {
        if kfor_unique(xs, key, m) == 1 {
            let mut ok = 1
            let mut i = 0
            while i < m {
                if arena.key_node(nid, key(xs[i])) <= 0 {
                    ok = 0
                    break
                }
                i = i + 1
            }
            if ok == 1 {
                let mut order = []int {}
                let mut j = 0
                while j < m {
                    push(order, arena.key_node(nid, key(xs[j])))
                    j = j + 1
                }
                arena.nodes[nid].kids = order
                return
            }
        }
    }
    // Slow path: rebuild the host; every row is re-created and recycled.
    arena.key_clear(nid)
    let prev = arena.rebuild_begin(nid)
    ui_push(nid)
    let mut i = 0
    while i < m {
        let before = arena.nodes[nid].kids.len
        build(i, xs[i])
        let after = arena.nodes[nid].kids.len
        // A row must be a single top-level child to be movable. If the builder
        // mounted zero or several, record nothing so the next update rebuilds
        // rather than reorders a partial row.
        if after == before + 1 {
            arena.key_set(nid, key(xs[i]), arena.nodes[nid].kids[before])
        } else {
            arena.key_set(nid, key(xs[i]), 0)
        }
        i = i + 1
    }
    ui_pop()
    arena.rebuild_end(prev)
}

/// One arm mounted at a time. `on` is a live signal; `build(value)` rebuilds
/// the host whenever `on` changes, so only the current arm is in the tree.
/// Pair with an integer tag signal for a switch/match.
fn Match<T>(on: Signal<T>, build: fn(T)) -> Node {
    let n = raw_box()
    let nid = n.id
    match_build(nid, on, build)
    return Component(n, align_direction = DIRECTION.Column,
        rebuild = || { match_refresh(nid, on, build) })
}

/// Tear the subtree down and rebuild it for the current value of `on`.
/// `list_gen` records the slot it was built from, so `match_refresh` can tell
/// a real change from a bare refresh sweep.
fn match_build<T>(nid: int, on: Signal<T>, build: fn(T)) {
    arena.nodes[nid].list_gen = platform.plat_sig_gen(on.id)
    let prev = arena.rebuild_begin(nid)
    ui_push(nid)
    build(on.get())
    ui_pop()
    arena.rebuild_end(prev)
}

/// `refresh_lists` invokes every node that has a `list_fn`, on every layout.
/// The refit and For/Index hosts all return early when nothing changed; Match
/// did not, so each layout ran `rebuild_begin` — which calls `release_sigs` —
/// and every `zeus.signal` the page declared was freed and re-created at its
/// initial value. Page state reset on any repaint, which reads as "signals
/// don't work" in a routed app. Rebuild only when `on` actually moved.
fn match_refresh<T>(nid: int, on: Signal<T>, build: fn(T)) {
    if platform.plat_sig_gen(on.id) == arena.nodes[nid].list_gen {
        return
    }
    match_build(nid, on, build)
}

/// Error boundary. `build()` runs under a recoverable trap; if it traps, the
/// partial subtree is discarded, the arena is rolled back to its entry mark,
/// and `fallback(message)` is built in its place, so the rest of the app keeps
/// running. Recovers UI state only: C-seam side effects (I/O, network) are not
/// undone, and a trap raised outside `build` (e.g. in a later layout effect) is
/// not caught. On wasm there is no `setjmp`, so a trap still aborts.
fn Boundary(build: fn(), fallback: fn(string)) -> Node {
    let host = raw_box()
    let hid = host.id
    let m = arena.mark()
    let prev = arena.scope_begin(hid)
    ui_push(hid)
    let stack0 = ui_parents.len
    let msg = platform.plat_boundary(build)
    arena.scope_end(prev)
    if msg.len == 0 {
        ui_pop()
    } else {
        // A trap skipped the normal pop: unwind the build stack by hand.
        while ui_parents.len > stack0 {
            pop(ui_parents)
        }
        ui_pop()
        arena.rollback(hid, m)
        ui_push(hid)
        fallback(msg)
        ui_pop()
    }
    return Component(host, align_direction = DIRECTION.Column)
}

/// Vertical scroller that window-renders `items`. `row_h` is the fixed row
/// height in points (spacers use it so `scroll_max` matches the full list).
/// `build(i, item)` is the row. 10k rows stay a few dozen nodes.
fn VirtualList<T>(items: Signal<[]T>, row_h: int, build: fn(int, T)) -> Node {
    let n = raw_scroll()
    let nid = n.id
    virt_refresh(nid, items, build, row_h)
    return Component(n, grow = 1, a11y_role = "list", row_h = row_h,
        rebuild = || { virt_refresh(nid, items, build, row_h) })
}

/// Windowed list with per-row heights. `heights[i]` is row `i` in points
/// (0 / missing uses `fallback`). Spacers use the prefix sum so `scroll_max`
/// matches the real list.
fn VirtualListVar<T>(items: Signal<[]T>, heights: Signal<[]int>, fallback: int,
                     build: fn(int, T)) -> Node {
    let n = raw_scroll()
    let nid = n.id
    virt_refresh_var(nid, items, build, fallback, heights)
    return Component(n, grow = 1, a11y_role = "list", row_h = fallback,
        rebuild = || { virt_refresh_var(nid, items, build, fallback, heights) })
}

/// Windowed table. `rows` is `zeus.signal([]T {})` where `T` is a row struct;
/// `cols` is `[]TableCol` (title + width) for the header. The body is a
/// `VirtualList` of `build(i, row)` — only visible rows are mounted. The
/// themed header (`TableCols`) shares its gutter with body rows; build every
/// cell with `set_flex_basis_zero(...).grow(1)` (or a fixed `.set_width(px)` matching the column)
/// so body columns line up under the header.
fn VirtualTable<T>(rows: Signal<[]T>, cols: []TableCol, row_h: int, build: fn(int, T)) -> Node {
    let wrap = raw_box()
    ui_push(wrap.id)
    TableCols(cols)
    VirtualList(rows, row_h, build)
    ui_pop()
    return Component(wrap, align_direction = DIRECTION.Column, grow = 1,
        a11y_role = "table")
}

/// Jump `n` (a `Scroll` / `VirtualList`) to vertical offset `y`. Clears
/// residual velocity so physics does not coast past the target. Clamped.
fn scroll_to(n: Node, y: int) -> Node {
    arena.nodes[n.id].vel_y = 0
    arena.nodes[n.id].scroll_y = y
    arena.clamp_scroll(n.id)
    if arena.nodes[n.id].bind_sig > 0 {
        arena.store_sig(arena.nodes[n.id].bind_sig, arena.nodes[n.id].scroll_y)
    }
    return n
}

/// Jump `n` to horizontal offset `x`.
fn scroll_to_x(n: Node, x: int) -> Node {
    arena.nodes[n.id].vel_x = 0
    arena.nodes[n.id].scroll_x = x
    arena.clamp_scroll(n.id)
    return n
}

/// Jump a windowed list so item `i` is at the top of the viewport.
fn scroll_to_index(n: Node, i: int) -> Node {
    let mut rh = arena.nodes[n.id].row_h
    if rh < 1 {
        rh = 1
    }
    let mut at = i
    if at < 0 {
        at = 0
    }
    return scroll_to(n, at * rh)
}

/// Live `scroll_y` of `n`.
fn scroll_y(n: Node) -> int {
    return arena.nodes[n.id].scroll_y
}

/// Width a node measured by the last layout pass (0 until the first one).
fn measured_width(n: Node) -> int {
    return arena.nodes[n.id].w
}

/// Re-run `build` into `host` whenever the host's measured width changes
/// (window resize, card reflow). `host` must be widthless so it stretches
/// with its parent. Pixel-exact widgets — charts, plots — lay out their
/// children from the measured width, so they stay glued to the container.
/// Rebuilds happen on the layout after a size change.
fn refit_refresh(nid: int, build: fn()) {
    let w = arena.nodes[nid].w
    if w == arena.nodes[nid].list_gen {
        return
    }
    // A zero-width host (hidden tab, or not laid out yet) defers its rebuild
    // until it is measured at a real width. Syncing `list_gen` here keeps it
    // from refitting on every resize frame while off-screen.
    if w == 0 {
        arena.nodes[nid].list_gen = 0
        return
    }
    arena.nodes[nid].list_gen = w
    let prev = arena.rebuild_begin(nid)
    slot(node_handle(nid), build)
    arena.rebuild_end(prev)
}

fn refit(host: Node, build: fn()) -> Node {
    arena.ensure()
    let nid = host.id
    arena.nodes[nid].list_fn = intern_fn(|| {
        refit_refresh(nid, build)
    })
    return host
}

/// Vertical scroller. Children keep intrinsic height; a bar appears on overflow.
/// `bind` is an optional two-way `scroll_y` signal (`scroll_to` writes it).
fn Scroll(p: ScrollProps) -> Node {
    let __n = Component(raw_scroll(), width = p.width, height = p.height,
        grow = p.grow, bind = p.bind)
    return apply_key(__n, p.key, p.key_action, p.on_key, p.on_key__set, p.key_global)
}

/// Inline SVG. `currentColor` follows the node's foreground. Geometry props:
/// `width`, `height` (an svg is otherwise measured like a label), plus the
/// usual `position` / pins / `z_index` for layered plots.
fn Svg(markup: string, p: SvgProps) -> Node {
    let __n = Component(raw_svg(markup), width = p.width, height = p.height,
        position = p.position, left = p.left, top = p.top, right = p.right,
        bottom = p.bottom, z_index = p.z_index, show = p.show)
    return apply_key(__n, p.key, p.key_action, p.on_key, p.on_key__set, p.key_global)
}

/// Raster image. `src` is a file path, `data:` URI, or `http(s):` URL — a
/// thunk, so a signal read inside it repaints this node. Hosts decode PNG /
/// JPEG / WebP / GIF and cache by that string; a missing or still-loading
/// src paints nothing. With no `width`/`height` the node auto-sizes to the
/// container (device) width at the source aspect ratio — see `ImageProps`.
/// `fit` is `IMAGE_FIT` (stretch / contain / cover / none). `lazy = 1` skips
/// decode while off-screen.
fn Image(src: fn() -> string, p: ImageProps) -> Node {
    return Component(raw_image(""), text = src, width = p.width, height = p.height,
        radius = p.radius, fit = p.fit, lazy = p.lazy, opacity = p.opacity,
        grow = p.grow, shrink = p.shrink, min_width = p.min_width,
        max_width = p.max_width, min_height = p.min_height, max_height = p.max_height,
        position = p.position, left = p.left, top = p.top, right = p.right,
        bottom = p.bottom, z_index = p.z_index, show = p.show,
        a11y_label = p.a11y_label, a11y_role = "img")
}

let mut pick_dest: Signal<string> = Signal { id: 0 }
let mut pick_w: Signal<int> = Signal { id: 0 }
let mut pick_h: Signal<int> = Signal { id: 0 }

/// Open a host file picker (PNG / JPEG / WebP / GIF). Writes the chosen src
/// into `dest` and the image's intrinsic size into `dw` / `dh`. Native hosts
/// return from the dialog; wasm and mobile finish via `engine_picked_image`.
fn pick_image(dest: Signal<string>, dw: Signal<int>, dh: Signal<int>) {
    pick_dest = dest
    pick_w = dw
    pick_h = dh
    let mut w = 0
    let mut h = 0
    let src = platform.plat_pick_image(&mut w, &mut h)
    if src.len > 0 {
        set(dest, src)
        set(dw, w)
        set(dh, h)
        pick_dest = Signal { id: 0 }
        pick_w = Signal { id: 0 }
        pick_h = Signal { id: 0 }
    }
}

/// Host async completion for `pick_image` (file input, photo library).
fn engine_picked_image(src: string, w: int, h: int) {
    if pick_dest.id > 0 {
        if src.len > 0 {
            set(pick_dest, src)
            if pick_w.id > 0 {
                set(pick_w, w)
            }
            if pick_h.id > 0 {
                set(pick_h, h)
            }
        }
        pick_dest = Signal { id: 0 }
        pick_w = Signal { id: 0 }
        pick_h = Signal { id: 0 }
    }
}

/// Open a window and build the tree once. The tree is retained: signals
/// update the props that read them, never a whole subtree.
/// Size comes from the host (`window_size`): on desktop that is the device
/// screen's work area and on iOS/Android the full screen, so an app opens
/// screen-filling. Trailing `width` / `height` pin an exact macOS/wasm window
/// instead (a first size before the view exists, and headless draw tests).
/// The desktop host bounds what a screen-sized window costs with its backing
/// scale (`ZEUS_BACKING_SCALE`), never by shrinking the window.
/// The root is a vertical scroller: children keep their intrinsic height and
/// a bar appears when they overflow. A full-bleed `VirtualList` inside should
/// `grow = 1` so it is the scrolling pane — nested momentum chaining is not
/// this function.
fn App(title: string, build: fn(), width: int = 0, height: int = 0) {
    init()
    let mut w = width
    let mut h = height
    let win_size = window_size()
    if w <= 0 {
        w = win_size.width
    }
    if h <= 0 {
        h = win_size.height
    }
    window(title, w, h)
    let top = raw_scroll()
    // Paint the page background on the root scroller itself (theme-aware,
    // like `Page`): when content rubber-bands past the top/bottom edge or
    // ends short of the viewport, the revealed strip stays paper instead of
    // showing the host's clear color (black on a dark window / wasm page).
    // Root already takes host safe-area insets (`inset_here(root)`).
    Component(top, background = paper())
    slot(top, build)
    root(top)
    raw_run()
}

// ═══════════════════════════════════════════════════════════════════
// Design system: zinc palette + theme roles, LOOK / SIZE / TINT tokens,
// typography and radius constants, lucide icon paths, and themed chrome —
// Card / Chip / Badge / Dialog / forms (Field, TextInput, TextArea) / tabs /
// select / radio / toggle / Pagination / charts / DatePicker / Page.
// ═══════════════════════════════════════════════════════════════════


/// Theme roles. `accent` is the neutral "primary": near-black in light,
/// near-white in dark. Status tints (ok, danger) stay semantic; the chart
/// fields are the data-viz layer every chart reads (stroke + area wash).
struct Palette {
    bg: string,
    card: string,
    raised: string,
    text: string,
    muted: string,
    faint: string,
    line: string,
    line_strong: string,
    wash: string,
    on_solid: string,
    accent: string,
    accent_soft: string,
    danger: string,
    danger_solid: string,
    success: string,
    success_fill: string,
    /// Warning tint: text, pips, icons (amber).
    warn: string,
    /// Warning wash (alert fills, soft warning badges).
    warn_fill: string,
    /// Warning border: soft in light, full in dark.
    warn_edge: string,
    /// Destructive border: destructive/50 in light, full in dark.
    danger_edge: string,
    /// Solid success fill for badges and other ok-on-surface pills.
    ok_solid: string,
    /// Text on colored status fills (ok/danger solids) — white in both
    /// appearances.
    on_fill: string,
    /// Modal scrim (behind dialogs and popovers).
    scrim: string,
    /// Tooltip border.
    chart_edge: string,
    /// Series strokes (the default chart palette).
    chart1: string,
    chart2: string,
    chart3: string,
    chart4: string,
    chart5: string,
    /// Per-series area wash, one entry per appearance.
    fill1: string,
    fill2: string,
    fill3: string,
    fill4: string,
    fill5: string,
}

/// Light is the xAI paper theme: white canvas, ivory cards, dove hairlines,
/// jet ink, sunset accent. Values are the published xAI tokens —
/// `hsl` triplets from `x.ai/grok` converted to hex: background
/// `0 0% 100%`, card `40 18% 97%`, border `222 19% 86%`, foreground
/// `0 0% 4%`, primary `0 0% 4%`, accent `22 100% 51.6%`,
/// success `142 71% 45%`, warning `45 93% 47%`, error `0 84% 60%`.
const LIGHT: Palette = Palette(
    bg = "#ffffff",
    card = "#f9f8f6",
    raised = "#f1f2f6",
    text = "#0a0a0a",
    muted = "#7d8187",
    faint = "#a9b2bc",
    line = "#d5d9e2",
    line_strong = "#a9b2bc",
    wash = "#f7f6f4",
    on_solid = "#ffffff",
    accent = "#0a0a0a",
    accent_soft = "#f1f2f6",
    danger = "#ef4343",
    danger_solid = "#dc2828",
    success = "#21c45d",
    success_fill = "#e4f8ec",
    warn = "#e7b008",
    warn_fill = "#fdf7e6",
    warn_edge = "#fad66b",
    danger_edge = "#f69898",
    ok_solid = "#189044",
    on_fill = "#ffffff",
    scrim = "#000000",
    chart_edge = "#d5d9e2",
    chart1 = "#ff6308",
    chart2 = "#6c28d9",
    chart3 = "#0a1626",
    chart4 = "#477cc2",
    chart5 = "#23958f",
    fill1 = "#ffece1",
    fill2 = "#ede5fa",
    fill3 = "#e2e3e5",
    fill4 = "#e9eff8",
    fill5 = "#e5f2f2"
)

/// Dark is the xAI canvas: near-black edge to edge, white ink, hairline
/// borders. Values are the published xAI tokens — canvas `0 0% 4%`, card
/// `0 0% 10%`, soft `221 12% 14%`, mid `216 4% 22%`, hairline `221 12% 14%`,
/// body `222 19% 86%`, mute `216 4% 51%` — with the light-appropriate
/// sunset / dawn / dusk / twilight / breeze series for charts.
const DARK: Palette = Palette(
    bg = "#0a0a0a",
    card = "#1a1a1a",
    raised = "#1f2228",
    text = "#ffffff",
    muted = "#d5d9e2",
    faint = "#7d8187",
    line = "#1f2228",
    line_strong = "#36383a",
    wash = "#121212",
    on_solid = "#0a0a0a",
    accent = "#ffffff",
    accent_soft = "#1f2228",
    danger = "#e66565",
    danger_solid = "#dc2828",
    success = "#4ade80",
    success_fill = "#142c1d",
    warn = "#f8c630",
    warn_fill = "#2e2610",
    warn_edge = "#947005",
    danger_edge = "#9a1919",
    ok_solid = "#189044",
    on_fill = "#ffffff",
    scrim = "#000000",
    chart_edge = "#1f2228",
    chart1 = "#ff6308",
    chart2 = "#a689fa",
    chart3 = "#9cb8dd",
    chart4 = "#ffd085",
    chart5 = "#45d3cc",
    fill1 = "#361a0a",
    fill2 = "#262135",
    fill3 = "#242930",
    fill4 = "#362e20",
    fill5 = "#152e2d"
)

// --- xAI brand accents ---
// Published brand colors, for charts, marks and highlights. The neutral
// palette above stays the chrome; these are the deliberate splashes.

/// Sunset orange — the primary brand accent (`22 100% 51.6%`).
fn sunset() -> string { return "#ff6308" }
/// Dawn — the soft partner to `sunset` (`37 100% 76%`).
fn sunset_soft() -> string { return "#ffd085" }
/// Dusk purple (`263 70% 50.4%`).
fn dusk() -> string { return "#6c28d9" }
/// Twilight violet, the light partner to `dusk` (`255 92% 76%`).
fn twilight() -> string { return "#a689fa" }
/// Breeze blue (`214 48.9% 73.9%`).
fn breeze() -> string { return "#9cb8dd" }
/// Midnight, the deepest brand blue (`214 58.3% 9.4%`).
fn midnight() -> string { return "#0a1626" }

/// Choose between a light and a dark value for the current appearance.
/// Reads the appearance signal, so a caller inside a reactive prop follows
/// a theme switch automatically.
fn pick_by_appearance(lit: string, dim: string) -> string {
    if appearance().get() == 1 {
        return dim
    }
    return lit
}

/// Page background. Dark is zinc-950.
/// Theme slots. A widget stores the *role*, not a resolved color, so the
/// paint pass resolves it against `appearance()` every frame — that is how
/// a theme switch repaints a retained tree with no effects and no rebuild.
enum ROLE {
    Paper = 1,
    Plate = 2,
    Raised = 3,
    Ink = 4,
    Mute = 5,
    Dim = 6,
    Rule = 7,
    Hard = 8,
    Wash = 9,
    OnInk = 10,
    Accent = 11,
    AccentSoft = 12,
    Danger = 13,
    DangerSolid = 14,
    DangerEdge = 15,
    OkSolid = 16,
    Ok = 17,
    OkFill = 18,
    Warn = 19,
    WarnFill = 20,
    WarnEdge = 21,
    OnFill = 22,
    Scrim = 23,
    ChartEdge = 24,
    Chart1 = 25,
    Chart2 = 26,
    Chart3 = 27,
    Chart4 = 28,
    Chart5 = 29,
    Fill1 = 30,
    Fill2 = 31,
    Fill3 = 32,
    Fill4 = 33,
    Fill5 = 34,
    Bone = 35,
    // 36 is baked into `arena.focus_ring_rgb`: the keyboard focus ring is
    // the foreground color in both appearances.
    FocusRing = 36,
}

/// A color that names a theme slot instead of carrying a value. Resolved by
/// the paint pass, so it follows `appearance()` with no effect attached.
fn role_token(slot: int) -> string {
    return "@{{slot}}"
}

fn paper() -> string { return role_token(ROLE.Paper) }
/// Card / popover / dialog surface.
fn plate() -> string { return role_token(ROLE.Plate) }
/// Muted / secondary / accent background (hover, chips, tab tray).
fn raised() -> string { return role_token(ROLE.Raised) }
/// Foreground text. `ink` is the strongest ink.
fn ink() -> string { return role_token(ROLE.Ink) }
/// Muted-foreground: secondary text, labels on wash.
fn mute() -> string { return role_token(ROLE.Mute) }
/// Faint text: captions, overlines, placeholders.
fn dim() -> string { return role_token(ROLE.Dim) }
/// Border / input stroke.
fn rule() -> string { return role_token(ROLE.Rule) }
/// Stronger border: popovers, focus-ish outlines.
fn hard() -> string { return role_token(ROLE.Hard) }
/// Soft fill for code blocks and inset panels.
fn wash() -> string { return role_token(ROLE.Wash) }
/// Text on `accent` (primary-foreground).
fn on_ink() -> string { return role_token(ROLE.OnInk) }
/// Primary: fills for default buttons, switches, selection. Neutral.
fn accent() -> string { return role_token(ROLE.Accent) }
/// Soft accent surface (`secondary`): soft buttons, pressed toggles.
fn accent_soft() -> string { return role_token(ROLE.AccentSoft) }
/// Destructive text (errors, destructive alerts).
fn danger() -> string { return role_token(ROLE.Danger) }
/// Destructive fill (destructive buttons, filled danger badges).
fn danger_solid() -> string { return role_token(ROLE.DangerSolid) }
/// Destructive border: destructive/50 in light, full in dark.
fn danger_edge() -> string { return role_token(ROLE.DangerEdge) }
/// Solid success fill (ok badges). Deeper than `ok` so white text holds.
fn ok_solid() -> string { return role_token(ROLE.OkSolid) }
/// Success tint.
fn ok() -> string { return role_token(ROLE.Ok) }
/// Success wash.
fn ok_fill() -> string { return role_token(ROLE.OkFill) }
/// Warning tint: alert icons, warning chips/pips.
fn warn() -> string { return role_token(ROLE.Warn) }
/// Warning wash (soft warning badges, alert fills).
fn warn_fill() -> string { return role_token(ROLE.WarnFill) }
/// Warning border: soft in light, full in dark.
fn warn_edge() -> string { return role_token(ROLE.WarnEdge) }
/// Text on danger fills is white in both appearances.
fn on_danger() -> string { return role_token(ROLE.OnFill) }
/// Text on ok fills is white in both appearances.
fn on_ok() -> string { return role_token(ROLE.OnFill) }
/// Modal scrim behind dialogs and popovers.
fn scrim() -> string { return role_token(ROLE.Scrim) }
/// Skeleton fill: borders in light, raised in dark.
fn bone() -> string { return role_token(ROLE.Bone) }

/// Theme roles so native thumbs (switch / slider) follow appearance at paint.
/// 32 primary, 33 input track, 34 thumb (background), 35 primary/20 track.
/// Theme roles so native thumbs (switch / slider) follow appearance at paint.
/// The four slots are palette-backed: text (32), line (33), surface/card
/// (34), and line_strong (35), so restyling the palette restyles the thumbs.
fn ensure_role_colors() {
    if roles_ready != 0 {
        return
    }
    roles_ready = 1
    theme(ROLE.Paper, parse_hex_color(LIGHT.bg), parse_hex_color(DARK.bg))
    theme(ROLE.Plate, parse_hex_color(LIGHT.card), parse_hex_color(DARK.card))
    theme(ROLE.Raised, parse_hex_color(LIGHT.raised), parse_hex_color(DARK.raised))
    theme(ROLE.Ink, parse_hex_color(LIGHT.text), parse_hex_color(DARK.text))
    theme(ROLE.Mute, parse_hex_color(LIGHT.muted), parse_hex_color(DARK.muted))
    theme(ROLE.Dim, parse_hex_color(LIGHT.faint), parse_hex_color(DARK.faint))
    theme(ROLE.Rule, parse_hex_color(LIGHT.line), parse_hex_color(DARK.line))
    theme(ROLE.Hard, parse_hex_color(LIGHT.line_strong), parse_hex_color(DARK.line_strong))
    theme(ROLE.Wash, parse_hex_color(LIGHT.wash), parse_hex_color(DARK.wash))
    theme(ROLE.OnInk, parse_hex_color(LIGHT.on_solid), parse_hex_color(DARK.on_solid))
    theme(ROLE.Accent, parse_hex_color(LIGHT.accent), parse_hex_color(DARK.accent))
    theme(ROLE.AccentSoft, parse_hex_color(LIGHT.accent_soft), parse_hex_color(DARK.accent_soft))
    theme(ROLE.Danger, parse_hex_color(LIGHT.danger), parse_hex_color(DARK.danger))
    theme(ROLE.DangerSolid, parse_hex_color(LIGHT.danger_solid), parse_hex_color(DARK.danger_solid))
    theme(ROLE.DangerEdge, parse_hex_color(LIGHT.danger_edge), parse_hex_color(DARK.danger_edge))
    theme(ROLE.OkSolid, parse_hex_color(LIGHT.ok_solid), parse_hex_color(DARK.ok_solid))
    theme(ROLE.Ok, parse_hex_color(LIGHT.success), parse_hex_color(DARK.success))
    theme(ROLE.OkFill, parse_hex_color(LIGHT.success_fill), parse_hex_color(DARK.success_fill))
    theme(ROLE.Warn, parse_hex_color(LIGHT.warn), parse_hex_color(DARK.warn))
    theme(ROLE.WarnFill, parse_hex_color(LIGHT.warn_fill), parse_hex_color(DARK.warn_fill))
    theme(ROLE.WarnEdge, parse_hex_color(LIGHT.warn_edge), parse_hex_color(DARK.warn_edge))
    theme(ROLE.OnFill, parse_hex_color(LIGHT.on_fill), parse_hex_color(DARK.on_fill))
    theme(ROLE.Scrim, parse_hex_color(LIGHT.scrim), parse_hex_color(DARK.scrim))
    theme(ROLE.ChartEdge, parse_hex_color(LIGHT.chart_edge), parse_hex_color(DARK.chart_edge))
    theme(ROLE.Chart1, parse_hex_color(LIGHT.chart1), parse_hex_color(DARK.chart1))
    theme(ROLE.Chart2, parse_hex_color(LIGHT.chart2), parse_hex_color(DARK.chart2))
    theme(ROLE.Chart3, parse_hex_color(LIGHT.chart3), parse_hex_color(DARK.chart3))
    theme(ROLE.Chart4, parse_hex_color(LIGHT.chart4), parse_hex_color(DARK.chart4))
    theme(ROLE.Chart5, parse_hex_color(LIGHT.chart5), parse_hex_color(DARK.chart5))
    theme(ROLE.Fill1, parse_hex_color(LIGHT.fill1), parse_hex_color(DARK.fill1))
    theme(ROLE.Fill2, parse_hex_color(LIGHT.fill2), parse_hex_color(DARK.fill2))
    theme(ROLE.Fill3, parse_hex_color(LIGHT.fill3), parse_hex_color(DARK.fill3))
    theme(ROLE.Fill4, parse_hex_color(LIGHT.fill4), parse_hex_color(DARK.fill4))
    theme(ROLE.Fill5, parse_hex_color(LIGHT.fill5), parse_hex_color(DARK.fill5))
    theme(ROLE.Bone, parse_hex_color(LIGHT.line), parse_hex_color(DARK.raised))
    theme(ROLE.FocusRing, parse_hex_color(LIGHT.text), parse_hex_color(DARK.text))
}


/// Type scale. Canvas hosts draw one weight, so hierarchy leans on size and
/// color. 14 is the body workhorse.
const FONT_DISPLAY: int = 30
const FONT_HEADING: int = 20
const FONT_TITLE: int = 16
const FONT_BODY: int = 14
const FONT_CONTROL: int = 13
const FONT_CAPTION: int = 12
const FONT_OVERLINE: int = 11

const PAGE_PAD: int = 32
const SECTION: int = 24
/// Corner radii, small to extra large.
const RAD_SM: int = 6
const RAD_MD: int = 8
const RAD_LG: int = 10
const RAD_XL: int = 14
const RAD_FULL: int = 999
const BAR: int = 52
const DOT: int = 8
const HAIRLINE: int = 1

// --- UI scale (density + type, one knob) ---
/// Scale in percent; 100 is the design system's 1.0. Clamped to 50..200.
/// Applied once, in `apply_int`, as each geometry or type prop lands on a
/// node — so no widget multiplies anything itself. Read at build time, so
/// set it before building a retained tree; a `zeus.view` app re-reads it
/// every frame (zoom reacts live there).
let mut roles_ready: int = 0
let mut ui_scale: int = 100

fn set_scale(pct: int) {
    let mut v = pct
    if v < 50 {
        v = 50
    }
    if v > 200 {
        v = 200
    }
    ui_scale = v
}

/// Identity at scale 1.0. `x * 100 / 100 == x` for every non-negative int.
// --- typography ---

/// Set the typeface for every label the app draws. One family for the whole
/// app, applied by the host when it measures and draws — there is no
/// per-node family, because the design system uses one typeface and the
/// text ABI carries a pixel size only.
///
/// ```
/// zeus.set_font_family("Universal Sans")
/// ```
/// Pass `""` to fall back to the host's default UI font.
fn set_font_family(name: string) {
    arena.ensure()
    platform.plat_set_font_family(name)
}

/// Register a font the host does not ship, then make it current. `src` is a
/// file path on desktop or a URL on the web. Returns 1 when the host
/// accepted it, 0 when it did not — callers should keep working on the
/// fallback rather than assume the face is present.
///
/// ```
/// if zeus.load_font("Universal Sans", "./fonts/UniversalSans.woff2") == 0 {
///     zeus.set_font_family("Inter")
/// }
/// ```
fn load_font(family: string, src: string) -> int {
    arena.ensure()
    let ok = platform.plat_load_font(family, src)
    if ok != 0 {
        platform.plat_set_font_family(family)
    }
    return ok
}

/// Measure text in-tree from an external font, so every host computes the same
/// line box for the same (font, size, string). `src` is a file path on desktop
/// or a URL on the web.
///
/// Pair it with `load_font(family, src)` so the host *draws* with the same
/// face; this binds the bytes that layout measures with. Returns 1 when the
/// font was read and parsed, 0 when it could not be (the app then keeps host
/// measurement and should not assume the face is present).
///
/// ```
/// if zeus.use_font("./fonts/Inter.ttf") == 0 {
///     // host metrics remain in effect
/// }
/// ```
fn use_font(src: string) -> int {
    arena.ensure()
    return metrics.bind(platform.plat_font_bytes(src))
}

/// Bind already-loaded font bytes for in-tree measurement. The web host has no
/// filesystem, so a web app passes the bytes it fetched itself; desktop apps
/// can use `use_font` instead.
fn use_font_bytes(bytes: string) -> int {
    return metrics.bind(bytes)
}

/// Drop the external font; measurement falls back to the host default.
fn clear_font() {
    metrics.unbind()
}

/// A design px scaled by the UI-scale knob: `scaled(16)` is 16 at 100%,
/// 20 at 125%. Internal — `apply_int` calls it for every geometry and type
/// prop, which is the only place scaling happens. Widgets never call it.
fn scaled(v: int) -> int {
    return i32(i64(v) * i64(ui_scale) / i64(100))
}

// --- button geometry: heights 32/36/40px, side padding 12/16/32px ---

/// Side padding for a `SIZE` token. Button geometry is a set of small
/// pickers so a recipe reads one token and gets a consistent control.
fn button_padding_x(size: int) -> int {
    if size == SIZE.Sm { 12 } else if size == SIZE.Lg { 32 } else { 16 }
}

/// Control height for a `SIZE` token; see `button_padding_x`.
fn button_height(size: int) -> int {
    if size == SIZE.Sm { 32 } else if size == SIZE.Lg { 40 } else { 36 }
}

/// Label size for a `SIZE` token; see `button_padding_x`.
fn button_font(size: int) -> int {
    if size == SIZE.Sm { 12 } else { FONT_BODY }
}

/// Corner radius for a `SIZE` token; see `button_padding_x`.
fn button_radius(size: int) -> int {
    return RAD_MD
}

/// Fill for a `LOOK` token. Returns a theme accessor result, so calling it
/// inside a prop expression keeps the button following the palette.
fn button_background(look: int) -> string {
    match look {
        LOOK.Solid => { return accent() }
        LOOK.Soft => { return raised() }
        LOOK.Outline => { return plate() }
        LOOK.Danger => { return danger_solid() }
        _ => { return "" }
    }
}

/// Label color for a `LOOK` token; see `button_background`.
fn button_color(look: int) -> string {
    match look {
        LOOK.Solid => { return on_ink() }
        LOOK.Danger => { return on_danger() }
        _ => { return ink() }
    }
}

/// Border width for a `LOOK` token — only the outline look carries one.
fn button_border_width(look: int) -> int {
    match look {
        LOOK.Outline => { return HAIRLINE }
        _ => { return 0 }
    }
}

/// Border color for a `LOOK` token; see `button_border_width`.
fn button_border_color(look: int) -> string {
    match look {
        LOOK.Outline => { return rule() }
        _ => { return "" }
    }
}

// --- inline SVG icons (lucide, CC BY 4.0) ---
// The engine's svg reader knows path / circle, `currentColor`, and the
// stroke attrs used below. `Icon` tints them with the node's foreground.

