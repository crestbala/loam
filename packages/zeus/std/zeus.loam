fn raster_push_str(b: &mut []int, s: string) {
    let mut i = 0
    while i < s.len {
        b.push(s[i])
        i = i + 1
    }
}

/// The zero-copy blit contract, Loam side: the framebuffer's generation. A host
/// wraps the buffer once with a no-copy data provider (CGImage on native, a
/// typed-array view on web) and rebuilds that wrapper ONLY when this number
/// changes — which is reallocation, on a size or backing-scale change, not per
/// frame. Between changes the same bytes are handed over untouched, so there is
/// no per-frame full-buffer copy.
fn raster_blit_generation() -> int {
    return raster.raster_generation()
}

/// Blit the framebuffer we rasterized into to the host: the one place our
/// pixels leave the engine, and the only host call that is not a draw op.
/// Returns 1 when a host presented, 0 when none is listening (headless, or a
/// host without a blit path). Pair it with `scene_rasterize` to drive a frame
/// with our own rasterizer instead of the host's 2D API.
fn raster_blit() -> int {
    return scene.raster_blit()
}

/// Write the framebuffer as a binary PPM (P6). This is the headless capture
/// path: no graphics API, just the bytes we own, which is what lets a pixel
/// golden exist without a display. Returns 0 on success.
fn raster_dump_ppm(path: string) -> int {
    let w = raster.raster_width()
    let h = raster.raster_height()
    let mut b: []int = []int {}
    raster_push_str(&mut b, "P6\n{{w}} {{h}}\n255\n")
    let mut y = 0
    while y < h {
        let mut x = 0
        while x < w {
            b.push(raster.raster_get(x, y, 2))
            b.push(raster.raster_get(x, y, 1))
            b.push(raster.raster_get(x, y, 0))
            x = x + 1
        }
        y = y + 1
    }
    return sys.write_file(path, string_from_bytes(b))
}

/// Set the damage clip from this frame's damage list: the bounding box of the
/// damage rects. A bounding box is a superset of the union, so it can only
/// damage MORE than needed, never less — the safe direction. A full-damage
/// frame (or no damage) clears the clip.
fn raster_clip_from_damage() {
    raster.raster_clip_reset()
    if arena.damage_full != 0 {
        return
    }
    let n = arena.damage.len
    if n == 0 {
        return
    }
    let mut x0 = arena.damage[0].x
    let mut y0 = arena.damage[0].y
    let mut x1 = arena.damage[0].x + arena.damage[0].w
    let mut y1 = arena.damage[0].y + arena.damage[0].h
    let mut i = 1
    while i < n {
        let d = arena.damage[i]
        if d.x < x0 {
            x0 = d.x
        }
        if d.y < y0 {
            y0 = d.y
        }
        if d.x + d.w > x1 {
            x1 = d.x + d.w
        }
        if d.y + d.h > y1 {
            y1 = d.y + d.h
        }
        i = i + 1
    }
    if x1 > x0 {
        if y1 > y0 {
            raster.raster_clip_box(x0, y0, x1, y1)
        }
    }
}

fn damage_x(i: int) -> int {
    return arena.damage[i].x
}

fn damage_y(i: int) -> int {
    return arena.damage[i].y
}

fn damage_w(i: int) -> int {
    return arena.damage[i].w
}

fn damage_h(i: int) -> int {
    return arena.damage[i].h
}

/// Phase 4 diagnostics: build the frame's raster tile list from the damage list
/// (Phase 1) and return how many tiles it touches. Additive.
fn damage_tiles_build() -> int {
    return scene.damage_tiles_build()
}

fn damage_tiles_count() -> int {
    return scene.damage_tiles_count()
}

fn damage_tiles_x(i: int) -> int {
    return scene.damage_tiles_x(i)
}

fn damage_tiles_y(i: int) -> int {
    return scene.damage_tiles_y(i)
}

/// Byte size of one draw-list record (diagnostics for the Phase 11 layout
/// steps).
fn draw_op_bytes() -> int {
    if scene.draws.len == 0 {
        return 0
    }
    return __sizeof(scene.draws[0])
}

/// Total bytes held by the draw list at paint time.
fn draw_bytes() -> i64 {
    if scene.draws.len == 0 {
        return 0
    }
    return i64(scene.draws.len) * i64(__sizeof(scene.draws[0]))
}

/// Print the current draw list. The DRAW goldens diff this text, which is
/// why the format is stable and why paint order is deterministic.
fn dump_draw_list() {
    let n = scene.draws.len
    fmt.println("DRAW", n)
    for i in 0..n {
        let d = scene.draws[i]
        if d.kind == 0 {
            fmt.println("fill", d.x, d.y, d.w, d.h, d.rgb, d.radius)
        } else if d.kind == 1 {
            fmt.println("fill_a", d.x, d.y, d.w, d.h, d.rgb, d.alpha)
        } else if d.kind == 2 {
            fmt.println("text", d.x, d.y, d.rgb, d.font, d.text)
        } else if d.kind == 3 {
            fmt.println("text_int", d.x, d.y, d.value, d.rgb, d.font)
        } else if d.kind == 4 {
            fmt.println("text_wrap", d.x, d.y, d.w, d.text)
        } else if d.kind == 5 {
            fmt.println("svg", d.x, d.y, d.w, d.h, d.rgb)
        } else if d.kind == 6 {
            fmt.println("save")
        } else if d.kind == 7 {
            fmt.println("clip", d.x, d.y, d.w, d.h)
        } else if d.kind == 8 {
            fmt.println("restore")
        } else if d.kind == 9 {
            fmt.println("text_rot", d.x, d.y, d.rgb, d.font, d.w, d.text)
        } else if d.kind == 10 {
            fmt.println("image", d.x, d.y, d.w, d.h, d.alpha, d.radius, d.value)
        } else if d.kind == 11 {
            fmt.println("grad", d.x, d.y, d.w, d.h, d.rgb, d.value, d.radius)
        } else if d.kind == 12 {
            fmt.println("shadow", d.x, d.y, d.w, d.h, d.rgb, d.radius, d.alpha, d.font,
                         d.value % 256 - 128, d.value / 256 - 128)
        } else if d.kind == 13 {
            fmt.println("stroke", d.x, d.y, d.w, d.h, d.rgb, d.radius, d.font, d.alpha)
        } else if d.kind == 14 {
            fmt.println("fill4", d.x, d.y, d.w, d.h, d.rgb, d.alpha,
                         d.radius % 65536, d.radius / 65536,
                         d.value % 65536, d.value / 65536)
        } else if d.kind == 15 {
            fmt.println("xform", d.x, d.y, d.w, d.h, d.radius, d.font)
        }
    }
}

fn snapshot(width: int, height: int, build: fn() -> Node) {
    window("zeus-snap", width, height)
    let n = build()
    root(n)
    engine_layout(width, height)
    engine_paint()
    dump_draw_list()
}

/// Host async completion for `pick_image` (file input, photo library).
fn engine_picked_image(src: string, w: int, h: int) {
    if pick_dest.id > 0 {
        if src.len > 0 {
            set(pick_dest, src)
            if pick_w.id > 0 {
                set(pick_w, w)
            }
            if pick_h.id > 0 {
                set(pick_h, h)
            }
        }
        pick_dest = Signal { id: 0 }
        pick_w = Signal { id: 0 }
        pick_h = Signal { id: 0 }
    }
}
