//! `zeus` — UI toolkit. Native Cocoa and WASM/Canvas2D run the same source.
//!
//! Widgets are `Box` / `Text` / `Button` / `Input` / `Grid` / `Overlay` /
//! `Scroll` / `Svg` / `If` / `Loop` / `Each` / `For` / `VirtualList` /
//! `VirtualTable` / `App`. Hierarchy is a trailing block. Lists:
//! `zeus.signal([]T {})` + `Each` / `For` (reactive, keyed) or `Loop` (static,
//! one-shot) + `push_item` / `insert_item`. Windowed lists
//! (`VirtualList`, `For(..., row_h)`, `VirtualTable`) render visible rows
//! only; table rows and columns are structs.
//!
//! Reactivity is fine-grained, and the whole model is five rules:
//!
//!   1. A `signal` is a value with `get` / `set`. Reading one inside a
//!      reactive scope subscribes that scope to it — dependencies are
//!      discovered, never declared. `peek` reads without subscribing.
//!   2. An `effect` runs once, then re-runs whenever a signal it read
//!      changes. Effects are the edges of the graph.
//!   3. A `computed<T>` is a cached derivation, generic over its value type
//!      (a struct, a list, a string — not just int). It is lazy: an input
//!      change only marks it stale, and its body re-runs when something reads
//!      it. Each input's generation is recorded, so a recompute that does not
//!      actually change the value propagates no further.
//!   4. Components disappear. A widget fn is a *setup* function: it runs
//!      once, wires bindings to signals, and is never called again. There
//!      is no render loop and no component re-execution.
//!   5. Updates are surgical. Every dynamic prop (`Text("n = {{n.get()}}")`,
//!      `Image(photo.get())`) is its own effect over one node attribute, so a
//!      `set` repaints exactly the attributes that read it — no virtual
//!      DOM, no diffing, no tree walk.
//!
//! `scope` groups derivations that must not outlive the run that made them: a
//! re-run disposes everything the body created — effect rows, output cells and
//! stored bodies alike.
//!
//! Every widget is a `Component`: `slot` (parent stack), `bind`, `visible`,
//! press, then attach. Trailing blocks are `slot`. Recipes extend `Comp` /
//! `Box` — they do not call `ui_push` / `bind` / `show` themselves.
//! Named props fill a last-param struct. Restyle without forking by passing
//! the style prop straight to the widget — `Button("Go", radius = 4)`,
//! `Card(padding = 12)`, `Chip("pill", TINT.Ok, radius = 6)`. `Button` /
//! `Card` / `Chip` / `Comp` / `IconButton` / `Badge` / `Alert` / `Field` /
//! `TextInput` all take the same twelve: `background`, `color`, `radius`,
//! `padding`, `padding_x`, `padding_y`, `padding_top` / `_right` / `_bottom` /
//! `_left`, `margin_*`, `gap` / `gap_row` / `gap_col`, `width`, `height`, `font`, `border`,
//! `border_color`, `spacing`. Write them as plain data — `radius = 4`,
//! `background = paper()`. Text is a thunk: write `Text("n = {{n.get()}}")`
//! and the compiler lifts the expression, so a signal read inside it
//! repaints just that label. (`Text(|| "{{n.get()}}")` says the same
//! thing by hand.) Closures are for events: `on_click = fn() => ...`.
//! Omit a prop and the recipe's own value stands.
//! `Comp` is the function-widget primitive (`bind` / `visible` / `press` /
//! slot). No `View` trait — write `fn MyThing(p: MyProps)` and call `Comp`.
//! One UI-scale knob (`set_scale` percent) scales type and control chrome.
//! It is applied centrally, where a prop lands on a node, so widgets and
//! callers alike write plain design px — nothing calls a scale helper.
//! It is the identity at 100, so goldens hold at 1.0.
//! `Button` paints the themed chrome when you pass `look = LOOK.*` and
//! `size = SIZE.*`; without them it is a plain clickable label whose
//! background / color / width / height / `enabled` / `on_click` come from
//! the props. Keyboard: every click target is a tab stop; Tab walks the
//! focus ring in document order (Shift-Tab back), Enter/Space activate, and
//! the focused control paints a 2px ring (keyboard focus only — pointer
//! clicks clear it).
//!
//! Example:
//! ```
//! import "std:zeus"
//!
//! fn main() {
//!     let n = zeus.signal(0)
//!     zeus.App("Count", fn() {
//!         zeus.Box(align_direction = DIRECTION.Column, padding = 16, spacing = 8) {
//!             zeus.Text("Count", font = 22)
//!             zeus.Text("{{n.get()}}", font = 28)
//!             zeus.Box(align_direction = DIRECTION.Row, spacing = 8) {
//!                 zui.Button("-", look = zeus.LOOK.Ghost, size = zeus.SIZE.Md,
//!                             on_click = fn() => n.set(n.get() - 1))
//!                 zui.Button("+", look = zeus.LOOK.Solid, size = zeus.SIZE.Md,
//!                             on_click = fn() => n.set(n.get() + 1))
//!             }
//!         }
//!     })
//! }
//! ```
//!
//! `zeus.App(title, build)` is the entry: retained tree, view size from
//! the host (`window_size`); pass trailing `width`/`height` only to pin a
//! macOS/wasm window. Per-frame rebuild is `zeus.view` / `zeus.app`.
//! Hide live nodes with `If` / `show` (`Signal<int>` 0/1). `Box.show` is
//! the bool-thunk form of the same flag. Internals: `packages/zeus/std/zeuscore/*.loam`.
//! C is host FFI (`platform.loam`). `Node` is `{ id: int }`.
//! See `docs/boundary.md`. `ZEUS_HEADLESS=1` layouts once and exits.

import "zeuscore/geometry.loam"
import "zeuscore/platform.loam"
import "zeuscore/arena.loam"
import "zeuscore/raster.loam"
import "zeuscore/atlas.loam"
import "zeuscore/image.loam"
import "zeuscore/layout.loam"
import "zeuscore/metrics.loam"
import "zeuscore/scene.loam"
import "zeuscore/input.loam"
import "zeuscore/track.loam"
import "std:async"
import "std:fmt"
import "std:sys"
import "zeus_constants.loam"
import "structs.loam"
import "enums.loam"
import "zeusbase.loam"
import "zeus-components:colors"

let mut has_view: int = 0
let mut view_fn: fn() -> Node = empty_view


/// Open a window and build the tree once. The tree is retained: signals
/// update the props that read them, never a whole subtree.
/// Size comes from the host (`window_size`): on desktop that is the device
/// screen's work area and on iOS/Android the full screen, so an app opens
/// screen-filling. Trailing `width` / `height` pin an exact macOS/wasm window
/// instead (a first size before the view exists, and headless draw tests).
/// The desktop host bounds what a screen-sized window costs with its backing
/// scale (`ZEUS_BACKING_SCALE`), never by shrinking the window.
/// The root is a vertical scroller: children keep their intrinsic height and
/// a bar appears when they overflow. A full-bleed `VirtualList` inside should
/// `grow = 1` so it is the scrolling pane — nested momentum chaining is not
/// this function.
fn App(title: string, build: fn(), width: int = 0, height: int = 0) {
    init()
    let mut w = width
    let mut h = height
    let win_size = window_size()
    if w <= 0 {
        w = win_size.width
    }
    if h <= 0 {
        h = win_size.height
    }
    window(title, w, h)
    let top = raw_scroll()
    // Paint the page background on the root scroller itself (theme-aware,
    // like `Page`): when content rubber-bands past the top/bottom edge or
    // ends short of the viewport, the revealed strip stays paper instead of
    // showing the host's clear color (black on a dark window / wasm page).
    // Root already takes host safe-area insets (`inset_here(root)`).
    Component(top, background = role_token(ROLE.Paper))
    slot(top, build)
    root(top)
    raw_run()
}

fn raw_init() {
    arena.ensure()
}

fn open_window(title: string, width: int, height: int) {
    arena.ensure()
    arena.win_w = width
    arena.win_h = height
    platform.plat_set_window(title, width, height)
}

fn raw_run() {
    arena.ensure()
    if platform.plat_headless() != 0 {
        engine_layout(arena.win_w, arena.win_h)
        // With stats on, paint once so the draw list is part of the baseline.
        // With stats off this is exactly the old one-layout-and-exit path, so
        // no existing headless test changes.
        if arena.mem_stats_on() != 0 {
            engine_paint()
        }
        mem_stats_report()
        return
    }
    platform.plat_run()
    mem_stats_report()
}

/// Phase 0 memory report: arena buckets (arena side), the retained draw list,
/// and the host's process footprint. Printed once, on exit, and only when
/// `ZEUS_MEM_STATS` is on (build `-DZEUS_MEM_STATS`, or the env var). With
/// stats off this is a single host call that returns 0.
fn mem_stats_report() {
    if arena.mem_stats_on() == 0 {
        return
    }
    arena.mem_report()
    fmt.println("ZEUS_MEM draw_ops=", scene.draws.len, " draw_bytes=", draw_bytes())
    fmt.println("ZEUS_MEM process_kb=", memory_kb())
}

fn init() {
    raw_init()
    // Theme slots must exist before anything paints: a node stores a role,
    // and the paint pass resolves it against the palette registered here.
    ensure_role_colors()
}

/// Open a native window. Sizes are CSS-like points, not pixels.
/// Prefer `zeus.App(...)` over calling this alone.
fn window(title: string, width: int, height: int) {
    init()
    open_window(title, width, height)
}

/// Host view size in points: browser canvas, or the native content view.
struct WindowSize {
    width: int,
    height: int,
}

fn window_size() -> WindowSize {
    return WindowSize {
        width: platform.plat_view_width(),
        height: platform.plat_view_height(),
    }
}

/// Host process memory in KB for diagnostics UI: Apple phys_footprint
/// (Xcode's memory-gauge number), Linux/Android resident set, live wasm
/// heap on the web host (0 = unknown).
fn memory_kb() -> int {
    arena.ensure()
    return platform.plat_mem_kb()
}

/// Enter the event loop with `node` as the tree root.
/// `ZEUS_HEADLESS=1` layouts once and exits (tests). Prefer `zeus.App`.
fn run(node: Node) {
    init()
    arena.root_id = node.id
    raw_run()
}

/// GPUI-style: each frame rebuilds the element tree from signals.
/// Omit this and the tree stays retained (the `App` mode).
fn view(build: fn() -> Node) {
    init()
    view_fn = build
    has_view = 1
}

/// Open a window, install `build` as the per-frame view, and run.
/// Rebuilds the tree every layout. Prefer `zeus.App` for a retained tree.
///
/// Example:
/// ```
/// zeus.app("Demo", 400, 300, || {
///     zeus.Text("frame")
/// })
/// ```
fn app(title: string, width: int, height: int, build: fn() -> Node) {
    window(title, width, height)
    view(build)
    init()
    raw_run()
}

fn engine_key_apply(signal_id: int, mode: int, value: int, lo: int, hi: int) {
    arena.ensure()
    if mode == 5 {
        platform.plat_invoke_fn(value)
        return
    }
    if signal_id <= 0 {
        return
    }
    if signal_id >= arena.sigs.len {
        return
    }
    let mut next = arena.sigs[signal_id]
    if mode == 1 {
        if next == 0 {
            next = 1
        } else {
            next = 0
        }
    } else if mode == 2 {
        next = value
    } else if mode == 3 {
        next = next + value
    } else if mode == 4 {
        let mut vlo = lo
        let mut vhi = hi
        if vhi < vlo {
            let t = vlo
            vlo = vhi
            vhi = t
        }
        next = next + value
        if next < vlo {
            next = vlo
        }
        if next > vhi {
            next = vhi
        }
    } else {
        next = next + 1
    }
    arena.store_sig(signal_id, next)
}

fn refresh_lists() {
    let n = arena.nodes.len
    for i in 1..n {
        if arena.nodes[i].list_fn > 0 {
            platform.plat_invoke_fn(arena.nodes[i].list_fn)
        }
    }
}

fn virtual_stale() -> int {
    let n = arena.nodes.len
    for i in 1..n {
        if arena.nodes[i].row_h > 0 {
            if arena.nodes[i].list_fn > 0 {
                let w = virtual_window(i, arena.nodes[i].list_n, arena.nodes[i].row_h)
                if w.first != arena.nodes[i].list_lo {
                    return 1
                }
                if w.last != arena.nodes[i].list_hi {
                    return 1
                }
            }
        }
    }
    return 0
}

/// A refit host (chart, plot) whose measured width moved since its last
/// rebuild. Checked after the layout that measured it, so the refresh pass
/// rebuilds it with the width it will paint this very frame — no one-frame
/// lag and no empty band while a window is being resized.
fn refit_stale() -> int {
    let n = arena.nodes.len
    for i in 1..n {
        if arena.nodes[i].list_fn > 0 {
            if arena.nodes[i].w != arena.nodes[i].list_gen {
                return 1
            }
        }
    }
    return 0
}

fn engine_layout(width: int, height: int) {
    ensure_role_colors()
    arena.damage_frame_begin()
    // One frame of the async world first: steppers advance in-flight socket
    // state machines, then spawns and due timers fire. Callbacks set signals;
    // the rebuild and layout below paint their effect this very frame. Hosts
    // call this per frame (mac drawRect, web rAF, headless pump).
    async.tick()
    if arena.physics_step() != 0 {
        arena.mark_paint()
    }
    let mut resized = 0
    if width != arena.win_w {
        resized = 1
    }
    if height != arena.win_h {
        resized = 1
    }
    if has_view != 0 {
        arena.snapshot_focus()
        arena.snapshot_scroll()
        arena.reset_tree()
        platform.plat_key_reset()
        track.reset()
        let n = view_fn()
        arena.root_id = n.id
        arena.restore_scroll()
        arena.restore_focus()
        arena.mark_tree()
    }
    // A non-int signal write (array / string / bool) never passes through
    // `store_sig`, so its dirt is noted on the tracking module and drained here.
    if track.take_wrote() != 0 {
        arena.mark_layout()
        arena.mark_chrome()
    }
    // Layout runs only when the box model can have moved: a resize, a tree
    // build, or a discrete write that touched a layout prop. A frame whose
    // only dirt is PAINT — every animation frame — skips it entirely. When it
    // does run, a write that invalidated only a subpath of the tree can re-solve
    // that subtree instead of the whole surface (`layout.relayout`).
    let mut lay = 0
    if resized != 0 || arena.layout_dirty != 0 {
        lay = 1
    }
    let full = arena.take_layout_full()
    let dirty = arena.take_dirty_layout_nodes()
    // `whole` = re-solve the entire tree (and so repaint the whole surface).
    let mut whole = 1
    if lay == 0 {
        whole = 0
    } else if resized == 0 && full == 0 {
        if layout.relayout(dirty) != 0 {
            whole = 0
        }
    }
    last_whole = whole
    if whole != 0 {
        arena.damage_all()
    }
    if lay != 0 {
        arena.stamp_edits()
        if whole != 0 {
            layout.layout(width, height)
        }
        arena.layout_dirty = 0
        arena.mark_paint()
        layout_gen = layout_gen + 1
    }
    // Windowed lists size their window from the scroller's laid-out height and
    // its scroll, and refit hosts (charts) rebuild when this frame's layout
    // moved their width. One refresh pass covers both; a second layout applies
    // the new rows / fresh chart width. A pure scroll frame that stays inside
    // the mounted window skips both.
    if lay != 0 || arena.virtual_dirty != 0 {
        if (virtual_stale() != 0) || (refit_stale() != 0) {
            refresh_lists()
            layout.layout(width, height)
            arena.layout_dirty = 0
        }
        arena.virtual_dirty = 0
    }
    if lay != 0 {
        // Positions moved, so pointer-over targets may have changed.
        arena.mark_chrome()
    }
    // The shared interaction-state pass: recompute hover/press/tween/fade
    // targets and (re)target their paint tracks. Event-driven, never per frame.
    if arena.chrome_dirty != 0 {
        // A pointer move, a scroll, a layout change or a tree change can move
        // every hot target: re-sync all of them and drop any targeted queue.
        arena.sync_chrome_all()
        arena.chrome_dirty = 0
        arena.clear_chrome_ids()
    } else if arena.chrome_ids_len() != 0 {
        // Only the flagged nodes changed: re-sync just them.
        arena.sync_chrome_targeted()
    }
    if arena.mem_stats_on() != 0 {
        arena.mem_sample()
    }
}

fn engine_fill_focus() {
    arena.fill_focus_chain()
}

fn engine_focus_depth() -> int {
    return arena.chain_nodes.len
}

fn engine_focus_node(i: int) -> int {
    if i < 0 {
        return 0
    }
    if i >= arena.chain_nodes.len {
        return 0
    }
    return arena.chain_nodes[i]
}

fn engine_focus_ctx(i: int) -> int {
    if i < 0 {
        return 0
    }
    if i >= arena.chain_ctxs.len {
        return 0
    }
    return arena.chain_ctxs[i]
}

fn engine_focus_step(back: int) -> int {
    return arena.focus_step(back)
}

fn engine_focus_captures_text() -> int {
    return arena.focus_captures_text()
}

/// Node id that currently holds focus (0 = none). Stable across a keyed
/// reorder, because the row's node is moved rather than rebuilt.
fn engine_focus_id() -> int {
    return arena.focus_id
}

fn engine_key(key: int) -> int {
    return input.key(key)
}

/// Insert UTF-8 into the focused input (IME commit, paste). Headless tests
/// can call this instead of synthesizing one key per byte.
fn engine_insert(text: string) -> int {
    return input.insert_text(text)
}

/// IME composition overlay on the focused input. Empty clears the mark.
fn engine_marked(text: string) -> int {
    return input.mark_text(text)
}

fn engine_set_mods(mods: int) {
    arena.ev_mods = mods
}

fn engine_key_ev(key: int, mods: int) -> int {
    arena.ensure()
    arena.ev_mods = mods
    return platform.plat_key_ev(key, mods)
}

/// Key release, from hosts that deliver it. Runs the focused node's
/// `on_key_up`, then `on_key_press` — the down→up cycle.
fn engine_key_up(key: int, mods: int) -> int {
    arena.ensure()
    return input.key_handlers(key, mods, 1)
}

// --- engine trampolines ---
/// Cocoa calls these through zeus_plat.c (`loam_zeus_engine_*`). Do not use
/// from app code; use `App`, clicks, and signals instead.

fn engine_paint() {
    arena.damage_frame_begin()
    scene.paint()
}

/// One host frame with its own delta. `zeus_step(delta_ms)` in the runtime passes the
/// delta here; the cap keeps a backgrounded app from jumping when it wakes.
/// Tests and headless pumps call `engine_step()` (a nominal 16 ms).
fn engine_step_dt(dt_ms: int) -> int {
    let mut delta_ms = dt_ms
    if delta_ms <= 0 {
        delta_ms = 16
    }
    if delta_ms > 64 {
        delta_ms = 64
    }
    let d = scene.step(delta_ms)
    // A layout-driving `animate` reflows in this same frame so paint sees
    // the new box. Hover / press still skip layout: they never push a
    // layout-anim binding.
    if arena.take_layout_anim_moved() != 0 {
        apply_layout_anims()
        if arena.root_id > 0 {
            layout.layout(arena.win_w, arena.win_h)
            arena.layout_dirty = 0
            layout_gen = layout_gen + 1
        }
    }
    // While an async op is in flight or a spawn waits, hosts must keep
    // drawing frames: only a frame's tick advances them. Coasting scroll
    // is the same: keep frames until velocity and overscroll settle.
    if async.busy() != 0 {
        return 1
    }
    if arena.physics_live() != 0 {
        return 1
    }
    if arena.anim_live() != 0 {
        return 1
    }
    return d
}

fn engine_step() -> int {
    return engine_step_dt(16)
}

/// Milliseconds until the next async timer is due (0 = none; -1 = a spawn
/// waits). Native hosts that stop drawing when idle use this to schedule the
/// next frame exactly at the deadline. Coasts at ~60 fps while a scroller
/// is in motion.
fn engine_next_ms() -> int {
    if arena.physics_live() != 0 {
        return 16
    }
    if arena.anim_live() != 0 {
        return 16
    }
    if arena.spin_live() != 0 {
        return 16
    }
    // A shown scrollbar thumb needs one wake at its hide deadline.
    let bar = arena.bar_next_ms()
    let due = async.next_due()
    if bar > 0 {
        if due <= 0 || bar < due {
            return bar
        }
    }
    return due
}

// --- Phase 3 proof harness ------------------------------------------------
/// Component-function runs since boot. Flat across an animation.
fn proof_components() -> int {
    return arena.component_runs
}
/// Reactive-effect runs since boot. Flat across an animation.
fn proof_effects() -> int {
    return track.runs
}
/// Signal setters fired from inside the animation tick. Must stay 0.
fn proof_signal_writes() -> int {
    return arena.anim_signal_writes
}
/// Active animation tracks.
fn proof_anim_live() -> int {
    return arena.anim_live_count()
}
/// 1 while an indeterminate spinner is visible and not reduced-motion-suppressed.
fn proof_spin_live() -> int {
    return arena.spin_live()
}
/// Allocations since boot (runtime allocator). A frame that only animates
/// allocates nothing, so this must not move while a track is running.
fn proof_allocs() -> int {
    return platform.plat_alloc_count()
}

/// High-water size of the effect table. A `scope` that re-runs must reuse the
/// rows it disposed, so this stays flat across re-runs; exposed for tests.
fn reactive_rows() -> int {
    return track.effect_rows()
}
/// The paint value a bound signal currently resolves to: the interpolated
/// overlay while `animate` runs, else the signal's state. Tests use it to see
/// the animation without a component thunk re-running.
fn anim_paint(sig: Signal<int>) -> int {
    return arena.sig_val(sig.id)
}

/// Shape a 0..1000 linear progress into the named `EASE` curve. Same helper
/// the track pool uses; tests lock samples so a control-point or solver
/// change is visible.
fn anim_ease(easing: int, t: int) -> int {
    return arena.anim_ease(easing, t)
}
/// Host / app reduced-motion preference: animations jump to their final value.
fn set_reduced_motion(on: bool) {
    arena.ensure()
    if on {
        arena.reduced = 1
    } else {
        arena.reduced = 0
    }
}

/// Host trampoline: the OS reports a reduced-motion preference (Cocoa, iOS,
/// web `prefers-reduced-motion`, Android animator scale).
fn engine_set_reduced_motion(on: int) {
    arena.ensure()
    arena.reduced = on
}

/// Host trampoline and test hook: set the safe-area insets the next layout
/// pass will read (`plat_inset_*`). iOS / Android already call the C setter
/// from the view; tests use this so a notched viewport is deterministic.
fn engine_set_insets(top: int, right: int, bottom: int, left: int) {
    arena.ensure()
    platform.plat_set_insets(top, right, bottom, left)
    arena.mark_layout()
}

/// Test hook: 1 = treat this process as an overlay-scroll (touch) host.
/// iOS / Android already compile that way; desktop tests use this so a
/// 44dp hit target can be asserted without a device.
fn engine_set_overlay_scroll(on: int) {
    arena.ensure()
    platform.plat_set_overlay_scroll(on)
}

/// One headless host frame: async tick, rebuild + layout, then paint. Tests
/// use this instead of calling `engine_layout` by hand.
fn pump_frame() {
    engine_layout(arena.win_w, arena.win_h)
    engine_paint()
}

fn engine_click(px: int, py: int) -> int {
    return input.click(px, py)
}

fn click_id(id: int) -> int {
    let mut i = id
    while i > 0 {
        if arena.nodes[i].click_fn > 0 {
            return click_node(i)
        }
        i = arena.nodes[i].parent
    }
    return click_node(id)
}

/// Click the centre of `id`, in *window* coordinates: `nodes[id].x/y` are
/// content coordinates, so a scrolled node needs its scrollers' offsets
/// removed or the point lands off screen.
fn click_node(id: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= arena.nodes.len {
        return 0
    }
    let o = layout.screen_origin(id)
    let x = o.x + arena.nodes[id].w / 2
    let y = o.y + arena.nodes[id].h / 2
    return input.click(x, y)
}

/// Node id whose `text` or `a11y_label` equals `label` (tests, headless
/// hosts). 0 when nothing visible matches. Hidden nodes are skipped.
fn engine_find_text(label: string) -> int {
    let n = arena.nodes.len
    for i in 1..n {
        if arena.want_show(i) == 0 {
            continue
        }
        if fmt.eq(arena.nodes[i].text, label) {
            return i
        }
        if fmt.eq(arena.nodes[i].a11y_label, label) {
            return i
        }
    }
    return 0
}

/// Ancestor-aware text presence for tests: 1 when a node whose ancestors are
/// all visible carries `label`. `engine_find_text` only checks the node's own
/// visibility, so it cannot see a child of a hidden container.
fn text_visible(label: string) -> bool {
    let n = arena.nodes.len
    for i in 1..n {
        if arena.shown_in_tree(i) == 0 {
            continue
        }
        if fmt.eq(arena.nodes[i].text, label) {
            return true
        }
        if fmt.eq(arena.nodes[i].a11y_label, label) {
            return true
        }
    }
    return false
}

/// Node id whose `a11y_role` equals `role` (tests, headless hosts); the
/// first match in tree order, 0 when none is visible.
fn engine_find_role(role: string) -> int {
    let n = arena.nodes.len
    for i in 1..n {
        if arena.want_show(i) == 0 {
            continue
        }
        if fmt.eq(arena.nodes[i].a11y_role, role) {
            return i
        }
    }
    return 0
}

let mut A11Y_out: []int = []int {}

fn a11y_push(s: string) {
    let mut i = 0
    while i < s.len {
        push(A11Y_out, s[i])
        i = i + 1
    }
}

fn a11y_num(v: int) {
    let mut x = v
    if x < 0 {
        push(A11Y_out, 45)
        x = 0 - x
    }
    if x == 0 {
        push(A11Y_out, 48)
        return
    }
    let mut buf = []int {}
    while x > 0 {
        push(buf, 48 + x % 10)
        x = x / 10
    }
    let mut k = buf.len
    while k > 0 {
        k = k - 1
        push(A11Y_out, buf[k])
    }
}

/// Counts layout passes. A host that mirrors the semantic tree (`engine_a11y_dump`)
/// polls this and only re-dumps when it moved: the dump builds a fresh string
/// every call and strings are never freed, so dumping per paint frame leaked
/// ~16 KB a frame on the web host.
let mut layout_gen: int = 0
/// 1 when the last `engine_layout` re-solved the whole tree, 0 when it re-solved
/// only a subtree (Phase 5). Exposed for tests as `layout_was_full`.
let mut last_whole: int = 1

fn engine_layout_gen() -> int {
    return layout_gen
}

fn layout_was_full() -> int {
    return last_whole
}

/// Nodes the last interaction-state (chrome) pass visited, then reset. A write
/// that names the nodes it touched visits only them; a pointer / layout frame
/// visits all of them. Exposed for tests.
fn chrome_sync_count() -> int {
    return arena.take_chrome_sync_count()
}

/// Serialize the visible **semantic tree** for an accessibility mirror (§2.3):
/// one `depth<TAB>role<TAB>label<TAB>x<TAB>y<TAB>w<TAB>h` line per node
/// carrying a role, a label, or visible text. Geometry lets a native host
/// place accessible frames; the web mirror uses role and label only. The UI
/// stays canvas — hosts relay this to a visually-hidden DOM on web, or to
/// `NSAccessibility` on native. A node with a label but no role is a `text`
/// node; the label falls back to its visible text.
///
/// Builds a fresh string, and strings are never freed: a host that polls
/// (the web mirror) reads `engine_a11y_bytes` instead, which hands back the
/// refcounted byte buffer to copy and drop.
fn engine_a11y_dump() -> string {
    a11y_build()
    return string_from_bytes(A11Y_out)
}

/// The semantic-tree lines as bytes (same content as `engine_a11y_dump`), in
/// a `[]int` the host copies out and drops — no string, nothing leaks.
fn engine_a11y_bytes() -> []int {
    a11y_build()
    return A11Y_out
}

fn a11y_build() {
    A11Y_out = []int {}
    let n = arena.nodes.len
    let mut i = 1
    while i < n {
        if arena.want_show(i) != 0 {
            let role = arena.nodes[i].a11y_role
            let label = arena.nodes[i].a11y_label
            let txt = arena.nodes[i].text
            if role.len > 0 || label.len > 0 || txt.len > 0 {
                let mut r = role
                let mut l = label
                if l.len == 0 {
                    l = txt
                }
                if r.len == 0 {
                    r = "text"
                }
                let mut d = 0
                let mut p = arena.nodes[i].parent
                while p > 0 {
                    d = d + 1
                    p = arena.nodes[p].parent
                }
                a11y_num(d)
                push(A11Y_out, 9)
                a11y_push(r)
                push(A11Y_out, 9)
                a11y_push(l)
                push(A11Y_out, 9)
                a11y_num(arena.nodes[i].x)
                push(A11Y_out, 9)
                a11y_num(arena.nodes[i].y)
                push(A11Y_out, 9)
                a11y_num(arena.nodes[i].w)
                push(A11Y_out, 9)
                a11y_num(arena.nodes[i].h)
                push(A11Y_out, 10)
            }
        }
        i = i + 1
    }
}

/// Inspector dump of the retained tree (devtools §2.4): one
/// `id<TAB>parent<TAB>x<TAB>y<TAB>w<TAB>h<TAB>role<TAB>label` line per visible
/// node, in tree order. Geometry is what the last layout pass produced.
fn engine_tree_dump() -> string {
    A11Y_out = []int {}
    let n = arena.nodes.len
    let mut i = 1
    while i < n {
        if arena.want_show(i) != 0 {
            a11y_num(i)
            push(A11Y_out, 9)
            a11y_num(arena.nodes[i].parent)
            push(A11Y_out, 9)
            a11y_num(arena.nodes[i].x)
            push(A11Y_out, 9)
            a11y_num(arena.nodes[i].y)
            push(A11Y_out, 9)
            a11y_num(arena.nodes[i].w)
            push(A11Y_out, 9)
            a11y_num(arena.nodes[i].h)
            push(A11Y_out, 9)
            a11y_push(arena.nodes[i].a11y_role)
            push(A11Y_out, 9)
            let l = arena.nodes[i].a11y_label
            if l.len > 0 {
                a11y_push(l)
            } else {
                a11y_push(arena.nodes[i].text)
            }
            push(A11Y_out, 10)
        }
        i = i + 1
    }
    return string_from_bytes(A11Y_out)
}

/// Inspector dump of live signal values (devtools §2.4): one `id<TAB>value`
/// line per int-mirrored signal slot.
fn engine_signals_dump() -> string {
    A11Y_out = []int {}
    let n = arena.sigs.len
    let mut i = 0
    while i < n {
        a11y_num(i)
        push(A11Y_out, 9)
        a11y_num(arena.sigs[i])
        push(A11Y_out, 10)
        i = i + 1
    }
    return string_from_bytes(A11Y_out)
}

/// Restore signal values from an `engine_signals_dump()` snapshot. Returns how
/// many slots were applied. This is the hot-reload primitive (§2.5): save the
/// arena before a rebuild, restore after. Ids are positional, so the dev loop
/// should only restore when the new build's signal set still lines up.
fn engine_state_load(s: string) -> int {
    let mut i = 0
    let mut applied = 0
    while i < s.len {
        let mut id = 0
        let mut have_id = 0
        while i < s.len {
            let b = s[i]
            i = i + 1
            if b == 9 {
                break
            }
            if b == 10 {
                break
            }
            if b >= 48 {
                if b <= 57 {
                    id = id * 10 + (b - 48)
                    have_id = 1
                }
            }
        }
        let mut v = 0
        let mut vhave = 0
        let mut neg = 0
        while i < s.len {
            let b = s[i]
            if b == 10 {
                i = i + 1
                break
            }
            if b == 45 {
                neg = 1
            } else if b >= 48 {
                if b <= 57 {
                    v = v * 10 + (b - 48)
                    vhave = 1
                }
            }
            i = i + 1
        }
        if have_id == 1 {
            if vhave == 1 {
                if neg == 1 {
                    v = 0 - v
                }
                arena.store_sig(id, v)
                applied = applied + 1
            }
        }
    }
    return applied
}

/// Whether a node is currently shown by its own show binding (tests).
/// Hidden ancestors still hide it from paint and hit tests.
fn node_visible(id: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= arena.nodes.len {
        return 0
    }
    return arena.want_show(id)
}

/// Click the control whose label or `a11y_label` is `label`. Tests use this
/// instead of pixel coordinates.
fn engine_click_text(label: string) -> int {
    let id = engine_find_text(label)
    if id <= 0 {
        return 0
    }
    return click_id(id)
}

fn engine_scroll(px: int, py: int, dx: int, dy: int) -> int {
    return input.scroll(px, py, dx, dy)
}

/// Discrete scroll step (mouse wheel notch / web line wheel): applies the
/// delta with no momentum. Tests and hosts use this for input that must stop
/// exactly where it lands.
fn engine_scroll_step(px: int, py: int, dx: int, dy: int) -> int {
    return input.scroll_step(px, py, dx, dy)
}

/// Mouse-wheel notch: eases to the target over ~150 ms (browser feel).
fn engine_scroll_smooth(px: int, py: int, dx: int, dy: int) -> int {
    return input.scroll_smooth(px, py, dx, dy)
}

fn engine_drag(px: int, py: int) -> int {
    return input.drag(px, py)
}

fn engine_mouseup() {
    input.mouseup()
}

fn engine_hover(px: int, py: int) -> int {
    return input.hover(px, py)
}

fn engine_over_button() -> int {
    return input.over_button()
}

/// CSS cursor name under the pointer: the most recently created node with an
/// explicit `cursor` wins (children outrank parents). "" = default arrow.
fn engine_cursor() -> string {
    return input.cursor_at()
}

/// Set a cursor name directly on any node (native thumbs have no props).
fn cursor(n: Node, s: string) -> Node {
    arena.nodes[n.id].cursor = s
    return n
}

fn draw_count() -> int {
    return scene.draws.len
}

/// Op kind of draw `i` (tests): 1 fill, 2 text, 7 clip, 11 gradient, 12 shadow.
fn draw_op(i: int) -> int {
    return scene.draws[i].kind
}
/// Left edge of draw `i` (tests).
fn draw_x(i: int) -> int {
    return scene.draws[i].x
}
/// Top edge of draw `i` (tests).
fn draw_y(i: int) -> int {
    return scene.draws[i].y
}
/// Width of draw `i` (tests).
fn draw_w(i: int) -> int {
    return scene.draws[i].w
}
/// Height of draw `i` (tests).
fn draw_h(i: int) -> int {
    return scene.draws[i].h
}
/// Colour of draw `i` (tests).
fn draw_rgb(i: int) -> int {
    return scene.draws[i].rgb
}
/// Corner radius of draw `i` (tests).
fn draw_radius(i: int) -> int {
    return scene.draws[i].radius
}
/// Alpha of draw `i` (tests).
fn draw_alpha(i: int) -> int {
    return scene.draws[i].alpha
}
/// The `font` field of draw `i`: pixel size for text, stroke width for a
/// stroke, blur for a shadow, gradient axis for a gradient (tests).
fn draw_font(i: int) -> int {
    return scene.draws[i].font
}
/// The `value` field of draw `i` (tests).
fn draw_value(i: int) -> int {
    return scene.draws[i].value
}
/// The `text` field of draw `i` (tests).
fn draw_text(i: int) -> string {
    return scene.draws[i].text
}

/// Layout results for tests: the box of the node that matched
/// `engine_find_text`. Positions are window-space after the last layout.
fn node_x(id: int) -> int {
    return arena.nodes[id].x
}

/// A node's fill as the paint pass sees it: a stored role token resolved
/// against the current appearance. Tests use it to prove a theme switch
/// repaints without re-running any prop.
fn node_background_rgb(id: int) -> int {
    arena.ensure()
    return arena.paint_rgb(arena.nodes[id].bg)
}

/// A node's accessible label (or its text when it has none), for tests.
fn node_label(id: int) -> string {
    if arena.nodes[id].a11y_label.len > 0 {
        return arena.nodes[id].a11y_label
    }
    return arena.nodes[id].text
}

/// Resolved foreground (text / icon tint) of a node id, as `node_background_rgb`.
fn node_color_rgb(id: int) -> int {
    arena.ensure()
    return arena.fg_of(id)
}

/// Laid-out top edge of a node id. The id-based accessors exist for tests
/// and engine code that hold an id rather than a `Node`.
fn node_y(id: int) -> int {
    return arena.nodes[id].y
}

/// Laid-out width of a node id; see `node_y`.
fn node_width(id: int) -> int {
    return arena.nodes[id].w
}

/// Laid-out height of a node id; see `node_y`.
fn node_height(id: int) -> int {
    return arena.nodes[id].h
}

/// Parent id in the retained tree (0 = root). Tests walk scroll chains with this.
fn node_parent(id: int) -> int {
    return arena.nodes[id].parent
}

/// Engine kind: 11 is a scroll pane.
fn node_kind(id: int) -> int {
    return int(arena.nodes[id].kind)
}

/// Current vertical scroll offset of node `id` (tests, `scroll_to`).
fn node_scroll_y(id: int) -> int {
    return arena.nodes[id].scroll_y
}

/// Current horizontal scroll offset of node `id`.
fn node_scroll_x(id: int) -> int {
    return arena.nodes[id].scroll_x
}

/// Max vertical scroll of node `id` (`content - viewport`, 0 if no overflow).
fn node_scroll_max(id: int) -> int {
    return arena.scroll_max(id)
}

/// Live slot counts (diagnostics for tests). `nodes` includes dead slots
/// waiting to be recycled; `sigs` is the same for signals. A streaming `For`
/// that rebuilds without growing the tree keeps both constant.
fn arena_nodes() -> int {
    return arena.nodes.len
}

fn arena_sigs() -> int {
    return arena.sigs.len
}

/// Byte size of one arena node record (diagnostics for the Phase 11 layout
/// steps).
fn node_bytes() -> int {
    if arena.nodes.len == 0 {
        return 0
    }
    return __sizeof(arena.nodes[0])
}

/// Total bytes held by live arena node records.
fn arena_bytes() -> i64 {
    if arena.nodes.len == 0 {
        return 0
    }
    return i64(arena.nodes.len) * i64(__sizeof(arena.nodes[0]))
}

/// Phase 0 diagnostics: live (non-recycled) node count. Additive; no
/// allocation behavior reads it. See `docs/mem-baseline.md`.
fn mem_live_nodes() -> int {
    return arena.mem_live_nodes()
}

/// Phase 0 diagnostics: total arena bytes across every bucket (nodes, signals,
/// interning, animation, misc). Additive; no allocation behavior reads it.
fn mem_bytes() -> i64 {
    return arena.mem_total_bytes()
}

/// Phase 0 diagnostics: print the full arena bucket report on demand. Same
/// lines the on-exit report prints; for tests and probes that need to see which
/// bucket moved between frames.
fn mem_dump() {
    arena.mem_report()
}

/// Phase 1 damage diagnostics: 1 when the last frame repainted the whole
/// surface (layout, tree rebuild, resize, or an unmarked global change).
/// Additive; no paint behavior reads these.
fn damage_full() -> int {
    return arena.damage_full
}

/// Phase 1 damage diagnostics: rects contributed by the last frame's paint.
/// Empty when `damage_full()` is 1. Additive.
fn damage_count() -> int {
    return arena.damage.len
}

/// Phase 2 node-arena ceiling (see `arena.alloc_node`). Default 65535, the
/// `u16` id maximum. Additive diagnostics; `engine_set_node_cap` is a tuning /
/// test hook.
fn node_cap() -> int {
    return arena.node_cap_get()
}

fn node_overflow() -> int {
    return arena.node_overflow_get()
}

fn engine_set_node_cap(n: int) {
    arena.set_node_cap(n)
}

