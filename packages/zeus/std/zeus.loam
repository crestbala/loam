// --- images: decode (Phase 4) ---------------------------------------------

/// Decode a PNG into the reusable source buffers (RGBA8, premultiplied).
/// Returns 1 on success. See `image.loam` for exactly what is supported.
fn image_decode_png(src: string) -> int {
    return image.png_decode(src)
}

/// Decode a baseline JPEG into the reusable source buffers (RGBA8,
/// premultiplied — JPEG is opaque). Returns 1 on success; a recognised variant
/// this decoder does not cover (progressive, CMYK) sets the status to
/// UNSUPPORTED instead, so the platform image path keeps loading it.
fn image_decode_jpeg(src: string) -> int {
    return image.jpg_decode(src)
}

/// Decode any format the in-Loam decoders cover, choosing by magic bytes. When
/// it returns 0, `image_last_status()` says whether the file was malformed or
/// simply a format that the platform image path (`plat_image`) should load.
fn image_decode_any(src: string) -> int {
    return image.src_decode_any(src)
}

/// FMT_PNG / FMT_BMP / FMT_JPEG / ... for the given encoded bytes; 0 for
/// unknown. Decided by magic bytes, because a file extension lies.
fn image_format_of(src: string) -> int {
    return image.src_format_of(src)
}

fn image_format_name(f: int) -> string {
    return image.src_format_name(f)
}

/// 1 when the in-Loam decoders cover this format today, 0 when the platform
/// loader is what handles it.
fn image_format_is_decodable(f: int) -> int {
    return image.src_format_is_decodable(f)
}

/// 1 = decoded, -1 = malformed, -2 = a real format the platform should load.
fn image_last_status() -> int {
    return image.src_last_status()
}

fn image_status_ok() -> int {
    return 1
}

fn image_status_malformed() -> int {
    return -1
}

fn image_status_unsupported() -> int {
    return -2
}

/// How many decodes have seen a non-sRGB gAMA (composited as sRGB anyway, since
/// the whole pipeline is sRGB).
fn image_gamma_assumed_count() -> int {
    return image.src_gamma_assumed_count()
}

fn image_src_width() -> int {
    return image.src_width()
}

fn image_src_height() -> int {
    return image.src_height()
}

/// Channel `c` (0 R, 1 G, 2 B, 3 A) of the decoded source at (x, y).
fn image_src_get(x: int, y: int, c: int) -> int {
    return image.src_get(x, y, c)
}

/// Bytes held by the decode scratch. Bounded by the largest image decoded, not
/// by how many have been decoded.
fn image_scratch_bytes() -> int {
    return image.src_scratch_bytes()
}

fn image_decode_count() -> int {
    return image.src_decode_count()
}

fn image_decode_failure_count() -> int {
    return image.src_failure_count()
}

fn image_decode_failure_reason() -> string {
    return image.src_failure_reason()
}

// --- images: resized cache (Phase 4) ---------------------------------------

/// Resized image for (id, display pixels), decoding and resampling on a miss.
/// Returns the slot, or -1 when the image cannot be decoded or does not fit the
/// fixed byte budget. Repeated calls for the same key are cache hits.
fn image_get(id: int, encoded: string, dw: int, dh: int) -> int {
    return image.img_get(id, encoded, dw, dh)
}

/// Composite a cached image at (x, y) with `alpha` as a multiplier 0..255.
fn image_blit(s: int, x: int, y: int, alpha: int) {
    image.img_blit(s, x, y, alpha)
}

fn image_w(s: int) -> int {
    return image.img_w(s)
}

fn image_h(s: int) -> int {
    return image.img_h(s)
}

/// Channel `c` (0 R, 1 G, 2 B, 3 A) of a cached image at (x, y).
fn image_get_px(s: int, x: int, y: int, c: int) -> int {
    return image.img_get_px(s, x, y, c)
}

fn image_cache_count() -> int {
    return image.img_cache_count()
}

fn image_cache_bytes() -> int {
    return image.img_cache_bytes()
}

fn image_cache_budget() -> int {
    return image.img_cache_budget()
}

fn image_cache_capacity() -> int {
    return image.img_cache_capacity()
}

fn image_cache_hit_count() -> int {
    return image.img_hit_count()
}

fn image_cache_miss_count() -> int {
    return image.img_miss_count()
}

fn image_cache_eviction_count() -> int {
    return image.img_eviction_count()
}

fn image_cache_refusal_count() -> int {
    return image.img_refusal_count()
}

/// Set the cache's byte budget (a knob, and a test hook: the invariant
/// `image_cache_bytes() <= image_cache_budget()` is what the budget means).
fn image_set_budget(b: int) {
    image.img_set_budget(b)
}

fn image_cache_clear() {
    image.img_cache_clear()
}

fn image_resize_count() -> int {
    return image.mitchell_resize_count()
}

fn image_mem_bytes() -> i64 {
    return image.img_mem_bytes()
}

fn raster_push_str(b: &mut []int, s: string) {
    let mut i = 0
    while i < s.len {
        b.push(s[i])
        i = i + 1
    }
}

/// The zero-copy blit contract, Loam side: the framebuffer's generation. A host
/// wraps the buffer once with a no-copy data provider (CGImage on native, a
/// typed-array view on web) and rebuilds that wrapper ONLY when this number
/// changes — which is reallocation, on a size or backing-scale change, not per
/// frame. Between changes the same bytes are handed over untouched, so there is
/// no per-frame full-buffer copy.
fn raster_blit_generation() -> int {
    return raster.raster_generation()
}

/// Blit the framebuffer we rasterized into to the host: the one place our
/// pixels leave the engine, and the only host call that is not a draw op.
/// Returns 1 when a host presented, 0 when none is listening (headless, or a
/// host without a blit path). Pair it with `scene_rasterize` to drive a frame
/// with our own rasterizer instead of the host's 2D API.
fn raster_blit() -> int {
    return scene.raster_blit()
}

/// Write the framebuffer as a binary PPM (P6). This is the headless capture
/// path: no graphics API, just the bytes we own, which is what lets a pixel
/// golden exist without a display. Returns 0 on success.
fn raster_dump_ppm(path: string) -> int {
    let w = raster.raster_width()
    let h = raster.raster_height()
    let mut b: []int = []int {}
    raster_push_str(&mut b, "P6\n{{w}} {{h}}\n255\n")
    let mut y = 0
    while y < h {
        let mut x = 0
        while x < w {
            b.push(raster.raster_get(x, y, 2))
            b.push(raster.raster_get(x, y, 1))
            b.push(raster.raster_get(x, y, 0))
            x = x + 1
        }
        y = y + 1
    }
    return sys.write_file(path, string_from_bytes(b))
}

/// Set the damage clip from this frame's damage list: the bounding box of the
/// damage rects. A bounding box is a superset of the union, so it can only
/// damage MORE than needed, never less — the safe direction. A full-damage
/// frame (or no damage) clears the clip.
fn raster_clip_from_damage() {
    raster.raster_clip_reset()
    if arena.damage_full != 0 {
        return
    }
    let n = arena.damage.len
    if n == 0 {
        return
    }
    let mut x0 = arena.damage[0].x
    let mut y0 = arena.damage[0].y
    let mut x1 = arena.damage[0].x + arena.damage[0].w
    let mut y1 = arena.damage[0].y + arena.damage[0].h
    let mut i = 1
    while i < n {
        let d = arena.damage[i]
        if d.x < x0 {
            x0 = d.x
        }
        if d.y < y0 {
            y0 = d.y
        }
        if d.x + d.w > x1 {
            x1 = d.x + d.w
        }
        if d.y + d.h > y1 {
            y1 = d.y + d.h
        }
        i = i + 1
    }
    if x1 > x0 {
        if y1 > y0 {
            raster.raster_clip_box(x0, y0, x1, y1)
        }
    }
}

fn damage_x(i: int) -> int {
    return arena.damage[i].x
}

fn damage_y(i: int) -> int {
    return arena.damage[i].y
}

fn damage_w(i: int) -> int {
    return arena.damage[i].w
}

fn damage_h(i: int) -> int {
    return arena.damage[i].h
}

/// Phase 4 diagnostics: build the frame's raster tile list from the damage list
/// (Phase 1) and return how many tiles it touches. Additive.
fn damage_tiles_build() -> int {
    return scene.damage_tiles_build()
}

fn damage_tiles_count() -> int {
    return scene.damage_tiles_count()
}

fn damage_tiles_x(i: int) -> int {
    return scene.damage_tiles_x(i)
}

fn damage_tiles_y(i: int) -> int {
    return scene.damage_tiles_y(i)
}

/// Byte size of one draw-list record (diagnostics for the Phase 11 layout
/// steps).
fn draw_op_bytes() -> int {
    if scene.draws.len == 0 {
        return 0
    }
    return __sizeof(scene.draws[0])
}

/// Total bytes held by the draw list at paint time.
fn draw_bytes() -> i64 {
    if scene.draws.len == 0 {
        return 0
    }
    return i64(scene.draws.len) * i64(__sizeof(scene.draws[0]))
}

/// Print the current draw list. The DRAW goldens diff this text, which is
/// why the format is stable and why paint order is deterministic.
fn dump_draw_list() {
    let n = scene.draws.len
    fmt.println("DRAW", n)
    for i in 0..n {
        let d = scene.draws[i]
        if d.kind == 0 {
            fmt.println("fill", d.x, d.y, d.w, d.h, d.rgb, d.radius)
        } else if d.kind == 1 {
            fmt.println("fill_a", d.x, d.y, d.w, d.h, d.rgb, d.alpha)
        } else if d.kind == 2 {
            fmt.println("text", d.x, d.y, d.rgb, d.font, d.text)
        } else if d.kind == 3 {
            fmt.println("text_int", d.x, d.y, d.value, d.rgb, d.font)
        } else if d.kind == 4 {
            fmt.println("text_wrap", d.x, d.y, d.w, d.text)
        } else if d.kind == 5 {
            fmt.println("svg", d.x, d.y, d.w, d.h, d.rgb)
        } else if d.kind == 6 {
            fmt.println("save")
        } else if d.kind == 7 {
            fmt.println("clip", d.x, d.y, d.w, d.h)
        } else if d.kind == 8 {
            fmt.println("restore")
        } else if d.kind == 9 {
            fmt.println("text_rot", d.x, d.y, d.rgb, d.font, d.w, d.text)
        } else if d.kind == 10 {
            fmt.println("image", d.x, d.y, d.w, d.h, d.alpha, d.radius, d.value)
        } else if d.kind == 11 {
            fmt.println("grad", d.x, d.y, d.w, d.h, d.rgb, d.value, d.radius)
        } else if d.kind == 12 {
            fmt.println("shadow", d.x, d.y, d.w, d.h, d.rgb, d.radius, d.alpha, d.font,
                         d.value % 256 - 128, d.value / 256 - 128)
        } else if d.kind == 13 {
            fmt.println("stroke", d.x, d.y, d.w, d.h, d.rgb, d.radius, d.font, d.alpha)
        } else if d.kind == 14 {
            fmt.println("fill4", d.x, d.y, d.w, d.h, d.rgb, d.alpha,
                         d.radius % 65536, d.radius / 65536,
                         d.value % 65536, d.value / 65536)
        } else if d.kind == 15 {
            fmt.println("xform", d.x, d.y, d.w, d.h, d.radius, d.font)
        }
    }
}

fn snapshot(width: int, height: int, build: fn() -> Node) {
    window("zeus-snap", width, height)
    let n = build()
    root(n)
    engine_layout(width, height)
    engine_paint()
    dump_draw_list()
}

// --- declarative layer ---
//
// Components are plain `fn`s, hierarchy comes from trailing blocks, props are
// named arguments on a props struct, and every style prop is a thunk so a
// signal read inside it re-applies just that prop.

/// Layout direction for `align_direction`.
enum DIRECTION {
    Row = 0,
    Column = 1,
}

/// Cross-axis and main-axis alignment. Same codes the layout solver uses.
enum ALIGN {
    Start = 0,
    Center = 1,
    End = 2,
    Between = 3,
    Around = 4,
    Evenly = 5,
    Stretch = 6,
}

/// How `Image` maps the bitmap into its layout box: Stretch (default, may
/// distort), Contain (letterbox), Cover (crop to fill), None (intrinsic size).
enum IMAGE_FIT {
    Stretch = 0,
    Contain = 1,
    Cover = 2,
    None = 3,
}

/// The spacing scale, in points.
/// Spacing, on a 4pt grid. Every step is a multiple of 4 — the three that
/// were not (`Exxxs` 2, `Exxs` 6, `Xxxl` 62) are snapped to the nearest
/// multiple, which is the whole of the change. `Exxs` and `Exs` both land on
/// 8: the old 6/8 pair was a distinction the grid does not make, and keeping
/// both names means no call site has to move.
enum SPACE {
    None = 0,
    Exxxs = 4,
    Exxs = 8,
    Exs = 8,
    Xs = 12,
    Sm = 16,
    Md = 20,
    Lg = 24,
    Xl = 32,
    Xxl = 48,
    Xxxl = 64,
    Xxxxl = 72
}

/// Key codes as delivered by the hosts. `e.key == Key.K` is the spell.
enum Key {
    Backspace = 8,
    Tab = 9,
    Enter = 13,
    Escape = 27,
    Space = 32,
    A = 97,
    B = 98,
    C = 99,
    D = 100,
    E = 101,
    F = 102,
    G = 103,
    H = 104,
    I = 105,
    J = 106,
    K = 107,
    L = 108,
    M = 109,
    N = 110,
    O = 111,
    P = 112,
    Q = 113,
    R = 114,
    S = 115,
    T = 116,
    U = 117,
    V = 118,
    W = 119,
    X = 120,
    Y = 121,
    Z = 122,
    Left = 1000,
    Right = 1001,
    Up = 1002,
    Down = 1003,
    Home = 1004,
    End = 1005,
}

/// Pointer payload, staged by the engine and read inside a handler.
struct MouseEvent {
    x: int,
    y: int,
    button: int,
}

/// Keyboard payload, staged by the engine and read inside a handler.
struct KeyEvent {
    key: int,
    ctrl: bool,
    shift: bool,
    alt: bool,
}

/// Multi-value box sizing, passed as one `style =` prop.
struct BoxStyle {
    width: int = -1,
    height: int = -1,
    background: string = "",
    padding: int = 0,
    grow: int = 0,
}

/// `v` when the caller set it (>= 0), else the recipe's `fallback`. Both
/// sides stay thunks, so a themed default repaints on a palette switch just
/// like a caller-supplied one. This is how a recipe widget layers its own
/// look under whatever the caller passed.
fn px_or_default(v: int, fallback: int) -> int {
    if v >= 0 {
        return v
    }
    return fallback
}

/// `px_or` for colors and other strings: a non-empty `v` wins.
fn str_or_default(v: string, fallback: string) -> string {
    if v.len > 0 {
        return v
    }
    return fallback
}

/// 2D grid configuration.
struct GridConfig {
    /// Column count. In auto mode (see `auto_columns`) it is instead the cap
    /// on the count, and `0` means no cap — the width alone decides.
    /// `GridConfig {}`, like any count `< 1`, is a single column.
    columns: int = 0,
    gap: int = 0,
    padding: int = 0,
    /// The narrowest a cell may be, in points like `gap`. This is what makes
    /// the grid responsive: the count becomes how many cells at least this
    /// wide fit the width the grid is given, capped by `columns` and by the
    /// child count. With `gap = 12` and `auto_columns = 220`, a grid with 1000
    /// points of content width fits four cells (and `columns = 3` takes it back
    /// to three), 620 points fits two, 420 fits one. The gap is part of the
    /// cell, because `cols` cells leave `cols - 1` gaps.
    ///
    /// `0` is the same thing with the width taken from the children instead —
    /// a cell is as wide as the widest child wants to be — so the count
    /// follows the content and needs no number to pick. `-1` (the default)
    /// keeps the fixed `columns` behaviour.
    ///
    /// A constant, not a signal: a cell width is a layout parameter, so
    /// re-resolving it every frame would buy nothing.
    auto_columns: int = -1,
}

/// The event payload for the handler now running. A handler is invoked with
/// no arguments, so `fn(e: MouseEvent)` is lowered to a `let` of this.
fn current_mouse() -> MouseEvent {
    return MouseEvent { x: arena.ev_x, y: arena.ev_y, button: arena.ev_button }
}

fn current_key() -> KeyEvent {
    return KeyEvent {
        key: arena.ev_key,
        ctrl: arena.ev_mods % 4 >= 2,
        shift: arena.ev_mods % 2 == 1,
        alt: arena.ev_mods % 8 >= 4,
    }
}

/// Default for the text/label thunks: an unset text prop reads as empty.
fn empty_text() -> string {
    return ""
}

/// Default for an unset handler prop. Never installed: `on_x__set` says
/// whether the caller passed one.
fn noop() {
    return
}

/// `noop` for `fn(int)` handler props (`Menu.on_select`).
fn noop_int(i: int) {
    return
}

/// Shared props for `Component` / `Box`. Every widget passes these.
struct BoxProps {
    width: int = -1,
    height: int = -1,
    padding: int = -1,
    padding_x: int = -1,
    padding_y: int = -1,
    /// Per-edge insets. Applied after `padding` / `padding_x` / `padding_y`.
    /// Pass a `SPACE.*` step (`SPACE.Sm` = 16). `-1` = unset (the node stays
    /// at `SPACE.None` = 0 unless a shorthand set it).
    padding_top: int = -1,
    padding_right: int = -1,
    padding_bottom: int = -1,
    padding_left: int = -1,
    /// Outer gap around this node in the parent's packing. Same cascade as
    /// padding: `margin`, then `margin_x` / `margin_y`, then per-edge.
    /// `SPACE.*` values; `-1` = unset (`SPACE.None`).
    margin: int = -1,
    margin_x: int = -1,
    margin_y: int = -1,
    margin_top: int = -1,
    margin_right: int = -1,
    margin_bottom: int = -1,
    margin_left: int = -1,
    spacing: int = -1,
    /// Space between children. Same field as `spacing`; `gap` wins if both
    /// are set. Layout uses it on the main axis: a row gaps horizontally, a
    /// column vertically. `gap_row` / `gap_col` override one axis (CSS
    /// row-gap / column-gap). `SPACE.*`; `-1` = unset.
    gap: int = -1,
    gap_row: int = -1,
    gap_col: int = -1,
    radius: int = -1,
    /// Round only the top / bottom pair of corners (both corners on that
    /// edge), overriding the matching corners of `radius`; `-1` leaves them
    /// to it. `radius = 8, radius_bottom = 0` is a top-rounded sheet.
    radius_top: int = -1,
    radius_bottom: int = -1,
    border: int = -1,
    border_color: string = "",
    /// Elevation 0..4: paints a soft shadow under the surface. `-1` = none.
    elevation: int = -1,
    background: string = "",
    color: string = "",
    font: int = -1,
    opacity: int = -1,
    grow: int = -1,
    shrink: int = -1,
    show: bool = true,
    align_direction: int = 1,
    align_items: int = -1,
    justify: int = -1,
    wrap: int = 0,
    min_width: int = -1,
    max_width: int = -1,
    min_height: int = -1,
    max_height: int = -1,
    position: int = -1,
    left: int = -1,
    top: int = -1,
    right: int = -1,
    bottom: int = -1,
    z_index: int = -1,
    safe: int = 0,
    hover_off: bool = true,
    cursor: string = "",
    visible: Signal<int> = Signal { id: 0 },
    visible__set: bool = false,
    bind: Signal<int> = Signal { id: 0 },
    bind__set: bool = false,
    press: bool = false,
    /// Label text. A thunk so a signal read inside it repaints just this
    /// attribute; the compiler lifts a plain expression passed here —
    /// `text = "n = {{count.get()}}"` — into that thunk. Nothing at the
    /// call site is a closure unless the caller wants one.
    text: fn() -> string = empty_text,
    text__set: bool = false,
    enabled: bool = true,
    multiline: int = 0,
    fit: int = 0,
    lazy: int = 0,
    edit: Signal<string> = Signal { id: 0 },
    edit__set: bool = false,
    row_h: int = 0,
    rebuild: fn() = noop,
    rebuild__set: bool = false,
    a11y_label: string = "",
    a11y_role: string = "",
    style: BoxStyle = BoxStyle {},
    style__set: bool = false,
    on_click: fn() = noop,
    on_click__set: bool = false,
    on_mouse_down: fn() = noop,
    on_mouse_down__set: bool = false,
    on_mouse_up: fn() = noop,
    on_mouse_up__set: bool = false,
    /// Chord that activates this node: `"cmd+s"`, `"ctrl+shift+p"`, or a
    /// sequence like `"g d"`. Every widget takes it, because `Component`
    /// installs it — nothing here is specific to buttons or sliders.
    key: string = "",
    /// Name the chord resolves to, so an app can remap the shortcut with
    /// `remap_key` without touching the widget. Defaults to `"key.<chord>"`.
    key_action: string = "",
    /// Handler for the chord. Omit it and the chord runs `on_click`, which
    /// is what a button with a shortcut wants.
    on_key: fn() = noop,
    on_key__set: bool = false,
    /// true = the chord fires wherever focus is. Default is node-scoped:
    /// it fires only while this node (or a descendant) holds focus.
    key_global: bool = false,
    on_key_down: fn() = noop,
    on_key_down__set: bool = false,
    on_key_up: fn() = noop,
    on_key_up__set: bool = false,
    on_key_press: fn() = noop,
    on_key_press__set: bool = false,
}

/// `#rrggbb` / `#rgb` to packed RGB. -1 for empty or malformed, which every
/// style setter reads as "leave unset".
fn parse_hex_color(s: string) -> int {
    let n = s.len
    if n == 0 {
        return -1
    }
    // `@N` is a theme role (see `role_token`): keep it symbolic so the paint
    // pass can resolve it per appearance.
    if s[0] == 64 {
        let mut slot = 0
        for i in 1..n {
            let d = s[i] - 48
            if d < 0 || d > 9 {
                return -1
            }
            slot = slot * 10 + d
        }
        return role_color(slot)
    }
    if s[0] != 35 {
        return -1
    }
    let mut v = 0
    if n == 7 {
        for i in 1..7 {
            let d = hex_digit_value(s[i])
            if d < 0 {
                return -1
            }
            v = v * 16 + d
        }
        return v
    }
    if n == 4 {
        for i in 1..4 {
            let d = hex_digit_value(s[i])
            if d < 0 {
                return -1
            }
            v = v * 256 + d * 17
        }
        return v
    }
    return -1
}

/// One hex nibble, or -1 when the byte is not a hex digit — the -1 is what
/// lets `parse_hex_color` reject malformed colors instead of guessing.
fn hex_digit_value(c: int) -> int {
    if c >= 48 {
        if c <= 57 {
            return c - 48
        }
    }
    if c >= 97 {
        if c <= 102 {
            return c - 87
        }
    }
    if c >= 65 {
        if c <= 70 {
            return c - 55
        }
    }
    return -1
}

// --- Component ---
// Every widget is `Component(node, props)`: style thunks, events, bind,
// visible, press, then attach to the current slot parent. Trailing blocks
// lower to `slot`. Recipes allocate a raw node (or call Box) and pass
// props — they do not intern, write arena fields, or call prop_int.

let mut ui_parents: []int = []int {}

fn ui_push(id: int) {
    let mut target = id
    if id > 0 {
        if id < arena.nodes.len {
            if arena.nodes[id].slot_into > 0 {
                target = arena.nodes[id].slot_into
            }
        }
    }
    push(ui_parents, target)
}

fn ui_pop() {
    if ui_parents.len > 0 {
        pop(ui_parents)
    }
}

/// `show` as the 0/1 the arena stores. A plain bool prop, so it is read once
/// at build; reactive hiding goes through the `visible` Signal instead.
fn show_on(show: bool) -> int {
    match show {
        true => { return 1 }
        _ => { return 0 }
    }
}

/// An explicit `shrink` wins; otherwise anything that grows may also shrink.
/// Keeps a growing child from overflowing its row without the caller having
/// to set both.
fn shrink_weight(grow: int, shrink: int) -> int {
    if shrink >= 0 {
        return shrink
    }
    if grow > 0 {
        return 1
    }
    return 0
}

/// A disabled widget paints at 40% so "not available" reads without every
/// recipe hand-dimming its own colors.
fn enabled_opacity(enabled: bool, opacity: int) -> int {
    match enabled {
        false => { return 40 }
        _ => { return opacity }
    }
}

// --- reactive props ---
// A style prop is a thunk. Interning it yields an int id, which a plain `||`
// effect closure can capture — a `fn` value is not Copy and cannot be. The
// effect calls the thunk and re-applies one setter, so setting a signal
// repaints exactly the props that read it.

/// Which node attribute a reactive prop writes. One effect per member, so a
/// signal change repaints exactly that attribute.
enum SET {
    Width = 1,
    Height = 2,
    Padding = 3,
    PaddingX = 4,
    PaddingY = 5,
    Spacing = 6,
    Radius = 7,
    Border = 8,
    Grow = 9,
    AlignItems = 10,
    Justify = 11,
    Font = 12,
    Opacity = 13,
    Direction = 14,
    Background = 15,
    Color = 16,
    BorderColor = 17,
    MinWidth = 18,
    MaxWidth = 19,
    MinHeight = 20,
    MaxHeight = 21,
    Wrap = 22,
    Safe = 23,
    Position = 24,
    Left = 25,
    Top = 26,
    Right = 27,
    Bottom = 28,
    ZIndex = 29,
    Shrink = 30,
    ShowOn = 31,
    SvgFit = 32,
    SvgLazy = 33,
    Elevation = 34,
    PaddingTop = 35,
    PaddingRight = 36,
    PaddingBottom = 37,
    PaddingLeft = 38,
    Margin = 39,
    MarginX = 40,
    MarginY = 41,
    MarginTop = 42,
    MarginRight = 43,
    MarginBottom = 44,
    MarginLeft = 45,
    GapRow = 46,
    GapCol = 47,
    RadiusTop = 48,
    RadiusBottom = 49,
    Text = 100,
    A11yLabel = 101,
    A11yRole = 102,
    Cursor = 103,
}

/// Does this write carry no value? Most props use -1 for "the caller did not
/// pass this", so one rule here replaces the same `if v >= 0` repeated in
/// every arm below. The flag-like setters opt out: they mean something at 0
/// and -1, so they always apply. `SET.Border` is deliberately not one of them:
/// its width is additive in `content_x`/`content_y`, so applying the unset `-1`
/// shifted every container's content by one pixel.
fn skip_unset(setter: int, v: int) -> bool {
    match setter {
        SET.Direction | SET.Wrap | SET.Safe | SET.ShowOn => { return false }
        /* The four pin offsets are the one geometry prop where a negative is a
           real value: `left = -3, top = -3` is how a 22px ring is centred on a
           16px dot. `v < 0` here silently dropped those, so the ring drew at the
           parent's origin and hung 3px down-right of the dot it was meant to
           circle. `-1` still means "unset" in the layout guards. */
        SET.Left | SET.Top | SET.Right | SET.Bottom => { return false }
        // A 0px glyph is not a size, so font rejects 0 as well.
        SET.Font => { return v <= 0 }
        _ => { return v < 0 }
    }
}

/// Geometry a layout-driving `animate` may tween. Flags (direction, wrap,
/// show) still jump: they are not a continuous length.
fn setter_tweens_layout(setter: int) -> bool {
    match setter {
        SET.Width | SET.Height | SET.MinWidth | SET.MaxWidth |
        SET.MinHeight | SET.MaxHeight | SET.Left | SET.Top | SET.Right |
        SET.Bottom => { return true }
        _ => { return false }
    }
}

fn layout_target_px(setter: int, v: int) -> int {
    match setter {
        SET.Width | SET.Height | SET.MinWidth | SET.MaxWidth |
        SET.MinHeight | SET.MaxHeight | SET.Left | SET.Top | SET.Right |
        SET.Bottom => { return scaled(v) }
        _ => { return v }
    }
}

fn layout_read(node_id: int, setter: int) -> int {
    match setter {
        SET.Width => {
            if arena.nodes[node_id].explicit_width >= 0 {
                return arena.nodes[node_id].explicit_width
            }
            return arena.nodes[node_id].w
        }
        SET.Height => {
            if arena.nodes[node_id].explicit_height >= 0 {
                return arena.nodes[node_id].explicit_height
            }
            return arena.nodes[node_id].h
        }
        SET.MinWidth => { return arena.nodes[node_id].min_w }
        SET.MaxWidth => { return arena.nodes[node_id].max_w }
        SET.MinHeight => { return arena.nodes[node_id].min_h }
        SET.MaxHeight => { return arena.nodes[node_id].max_h }
        SET.Left => { return arena.nodes[node_id].pin_l }
        SET.Top => { return arena.nodes[node_id].pin_t }
        SET.Right => { return arena.nodes[node_id].pin_r }
        SET.Bottom => { return arena.nodes[node_id].pin_b }
        _ => { return 0 }
    }
}

fn apply_int_px(node_id: int, setter: int, v: int) {
    let n = node_handle(node_id)
    match setter {
        SET.Width => { set_width(n, v) }
        SET.Height => { set_height(n, v) }
        SET.MinWidth => { set_min_width(n, v) }
        SET.MaxWidth => { set_max_width(n, v) }
        SET.MinHeight => { set_min_height(n, v) }
        SET.MaxHeight => { set_max_height(n, v) }
        SET.Left => { arena.nodes[node_id].pin_l = v }
        SET.Top => { arena.nodes[node_id].pin_t = v }
        SET.Right => { arena.nodes[node_id].pin_r = v }
        SET.Bottom => { arena.nodes[node_id].pin_b = v }
        _ => {}
    }
}

fn apply_layout_anims() {
    let n = arena.layout_anim_len()
    let mut i = 0
    while i < n {
        let a = arena.layout_anim_get(i)
        if a.live != 0 {
            apply_int_px(a.node_id, a.setter, a.current_value)
        }
        i = i + 1
    }
    arena.layout_anim_reap()
    arena.mark_layout()
}

fn apply_int(node_id: int, setter: int, v: int) {
    if skip_unset(setter, v) {
        return
    }
    if arena.anim_bind_on() != 0 {
        if setter_tweens_layout(setter) {
            let from = layout_read(node_id, setter)
            let to = layout_target_px(setter, v)
            if arena.layout_anim_push(node_id, setter, from, to) != 0 {
                return
            }
        }
    }
    let n = node_handle(node_id)
    // The UI-scale knob is applied here, once, so recipes and callers both
    // write plain design px and never call `scaled` themselves. Only
    // geometry and type scale; weights, flags, colors and z-order do not —
    // so `scaled` is called in those arms only (scaling a packed color would
    // overflow the 32-bit default).
    match setter {
        SET.Width => { set_width(n, scaled(v)) }
        SET.Height => { set_height(n, scaled(v)) }
        SET.Padding => { set_padding(n, scaled(v)) }
        SET.PaddingX => { set_padding_x(n, scaled(v)) }
        SET.PaddingY => { set_padding_y(n, scaled(v)) }
        SET.PaddingTop => { set_padding_top(n, scaled(v)) }
        SET.PaddingRight => { set_padding_right(n, scaled(v)) }
        SET.PaddingBottom => { set_padding_bottom(n, scaled(v)) }
        SET.PaddingLeft => { set_padding_left(n, scaled(v)) }
        SET.Margin => { margin(n, scaled(v)) }
        SET.MarginX => { marginX(n, scaled(v)) }
        SET.MarginY => { marginY(n, scaled(v)) }
        SET.MarginTop => { marginTop(n, scaled(v)) }
        SET.MarginRight => { marginRight(n, scaled(v)) }
        SET.MarginBottom => { marginBottom(n, scaled(v)) }
        SET.MarginLeft => { marginLeft(n, scaled(v)) }
        SET.Spacing => { set_spacing(n, scaled(v)) }
        SET.GapRow => { set_spacing_row(n, scaled(v)) }
        SET.GapCol => { set_spacing_col(n, scaled(v)) }
        SET.Radius => { radius(n, scaled(v)) }
        SET.RadiusTop => { radius_top(n, scaled(v)) }
        SET.RadiusBottom => { radius_bottom(n, scaled(v)) }
        SET.Border => { arena.nodes[node_id].border_w = u16(v) }
        SET.Grow => { grow(n, v) }
        SET.AlignItems => { align(n, v) }
        SET.Justify => { justify(n, v) }
        SET.Font => { font(n, scaled(v)) }
        SET.Opacity => { opacity(n, v) }
        SET.Direction => {
            match v {
                1 => { flex_col(n) }
                _ => { flex_row(n) }
            }
        }
        SET.Background => { set_background(n, v) }
        SET.Color => { set_color(n, v) }
        SET.BorderColor => { border_color(n, v) }
        SET.MinWidth => { set_min_width(n, scaled(v)) }
        SET.MaxWidth => { set_max_width(n, scaled(v)) }
        SET.MinHeight => { set_min_height(n, scaled(v)) }
        SET.MaxHeight => { set_max_height(n, scaled(v)) }
        SET.Wrap => {
            match v {
                0 => {}
                _ => { flex_wrap(n) }
            }
        }
        SET.Safe => {
            match v {
                0 => { arena.nodes[node_id].safe = u8(0) }
                _ => { arena.nodes[node_id].safe = u8(1) }
            }
        }
        SET.Position => { arena.nodes[node_id].pos = u8(v) }
        SET.Left => { arena.nodes[node_id].pin_l = scaled(v) }
        SET.Top => { arena.nodes[node_id].pin_t = scaled(v) }
        SET.Right => { arena.nodes[node_id].pin_r = scaled(v) }
        SET.Bottom => { arena.nodes[node_id].pin_b = scaled(v) }
        SET.ZIndex => { arena.nodes[node_id].z_index = i16(v) }
        SET.Shrink => { shrink(n, v) }
        SET.ShowOn => {
            match v {
                0 | 1 => { arena.nodes[node_id].show_on = u8(v) }
                _ => {}
            }
        }
        SET.SvgFit => { arena.nodes[node_id].font = u16(v) }
        SET.SvgLazy => { arena.nodes[node_id].wrap = u8(v) }
        SET.Elevation => {
            if v <= 0 {
                arena.nodes[node_id].elev = u8(0)
            } else {
                let mut lv = v
                if lv > 4 {
                    lv = 4
                }
                arena.nodes[node_id].elev = u8(lv)
                arena.nodes[node_id].elev_c = role_color(ROLE.Shadow)
            }
        }
        _ => {}
    }
    if setter_is_paint_only(setter) {
        arena.mark_paint()
    } else {
        arena.mark_layout()
    }
}

/// Setters that change only paint state: geometry is untouched, so a frame
/// that writes one skips `layout.layout()`. Everything else (sizes, padding,
/// border, text, font, position, show) can move the box model.
fn setter_is_paint_only(setter: int) -> bool {
    match setter {
        SET.Radius | SET.RadiusTop | SET.RadiusBottom | SET.Opacity | SET.Background | SET.Color | SET.BorderColor |
        SET.ZIndex | SET.SvgFit | SET.SvgLazy | SET.Elevation => { return true }
        _ => { return false }
    }
}

fn apply_str(node_id: int, setter: int, v: string) {
    match setter {
        SET.Text => {
            arena.nodes[node_id].text = v
            arena.mark_layout()
        }
        SET.A11yLabel => { arena.nodes[node_id].a11y_label = v }
        SET.A11yRole => { arena.nodes[node_id].a11y_role = v }
        SET.Cursor => { arena.nodes[node_id].cursor = v }
        _ => { apply_int(node_id, setter, parse_hex_color(v)) }
    }
}

/// Write a plain prop value straight onto the node. Style props are data, so
/// there is nothing to re-run: one assignment at build time.
fn set_prop_int(node: Node, setter: int, v: int) -> Node {
    apply_int(node.id, setter, v)
    return node
}

/// `set_prop_int` for string props (colors, labels, a11y).
fn set_prop_str(node: Node, setter: int, v: string) -> Node {
    apply_str(node.id, setter, v)
    return node
}

fn prop_int(node: Node, setter: int, thunk: fn() -> int) -> Node {
    let fn_id = intern_int(thunk)
    let node_id = node.id
    return styled(node, || { apply_int(node_id, setter, platform.plat_invoke_int_fn(fn_id)) })
}

fn prop_str(node: Node, setter: int, thunk: fn() -> string) -> Node {
    let fn_id = intern_str(thunk)
    let node_id = node.id
    return styled(node, || { apply_str(node_id, setter, platform.plat_invoke_str_fn(fn_id)) })
}

// --- effects and derivations ---
// `styled` is the node-scoped effect every prop above is built from. The two
// below are the free-standing forms: `effect` for a side effect, `computed`
// for a cached value. Both are ordinary reactive scopes — they read signals
// through `get`, so their dependencies are discovered, not declared.

/// Owner for a free-standing reactive scope: the `slot` parent currently
/// being built. An effect created inside a component therefore dies with
/// that component's subtree. 0 at top level — those live for the process.
fn effect_owner() -> int {
    if ui_parents.len > 0 {
        return ui_parents[ui_parents.len - 1]
    }
    return 0
}

// --- context (provide / inject) ---
// A `Context<T>` is a typed key. `provide` binds a value for the dynamic
// extent of `body`; `use_context` reads the topmost binding, or the default
// the context was created with. The bindings live in ordinary `Signal<T>`
// cells — this file's one generic store — so the open-scope stack itself is
// just ints (signal ids) and needs no per-type copy of the machinery.

/// A typed key for `provide` / `use_context`. The default travels on the
/// handle, so lookups need no side table; `T` must be Copy, as for `Signal`.
struct Context<T> {
    id: int,
    default_value: T,
}

let mut ctx_next_id: int = 1
/// Open `provide` scopes, as parallel stacks of (context id, value cell).
let mut ctx_stack_ctx: []int = []int {}
let mut ctx_stack_sig: []int = []int {}

/* The stack itself is untyped ints, so these helpers are concrete: a global
   read only from a generic body is not the one the codegen emits (see
   `signal` vs `computed`), and keeping the id bookkeeping here avoids that. */
fn ctx_take_id() -> int {
    let context_id = ctx_next_id
    ctx_next_id = ctx_next_id + 1
    return context_id
}

fn ctx_push(context_id: int, cell: int) {
    push(ctx_stack_ctx, context_id)
    push(ctx_stack_sig, cell)
}

fn ctx_pop() {
    pop(ctx_stack_ctx)
    pop(ctx_stack_sig)
}

/// Cell id of the topmost `provide` for `context_id`, or -1 when none is open.
fn ctx_cell(context_id: int) -> int {
    let n = ctx_stack_ctx.len
    let mut i = n
    while i > 0 {
        i = i - 1
        if ctx_stack_ctx[i] == context_id {
            return ctx_stack_sig[i]
        }
    }
    return -1
}

/// Create a typed context whose value is `default_value` until something `provide`s
/// one. `T` is inferred from `default_value`.
fn create_context<T>(default_value: T) -> Context<T> {
    arena.ensure()
    return Context { id: ctx_take_id(), default_value: default_value }
}

/// Make `value` the current binding of `ctx` for the dynamic extent of
/// `body`. Call as `provide(ctx, value, fn() { ... })`; scopes nest, and the
/// innermost binding wins.
fn provide<T>(ctx: Context<T>, value: T, body: fn()) {
    arena.ensure()
    let cell = signal(value)
    ctx_push(ctx.id, cell.id)
    body()
    ctx_pop()
}

/// The topmost provided value for `ctx`, else the default it was created with.
/// Reading a context does not subscribe the caller to anything.
fn use_context<T>(ctx: Context<T>) -> T {
    arena.ensure()
    let signal_id = ctx_cell(ctx.id)
    if signal_id < 0 {
        return ctx.default_value
    }
    // Read without subscribing: `__sig_load` is what `peek` wraps, and its
    // result type comes from the return type, so no `Signal<T>` value is
    // needed here.
    return __sig_load(signal_id)
}

/// Run `body` once now, then again whenever a signal it read changes.
/// Effects are the edges of the graph: `body` writes a signal, an arena
/// field, or the outside world — it never rebuilds the tree. Prefer a text
/// thunk (`Text("{{n.get()}}")`) for anything a widget can express; reach
/// for `effect` for the rest (logging, sync, imperative host calls).
///
/// ```
/// let n = zeus.signal(0)
/// zeus.effect(|| { fmt.println("n is now", n.get()) })
/// ```
fn effect(body: fn()) {
    effect_eid(body)
}

/// `effect`, returning the effect id so a `computed` can record itself as the
/// producer of its output signal (see `track.mark_produced`).
fn effect_eid(body: fn()) -> int {
    arena.ensure()
    let effect_id = track.alloc(intern_fn(body), effect_owner())
    // A nested scope outranks its parent, so a reader of what this effect
    // writes is flushed after it (glitch-free ordering).
    track.set_rank(effect_id, 1 + track.current_rank())
    track.run(effect_id)
    return effect_id
}

/// Batch `body`'s signal writes: each `set` re-runs no effect until the
/// outermost `batch` returns, then every affected effect runs once, in
/// dependency order. Use it when a handler writes several signals that feed
/// the same derivation, so it recomputes once instead of once per write.
///
/// ```
/// zeus.batch(fn() {
///     x.set(1)
///     y.set(2)
/// })
/// ```
fn batch(body: fn()) {
    track.batch_begin()
    body()
    track.batch_end()
}

/// Register `body` to run before the enclosing `effect` re-runs, so a
/// subscription the effect opened is closed before its body runs again.
/// Call inside an effect; a no-op outside one.
fn on_cleanup(body: fn()) {
    track.set_cleanup(track.current_eid(), intern_fn(body))
}

/// A cached derivation. `calc` runs now, and re-runs only when one of the
/// signals *it* read changes — not on every read, and not when some
/// unrelated signal moves. The result is a plain `Signal<int>`, so a reader
/// subscribes to the derivation rather than to its inputs, and because `set`
/// is change-gated a recompute that lands on the same value propagates no
/// further.
///
/// ```
/// let first = zeus.signal("Ada")
/// let last = zeus.signal("Lovelace")
/// let full = zeus.computed_str(|| { "{{first.get()}} {{last.get()}}" })
/// zeus.Text("{{full.get()}}")
/// ```
fn computed(calc: fn() -> int) -> Signal<int> {
    arena.ensure()
    let fn_id = intern_int(calc)
    let out = signal(0)
    let effect_id = effect_eid(|| { set(out, platform.plat_invoke_int_fn(fn_id)) })
    track.mark_produced(out.id, effect_id)
    return out
}

/// `computed` for a string derivation.
fn computed_str(calc: fn() -> string) -> Signal<string> {
    arena.ensure()
    let fn_id = intern_str(calc)
    let out = signal("")
    let effect_id = effect_eid(|| { set(out, platform.plat_invoke_str_fn(fn_id)) })
    track.mark_produced(out.id, effect_id)
    return out
}

/// `computed` for a bool derivation.
fn computed_bool(calc: fn() -> bool) -> Signal<bool> {
    arena.ensure()
    let fn_id = intern_bool(calc)
    let out = signal(false)
    let effect_id = effect_eid(|| { set(out, platform.plat_invoke_bool_fn(fn_id) != 0) })
    track.mark_produced(out.id, effect_id)
    return out
}

/// Apply every style, event, bind, visible, and press prop, then attach
/// `node` to the current `slot` parent. Kind-specific chrome (native
/// thumbs, overlay float, text-input edit, list rebuild) is handled here
/// so widgets stay data.
fn Component(node: Node, p: BoxProps) -> Node {
    arena.ensure()
    arena.component_runs = arena.component_runs + 1
    shrink(node, 0)
    let k = int(arena.nodes[node.id].kind)
    if p.style__set {
        if p.style.width >= 0 {
            set_width(node, p.style.width)
        }
        if p.style.height >= 0 {
            set_height(node, p.style.height)
        }
        if p.style.padding > 0 {
            set_padding(node, p.style.padding)
        }
        if p.style.grow > 0 {
            grow(node, p.style.grow)
        }
        let sbg = parse_hex_color(p.style.background)
        if sbg >= 0 {
            set_background(node, sbg)
        }
    }
    if k == 1 {
        set_prop_int(node, SET.Direction, p.align_direction)
        set_prop_int(node, SET.Border, p.border)
    }
    if k == 4 {
        set_prop_int(node, SET.Border, p.border)
    }
    if k == 9 {
        set_prop_int(node, SET.Direction, p.align_direction)
    }
    if k == 11 {
        set_prop_int(node, SET.Direction, p.align_direction)
    }
    set_prop_int(node, SET.Width, p.width)
    set_prop_int(node, SET.Height, p.height)
    set_prop_int(node, SET.Padding, p.padding)
    set_prop_int(node, SET.PaddingX, p.padding_x)
    set_prop_int(node, SET.PaddingY, p.padding_y)
    set_prop_int(node, SET.PaddingTop, p.padding_top)
    set_prop_int(node, SET.PaddingRight, p.padding_right)
    set_prop_int(node, SET.PaddingBottom, p.padding_bottom)
    set_prop_int(node, SET.PaddingLeft, p.padding_left)
    set_prop_int(node, SET.Margin, p.margin)
    set_prop_int(node, SET.MarginX, p.margin_x)
    set_prop_int(node, SET.MarginY, p.margin_y)
    set_prop_int(node, SET.MarginTop, p.margin_top)
    set_prop_int(node, SET.MarginRight, p.margin_right)
    set_prop_int(node, SET.MarginBottom, p.margin_bottom)
    set_prop_int(node, SET.MarginLeft, p.margin_left)
    let mut gap = p.spacing
    if p.gap >= 0 {
        gap = p.gap
    }
    set_prop_int(node, SET.Spacing, gap)
    set_prop_int(node, SET.GapRow, p.gap_row)
    set_prop_int(node, SET.GapCol, p.gap_col)
    set_prop_int(node, SET.Radius, p.radius)
    set_prop_int(node, SET.RadiusTop, p.radius_top)
    set_prop_int(node, SET.RadiusBottom, p.radius_bottom)
    set_prop_int(node, SET.Elevation, p.elevation)
    set_prop_int(node, SET.Grow, p.grow)
    let sw = shrink_weight(p.grow, p.shrink)
    set_prop_int(node, SET.Shrink, sw)
    set_prop_int(node, SET.AlignItems, p.align_items)
    set_prop_int(node, SET.Justify, p.justify)
    set_prop_int(node, SET.Wrap, p.wrap)
    set_prop_int(node, SET.MinWidth, p.min_width)
    set_prop_int(node, SET.MaxWidth, p.max_width)
    set_prop_int(node, SET.MinHeight, p.min_height)
    set_prop_int(node, SET.MaxHeight, p.max_height)
    set_prop_int(node, SET.Safe, p.safe)
    set_prop_int(node, SET.Position, p.position)
    set_prop_int(node, SET.Left, p.left)
    set_prop_int(node, SET.Top, p.top)
    set_prop_int(node, SET.Right, p.right)
    set_prop_int(node, SET.Bottom, p.bottom)
    set_prop_int(node, SET.ZIndex, p.z_index)
    let shown = show_on(p.show)
    set_prop_int(node, SET.ShowOn, shown)
    if k == 14 {
        set_prop_int(node, SET.SvgFit, p.fit)
        set_prop_int(node, SET.SvgLazy, p.lazy)
    } else {
        set_prop_int(node, SET.Font, p.font)
    }
    let dim = enabled_opacity(p.enabled, p.opacity)
    set_prop_int(node, SET.Opacity, dim)
    // The shared state overlay records disabled once, so hover / press and any
    // future invalid / loading chrome read one model instead of re-deriving it.
    if p.enabled {
        arena.set_disabled(node.id, 0)
    } else {
        arena.set_disabled(node.id, 1)
    }
    if k == 10 {
        set_prop_int(node, SET.Wrap, p.multiline)
    }
    set_prop_str(node, SET.Background, p.background)
    set_prop_str(node, SET.Color, p.color)
    set_prop_str(node, SET.BorderColor, p.border_color)
    set_prop_str(node, SET.A11yLabel, p.a11y_label)
    set_prop_str(node, SET.A11yRole, p.a11y_role)
    set_prop_str(node, SET.Cursor, p.cursor)
    if p.text__set {
        prop_str(node, SET.Text, p.text)
    }
    if p.on_click__set {
        arena.nodes[node.id].click_fn = intern_fn(p.on_click)
        arena.nodes[node.id].focusable = 1
    }
    if p.on_mouse_down__set {
        arena.nodes[node.id].down_fn = intern_fn(p.on_mouse_down)
    }
    if p.on_mouse_up__set {
        arena.nodes[node.id].up_fn = intern_fn(p.on_mouse_up)
    }
    // A `key` prop works on every widget: the chord runs `on_key`, or
    // `on_click` when no separate handler was given. Installed after the
    // click handler so that fallback has something to call.
    if p.key.len > 0 {
        let mut kfn = 0
        if p.on_key__set {
            kfn = intern_fn(p.on_key)
        } else {
            kfn = arena.nodes[node.id].click_fn
        }
        install_key(node, p.key, p.key_action, kfn, p.key_global)
    }
    if p.on_key_down__set {
        arena.nodes[node.id].kdown_fn = intern_fn(p.on_key_down)
        arena.nodes[node.id].focusable = 1
    }
    if p.on_key_up__set {
        arena.nodes[node.id].kup_fn = intern_fn(p.on_key_up)
        arena.nodes[node.id].focusable = 1
    }
    if p.on_key_press__set {
        arena.nodes[node.id].kpress_fn = intern_fn(p.on_key_press)
        arena.nodes[node.id].focusable = 1
    }
    // `hover_off` is a plain bool field, so interning a thunk here only to
    // invoke it on the next line allocated a closure env capturing the whole
    // BoxProps (624 B) on every Component — and the env outlives the interned
    // copy, so it leaked once per node build. Read the field directly.
    if p.hover_off {
        hover_off(node)
    }
    if p.bind__set {
        bind(node, p.bind)
    }
    if p.visible__set {
        show(node, p.visible)
    }
    if p.press {
        arena.nodes[node.id].press = 1
    }
    if p.edit__set {
        if p.edit.id > 0 {
            let sig = p.edit
            let node_id = node.id
            arena.nodes[node_id].edit_sig = sig.id
            arena.nodes[node_id].bind_fn = intern_fn(|| { set(sig, arena.input_committed(node_id)) })
            /* Seed the edit buffer from the bound signal. The signal is the
               field's text until the user edits it, and the C-side buffer is
               what every read goes through (`input_shown`, the caret, and the
               Backspace / Delete handlers), so without this the field draws its
               PLACEHOLDER while the signal holds a value — and a Backspace has
               an empty buffer to delete from, i.e. clearing does nothing. That
               is what made a restored draft (std:kv) or a pre-filled form look
               and behave empty.

               Only on a real difference: a rebuild re-runs this on every
               keystroke, and `plat_edit_set` resets the caret to the end and
               drops the selection, so an unconditional seed would make typing
               anywhere but the end jump to the end. When the buffer already
               holds what the signal holds, the two agree and there is nothing
               to adopt. */
            let seed = sig.get()
            if arena.input_committed(node_id) != seed {
                set_input(node, seed)
            }
        }
    }
    if p.row_h != 0 {
        arena.nodes[node.id].row_h = p.row_h
    }
    if p.rebuild__set {
        arena.nodes[node.id].list_fn = intern_fn(p.rebuild)
    }
    if k == 7 {
        ensure_role_colors()
        set_background(node, role_color(ROLE.Rule))
        set_color(node, role_color(ROLE.Ink))
        border_color(node, role_color(ROLE.Plate))
        arena.nodes[node.id].focusable = 1
    }
    if k == 13 {
        ensure_role_colors()
        set_background(node, role_color(ROLE.Hard))
        set_color(node, role_color(ROLE.Ink))
        border_color(node, role_color(ROLE.Plate))
        if p.bind__set {
            keys(node, p.bind, 0, 100)
        }
    }
    if k == 6 {
        ensure_role_colors()
        set_background(node, role_color(ROLE.Hard))
        set_color(node, role_color(ROLE.Ink))
        border_color(node, role_color(ROLE.Plate))
    }
    if k == 9 {
        arena.nodes[node.id].dir = 1
        center(node)
        z_index(node, 50)
    }
    if k == 11 {
        if p.bind__set {
            let node_id = node.id
            let signal_id = p.bind.id
            styled(node, || {
                let y = signal_handle(signal_id).get()
                if arena.nodes[node_id].scroll_y != y {
                    arena.nodes[node_id].vel_y = 0
                    arena.nodes[node_id].scroll_y = y
                    arena.clamp_scroll(node_id)
                }
            })
        }
    }
    if ui_parents.len > 0 {
        let pid = ui_parents[ui_parents.len - 1]
        if pid > 0 {
            child(node_handle(pid), node)
        }
    }
    return node
}

/// Run `build` with `host` as the parent. Trailing blocks lower to this.
fn slot(host: Node, build: fn()) -> Node {
    ui_push(host.id)
    build()
    ui_pop()
    return host
}

/// Compiler trailing-block sugar until `slot` is the emitted name.
fn __ui_scope(node: Node, build: fn()) -> Node {
    return slot(node, build)
}

fn ui_emit(node: Node) -> Node {
    return Component(node)
}

// --- widgets ---
// Every prop is optional; an omitted one takes its declared default. A
// `foo__set` companion records whether the caller passed `foo`.

struct TextProps {
    color: string = "",
    font: int = -1,
    padding: int = -1,
    opacity: int = -1,
    // grow / shrink / show: as BoxProps. `grow = 1` text fills leftover row
    // space and narrows before the row wraps; `show` hides without
    // rebuilding.
    grow: int = -1,
    shrink: int = -1,
    show: bool = true,
    wrap: int = 0,
    /// Truncate with a trailing `…` when the label is wider than its box.
    /// Off by default: overflow (and `wrap`) stay the right answer for
    /// pinned and rotated chart text.
    ellipsis: bool = false,
    // position / left / top / right / bottom / z_index: as BoxProps. Pinned
    // labels are how axis ticks and rotated chart text place themselves.
    position: int = -1,
    left: int = -1,
    top: int = -1,
    right: int = -1,
    bottom: int = -1,
    z_index: int = -1,
    a11y_label: string = "",
    a11y_role: string = "",
    /// Chord that activates this node: `"cmd+s"`, `"ctrl+shift+p"`, or a
    /// sequence like `"g d"`. Every widget takes it — key binding is a prop,
    /// not something a particular widget hard-codes.
    key: string = "",
    /// Name the chord resolves to, so an app can remap it with `remap_key`
    /// without touching the widget. Defaults to `"key.<chord>"`.
    key_action: string = "",
    /// Handler for the chord; omit it and the chord runs `on_click`.
    on_key: fn() = noop,
    on_key__set: bool = false,
    /// true = fires wherever focus is, instead of only on this node.
    key_global: bool = false,
}

/// Options for `Button`. Default `look = LOOK.Solid` (gallery "Primary")
/// paints themed chrome. `look = -1` is a plain clickable label styled by
/// `background` / `color` / `font` / `padding` / `radius` / `width` /
/// `height` / `enabled` (dims when false). `on_click` fires it.
struct ButtonProps {
    /// Label of the Button. A thunk, so `"n = {{count.get()}}"` keeps
    /// updating; the compiler lifts a plain expression into it.
    label: fn() -> string = empty_text,
    /// `LOOK` token for themed chrome; `-1` = raw (props below decide the look).
    look: int = LOOK.Solid,
    /// `SIZE` token for themed chrome.
    size: int = SIZE.Md,
    /// Style props. Plain data — `radius = 4`, `background = paper()`. Each
    /// is re-evaluated by the effect that owns that attribute, so it follows
    /// a theme switch. `-1` / `""` keep the recipe's own value.
    background: string = "",
    color: string = "",
    radius: int = -1,
    padding: int = -1,
    padding_x: int = -1,
    padding_y: int = -1,
    width: int = -1,
    height: int = -1,
    font: int = -1,
    border: int = -1,
    border_color: string = "",
    spacing: int = -1,
    // position / left / top / right / bottom / z_index: as BoxProps.
    position: int = -1,
    left: int = -1,
    top: int = -1,
    right: int = -1,
    bottom: int = -1,
    z_index: int = -1,
    /// Visible when the thunk is true (signal shows win, as BoxProps).
    show: bool = true,
    /// `enabled = form_valid.get()` dims and disables reactively.
    enabled: bool = true,
    /// 1 silences the gray hover wash (the default: flat chrome).
    /// Set `hover_off = false` to let the button wash on hover.
    hover_off: bool = false,
    /// CSS cursor under the pointer (default `""` = arrow).
    cursor: string = "",
    /// Leading icon markup (`IC_PLUS`, ...). Sized to the `SIZE` token and
    /// tinted like the label. Themed chrome only.
    icon: string = "",
    /// 0/1 signal. While 1 the button is inert (no click, hover, or press),
    /// dims, and a spinner takes the icon slot. Themed chrome only.
    loading: Signal<int> = Signal { id: 0 },
    loading__set: bool = false,
    on_click: fn() = noop,
    on_click__set: bool = false,
    /// Chord that activates this node: `"cmd+s"`, `"ctrl+shift+p"`, or a
    /// sequence like `"g d"`. Every widget takes it — key binding is a prop,
    /// not something a particular widget hard-codes.
    key: string = "",
    /// Name the chord resolves to, so an app can remap it with `remap_key`
    /// without touching the widget. Defaults to `"key.<chord>"`.
    key_action: string = "",
    /// Handler for the chord; omit it and the chord runs `on_click`.
    on_key: fn() = noop,
    on_key__set: bool = false,
    /// true = fires wherever focus is, instead of only on this node.
    key_global: bool = false,
}

struct InputProps {
    placeholder: string = "",
    width: int = -1,
    height: int = -1,
    // position / left / top / right / bottom / z_index: as BoxProps.
    position: int = -1,
    left: int = -1,
    top: int = -1,
    right: int = -1,
    bottom: int = -1,
    z_index: int = -1,
    /// Visible when the thunk is true (signal shows win, as BoxProps).
    show: bool = true,
    color: string = "",
    background: string = "",
    font: int = -1,
    padding: int = -1,
    grow: int = -1,
    bind: Signal<string> = Signal { id: 0 },
    bind__set: bool = false,
    /// CSS cursor under the pointer (default `""` = arrow; inputs usually
    /// want `"text"` on their frame).
    cursor: string = "",
    a11y_label: string = "",
    /// 1 = multiline (Enter inserts a newline, wrap + caret up/down).
    multiline: int = 0,
    on_key_down: fn() = noop,
    on_key_down__set: bool = false,
    on_key_up: fn() = noop,
    on_key_up__set: bool = false,
    on_key_press: fn() = noop,
    on_key_press__set: bool = false,
    /// Chord that activates this node: `"cmd+s"`, `"ctrl+shift+p"`, or a
    /// sequence like `"g d"`. Every widget takes it — key binding is a prop,
    /// not something a particular widget hard-codes.
    key: string = "",
    /// Name the chord resolves to, so an app can remap it with `remap_key`
    /// without touching the widget. Defaults to `"key.<chord>"`.
    key_action: string = "",
    /// Handler for the chord; omit it and the chord runs `on_click`.
    on_key: fn() = noop,
    on_key__set: bool = false,
    /// true = fires wherever focus is, instead of only on this node.
    key_global: bool = false,
}

struct GridProps {
    config: GridConfig = GridConfig {},
    width: int = -1,
    background: string = "",
    padding: int = -1,
    // position / left / top / right / bottom / z_index: as BoxProps.
    position: int = -1,
    left: int = -1,
    top: int = -1,
    right: int = -1,
    bottom: int = -1,
    z_index: int = -1,
    /// Visible when the thunk is true (signal shows win, as BoxProps).
    show: bool = true,
    /// Chord that activates this node: `"cmd+s"`, `"ctrl+shift+p"`, or a
    /// sequence like `"g d"`. Every widget takes it — key binding is a prop,
    /// not something a particular widget hard-codes.
    key: string = "",
    /// Name the chord resolves to, so an app can remap it with `remap_key`
    /// without touching the widget. Defaults to `"key.<chord>"`.
    key_action: string = "",
    /// Handler for the chord; omit it and the chord runs `on_click`.
    on_key: fn() = noop,
    on_key__set: bool = false,
    /// true = fires wherever focus is, instead of only on this node.
    key_global: bool = false,
}

struct OverlayProps {
    background: string = "",
    opacity: int = -1,
    /// Visible when the thunk is true (signal shows win, as BoxProps).
    show: bool = true,
    /// Signal hide: `visible = open` is `show(node, open)`.
    visible: Signal<int> = Signal { id: 0 },
    visible__set: bool = false,
    on_click: fn() = noop,
    on_click__set: bool = false,
    /// Chord that activates this node: `"cmd+s"`, `"ctrl+shift+p"`, or a
    /// sequence like `"g d"`. Every widget takes it — key binding is a prop,
    /// not something a particular widget hard-codes.
    key: string = "",
    /// Name the chord resolves to, so an app can remap it with `remap_key`
    /// without touching the widget. Defaults to `"key.<chord>"`.
    key_action: string = "",
    /// Handler for the chord; omit it and the chord runs `on_click`.
    on_key: fn() = noop,
    on_key__set: bool = false,
    /// true = fires wherever focus is, instead of only on this node.
    key_global: bool = false,
}

/// Options for `Scroll`. `bind` is a two-way `scroll_y` signal: writing it
/// calls `scroll_to`, and wheel / pan / physics write the live offset back.
struct ScrollProps {
    width: int = -1,
    height: int = -1,
    grow: int = -1,
    bind: Signal<int> = Signal { id: 0 },
    bind__set: bool = false,
    /// Chord that activates this node: `"cmd+s"`, `"ctrl+shift+p"`, or a
    /// sequence like `"g d"`. Every widget takes it — key binding is a prop,
    /// not something a particular widget hard-codes.
    key: string = "",
    /// Name the chord resolves to, so an app can remap it with `remap_key`
    /// without touching the widget. Defaults to `"key.<chord>"`.
    key_action: string = "",
    /// Handler for the chord; omit it and the chord runs `on_click`.
    on_key: fn() = noop,
    on_key__set: bool = false,
    /// true = fires wherever focus is, instead of only on this node.
    key_global: bool = false,
}

/// One column of a `VirtualTable`. `width` 0 means the column takes an equal
/// share of the row (pair cells with `set_flex_basis_zero(...).grow(1)`); a positive value
/// is a pixel width. `title` is the header cell.
struct TableCol {
    title: string,
    width: int,
    /// Cell alignment for this column: `ALIGN.Start` (default), `Center`,
    /// or `End` — numbers go `End`. `TableCols` aligns the header and
    /// `TableRowCols` the body cells.
    align: int = 0,
    /// true = the header is a sort trigger (see `TableCols`' `sort`).
    sortable: bool = false,
}

/// Extras for `TableCols`: `sort` is the sort state. `0` = none; `i + 1` =
/// column `i` ascending; `-(i + 1)` = descending. Clicking a sortable header
/// cycles none → asc → desc → none on its column and clears the others; the
/// app orders its rows from the signal. An arrow marks the sorted column.
struct TableColsProps {
    sort: Signal<int> = Signal { id: 0 },
    sort__set: bool = false,
}

/// Extras for `TableRow` / `TableRowCols`. `zebra` shades every second body
/// row (counted among the row's siblings, so a header does not count);
/// `hover` washes the row under the pointer; `on_click` makes the row a
/// pointer target (hover implied).
struct TableRowProps {
    zebra: bool = false,
    hover: bool = false,
    on_click: fn() = noop,
    on_click__set: bool = false,
}

/// Geometry for `Svg` layers: explicit size plus absolute placement
/// (`position` / `left` / `top` / `right` / `bottom` / `z_index`, as
/// `BoxProps`). Without `width`/`height` an svg is measured like a label.
struct SvgProps {
    width: int = -1,
    height: int = -1,
    position: int = -1,
    left: int = -1,
    top: int = -1,
    right: int = -1,
    bottom: int = -1,
    z_index: int = -1,
    /// Visible when the thunk is true (signal shows win, as BoxProps).
    show: bool = true,
    /// Chord that activates this node: `"cmd+s"`, `"ctrl+shift+p"`, or a
    /// sequence like `"g d"`. Every widget takes it — key binding is a prop,
    /// not something a particular widget hard-codes.
    key: string = "",
    /// Name the chord resolves to, so an app can remap it with `remap_key`
    /// without touching the widget. Defaults to `"key.<chord>"`.
    key_action: string = "",
    /// Handler for the chord; omit it and the chord runs `on_click`.
    on_key: fn() = noop,
    on_key__set: bool = false,
    /// true = fires wherever focus is, instead of only on this node.
    key_global: bool = false,
}

/// Options for `Image`. Hosts decode PNG / JPEG / WebP / GIF from a path,
/// data URI, or URL and cache by `src`. With no `width`/`height` the box
/// takes the decoded source size: it keeps the source aspect ratio and fills
/// the container (device) width without growing past the source — web
/// `max-width: 100%`. Give `width` and the height follows the aspect ratio;
/// give `height` and the width is the container width. Set both to pin a box
/// that `fit` then maps the bitmap into. `fit` is `IMAGE_FIT` (stretch /
/// contain / cover / none).
struct ImageProps {
    width: int = -1,
    height: int = -1,
    radius: int = -1,
    /// `IMAGE_FIT.Stretch` (default), `.Contain`, `.Cover`, or `.None`.
    fit: int = 0,
    /// 1 = decode only once the node intersects the view (skip off-screen).
    lazy: int = 0,
    opacity: int = -1,
    grow: int = -1,
    shrink: int = -1,
    min_width: int = -1,
    max_width: int = -1,
    min_height: int = -1,
    max_height: int = -1,
    position: int = -1,
    left: int = -1,
    top: int = -1,
    right: int = -1,
    bottom: int = -1,
    z_index: int = -1,
    /// Visible when the thunk is true (signal shows win, as BoxProps).
    show: bool = true,
    a11y_label: string = "",
    /// Chord that activates this node: `"cmd+s"`, `"ctrl+shift+p"`, or a
    /// sequence like `"g d"`. Every widget takes it — key binding is a prop,
    /// not something a particular widget hard-codes.
    key: string = "",
    /// Name the chord resolves to, so an app can remap it with `remap_key`
    /// without touching the widget. Defaults to `"key.<chord>"`.
    key_action: string = "",
    /// Handler for the chord; omit it and the chord runs `on_click`.
    on_key: fn() = noop,
    on_key__set: bool = false,
    /// true = fires wherever focus is, instead of only on this node.
    key_global: bool = false,
}

/// A flex container. Trailing block is the slot.
fn Box(p: BoxProps) -> Node {
    return Component(raw_box(), p)
}

/// Static or reactive text. The label is a thunk, so a signal read inside it
/// is recorded against this label's own effect: setting the signal repaints
/// this one node. The compiler lifts a plain expression —
/// `Text("n={{count.get()}}")` — into that thunk, so callers write data.
fn Text(label: fn() -> string, p: TextProps) -> Node {
    let __n = Component(raw_label(""), text = label, color = p.color, font = p.font,
                        padding = p.padding, opacity = p.opacity, grow = p.grow, shrink = p.shrink,
                        show = p.show, wrap = p.wrap, position = p.position, left = p.left,
                        top = p.top, right = p.right, bottom = p.bottom, z_index = p.z_index,
                        a11y_label = p.a11y_label, a11y_role = p.a11y_role)
    if p.ellipsis {
        text_ellipsis(__n)
    }
    return apply_key(__n, p.key, p.key_action, p.on_key, p.on_key__set, p.key_global)
}

/// Action button. Default `look = LOOK.Solid`. `look = -1` is a plain label.
fn Button(p: ButtonProps) -> Node {
    if p.look >= 0 {
        return btn_look(p)
    }
    let __n = Component(raw_button(""), text = p.label, color = p.color,
                        background = p.background, font = p.font, padding = p.padding,
                        radius = p.radius, width = p.width, height = p.height,
                        position = p.position, left = p.left, top = p.top, right = p.right,
                        bottom = p.bottom, z_index = p.z_index, show = p.show,
                        enabled = p.enabled, cursor = p.cursor, on_click = p.on_click,
                        hover_off = p.hover_off, a11y_role = "button", a11y_label = p.label(),
                        press = p.on_click__set)
    if p.hover_off == false {
        hover_fade(__n)
    }
    press_scale(__n)
    return apply_key(__n, p.key, p.key_action, p.on_key, p.on_key__set, p.key_global)
}

/// Disabled fill for themed chrome: a muted plate instead of the accent at
/// 40% alpha, so a disabled Solid button reads as a control that is off
/// rather than a washed-out one. Outline keeps its ring on `rule()`.
fn button_disabled_background(look: int) -> string {
    match look {
        LOOK.Ghost | LOOK.Link => { return "" }
        _ => { return raised() }
    }
}

/// Icon size for a `SIZE` token; see `button_padding_x`.
fn button_icon(size: int) -> int {
    if size == SIZE.Sm { 14 } else { 16 }
}

/// Themed chrome branch of `Button`.
fn btn_look(p: ButtonProps) -> Node {
    let look = p.look
    let size = p.size
    let mut fill = str_or_default(p.background, button_background(look))
    let mut ink_c = str_or_default(p.color, button_color(look))
    let mut edge = str_or_default(p.border_color, button_border_color(look))
    if p.enabled == false {
        fill = str_or_default(p.background, button_disabled_background(look))
        ink_c = str_or_default(p.color, mute())
        edge = str_or_default(p.border_color, rule())
    }
    let n = Box(
        align_direction = DIRECTION.Row,
        align_items = ALIGN.Center,
        justify = ALIGN.Center,
        spacing = px_or_default(p.spacing, SPACE.Exs),
        background = fill,
        color = ink_c,
        width = p.width,
        height = px_or_default(p.height, button_height(size)),
        padding_x = px_or_default(p.padding_x, px_or_default(p.padding, button_padding_x(size))),
        radius = px_or_default(p.radius, button_radius(size)),
        border = px_or_default(p.border, button_border_width(look)),
        border_color = edge,
        on_click = p.on_click,
        on_click__set = p.on_click__set,
        a11y_role = "button",
        a11y_label = p.label(),
        show = p.show,
        padding_y = p.padding_y,
        hover_off = p.hover_off,
        cursor = "pointer",
        press = true
    )
    // Disabled: the muted fill above is the styling; the shared overlay
    // still turns hover / press / activation off. The 40% dim `enabled`
    // would apply through `Component` is replaced by a lighter 70%, since
    // the fill swap already carries the state.
    if p.enabled == false {
        disabled(n, true)
        set_prop_int(n, SET.Opacity, 70)
    }
    ui_push(n.id)
    if p.loading__set {
        let sp = Spinner(size = button_icon(size), color = ink_c)
        show(sp, p.loading)
    }
    if p.icon.len > 0 {
        let ic = Icon(p.icon, button_icon(size), ink_c)
        if p.loading__set {
            // The spinner takes the icon slot while loading.
            show_eq(ic, p.loading, 0)
        }
    }
    Text(p.label, color = ink_c, font = px_or_default(p.font, button_font(size)))
    ui_pop()
    if p.loading__set {
        let node_id = n.id
        let ls = p.loading
        effect(|| {
            if ls.get() != 0 {
                arena.set_loading(node_id, 1)
                arena.nodes[node_id].opacity = i16(70)
            } else {
                arena.set_loading(node_id, 0)
                arena.nodes[node_id].opacity = i16(100)
            }
        })
    }
    // Chrome hover is explicit: a themed button stays a hover target even
    // when it has no click handler (`is_hot` would otherwise require one).
    if p.hover_off == false {
        hover_fade(n)
    }
    press_scale(n)
    return n
}

/// Text field. `multiline = 1` wraps and lets Enter insert a newline.
/// `bind = sig` writes the committed buffer into a `Signal<string>` on every
/// edit; the store notifies only on a real change.
fn Input(p: InputProps) -> Node {
    let __n = Component(raw_input(p.placeholder), width = p.width, height = p.height,
                        position = p.position, left = p.left, top = p.top, right = p.right,
                        bottom = p.bottom, z_index = p.z_index, show = p.show, color = p.color,
                        background = p.background, font = p.font, padding = p.padding,
                        grow = p.grow, a11y_label = p.a11y_label, cursor = p.cursor,
                        multiline = p.multiline, a11y_role = "textbox", edit = p.bind,
                        on_key_down = p.on_key_down, on_key_down__set = p.on_key_down__set,
                        on_key_up = p.on_key_up, on_key_up__set = p.on_key_up__set,
                        on_key_press = p.on_key_press, on_key_press__set = p.on_key_press__set)
    return apply_key(__n, p.key, p.key_action, p.on_key, p.on_key__set, p.key_global)
}

/// 2D grid. Fixed: `config = GridConfig(columns = 3, gap = 12, padding = 16)`.
/// Responsive: `auto_columns` is the narrowest a cell may be, in points like
/// `gap`. `GridConfig(columns = 3, auto_columns = 220, gap = 12)` fits as many
/// 220 point cells as the width allows — three at most, the `columns` cap —
/// and `auto_columns = 0` instead sizes a cell to the widest child.
fn Grid(p: GridProps) -> Node {
    let __n = Component(
        set_auto_columns(raw_grid(p.config.columns, p.config.gap), p.config.auto_columns),
        width = p.width,
        padding = p.config.padding, position = p.position, left = p.left,
        top = p.top, right = p.right, bottom = p.bottom, z_index = p.z_index,
        show = p.show, background = p.background)
    return apply_key(__n, p.key, p.key_action, p.on_key, p.on_key__set, p.key_global)
}

/// Full-window floater. Kind 9 is out of flow. Children are centred.
fn Overlay(p: OverlayProps) -> Node {
    let __n = Component(raw_overlay(), background = p.background, opacity = p.opacity,
                        show = p.show, visible = p.visible, on_click = p.on_click)
    return apply_key(__n, p.key, p.key_action, p.on_key, p.on_key__set, p.key_global)
}

/// A column that skips layout while `visible` is 0. Trailing block is the body.
/// The subtree is built once (retained), unlike a build-time `if`.
fn If(visible: Signal<int>) -> Node {
    return Box(align_direction = DIRECTION.Column, visible = visible)
}

/// Run `build(i, item)` for each element. `[]T` is Copy when `T` is Copy, so
/// this is safe inside a trailing block.
fn Each<T>(items: []T, build: fn(int, T)) {
    let n = items.len
    for i in 0..n {
        build(i, items[i])
    }
}

/// Append `v` to a live list signal and notify. Use with `For` / `VirtualList`.
/// A windowed list only rebuilds the visible window, not every row.
fn push_item<T>(sig: Signal<[]T>, v: T) {
    let mut xs = sig.get()
    push(xs, v)
    sig.set(xs)
}

/// Insert `v` at index `i` (clamped to `0..len`). Use with `For` / `VirtualList`.
fn insert_item<T>(sig: Signal<[]T>, i: int, v: T) {
    let xs = sig.get()
    let n = xs.len
    let mut at = i
    if at < 0 {
        at = 0
    }
    if at > n {
        at = n
    }
    let mut out = []T {}
    let mut j = 0
    while j < at {
        push(out, xs[j])
        j = j + 1
    }
    push(out, v)
    while j < n {
        push(out, xs[j])
        j = j + 1
    }
    sig.set(out)
}

/// Remove the item at index `i`. No-op if `i` is out of range.
fn remove_item<T>(sig: Signal<[]T>, i: int) {
    let xs = sig.get()
    let n = xs.len
    if i < 0 {
        return
    }
    if i >= n {
        return
    }
    let mut out = []T {}
    let mut j = 0
    while j < n {
        if j != i {
            push(out, xs[j])
        }
        j = j + 1
    }
    sig.set(out)
}

/// Remove the last item from a live list signal. No-op if empty.
fn pop_item<T>(sig: Signal<[]T>) {
    let mut xs = sig.get()
    if xs.len > 0 {
        pop(xs)
        sig.set(xs)
    }
}

struct VirtWin {
    first: int,
    last: int,
}

fn find_scroller(id: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= arena.nodes.len {
        return 0
    }
    if int(arena.nodes[id].kind) == 11 {
        return id
    }
    let mut p = arena.nodes[id].parent
    while p > 0 {
        if int(arena.nodes[p].kind) == 11 {
            return p
        }
        p = arena.nodes[p].parent
    }
    return 0
}

/// Visible index window for a windowed list. `row_h` is the fixed row height
/// used to turn `scroll_y` into indices; overscan keeps a few extra rows
/// mounted so a small flick does not rebuild.
fn virtual_window(node_id: int, n: int, row_h: int) -> VirtWin {
    let mut first = 0
    let mut last = n
    if row_h <= 0 {
        return VirtWin { first: first, last: last }
    }
    let signal_id = find_scroller(node_id)
    let mut view_h = 240
    let mut local = 0
    if signal_id > 0 {
        if arena.nodes[signal_id].h > 0 {
            view_h = arena.nodes[signal_id].h
        }
        if node_id == signal_id {
            local = arena.nodes[signal_id].scroll_y
        } else {
            local = arena.nodes[signal_id].scroll_y - (arena.nodes[node_id].y - arena.nodes[signal_id].y)
        }
    } else if arena.nodes[node_id].h > 0 {
        view_h = arena.nodes[node_id].h
    }
    if local < 0 {
        local = 0
    }
    first = local / row_h - VIRT_OVERSCAN
    last = (local + view_h) / row_h + VIRT_OVERSCAN + 1
    if first < 0 {
        first = 0
    }
    if last > n {
        last = n
    }
    if last < first {
        last = first
    }
    return VirtWin { first: first, last: last }
}

fn virtual_refresh<T>(node_id: int, items: Signal<[]T>, build: fn(int, T), row_h: int) {
    let xs = items.get()
    let m = xs.len
    let gen = platform.plat_sig_gen(items.id)
    let mut first = 0
    let mut last = m
    if row_h > 0 {
        let w = virtual_window(node_id, m, row_h)
        first = w.first
        last = w.last
    }
    if gen == arena.nodes[node_id].list_gen {
        if first == arena.nodes[node_id].list_lo {
            if last == arena.nodes[node_id].list_hi {
                if arena.nodes[node_id].kids.len > 0 {
                    return
                }
                if m == 0 {
                    arena.nodes[node_id].list_n = 0
                    return
                }
            }
        }
    }
    arena.nodes[node_id].list_gen = gen
    arena.nodes[node_id].list_lo = first
    arena.nodes[node_id].list_hi = last
    arena.nodes[node_id].list_n = m
    arena.nodes[node_id].row_h = row_h
    // Everything the builder allocated last time is owned by this host:
    // signals and interned handlers are freed (and their ids recycled) on
    // the next rebuild, so streaming data does not grow the arena. A
    // windowed list only (re)builds the visible rows — append / insert
    // outside the window is a spacer resize, not O(n) widgets.
    let previous = arena.rebuild_begin(node_id)
    ui_push(node_id)
    if row_h > 0 {
        if first > 0 {
            let top = raw_spacer()
            set_height(top, first * row_h)
            Component(top)
        }
    }
    let mut i = first
    while i < last {
        build(i, xs[i])
        i = i + 1
    }
    if row_h > 0 {
        if last < m {
            let bot = raw_spacer()
            set_height(bot, (m - last) * row_h)
            Component(bot)
        }
    }
    ui_pop()
    arena.rebuild_end(previous)
}

fn virtual_row_h(heights: []int, i: int, fallback: int) -> int {
    if i >= 0 {
        if i < heights.len {
            if heights[i] > 0 {
                return heights[i]
            }
        }
    }
    return fallback
}

fn virtual_prefix(heights: []int, n: int, fallback: int) -> int {
    let mut y = 0
    let mut i = 0
    while i < n {
        y = y + virtual_row_h(heights, i, fallback)
        i = i + 1
    }
    return y
}

fn virt_window_var(node_id: int, n: int, heights: []int, fallback: int) -> VirtWin {
    if heights.len == 0 {
        return virtual_window(node_id, n, fallback)
    }
    let signal_id = find_scroller(node_id)
    let mut view_h = 240
    let mut local = 0
    if signal_id > 0 {
        if arena.nodes[signal_id].h > 0 {
            view_h = arena.nodes[signal_id].h
        }
        if node_id == signal_id {
            local = arena.nodes[signal_id].scroll_y
        } else {
            local = arena.nodes[signal_id].scroll_y - (arena.nodes[node_id].y - arena.nodes[signal_id].y)
        }
    } else if arena.nodes[node_id].h > 0 {
        view_h = arena.nodes[node_id].h
    }
    if local < 0 {
        local = 0
    }
    let mut acc = 0
    let mut first = n
    let mut last = n
    let mut i = 0
    while i < n {
        let rh = virtual_row_h(heights, i, fallback)
        if acc + rh > local {
            first = i
            break
        }
        acc = acc + rh
        i = i + 1
    }
    first = first - VIRT_OVERSCAN
    if first < 0 {
        first = 0
    }
    acc = virtual_prefix(heights, first, fallback)
    last = first
    while last < n {
        if acc >= local + view_h {
            last = last + VIRT_OVERSCAN
            if last > n {
                last = n
            }
            return VirtWin { first: first, last: last }
        }
        acc = acc + virtual_row_h(heights, last, fallback)
        last = last + 1
    }
    return VirtWin { first: first, last: last }
}

fn virt_refresh_var<T>(node_id: int, items: Signal<[]T>, build: fn(int, T), fallback: int,
                       heights: Signal<[]int>) {
    let xs = items.get()
    let hs = heights.get()
    let m = xs.len
    let gen = platform.plat_sig_gen(items.id) + platform.plat_sig_gen(heights.id)
    let w = virt_window_var(node_id, m, hs, fallback)
    let first = w.first
    let last = w.last
    if gen == arena.nodes[node_id].list_gen {
        if first == arena.nodes[node_id].list_lo {
            if last == arena.nodes[node_id].list_hi {
                if arena.nodes[node_id].kids.len > 0 {
                    return
                }
                if m == 0 {
                    arena.nodes[node_id].list_n = 0
                    return
                }
            }
        }
    }
    arena.nodes[node_id].list_gen = gen
    arena.nodes[node_id].list_lo = first
    arena.nodes[node_id].list_hi = last
    arena.nodes[node_id].list_n = m
    arena.nodes[node_id].row_h = fallback
    let previous = arena.rebuild_begin(node_id)
    ui_push(node_id)
    if first > 0 {
        let top = raw_spacer()
        set_height(top, virtual_prefix(hs, first, fallback))
        Component(top)
    }
    let mut i = first
    while i < last {
        build(i, xs[i])
        i = i + 1
    }
    if last < m {
        let bot = raw_spacer()
        set_height(bot, virtual_prefix(hs, m, fallback) - virtual_prefix(hs, last, fallback))
        Component(bot)
    }
    ui_pop()
    arena.rebuild_end(previous)
}

/// Positional list. `items` is `zeus.signal([]T {})` (`T` Copy). Rows are
/// rebuilt in place on every change; use `For` when a row must keep its state
/// across a reorder.
fn Index<T>(items: Signal<[]T>, build: fn(int, T)) -> Node {
    let n = raw_box()
    let node_id = n.id
    virtual_refresh(node_id, items, build, 0)
    return Component(n, align_direction = DIRECTION.Column,
                     rebuild = || { virtual_refresh(node_id, items, build, 0) })
}

fn kfor_unique<T>(xs: []T, key: fn(T) -> string, m: int) -> int {
    let mut i = 0
    while i < m {
        let mut j = i + 1
        while j < m {
            if key(xs[i]) == key(xs[j]) {
                return 0
            }
            j = j + 1
        }
        i = i + 1
    }
    return 1
}

/// Keyed list. `items` is `zeus.signal([]T {})` (`T` Copy); `key(item)` must
/// return a stable, unique string. Rows are mounted once per key and **moved**
/// on reorder, so focus and per-row state survive and a pure reorder allocates
/// nothing. A changed key set (insert / remove) rebuilds the host and recycles
/// every row. `build(i, item)` runs at mount; for content that follows the
/// item, read a signal inside the row instead of `i`.
fn For<T>(items: Signal<[]T>, key: fn(T) -> string, build: fn(int, T)) -> Node {
    let n = raw_box()
    let node_id = n.id
    kfor_refresh(node_id, items, key, build)
    return Component(n, align_direction = DIRECTION.Column,
                     rebuild = || { kfor_refresh(node_id, items, key, build) })
}

fn kfor_refresh<T>(node_id: int, items: Signal<[]T>, key: fn(T) -> string, build: fn(int, T)) {
    let xs = items.get()
    let m = xs.len
    // Fast path: the key set is unchanged, so move the existing rows into the
    // new order. Node ids, focus, scroll and row state all survive; nothing is
    // allocated. A changed key set (or duplicate keys) falls through.
    if arena.key_count(node_id) == m {
        if kfor_unique(xs, key, m) == 1 {
            let mut ok = 1
            let mut i = 0
            while i < m {
                if arena.key_node(node_id, key(xs[i])) <= 0 {
                    ok = 0
                    break
                }
                i = i + 1
            }
            if ok == 1 {
                let mut order = []int {}
                let mut j = 0
                while j < m {
                    push(order, arena.key_node(node_id, key(xs[j])))
                    j = j + 1
                }
                arena.nodes[node_id].kids = order
                return
            }
        }
    }
    // Slow path: rebuild the host; every row is re-created and recycled.
    arena.key_clear(node_id)
    let previous = arena.rebuild_begin(node_id)
    ui_push(node_id)
    let mut i = 0
    while i < m {
        let before = arena.nodes[node_id].kids.len
        build(i, xs[i])
        let after = arena.nodes[node_id].kids.len
        // A row must be a single top-level child to be movable. If the builder
        // mounted zero or several, record nothing so the next update rebuilds
        // rather than reorders a partial row.
        if after == before + 1 {
            arena.key_set(node_id, key(xs[i]), arena.nodes[node_id].kids[before])
        } else {
            arena.key_set(node_id, key(xs[i]), 0)
        }
        i = i + 1
    }
    ui_pop()
    arena.rebuild_end(previous)
}

/// One arm mounted at a time. `on` is a live signal; `build(value)` rebuilds
/// the host whenever `on` changes, so only the current arm is in the tree.
/// Pair with an integer tag signal for a switch/match.
fn Match<T>(on: Signal<T>, build: fn(T)) -> Node {
    let n = raw_box()
    let node_id = n.id
    match_build(node_id, on, build)
    return Component(n, align_direction = DIRECTION.Column,
                     rebuild = || { match_refresh(node_id, on, build) })
}

/// Tear the subtree down and rebuild it for the current value of `on`.
/// `list_gen` records the slot it was built from, so `match_refresh` can tell
/// a real change from a bare refresh sweep.
fn match_build<T>(node_id: int, on: Signal<T>, build: fn(T)) {
    arena.nodes[node_id].list_gen = platform.plat_sig_gen(on.id)
    let previous = arena.rebuild_begin(node_id)
    ui_push(node_id)
    build(on.get())
    ui_pop()
    arena.rebuild_end(previous)
}

/// `refresh_lists` invokes every node that has a `list_fn`, on every layout.
/// The refit and For/Index hosts all return early when nothing changed; Match
/// did not, so each layout ran `rebuild_begin` — which calls `release_sigs` —
/// and every `zeus.signal` the page declared was freed and re-created at its
/// initial value. Page state reset on any repaint, which reads as "signals
/// don't work" in a routed app. Rebuild only when `on` actually moved.
fn match_refresh<T>(node_id: int, on: Signal<T>, build: fn(T)) {
    if platform.plat_sig_gen(on.id) == arena.nodes[node_id].list_gen {
        return
    }
    match_build(node_id, on, build)
}

/// Error boundary. `build()` runs under a recoverable trap; if it traps, the
/// partial subtree is discarded, the arena is rolled back to its entry mark,
/// and `fallback(message)` is built in its place, so the rest of the app keeps
/// running. Recovers UI state only: C-seam side effects (I/O, network) are not
/// undone, and a trap raised outside `build` (e.g. in a later layout effect) is
/// not caught. On wasm there is no `setjmp`, so a trap still aborts.
fn Boundary(build: fn(), fallback: fn(string)) -> Node {
    let host = raw_box()
    let hid = host.id
    let m = arena.mark()
    let previous = arena.scope_begin(hid)
    ui_push(hid)
    let stack0 = ui_parents.len
    let msg = platform.plat_boundary(build)
    arena.scope_end(previous)
    if msg.len == 0 {
        ui_pop()
    } else {
        // A trap skipped the normal pop: unwind the build stack by hand.
        while ui_parents.len > stack0 {
            pop(ui_parents)
        }
        ui_pop()
        arena.rollback(hid, m)
        ui_push(hid)
        fallback(msg)
        ui_pop()
    }
    return Component(host, align_direction = DIRECTION.Column)
}

/// Vertical scroller that window-renders `items`. `row_h` is the fixed row
/// height in points (spacers use it so `scroll_max` matches the full list).
/// `build(i, item)` is the row. 10k rows stay a few dozen nodes.
fn VirtualList<T>(items: Signal<[]T>, row_h: int, build: fn(int, T)) -> Node {
    let n = raw_scroll()
    let node_id = n.id
    virtual_refresh(node_id, items, build, row_h)
    return Component(n, grow = 1, a11y_role = "list", row_h = row_h,
                     rebuild = || { virtual_refresh(node_id, items, build, row_h) })
}

/// Windowed list with per-row heights. `heights[i]` is row `i` in points
/// (0 / missing uses `fallback`). Spacers use the prefix sum so `scroll_max`
/// matches the real list.
fn VirtualListVar<T>(items: Signal<[]T>, heights: Signal<[]int>, fallback: int,
                     build: fn(int, T)) -> Node {
    let n = raw_scroll()
    let node_id = n.id
    virt_refresh_var(node_id, items, build, fallback, heights)
    return Component(n, grow = 1, a11y_role = "list", row_h = fallback,
                     rebuild = || { virt_refresh_var(node_id, items, build, fallback, heights) })
}

/// Windowed table. `rows` is `zeus.signal([]T {})` where `T` is a row struct;
/// `cols` is `[]TableCol` (title + width) for the header. The body is a
/// `VirtualList` of `build(i, row)` — only visible rows are mounted. The
/// themed header (`TableCols`) shares its gutter with body rows; build every
/// cell with `set_flex_basis_zero(...).grow(1)` (or a fixed `.set_width(px)` matching the column)
/// so body columns line up under the header.
/// Extras for `VirtualTable`: `sort` wires the header's sortable columns
/// (see `TableColsProps`). Rows are the app's `Signal<[]T>`, so the app
/// reorders them — `sort_by` with a key per column — in an effect on `sort`.
struct VirtualTableProps {
    sort: Signal<int> = Signal { id: 0 },
    sort__set: bool = false,
}

fn VirtualTable<T>(rows: Signal<[]T>, cols: []TableCol, row_h: int, build: fn(int, T),
                   p: VirtualTableProps) -> Node {
    let wrap = raw_box()
    ui_push(wrap.id)
    TableCols(cols, sort = p.sort, sort__set = p.sort__set)
    VirtualList(rows, row_h, build)
    ui_pop()
    return Component(wrap, align_direction = DIRECTION.Column, grow = 1,
                     a11y_role = "table")
}

/// Jump `n` (a `Scroll` / `VirtualList`) to vertical offset `y`. Clears
/// residual velocity so physics does not coast past the target. Clamped.
fn scroll_to(n: Node, y: int) -> Node {
    arena.nodes[n.id].vel_y = 0
    arena.nodes[n.id].scroll_y = y
    arena.clamp_scroll(n.id)
    if arena.nodes[n.id].bind_sig > 0 {
        arena.store_sig(arena.nodes[n.id].bind_sig, arena.nodes[n.id].scroll_y)
    }
    return n
}

/// Jump `n` to horizontal offset `x`.
fn scroll_to_x(n: Node, x: int) -> Node {
    arena.nodes[n.id].vel_x = 0
    arena.nodes[n.id].scroll_x = x
    arena.clamp_scroll(n.id)
    return n
}

/// Jump a windowed list so item `i` is at the top of the viewport.
fn scroll_to_index(n: Node, i: int) -> Node {
    let mut rh = arena.nodes[n.id].row_h
    if rh < 1 {
        rh = 1
    }
    let mut at = i
    if at < 0 {
        at = 0
    }
    return scroll_to(n, at * rh)
}

/// Live `scroll_y` of `n`.
fn scroll_y(n: Node) -> int {
    return arena.nodes[n.id].scroll_y
}

/// Width a node measured by the last layout pass (0 until the first one).
fn measured_width(n: Node) -> int {
    return arena.nodes[n.id].w
}

/// Re-run `build` into `host` whenever the host's measured width changes
/// (window resize, card reflow). `host` must be widthless so it stretches
/// with its parent. Pixel-exact widgets — charts, plots — lay out their
/// children from the measured width, so they stay glued to the container.
/// Rebuilds happen on the layout after a size change.
fn refit_refresh(node_id: int, build: fn()) {
    let w = arena.nodes[node_id].w
    if w == arena.nodes[node_id].list_gen {
        return
    }
    // A zero-width host (hidden tab, or not laid out yet) defers its rebuild
    // until it is measured at a real width. Syncing `list_gen` here keeps it
    // from refitting on every resize frame while off-screen.
    if w == 0 {
        arena.nodes[node_id].list_gen = 0
        return
    }
    arena.nodes[node_id].list_gen = w
    let previous = arena.rebuild_begin(node_id)
    slot(node_handle(node_id), build)
    arena.rebuild_end(previous)
}

fn refit(host: Node, build: fn()) -> Node {
    arena.ensure()
    let node_id = host.id
    arena.nodes[node_id].list_fn = intern_fn(|| {
        refit_refresh(node_id, build)
    })
    return host
}

/// Vertical scroller. Children keep intrinsic height; a bar appears on overflow.
/// `bind` is an optional two-way `scroll_y` signal (`scroll_to` writes it).
fn Scroll(p: ScrollProps) -> Node {
    let __n = Component(raw_scroll(), width = p.width, height = p.height,
                        grow = p.grow, bind = p.bind)
    return apply_key(__n, p.key, p.key_action, p.on_key, p.on_key__set, p.key_global)
}

/// Inline SVG. `currentColor` follows the node's foreground. Geometry props:
/// `width`, `height` (an svg is otherwise measured like a label), plus the
/// usual `position` / pins / `z_index` for layered plots.
fn Svg(markup: string, p: SvgProps) -> Node {
    let __n = Component(raw_svg(markup), width = p.width, height = p.height,
                        position = p.position, left = p.left, top = p.top, right = p.right,
                        bottom = p.bottom, z_index = p.z_index, show = p.show)
    return apply_key(__n, p.key, p.key_action, p.on_key, p.on_key__set, p.key_global)
}

/// Raster image. `src` is a file path, `data:` URI, or `http(s):` URL — a
/// thunk, so a signal read inside it repaints this node. Hosts decode PNG /
/// JPEG / WebP / GIF and cache by that string; a missing or still-loading
/// src paints nothing. With no `width`/`height` the node auto-sizes to the
/// container (device) width at the source aspect ratio — see `ImageProps`.
/// `fit` is `IMAGE_FIT` (stretch / contain / cover / none). `lazy = 1` skips
/// decode while off-screen.
fn Image(src: fn() -> string, p: ImageProps) -> Node {
    return Component(raw_image(""), text = src, width = p.width, height = p.height,
                     radius = p.radius, fit = p.fit, lazy = p.lazy, opacity = p.opacity,
                     grow = p.grow, shrink = p.shrink, min_width = p.min_width,
                     max_width = p.max_width, min_height = p.min_height, max_height = p.max_height,
                     position = p.position, left = p.left, top = p.top, right = p.right,
                     bottom = p.bottom, z_index = p.z_index, show = p.show,
                     a11y_label = p.a11y_label, a11y_role = "img")
}

let mut pick_dest: Signal<string> = Signal { id: 0 }
let mut pick_w: Signal<int> = Signal { id: 0 }
let mut pick_h: Signal<int> = Signal { id: 0 }

/// Open a host file picker (PNG / JPEG / WebP / GIF). Writes the chosen src
/// into `dest` and the image's intrinsic size into `dw` / `dh`. Native hosts
/// return from the dialog; wasm and mobile finish via `engine_picked_image`.
fn pick_image(dest: Signal<string>, dw: Signal<int>, dh: Signal<int>) {
    pick_dest = dest
    pick_w = dw
    pick_h = dh
    let mut w = 0
    let mut h = 0
    let src = platform.plat_pick_image(&mut w, &mut h)
    if src.len > 0 {
        set(dest, src)
        set(dw, w)
        set(dh, h)
        pick_dest = Signal { id: 0 }
        pick_w = Signal { id: 0 }
        pick_h = Signal { id: 0 }
    }
}

/// Host async completion for `pick_image` (file input, photo library).
fn engine_picked_image(src: string, w: int, h: int) {
    if pick_dest.id > 0 {
        if src.len > 0 {
            set(pick_dest, src)
            if pick_w.id > 0 {
                set(pick_w, w)
            }
            if pick_h.id > 0 {
                set(pick_h, h)
            }
        }
        pick_dest = Signal { id: 0 }
        pick_w = Signal { id: 0 }
        pick_h = Signal { id: 0 }
    }
}

/// Open a window and build the tree once. The tree is retained: signals
/// update the props that read them, never a whole subtree.
/// Size comes from the host (`window_size`): on desktop that is the device
/// screen's work area and on iOS/Android the full screen, so an app opens
/// screen-filling. Trailing `width` / `height` pin an exact macOS/wasm window
/// instead (a first size before the view exists, and headless draw tests).
/// The desktop host bounds what a screen-sized window costs with its backing
/// scale (`ZEUS_BACKING_SCALE`), never by shrinking the window.
/// The root is a vertical scroller: children keep their intrinsic height and
/// a bar appears when they overflow. A full-bleed `VirtualList` inside should
/// `grow = 1` so it is the scrolling pane — nested momentum chaining is not
/// this function.
fn App(title: string, build: fn(), width: int = 0, height: int = 0) {
    init()
    let mut w = width
    let mut h = height
    let win_size = window_size()
    if w <= 0 {
        w = win_size.width
    }
    if h <= 0 {
        h = win_size.height
    }
    window(title, w, h)
    let top = raw_scroll()
    // Paint the page background on the root scroller itself (theme-aware,
    // like `Page`): when content rubber-bands past the top/bottom edge or
    // ends short of the viewport, the revealed strip stays paper instead of
    // showing the host's clear color (black on a dark window / wasm page).
    // Root already takes host safe-area insets (`inset_here(root)`).
    Component(top, background = paper())
    slot(top, build)
    root(top)
    raw_run()
}

// ═══════════════════════════════════════════════════════════════════
// Design system: zinc palette + theme roles, LOOK / SIZE / TINT tokens,
// typography and radius constants, lucide icon paths, and themed chrome —
// Card / Chip / Badge / Dialog / forms (Field, TextInput, TextArea) / tabs /
// select / radio / toggle / Pagination / charts / DatePicker / Page.
// ═══════════════════════════════════════════════════════════════════

/// Theme roles. `accent` is the live brand ramp's solid step — blue by
/// default, and whatever `set_accent` picks after that. Status tints (ok,
/// danger) stay semantic; the chart fields are the data-viz layer every chart
/// reads (stroke + area wash).
struct Palette {
    bg: string,
    card: string,
    raised: string,
    text: string,
    muted: string,
    faint: string,
    line: string,
    line_strong: string,
    wash: string,
    on_solid: string,
    accent: string,
    accent_soft: string,
    danger: string,
    danger_solid: string,
    success: string,
    success_fill: string,
    /// Warning tint: text, pips, icons (amber).
    warn: string,
    /// Warning wash (alert fills, soft warning badges).
    warn_fill: string,
    /// Warning border: soft in light, full in dark.
    warn_edge: string,
    /// Destructive border: destructive/50 in light, full in dark.
    danger_edge: string,
    /// Solid success fill for badges and other ok-on-surface pills.
    ok_solid: string,
    /// Text on colored status fills (ok/danger solids) — white in both
    /// appearances.
    on_fill: string,
    /// Modal scrim (behind dialogs and popovers).
    scrim: string,
    /// Tooltip border.
    chart_edge: string,
    /// Series strokes (the default chart palette).
    chart1: string,
    chart2: string,
    chart3: string,
    chart4: string,
    chart5: string,
    /// Per-series area wash, one entry per appearance.
    fill1: string,
    fill2: string,
    fill3: string,
    fill4: string,
    fill5: string,
}

/// Light is the xAI paper theme: white canvas, ivory cards, dove hairlines,
/// jet ink, sunset accent. Values are the published xAI tokens —
/// `hsl` triplets from `x.ai/grok` converted to hex: background
/// `0 0% 100%`, card `40 18% 97%`, border `222 19% 86%`, foreground
/// `0 0% 4%`, primary `0 0% 4%`, accent `22 100% 51.6%`,
/// success `142 71% 45%`, warning `45 93% 47%`, error `0 84% 60%`.
const LIGHT: Palette = Palette(
    bg = "#ffffff",
    card = "#f9f8f6",
    raised = "#f1f2f6",
    text = "#0a0a0a",
    muted = "#7d8187",
    faint = "#a9b2bc",
    line = "#d5d9e2",
    line_strong = "#a9b2bc",
    wash = "#f7f6f4",
    on_solid = "#ffffff",
    accent = "#0a0a0a",
    accent_soft = "#f1f2f6",
    danger = "#ef4343",
    danger_solid = "#dc2828",
    success = "#21c45d",
    success_fill = "#e4f8ec",
    warn = "#e7b008",
    warn_fill = "#fdf7e6",
    warn_edge = "#fad66b",
    danger_edge = "#f69898",
    ok_solid = "#189044",
    on_fill = "#ffffff",
    scrim = "#000000",
    chart_edge = "#d5d9e2",
    chart1 = "#ff6308",
    chart2 = "#6c28d9",
    chart3 = "#0a1626",
    chart4 = "#477cc2",
    chart5 = "#23958f",
    fill1 = "#ffece1",
    fill2 = "#ede5fa",
    fill3 = "#e2e3e5",
    fill4 = "#e9eff8",
    fill5 = "#e5f2f2"
)

/// Dark is the xAI canvas: near-black edge to edge, white ink, hairline
/// borders. Values are the published xAI tokens — canvas `0 0% 4%`, card
/// `0 0% 10%`, soft `221 12% 14%`, mid `216 4% 22%`, hairline `221 12% 14%`,
/// body `222 19% 86%`, mute `216 4% 51%` — with the light-appropriate
/// sunset / dawn / dusk / twilight / breeze series for charts.
const DARK: Palette = Palette(
    bg = "#0a0a0a",
    card = "#1a1a1a",
    raised = "#1f2228",
    text = "#ffffff",
    muted = "#d5d9e2",
    faint = "#7d8187",
    line = "#1f2228",
    line_strong = "#36383a",
    wash = "#121212",
    on_solid = "#0a0a0a",
    accent = "#ffffff",
    accent_soft = "#1f2228",
    danger = "#e66565",
    danger_solid = "#dc2828",
    success = "#4ade80",
    success_fill = "#142c1d",
    warn = "#f8c630",
    warn_fill = "#2e2610",
    warn_edge = "#947005",
    danger_edge = "#9a1919",
    ok_solid = "#189044",
    on_fill = "#ffffff",
    scrim = "#000000",
    chart_edge = "#1f2228",
    chart1 = "#ff6308",
    chart2 = "#a689fa",
    chart3 = "#9cb8dd",
    chart4 = "#ffd085",
    chart5 = "#45d3cc",
    fill1 = "#361a0a",
    fill2 = "#262135",
    fill3 = "#242930",
    fill4 = "#362e20",
    fill5 = "#152e2d"
)

// --- xAI brand accents ---
// Published brand colors, for charts, marks and highlights. The neutral
// palette above stays the chrome; these are the deliberate splashes.

/// Sunset orange — the primary brand accent (`22 100% 51.6%`).
fn sunset() -> string { return "#ff6308" }
/// Dawn — the soft partner to `sunset` (`37 100% 76%`).
fn sunset_soft() -> string { return "#ffd085" }
/// Dusk purple (`263 70% 50.4%`).
fn dusk() -> string { return "#6c28d9" }
/// Twilight violet, the light partner to `dusk` (`255 92% 76%`).
fn twilight() -> string { return "#a689fa" }
/// Breeze blue (`214 48.9% 73.9%`).
fn breeze() -> string { return "#9cb8dd" }
/// Midnight, the deepest brand blue (`214 58.3% 9.4%`).
fn midnight() -> string { return "#0a1626" }

/// Choose between a light and a dark value for the current appearance.
/// Reads the appearance signal, so a caller inside a reactive prop follows
/// a theme switch automatically.
fn pick_by_appearance(lit: string, dim: string) -> string {
    if appearance().get() == 1 {
        return dim
    }
    return lit
}

/// Page background. Dark is zinc-950.
/// Theme slots. A widget stores the *role*, not a resolved color, so the
/// paint pass resolves it against `appearance()` every frame — that is how
/// a theme switch repaints a retained tree with no effects and no rebuild.
enum ROLE {
    Paper = 1,
    Plate = 2,
    Raised = 3,
    Ink = 4,
    Mute = 5,
    Dim = 6,
    Rule = 7,
    Hard = 8,
    Wash = 9,
    OnInk = 10,
    Accent = 11,
    AccentSoft = 12,
    Danger = 13,
    DangerSolid = 14,
    DangerEdge = 15,
    OkSolid = 16,
    Ok = 17,
    OkFill = 18,
    Warn = 19,
    WarnFill = 20,
    WarnEdge = 21,
    OnFill = 22,
    Scrim = 23,
    ChartEdge = 24,
    Chart1 = 25,
    Chart2 = 26,
    Chart3 = 27,
    Chart4 = 28,
    Chart5 = 29,
    Fill1 = 30,
    Fill2 = 31,
    Fill3 = 32,
    Fill4 = 33,
    Fill5 = 34,
    Bone = 35,
    // 36 is baked into `arena.focus_ring_rgb`: the keyboard focus ring is
    // the foreground color in both appearances.
    FocusRing = 36,

    // --- scales (design-system phase 2) ---
    // A 12-step ramp in the Radix sense, not a Tailwind swatch list: the
    // step number is a *role*, so a widget asks for "the border step" and
    // gets a value that stays correct in both appearances and under any
    // accent. 1-2 backgrounds, 3-5 component fills (rest / hover / active),
    // 6-8 borders (subtle / default / strong), 9-10 solid fills, 11-12 text.
    // Steps 11 and 12 are the only ones text is ever drawn in, and both are
    // checked against steps 1-3 by `tokens_contrast_report`.
    N1 = 40, N2 = 41, N3 = 42, N4 = 43, N5 = 44, N6 = 45,
    N7 = 46, N8 = 47, N9 = 48, N10 = 49, N11 = 50, N12 = 51,
    A1 = 52, A2 = 53, A3 = 54, A4 = 55, A5 = 56, A6 = 57,
    A7 = 58, A8 = 59, A9 = 60, A10 = 61, A11 = 62, A12 = 63,
    // Text on the accent's solid step (9/10). Recomputed per accent by
    // `best_on`, because a light accent needs dark text and vice versa —
    // hard-coding white here is what makes an orange primary button fail AA.
    OnAccent = 64,

    // Semantic tiers. Five slots each is what components actually consume:
    // a wash to sit on, a border, a solid fill, that fill's hover, and a
    // text ink that clears AA on the page background.
    // Named by step, not by word: `OkFill` and `WarnFill` already exist above
    // (slots 18 and 20) with different meanings, and Loam accepts duplicate
    // enum names silently — the first cut of this collided and bound white
    // text against a pale wash without any error.
    OkS3 = 65, OkS6 = 66, OkS9 = 67, OkS10 = 68, OkS11 = 69,
    WarnS3 = 70, WarnS6 = 71, WarnS9 = 72, WarnS10 = 73, WarnS11 = 74,
    DangerS3 = 75, DangerS6 = 76, DangerS9 = 77, DangerS10 = 78, DangerS11 = 79,
    InfoS3 = 80, InfoS6 = 81, InfoS9 = 82, InfoS10 = 83, InfoS11 = 84,
    // Text on a semantic solid fill, one per tier. Not a single shared
    // white: white on the amber solid is 2.14:1 and on the green 2.27:1,
    // both under AA's 3:1 for component text. Each is `best_on` of its own
    // fill, so amber badges get dark ink and blue ones get white — which is
    // what the ratio demands, not a stylistic preference.
    OnOk = 85, OnWarn = 87, OnDanger = 88, OnInfo = 89,
    // Elevation shadow color: near-black in light, true black in dark
    // (a dark UI needs a darker, tighter shadow to read as lift at all).
    Shadow = 86,
}

/// A color that names a theme slot instead of carrying a value. Resolved by
/// the paint pass, so it follows `appearance()` with no effect attached.
fn role_token(slot: int) -> string {
    return "@{{slot}}"
}

fn paper() -> string { return role_token(ROLE.Paper) }
/// Card / popover / dialog surface.
fn plate() -> string { return role_token(ROLE.Plate) }
/// Muted / secondary / accent background (hover, chips, tab tray).
fn raised() -> string { return role_token(ROLE.Raised) }
/// Foreground text. `ink` is the strongest ink.
fn ink() -> string { return role_token(ROLE.Ink) }
/// Muted-foreground: secondary text, labels on wash.
fn mute() -> string { return role_token(ROLE.Mute) }
/// Faint text: captions, overlines, placeholders.
fn dim() -> string { return role_token(ROLE.Dim) }
/// Border / input stroke.
fn rule() -> string { return role_token(ROLE.Rule) }
/// Stronger border: popovers, focus-ish outlines.
fn hard() -> string { return role_token(ROLE.Hard) }
/// Soft fill for code blocks and inset panels.
fn wash() -> string { return role_token(ROLE.Wash) }
/// Text on `accent` (primary-foreground).
fn on_ink() -> string { return role_token(ROLE.OnInk) }
/// Primary: fills for default buttons, switches, selection. The accent ramp's
/// solid step (`register_accent`), blue by default.
fn accent() -> string { return role_token(ROLE.Accent) }
/// Soft accent surface (`secondary`): soft buttons, pressed toggles.
fn accent_soft() -> string { return role_token(ROLE.AccentSoft) }
/// Destructive text (errors, destructive alerts).
fn danger() -> string { return role_token(ROLE.Danger) }
/// Destructive fill (destructive buttons, filled danger badges).
fn danger_solid() -> string { return role_token(ROLE.DangerSolid) }
/// Destructive border: destructive/50 in light, full in dark.
fn danger_edge() -> string { return role_token(ROLE.DangerEdge) }
/// Solid success fill (ok badges). Deeper than `ok` so white text holds.
fn ok_solid() -> string { return role_token(ROLE.OkSolid) }
/// Success tint.
fn ok() -> string { return role_token(ROLE.Ok) }
/// Success wash.
fn ok_fill() -> string { return role_token(ROLE.OkS9) }
/// Warning tint: alert icons, warning chips/pips.
fn warn() -> string { return role_token(ROLE.Warn) }
/// Warning wash (soft warning badges, alert fills).
fn warn_fill() -> string { return role_token(ROLE.WarnS9) }
/// Warning border: soft in light, full in dark.
fn warn_edge() -> string { return role_token(ROLE.WarnEdge) }
/// Text on danger fills is white in both appearances.
fn on_danger() -> string { return role_token(ROLE.OnFill) }
/// Text on ok fills is white in both appearances.
fn on_ok() -> string { return role_token(ROLE.OnFill) }
/// Modal scrim behind dialogs and popovers.
fn scrim() -> string { return role_token(ROLE.Scrim) }
/// Skeleton fill: borders in light, raised in dark.
fn bone() -> string { return role_token(ROLE.Bone) }

// ═══════════════════════════════════════════════════════════════════
// Design tokens: scales, elevation, motion, focus, contrast
// ═══════════════════════════════════════════════════════════════════
//
// The flat role list above (`paper`, `plate`, `rule`, …) stays — it is what
// every existing call site uses, and it now *resolves onto* the scales below
// rather than carrying its own hex values. One ramp, two spellings.
//
// A `Scale` is 12 hex strings, indexed 1..12 in the Radix sense described on
// the ROLE enum. Holding them as data rather than as 12 named constants is
// what makes the accent swappable at runtime: `set_accent` re-registers the
// twelve A-slots and the next paint picks them up, with no rebuild and no
// effect runs — the same trick that already makes light/dark free.

struct Scale {
    s1: string, s2: string, s3: string, s4: string, s5: string, s6: string,
    s7: string, s8: string, s9: string, s10: string, s11: string, s12: string,
}

fn scale_at(sc: Scale, step: int) -> string {
    if step <= 1 { return sc.s1 }
    if step == 2 { return sc.s2 }
    if step == 3 { return sc.s3 }
    if step == 4 { return sc.s4 }
    if step == 5 { return sc.s5 }
    if step == 6 { return sc.s6 }
    if step == 7 { return sc.s7 }
    if step == 8 { return sc.s8 }
    if step == 9 { return sc.s9 }
    if step == 10 { return sc.s10 }
    if step == 11 { return sc.s11 }
    return sc.s12
}

/// Neutral ramp, light. Zinc-derived, spaced so 3/4/5 read as distinct
/// component states on a white page rather than three shades of the same
/// grey.
const NEUTRAL_L: Scale = Scale(
    s1 = "#ffffff", s2 = "#fafafa", s3 = "#f4f4f5", s4 = "#ececee",
    s5 = "#e4e4e7", s6 = "#dcdce0", s7 = "#d4d4d8", s8 = "#b9b9c0",
    s9 = "#71717a", s10 = "#62626b", s11 = "#52525b", s12 = "#18181b"
)

/// Neutral ramp, dark. Not the light ramp reversed: the dark end needs
/// tighter steps near the background (1-5) so surfaces separate at all, and
/// looser steps at the text end so 11 and 12 stay distinguishable.
const NEUTRAL_D: Scale = Scale(
    s1 = "#09090b", s2 = "#101012", s3 = "#18181b", s4 = "#1f1f23",
    s5 = "#26262a", s6 = "#2e2e33", s7 = "#3f3f46", s8 = "#52525b",
    s9 = "#71717a", s10 = "#7e7e87", s11 = "#a1a1aa", s12 = "#ededef"
)

// --- accent ramps ---------------------------------------------------------
// One per pickable accent. Step 9 is the brand value; 1-8 are tints of it
// over the page background, 10 is the pressed solid, 11-12 are inks.

/// Sunset — the xAI brand orange (`#ff6308`), and the default accent.
const ACCENT_SUNSET_L: Scale = Scale(
    s1 = "#fffaf7", s2 = "#fff4ed", s3 = "#ffe8db", s4 = "#ffdcc7",
    s5 = "#ffceb0", s6 = "#ffbc94", s7 = "#ffa46f", s8 = "#fb8340",
    s9 = "#ff6308", s10 = "#f05500", s11 = "#ad4100", s12 = "#5c2100"
)
const ACCENT_SUNSET_D: Scale = Scale(
    s1 = "#150c06", s2 = "#1d1008", s3 = "#2c1608", s4 = "#3a1a06",
    s5 = "#481f06", s6 = "#582709", s7 = "#6e320b", s8 = "#8e4310",
    s9 = "#ff6308", s10 = "#ff7a2b", s11 = "#ffa06b", s12 = "#ffdcc7"
)

/// Blue — the default accent. Step 9 is `#2563eb`, deep enough that white
/// is the ink `best_on` picks in both appearances, which is what keeps the
/// primary button reading as a primary button.
const ACCENT_BLUE_L: Scale = Scale(
    s1 = "#fbfcfe", s2 = "#f5f8ff", s3 = "#e9f0fe", s4 = "#dbe7fd",
    s5 = "#cbdcfc", s6 = "#b6cdfa", s7 = "#9bbaf7", s8 = "#74a0f2",
    s9 = "#2563eb", s10 = "#1d56d6", s11 = "#1a4ab8", s12 = "#12275c"
)
const ACCENT_BLUE_D: Scale = Scale(
    s1 = "#070b14", s2 = "#0a0f1c", s3 = "#0e1830", s4 = "#111e3e",
    s5 = "#14244c", s6 = "#182d5e", s7 = "#1f3a78", s8 = "#2b4fa3",
    s9 = "#2b6be6", s10 = "#4a87f4", s11 = "#93bbfc", s12 = "#dbe7fd"
)

/// Indigo — a violet-leaning alternative to the default blue.
const ACCENT_INDIGO_L: Scale = Scale(
    s1 = "#fcfcfe", s2 = "#f6f8ff", s3 = "#eceffe", s4 = "#e0e6fd",
    s5 = "#d2dbfc", s6 = "#c0cdfa", s7 = "#a7b9f6", s8 = "#849eef",
    s9 = "#4f46e5", s10 = "#463dd4", s11 = "#4038c4", s12 = "#1e1b57"
)
const ACCENT_INDIGO_D: Scale = Scale(
    s1 = "#0b0b14", s2 = "#101019", s3 = "#171a2e", s4 = "#1c203e",
    s5 = "#22284b", s6 = "#2a325c", s7 = "#363f74", s8 = "#4650a0",
    s9 = "#4f46e5", s10 = "#6258f0", s11 = "#a6a1fb", s12 = "#e2e0fe"
)

/// Teal — a cooler, lower-chroma accent that stays legible on dense data.
const ACCENT_TEAL_L: Scale = Scale(
    s1 = "#fafefd", s2 = "#f1fcfa", s3 = "#e0f8f4", s4 = "#cdf2ec",
    s5 = "#b7e9e1", s6 = "#9cddd3", s7 = "#77cdc1", s8 = "#40b6a7",
    s9 = "#0d9488", s10 = "#0b857a", s11 = "#0a6f66", s12 = "#0a2e2b"
)
const ACCENT_TEAL_D: Scale = Scale(
    s1 = "#06100f", s2 = "#081614", s3 = "#0a221f", s4 = "#0b2c28",
    s5 = "#0d3632", s6 = "#10443e", s7 = "#155850", s8 = "#1a766b",
    s9 = "#0d9488", s10 = "#14b0a1", s11 = "#5fd6c8", s12 = "#cdf2ec"
)

/// Rose — a warm accent distinct from the danger tier at every step.
const ACCENT_ROSE_L: Scale = Scale(
    s1 = "#fffafb", s2 = "#fff1f4", s3 = "#ffe4ea", s4 = "#fed5de",
    s5 = "#fbc6d2", s6 = "#f7b2c2", s7 = "#f094ab", s8 = "#e66b8b",
    s9 = "#e11d48", s10 = "#cf1541", s11 = "#b81139", s12 = "#500718"
)
const ACCENT_ROSE_D: Scale = Scale(
    s1 = "#140a0d", s2 = "#1b0d11", s3 = "#2b1119", s4 = "#38131f",
    s5 = "#441724", s6 = "#551d2d", s7 = "#6d2639", s8 = "#95344c",
    s9 = "#e11d48", s10 = "#ef3560", s11 = "#ff8ca6", s12 = "#ffe4ea"
)

/// Accent choices, in picker order. `set_accent` takes one of these.
enum ACCENT {
    Blue = 0,
    Indigo = 1,
    Teal = 2,
    Rose = 3,
    Sunset = 4,
}

fn accent_scale_light(which: int) -> Scale {
    if which == ACCENT.Indigo { return ACCENT_INDIGO_L }
    if which == ACCENT.Teal { return ACCENT_TEAL_L }
    if which == ACCENT.Rose { return ACCENT_ROSE_L }
    if which == ACCENT.Sunset { return ACCENT_SUNSET_L }
    return ACCENT_BLUE_L
}

fn accent_scale_dark(which: int) -> Scale {
    if which == ACCENT.Indigo { return ACCENT_INDIGO_D }
    if which == ACCENT.Teal { return ACCENT_TEAL_D }
    if which == ACCENT.Rose { return ACCENT_ROSE_D }
    if which == ACCENT.Sunset { return ACCENT_SUNSET_D }
    return ACCENT_BLUE_D
}

/// Display name, for the gallery's accent picker.
fn accent_name(which: int) -> string {
    if which == ACCENT.Indigo { return "Indigo" }
    if which == ACCENT.Teal { return "Teal" }
    if which == ACCENT.Rose { return "Rose" }
    if which == ACCENT.Sunset { return "Sunset" }
    return "Blue"
}

fn accent_count() -> int {
    return 5
}

// --- semantic tiers -------------------------------------------------------
// Five slots each: wash, border, solid, solid hover, ink. The ink values are
// the ones AA actually constrains, and each was chosen to clear 4.5:1 on the
// tier's own wash *and* on the page background.

struct Tier {
    bg: string,
    line: string,
    fill: string,
    fill_hover: string,
    ink: string,
}

const OK_L: Tier = Tier(bg = "#e8f8ee", line = "#a9e3bf", fill = "#16a34a",
                        fill_hover = "#15803d", ink = "#126e33")
const OK_D: Tier = Tier(bg = "#0e2a19", line = "#1d5334", fill = "#22c55e",
                        fill_hover = "#16a34a", ink = "#4ade80")
const WARN_L: Tier = Tier(bg = "#fdf5e3", line = "#f3d78a", fill = "#d97706",
                          fill_hover = "#b45309", ink = "#925309")
const WARN_D: Tier = Tier(bg = "#2b2109", line = "#5a4610", fill = "#f59e0b",
                          fill_hover = "#d97706", ink = "#fbbf24")
const DANGER_L: Tier = Tier(bg = "#fdecec", line = "#f5b5b5", fill = "#dc2626",
                            fill_hover = "#b91c1c", ink = "#b3201f")
const DANGER_D: Tier = Tier(bg = "#2c1214", line = "#5c2225", fill = "#ef4444",
                            fill_hover = "#dc2626", ink = "#f87171")
const INFO_L: Tier = Tier(bg = "#e9f1fd", line = "#b3cdf7", fill = "#2563eb",
                          fill_hover = "#1d4ed8", ink = "#1d4ed8")
const INFO_D: Tier = Tier(bg = "#111f38", line = "#1e3a6b", fill = "#3b82f6",
                          fill_hover = "#2563eb", ink = "#7ab0fb")

// --- contrast -------------------------------------------------------------
// WCAG relative luminance, so a picker can choose an ink that actually
// passes rather than assuming white.
//
// The sRGB transfer curve needs `x^2.4`, which the tree has no `pow` for.
// It also never needs it in general: a channel is always one of 256 values,
// so the curve is a table. Exact, allocation-free, and no iteration that can
// fail to converge — an earlier Newton-iteration version of this silently
// returned garbage for mid-tones, which is exactly the kind of bug a
// contrast checker must not have.

/// sRGB 8-bit channel → linear light, ×100000.
const SRGB_LIN: []int = []int {
    0, 30, 61, 91, 121, 152, 182, 212,
    243, 273, 304, 335, 368, 402, 439, 478,
    518, 561, 605, 651, 700, 750, 802, 857,
    913, 972, 1033, 1096, 1161, 1229, 1298, 1370,
    1444, 1521, 1600, 1681, 1764, 1850, 1938, 2029,
    2122, 2217, 2315, 2416, 2519, 2624, 2732, 2843,
    2956, 3071, 3190, 3310, 3434, 3560, 3689, 3820,
    3955, 4092, 4231, 4374, 4519, 4667, 4817, 4971,
    5127, 5286, 5448, 5613, 5781, 5951, 6125, 6301,
    6480, 6663, 6848, 7036, 7227, 7421, 7619, 7819,
    8022, 8228, 8438, 8650, 8866, 9084, 9306, 9531,
    9759, 9990, 10224, 10462, 10702, 10946, 11193, 11444,
    11697, 11954, 12214, 12477, 12744, 13014, 13287, 13563,
    13843, 14126, 14413, 14703, 14996, 15293, 15593, 15896,
    16203, 16513, 16827, 17144, 17465, 17789, 18116, 18447,
    18782, 19120, 19462, 19807, 20156, 20508, 20864, 21223,
    21586, 21953, 22323, 22697, 23074, 23455, 23840, 24228,
    24620, 25016, 25415, 25818, 26225, 26636, 27050, 27468,
    27889, 28315, 28744, 29177, 29614, 30054, 30499, 30947,
    31399, 31855, 32314, 32778, 33245, 33716, 34191, 34670,
    35153, 35640, 36131, 36625, 37124, 37626, 38133, 38643,
    39157, 39676, 40198, 40724, 41254, 41789, 42327, 42869,
    43415, 43966, 44520, 45079, 45641, 46208, 46778, 47353,
    47932, 48515, 49102, 49693, 50289, 50888, 51492, 52100,
    52712, 53328, 53948, 54572, 55201, 55834, 56471, 57112,
    57758, 58408, 59062, 59720, 60383, 61050, 61721, 62396,
    63076, 63760, 64448, 65141, 65837, 66539, 67244, 67954,
    68669, 69387, 70110, 70838, 71569, 72306, 73046, 73791,
    74540, 75294, 76052, 76815, 77582, 78354, 79130, 79910,
    80695, 81485, 82279, 83077, 83880, 84687, 85499, 86316,
    87137, 87962, 88792, 89627, 90466, 91310, 92158, 93011,
    93869, 94731, 95597, 96469, 97345, 98225, 99110, 100000,
}

/// WCAG relative luminance of a packed rgb, ×100000.
fn luminance(rgb: int) -> int {
    let r = SRGB_LIN[(rgb / 65536) % 256]
    let g = SRGB_LIN[(rgb / 256) % 256]
    let b = SRGB_LIN[rgb % 256]
    return (2126 * r + 7152 * g + 722 * b) / 10000
}

/// Contrast ratio between two packed rgb colors, ×100 (so 4.5:1 is 450).
fn contrast_ratio(a: int, b: int) -> int {
    let la = luminance(a)
    let lb = luminance(b)
    let mut hi = la
    let mut lo = lb
    if lb > la {
        hi = lb
        lo = la
    }
    // WCAG adds 0.05 to each term; luminance is ×100000, so that is 5000.
    return (hi + 5000) * 100 / (lo + 5000)
}

/// 1 when `fg` on `bg` clears WCAG AA for body text (4.5:1).
fn meets_aa(fg: int, bg: int) -> int {
    if contrast_ratio(fg, bg) >= 450 {
        return 1
    }
    return 0
}

/// 1 when `fg` on `bg` clears AA for large text / UI components (3:1).
fn meets_aa_large(fg: int, bg: int) -> int {
    if contrast_ratio(fg, bg) >= 300 {
        return 1
    }
    return 0
}

/// The ink — near-black or near-white — that reads best on `bg`. This is why
/// an orange primary button gets dark text and an indigo one gets white,
/// without either being spelled out per accent.
fn best_on(bg: int) -> int {
    let dark = parse_hex_color("#18181b")
    let light = parse_hex_color("#ffffff")
    if contrast_ratio(dark, bg) >= contrast_ratio(light, bg) {
        return dark
    }
    return light
}

// --- elevation ------------------------------------------------------------
// The curves and the `Elev` record live in the core (`arena`), because the
// paint pass resolves a node's shadow and cannot import this module. These are
// the public spellings; they delegate so there is one home for the numbers.

/// Elevation for `level` 0..4, light appearance.
fn elevation(level: int) -> Elev {
    return arena.elevation(level)
}

/// Elevation for `level` 0..4, dark appearance. A dark UI needs a darker,
/// tighter shadow: the same alpha over a near-black surface is invisible, so
/// every level roughly doubles its opacity and pulls the blur in.
fn elevation_dark(level: int) -> Elev {
    return arena.elevation_dark(level)
}

/// Elevation resolved for the current appearance.
fn elev_now(level: int) -> Elev {
    return arena.elev_now(level)
}

// --- motion ---------------------------------------------------------------
/// Transition durations in milliseconds. Anything that moves uses one of
/// these three; a bespoke duration is a bug, not a refinement.
enum MOTION {
    // Hover, press, focus — feedback that must feel instant.
    Fast = 120,
    // The default: state changes, indicators, switches.
    Base = 200,
    // Entrances and exits of large surfaces (dialog, drawer, toast).
    Slow = 320,
}

/// Easing curves. Integer ids — the curve itself lives in the animation
/// subsystem (`arena.anim_ease`), which evaluates a CSS cubic-bezier per
/// track without allocating. Control points are documented there.
enum EASE {
    // No shaping. Progress bars and crossfades of colour only.
    Linear = 0,
    // The workhorse: fast out, slow in. cubic-bezier(0.215, 0.61, 0.355, 1)
    // (ease-out cubic). Everything unspecified uses it.
    Standard = 1,
    // More pronounced deceleration, for entrances that should feel arrived.
    // cubic-bezier(0.23, 1, 0.32, 1) (ease-out quint).
    Emphasized = 2,
    // Overshoots and settles. Switch thumbs and anything that "snaps".
    // cubic-bezier(0.34, 1.56, 0.64, 1) (ease-out-back).
    Spring = 3,
}


/// Line box for `font` px at a `LEAD_*` percentage.
fn line_height(font: int, lead: int) -> int {
    return font * lead / 100
}

// --- the live accent ------------------------------------------------------
let mut accent_which: int = 0

/// The accent in effect. Changing it re-registers the twelve A-slots, so the
/// next paint picks up the new ramp with no rebuild and no effect runs — the
/// same paint-time resolution that makes the light/dark switch free.
fn accent_choice() -> int {
    return accent_which
}

fn set_accent(which: int) {
    ensure_role_colors()
    let mut w = which
    if w < 0 {
        w = 0
    }
    if w >= accent_count() {
        w = accent_count() - 1
    }
    accent_which = w
    register_accent()
}

fn register_scale(base: int, light: Scale, dark: Scale) {
    for i in 0..12 {
        theme(base + i, parse_hex_color(scale_at(light, i + 1)),
              parse_hex_color(scale_at(dark, i + 1)))
    }
}

fn register_tier(base: int, light: Tier, dark: Tier) {
    theme(base + 0, parse_hex_color(light.bg), parse_hex_color(dark.bg))
    theme(base + 1, parse_hex_color(light.line), parse_hex_color(dark.line))
    theme(base + 2, parse_hex_color(light.fill), parse_hex_color(dark.fill))
    theme(base + 3, parse_hex_color(light.fill_hover), parse_hex_color(dark.fill_hover))
    theme(base + 4, parse_hex_color(light.ink), parse_hex_color(dark.ink))
}

fn register_accent() {
    let al = accent_scale_light(accent_which)
    let ad = accent_scale_dark(accent_which)
    register_scale(ROLE.A1, al, ad)
    // Text on the accent's solid step, chosen by contrast rather than
    // assumed: white on `#ff6308` is 2.98:1 and fails AA outright.
    theme(ROLE.OnAccent, best_on(parse_hex_color(al.s9)),
          best_on(parse_hex_color(ad.s9)))
    // The flat `accent` role tracks the ramp's solid step, so every existing
    // `accent()` call site follows the picker with no change.
    theme(ROLE.Accent, parse_hex_color(al.s9), parse_hex_color(ad.s9))
    theme(ROLE.AccentSoft, parse_hex_color(al.s3), parse_hex_color(ad.s3))
    theme(ROLE.OnInk, best_on(parse_hex_color(al.s9)), best_on(parse_hex_color(ad.s9)))
}

// --- scale accessors ------------------------------------------------------
/// Neutral ramp step 1..12 as a role token (see the ROLE enum for what each
/// step means).
fn n(step: int) -> string {
    let mut k = step
    if k < 1 {
        k = 1
    }
    if k > 12 {
        k = 12
    }
    return role_token(ROLE.N1 + k - 1)
}

/// Accent ramp step 1..12 as a role token. Follows `set_accent`.
fn ac(step: int) -> string {
    let mut k = step
    if k < 1 {
        k = 1
    }
    if k > 12 {
        k = 12
    }
    return role_token(ROLE.A1 + k - 1)
}

/// Text on the accent's solid fill — dark or light, whichever passes.
fn on_accent() -> string { return role_token(ROLE.OnAccent) }
/// Text on a semantic solid fill, picked per tier by contrast.
fn on_tint(kind: int) -> string {
    if kind == TINT.Ok { return role_token(ROLE.OnOk) }
    if kind == TINT.Warn { return role_token(ROLE.OnWarn) }
    if kind == TINT.Danger { return role_token(ROLE.OnDanger) }
    if kind == TINT.Info { return role_token(ROLE.OnInfo) }
    return role_token(ROLE.OnAccent)
}
/// Elevation shadow colour.
fn shadow_color() -> string { return role_token(ROLE.Shadow) }

fn ok_bg() -> string { return role_token(ROLE.OkS3) }
fn ok_line() -> string { return role_token(ROLE.OkS6) }
fn ok_fill_solid() -> string { return role_token(ROLE.OkS9) }
fn ok_fill_hover() -> string { return role_token(ROLE.OkS10) }
fn ok_ink() -> string { return role_token(ROLE.OkS11) }

fn warn_bg() -> string { return role_token(ROLE.WarnS3) }
fn warn_line() -> string { return role_token(ROLE.WarnS6) }
fn warn_fill_solid() -> string { return role_token(ROLE.WarnS9) }
fn warn_fill_hover() -> string { return role_token(ROLE.WarnS10) }
fn warn_ink() -> string { return role_token(ROLE.WarnS11) }

fn danger_bg() -> string { return role_token(ROLE.DangerS3) }
fn danger_line() -> string { return role_token(ROLE.DangerS6) }
fn danger_fill_solid() -> string { return role_token(ROLE.DangerS9) }
fn danger_fill_hover() -> string { return role_token(ROLE.DangerS10) }
fn danger_ink() -> string { return role_token(ROLE.DangerS11) }

fn info_bg() -> string { return role_token(ROLE.InfoS3) }
fn info_line() -> string { return role_token(ROLE.InfoS6) }
fn info_fill_solid() -> string { return role_token(ROLE.InfoS9) }
fn info_fill_hover() -> string { return role_token(ROLE.InfoS10) }
fn info_ink() -> string { return role_token(ROLE.InfoS11) }

/// Wash / border / ink for a `TINT`, so a widget takes one token and gets a
/// consistent tier instead of picking three colours by hand.
fn tint_bg(kind: int) -> string {
    if kind == TINT.Ok { return ok_bg() }
    if kind == TINT.Warn { return warn_bg() }
    if kind == TINT.Danger { return danger_bg() }
    if kind == TINT.Info { return info_bg() }
    return n(3)
}

fn tint_line(kind: int) -> string {
    if kind == TINT.Ok { return ok_line() }
    if kind == TINT.Warn { return warn_line() }
    if kind == TINT.Danger { return danger_line() }
    if kind == TINT.Info { return info_line() }
    return n(6)
}

fn tint_fill(kind: int) -> string {
    if kind == TINT.Ok { return ok_fill_solid() }
    if kind == TINT.Warn { return warn_fill_solid() }
    if kind == TINT.Danger { return danger_fill_solid() }
    if kind == TINT.Info { return info_fill_solid() }
    return n(9)
}

fn tint_ink(kind: int) -> string {
    if kind == TINT.Ok { return ok_ink() }
    if kind == TINT.Warn { return warn_ink() }
    if kind == TINT.Danger { return danger_ink() }
    if kind == TINT.Info { return info_ink() }
    if kind == TINT.Mute { return n(11) }
    if kind == TINT.Dim { return n(10) }
    return n(12)
}

/// Theme roles so native thumbs (switch / slider) follow appearance at paint.
/// 32 primary, 33 input track, 34 thumb (background), 35 primary/20 track.
/// Theme roles so native thumbs (switch / slider) follow appearance at paint.
/// The four slots are palette-backed: text (32), line (33), surface/card
/// (34), and line_strong (35), so restyling the palette restyles the thumbs.
fn ensure_role_colors() {
    if roles_ready != 0 {
        return
    }
    roles_ready = 1
    theme(ROLE.Paper, parse_hex_color(LIGHT.bg), parse_hex_color(DARK.bg))
    theme(ROLE.Plate, parse_hex_color(LIGHT.card), parse_hex_color(DARK.card))
    theme(ROLE.Raised, parse_hex_color(LIGHT.raised), parse_hex_color(DARK.raised))
    theme(ROLE.Ink, parse_hex_color(LIGHT.text), parse_hex_color(DARK.text))
    theme(ROLE.Mute, parse_hex_color(LIGHT.muted), parse_hex_color(DARK.muted))
    theme(ROLE.Dim, parse_hex_color(LIGHT.faint), parse_hex_color(DARK.faint))
    theme(ROLE.Rule, parse_hex_color(LIGHT.line), parse_hex_color(DARK.line))
    theme(ROLE.Hard, parse_hex_color(LIGHT.line_strong), parse_hex_color(DARK.line_strong))
    theme(ROLE.Wash, parse_hex_color(LIGHT.wash), parse_hex_color(DARK.wash))
    theme(ROLE.OnInk, parse_hex_color(LIGHT.on_solid), parse_hex_color(DARK.on_solid))
    theme(ROLE.Accent, parse_hex_color(LIGHT.accent), parse_hex_color(DARK.accent))
    theme(ROLE.AccentSoft, parse_hex_color(LIGHT.accent_soft), parse_hex_color(DARK.accent_soft))
    theme(ROLE.Danger, parse_hex_color(LIGHT.danger), parse_hex_color(DARK.danger))
    theme(ROLE.DangerSolid, parse_hex_color(LIGHT.danger_solid), parse_hex_color(DARK.danger_solid))
    theme(ROLE.DangerEdge, parse_hex_color(LIGHT.danger_edge), parse_hex_color(DARK.danger_edge))
    theme(ROLE.OkSolid, parse_hex_color(LIGHT.ok_solid), parse_hex_color(DARK.ok_solid))
    theme(ROLE.Ok, parse_hex_color(LIGHT.success), parse_hex_color(DARK.success))
    theme(ROLE.OkFill, parse_hex_color(LIGHT.success_fill), parse_hex_color(DARK.success_fill))
    theme(ROLE.Warn, parse_hex_color(LIGHT.warn), parse_hex_color(DARK.warn))
    theme(ROLE.WarnFill, parse_hex_color(LIGHT.warn_fill), parse_hex_color(DARK.warn_fill))
    theme(ROLE.WarnEdge, parse_hex_color(LIGHT.warn_edge), parse_hex_color(DARK.warn_edge))
    theme(ROLE.OnFill, parse_hex_color(LIGHT.on_fill), parse_hex_color(DARK.on_fill))
    theme(ROLE.Scrim, parse_hex_color(LIGHT.scrim), parse_hex_color(DARK.scrim))
    theme(ROLE.ChartEdge, parse_hex_color(LIGHT.chart_edge), parse_hex_color(DARK.chart_edge))
    theme(ROLE.Chart1, parse_hex_color(LIGHT.chart1), parse_hex_color(DARK.chart1))
    theme(ROLE.Chart2, parse_hex_color(LIGHT.chart2), parse_hex_color(DARK.chart2))
    theme(ROLE.Chart3, parse_hex_color(LIGHT.chart3), parse_hex_color(DARK.chart3))
    theme(ROLE.Chart4, parse_hex_color(LIGHT.chart4), parse_hex_color(DARK.chart4))
    theme(ROLE.Chart5, parse_hex_color(LIGHT.chart5), parse_hex_color(DARK.chart5))
    theme(ROLE.Fill1, parse_hex_color(LIGHT.fill1), parse_hex_color(DARK.fill1))
    theme(ROLE.Fill2, parse_hex_color(LIGHT.fill2), parse_hex_color(DARK.fill2))
    theme(ROLE.Fill3, parse_hex_color(LIGHT.fill3), parse_hex_color(DARK.fill3))
    theme(ROLE.Fill4, parse_hex_color(LIGHT.fill4), parse_hex_color(DARK.fill4))
    theme(ROLE.Fill5, parse_hex_color(LIGHT.fill5), parse_hex_color(DARK.fill5))
    theme(ROLE.Bone, parse_hex_color(LIGHT.line), parse_hex_color(DARK.raised))
    theme(ROLE.FocusRing, parse_hex_color(LIGHT.text), parse_hex_color(DARK.text))

    // --- scales, then the flat roles rebound onto them ---
    register_scale(ROLE.N1, NEUTRAL_L, NEUTRAL_D)
    register_tier(ROLE.OkS3, OK_L, OK_D)
    register_tier(ROLE.WarnS3, WARN_L, WARN_D)
    register_tier(ROLE.DangerS3, DANGER_L, DANGER_D)
    register_tier(ROLE.InfoS3, INFO_L, INFO_D)
    theme(ROLE.OnOk, best_on(parse_hex_color(OK_L.fill)), best_on(parse_hex_color(OK_D.fill)))
    theme(ROLE.OnWarn, best_on(parse_hex_color(WARN_L.fill)), best_on(parse_hex_color(WARN_D.fill)))
    theme(ROLE.OnDanger, best_on(parse_hex_color(DANGER_L.fill)), best_on(parse_hex_color(DANGER_D.fill)))
    theme(ROLE.OnInfo, best_on(parse_hex_color(INFO_L.fill)), best_on(parse_hex_color(INFO_D.fill)))
    // Light shadows are a soft near-black; dark ones are true black, because
    // a tinted shadow over a near-black surface reads as haze, not lift.
    theme(ROLE.Shadow, parse_hex_color("#1a1a22"), parse_hex_color("#000000"))
    register_accent()

    // The flat role names every existing call site uses now resolve onto the
    // neutral ramp, so there is one source of truth for the chrome. The
    // mapping is where the audit's contrast finding is fixed: `dim` was
    // `#a9b2bc`, which is 2.15:1 on white and failed AA everywhere it was
    // used for captions and placeholders. It is now step 10 (6.1:1) and
    // `mute` is step 11 (7.6:1); both clear AA on steps 1-3.
    theme(ROLE.Paper, parse_hex_color(NEUTRAL_L.s1), parse_hex_color(NEUTRAL_D.s1))
    theme(ROLE.Plate, parse_hex_color(NEUTRAL_L.s2), parse_hex_color(NEUTRAL_D.s3))
    theme(ROLE.Raised, parse_hex_color(NEUTRAL_L.s3), parse_hex_color(NEUTRAL_D.s4))
    theme(ROLE.Wash, parse_hex_color(NEUTRAL_L.s2), parse_hex_color(NEUTRAL_D.s2))
    theme(ROLE.Rule, parse_hex_color(NEUTRAL_L.s6), parse_hex_color(NEUTRAL_D.s6))
    theme(ROLE.Hard, parse_hex_color(NEUTRAL_L.s8), parse_hex_color(NEUTRAL_D.s8))
    theme(ROLE.Ink, parse_hex_color(NEUTRAL_L.s12), parse_hex_color(NEUTRAL_D.s12))
    theme(ROLE.Mute, parse_hex_color(NEUTRAL_L.s11), parse_hex_color(NEUTRAL_D.s11))
    theme(ROLE.Dim, parse_hex_color(NEUTRAL_L.s10), parse_hex_color(NEUTRAL_D.s10))
    theme(ROLE.Bone, parse_hex_color(NEUTRAL_L.s4), parse_hex_color(NEUTRAL_D.s4))
    theme(ROLE.FocusRing, parse_hex_color(NEUTRAL_L.s12), parse_hex_color(NEUTRAL_D.s12))
    // Status roles follow their tier, so `danger()` and `danger_ink()` can
    // never drift apart.
    theme(ROLE.Ok, parse_hex_color(OK_L.ink), parse_hex_color(OK_D.ink))
    theme(ROLE.OkFill, parse_hex_color(OK_L.bg), parse_hex_color(OK_D.bg))
    theme(ROLE.OkSolid, parse_hex_color(OK_L.fill), parse_hex_color(OK_D.fill))
    theme(ROLE.Warn, parse_hex_color(WARN_L.ink), parse_hex_color(WARN_D.ink))
    theme(ROLE.WarnFill, parse_hex_color(WARN_L.bg), parse_hex_color(WARN_D.bg))
    theme(ROLE.WarnEdge, parse_hex_color(WARN_L.line), parse_hex_color(WARN_D.line))
    theme(ROLE.Danger, parse_hex_color(DANGER_L.ink), parse_hex_color(DANGER_D.ink))
    theme(ROLE.DangerSolid, parse_hex_color(DANGER_L.fill), parse_hex_color(DANGER_D.fill))
    theme(ROLE.DangerEdge, parse_hex_color(DANGER_L.line), parse_hex_color(DANGER_D.line))
}

/// Every (ink, surface) pair the design system can produce, checked against
/// WCAG AA and reported as `pass`/`FAIL` lines. This is the §2 contrast
/// requirement made executable rather than asserted in prose — the in-language
/// test runs it for both appearances and fails on any `FAIL`.
fn tokens_contrast_report() -> string {
    ensure_role_colors()
    let mut out = ""
    let dark = appearance().get()
    let mut surfaces = []int {}
    let mut snames = []string {}
    push(surfaces, role_rgb_now(ROLE.N1))
    push(snames, "n1")
    push(surfaces, role_rgb_now(ROLE.N2))
    push(snames, "n2")
    push(surfaces, role_rgb_now(ROLE.N3))
    push(snames, "n3")

    let mut inks = []int {}
    let mut inames = []string {}
    push(inks, role_rgb_now(ROLE.N11))
    push(inames, "n11")
    push(inks, role_rgb_now(ROLE.N12))
    push(inames, "n12")
    push(inks, role_rgb_now(ROLE.OkS11))
    push(inames, "ok_ink")
    push(inks, role_rgb_now(ROLE.WarnS11))
    push(inames, "warn_ink")
    push(inks, role_rgb_now(ROLE.DangerS11))
    push(inames, "danger_ink")
    push(inks, role_rgb_now(ROLE.InfoS11))
    push(inames, "info_ink")
    push(inks, role_rgb_now(ROLE.A11))
    push(inames, "a11")

    for si in 0..surfaces.len {
        for ii in 0..inks.len {
            let r = contrast_ratio(inks[ii], surfaces[si])
            let mut verdict = "pass"
            if r < 450 {
                verdict = "FAIL"
            }
            out = "{{out}}{{inames[ii]}} on {{snames[si]}}: {{r}} {{verdict}}\n"
        }
    }
    // Text drawn on a solid fill: the accent's own ink, and white on each
    // semantic solid.
    let pairs_fg = []int {
        role_rgb_now(ROLE.OnAccent), role_rgb_now(ROLE.OnOk),
        role_rgb_now(ROLE.OnWarn), role_rgb_now(ROLE.OnDanger),
        role_rgb_now(ROLE.OnInfo),
    }
    let pairs_bg = []int {
        role_rgb_now(ROLE.A9), role_rgb_now(ROLE.OkS9),
        role_rgb_now(ROLE.WarnS9), role_rgb_now(ROLE.DangerS9),
        role_rgb_now(ROLE.InfoS9),
    }
    let pair_names = []string {
        "on_accent/a9", "on_ok/ok_s9", "on_warn/warn_s9",
        "on_danger/danger_s9", "on_info/info_s9",
    }
    for i in 0..pairs_fg.len {
        let r = contrast_ratio(pairs_fg[i], pairs_bg[i])
        // Text on a solid control fill is UI text on a component: AA's 3:1
        // component threshold is the one that applies, not body text's 4.5:1.
        let mut verdict = "pass"
        if r < 300 {
            verdict = "FAIL"
        }
        out = "{{out}}{{pair_names[i]}}: {{r}} {{verdict}}\n"
    }
    return out
}

/// Resolve a role to a packed rgb for the appearance in effect. The paint
/// pass does this per draw; the contrast report needs it up front.
fn role_rgb_now(slot: int) -> int {
    // The roles are registered lazily, and a caller outside the paint path
    // (a test, a contrast check, an accent picker) may be the first to ask.
    ensure_role_colors()
    return arena.paint_rgb(role_color(slot))
}


// --- UI scale (density + type, one knob) ---
/// Scale in percent; 100 is the design system's 1.0. Clamped to 50..200.
/// Applied once, in `apply_int`, as each geometry or type prop lands on a
/// node — so no widget multiplies anything itself. Read at build time, so
/// set it before building a retained tree; a `zeus.view` app re-reads it
/// every frame (zoom reacts live there).
let mut roles_ready: int = 0
let mut ui_scale: int = 100

fn set_scale(percent_value: int) {
    let mut v = percent_value
    if v < 50 {
        v = 50
    }
    if v > 200 {
        v = 200
    }
    ui_scale = v
}

/// Identity at scale 1.0. `x * 100 / 100 == x` for every non-negative int.
// --- typography ---

/// Set the typeface for every label the app draws. One family for the whole
/// app, applied by the host when it measures and draws — there is no
/// per-node family, because the design system uses one typeface and the
/// text ABI carries a pixel size only.
///
/// ```
/// zeus.set_font_family("Universal Sans")
/// ```
/// Pass `""` to fall back to the host's default UI font.
fn set_font_family(name: string) {
    arena.ensure()
    platform.plat_set_font_family(name)
}

/// Register a font the host does not ship, then make it current. `src` is a
/// file path on desktop or a URL on the web. Returns 1 when the host
/// accepted it, 0 when it did not — callers should keep working on the
/// fallback rather than assume the face is present.
///
/// ```
/// if zeus.load_font("Universal Sans", "./fonts/UniversalSans.woff2") == 0 {
///     zeus.set_font_family("Inter")
/// }
/// ```
fn load_font(family: string, src: string) -> int {
    arena.ensure()
    let ok = platform.plat_load_font(family, src)
    if ok != 0 {
        platform.plat_set_font_family(family)
    }
    return ok
}

/// Measure text in-tree from an external font, so every host computes the same
/// line box for the same (font, size, string). `src` is a file path on desktop
/// or a URL on the web.
///
/// Pair it with `load_font(family, src)` so the host *draws* with the same
/// face; this binds the bytes that layout measures with. Returns 1 when the
/// font was read and parsed, 0 when it could not be (the app then keeps host
/// measurement and should not assume the face is present).
///
/// ```
/// if zeus.use_font("./fonts/Inter.ttf") == 0 {
///     // host metrics remain in effect
/// }
/// ```
fn use_font(src: string) -> int {
    arena.ensure()
    return metrics.bind(platform.plat_font_bytes(src))
}

/// Bind already-loaded font bytes for in-tree measurement. The web host has no
/// filesystem, so a web app passes the bytes it fetched itself; desktop apps
/// can use `use_font` instead.
fn use_font_bytes(bytes: string) -> int {
    return metrics.bind(bytes)
}

/// Drop the external font; measurement falls back to the host default.
fn clear_font() {
    metrics.unbind()
}

/// A design px scaled by the UI-scale knob: `scaled(16)` is 16 at 100%,
/// 20 at 125%. Internal — `apply_int` calls it for every geometry and type
/// prop, which is the only place scaling happens. Widgets never call it.
fn scaled(v: int) -> int {
    return i32(i64(v) * i64(ui_scale) / i64(100))
}

// --- button geometry: heights 32/36/40px, side padding 12/16/32px ---

/// Side padding for a `SIZE` token. Button geometry is a set of small
/// pickers so a recipe reads one token and gets a consistent control.
fn button_padding_x(size: int) -> int {
    if size == SIZE.Sm { 12 } else if size == SIZE.Lg { 32 } else { 16 }
}

/// Control height for a `SIZE` token; see `button_padding_x`.
fn button_height(size: int) -> int {
    if size == SIZE.Sm { 32 } else if size == SIZE.Lg { 40 } else { 36 }
}

/// Label size for a `SIZE` token; see `button_padding_x`.
fn button_font(size: int) -> int {
    if size == SIZE.Sm { 12 } else { FONT_BODY }
}

/// Corner radius for a `SIZE` token; see `button_padding_x`.
fn button_radius(size: int) -> int {
    return RAD_MD
}

/// Fill for a `LOOK` token. Returns a theme accessor result, so calling it
/// inside a prop expression keeps the button following the palette.
fn button_background(look: int) -> string {
    match look {
        LOOK.Solid => { return accent() }
        LOOK.Soft => { return raised() }
        LOOK.Outline => { return plate() }
        LOOK.Danger => { return danger_solid() }
        _ => { return "" }
    }
}

/// Label color for a `LOOK` token; see `button_background`.
fn button_color(look: int) -> string {
    match look {
        LOOK.Solid => { return on_ink() }
        LOOK.Danger => { return on_danger() }
        _ => { return ink() }
    }
}

/// Border width for a `LOOK` token — only the outline look carries one.
fn button_border_width(look: int) -> int {
    match look {
        LOOK.Outline => { return HAIRLINE }
        _ => { return 0 }
    }
}

/// Border color for a `LOOK` token; see `button_border_width`.
fn button_border_color(look: int) -> string {
    match look {
        LOOK.Outline => { return rule() }
        _ => { return "" }
    }
}


/// `markup` painted at `px` square and tinted by `tint`. Returns the node so
/// callers can bind visibility.
///
/// An svg node has no intrinsic size, so the box is set explicitly. The tint
/// goes through `prop_str` rather than `fg` so it re-applies on an
/// appearance change: `apply_str` hands an unknown setter to `apply_int`, and
/// 16 is the fg slot.
fn Icon(markup: string, px: int, tint: string) -> Node {
    return Component(raw_svg(markup), width = px, height = px, color = tint)
}

fn Pip(fill: string, size: int) -> Node {
    return Box(width = size, height = size, radius = size / 2, background = fill)
}

fn Row(spacing: int) -> Node {
    return Box(align_direction = DIRECTION.Row, spacing = spacing,
               align_items = ALIGN.Center)
}

/// Row that wraps onto the next line when it overflows (`flex-wrap: wrap`).
/// Use for responsive clusters of chips, buttons, and badges.
fn RowWrap(spacing: int) -> Node {
    return Box(align_direction = DIRECTION.Row, spacing = spacing,
               align_items = ALIGN.Center, wrap = 1)
}

fn Column(spacing: int) -> Node {
    return Box(align_direction = DIRECTION.Column, spacing = spacing)
}

fn Grow() {
    Box(grow = 1)
}

/// Card chrome. `Card()` keeps the recipe; pass any style prop to restyle
/// it without copying the widget (`Card(radius = 6, padding = 12)`).
/// `visible` and `bind` go through `Component`.
struct CardProps {
    /// Style props. Plain data — `radius = 4`, `background = paper()`. Each
    /// is re-evaluated by the effect that owns that attribute, so it follows
    /// a theme switch. `-1` / `""` keep the recipe's own value.
    background: string = "",
    color: string = "",
    /// Elevation 0..4; defaults to 1 (a resting card).
    elevation: int = -1,
    radius: int = -1,
    padding: int = -1,
    padding_x: int = -1,
    padding_y: int = -1,
    width: int = -1,
    height: int = -1,
    /// Bounds the card can lay out within. `Box` has always had these; the
    /// recipe dropped them, so `Card(min_width = …)` was an unknown field.
    min_width: int = -1,
    max_width: int = -1,
    min_height: int = -1,
    max_height: int = -1,
    font: int = -1,
    border: int = -1,
    border_color: string = "",
    spacing: int = -1,

    visible: Signal<int> = Signal { id: 0 },
    visible__set: bool = false,
    bind: Signal<int> = Signal { id: 0 },
    bind__set: bool = false,
    /// Interactive card: a pointer target with a hover lift and `on_click`
    /// (role `button`). `on_click` alone implies it.
    interactive: bool = false,
    on_click: fn() = noop,
    on_click__set: bool = false,
    /// Elevation the card lifts to on hover (default 3 when interactive,
    /// 0 = no lift). Paint-only: the shadow blends on the hover track.
    lift: int = -1,
    /// Header row above the body: `title` (heading type) and `subtitle`
    /// (muted caption). Either empty = no header.
    title: string = "",
    subtitle: string = "",
    /// Media strip above everything: an image `src` at `media_height` dp,
    /// bleeding to the card edge under the top corners.
    media: string = "",
    media_height: int = 160,
    /// Footer row under the body, separated by a hairline; built by this
    /// thunk (actions, a caption). Omit for none.
    footer: fn() = noop,
    footer__set: bool = false,
    /// Chord that activates this node: `"cmd+s"`, `"ctrl+shift+p"`, or a
    /// sequence like `"g d"`. Every widget takes it — key binding is a prop,
    /// not something a particular widget hard-codes.
    key: string = "",
    /// Name the chord resolves to, so an app can remap it with `remap_key`
    /// without touching the widget. Defaults to `"key.<chord>"`.
    key_action: string = "",
    /// Handler for the chord; omit it and the chord runs `on_click`.
    on_key: fn() = noop,
    on_key__set: bool = false,
    /// true = fires wherever focus is, instead of only on this node.
    key_global: bool = false,
}

/// Lift a node's shadow to elevation `level` while hovered (paint-only; the
/// hover wash is dropped in favour of the lift). `Card(interactive = true)`
/// sets it; any surface can take it.
fn hover_lift(node: Node, level: int) -> Node {
    let mut l = level
    if l < 0 {
        l = 0
    }
    if l > 4 {
        l = 4
    }
    arena.nodes[node.id].lift = u8(l)
    hover_fade(node)
    return node
}

/// Card body slot. The trailing block lands here — after the media and
/// header, before the footer — so `Card(title = "…") { … }` reads top-down.
fn Card(p: CardProps) -> Node {
    let interactive = p.interactive || p.on_click__set
    let mut cursor = ""
    let mut role = ""
    if interactive {
        cursor = "pointer"
        role = "button"
    }
    let mut pad_top = px_or_default(p.padding_y, px_or_default(p.padding, 16))
    if p.media.len > 0 {
        pad_top = 0
    }
    let n = Box(
        align_direction = DIRECTION.Column,
        spacing = px_or_default(p.spacing, SPACE.Xs),
        background = str_or_default(p.background, plate()),
        padding_x = px_or_default(p.padding_x, px_or_default(p.padding, 20)),
        padding_top = pad_top,
        padding_bottom = px_or_default(p.padding_y, px_or_default(p.padding, 16)),
        radius = px_or_default(p.radius, RAD_XL),
        border = px_or_default(p.border, HAIRLINE),
        border_color = str_or_default(p.border_color, rule()),
        elevation = px_or_default(p.elevation, 1),
        color = p.color,
        font = p.font,
        width = p.width,
        height = p.height,
        min_width = p.min_width,
        max_width = p.max_width,
        min_height = p.min_height,
        max_height = p.max_height,
        visible = p.visible,
        bind = p.bind,
        on_click = p.on_click,
        on_click__set = p.on_click__set,
        cursor = cursor,
        a11y_role = role
    )
    if interactive {
        hover_lift(n, px_or_default(p.lift, 3))
        press_scale(n)
        arena.nodes[n.id].press = u8(1)
    } else if p.lift > 0 {
        hover_lift(n, p.lift)
    }
    let has_header = p.title.len > 0 || p.subtitle.len > 0
    if p.media.len > 0 || has_header {
        ui_push(n.id)
        if p.media.len > 0 {
            // Negative side margins pull the strip out to the card edge;
            // the top corners follow the card radius.
            let r = px_or_default(p.radius, RAD_XL)
            let px = px_or_default(p.padding_x, px_or_default(p.padding, 20))
            let strip = Box(height = p.media_height, radius = r)
            // Props drop negatives (-1 = unset), so the bleed is set directly.
            marginLeft(strip, -px)
            marginRight(strip, -px)
            overflow(strip, overflow_hidden())
            slot(strip, || {
                Image(p.media, height = p.media_height, fit = IMAGE_FIT.Cover, grow = 1)
            })
            let signal_id = strip.id
            arena.nodes[signal_id].a11y_role = "img"
        }
        if has_header {
            let hd = Column(2)
            arena.nodes[hd.id].a11y_role = "heading"
            slot(hd, || {
                if p.title.len > 0 {
                    Text(p.title, color = ink(), font = FONT_TITLE)
                }
                if p.subtitle.len > 0 {
                    Text(p.subtitle, color = mute(), font = FONT_CAPTION)
                }
            })
        }
        ui_pop()
    }
    if p.footer__set {
        // The caller's trailing block is emitted after this returns, so the
        // footer built here would sit above it. An inner body column takes
        // the block (`slot_into`), and the footer follows that column.
        ui_push(n.id)
        let body = Column(px_or_default(p.spacing, SPACE.Xs))
        Separator()
        let f = Box(align_direction = DIRECTION.Row, align_items = ALIGN.Center,
                    spacing = SPACE.Exs)
        arena.nodes[f.id].a11y_role = "contentinfo"
        slot(f, p.footer)
        ui_pop()
        arena.nodes[n.id].slot_into = body.id
    }
    return n
}

/// Build your own widget: extends `Component` via `Box`. Trailing block is
/// the slot. `bind` / `visible` / `press` are the same lifecycle as every
/// other widget — pass them here, do not call `ui_push` / `bind` / `show`.
struct CompProps {
    /// Style props. Plain data — `radius = 4`, `background = paper()`. Each
    /// is re-evaluated by the effect that owns that attribute, so it follows
    /// a theme switch. `-1` / `""` keep the recipe's own value.
    background: string = "",
    color: string = "",
    radius: int = -1,
    padding: int = -1,
    padding_x: int = -1,
    padding_y: int = -1,
    padding_top: int = -1,
    padding_right: int = -1,
    padding_bottom: int = -1,
    padding_left: int = -1,
    margin: int = -1,
    margin_x: int = -1,
    margin_y: int = -1,
    margin_top: int = -1,
    margin_right: int = -1,
    margin_bottom: int = -1,
    margin_left: int = -1,
    width: int = -1,
    height: int = -1,
    /// Bounds for a custom widget; `Box` has always had these.
    min_width: int = -1,
    max_width: int = -1,
    min_height: int = -1,
    max_height: int = -1,
    font: int = -1,
    border: int = -1,
    border_color: string = "",
    spacing: int = -1,
    gap: int = -1,
    gap_row: int = -1,
    gap_col: int = -1,
    align_direction: int = 1,
    align_items: int = -1,
    justify: int = -1,
    on_click: fn() = noop,
    on_click__set: bool = false,
    a11y_role: string = "",
    a11y_label: string = "",
    hover_off: bool = true,
    cursor: string = "",
    bind: Signal<int> = Signal { id: 0 },
    bind__set: bool = false,
    visible: Signal<int> = Signal { id: 0 },
    visible__set: bool = false,
    press: bool = false,
    /// Chord that activates this node: `"cmd+s"`, `"ctrl+shift+p"`, or a
    /// sequence like `"g d"`. Every widget takes it — key binding is a prop,
    /// not something a particular widget hard-codes.
    key: string = "",
    /// Name the chord resolves to, so an app can remap it with `remap_key`
    /// without touching the widget. Defaults to `"key.<chord>"`.
    key_action: string = "",
    /// Handler for the chord; omit it and the chord runs `on_click`.
    on_key: fn() = noop,
    on_key__set: bool = false,
    /// true = fires wherever focus is, instead of only on this node.
    key_global: bool = false,
}

fn Comp(p: CompProps) -> Node {
    let want_press = p.press || p.on_click__set
    let __n = Box(
        align_direction = p.align_direction,
        align_items = p.align_items,
        justify = p.justify,
        background = p.background,
        color = p.color,
        radius = p.radius,
        padding = p.padding,
        padding_x = p.padding_x,
        padding_y = p.padding_y,
        padding_top = p.padding_top,
        padding_right = p.padding_right,
        padding_bottom = p.padding_bottom,
        padding_left = p.padding_left,
        margin = p.margin,
        margin_x = p.margin_x,
        margin_y = p.margin_y,
        margin_top = p.margin_top,
        margin_right = p.margin_right,
        margin_bottom = p.margin_bottom,
        margin_left = p.margin_left,
        width = p.width,
        height = p.height,
        min_width = p.min_width,
        max_width = p.max_width,
        min_height = p.min_height,
        max_height = p.max_height,
        font = p.font,
        border = p.border,
        border_color = p.border_color,
        spacing = p.spacing,
        gap = p.gap,
        gap_row = p.gap_row,
        gap_col = p.gap_col,
        on_click = p.on_click,
        on_click__set = p.on_click__set,
        a11y_role = p.a11y_role,
        a11y_label = p.a11y_label,
        hover_off = p.hover_off,
        cursor = p.cursor,
        bind = p.bind,
        visible = p.visible,
        press = want_press
    )
    return apply_key(__n, p.key, p.key_action, p.on_key, p.on_key__set, p.key_global)
}

/// Horizontal hairline. Kept as `Divider` for older callers.
fn Separator() {
    Box(height = 1, background = rule())
}

/// Legacy name for `Separator`.
fn Divider() {
    Separator()
}

fn Overline(text: fn() -> string) -> Node {
    return Text(text, color = dim(), font = FONT_OVERLINE)
}

fn Display(text: fn() -> string) -> Node {
    return Text(text, color = ink(), font = FONT_DISPLAY)
}

fn Heading(text: fn() -> string) -> Node {
    return Text(text, color = ink(), font = FONT_HEADING)
}

fn Title(text: fn() -> string) -> Node {
    return Text(text, color = ink(), font = FONT_TITLE)
}

fn Body(text: fn() -> string) -> Node {
    return Text(text, color = mute(), font = FONT_BODY)
}

fn Note(text: fn() -> string) -> Node {
    return Text(text, color = dim(), font = FONT_CAPTION)
}

/// Overline + heading + supporting copy as one block.
fn SectionHeader(overline: fn() -> string, title: fn() -> string,
                 body: fn() -> string) {
    Column(SPACE.Exxxs) {
        Text(overline, color = dim(), font = FONT_OVERLINE)
        Text(title, color = ink(), font = FONT_HEADING)
        Text(body, color = mute(), font = FONT_BODY, wrap = 1)
    }
}

/// `SectionHeader` without the supporting copy.
fn SectionTitle(overline: fn() -> string, title: fn() -> string) {
    Column(SPACE.Exxxs) {
        Text(overline, color = dim(), font = FONT_OVERLINE)
        Text(title, color = ink(), font = FONT_HEADING)
    }
}

/// Icon-only button: square, 16px glyph in the `look` chrome. `size` picks
/// a 32 / 36 / 40px box. `on_click` is optional —
/// omit it for a look-only demo
/// (`IconButton(IC_X, LOOK.Ghost, SIZE.Md, "Close")`).
struct IconButtonProps {
    on_click: fn() = noop,
    on_click__set: bool = false,
    /// Style props. Plain data — `radius = 4`, `background = paper()`. Each
    /// is re-evaluated by the effect that owns that attribute, so it follows
    /// a theme switch. `-1` / `""` keep the recipe's own value.
    background: string = "",
    color: string = "",
    radius: int = -1,
    padding: int = -1,
    padding_x: int = -1,
    padding_y: int = -1,
    width: int = -1,
    height: int = -1,
    font: int = -1,
    border: int = -1,
    border_color: string = "",
    spacing: int = -1,
    /// Chord that activates this node: `"cmd+s"`, `"ctrl+shift+p"`, or a
    /// sequence like `"g d"`. Every widget takes it — key binding is a prop,
    /// not something a particular widget hard-codes.
    key: string = "",
    /// Name the chord resolves to, so an app can remap it with `remap_key`
    /// without touching the widget. Defaults to `"key.<chord>"`.
    key_action: string = "",
    /// Handler for the chord; omit it and the chord runs `on_click`.
    on_key: fn() = noop,
    on_key__set: bool = false,
    /// true = fires wherever focus is, instead of only on this node.
    key_global: bool = false,
}

fn IconButton(markup: string, look: int, size: int, label: string,
              p: IconButtonProps) -> Node {
    let n = Box(
        align_direction = DIRECTION.Row,
        align_items = ALIGN.Center,
        justify = ALIGN.Center,
        width = px_or_default(p.width, button_height(size)),
        height = px_or_default(p.height, button_height(size)),
        radius = px_or_default(p.radius, button_radius(size)),
        background = str_or_default(p.background, button_background(look)),
        border = px_or_default(p.border, button_border_width(look)),
        border_color = str_or_default(p.border_color, button_border_color(look)),
        on_click = p.on_click,
        on_click__set = p.on_click__set,
        a11y_role = "button",
        a11y_label = label,
        hover_off = false,
        cursor = "pointer",
        press = true
    ) {
        Icon(markup, 16, str_or_default(p.color, button_color(look)))
    }
    // Same as `btn_look`: the square stays a hover target without a handler.
    hover_fade(n)
    return n
}

/// Status pill: tinted dot and label on a muted border pill. Pass any style
/// prop to restyle it (`Chip("pill", TINT.Ok, radius = 6)`).
struct ChipProps {
    /// Style props. Plain data — `radius = 4`, `background = paper()`. Each
    /// is re-evaluated by the effect that owns that attribute, so it follows
    /// a theme switch. `-1` / `""` keep the recipe's own value.
    background: string = "",
    color: string = "",
    radius: int = -1,
    padding: int = -1,
    padding_x: int = -1,
    padding_y: int = -1,
    width: int = -1,
    height: int = -1,
    font: int = -1,
    border: int = -1,
    border_color: string = "",
    spacing: int = -1,
    /// false hides the leading tint dot.
    dot: bool = true,
    /// Removable chip: a trailing X runs this (role `button`, label
    /// `Remove <label>`). Hiding the chip is the caller's job — usually
    /// `show` on a signal the handler clears.
    on_remove: fn() = noop,
    on_remove__set: bool = false,
    /// Chord that activates this node: `"cmd+s"`, `"ctrl+shift+p"`, or a
    /// sequence like `"g d"`. Every widget takes it — key binding is a prop,
    /// not something a particular widget hard-codes.
    key: string = "",
    /// Name the chord resolves to, so an app can remap it with `remap_key`
    /// without touching the widget. Defaults to `"key.<chord>"`.
    key_action: string = "",
    /// Handler for the chord; omit it and the chord runs `on_click`.
    on_key: fn() = noop,
    on_key__set: bool = false,
    /// true = fires wherever focus is, instead of only on this node.
    key_global: bool = false,
}

/// Chip: rounded tag with a tint dot and caption text. `dot = false` drops
/// the pip; `on_remove` adds a trailing X.
fn Chip(label: fn() -> string, kind: int, p: ChipProps) -> Node {
    let tint = str_or_default(p.color, tint_of(kind))
    let mut pad_r = px_or_default(p.padding_x, px_or_default(p.padding, 10))
    if p.on_remove__set {
        // The X carries its own hit box, so the trailing gutter shrinks.
        pad_r = 4
    }
    let __n = Box(align_direction = DIRECTION.Row,
                  spacing = px_or_default(p.spacing, SPACE.Exxs),
                  align_items = ALIGN.Center,
                  padding_left = px_or_default(p.padding_x, px_or_default(p.padding, 10)),
                  padding_right = pad_r,
                  padding_y = px_or_default(p.padding_y, px_or_default(p.padding, 5)),
                  background = str_or_default(p.background, raised()),
                  radius = px_or_default(p.radius, RAD_FULL),
                  border = px_or_default(p.border, HAIRLINE),
                  border_color = str_or_default(p.border_color, rule()),
                  width = p.width,
                  height = px_or_default(p.height, 26))
    ui_push(__n.id)
    if p.dot {
        Pip(tint, DOT - 2)
    }
    Text(label, color = tint, font = px_or_default(p.font, FONT_CAPTION), ellipsis = true)
    if p.on_remove__set {
        let x = Box(width = 18, height = 18, radius = RAD_FULL,
                    align_items = ALIGN.Center, justify = ALIGN.Center,
                    shrink = 0,
                    on_click = p.on_remove,
                    a11y_role = "button",
                    a11y_label = "Remove {{label()}}",
                    cursor = "pointer") {
            Icon(IC_X, 12, mute())
        }
        hover_fade(x)
    }
    ui_pop()
    return apply_key(__n, p.key, p.key_action, p.on_key, p.on_key__set, p.key_global)
}

/// Fill for a badge `TINT`. Split from the button pickers because badges
/// use filled status colors where buttons use accent chrome.
fn badge_background(kind: int) -> string {
    match kind {
        TINT.Mute => { return raised() }
        TINT.Ok => { return ok_solid() }
        TINT.Danger => { return danger_solid() }
        TINT.Warn => { return warn_fill() }
        _ => { return accent() }
    }
}

/// Label color for a badge `TINT`; see `badge_background`.
fn badge_color(kind: int) -> string {
    match kind {
        TINT.Mute | TINT.Dim => { return ink() }
        TINT.Ok => { return on_ok() }
        TINT.Warn => { return warn() }
        _ => { return on_ink() }
    }
}

/// Border width for a badge `TINT` — only the outline tint carries one.
fn badge_border_width(kind: int) -> int {
    match kind {
        TINT.Dim => { return HAIRLINE }
        _ => { return 0 }
    }
}

/// Border color for a badge `TINT`; see `badge_border_width`.
fn badge_border_color(kind: int) -> string {
    match kind {
        TINT.Dim => { return hard() }
        _ => { return "" }
    }
}

/// Badge: small bordered pill, 10px side padding, caption type.
/// Kinds: Ink default, Mute secondary, Dim outline, Danger destructive;
/// Ok is a filled success badge. `dot = true` adds a leading status pip
/// in the label colour; `BadgeCount` is the numeric variant.
struct BadgeProps {
    /// Style props. Plain data — `radius = 4`, `background = paper()`. Each
    /// is re-evaluated by the effect that owns that attribute, so it follows
    /// a theme switch. `-1` / `""` keep the recipe's own value.
    background: string = "",
    color: string = "",
    radius: int = -1,
    padding: int = -1,
    padding_x: int = -1,
    padding_y: int = -1,
    width: int = -1,
    height: int = -1,
    font: int = -1,
    border: int = -1,
    border_color: string = "",
    spacing: int = -1,
    /// Leading status pip in the label colour.
    dot: bool = false,
    /// Chord that activates this node: `"cmd+s"`, `"ctrl+shift+p"`, or a
    /// sequence like `"g d"`. Every widget takes it — key binding is a prop,
    /// not something a particular widget hard-codes.
    key: string = "",
    /// Name the chord resolves to, so an app can remap it with `remap_key`
    /// without touching the widget. Defaults to `"key.<chord>"`.
    key_action: string = "",
    /// Handler for the chord; omit it and the chord runs `on_click`.
    on_key: fn() = noop,
    on_key__set: bool = false,
    /// true = fires wherever focus is, instead of only on this node.
    key_global: bool = false,
}

fn Badge(label: fn() -> string, kind: int, p: BadgeProps) -> Node {
    let tint = str_or_default(p.color, badge_color(kind))
    let __n = Box(align_direction = DIRECTION.Row,
                  padding_x = px_or_default(p.padding_x, px_or_default(p.padding, 10)),
                  padding_y = px_or_default(p.padding_y, px_or_default(p.padding, 2)),
                  radius = px_or_default(p.radius, RAD_MD),
                  background = str_or_default(p.background, badge_background(kind)),
                  border = px_or_default(p.border, badge_border_width(kind)),
                  border_color = str_or_default(p.border_color, badge_border_color(kind)),
                  width = p.width,
                  height = p.height,
                  spacing = px_or_default(p.spacing, SPACE.Exxs),
                  align_items = ALIGN.Center,
                  justify = ALIGN.Center)
    ui_push(__n.id)
    if p.dot {
        Pip(tint, DOT - 2)
    }
    Text(label, color = tint, font = px_or_default(p.font, FONT_CAPTION))
    ui_pop()
    return apply_key(__n, p.key, p.key_action, p.on_key, p.on_key__set, p.key_global)
}

/// Count badge: a round pill bound to a number, hidden while it is 0 and
/// capped at `max` ("99+"). Sits over an icon or after a nav label.
fn BadgeCount(count: Signal<int>, kind: int, max: int = 99) -> Node {
    let n = Box(align_direction = DIRECTION.Row,
                min_width = 18,
                height = 18,
                padding_x = 5,
                radius = RAD_FULL,
                background = badge_background(kind),
                align_items = ALIGN.Center,
                justify = ALIGN.Center,
                a11y_role = "status") {
        Text(fn() -> string {
            let v = count.get()
            if v > max {
                return "{{max}}+"
            }
            return "{{v}}"
        }, color = badge_color(kind), font = 11)
    }
    return show_ne(n, count, 0)
}

/// Key cap: 1px border on muted, mono-ish small text, 20px tall.
fn Kbd(key: fn() -> string) {
    Box(align_direction = DIRECTION.Row, padding_x = 6, radius = 4,
        height = 20, background = raised(), border = HAIRLINE,
        border_color = rule(), align_items = ALIGN.Center,
        justify = ALIGN.Center) {
        Text(key, color = mute(), font = 10)
    }
}

/// Toggle `on` (0/1). Native toggle: off track = input, on track = primary,
/// thumb rides on `background`. Pass `appearance()` for Dark mode.
fn Switch(on: Signal<int>) {
    Component(raw_toggle(), bind = on, width = 36, height = 20,
              radius = 10, on_click = fn() => on.set(1 - on.get()),
              a11y_role = "switch", hover_off = true, cursor = "pointer")
}

/// Slider. Track is `primary/20`-ish, filled range primary, thumb surface.
fn Slider(value: Signal<int>) {
    Component(raw_slider(), bind = value, width = 220, height = 20, radius = 10,
              a11y_role = "slider", hover_off = true, cursor = "pointer")
}

/// Progress: 8px track, rounded, filled with the accent. Value 0..100; a
/// plain `set` eases the fill over `MOTION.Base` on the paint overlay (no
/// effect re-runs per frame). A negative value is indeterminate: a segment
/// sweeps the track on the frame clock until the value is 0..100 again.
fn Progress(value: Signal<int>) -> Node {
    let n = Component(raw_progress(), bind = value, width = 220, height = 8, radius = 4)
    arena.nodes[n.id].a11y_role = "progressbar"
    let node_id = n.id
    let signal_id = value.id
    // `tween` holds the last state this bar was asked to show (-1 at build),
    // so the next write can ease from it.
    effect(|| {
        let v = value.get()
        let last = arena.nodes[node_id].tween
        if v < 0 {
            arena.note_spin(node_id, 1400)
        } else {
            arena.clear_spin(node_id)
            // A write from `zeus.animate` brings its own track and duration;
            // only a plain `set` gets the default ease.
            if last >= 0 && arena.anim_bind_on() == 0 {
                arena.anim_paint_from(signal_id, last, MOTION.Base)
            }
        }
        arena.nodes[node_id].tween = v
    })
    return n
}

/// Legacy name for `Progress`.
fn Meter(value: Signal<int>) {
    Progress(value)
}

/// Alert: rounded bordered panel, leading icon, title + description.
/// Default is the info tier; `AlertDestructive` / `AlertWarning` /
/// `AlertSuccess` pick the others. `dismiss` is a 0/1 signal (X sets 0).
/// Trailing block is the action slot, under the body.
struct AlertProps {
    /// Style props. Plain data — `radius = 4`, `background = paper()`. Each
    /// is re-evaluated by the effect that owns that attribute, so it follows
    /// a theme switch. `-1` / `""` keep the recipe's own value.
    background: string = "",
    color: string = "",
    radius: int = -1,
    padding: int = -1,
    padding_x: int = -1,
    padding_y: int = -1,
    width: int = -1,
    height: int = -1,
    font: int = -1,
    border: int = -1,
    border_color: string = "",
    spacing: int = -1,
    /// Override the function's tier (`ALERT.*`). `-1` keeps the function's.
    kind: int = -1,
    /// 0/1 show signal. When passed, an X in the title row sets it to 0.
    dismiss: Signal<int> = Signal { id: 0 },
    dismiss__set: bool = false,
    /// Chord that activates this node: `"cmd+s"`, `"ctrl+shift+p"`, or a
    /// sequence like `"g d"`. Every widget takes it — key binding is a prop,
    /// not something a particular widget hard-codes.
    key: string = "",
    /// Name the chord resolves to, so an app can remap it with `remap_key`
    /// without touching the widget. Defaults to `"key.<chord>"`.
    key_action: string = "",
    /// Handler for the chord; omit it and the chord runs `on_click`.
    on_key: fn() = noop,
    on_key__set: bool = false,
    /// true = fires wherever focus is, instead of only on this node.
    key_global: bool = false,
}

fn Alert(title: fn() -> string, body: fn() -> string, p: AlertProps) -> Node {
    let mut k = ALERT.Info
    if p.kind >= 0 {
        k = p.kind
    }
    return alert_view(title, body, k, p)
}

/// Destructive variant of `Alert`.
fn AlertDestructive(title: fn() -> string, body: fn() -> string, p: AlertProps) -> Node {
    let mut k = ALERT.Danger
    if p.kind >= 0 {
        k = p.kind
    }
    return alert_view(title, body, k, p)
}

/// Warning variant of `Alert`: amber edge and icon.
fn AlertWarning(title: fn() -> string, body: fn() -> string, p: AlertProps) -> Node {
    let mut k = ALERT.Warn
    if p.kind >= 0 {
        k = p.kind
    }
    return alert_view(title, body, k, p)
}

/// Success variant of `Alert`: green edge and check icon.
fn AlertSuccess(title: fn() -> string, body: fn() -> string, p: AlertProps) -> Node {
    let mut k = ALERT.Ok
    if p.kind >= 0 {
        k = p.kind
    }
    return alert_view(title, body, k, p)
}

/// Explicit info variant; same as `Alert`.
fn AlertInfo(title: fn() -> string, body: fn() -> string, p: AlertProps) -> Node {
    return Alert(title, body, p)
}

/// Which `Alert` variant is painting.
enum ALERT {
    Info = 0,
    Danger = 1,
    Warn = 2,
    Ok = 3,
}

fn alert_edge(kind: int) -> string {
    match kind {
        ALERT.Danger => { return danger_edge() }
        ALERT.Warn => { return warn_edge() }
        ALERT.Ok => { return ok() }
        _ => { return info_line() }
    }
}

fn alert_title_tint(kind: int) -> string {
    match kind {
        ALERT.Danger => { return danger() }
        ALERT.Warn => { return warn() }
        ALERT.Ok => { return ok() }
        _ => { return info_ink() }
    }
}

fn alert_body_tint(kind: int) -> string {
    match kind {
        ALERT.Danger => { return danger() }
        ALERT.Ok => { return ok() }
        _ => { return mute() }
    }
}

fn alert_icon(kind: int) {
    match kind {
        ALERT.Danger => { Icon(IC_ALERT_CIRCLE, 16, danger()) }
        ALERT.Warn => { Icon(IC_ALERT_CIRCLE, 16, warn()) }
        ALERT.Ok => { Icon(IC_CHECK, 16, ok()) }
        _ => { Icon(IC_INFO, 16, info_ink()) }
    }
}

fn alert_view(title: fn() -> string, body: fn() -> string, kind: int, p: AlertProps) -> Node {
    let shell = Box(align_direction = DIRECTION.Row,
               spacing = px_or_default(p.spacing, 12),
               align_items = ALIGN.Start,
               background = str_or_default(p.background, plate()),
               border = px_or_default(p.border, HAIRLINE),
               border_color = str_or_default(p.border_color, alert_edge(kind)),
               padding_x = px_or_default(p.padding_x, px_or_default(p.padding, 16)),
               padding_y = px_or_default(p.padding_y, px_or_default(p.padding, 12)),
               width = p.width,
               height = p.height,
               radius = px_or_default(p.radius, RAD_LG),
               a11y_role = "alert",
               visible = p.dismiss,
               visible__set = p.dismiss__set) {
        alert_icon(kind)
        Column(4) {
            if p.dismiss__set {
                Box(align_direction = DIRECTION.Row, align_items = ALIGN.Center, spacing = SPACE.Exs) {
                    Text(title, color = alert_title_tint(kind), font = FONT_BODY, grow = 1)
                    let x = Box(width = 28, height = 28, radius = RAD_MD,
                                align_items = ALIGN.Center, justify = ALIGN.Center,
                                on_click = fn() { p.dismiss.set(0) },
                                a11y_role = "button", a11y_label = "Dismiss",
                                cursor = "pointer") {
                        Icon(IC_X, 16, mute())
                    }
                    focusable(x)
                }
            } else {
                Text(title, color = alert_title_tint(kind), font = FONT_BODY)
            }
            Text(body, color = alert_body_tint(kind), font = FONT_CONTROL, wrap = 1)
        }
    }
    return apply_key(shell, p.key, p.key_action, p.on_key, p.on_key__set, p.key_global)
}

/// Raised panel (no border). Prefer `Card` for the bordered look.
fn Surface() -> Node {
    return Box(
        align_direction = DIRECTION.Column,
        spacing = SPACE.Xs,
        background = raised(),
        padding = SPACE.Md,
        radius = RAD_LG
    )
}

/// Form label: body-size, medium weight.
fn Label(text: fn() -> string) -> Node {
    return Text(text, color = ink(), font = FONT_BODY)
}

/// Text input frame (themed; raw editing widget is `Input`): 36px tall,
/// rounded, 1px border, transparent fill.
/// Single-line compose field. `width >= 0` pins the field (typing then
/// scrolls inside it instead of resizing the layout); -1 keeps the natural
/// content width. Pin with `width = 200`; restyle with any style prop.
struct TextInputProps {
    /// Style props. Plain data — `radius = 4`, `background = paper()`. Each
    /// is re-evaluated by the effect that owns that attribute, so it follows
    /// a theme switch. `-1` / `""` keep the recipe's own value.
    background: string = "",
    color: string = "",
    radius: int = -1,
    padding: int = -1,
    padding_x: int = -1,
    padding_y: int = -1,
    width: int = -1,
    height: int = -1,
    font: int = -1,
    border: int = -1,
    border_color: string = "",
    spacing: int = -1,
    /// Chord that activates this node: `"cmd+s"`, `"ctrl+shift+p"`, or a
    /// sequence like `"g d"`. Every widget takes it — key binding is a prop,
    /// not something a particular widget hard-codes.
    key: string = "",
    /// Name the chord resolves to, so an app can remap it with `remap_key`
    /// without touching the widget. Defaults to `"key.<chord>"`.
    key_action: string = "",
    /// Handler for the chord; omit it and the chord runs `on_click`.
    on_key: fn() = noop,
    on_key__set: bool = false,
    /// true = fires wherever focus is, instead of only on this node.
    key_global: bool = false,
}

/// X control that appears while `value` is non-empty and clears the bound
/// field. Shared by `TextInput` / `TextArea` / `Combobox`.
fn input_clear(value: Signal<string>, field: Node) {
    let on = signal(0)
    effect(|| {
        if value.get().len > 0 {
            on.set(1)
        } else {
            on.set(0)
        }
    })
    let btn = Box(width = 20, height = 20, radius = RAD_SM,
                  align_items = ALIGN.Center, justify = ALIGN.Center,
                  shrink = 0,
                  on_click = fn() {
                      value.set("")
                      set_input(field, "")
                      arena.claim_focus(field.id)
                  },
                  a11y_role = "button",
                  a11y_label = "Clear",
                  cursor = "pointer") {
        Icon(IC_X, 12, mute())
    }
    // Pointer-only: keyboard users clear with Cmd/Ctrl+A then Backspace, so
    // the X is not a tab stop between the field and the next control.
    arena.nodes[btn.id].focusable = 0
    show(btn, on)
}

fn TextInput(value: Signal<string>, placeholder: string, p: TextInputProps) -> Node {
    let __n = Box(
        align_direction = DIRECTION.Row,
        align_items = ALIGN.Center,
        background = str_or_default(p.background, plate()),
        border = px_or_default(p.border, HAIRLINE),
        border_color = str_or_default(p.border_color, rule()),
        radius = px_or_default(p.radius, RAD_MD),
        padding_x = px_or_default(p.padding_x, px_or_default(p.padding, 12)),
        padding_y = px_or_default(p.padding_y, px_or_default(p.padding, 8)),
        width = p.width,
        height = p.height,
        spacing = px_or_default(p.spacing, 4),
        cursor = "text"
    )
    ui_push(__n.id)
    let fin = Input(bind = value, placeholder = placeholder,
                    background = "", color = str_or_default(p.color, ink()),
                    font = px_or_default(p.font, FONT_BODY),
                    padding = 0, grow = 1, a11y_label = placeholder)
    shrink(fin, 1)
    on_click(__n, fn() { arena.claim_focus(fin.id) })
    input_clear(value, fin)
    ui_pop()
    return apply_key(__n, p.key, p.key_action, p.on_key, p.on_key__set, p.key_global)
}

/// Multiline compose field: min-height ~4 lines, same chrome as `TextInput`.
/// `width >= 0` pins the field width; -1 keeps the natural content width.
/// `on_edit` runs on key-up (autosave).
fn TextArea(value: Signal<string>, placeholder: string, on_edit: fn() = noop,
            width: int = -1) {
    let node = Box(
        align_direction = DIRECTION.Row,
        align_items = ALIGN.Start,
        background = plate(),
        border = HAIRLINE,
        border_color = rule(),
        radius = RAD_MD,
        padding_x = 12,
        padding_y = 8,
        min_height = 96,
        spacing = 4,
        cursor = "text"
    )
    ui_push(node.id)
    let fin = Input(bind = value, placeholder = placeholder,
                    background = "", color = ink(), font = FONT_BODY,
                    padding = 0, multiline = 1, grow = 1, a11y_label = placeholder,
                    on_key_up = on_edit)
    on_click(node, fn() { arena.claim_focus(fin.id) })
    input_clear(value, fin)
    ui_pop()
    if width >= 0 {
        set_width(node, width)
    }
    node
}

/// Label + input. Pin with `width = 200` so the row
/// around it does not reflow while typing; restyle with any style prop —
/// they all forward to the `TextInput` underneath.
struct FieldProps {
    /// Style props. Plain data — `radius = 4`, `background = paper()`. Each
    /// is re-evaluated by the effect that owns that attribute, so it follows
    /// a theme switch. `-1` / `""` keep the recipe's own value.
    background: string = "",
    color: string = "",
    radius: int = -1,
    padding: int = -1,
    padding_x: int = -1,
    padding_y: int = -1,
    width: int = -1,
    height: int = -1,
    font: int = -1,
    border: int = -1,
    border_color: string = "",
    spacing: int = -1,
    /// Chord that activates this node: `"cmd+s"`, `"ctrl+shift+p"`, or a
    /// sequence like `"g d"`. Every widget takes it — key binding is a prop,
    /// not something a particular widget hard-codes.
    key: string = "",
    /// Name the chord resolves to, so an app can remap it with `remap_key`
    /// without touching the widget. Defaults to `"key.<chord>"`.
    key_action: string = "",
    /// Handler for the chord; omit it and the chord runs `on_click`.
    on_key: fn() = noop,
    on_key__set: bool = false,
    /// true = fires wherever focus is, instead of only on this node.
    key_global: bool = false,
}

fn Field(label: string, value: Signal<string>, placeholder: string,
         p: FieldProps) -> Node {
    return Column(SPACE.Exs) {
        Label(label)
        TextInput(value, placeholder,
                  background = p.background, color = p.color, radius = p.radius,
                  padding = p.padding, padding_x = p.padding_x,
                  padding_y = p.padding_y, width = p.width, height = p.height,
                  font = p.font, border = p.border,
                  border_color = p.border_color, spacing = p.spacing)
    }
}

/// Checkbox: 16px rounded box, 1px accent border, accent fill when checked
/// with a white 16px SVG check.
fn Checkbox(label: string, on: Signal<int>) {
    Box(align_direction = DIRECTION.Row, spacing = SPACE.Exs,
        align_items = ALIGN.Center,
        on_click = fn() => on.set(1 - on.get()),
        a11y_role = "checkbox",
        a11y_label = label,
        cursor = "pointer") {
        let tick = Box(width = 16, height = 16, radius = RAD_SM,
                       border = HAIRLINE,
                       border_color = accent(),
                       align_items = ALIGN.Center, justify = ALIGN.Center) {
            Component(raw_svg(IC_CHECK), width = 16, height = 16,
                      color = on_ink(), visible = on)
        }
        selected_chrome(tick, empty_view(), || { on.get() == 1 },
                        accent(), plate(), "", "")
        Text(label, color = ink(), font = FONT_BODY)
    }
}

fn avatar_dot(size: int) -> int {
    let d = size / 4
    if d < 8 {
        return 8
    }
    if d > 14 {
        return 14
    }
    return d
}

struct AvatarProps {
    src: string = ""
    /// `TINT` for the corner presence pip. `-1` = none.
    status: int = -1
}

/// Avatar: full-round with initials on muted. `size` is the diameter in px
/// (40 is the common one). Pass `src` for a photo; initials remain the fallback
/// while the host loads. `status` is a `TINT` for the corner presence pip
/// (`-1` = none). `User` composes it; `AvatarGroup` stacks several.
fn Avatar(initials: string, size: int, p: AvatarProps) -> Node {
    let host = Box(align_direction = DIRECTION.Row, width = size, height = size,
                   radius = size / 2, background = raised(),
                   align_items = ALIGN.Center, justify = ALIGN.Center)
    ui_push(host.id)
    Text(initials, color = ink(), font = (size + 8) / 4)
    if p.src.len > 0 {
        Image(p.src, width = size, height = size, radius = size / 2,
              position = pos_absolute(), left = 0, top = 0)
    }
    if p.status >= 0 {
        Box(width = avatar_dot(size), height = avatar_dot(size),
            radius = avatar_dot(size) / 2,
            background = tint_of(p.status),
            border = 2, border_color = plate(),
            position = pos_absolute(), right = 0, bottom = 0,
            a11y_role = "status")
    }
    ui_pop()
    return host
}

/// Overlapping row of avatars. Later faces sit on top; each one after the
/// first pulls left by a third of `size`.
fn AvatarGroup(labels: []string, size: int = 32) -> Node {
    let row = Row(0)
    ui_push(row.id)
    let n = labels.len
    for i in 0..n {
        let av = Avatar(labels[i], size)
        if i > 0 {
            marginLeft(av, -(size / 3))
        }
        z_index(av, i + 1)
    }
    ui_pop()
    return row
}

struct UserProps {
    src: string = ""
    status: int = -1
}

/// Avatar + name + role column, the "user card" pattern.
fn User(initials: string, name: string, role: string, p: UserProps) {
    Row(SPACE.Xs) {
        Avatar(initials, 40, src = p.src, status = p.status)
        Column(2) {
            Text(name, color = ink(), font = FONT_BODY)
            Text(role, color = mute(), font = FONT_CAPTION)
        }
    }
}

/// Trend direction for `Stat`'s delta row.
enum TREND {
    Flat = 0,
    Up = 1,
    Down = 2,
}

struct StatProps {
    /// Change caption under the value ("+12%"). Empty = no delta row.
    delta: fn() -> string = empty_text,
    /// `TREND` for the arrow and tint: Up is ok, Down is danger, Flat is
    /// muted with no arrow.
    trend: int = 0,
    /// Series for a trailing sparkline. A signal, so a dashboard can push
    /// points and the line redraws without a rebuild.
    spark: Signal<[]int> = Signal { id: 0 },
    spark__set: bool = false,
}

fn trend_tint(trend: int) -> string {
    match trend {
        TREND.Up => { return ok() }
        TREND.Down => { return danger() }
        _ => { return mute() }
    }
}

/// Sparkline path: `vals` fit to a `w`×`h` box, stroked in `currentColor`
/// so `Icon`-style tinting applies. Flat series draw a midline.
fn spark_markup(vals: []int, w: int, h: int) -> string {
    let n = vals.len
    if n < 2 {
        return ""
    }
    let mut lo = vals[0]
    let mut hi = vals[0]
    for i in 1..n {
        if vals[i] < lo {
            lo = vals[i]
        }
        if vals[i] > hi {
            hi = vals[i]
        }
    }
    let mut span = hi - lo
    if span <= 0 {
        span = 1
    }
    let pad = 2
    let mut d = ""
    for i in 0..n {
        let x = pad + (w - pad * 2) * i / (n - 1)
        let y = pad + (h - pad * 2) * (hi - vals[i]) / span
        if i == 0 {
            d = "M{{x}} {{y}}"
        } else {
            d = "{{d}} L{{x}} {{y}}"
        }
    }
    return "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 {{w}} {{h}}'><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='{{d}}'/></svg>"
}

/// Inline trend line, `w`×`h` dp, stroked in `tint`. The markup is a text
/// thunk over `vals`, so pushing a point repaints only this node.
fn Sparkline(vals: Signal<[]int>, w: int, h: int, tint: string) -> Node {
    let n = Component(raw_svg(""), width = w, height = h, color = tint,
                      text = fn() -> string { return spark_markup(vals.get(), w, h) })
    arena.nodes[n.id].a11y_role = "img"
    arena.nodes[n.id].a11y_label = "sparkline"
    return n
}

/// Stat card: small muted label over a big tinted value. `delta` + `trend`
/// add an arrow-and-caption row; `spark` a sparkline beside the value.
fn Stat(label: fn() -> string, value: fn() -> string, kind: int, p: StatProps) {
    let c = Card() {
        Text(label, color = mute(), font = FONT_CONTROL)
        Row(SPACE.Xs) {
            Text(value, color = tint_of(kind), font = 26)
            if p.spark__set {
                Grow()
                Sparkline(p.spark, 64, 24, trend_tint(p.trend))
            }
        }
        if p.delta().len > 0 {
            let r = Row(2) {
                if p.trend == TREND.Up {
                    Icon(IC_TREND_UP, 14, trend_tint(p.trend))
                }
                if p.trend == TREND.Down {
                    Icon(IC_TREND_DOWN, 14, trend_tint(p.trend))
                }
                Text(p.delta, color = trend_tint(p.trend), font = FONT_CAPTION)
            }
            arena.nodes[r.id].a11y_role = "status"
        }
    }
    grow(c, 1)
}

fn StatCount(label: string, sig: Signal<int>, kind: int) {
    let c = Card() {
        Text(label, color = mute(), font = FONT_CONTROL)
        Text("{{sig.get()}}", color = tint_of(kind), font = 26)
    }
    grow(c, 1)
}

/// Breadcrumb: items separated by chevron icons; last item is foreground.
fn Breadcrumbs(items: []string) {
    Row(6) {
        Each(items, fn(i, s) {
            if i > 0 {
                Icon(IC_CHEV_RIGHT, 14, mute())
            }
            if i == items.len - 1 {
                Text(s, color = ink(), font = FONT_BODY)
            } else {
                Text(s, color = mute(), font = FONT_BODY)
            }
        })
    }
}

/// Step an exclusive-pick signal by `delta` if this row is the one that
/// currently holds it. Clamps at both ends (same as Menu / Select).
fn roving_step(value: Signal<int>, index: int, count: int, delta: int) {
    if value.get() != index {
        return
    }
    let n = value.get() + delta
    if n < 0 {
        return
    }
    if n >= count {
        return
    }
    value.set(n)
}

/// Roving tabindex for one exclusive-pick row: only the selected item is
/// focusable, and it takes focus when it becomes selected so the next
/// arrow lands on it. Menu rows do the same.
fn roving_focus(node: Node, value: Signal<int>, index: int) {
    let node_id = node.id
    effect(|| {
        if value.get() == index {
            arena.nodes[node_id].focusable = 1
            arena.claim_focus(node_id)
        } else {
            arena.nodes[node_id].focusable = 0
        }
    })
}

/// One tab trigger. Active: card background, foreground text. Left / Right
/// move the selection; only the selected tab is a tab stop.
fn Tab(label: string, selected: Signal<int>, index: int, count: int = 0, plain: int = 0) {
    let tab = Box(
        align_direction = DIRECTION.Row,
        align_items = ALIGN.Center,
        spacing = SPACE.Exxs,
        padding_x = 12,
        padding_y = 5,
        radius = RAD_MD,
        on_click = fn() => selected.set(index),
        a11y_role = "tab",
        a11y_label = label,
        cursor = "pointer"
    )
    ui_push(tab.id)
    let text = Text(label, font = FONT_BODY, ellipsis = true)
    ui_pop()
    // `plain` = the tray's sliding indicator carries the fill; the trigger
    // only swaps its label colour.
    if plain != 0 {
        selected_chrome(tab, text, || { selected.get() == index },
                        "", "", ink(), mute())
    } else {
        selected_chrome(tab, text, || { selected.get() == index },
                        plate(), raised(), ink(), mute())
    }
    apply_key(tab, "right", "tab.next", fn() { roving_step(selected, index, count, 1) }, true, false)
    apply_key(tab, "left", "tab.prev", fn() { roving_step(selected, index, count, -1) }, true, false)
    roving_focus(tab, selected, index)
}

/// Tabs: 36px muted tray, rounded, 4px inset, with a card-coloured trigger.
/// The tray sits in a row wrapper so it hugs its triggers instead of
/// stretching to the column width (columns stretch children cross-axis).
/// Tabs: 36px muted tray, rounded, 4px inset, with a card-coloured
/// indicator that slides under the selected trigger. The indicator is an
/// absolute box whose `left` / `width` pins are signals: a selection change
/// `animate`s them (layout tweens the pins, batch 9.4), and the tray's refit
/// hook re-places it instantly after the first layout or a resize, when the
/// triggers' measured geometry moves.
fn Tabs(selected: Signal<int>, labels: []string) {
    Row(0) {
        let tray = Box(
            align_direction = DIRECTION.Row,
            spacing = 2,
            padding = 4,
            background = raised(),
            radius = RAD_LG,
            align_items = ALIGN.Center
        )
        let ind_l = signal(0)
        let ind_w = signal(0)
        let ind_h = signal(0)
        let n = labels.len
        slot(tray, || {
            // First child, so it paints under the triggers.
            let ind = Box(position = pos_absolute(), top = 0,
                          background = plate(), radius = RAD_MD)
            arena.nodes[ind.id].a11y_role = "presentation"
            prop_int(ind, SET.Left, fn() -> int { return ind_l.get() })
            prop_int(ind, SET.Width, fn() -> int { return ind_w.get() })
            prop_int(ind, SET.Height, fn() -> int { return ind_h.get() })
            set_prop_int(ind, SET.Elevation, 1)
            Each(labels, fn(i, lab) {
                Tab(lab, selected, i, n, 1)
            })
        })
        let tid = tray.id
        // Trigger ids: every tray kid after the indicator.
        let mut ids = []int {}
        let kids = arena.nodes[tid].kids
        for i in 1..kids.len {
            push(ids, kids[i])
        }
        // Refit: runs after any layout that changed the tray's width (the
        // first one included), then a second layout applies the pins.
        arena.nodes[tid].list_fn = intern_fn(|| {
            let w = arena.nodes[tid].w
            if w == arena.nodes[tid].list_gen {
                return
            }
            arena.nodes[tid].list_gen = w
            tabs_place(tid, ids, selected, ind_l, ind_w, ind_h, 0)
        })
        effect(|| {
            tabs_place(tid, ids, selected, ind_l, ind_w, ind_h, MOTION.Base)
        })
    }
}

/// Move the `Tabs` indicator to the selected trigger: pins in the tray's
/// content box, tweened over `ms` (0 = jump). Skipped before the first
/// layout, when the triggers have no width yet.
fn tabs_place(tid: int, ids: []int, selected: Signal<int>,
              ind_l: Signal<int>, ind_w: Signal<int>, ind_h: Signal<int>, ms: int) {
    let sel = selected.get()
    if sel < 0 || sel >= ids.len {
        return
    }
    let t = ids[sel]
    if arena.nodes[t].w <= 0 {
        return
    }
    let l = arena.nodes[t].x - arena.content_x(tid)
    if ms > 0 {
        animate(ind_l, l, ms)
        animate(ind_w, arena.nodes[t].w, ms)
    } else {
        ind_l.set(l)
        ind_w.set(arena.nodes[t].w)
    }
    ind_h.set(arena.nodes[t].h)
}

/// One toggle-style choice row inside `Segmented` / `ToggleGroup`.
fn Choice(label: string, value: Signal<int>, index: int, count: int = 0) {
    let row = Box(
        align_direction = DIRECTION.Row,
        align_items = ALIGN.Center,
        spacing = SPACE.Exxs,
        padding_x = 12,
        padding_y = 5,
        radius = RAD_MD,
        on_click = fn() => value.set(index),
        a11y_role = "radio",
        a11y_label = label,
        cursor = "pointer"
    )
    ui_push(row.id)
    let text = Text(label, font = FONT_BODY)
    ui_pop()
    selected_chrome(row, text, || { value.get() == index },
                    plate(), raised(), ink(), mute())
    apply_key(row, "right", "choice.next", fn() { roving_step(value, index, count, 1) }, true, false)
    apply_key(row, "left", "choice.prev", fn() { roving_step(value, index, count, -1) }, true, false)
    roving_focus(row, value, index)
}

/// Exclusive pick from `labels` as a Tabs-style tray. Same chrome as
/// `Tabs`; kept for older callers.
fn Segmented(value: Signal<int>, labels: []string) {
    Row(0) {
        Box(
            align_direction = DIRECTION.Row,
            spacing = 2,
            padding = 4,
            background = raised(),
            radius = RAD_LG,
            align_items = ALIGN.Center
        ) {
            let n = labels.len
            Each(labels, fn(i, lab) {
                Choice(lab, value, i, n)
            })
        }
    }
}


/// One row of a `Select` menu: a check icon on the picked row and a raised fill
/// on the active row (the keyboard highlight).
fn SelectRow(value: Signal<int>, active: Signal<int>, index: int, label: string) {
    let row = Box(
        align_direction = DIRECTION.Row,
        align_items = ALIGN.Center,
        spacing = 4,
        padding_x = 8,
        padding_y = 6,
        radius = RAD_SM,
        on_click = fn() {
            value.set(index)
            active.set(-1)
        },
        a11y_role = "listitem",
        a11y_label = label,
        cursor = "pointer",
        hover_off = false
    )
    ui_push(row.id)
    Text(label, color = ink(), font = FONT_BODY, ellipsis = true)
    Grow()
    let mark = Icon(IC_CHECK, 16, ink())
    show_eq(mark, value, index)
    ui_pop()
    selected_chrome(row, empty_view(), || { active.get() == index },
                    raised(), "", "", "")
}

/// Dropdown. The trigger shows the current label; the menu is an anchored
/// floater (card surface, p-1 viewport, hairline border) that stays beside the
/// trigger and follows it on scroll. Arrows move the highlight, Enter picks,
/// Escape or an outside click closes. `active` (-1 = closed) is the menu's only
/// extra state; the picked value stays in the caller's `value` signal.
fn Select(value: Signal<int>, labels: []string) {
    let active = signal(-1)
    let n = labels.len
    // Outside click closes. Created first so the trigger and menu draw over it.
    let scrim = Overlay(on_click = fn() { active.set(-1) })
    show_ge(scrim, active, 0)
    z_index(scrim, Z_SCRIM)
    let host = Box(align_direction = DIRECTION.Column)
    ui_push(host.id)
    let trigger = Box(
        align_direction = DIRECTION.Row,
        align_items = ALIGN.Center,
        spacing = 4,
        width = SELECT_W,
        padding_x = 12,
        padding_y = 8,
        background = plate(),
        border = HAIRLINE,
        border_color = rule(),
        radius = RAD_MD,
        z_index = Z_FIELD,
        on_click = fn() {
            if active.get() >= 0 {
                active.set(-1)
            } else {
                active.set(0)
            }
        },
        a11y_role = "combobox",
        cursor = "pointer",
        hover_off = false,
        press = true
    )
    ui_push(trigger.id)
    Each(labels, fn(i, lab) {
        let t = Text(lab, color = ink(), font = FONT_BODY, ellipsis = true)
        show_eq(t, value, i)
    })
    Grow()
    Icon(IC_CHEV_DOWN, 16, dim())
    ui_pop()
    let menu = Box(
        align_direction = DIRECTION.Column,
        width = SELECT_W,
        padding = 4,
        spacing = 2,
        background = plate(),
        border = HAIRLINE,
        border_color = rule(),
        radius = RAD_MD,
        position = pos_absolute(),
        z_index = Z_POPUP,
        elevation = 2
    )
    show_ge(menu, active, 0)
    arena.anchor_to(menu.id, trigger.id, PLACE.PlaceBelow, 6)
    enter_fade(menu)
    apply_key(menu, "escape", "select.close", fn() { active.set(-1) }, true, false)
    apply_key(menu, "down", "select.next", fn() {
        if active.get() >= 0 {
            if active.get() + 1 < n {
                active.set(active.get() + 1)
            }
        }
    }, true, false)
    apply_key(menu, "up", "select.prev", fn() {
        if active.get() > 0 {
            active.set(active.get() - 1)
        }
    }, true, false)
    apply_key(menu, "enter", "select.pick", fn() {
        if active.get() >= 0 {
            value.set(active.get())
            active.set(-1)
        }
    }, true, false)
    // The menu holds focus, so the arrows and Enter above reach it.
    let mid = menu.id
    effect(|| {
        if active.get() >= 0 {
            arena.claim_focus(mid)
        }
    })
    ui_push(menu.id)
    Each(labels, fn(i, lab) {
        SelectRow(value, active, i, lab)
    })
    ui_pop()
    ui_pop()
    align_self(host, ALIGN.Start)
}

// --- combobox --------------------------------------------------------------

/// Case-insensitive ASCII substring test, used to filter combobox options.
fn ci_has(hay: string, needle: string) -> bool {
    let hn = hay.len
    let nn = needle.len
    if nn == 0 {
        return true
    }
    if nn > hn {
        return false
    }
    let mut i = 0
    while i + nn <= hn {
        let mut j = 0
        let mut ok = 1
        while j < nn {
            if lower_byte(hay[i + j]) != lower_byte(needle[j]) {
                ok = 0
            }
            j = j + 1
        }
        if ok != 0 {
            return true
        }
        i = i + 1
    }
    return false
}

fn lower_byte(c: int) -> int {
    if c >= 65 {
        if c <= 90 {
            return c + 32
        }
    }
    return c
}

fn combo_filter(options: []string, q: string) -> []string {
    let mut out = []string {}
    let n = options.len
    for i in 0..n {
        if ci_has(options[i], q) {
            push(out, options[i])
        }
    }
    return out
}

struct ComboboxProps {
    placeholder: string = "Search",
    width: int = -1,
    radius: int = -1,
}

/// A text field with a filtered option list below it. Clicking the field (or
/// its chevron), typing, or Down opens the list; an empty query shows every
/// option. Up / Down move the highlight, Enter picks the highlighted option into
/// the field, Escape or an outside click closes. `text` is the one piece of state
/// and belongs to the caller. Options should be unique: the list is keyed by
/// label (`zeus.For`).
fn Combobox(text: Signal<string>, options: []string, p: ComboboxProps) {
    let active = signal(-1)
    let matches = signal([]string {})
    let opts = options
    effect(|| {
        matches.set(combo_filter(opts, text.get()))
    })
    let w = px_or_default(p.width, 240)
    // Outside click closes. Created first so the field and list draw over it.
    let scrim = Overlay(on_click = fn() { active.set(-1) })
    show_ge(scrim, active, 0)
    z_index(scrim, Z_SCRIM)
    let host = Box(align_direction = DIRECTION.Column)
    ui_push(host.id)
    let field = Box(
        align_direction = DIRECTION.Row,
        align_items = ALIGN.Center,
        spacing = 4,
        width = w,
        padding_x = 12,
        padding_y = 8,
        background = plate(),
        border = HAIRLINE,
        border_color = rule(),
        radius = px_or_default(p.radius, RAD_MD),
        z_index = Z_FIELD,
        cursor = "text"
    )
    ui_push(field.id)
    // A focused text field consumes Enter before any keymap chord sees it, so
    // the list keys are handled in `on_key_down` via `current_key()`. The
    // handler is installed after the node exists (it writes back into the field;
    // the local is `fin` because `input` is the input module).
    let fin = Input(bind = text, placeholder = p.placeholder,
                    background = "", color = ink(), font = FONT_BODY,
                    padding = 0, grow = 1, a11y_label = p.placeholder)
    let iid = fin.id
    // Open on click whether the pointer lands on the field frame, the chevron,
    // or the text area itself. The inner input CONSUMES its click — it is
    // focusable, so the engine stops walking up the tree there and a handler on
    // the frame alone never fires for the most obvious target of all. Both
    // nodes get the same handler; it is idempotent, so double delivery is
    // harmless.
    let open_list = fn() {
        arena.claim_focus(iid)
        if active.get() < 0 {
            active.set(0)
        }
    }
    on_click(field, open_list)
    on_click(node_handle(iid), open_list)
    input_clear(text, fin)
    Icon(IC_CHEV_DOWN, 16, dim())
    ui_pop()
    let list = Box(
        align_direction = DIRECTION.Column,
        width = w,
        padding = 4,
        spacing = 2,
        background = plate(),
        border = HAIRLINE,
        border_color = rule(),
        radius = px_or_default(p.radius, RAD_MD),
        position = pos_absolute(),
        z_index = Z_POPUP,
        elevation = 2
    )
    show_ge(list, active, 0)
    arena.anchor_to(list.id, field.id, PLACE.PlaceBelow, 4)
    enter_fade(list)
    let label_id = list.id
    let signal_id = scrim.id
    arena.nodes[iid].kdown_fn = intern_fn(fn() {
        let picked = combo_key(active, matches)
        if picked >= 0 {
            let ms = matches.get()
            if picked < ms.len {
                text.set(ms[picked])
                set_input(node_handle(iid), ms[picked])
            }
            arena.snap_exit(label_id)
            arena.snap_exit(signal_id)
            active.set(-1)
        }
    })
    ui_push(list.id)
    For(matches, fn(s) => s, fn(i, s) {
        ComboRow(text, active, fin, i, s, signal_id)
    })
    ui_pop()
    ui_pop()
    align_self(host, ALIGN.Start)
}

/// Read the pending key and move the combobox highlight. Returns the index to
/// pick, or -1.
fn combo_key(active: Signal<int>, matches: Signal<[]string>) -> int {
    let k = current_key().key
    let n = matches.get().len
    if k == Key.Down {
        if active.get() < 0 {
            active.set(0)
        } else if active.get() + 1 < n {
            active.set(active.get() + 1)
        }
        return -1
    }
    if k == Key.Up {
        if active.get() > 0 {
            active.set(active.get() - 1)
        }
        return -1
    }
    if k == Key.Enter {
        if active.get() >= 0 {
            return active.get()
        }
        return -1
    }
    if k == Key.Escape {
        active.set(-1)
        return -1
    }
    if k == Key.Backspace {
        if n > 0 {
            if active.get() < 0 {
                active.set(0)
            }
        }
        return -1
    }
    if k >= 32 {
        if k < 127 {
            // Typing filters the list; open it on the first character.
            active.set(0)
        }
    }
    return -1
}

/// One option row of a `Combobox`. Picking writes the label into the field.
fn ComboRow(text: Signal<string>, active: Signal<int>, fin: Node, index: int, label: string, scrim: int) {
    let row = Box(
        align_direction = DIRECTION.Row,
        align_items = ALIGN.Center,
        spacing = 4,
        padding_x = 8,
        padding_y = 6,
        radius = RAD_SM,
        a11y_role = "option",
        a11y_label = label,
        cursor = "pointer",
        hover_off = false
    )
    on_click(row, fn() {
        text.set(label)
        set_input(fin, label)
        arena.snap_exit(row.id)
        arena.snap_exit(scrim)
        active.set(-1)
    })
    ui_push(row.id)
    Text(label, color = ink(), font = FONT_BODY)
    ui_pop()
    selected_chrome(row, empty_view(), || { active.get() == index },
                    raised(), "", "", "")
}

/// Radio group: vertical stack of `Radio` rows, 8px apart. The picked row gets a
/// filled primary dot. Arrows move the pick; only the selected row is a tab stop.
fn Radio(label: string, value: Signal<int>, index: int, count: int = 0) {
    let row = Box(align_direction = DIRECTION.Row, spacing = SPACE.Exs,
        align_items = ALIGN.Center,
        on_click = fn() => value.set(index),
        a11y_role = "radio",
        a11y_label = label,
        cursor = "pointer") {
        Box(width = 16, height = 16, radius = 8,
            background = plate(), border = HAIRLINE,
            border_color = accent(),
            align_items = ALIGN.Center, justify = ALIGN.Center) {
            let dot = Box(width = 14, height = 14, radius = 7)
            selected_chrome(dot, empty_view(), || { value.get() == index },
                            accent(), plate(), "", "")
        }
        Text(label, color = ink(), font = FONT_BODY)
    }
    apply_key(row, "down", "radio.next", fn() { roving_step(value, index, count, 1) }, true, false)
    apply_key(row, "up", "radio.prev", fn() { roving_step(value, index, count, -1) }, true, false)
    apply_key(row, "right", "radio.next", fn() { roving_step(value, index, count, 1) }, true, false)
    apply_key(row, "left", "radio.prev", fn() { roving_step(value, index, count, -1) }, true, false)
    roving_focus(row, value, index)
}

/// `RadioGroup(value, labels)`: one circle per option.
fn RadioGroup(value: Signal<int>, labels: []string) {
    let n = labels.len
    Column(SPACE.Exs) {
        Each(labels, fn(i, lab) {
            Radio(lab, value, i, n)
        })
    }
}

/// Toggle: default variant, no border — a pressed state fills muted
/// (accent fill), 36px tall and rounded.
fn Toggle(label: string, on: Signal<int>) {
    let btn = Box(
        align_direction = DIRECTION.Row,
        align_items = ALIGN.Center,
        justify = ALIGN.Center,
        spacing = SPACE.Exxs,
        height = 36,
        padding_x = 12,
        radius = RAD_MD,
        on_click = fn() => on.set(1 - on.get()),
        a11y_role = "button",
        a11y_label = label,
        cursor = "pointer"
    )
    ui_push(btn.id)
    let text = Text(label, font = FONT_BODY)
    ui_pop()
    selected_chrome(btn, text, || { on.get() == 1 },
                    raised(), plate(), ink(), mute())
}

/// Toggle group: a 4px-gap row of single-choice toggles with outline
/// chrome; the pressed state fills muted.
fn ToggleGroup(value: Signal<int>, labels: []string) {
    Row(4) {
        Each(labels, fn(i, lab) {
            let item = Box(
                align_direction = DIRECTION.Row,
                align_items = ALIGN.Center,
                justify = ALIGN.Center,
                height = 36,
                padding_x = 12,
                radius = RAD_MD,
                border = HAIRLINE,
                border_color = rule(),
                on_click = fn() => value.set(i),
                a11y_role = "button",
                a11y_label = lab,
                cursor = "pointer"
            ) {
                Text(lab, color = ink(), font = FONT_BODY)
            }
            let ii = i
            selected_chrome(item, empty_view(), || { value.get() == ii },
                            raised(), plate(), "", "")
        })
    }
}

/// Placeholder surface: rounded, faint accent fill with a left-to-right
/// shimmer band on the frame clock (static under reduced motion). Width /
/// height explicit; wrap in a card to demo.
fn Skeleton(w: int, h: int, radius: int) -> Node {
    let n = Box(width = w, height = h, radius = radius, background = bone())
    arena.nodes[n.id].a11y_role = "progressbar"
    arena.nodes[n.id].a11y_label = "Loading"
    return pulse(n)
}

struct SpinnerProps {
    /// Ring diameter in dp.
    size: int = 16,
    /// Ring color; defaults to `dim()`.
    color: string = "",
    /// Milliseconds per full turn.
    period: int = 900,
    /// Accessible label (role `progressbar`).
    label: string = "Loading",
}

/// Indeterminate loader. The rotation is a paint-only loop track: it never
/// re-runs a component or effect and skips layout, and it keeps a frame live
/// while it is visible. Under reduced motion it settles static.
fn Spinner(p: SpinnerProps) -> Node {
    let n = Icon(IC_LOADER, px_or_default(p.size, 16), str_or_default(p.color, dim()))
    arena.nodes[n.id].a11y_role = "progressbar"
    arena.nodes[n.id].a11y_label = p.label
    return spin(n, px_or_default(p.period, 900))
}

struct EmptyProps {
    /// Icon markup, e.g. `IC_INFO`. Empty for none.
    icon: string = "",
    title: fn() -> string = empty_text,
    body: fn() -> string = empty_text,
    width: int = -1,
    height: int = -1,
    padding: int = -1,
}

/// Centred empty state: optional icon, title, supporting copy, then an action
/// supplied as the trailing block.
fn Empty(p: EmptyProps) -> Node {
    let n = Box(align_direction = DIRECTION.Column,
                align_items = ALIGN.Center,
                justify = ALIGN.Center,
                spacing = SPACE.Xs,
                padding = px_or_default(p.padding, SPACE.Xl),
                width = p.width, height = p.height)
    ui_push(n.id)
    if p.icon.len > 0 {
        Icon(p.icon, 28, dim())
    }
    Text(p.title, color = ink(), font = FONT_TITLE)
    Text(p.body, color = mute(), font = FONT_BODY)
    ui_pop()
    return n
}

/// A single-open accordion. `open` is the *only* state: the open item's index,
/// or `-1` for all closed. Items take the shared signal and their own `index`;
/// no item owns state. Opening one closes the rest by construction — there is
/// one index, so two items can never both match it.
fn Accordion(open: Signal<int>, p: AccordionProps) -> Node {
    let n = Box(align_direction = DIRECTION.Column,
                background = str_or_default(p.background, plate()),
                border = px_or_default(p.border, HAIRLINE),
                border_color = str_or_default(p.border_color, rule()),
                radius = px_or_default(p.radius, RAD_LG),
                width = p.width,
                bind = p.bind, bind__set = p.bind__set) {
                    Each(p.items, (index, item) => {
                        AccordionItem(open = open, index = index, title = item.title, body = item.body)
                    })
                }
    // Clip the rounded corners, so a body cannot spill past the card edge.
    return overflow(n, overflow_hidden())
}

struct AccordionRow {
    title: string,
    body: string,
}

struct AccordionProps {
    width: int = -1,
    radius: int = -1,
    border: int = -1,
    background: string = "",
    border_color: string = "",
    bind: Signal<int> = Signal { id: 0 },
    bind__set: bool = false,
    items: []AccordionRow,
}

struct AccordionItemProps {
    /// The accordion's single open-index signal (`-1` = all closed).
    open: Signal<int> = Signal { id: 0 },
    /// This item's index within its accordion.
    index: int = 0,
    /// Header label.
    title: fn() -> string = empty_text,
    /// Body copy, shown while this item is open.
    body: fn() -> string = empty_text,
    /// Optional leading icon markup.
    icon: string = "",
}

/// One row of an `Accordion`. Reads the shared `open` signal and compares it to
/// `index`, so it holds no state of its own: the chevron rotates on a paint-only
/// track and the body fades in, both driven by the container's one signal.
fn AccordionItem(p: AccordionItemProps) {
    let open = p.open
    let idx = p.index
    let head = Box(align_direction = DIRECTION.Row,
                   align_items = ALIGN.Center,
                   spacing = SPACE.Xs,
                   padding_x = 16,
                   padding_y = 12,
                   on_click = fn() {
                       if open.get() == idx {
                           open.set(-1)
                       } else {
                           open.set(idx)
                       }
                   },
                   a11y_role = "button",
                   a11y_label = p.title(),
                   cursor = "pointer",
                   hover_off = false,
                   press = true)
    ui_push(head.id)
    if p.icon.len > 0 {
        Icon(p.icon, 16, dim())
    }
    Text(p.title, color = ink(), font = FONT_CONTROL, grow = 1)
    let chev = Icon(IC_CHEV_DOWN, 16, dim())
    styled(chev, || {
        if open.get() == idx {
            animate_rotate(chev, 180, MOTION.Fast)
        } else {
            animate_rotate(chev, 0, MOTION.Fast)
        }
    })
    ui_pop()
    let content = Box(align_direction = DIRECTION.Column,
                      padding_x = 16,
                      padding_y = 12)
    // No gap above the body: the header already carries the top inset.
    set_padding_top(content, 0)
    show_eq(content, open, idx)
    enter_fade(content)
    enter_reveal(content)
    ui_push(content.id)
    Text(p.body, color = mute(), font = FONT_BODY, wrap = 1)
    ui_pop()
}

struct CollapsibleProps {
    /// 0 = closed, anything else = open.
    open: Signal<int> = Signal { id: 0 },
    title: fn() -> string = empty_text,
    /// Optional leading icon markup.
    icon: string = "",
    width: int = -1,
    /// Optional surface. Leave both empty for a bare disclosure (no card).
    background: string = "",
    border_color: string = "",
    radius: int = -1,
}

/// One disclosure: a header row that toggles, and a body that fades in while
/// `open`. `open` is a 0/1 signal and the *only* state; the chevron rotation and
/// the body fade are paint-only tracks. Trailing block is the body.
///
/// Self-contained like `Toast`: the header and a hideable body go into a
/// wrapper, and the wrapper's body is what is returned, so the trailing block
/// lands inside the part that hides.
fn Collapsible(p: CollapsibleProps) -> Node {
    let open = p.open
    let mut bw = -1
    if p.border_color.len > 0 {
        bw = HAIRLINE
    }
    let outer = Box(align_direction = DIRECTION.Column,
                    width = p.width,
                    background = p.background,
                    border = bw,
                    border_color = p.border_color,
                    radius = px_or_default(p.radius, RAD_LG))
    ui_push(outer.id)
    let head = Box(align_direction = DIRECTION.Row,
                   align_items = ALIGN.Center,
                   spacing = SPACE.Xs,
                   padding_x = 16,
                   padding_y = 12,
                   on_click = fn() {
                       if open.get() != 0 {
                           open.set(0)
                       } else {
                           open.set(1)
                       }
                   },
                   a11y_role = "button",
                   a11y_label = p.title(),
                   cursor = "pointer",
                   hover_off = false,
                   press = true)
    ui_push(head.id)
    if p.icon.len > 0 {
        Icon(p.icon, 16, dim())
    }
    Text(p.title, color = ink(), font = FONT_CONTROL, grow = 1)
    let chev = Icon(IC_CHEV_DOWN, 16, dim())
    styled(chev, || {
        if open.get() != 0 {
            animate_rotate(chev, 180, MOTION.Fast)
        } else {
            animate_rotate(chev, 0, MOTION.Fast)
        }
    })
    ui_pop()
    let body = Box(align_direction = DIRECTION.Column,
                   padding_x = 16,
                   padding_y = 12)
    // No gap above the body: the header already carries the top inset.
    set_padding_top(body, 0)
    show(body, open)
    enter_fade(body)
    enter_reveal(body)
    ui_pop()
    return body
}

// --- overlays: anchored floaters ------------------------------------------
//
// A floating panel is an out-of-flow node (`position = pos_absolute`, `z_index`)
// anchored to a trigger's screen rect. `arena.anchor_to` records the anchor and
// the layout pass places the node (`place_anchored` in `layout.loam`), flipping
// to the opposite side when the preferred one would leave the safe-area rect.
// The placement matches the trigger's *screen* rect, so a panel nested in a
// scroller follows its trigger without any layout change on scroll.

/// Preferred side for an anchored floater. `flip` (default on) switches to the
/// opposite side when the preferred one overflows.
enum PLACE {
    // Below the trigger (menus, select).
    PlaceBelow = 0,
    // Above the trigger (tooltips, hover cards).
    PlaceAbove = 1,
    // To the trigger's end (inline end on a row).
    PlaceEnd = 2,
    // To the trigger's start.
    PlaceStart = 3,
    // Tooltip placements: above / below the trigger, aligned to its start,
    // centre or end along the cross axis. `PlaceAboveCenter` is what a plain
    // tooltip wants — `PlaceAbove` / `PlaceBelow` keep the old start-aligned
    // behaviour the menus and popovers use.
    PlaceAboveStart = 4,
    PlaceAboveCenter = 5,
    PlaceAboveEnd = 6,
    PlaceBelowStart = 7,
    PlaceBelowCenter = 8,
    PlaceBelowEnd = 9,
}

struct PopoverProps {
    /// 0 = closed, anything else = open.
    open: Signal<int> = Signal { id: 0 },
    /// Preferred side (`PLACE.*`); flips when it would overflow.
    place: int = 0,
    gap: int = 6,
    width: int = -1,
    padding: int = -1,
    radius: int = -1,
    background: string = "",
    border_color: string = "",
    key: string = "escape",
}

/// A floating panel anchored to `trigger`. `open` is a 0/1 signal; outside
/// click and Escape close it. Edge-aware: `place` is preferred, flipped when
/// it would leave the safe-area rect. Trailing block is the panel body.
fn Popover(trigger: Node, p: PopoverProps) -> Node {
    let open = p.open
    // A transparent scrim: outside click closes; children are tried first, so
    // clicks on the panel itself never reach it.
    let scrim = Overlay(visible = open, on_click = fn() { open.set(0) })
    z_index(scrim, Z_SCRIM)
    let panel = Box(align_direction = DIRECTION.Column,
                    position = pos_absolute(),
                    z_index = Z_POPUP,
                    elevation = 3,
                    spacing = SPACE.Xs,
                    background = str_or_default(p.background, plate()),
                    border = HAIRLINE,
                    border_color = str_or_default(p.border_color, rule()),
                    radius = px_or_default(p.radius, RAD_LG),
                    padding = px_or_default(p.padding, SPACE.Sm),
                    width = p.width,
                    visible = open)
    arena.anchor_to(panel.id, trigger.id, p.place, p.gap)
    enter_fade(panel)
    // Escape closes while the panel holds focus; focus arrives when it opens.
    let closer = fn() { open.set(0) }
    apply_key(panel, p.key, "popover.close", closer, true, false)
    let pid = panel.id
    effect(|| {
        if open.get() != 0 {
            arena.claim_focus(pid)
        }
    })
    return panel
}

// --- menu ------------------------------------------------------------------
//
// A dropdown of commands, on the same anchored-floater mechanism as the
// overlays above. Like `Accordion`, the whole menu is ONE signal: `active`,
// the highlighted item's index, where `-1` means closed. Items take that
// signal, their own `index`, and the item `count` (for arrow clamping) — no
// item owns state, and "open" and "highlighted" cannot disagree, because they
// are the same number.
//
// The active row owns the keyboard: it is the one focusable row, binds Up / Down
// to move `active`, and Enter to run its own handler. Every handler is gated on
// `active`, so a hidden row that still holds focus cannot act.

struct MenuProps {
    /// Open at this item index; `-1` is closed. The menu's only state. Pass
    /// one to observe or drive the menu from outside; omitted, the menu owns it.
    active: Signal<int> = Signal { id: 0 },
    active__set: bool = false,
    items: []MenuRow,
    /// Runs with the picked row's index. Rows are plain data; this is the one
    /// callback for the whole menu.
    on_select: fn(int) = noop_int,
    label: string = "",
    /// Preferred side (`PLACE.*`); flips when it would overflow.
    place: int = 0,
    gap: int = 4,
    width: int = -1,
    padding: int = -1,
    radius: int = -1,
    background: string = "",
    border_color: string = "",
    /// Chord that dismisses the open menu.
    key: string = "escape",
}

struct MenuRow {
    label: string = "",
    /// Paint a separator above this row.
    is_separated: bool = false,
    /// Destructive command: painted in the danger ink.
    danger: bool = false,
}

/// A dropdown menu anchored to `trigger`. Clicking the trigger toggles it;
/// outside click and Escape close it; `place` is preferred and flips near the
/// viewport edge. The trailing block is the item list (`MenuItem` /
/// `MenuLabel` / `MenuSeparator`).
fn Menu(trigger: Node, p: MenuProps) -> Node {
    let mut active = p.active
    if !p.active__set {
        active = signal(-1)
    }
    // The trigger owns the toggle; opening lands on the first item.
    on_click(trigger, fn() {
        if active.get() >= 0 {
            active.set(-1)
        } else {
            active.set(0)
        }
    })
    // A transparent scrim: outside click closes. Children are tried first, so a
    // click on the panel or an item never reaches it.
    let scrim = Overlay(on_click = fn() { active.set(-1) })
    show_ge(scrim, active, 0)
    z_index(scrim, Z_SCRIM)
    let panel = Box(align_direction = DIRECTION.Column,
                    position = pos_absolute(),
                    z_index = Z_POPUP,
                    elevation = 3,
                    spacing = 2,
                    background = str_or_default(p.background, plate()),
                    border = HAIRLINE,
                    border_color = str_or_default(p.border_color, rule()),
                    radius = px_or_default(p.radius, RAD_LG),
                    padding = px_or_default(p.padding, 4),
                    width = p.width,
                    cursor = "pointer",
                    a11y_role = "menu") {
                        if p.label.len > 0 {
                            MenuLabel(p.label)
                        }
                        Each(p.items, fn(index, item) {
                            if item.is_separated {
                                MenuSeparator()
                            }
                            MenuItem(active = active, index = index, count = p.items.len,
                                     label = item.label, danger = item.danger,
                                     scrim = scrim.id,
                                     on_click = fn() => p.on_select(index))
                        })
                    }
    show_ge(panel, active, 0)
    arena.anchor_to(panel.id, trigger.id, p.place, p.gap)
    enter_fade(panel)
    // Escape closes while focus is inside the menu: a row, or the panel itself.
    apply_key(panel, p.key, "menu.dismiss", fn() { active.set(-1) }, true, false)
    return panel
}

struct MenuItemProps {
    /// The menu's one signal; the item compares it to `index`.
    active: Signal<int> = Signal { id: 0 },
    active__set: bool = false,
    /// This item's position within its menu.
    index: int = 0,
    /// How many items the menu has, so Up / Down clamp at the ends. Pass the
    /// same number to every item.
    count: int = 0,
    label: fn() -> string = empty_text,
    /// Optional leading icon markup.
    icon: string = "",
    on_click: fn() = noop,
    on_click__set: bool = false,
    disabled: bool = false,
    /// Destructive command: painted in the danger ink.
    danger: bool = false,
    /// The menu scrim. Snapped on pick so its exit track does not keep frames
    /// live after the panel is already gone.
    scrim: int = 0,
}

/// One command row. Highlights while `active == index`; the pointer moves
/// `active` on hover, so pointer and keyboard share one highlight. Owns no
/// state — the menu's `active` is the only signal.
fn MenuItem(p: MenuItemProps) {
    let active = p.active
    let idx = p.index
    let n = p.count
    let off = p.disabled
    let mut row_ink = ink()
    if p.danger {
        row_ink = danger_ink()
    }
    let row = Box(align_direction = DIRECTION.Row,
                  align_items = ALIGN.Center,
                  spacing = SPACE.Xs,
                  padding_x = 10,
                  padding_y = 7,
                  radius = RAD_SM,
                  a11y_role = "menuitem",
                  a11y_label = p.label(),
                  enabled = !off,
                  cursor = "pointer",
                  press = true)
    // Pick runs `on_select` then jumps the exit fade so the panel is gone
    // this frame — a Fast fade left item labels over the heading.
    on_click(row, fn() {
        if !off {
            p.on_click()
            arena.snap_exit(row.id)
            arena.snap_exit(p.scrim)
            active.set(-1)
        }
    })
    ui_push(row.id)
    if p.icon.len > 0 {
        Icon(p.icon, 16, dim())
    }
    Text(p.label, color = row_ink, font = FONT_BODY, grow = 1, ellipsis = true)
    ui_pop()
    selected_chrome(row, empty_view(), || { active.get() == idx },
                    raised(), "", "", "")
    // Hover moves the highlight, so the pointer and the keyboard agree.
    let hs = signal(0)
    hover(row, hs)
    styled(row, || {
        if hs.get() != 0 {
            active.set(idx)
        }
    })
    // Up / Down move the highlight; Enter runs this row. Every handler is gated
    // on `active`, so keys pressed after a close are inert even if this (now
    // hidden) row is still the focused one.
    apply_key(row, "down", "menu.next", fn() {
        if active.get() >= 0 {
            if active.get() + 1 < n {
                active.set(active.get() + 1)
            }
        }
    }, true, false)
    apply_key(row, "up", "menu.prev", fn() {
        if active.get() > 0 {
            active.set(active.get() - 1)
        }
    }, true, false)
    apply_key(row, "enter", "menu.activate", fn() {
        if active.get() == idx {
            if !off {
                p.on_click()
                arena.snap_exit(row.id)
                arena.snap_exit(p.scrim)
                active.set(-1)
            }
        }
    }, true, false)
    // Roving: only the active row can take focus, and it takes it the moment it
    // becomes active. Runs after the key bindings, which make a row focusable.
    let rid = row.id
    effect(|| {
        if active.get() == idx {
            arena.nodes[rid].focusable = 1
            arena.claim_focus(rid)
        } else {
            arena.nodes[rid].focusable = 0
        }
    })
}

/// A non-interactive group heading inside a `Menu`.
fn MenuLabel(text: fn() -> string) {
    Box(padding_x = 10, padding_y = 6) {
        Text(text, color = dim(), font = FONT_CAPTION)
    }
}

/// A hairline between menu groups.
fn MenuSeparator() {
    Box(padding_y = 3) {
        Separator()
    }
}

/// Which window edge a `Drawer` slides from.
enum SIDE {
    // Slide in from the start (left) edge.
    SideStart = 0,
    // Slide in from the end (right) edge.
    SideEnd = 1,
    // Slide down from the top edge.
    SideTop = 2,
    // Slide up from the bottom edge (a sheet).
    SideBottom = 3,
}

struct DrawerProps {
    /// Edge to slide from (`SIDE.*`). The top / bottom edges are the sheet shape.
    side: int = 1,
    /// Panel extent: width for the start / end edges, height for top / bottom.
    size: int = 320,
    /// Radius of the edge that faces the content (the inner edge). `-1` uses
    /// the sheet default (`RAD_XL`), `0` is square. The outer edge stays square
    /// so the panel meets the window edge cleanly.
    radius: int = -1,
    background: string = "",
    border_color: string = "",
    padding: int = -1,
    /// Chord that closes the drawer.
    key: string = "escape",
}

/// An edge panel over a scrim. `open` is a 0/1 signal; the scrim closes it on
/// outside click and Escape closes it while focus is inside. `side` picks the
/// edge and `size` the extent. Like the Dialog, the panel swallows clicks so a
/// press inside does not close it. Trailing block is the panel content.
fn Drawer(open: Signal<int>, p: DrawerProps) -> Node {
    let dim = Overlay(background = scrim(), opacity = 80, visible = open,
                      on_click = fn() { open.set(0) })
    // Pin the panel to the chosen edge of the full-window overlay. The overlay
    // is a centred column by default; the side edges need a row.
    if p.side == SIDE.SideStart {
        arena.nodes[dim.id].dir = 0
        justify(dim, ALIGN.Start)
        align(dim, ALIGN.Stretch)
    } else if p.side == SIDE.SideEnd {
        arena.nodes[dim.id].dir = 0
        justify(dim, ALIGN.End)
        align(dim, ALIGN.Stretch)
    } else if p.side == SIDE.SideTop {
        justify(dim, ALIGN.Start)
        align(dim, ALIGN.Stretch)
    } else {
        justify(dim, ALIGN.End)
        align(dim, ALIGN.Stretch)
    }
    let mut ww = -1
    let mut hh = -1
    if p.side == SIDE.SideStart || p.side == SIDE.SideEnd {
        ww = p.size
    } else {
        hh = p.size
    }
    ui_push(dim.id)
    let panel = Box(align_direction = DIRECTION.Column,
                    width = ww,
                    height = hh,
                    background = str_or_default(p.background, plate()),
                    border = HAIRLINE,
                    border_color = str_or_default(p.border_color, rule()),
                    padding = px_or_default(p.padding, SPACE.Md),
                    spacing = SPACE.Sm,
                    elevation = 4,
                    a11y_role = "dialog",
                    on_click = fn() { return })
    // The sheet shape: only the inner edge rounds, so the panel still meets
    // the window edge square. Per-corner fill is what makes this expressible.
    let corner = px_or_default(p.radius, RAD_XL)
    if corner > 0 {
        if p.side == SIDE.SideBottom {
            radius4(panel, corner, corner, 0, 0)
        } else if p.side == SIDE.SideTop {
            radius4(panel, 0, 0, corner, corner)
        } else if p.side == SIDE.SideStart {
            radius4(panel, 0, corner, corner, 0)
        } else {
            radius4(panel, corner, 0, 0, corner)
        }
    }
    ui_pop()
    enter_fade(panel)
    // Rest off the edge, then slide on. Paint-only: a transform never runs the
    // layout pass, and at boot the track jumps straight to its final value.
    drawer_slide(panel, p.side, p.size, 0)
    let side = p.side
    let size = p.size
    effect(|| {
        if open.get() != 0 {
            drawer_slide(panel, side, 0, MOTION.Base)
        } else {
            drawer_slide(panel, side, size, MOTION.Fast)
        }
    })
    apply_key(panel, p.key, "drawer.close", fn() { open.set(0) }, true, false)
    let pid = panel.id
    effect(|| {
        if open.get() != 0 {
            arena.claim_focus(pid)
        }
    })
    return panel
}

/// Slide `panel` to `to` points along its edge's axis (positive is out).
fn drawer_slide(panel: Node, side: int, to: int, ms: int) {
    if side == SIDE.SideStart {
        animate_x(panel, -to, ms)
    } else if side == SIDE.SideEnd {
        animate_x(panel, to, ms)
    } else if side == SIDE.SideTop {
        animate_y(panel, -to, ms)
    } else {
        animate_y(panel, to, ms)
    }
}

struct TooltipProps {
    text: fn() -> string = empty_text,
    /// Where the bubble sits (`PLACE.*`). The six tooltip placements are
    /// `PlaceAboveStart` / `PlaceAboveCenter` / `PlaceAboveEnd` and the three
    /// `PlaceBelow*` — i.e. top-left, top-centre, top-right, bottom-left,
    /// bottom-centre, bottom-right. `PlaceAbove` / `PlaceBelow` still work and
    /// are start-aligned. Defaults to top-centre, which is what a tooltip is.
    place: int = 5,
    gap: int = 6,
    /// Draw the little caret that points at the trigger. Dropped for the side
    /// placements, which have no edge facing the trigger.
    arrow: bool = true,
    /// Delay before showing, in ms (hover intent).
    delay: int = 400,
}


/// 1 when the bubble is above its trigger (so the caret points down).
fn tooltip_above(place: int) -> bool {
    if place == PLACE.PlaceBelow || place == PLACE.PlaceBelowStart ||
        place == PLACE.PlaceBelowCenter || place == PLACE.PlaceBelowEnd {
        return false
    }
    return true
}

/// A caret only makes sense on an edge that faces the trigger.
fn tooltip_arrow_ok(place: int) -> bool {
    if place == PLACE.PlaceEnd || place == PLACE.PlaceStart {
        return false
    }
    return true
}

/// Slide the caret along the trigger's edge to follow the bubble's alignment.
fn tooltip_justify(place: int) -> int {
    if place == PLACE.PlaceAboveStart || place == PLACE.PlaceBelowStart {
        return ALIGN.Start
    }
    if place == PLACE.PlaceAboveEnd || place == PLACE.PlaceBelowEnd {
        return ALIGN.End
    }
    return ALIGN.Center
}

/// A small non-interactive label shown while the pointer rests on `trigger`.
fn Tooltip(trigger: Node, p: TooltipProps) -> Node {
    let hovered = signal(0)
    hover(trigger, hovered)
    let shown = signal(0)
    let delay = p.delay
    effect(|| {
        if hovered.get() != 0 {
            async.after(delay, fn() {
                if hovered.get() != 0 {
                    shown.set(1)
                }
            })
        } else {
            shown.set(0)
        }
    })
    let panel = Box(align_direction = DIRECTION.Column,
                    position = pos_absolute(),
                    z_index = 70,
                    background = ink(),
                    elevation = 2,
                    padding_x = TOOLTIP_PAD_X,
                    padding_y = TOOLTIP_PAD_Y,
                    radius = RAD_SM,
                    visible = shown,
                    a11y_role = "tooltip",
                    a11y_label = p.text())
    arena.anchor_to(panel.id, trigger.id, p.place, p.gap)
    enter_fade(panel)
    ui_push(panel.id)
    Text(p.text, color = on_ink(), font = FONT_CAPTION)
    if p.arrow {
        if tooltip_arrow_ok(p.place) {
            // A square rotated 45°, straddling the edge that faces the trigger:
            // half of it lies on the panel's own fill (invisible) and half
            // sticks out, which is the shape that reads as a caret rather than
            // as another div. Absolute children are placed against the panel's
            // CONTENT box, so the offset adds the padding back to land the
            // caret's centre exactly on the panel's outer edge.
            let above = tooltip_above(p.place)
            let edge = 0 - (TOOLTIP_PAD_Y + TOOLTIP_ARROW / 2)
            let mut arrow_top = -1
            let mut arrow_bottom = -1
            if above {
                arrow_bottom = edge
            } else {
                arrow_top = edge
            }
            let layer = Box(position = pos_absolute(),
                            left = 0,
                            right = 0,
                            top = arrow_top,
                            bottom = arrow_bottom,
                            height = TOOLTIP_ARROW,
                            align_direction = DIRECTION.Row,
                            justify = tooltip_justify(p.place))
            ui_push(layer.id)
            let caret = Box(width = TOOLTIP_ARROW, height = TOOLTIP_ARROW,
                            background = ink())
            animate_rotate(caret, 45, 0)
            ui_pop()
        }
    }
    ui_pop()
    return panel
}

struct HoverCardProps {
    place: int = 1,
    gap: int = 8,
    /// Delay before showing, in ms. Longer than a tooltip: a hover card is
    /// larger and should not appear under a passing pointer.
    delay: int = 300,
    width: int = 280,
    padding: int = -1,
}

/// A hover-triggered panel, larger and interactive where a `Tooltip` is not.
/// Trailing block is the card body.
fn HoverCard(trigger: Node, p: HoverCardProps) -> Node {
    let hovered = signal(0)
    hover(trigger, hovered)
    let shown = signal(0)
    let delay = p.delay
    effect(|| {
        if hovered.get() != 0 {
            async.after(delay, fn() {
                if hovered.get() != 0 {
                    shown.set(1)
                }
            })
        } else {
            shown.set(0)
        }
    })
    let panel = Box(align_direction = DIRECTION.Column,
                    position = pos_absolute(),
                    z_index = 70,
                    spacing = SPACE.Xs,
                    background = plate(),
                    border = HAIRLINE,
                    border_color = rule(),
                    radius = RAD_LG,
                    padding = px_or_default(p.padding, SPACE.Sm),
                    width = p.width,
                    elevation = 2,
                    visible = shown)
    arena.anchor_to(panel.id, trigger.id, p.place, p.gap)
    enter_fade(panel)
    return panel
}

struct ToastProps {
    /// Auto-dismiss after this many ms.
    ms: int = 3200,
    /// 0 = bottom, 1 = top.
    place: int = 0,
    width: int = -1,
    padding: int = -1,
    radius: int = -1,
    background: string = "",
    color: string = "",
}

/// A transient message pinned to the bottom (or top) of the window. `open` is a
/// 0/1 signal; it dismisses itself after `ms`, or on click. It rises and fades
/// in on open, and sinks and fades out on close. Trailing block is the message.
fn Toast(open: Signal<int>, p: ToastProps) -> Node {
    let ov = Overlay(visible = open, on_click = fn() { open.set(0) })
    if p.place == 1 {
        justify(ov, ALIGN.Start)
        set_padding_top(ov, 24)
    } else {
        justify(ov, ALIGN.End)
        set_padding_bottom(ov, 24)
    }
    ui_push(ov.id)
    let card = Box(align_direction = DIRECTION.Row,
                   align_items = ALIGN.Center,
                   spacing = SPACE.Xs,
                   background = str_or_default(p.background, ink()),
                   padding_x = 16,
                   padding_y = 12,
                   radius = px_or_default(p.radius, RAD_MD),
                   elevation = 2,
                   width = p.width,
                   on_click = fn() { open.set(0) },
                   cursor = "pointer")
    ui_pop()
    enter_fade(card)
    // Rest 12dp low, then rise to 0 while opening (jumps instantly at boot).
    animate_y(card, 12, 0)
    let ms = p.ms
    effect(|| {
        if open.get() != 0 {
            animate_y(card, 0, MOTION.Base)
            async.after(ms, fn() { open.set(0) })
        } else {
            animate_y(card, 12, MOTION.Fast)
        }
    })
    return card
}

/// Named extras for `Dialog` / `AlertDialog`. `title` shares the header
/// row with the close control (Dialog) or stands alone (AlertDialog).
struct DialogProps {
    title: string = "",
}


/// Dialog + AlertDialog chrome. Header is a row: title, then `Grow()`, then
/// a fixed 28px close slot (Dialog only). No `position` / `top` / `left`.
fn dialog_shell(open: Signal<int>, close_x: int, title: string) -> Node {
    let dim = Overlay(
        background = scrim(),
        opacity = 80,
        visible = open,
        on_click = fn() => open.set(0)
    )
    ui_push(dim.id)
    // Responsive: 92% of the window, capped at the desktop 440dp, so a phone
    // keeps a gutter instead of clipping the card.
    let panel = Box(
        align_direction = DIRECTION.Column,
        max_width = DIALOG_W,
        padding = 24,
        spacing = 16,
        background = plate(),
        border = HAIRLINE,
        border_color = rule(),
        radius = RAD_LG,
        elevation = 4,
        a11y_role = "dialog",
        on_click = fn() { return }
    )
    width_pct(panel, 92)
    enter_fade(panel)
    // Scale-in: rest at 96%, grow to 100% while opening; shrink back on
    // close under the exit fade (paint-only, as the scrim's fade).
    animate_scale(panel, DIALOG_REST, 0)
    let pid0 = panel.id
    effect(|| {
        if open.get() != 0 {
            arena.anim_scale(pid0, 100, MOTION.Base)
        } else {
            arena.anim_scale(pid0, DIALOG_REST, MOTION.Fast)
        }
    })
    slot(panel, || {
        Box(
            align_direction = DIRECTION.Row,
            align_items = ALIGN.Center,
            spacing = SPACE.Exs
        ) {
            Title(title)
            Grow()
            if close_x == 1 {
                let close = Box(
                    align_direction = DIRECTION.Row,
                    width = 28,
                    height = 28,
                    shrink = 0,
                    radius = RAD_MD,
                    align_items = ALIGN.Center,
                    justify = ALIGN.Center,
                    on_click = fn() => open.set(0),
                    a11y_role = "button",
                    a11y_label = "Close",
                    cursor = "pointer"
                ) {
                    Icon(IC_X, 16, mute())
                }
                focusable(close)
            }
        }
    })
    ui_pop()
    apply_key(panel, "escape", "dialog.close", fn() { open.set(0) }, true, false)
    focusable(panel)
    let pid = panel.id
    effect(|| {
        if open.get() != 0 {
            arena.claim_trap(pid)
        } else {
            arena.release_trap(pid)
        }
    })
    return panel
}

/// Modal dialog: dim scrim, centered card. Pass `title = "..."` so the
/// heading and close control share one row. Trailing block is the body.
fn Dialog(open: Signal<int>, p: DialogProps) -> Node {
    return dialog_shell(open, 1, p.title)
}

/// AlertDialog: modal confirm with no X. Pass `title = "..."` for the heading.
fn AlertDialog(open: Signal<int>, p: DialogProps) -> Node {
    return dialog_shell(open, 0, p.title)
}

/// Top bar. `dark = 1` (default) includes the appearance switch; pass
/// `dark = 0` to omit it and put Dark in the trailing chrome yourself.
fn Navbar(brand: string, dark: int = 1) {
    Column(0) {
        Box(align_direction = DIRECTION.Row, spacing = SPACE.Md,
            align_items = ALIGN.Center, height = BAR,
            a11y_role = "navigation") {
            Pip(ink(), 10)
            Text(brand, color = ink(), font = FONT_TITLE)
            Grow()
            if dark != 0 {
                Text("Dark", color = mute(), font = FONT_CONTROL)
                Switch(appearance())
            }
        }
        Separator()
    }
}

/// Docs-style nav item: muted text, muted pill when active, 36px tall.
fn NavTab(label: string, page: Signal<int>, index: int) {
    let item = Box(
        align_direction = DIRECTION.Row,
        align_items = ALIGN.Center,
        spacing = SPACE.Exxs,
        padding_x = 12,
        height = 36,
        radius = RAD_MD,
        on_click = fn() => page.set(index),
        a11y_role = "button",
        a11y_label = label,
        cursor = "pointer"
    )
    ui_push(item.id)
    let text = Text(label, font = FONT_BODY, ellipsis = true)
    ui_pop()
    selected_chrome(item, text, || { page.get() == index },
                    raised(), paper(), ink(), mute())
}

/// Header row: muted label cells above a hairline. Cells use zero basis +
/// grow so columns split the row evenly and line up with `TableRow`.
fn TableHead(cols: []string) {
    Column(SPACE.Exs) {
        // Same gutter as `TableRow`, so header and cells share column edges.
        Box(align_direction = DIRECTION.Row, align_items = ALIGN.Center,
            spacing = SPACE.Sm, padding_x = SPACE.Exs) {
            Each(cols, fn(i, t) {
                table_cell(t, 0, ALIGN.Start, mute())
            })
        }
        Separator()
    }
}

/// Is the node about to be built an odd-numbered body row? Counts the
/// current slot parent's `TableRow` kids so far (role `row`), so a header
/// or separator sibling does not shift the stripe.
fn table_row_odd() -> bool {
    let pid = effect_owner()
    if pid <= 0 {
        return false
    }
    let mut n = 0
    let kids = arena.nodes[pid].kids
    let k = kids.len
    for i in 0..k {
        if fmt.eq(arena.nodes[kids[i]].a11y_role, "row") {
            n = n + 1
        }
    }
    return n % 2 == 1
}

/// Shell every body row shares: stripe, hover, click, role `row`.
fn table_row_shell(p: TableRowProps) -> Node {
    let mut fill = ""
    if p.zebra {
        if table_row_odd() {
            fill = raised()
        }
    }
    let mut cursor = ""
    if p.on_click__set {
        cursor = "pointer"
    }
    let row = Box(align_direction = DIRECTION.Row, align_items = ALIGN.Center,
                  spacing = SPACE.Sm, padding_x = SPACE.Exs, padding_y = SPACE.Exs,
                  background = fill, radius = RAD_SM,
                  on_click = p.on_click, on_click__set = p.on_click__set,
                  cursor = cursor, a11y_role = "row")
    if p.hover || p.on_click__set {
        hover_fade(row)
    }
    return row
}

/// A `TableCol.width` as a `Box` width prop: 0 (share the row) is -1 (unset).
fn table_col_width(w: int) -> int {
    if w <= 0 {
        return -1
    }
    return w
}

/// One cell: `width` 0 shares the row, `align` is `ALIGN.*`.
fn table_cell(text: string, width: int, align: int, tint: string) {
    // `width = 0` would pin a zero box; -1 leaves it to grow.
    let cell = Box(align_direction = DIRECTION.Row, justify = align,
                   width = table_col_width(width))
    if width <= 0 {
        set_flex_basis_zero(grow(cell, 1))
    }
    slot(cell, || {
        Text(text, color = tint, font = FONT_BODY, ellipsis = true)
    })
}

/// Body row: cells under a hairline, foreground text. Pair with `TableHead`.
/// `zebra` / `hover` / `on_click` are `TableRowProps`.
fn TableRow(cols: []string, p: TableRowProps) {
    let row = table_row_shell(p)
    slot(row, || {
        Each(cols, fn(i, t) {
            table_cell(t, 0, ALIGN.Start, ink())
        })
    })
    Separator()
}

/// Body row laid out by a `[]TableCol` spec: fixed widths and per-column
/// alignment match the `TableCols` header. `cols` beyond `spec` share the
/// row, start-aligned.
fn TableRowCols(cols: []string, spec: []TableCol, p: TableRowProps) {
    let row = table_row_shell(p)
    slot(row, || {
        Each(cols, fn(i, t) {
            let mut w = 0
            let mut al = ALIGN.Start
            if i < spec.len {
                w = spec[i].width
                al = spec[i].align
            }
            table_cell(t, w, al, ink())
        })
    })
    Separator()
}

/// Column a `TableColsProps.sort` value points at (-1 = unsorted).
fn sort_col(sort: int) -> int {
    if sort > 0 {
        return sort - 1
    }
    if sort < 0 {
        return -sort - 1
    }
    return -1
}

/// true when a `sort` value is descending.
fn sort_desc(sort: int) -> bool {
    return sort < 0
}

/// Byte-wise string order: negative, 0, positive.
fn str_cmp(a: string, b: string) -> int {
    let n = if a.len < b.len { a.len } else { b.len }
    for i in 0..n {
        if a[i] != b[i] {
            return a[i] - b[i]
        }
    }
    return a.len - b.len
}

/// Parse a cell as an integer (optional sign, digits, then anything —
/// "12", "-3", "30 kg" all count; "" and "abc" do not). Returns the value
/// and whether it parsed, so numeric columns sort by value.
struct CellNum {
    ok: bool,
    v: int,
}

fn cell_num(s: string) -> CellNum {
    let mut i = 0
    let mut neg = false
    if s.len > 0 {
        if s[0] == 45 {
            neg = true
            i = 1
        } else if s[0] == 43 {
            i = 1
        }
    }
    let mut v = 0
    let mut digits = 0
    while i < s.len {
        let c = s[i]
        if c < 48 || c > 57 {
            break
        }
        v = v * 10 + (c - 48)
        digits = digits + 1
        i = i + 1
    }
    if digits == 0 {
        return CellNum(ok = false, v = 0)
    }
    if neg {
        v = -v
    }
    return CellNum(ok = true, v = v)
}

/// Order two cells: numerically when both parse, else by bytes.
fn cell_cmp(a: string, b: string) -> int {
    let na = cell_num(a)
    let nb = cell_num(b)
    if na.ok && nb.ok {
        return na.v - nb.v
    }
    return str_cmp(a, b)
}

/// Stable sort of any items by a string key (numeric when the keys are
/// numbers), for a `VirtualTable`'s `Signal<[]T>`:
/// `rows.set(zeus.sort_by(base, fn(j) => j.name, zeus.sort_desc(sort.get())))`.
/// `sort_cells` does the same from a `cells` mapper and a `sort` value.
fn sort_by<T>(items: []T, key: fn(T) -> string, desc: bool) -> []T {
    let mut out = []T {}
    let n = items.len
    for i in 0..n {
        push(out, items[i])
    }
    for i in 1..n {
        let mut j = i
        while j > 0 {
            let a = out[j - 1]
            let b = out[j]
            let mut c = cell_cmp(key(a), key(b))
            if desc {
                c = -c
            }
            if c <= 0 {
                break
            }
            out[j - 1] = b
            out[j] = a
            j = j - 1
        }
    }
    return out
}

/// Items ordered by a `sort` value (`TableColsProps`) over their `cells`:
/// 0 returns them as given; otherwise a stable sort on that column, by
/// value when the cells are numbers. `Table` derives its shown order with
/// this; a `VirtualTable` app calls it in an effect on its sort signal.
fn sort_cells<T>(items: []T, cells: fn(T) -> []string, sort: int) -> []T {
    let col = sort_col(sort)
    if col < 0 {
        let mut out = []T {}
        for i in 0..items.len {
            push(out, items[i])
        }
        return out
    }
    return sort_by(items, fn(t: T) -> string {
        let c = cells(t)
        if col < c.len {
            return c[col]
        }
        return ""
    }, sort_desc(sort))
}

/// Position of the row whose cells key is `k` in the caller's data
/// (-1 when it is gone).
fn table_index_of<T>(rows: Signal<[]T>, cells: fn(T) -> []string, k: string) -> int {
    let xs = rows.get()
    for i in 0..xs.len {
        if fmt.eq(cells_key(cells(xs[i])), k) {
            return i
        }
    }
    return -1
}

/// Cells joined by tabs: `Table`'s row key.
fn cells_key(cells: []string) -> string {
    let mut k = ""
    for i in 0..cells.len {
        if i > 0 {
            k = "{{k}}\t{{cells[i]}}"
        } else {
            k = cells[i]
        }
    }
    return k
}

/// Extras for `Table`.
struct TableProps {
    /// Sort state (see `TableColsProps`); rows reorder when it changes.
    sort: Signal<int> = Signal { id: 0 },
    sort__set: bool = false,
    zebra: bool = false,
    hover: bool = false,
    /// Row click: receives the row's index in the caller's `rows` (not the
    /// sorted order), so `rows.get()[i]` is the item.
    on_pick: fn(int) = noop_int,
    on_pick__set: bool = false,
}

/// Data table: a `TableCols` header over rows from a `Signal<[]T>`, each
/// row's text from `cells(t)` (one string per column). Rows are keyed by
/// their cells, so a sort moves the existing nodes instead of rebuilding
/// them. Pass `sort` and the shown order follows it (`sort_cells`) without
/// touching the caller's data; `zebra` / `hover` / `on_pick` go to every
/// row. A long list wants `VirtualTable` (windowed) instead.
fn Table<T>(spec: []TableCol, rows: Signal<[]T>, cells: fn(T) -> []string,
            p: TableProps) -> Node {
    let host = Column(0)
    arena.nodes[host.id].a11y_role = "table"
    let shown = signal(rows.get())
    let sort = p.sort
    let sort_set = p.sort__set
    effect(|| {
        let mut s = 0
        if sort_set {
            s = sort.get()
        }
        shown.set(sort_cells(rows.get(), cells, s))
    })
    slot(host, || {
        TableCols(spec, sort = p.sort, sort__set = p.sort__set)
        For(shown, fn(t: T) -> string { return cells_key(cells(t)) }, fn(i: int, t: T) {
            // One top-level child per item, so `For` can reorder rows.
            let wrap = Column(0)
            slot(wrap, || {
                if p.on_pick__set {
                    TableRowCols(cells(t), spec, zebra = p.zebra, hover = p.hover,
                                 on_click = fn() {
                                     p.on_pick(table_index_of(rows, cells, cells_key(cells(t))))
                                 })
                } else {
                    TableRowCols(cells(t), spec, zebra = p.zebra, hover = p.hover)
                }
            })
            return
        })
    })
    return host
}

/// Next sort state after clicking column `i`: none → asc → desc → none.
fn sort_cycle(current_value: int, i: int) -> int {
    if current_value == i + 1 {
        return -(i + 1)
    }
    if current_value == -(i + 1) {
        return 0
    }
    return i + 1
}

/// Header from `[]TableCol` (`title` + `width`; 0 = equal share of the row).
/// A `sortable` column is a button that cycles `sort`; the sorted column
/// shows a direction arrow (see `TableColsProps`).
fn TableCols(cols: []TableCol, p: TableColsProps) {
    Column(SPACE.Exs) {
        // Same gutter as the body rows (`padding_x = SPACE.Exs`), so header
        // and cells share the same column boundaries.
        Box(align_direction = DIRECTION.Row, align_items = ALIGN.Center,
            spacing = SPACE.Sm, padding_x = SPACE.Exs) {
            Each(cols, fn(i, c) {
                let sortable = c.sortable && p.sort__set
                let mut cursor = ""
                if sortable {
                    cursor = "pointer"
                }
                let cell = Box(align_direction = DIRECTION.Row, align_items = ALIGN.Center,
                               justify = c.align, spacing = 2,
                               width = table_col_width(c.width), cursor = cursor)
                if c.width <= 0 {
                    set_flex_basis_zero(grow(cell, 1))
                }
                slot(cell, || {
                    Text(c.title, color = mute(), font = FONT_BODY)
                    if sortable {
                        show_eq(Icon(IC_SORT_ASC, 12, ink()), p.sort, i + 1)
                        show_eq(Icon(IC_SORT_DESC, 12, ink()), p.sort, -(i + 1))
                    }
                })
                if sortable {
                    let sig = p.sort
                    arena.nodes[cell.id].click_fn = intern_fn(fn() {
                        sig.set(sort_cycle(sig.get(), i))
                    })
                    arena.nodes[cell.id].focusable = 1
                    arena.nodes[cell.id].a11y_role = "button"
                    arena.nodes[cell.id].a11y_label = "Sort by {{c.title}}"
                    hover_fade(cell)
                }
            })
        }
        Separator()
    }
}

/// One page number for `Pagination`: ghost number; the current page is an
/// outline button. The current page is an effect, not a prop, so the row
/// repaints when `page` moves.
fn PageButton(page: Signal<int>, n: int) {
    let btn = Box(align_direction = DIRECTION.Row,
                  width = 36,
                  height = 36,
                  radius = RAD_MD,
                  align_items = ALIGN.Center,
                  justify = ALIGN.Center,
                  border_color = rule(),
                  on_click = fn() => page.set(n),
                  a11y_role = "button",
                  a11y_label = "{{n}}",
                  cursor = "pointer"
                 )
    ui_push(btn.id)
    let text = Text("{{n}}", font = FONT_BODY)
    ui_pop()
    selected_chrome(btn, text, || { page.get() == n },
                    plate(), paper(), ink(), mute())
    // The outline only exists on the current page.
    styled(btn, || {
        let mut bw = 0
        if page.get() == n {
            bw = HAIRLINE
        }
        arena.nodes[btn.id].border_w = u16(bw)
    })
}


/// Page number shown in `slot` (0-based) of a `PAGE_SLOTS`-wide row, or 0
/// for an ellipsis. Seven or fewer pages list every number; past that the
/// row keeps 1 and `pages` fixed and slides a window around `current_value`
/// (`1 … 4 5 6 … 20`), collapsing the ellipsis at either end.
fn page_at(current_value: int, pages: int, slot: int) -> int {
    if pages <= PAGE_SLOTS {
        return slot + 1
    }
    if slot == 0 {
        return 1
    }
    if slot == PAGE_SLOTS - 1 {
        return pages
    }
    if current_value <= 4 {
        // 1 2 3 4 5 … N
        if slot == PAGE_SLOTS - 2 {
            return 0
        }
        return slot + 1
    }
    if current_value >= pages - 3 {
        // 1 … N-4 N-3 N-2 N-1 N
        if slot == 1 {
            return 0
        }
        return pages - (PAGE_SLOTS - 1 - slot)
    }
    // 1 … c-1 c c+1 … N
    if slot == 1 {
        return 0
    }
    if slot == PAGE_SLOTS - 2 {
        return 0
    }
    return current_value + slot - 3
}

/// One slot of a collapsed `Pagination` row: the number it shows follows
/// `current_value`, so the row never rebuilds; an ellipsis slot is inert.
fn PageSlot(current_value: Signal<int>, pages: int, slot: int) {
    let btn = Box(align_direction = DIRECTION.Row,
                  width = 36,
                  height = 36,
                  radius = RAD_MD,
                  align_items = ALIGN.Center,
                  justify = ALIGN.Center,
                  border_color = rule(),
                  on_click = fn() {
                      let n = page_at(current_value.get(), pages, slot)
                      if n > 0 {
                          current_value.set(n)
                      }
                  },
                  a11y_role = "button",
                  cursor = "pointer"
                 )
    ui_push(btn.id)
    let text = Text(fn() -> string {
        let n = page_at(current_value.get(), pages, slot)
        if n == 0 {
            return "…"
        }
        return "{{n}}"
    }, font = FONT_BODY)
    ui_pop()
    selected_chrome(btn, text, || { page_at(current_value.get(), pages, slot) == current_value.get() },
                    plate(), paper(), ink(), mute())
    styled(btn, || {
        let n = page_at(current_value.get(), pages, slot)
        let mut bw = 0
        if n == current_value.get() {
            bw = HAIRLINE
        }
        arena.nodes[btn.id].border_w = u16(bw)
        if n == 0 {
            arena.nodes[btn.id].a11y_label = "More pages"
            arena.nodes[btn.id].cursor = ""
        } else {
            arena.nodes[btn.id].a11y_label = "{{n}}"
            arena.nodes[btn.id].cursor = "pointer"
        }
    })
}

/// `Pagination(current_value, pages)`: `pages` is the 1-based page count. Past seven
/// pages the row collapses to `1 … c-1 c c+1 … N` (see `page_at`).
fn Pagination(current_value: Signal<int>, pages: int) {
    Row(4) {
        let previous = Box(
            align_direction = DIRECTION.Row,
            width = 36,
            height = 36,
            radius = RAD_MD,
            align_items = ALIGN.Center,
            justify = ALIGN.Center,
            on_click = fn() {
            if current_value.get() > 1 {
                current_value.set(current_value.get() - 1)
            }
        },
            a11y_role = "button",
            a11y_label = "Previous page",
            cursor = "pointer"
        ) {
            Icon(IC_CHEV_LEFT, 16, mute())
        }
        if pages <= PAGE_SLOTS {
            let mut i = 1
            while i <= pages {
                PageButton(current_value, i)
                i = i + 1
            }
        } else {
            for slot in 0..PAGE_SLOTS {
                PageSlot(current_value, pages, slot)
            }
        }
        let next = Box(
            align_direction = DIRECTION.Row,
            width = 36,
            height = 36,
            radius = RAD_MD,
            align_items = ALIGN.Center,
            justify = ALIGN.Center,
            on_click = fn() {
            if current_value.get() < pages {
                current_value.set(current_value.get() + 1)
            }
        },
            a11y_role = "button",
            a11y_label = "Next page",
            cursor = "pointer"
        ) {
            Icon(IC_CHEV_RIGHT, 16, mute())
        }
    }
}

// --- charts ---
// Cartesian charts: muted gridlines, axis labels, a rounded floating tooltip
// per category (hovering any x-column shows it, like the recharts cursor),
// and a bottom legend. Data is flat: `labels` are the x categories, `names`
// the series, and `vals` holds `labels.len * names.len` ints row-major
// (category-major: `vals[i * s + j]` is category `i`, series `j`).


/// Series palette (the default chart colors), from the
/// `chart*` theme tokens so restyling edits the palette, not the charts.
// SVG paints from a string, so an area wash or a line stroke inside one
// needs a literal hex — a role token would land in the markup verbatim.
// Charts therefore build a light and a dark layer and show one (`show_eq`
// on `appearance`), which is why these come in pairs.

/// Light-mode stroke for series `i`.
fn chart_stroke_light(i: int) -> string {
    match i % 5 {
        0 => { return LIGHT.chart1 }
        1 => { return LIGHT.chart2 }
        2 => { return LIGHT.chart3 }
        3 => { return LIGHT.chart4 }
        _ => { return LIGHT.chart5 }
    }
}

/// Dark-mode stroke for series `i`.
fn chart_stroke_dark(i: int) -> string {
    match i % 5 {
        0 => { return DARK.chart1 }
        1 => { return DARK.chart2 }
        2 => { return DARK.chart3 }
        3 => { return DARK.chart4 }
        _ => { return DARK.chart5 }
    }
}

/// Light-mode area wash for series `i`.
fn chart_fl(i: int) -> string {
    match i % 5 {
        0 => { return LIGHT.fill1 }
        1 => { return LIGHT.fill2 }
        2 => { return LIGHT.fill3 }
        3 => { return LIGHT.fill4 }
        _ => { return LIGHT.fill5 }
    }
}

/// Dark-mode area wash for series `i`.
fn chart_fd(i: int) -> string {
    match i % 5 {
        0 => { return DARK.fill1 }
        1 => { return DARK.fill2 }
        2 => { return DARK.fill3 }
        3 => { return DARK.fill4 }
        _ => { return DARK.fill5 }
    }
}

/// Series stroke for series `i`. Series 0 is the first brand color — the
/// old `k == 1` ladder sent series 0 to the `else` arm, so the first series
/// was painted in the *last* color. Returns a role token, so a theme switch
/// repaints the series without rebuilding the chart.
fn chart_color(i: int) -> string {
    match i % 5 {
        0 => { return role_token(ROLE.Chart1) }
        1 => { return role_token(ROLE.Chart2) }
        2 => { return role_token(ROLE.Chart3) }
        3 => { return role_token(ROLE.Chart4) }
        _ => { return role_token(ROLE.Chart5) }
    }
}

/// Area wash per series in the light appearance (theme `fill*` tokens).

/// Area wash per series in the dark appearance.

/// Area wash per series in the current appearance (`primary/20`-style
/// blends of the series strokes).
/// Area wash under series `i`, matched to `chart_color` and indexed the
/// same way.
fn chart_fill(i: int) -> string {
    match i % 5 {
        0 => { return role_token(ROLE.Fill1) }
        1 => { return role_token(ROLE.Fill2) }
        2 => { return role_token(ROLE.Fill3) }
        3 => { return role_token(ROLE.Fill4) }
        _ => { return role_token(ROLE.Fill5) }
    }
}

/// Tooltip border: `border/50` in light, near-`border` in dark.
fn chart_edge() -> string { return role_token(ROLE.ChartEdge) }

fn bytes_s(b: []int, s: string) -> []int {
    let mut out = b
    for i in 0..s.len {
        out.push(s[i])
    }
    return out
}

fn bytes_i(b: []int, v: int) -> []int {
    let mut out = b
    let mut w = v
    if w < 0 {
        out.push(45)
        w = -w
    }
    if w == 0 {
        out.push(48)
        return out
    }
    let mut digits = []int {}
    let mut t = w
    while t > 0 {
        digits.push(48 + t % 10)
        t = t / 10
    }
    let m = digits.len
    for i in 0..m {
        out.push(digits[m - 1 - i])
    }
    return out
}

/// Value at category `i`, series `j` in the row-major flat array.
fn chart_val(vals: []int, s: int, i: int, j: int) -> int {
    return vals[i * s + j]
}

/// Shared y domain over series `0..s`: one axis scales every series.
fn chart_domain(vals: []int, s: int, n: int) -> int {
    let mut hi = 1
    for i in 0..n {
        for j in 0..s {
            let v = chart_val(vals, s, i, j)
            if v > hi {
                hi = v
            }
        }
    }
    return hi
}

fn chart_col_x(gutter: int, col_w: int, i: int) -> int {
    return gutter + i * col_w
}

/// Plot x of category `i` when the series spans the full plot width: the
/// first point sits on the left grid edge and the last on the right edge,
/// so a line/area chart has no half-column dead space at its ends.
/// `col_w * n` is the plot width; the n marks divide it into n-1 spans.
fn chart_pt_x(gutter: int, col_w: int, n: int, i: int) -> int {
    if n <= 1 {
        return gutter + col_w * n / 2
    }
    return gutter + i * (col_w * n) / (n - 1)
}

/// Mark x for category `i`: span mode (pt = 1, line/area charts) uses
/// `chart_pt_x`; column mode (pt = 0, bar charts) keeps the band centers.
fn chart_mx(pt: int, gutter: int, col_w: int, n: int, i: int) -> int {
    if pt != 0 {
        return chart_pt_x(gutter, col_w, n, i)
    }
    return chart_col_x(gutter, col_w, i) + col_w / 2
}

fn chart_y(maxv: int, plot_h: int, top: int, v: int) -> int {
    return top + plot_h - v * plot_h / maxv
}

/// Compose svg markup; `d` is in plot coordinates and the viewBox matches
/// the node size, so coordinates map 1:1.
fn chart_svg(d: string, w: int, h: int, fill: string, stroke: string, sw: int) -> string {
    let mut b = []int {}
    b = bytes_s(b, "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 ")
    b = bytes_i(b, w)
    b = bytes_s(b, " ")
    b = bytes_i(b, h)
    b = bytes_s(b, "'><path fill='")
    b = bytes_s(b, fill)
    b = bytes_s(b, "' stroke='")
    b = bytes_s(b, stroke)
    b = bytes_s(b, "' stroke-width='")
    b = bytes_i(b, sw)
    b = bytes_s(b, "' d='")
    b = bytes_s(b, d)
    b = bytes_s(b, "'/></svg>")
    return string_from_bytes(b)
}

/// Full-size svg node for the plot, layered at 0,0.
fn chart_layer(markup: string, w: int, h: int) -> Node {
    return Svg(markup, width = w, height = h,
               position = pos_absolute(), left = 0, top = 0)
}

/// Polyline for series `j` (straight segments — recharts default linear).
fn chart_line_d(vals: []int, s: int, j: int, maxv: int, gutter: int, col_w: int,
                plot_h: int, top: int, n: int) -> string {
    let mut b = []int {}
    b = bytes_s(b, "M")
    for i in 0..n {
        let x = chart_pt_x(gutter, col_w, n, i)
        let y = chart_y(maxv, plot_h, top, chart_val(vals, s, i, j))
        b = bytes_i(b, x)
        b = bytes_s(b, " ")
        b = bytes_i(b, y)
        if i + 1 < n {
            b = bytes_s(b, "L")
        }
    }
    return string_from_bytes(b)
}

/// Closed polygon under series `j`: the line plus the baseline (area fill).
fn chart_area_d(vals: []int, s: int, j: int, maxv: int, gutter: int, col_w: int,
                plot_h: int, top: int, n: int) -> string {
    let base = top + plot_h
    let first_x = chart_pt_x(gutter, col_w, n, 0)
    let last_x = chart_pt_x(gutter, col_w, n, n - 1)
    let mut b = []int {}
    b = bytes_s(b, "M")
    for i in 0..n {
        let x = chart_pt_x(gutter, col_w, n, i)
        let y = chart_y(maxv, plot_h, top, chart_val(vals, s, i, j))
        b = bytes_i(b, x)
        b = bytes_s(b, " ")
        b = bytes_i(b, y)
        b = bytes_s(b, "L")
    }
    b = bytes_i(b, last_x)
    b = bytes_s(b, " ")
    b = bytes_i(b, base)
    b = bytes_s(b, "L")
    b = bytes_i(b, first_x)
    b = bytes_s(b, " ")
    b = bytes_i(b, base)
    b = bytes_s(b, "Z")
    return string_from_bytes(b)
}

/// Gridlines + y tick labels + baseline. Call with the plot pushed.
fn chart_axes(w: int, h: int, maxv: int) {
    let plot_h = h - CHART_TOP - CHART_XLAB
    let base_y = CHART_TOP + plot_h
    // Gridlines above the baseline (top = max value).
    for k in 0..4 {
        let line = Box(width = w - CHART_GUTTER, height = 1,
                       background = rule(), opacity = 45,
                       position = pos_absolute(),
                       left = CHART_GUTTER,
                       top = CHART_TOP + k * plot_h / 4)
    }
    // Y tick labels, max .. 0 (bottom 0 sits above the baseline).
    for k in 0..5 {
        let tv = maxv - k * maxv / 4
        let lab = Box(align_direction = DIRECTION.Row, justify = ALIGN.End,
                      width = CHART_GUTTER - 6, height = 12,
                      position = pos_absolute(),
                      left = 0,
                      top = CHART_TOP + k * plot_h / 4 - 6) {
            Text("{{tv}}", color = mute(), font = FONT_CAPTION)
        }
    }
    // Baseline axis.
    let axis = Box(width = w - CHART_GUTTER, height = 1, background = hard(),
                   position = pos_absolute(),
                   left = CHART_GUTTER,
                   top = base_y)
}

/// One floating tooltip panel shared by every category: its content and
/// position track the hovered column (`act` = category + 1, 0 = none)
/// through an effect, instead of one pre-built panel per category. Style
/// props are plain data, so a prop that must follow a signal gets `styled`.
fn chart_tooltip(labels: []string, names: []string, vals: []int, s: int, n: int,
                 w: int, col_w: int, act: Signal<int>, pt: int) {
    let panel = Box(
        align_direction = DIRECTION.Column,
        width = 128,
        spacing = 4,
        padding_x = 10,
        padding_y = 6,
        background = plate(),
        border = HAIRLINE,
        border_color = chart_edge(),
        radius = RAD_LG,
        position = pos_absolute(),
        top = 0,
        z_index = 8,
        on_click = fn() { return },
        a11y_role = "dialog",
        visible = act
    )
    enter_fade(panel)
    // Slide to the hovered mark; -1 (no pin) while `act` is 0, when the
    // panel is hidden anyway.
    styled(panel, || {
        let a = act.get() - 1
        let mut x = -1
        if a >= 0 {
            if a < n {
                x = chart_mx(pt, CHART_GUTTER, col_w, n, a) - 64
                if x < CHART_GUTTER {
                    x = CHART_GUTTER
                }
                let max_l = w - 128 - CHART_GUTTER
                if x > max_l {
                    x = max_l
                }
            }
        }
        arena.nodes[panel.id].pin_l = x
    })
    slot(panel, || {
        Text(fn() -> string {
            let a = act.get() - 1
            if a >= 0 {
                if a < n {
                    return labels[a]
                }
            }
            return ""
        }, color = ink(), font = FONT_CAPTION)
        for j in 0..s {
            let jj = j
            Row(SPACE.Exs) {
                Box(width = 8, height = 8, radius = 2, background = chart_color(jj))
                Text(names[jj], color = mute(), font = FONT_CAPTION)
                Grow()
                Text(fn() -> string {
                    let a = act.get() - 1
                    if a >= 0 {
                        if a < n {
                            return "{{vals[a * s + jj]}}"
                        }
                    }
                    return ""
                }, color = ink(), font = FONT_CAPTION)
            }
        }
    })
}

/// Transparent hover zone for a category. Hovering it flips its own
/// signal; a watch effect folds that into the shared `act`. Span mode
/// gives each mark a contiguous catch strip from the midpoint of the
/// previous mark to the midpoint of the next (the ends reach the plot
/// edges), so the pointer always lands on the nearest mark; column mode
/// keeps the full-band coverage of the bar columns.
fn chart_zone(i: int, hov: Signal<int>, act: Signal<int>, h: int, col_w: int, pt: int,
              n: int) {
    let mut zl = 0
    let mut zw = col_w
    if pt != 0 {
        // Span mode: Voronoi strip around mark `i`.
        if n <= 1 {
            zl = CHART_GUTTER
            zw = col_w * n
        } else {
            if i == 0 {
                zl = CHART_GUTTER
            } else {
                zl = (chart_pt_x(CHART_GUTTER, col_w, n, i - 1) + chart_pt_x(CHART_GUTTER, col_w, n, i)) / 2
            }
            if i == n - 1 {
                zw = CHART_GUTTER + col_w * n - zl
            } else {
                let zr = (chart_pt_x(CHART_GUTTER, col_w, n, i) + chart_pt_x(CHART_GUTTER, col_w, n, i + 1)) / 2
                zw = zr - zl
            }
        }
    } else {
        zl = chart_col_x(CHART_GUTTER, col_w, i)
    }
    let zone = Box(width = zw, height = h,
                   position = pos_absolute(),
                   left = zl,
                   top = 0)
    hover(zone, hov)
    styled(zone, || {
        if hov.get() > 0 {
            act.set(i + 1)
        } else {
            if act.get() == i + 1 {
                act.set(0)
            }
        }
    })
}

/// X category label under the plot, rotated 45° clockwise around its top-left.
/// Rotated labels are parallel diagonal strips, so they never collide with
/// each other however narrow the plot gets; CHART_XLAB reserves their room.
fn chart_xlab(label: string, i: int, col_w: int, plot_h: int, pt: int, n: int) {
    // 8px of air below the baseline axis: the rotated strip starts below the
    // line, not on it (the pivot corner is the strip's top edge). Span mode
    // labels sit just left of their mark so the strip stays inside the plot.
    let x = if pt != 0 { chart_pt_x(CHART_GUTTER, col_w, n, i) - 4 } else { chart_col_x(CHART_GUTTER, col_w, i) + 3 }
    let lab = Text(label, color = mute(), font = FONT_CAPTION,
                   position = pos_absolute(),
                   left = x,
                   top = CHART_TOP + plot_h + 8)
    text_rot(lab, 45)
}

/// Bottom-centered legend, 16px between entries.
fn chart_legend(names: []string) {
    Box(align_direction = DIRECTION.Row, spacing = 16,
        justify = ALIGN.Center, wrap = 1) {
        Each(names, fn(j, name) {
            Row(SPACE.Exxs) {
                Box(width = 8, height = 8, radius = 2, background = chart_color(j))
                Text(name, color = mute(), font = FONT_CAPTION)
            }
        })
    }
}

/// Hover cursor: a single hairline through the hovered mark (no wash band).
/// `act` = category + 1; the line shows and slides with it.
fn chart_cursor(act: Signal<int>, n: int, col_w: int, plot_h: int, pt: int) {
    let line = Box(width = 1, height = plot_h, background = hard(),
                   opacity = 55, radius = 0, a11y_label = "cursor",
                   position = pos_absolute(),
                   top = CHART_TOP)
    styled(line, || {
        let a = act.get() - 1
        let mut x = -1
        if a >= 0 {
            if a < n {
                x = chart_mx(pt, CHART_GUTTER, col_w, n, a)
            }
        }
        arena.nodes[line.id].pin_l = x
    })
    show(line, act)
}

/// Hover zones + the shared cursor + the single following tooltip; call with
/// the plot pushed. `act` is created by the chart builder so the marks can
/// dim for the hovered column. `pt` = 1 for plot-spanning line/area charts
/// (zone strips snap to the nearest mark), 0 for column-mode bar charts.
fn chart_tooltips(labels: []string, names: []string, vals: []int, s: int, n: int,
                  h: int, w: int, col_w: int, act: Signal<int>, pt: int) {
    for i in 0..n {
        let hov = signal(0)
        chart_zone(i, hov, act, h, col_w, pt, n)
    }
    chart_cursor(act, n, col_w, h - CHART_TOP - CHART_XLAB, pt)
    chart_tooltip(labels, names, vals, s, n, w, col_w, act, pt)
}

/// Dim/restore a mark for the hovered column: full at rest or on its own
/// column, faded while another column is hovered.
fn chart_dim(act: Signal<int>, i: int) -> int {
    let a = act.get()
    if a == 0 {
        return 100
    }
    if a == i + 1 {
        return 100
    }
    return 40
}

/// Resolve the plot width: a measured host width wins (the host stretches
/// with its parent, so the chart re-fits on window resize); before the first
/// layout the caller's estimate is used.
fn chart_w(w: int, host: Node) -> int {
    let mw = measured_width(host)
    if mw > CHART_GUTTER + 8 {
        return mw
    }
    return w
}

/// Grouped bar chart. One shared y domain.
/// The plot re-fits the container: pass the intended width, and the chart
/// re-lays out whenever its card measures a different width.
fn BarChart(labels: []string, names: []string, vals: []int, w: int, h: int) {
    let n = labels.len
    let s = names.len
    if n == 0 {
        return
    }
    if s == 0 {
        return
    }
    let host = Column(SPACE.Exs)
    let node_id = host.id
    refit(host, fn() {
        chart_bars(labels, names, vals, n, s, w, h, host)
    })
    // Render immediately with the requested width; the next layout refits.
    slot(node_handle(node_id), || {
        chart_bars(labels, names, vals, n, s, w, h, host)
    })
}

fn chart_bars(labels: []string, names: []string, vals: []int, n: int, s: int,
              w: int, h: int, host: Node) {
    let gw = chart_w(w, host)
    let plot_h = h - CHART_TOP - CHART_XLAB
    let col_w = (gw - CHART_GUTTER) / n
    let domain = chart_domain(vals, s, n)
    let base_y = CHART_TOP + plot_h
    let bar_w = (col_w - 10) / s
    // Shared hovered mark: zones, cursor, tooltip, and the marks read it.
    let act = signal(0)
    let plot = Box(width = gw, height = h)
    slot(plot, || {
        chart_axes(gw, h, domain)
        for i in 0..n {
            let x0 = chart_col_x(CHART_GUTTER, col_w, i) + 5
            let ii = i
            for j in 0..s {
                let v = chart_val(vals, s, i, j)
                let bh = geometry.max2(v * plot_h / domain, 1)
                if v > 0 {
                    let bar = Box(width = bar_w, height = bh, radius = 3,
                                  background = chart_color(j),
                                  position = pos_absolute(),
                                  left = x0 + j * bar_w,
                                  top = base_y - bh)
                    styled(bar, || { opacity(bar, chart_dim(act, ii)) })
                }
            }
            chart_xlab(labels[i], i, col_w, plot_h, 0, n)
        }
        chart_tooltips(labels, names, vals, s, n, h, gw, col_w, act, 0)
    })
    chart_legend(names)
}

/// Straight-segment line chart with dots.
fn LineChart(labels: []string, names: []string, vals: []int, w: int, h: int) {
    let n = labels.len
    let s = names.len
    if n == 0 {
        return
    }
    if s == 0 {
        return
    }
    let host = Column(SPACE.Exs)
    let node_id = host.id
    refit(host, fn() {
        chart_lines(labels, names, vals, n, s, w, h, host)
    })
    slot(node_handle(node_id), || {
        chart_lines(labels, names, vals, n, s, w, h, host)
    })
}

fn chart_lines(labels: []string, names: []string, vals: []int, n: int, s: int,
               w: int, h: int, host: Node) {
    let gw = chart_w(w, host)
    let plot_h = h - CHART_TOP - CHART_XLAB
    let col_w = (gw - CHART_GUTTER) / n
    let domain = chart_domain(vals, s, n)
    // Shared hovered mark: zones, cursor, tooltip, and the marks read it.
    let act = signal(0)
    let plot = Box(width = gw, height = h)
    slot(plot, || {
        chart_axes(gw, h, domain)
        for j in 0..s {
            let d = chart_line_d(vals, s, j, domain, CHART_GUTTER, col_w, plot_h,
                                 CHART_TOP, n)
            let line_l = chart_layer(chart_svg(d, gw, h, "none", chart_stroke_light(j), 2), gw, h)
            let line_d = chart_layer(chart_svg(d, gw, h, "none", chart_stroke_dark(j), 2), gw, h)
            show_eq(line_l, appearance(), 0)
            show_eq(line_d, appearance(), 1)
            for i in 0..n {
                let x = chart_pt_x(CHART_GUTTER, col_w, n, i)
                let y = chart_y(domain, plot_h, CHART_TOP, chart_val(vals, s, i, j))
                let dot = Box(width = 6, height = 6, radius = 3,
                              background = chart_color(j),
                              position = pos_absolute(),
                              left = x - 3,
                              top = y - 3)
            }
        }
        for i in 0..n {
            chart_xlab(labels[i], i, col_w, plot_h, 1, n)
        }
        chart_tooltips(labels, names, vals, s, n, h, gw, col_w, act, 1)
    })
    chart_legend(names)
}

/// Area chart: tinted fill under the line (fill follows appearance).
fn AreaChart(labels: []string, names: []string, vals: []int, w: int, h: int) {
    let n = labels.len
    let s = names.len
    if n == 0 {
        return
    }
    if s == 0 {
        return
    }
    let host = Column(SPACE.Exs)
    let node_id = host.id
    refit(host, fn() {
        chart_areas(labels, names, vals, n, s, w, h, host)
    })
    slot(node_handle(node_id), || {
        chart_areas(labels, names, vals, n, s, w, h, host)
    })
}

fn chart_areas(labels: []string, names: []string, vals: []int, n: int, s: int,
               w: int, h: int, host: Node) {
    let gw = chart_w(w, host)
    let plot_h = h - CHART_TOP - CHART_XLAB
    let col_w = (gw - CHART_GUTTER) / n
    let domain = chart_domain(vals, s, n)
    // Shared hovered mark: zones, cursor, tooltip, and the marks read it.
    let act = signal(0)
    let plot = Box(width = gw, height = h)
    slot(plot, || {
        chart_axes(gw, h, domain)
        for j in 0..s {
            let d = chart_area_d(vals, s, j, domain, CHART_GUTTER, col_w, plot_h,
                                 CHART_TOP, n)
            let fd = chart_svg(d, gw, h, chart_fd(j), "none", 0)
            let fl = chart_svg(d, gw, h, chart_fl(j), "none", 0)
            let area_l = chart_layer(fl, gw, h)
            let area_d = chart_layer(fd, gw, h)
            show_eq(area_l, appearance(), 0)
            show_eq(area_d, appearance(), 1)
            let dl = chart_line_d(vals, s, j, domain, CHART_GUTTER, col_w, plot_h,
                                  CHART_TOP, n)
            let line_l = chart_layer(chart_svg(dl, gw, h, "none", chart_stroke_light(j), 2), gw, h)
            let line_d = chart_layer(chart_svg(dl, gw, h, "none", chart_stroke_dark(j), 2), gw, h)
            show_eq(line_l, appearance(), 0)
            show_eq(line_d, appearance(), 1)
            for i in 0..n {
                let x = chart_pt_x(CHART_GUTTER, col_w, n, i)
                let y = chart_y(domain, plot_h, CHART_TOP, chart_val(vals, s, i, j))
                let dot = Box(width = 6, height = 6, radius = 3,
                              background = chart_color(j),
                              position = pos_absolute(),
                              left = x - 3,
                              top = y - 3)
                let ii = i
                styled(dot, || { opacity(dot, chart_dim(act, ii)) })
            }
        }
        for i in 0..n {
            chart_xlab(labels[i], i, col_w, plot_h, 1, n)
        }
        chart_tooltips(labels, names, vals, s, n, h, gw, col_w, act, 1)
    })
    chart_legend(names)
}

// --- calendar internals ---

fn cal_leap(year: int) -> int {
    if year % 4 != 0 {
        return 0
    }
    if year % 100 != 0 {
        return 1
    }
    if year % 400 == 0 {
        return 1
    }
    return 0
}

fn cal_len(year: int, month: int) -> int {
    if month == 2 {
        if cal_leap(year) != 0 {
            return 29
        }
        return 28
    }
    if month == 4 {
        return 30
    }
    if month == 6 {
        return 30
    }
    if month == 9 {
        return 30
    }
    if month == 11 {
        return 30
    }
    return 31
}

fn cal_month_t(month: int) -> int {
    if month == 1 { return 0 }
    if month == 2 { return 3 }
    if month == 3 { return 2 }
    if month == 4 { return 5 }
    if month == 5 { return 0 }
    if month == 6 { return 3 }
    if month == 7 { return 5 }
    if month == 8 { return 1 }
    if month == 9 { return 4 }
    if month == 10 { return 6 }
    if month == 11 { return 2 }
    return 4
}

fn cal_first_monday(year: int, month: int) -> int {
    let mut y = year
    if month < 3 {
        y = y - 1
    }
    let s = y + y / 4 - y / 100 + y / 400 + cal_month_t(month) + 1
    let sun = s % 7
    return (sun + 6) % 7
}

/// Ghost icon step button for the month/year rails.
fn CalStep(markup: string, label: string, press: fn()) {
    Box(align_direction = DIRECTION.Row,
        width = 28,
        height = 28,
        radius = RAD_MD,
        align_items = ALIGN.Center,
        justify = ALIGN.Center,
        on_click = press,
        a11y_role = "button",
        a11y_label = label,
        hover_off = true,
        cursor = "pointer"
       ) {
        Icon(markup, 16, mute())
    }
}

fn CalWeekday(s: string) {
    Box(align_direction = DIRECTION.Row, width = CAL_CELL, height = 24,
        align_items = ALIGN.Center, justify = ALIGN.Center) {
        Text(s, color = dim(), font = FONT_CAPTION)
    }
}

fn CalWeekRow() {
    let n = Grid(config = GridConfig(columns = 7, gap = 4))
    slot(n, || {
        CalWeekday("Mo")
        CalWeekday("Tu")
        CalWeekday("We")
        CalWeekday("Th")
        CalWeekday("Fr")
        CalWeekday("Sa")
        CalWeekday("Su")
    })
}

fn cal_month_name(m: int) -> string {
    match m {
        1 => { return "January" }
        2 => { return "February" }
        3 => { return "March" }
        4 => { return "April" }
        5 => { return "May" }
        6 => { return "June" }
        7 => { return "July" }
        8 => { return "August" }
        9 => { return "September" }
        10 => { return "October" }
        11 => { return "November" }
        _ => { return "December" }
    }
}

/// Day number for grid cell `idx` (0-based) in the month `m` of `year`,
/// or 0 for a leading/trailing blank. Cells stay fixed; the value is
/// recomputed from the live y/m signals, so flipping month or year only
/// re-runs the cell prop thunks — no rebuild, no 12 pre-built grids.
fn cal_day_at(year: int, m: int, idx: int) -> int {
    let day = idx - cal_first_monday(year, m) + 1
    if day < 1 {
        return 0
    }
    if day > cal_len(year, m) {
        return 0
    }
    return day
}

fn CalCell(y: Signal<int>, m: Signal<int>, d: Signal<int>, open: Signal<int>, idx: int) {
    let cell = Box(
        align_direction = DIRECTION.Row,
        width = CAL_CELL,
        height = CAL_CELL,
        radius = RAD_LG,
        align_items = ALIGN.Center,
        justify = ALIGN.Center,
        on_click = fn() {
        let day = cal_day_at(y.get(), m.get(), idx)
        if day > 0 {
            d.set(day)
            open.set(0)
        }
    },
        a11y_role = "button",
        padding_x = 2,
        cursor = "pointer"
    )
    // Fill, label and text colour all track the y / m / d signals, so they
    // are effects rather than plain props. `""` never clears a fill (hex -1
    // is skipped), so the deselected state repaints the panel surface —
    // otherwise the last picked day keeps its accent after the selection
    // moves.
    // Build the label inside the cell so it is parented once — `Component`
    // attaches to the current `slot` parent, so creating it outside and then
    // calling `child` would add it twice.
    ui_push(cell.id)
    let label = Text(fn() -> string {
        let day = cal_day_at(y.get(), m.get(), idx)
        if day > 0 {
            return "{{day}}"
        }
        return ""
    }, font = FONT_BODY)
    ui_pop()
    styled(cell, || {
        let day = cal_day_at(y.get(), m.get(), idx)
        let picked = day > 0 && d.get() == day
        match picked {
            true => {
                set_background(cell, parse_hex_color(accent()))
                set_color(label, parse_hex_color(on_ink()))
            }
            _ => {
                set_background(cell, parse_hex_color(plate()))
                set_color(label, parse_hex_color(ink()))
            }
        }
        match day {
            0 => { arena.nodes[cell.id].a11y_label = "" }
            _ => { arena.nodes[cell.id].a11y_label = "{{day}}" }
        }
    })
}

/// One 7×6 grid for whichever month `m` names: 42 fixed cells whose content
/// tracks `y`/`m`/`d` through prop thunks. Built once, no per-month subtrees.
fn CalGrid(y: Signal<int>, m: Signal<int>, d: Signal<int>, open: Signal<int>) {
    let n = Grid(config = GridConfig(columns = 7, gap = 3))
    slot(n, || {
        for i in 0..42 {
            CalCell(y, m, d, open, i)
        }
    })
}

/// Calendar picker: label, input-like trigger with a calendar icon, and a
/// floating sheet (kind-9 so the page scroller cannot clip it). Month and
/// year rails step with chevron icons; picking a day closes the sheet.
fn DatePicker(y: Signal<int>, m: Signal<int>, d: Signal<int>) {
    let open = signal(0)
    // Invisible full-window scrim: the first click that misses the popover
    // closes it. It is created before the anchor, so the calendar panel (a
    // z-indexed floater) hit-tests above it; the panel itself swallows clicks.
    let scrim = Overlay(
        background = "",
        visible = open,
        on_click = fn() => open.set(0)
    )
    // Floaters hit-test in z order, not tree order (batch 17): the scrim
    // takes the Z_SCRIM tier and the sheet Z_POPUP, as Select / Menu do.
    z_index(scrim, Z_SCRIM)
    let anchor = Column(SPACE.Exs) {
        Label("Date")
        Box(
            align_direction = DIRECTION.Row,
            spacing = 4,
            width = 200,
            align_items = ALIGN.Center,
            background = plate(),
            border = HAIRLINE,
            border_color = rule(),
            radius = RAD_MD,
            padding_x = 12,
            padding_y = 8,
            on_click = fn() => open.set(1 - open.get()),
            a11y_role = "button",
            a11y_label = "Pick a date",
            cursor = "pointer"
        ) {
            Icon(IC_CALENDAR, 16, mute())
            Text("{{y.get()}}", color = ink(), font = FONT_BODY)
            Text("-", color = mute(), font = FONT_BODY)
            Text("{{m.get()}}", color = ink(), font = FONT_BODY)
            Text("-", color = mute(), font = FONT_BODY)
            Text("{{d.get()}}", color = ink(), font = FONT_BODY)
        }
    }
    slot(anchor, || {
        let panel = Box(
            align_direction = DIRECTION.Column,
            width = 320,
            padding = 12,
            spacing = SPACE.Exs,
            background = plate(),
            border = HAIRLINE,
            border_color = rule(),
            radius = RAD_LG,
            position = pos_absolute(),
            top = 68,
            left = 0,
            z_index = Z_POPUP,
            a11y_role = "dialog",
            on_click = fn() { return },
            visible = open
        )
        slot(panel, || {
            Row(4) {
                CalStep(IC_CHEV_LEFT, "Previous month", fn() {
                    if m.get() <= 1 {
                        m.set(12)
                    } else {
                        m.set(m.get() - 1)
                    }
                })
                // One text node whose label tracks `m`; the rails are its only
                // writers, so no pre-built name stack is needed. Centered between
                // the month steps so long and short names do not jump the arrows.
                Box(align_direction = DIRECTION.Row,
                    justify = ALIGN.Center,
                    align_items = ALIGN.Center,
                    grow = 1) {
                    Text(fn() -> string {
                        return cal_month_name(m.get())
                    }, color = ink(), font = FONT_BODY)
                }
                CalStep(IC_CHEV_RIGHT, "Next month", fn() {
                    if m.get() >= 12 {
                        m.set(1)
                    } else {
                        m.set(m.get() + 1)
                    }
                })
                Grow()
                CalStep(IC_CHEV_LEFT, "Previous year", fn() => y.set(y.get() - 1))
                // Bound text paints the live year — same trick the gauge widgets use.
                bind(Text("", color = ink(), font = FONT_BODY), y)
                CalStep(IC_CHEV_RIGHT, "Next year", fn() => y.set(y.get() + 1))
            }
            CalWeekRow()
            CalGrid(y, m, d, open)
        })
    })
}

/// Page: white background column with breathing room. Sets the native
/// roles once; every following Component reads them at paint.
fn Page() -> Node {
    ensure_role_colors()
    return Box(align_direction = DIRECTION.Column, spacing = SECTION,
               padding = PAGE_PAD, background = paper(), grow = 1)
}
