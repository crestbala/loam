// --- multi-contour fills (holes / winding) --------------------------------

fn raster_multi_begin() {
    raster.raster_multi_begin()
}

fn raster_multi_add_circle(cx: int, cy: int, r: int, sign: int) {
    raster.raster_multi_add_circle(float(cx), float(cy), float(r), sign)
}

fn raster_multi_add_poly(xs: []float, ys: []float, sign: int) {
    raster.raster_multi_add_poly(xs, ys, sign)
}

fn raster_multi_count() -> int {
    return raster.raster_multi_count()
}

fn raster_fill_multi(cr: int, cg: int, cb: int, alpha: int) {
    raster.raster_fill_multi(cr, cg, cb, alpha)
}

/// Add a glyph's contours to the multi-contour set. Points are in FONT UNITS;
/// `sc` is px/unitsPerEm and `(pen_x, pen_y)` the device-space baseline origin.
/// Winding signs are derived from contour orientation, so no sign is passed.
fn raster_multi_add_glyph(xs: []int, ys: []int, on: []int, ends: []int,
                          pen_x: float, pen_y: float, sc: float) {
    raster.raster_multi_add_glyph(xs, ys, on, ends, pen_x, pen_y, sc)
}

/// Rasterize the multi-contour set into an offscreen single-channel (R8) mask
/// over the device box [x0,x1) x [y0,y1). One tile a side at most. Returns 1 on
/// success. The mask is scratch for the caller: read it with the accessors
/// below, it is reused by the next call.
fn raster_multi_to_mask(x0: int, y0: int, x1: int, y1: int) -> int {
    return raster.raster_multi_to_mask(x0, y0, x1, y1)
}

fn raster_mask_w() -> int {
    return raster.raster_mask_w()
}

fn raster_mask_h() -> int {
    return raster.raster_mask_h()
}

/// Mask coverage 0..255 at a point in the mask's own space.
fn raster_mask_get(x: int, y: int) -> int {
    return raster.raster_mask_get(x, y)
}

// --- glyph atlas (Phase 4) --------------------------------------------------

/// Gamma-corrected coverage 0..255 for a raw coverage 0..255. Glyph coverage
/// goes through this on insert, so text weight is one documented constant.
fn atlas_gamma(c: int) -> int {
    return atlas.atlas_gamma(c)
}

/// Subpixel-x bucket: 1/4-px phase at sizes <= 16 LOGICAL px, 0 above.
fn atlas_subx_bucket(size_logical: int, frac_x: float) -> int {
    return atlas.atlas_subx_bucket(size_logical, frac_x)
}

/// Device offset (0, 0.25, 0.5, 0.75) baked in for a subpixel bucket.
fn atlas_subx_offset(bucket: int) -> float {
    return atlas.atlas_subx_offset(bucket)
}

/// Atlas slot for a key, or -1. A hit is promoted to most-recently-used.
fn atlas_lookup(font: int, gid: int, size: int, subx: int) -> int {
    return atlas.atlas_lookup(font, gid, size, subx)
}

/// Ensure a glyph is in the atlas (rasterizing on a miss) and return its slot,
/// or -1 when it cannot be atlased. `size` is the DEVICE pixel size; `subx` a
/// bucket from `atlas_subx_bucket`. The mask is stored relative to the pen, so
/// blit it at the integer pen position.
fn atlas_intern(font: int, gid: int, size: int, subx: int,
                xs: []int, ys: []int, on: []int, ends: []int, upm: int) -> int {
    return atlas.atlas_intern(font, gid, size, subx, xs, ys, on, ends, upm)
}

/// Composite an atlased glyph onto the framebuffer at an integer pen position.
fn atlas_blit(s: int, pen_x: int, pen_y: int, r: int, g: int, b: int, alpha: int) {
    atlas.atlas_blit(s, pen_x, pen_y, r, g, b, alpha)
}

fn atlas_cov(s: int, x: int, y: int) -> int {
    return atlas.atlas_cov(s, x, y)
}

fn atlas_glyph_w(s: int) -> int {
    return atlas.atlas_glyph_w(s)
}

fn atlas_glyph_h(s: int) -> int {
    return atlas.atlas_glyph_h(s)
