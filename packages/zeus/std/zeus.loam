//! `zeus` — UI toolkit. Native Cocoa and WASM/Canvas2D run the same source.
//!
//! Widgets are `Box` / `Text` / `Button` / `Input` / `Grid` / `Overlay` /
//! `Scroll` / `Svg` / `If` / `Each` / `For` / `VirtualList` / `VirtualTable` /
//! `App`. Hierarchy is a trailing block. Lists: `zeus.signal([]T {})` +
//! `For` / `VirtualList` + `push_item` / `insert_item`. Windowed lists
//! (`VirtualList`, `For(..., row_h)`, `VirtualTable`) render visible rows
//! only; table rows and columns are structs.
//!
//! Reactivity is fine-grained, and the whole model is five rules:
//!
//!   1. A `signal` is a value with `get` / `set`. Reading one inside a
//!      reactive scope subscribes that scope to it — dependencies are
//!      discovered, never declared. `peek` reads without subscribing.
//!   2. An `effect` runs once, then re-runs whenever a signal it read
//!      changes. Effects are the edges of the graph.
//!   3. A `computed` (`computed_str` / `computed_bool`) is a cached
//!      derivation: it recalculates only when its own inputs change, and
//!      because `set` is change-gated, a recompute landing on the same
//!      value propagates no further.
//!   4. Components disappear. A widget fn is a *setup* function: it runs
//!      once, wires bindings to signals, and is never called again. There
//!      is no render loop and no component re-execution.
//!   5. Updates are surgical. Every dynamic prop (`Text("n = {{n.get()}}")`,
//!      `Image(photo.get())`) is its own effect over one node attribute, so a
//!      `set` repaints exactly the attributes that read it — no virtual
//!      DOM, no diffing, no tree walk.
//!
//! Every widget is a `Component`: `slot` (parent stack), `bind`, `visible`,
//! press, then attach. Trailing blocks are `slot`. Recipes extend `Comp` /
//! `Box` — they do not call `ui_push` / `bind` / `show` themselves.
//! Named props fill a last-param struct. Restyle without forking by passing
//! the style prop straight to the widget — `Button("Go", radius = 4)`,
//! `Card(padding = 12)`, `Chip("pill", TINT.Ok, radius = 6)`. `Button` /
//! `Card` / `Chip` / `Comp` / `IconButton` / `Badge` / `Alert` / `Field` /
//! `TextInput` all take the same twelve: `background`, `color`, `radius`,
//! `padding`, `padding_x`, `padding_y`, `padding_top` / `_right` / `_bottom` /
//! `_left`, `margin_*`, `gap` / `gap_row` / `gap_col`, `width`, `height`, `font`, `border`,
//! `border_color`, `spacing`. Write them as plain data — `radius = 4`,
//! `background = paper()`. Text is a thunk: write `Text("n = {{n.get()}}")`
//! and the compiler lifts the expression, so a signal read inside it
//! repaints just that label. (`Text(|| "{{n.get()}}")` says the same
//! thing by hand.) Closures are for events: `on_click = fn() => ...`.
//! Omit a prop and the recipe's own value stands.
//! `Comp` is the function-widget primitive (`bind` / `visible` / `press` /
//! slot). No `View` trait — write `fn MyThing(p: MyProps)` and call `Comp`.
//! One UI-scale knob (`set_scale` percent) scales type and control chrome.
//! It is applied centrally, where a prop lands on a node, so widgets and
//! callers alike write plain design px — nothing calls a scale helper.
//! It is the identity at 100, so goldens hold at 1.0.
//! `Button` paints the themed chrome when you pass `look = LOOK.*` and
//! `size = SIZE.*`; without them it is a plain clickable label whose
//! background / color / width / height / `enabled` / `on_click` come from
//! the props. Keyboard: every click target is a tab stop; Tab walks the
//! focus ring in document order (Shift-Tab back), Enter/Space activate, and
//! the focused control paints a 2px ring (keyboard focus only — pointer
//! clicks clear it).
//!
//! Example:
//! ```
//! import "std:zeus"
//!
//! fn main() {
//!     let n = zeus.signal(0)
//!     zeus.App("Count", fn() {
//!         zeus.Box(align_direction = DIRECTION.Column, padding = 16, spacing = 8) {
//!             zeus.Text("Count", font = 22)
//!             zeus.Text("{{n.get()}}", font = 28)
//!             zeus.Box(align_direction = DIRECTION.Row, spacing = 8) {
//!                 zeus.Button("-", look = zeus.LOOK.Ghost, size = zeus.SIZE.Md,
//!                             on_click = fn() => n.set(n.get() - 1))
//!                 zeus.Button("+", look = zeus.LOOK.Solid, size = zeus.SIZE.Md,
//!                             on_click = fn() => n.set(n.get() + 1))
//!             }
//!         }
//!     })
//! }
//! ```
//!
//! `zeus.App(title, build)` is the entry: retained tree, view size from
//! the host (`window_size`); pass trailing `width`/`height` only to pin a
//! macOS/wasm window. Per-frame rebuild is `zeus.view` / `zeus.app`.
//! Hide live nodes with `If` / `show` (`Signal<int>` 0/1). `Box.show` is
//! the bool-thunk form of the same flag. Internals: `packages/zeus/std/zeuscore/*.loam`.
//! C is host FFI (`platform.loam`). `Node` is `{ id: int }`.
//! See `docs/boundary.md`. `ZEUS_HEADLESS=1` layouts once and exits.

import "zeuscore/geometry.loam"
import "zeuscore/platform.loam"
import "zeuscore/arena.loam"
import "zeuscore/raster.loam"
import "zeuscore/atlas.loam"
import "zeuscore/image.loam"
import "zeuscore/layout.loam"
import "zeuscore/metrics.loam"
import "zeuscore/scene.loam"
import "zeuscore/input.loam"
import "zeuscore/track.loam"
import "std:async"
import "std:fmt"
import "std:sys"
import "zeus_constants.loam"

/// Button variants, named after the fill they carry. `Solid` is the
/// `default` (primary) variant, `Soft` is `secondary`, `Danger` is
/// `destructive`, and `Link` is text-only. Gallery rows read
/// Primary / Secondary / Outline / Ghost / Destructive / Link.
enum LOOK {
    Solid = 0,
    Soft = 1,
    Outline = 2,
    Ghost = 3,
    Danger = 4,
    Link = 5,
}

/// Button sizes, by control height: Sm 32px, Md 36px, Lg 40px.
enum SIZE {
    Sm = 0,
    Md = 1,
    Lg = 2,
}

/// Status tints for chips, badges, stats, meters.
enum TINT {
    Ink = 0,
    Ok = 1,
    Mute = 2,
    Dim = 3,
    Danger = 4,
    Warn = 5,
    Info = 6,
}

fn tint_of(kind: int) -> string {
    match kind {
        TINT.Ok => { return ok() }
        TINT.Mute => { return mute() }
        TINT.Dim => { return dim() }
        TINT.Danger => { return danger() }
        TINT.Warn => { return warn() }
        _ => { return ink() }
    }
}

/// A widget in the tree. Copy handle (`id`).
struct Node {
    /// Slot in the engine arena. Do not construct by hand; use `Box` / `Text`.
    id: int,
}

/// Opaque reactive cell. Copy handle (`id`). `T` must be Copy (`int`,
/// `string`, `float`, `bool`, `[]U` when `U` is Copy, or a Copy struct).
///
/// ```
/// let n = zeus.signal(0)
/// n.set(n.get() + 1)
/// ```
struct Signal<T> {
    id: int,
}

fn empty_view() -> Node {
    return Node { id: 0 }
}

let mut has_view: int = 0
let mut view_fn: fn() -> Node = empty_view

/// Wrap a raw arena slot as a `Node`. Ids are the only thing the engine
/// stores, so every allocator hands one back through here rather than
/// letting callers build a `Node` literal and desync from the arena.
fn node_handle(id: int) -> Node {
    return Node { id: id }
}

/// Wrap a raw arena slot as a `Signal<int>`. Same reason as `node_handle`:
/// the engine speaks ids, the API speaks handles.
fn signal_handle(id: int) -> Signal<int> {
    return Signal { id: id }
}

fn raw_init() {
    arena.ensure()
}

fn open_window(title: string, width: int, height: int) {
    arena.ensure()
    arena.win_w = width
    arena.win_h = height
    platform.plat_set_window(title, width, height)
}

fn raw_run() {
    arena.ensure()
    if platform.plat_headless() != 0 {
        engine_layout(arena.win_w, arena.win_h)
        // With stats on, paint once so the draw list is part of the baseline.
        // With stats off this is exactly the old one-layout-and-exit path, so
        // no existing headless test changes.
        if arena.mem_stats_on() != 0 {
            engine_paint()
        }
        mem_stats_report()
        return
    }
    platform.plat_run()
    mem_stats_report()
}

/// Phase 0 memory report: arena buckets (arena side), the retained draw list,
/// and the host's process footprint. Printed once, on exit, and only when
/// `ZEUS_MEM_STATS` is on (build `-DZEUS_MEM_STATS`, or the env var). With
/// stats off this is a single host call that returns 0.
fn mem_stats_report() {
    if arena.mem_stats_on() == 0 {
        return
    }
    arena.mem_report()
    fmt.println("ZEUS_MEM draw_ops=", scene.draws.len, " draw_bytes=", draw_bytes())
    fmt.println("ZEUS_MEM process_kb=", memory_kb())
}

fn init() {
    raw_init()
    // Theme slots must exist before anything paints: a node stores a role,
    // and the paint pass resolves it against the palette registered here.
    ensure_role_colors()
}

/// Open a native window. Sizes are CSS-like points, not pixels.
/// Prefer `zeus.App(...)` over calling this alone.
fn window(title: string, width: int, height: int) {
    init()
    open_window(title, width, height)
}

/// Host view size in points: browser canvas, or the native content view.
struct WindowSize {
    width: int,
    height: int,
}

fn window_size() -> WindowSize {
    return WindowSize {
        width: platform.plat_view_width(),
        height: platform.plat_view_height(),
    }
}

/// Host process memory in KB for diagnostics UI: Apple phys_footprint
/// (Xcode's memory-gauge number), Linux/Android resident set, live wasm
/// heap on the web host (0 = unknown).
fn memory_kb() -> int {
    arena.ensure()
    return platform.plat_mem_kb()
}

/// Enter the event loop with `node` as the tree root.
/// `ZEUS_HEADLESS=1` layouts once and exits (tests). Prefer `zeus.App`.
fn run(node: Node) {
    init()
    arena.root_id = node.id
    raw_run()
}

/// GPUI-style: each frame rebuilds the element tree from signals.
/// Omit this and the tree stays retained (the `App` mode).
fn view(build: fn() -> Node) {
    init()
    view_fn = build
    has_view = 1
}

/// Open a window, install `build` as the per-frame view, and run.
/// Rebuilds the tree every layout. Prefer `zeus.App` for a retained tree.
///
/// Example:
/// ```
/// zeus.app("Demo", 400, 300, || {
///     zeus.Text("frame")
/// })
/// ```
fn app(title: string, width: int, height: int, build: fn() -> Node) {
    window(title, width, height)
    view(build)
    init()
    raw_run()
}

// --- signals (live Copy state) ---

/// Allocate a live cell. `T` is inferred from `value`.
///
/// Example:
/// ```
/// let count = zeus.signal(0)
/// zeus.Button("+", on_click = fn() => count.set(count.get() + 1))
/// ```
/// Allocations made while a `For` / `refit` rebuild is running are owned by
/// that host (the C alloc hook records them) and are freed when the host
/// rebuilds or is torn down, so builders that create state do not grow the
/// signal arena.
fn signal<T>(value: T) -> Signal<T> {
    arena.ensure()
    Signal { id: __sig_push(value) }
}

/// Read the current value of `sig`. Reading inside a reactive scope (an
/// `effect`, a `computed`, or the thunk behind any widget prop) records
/// `sig` as a dependency of that scope, so a later `set` re-runs it.
/// Call as `sig.get()`.
fn get<T>(sig: Signal<T>) -> T {
    arena.ensure()
    track.note_read(sig.id)
    __sig_load(sig.id)
}
/// Write `value` into `sig`, then re-run every reactive scope that read it.
/// Writing the value it already holds is a no-op: nothing is notified, so
/// derivations built on `sig` do not recompute. Call as `sig.set(value)`.
fn set<T>(sig: Signal<T>, value: T) {
    arena.ensure()
    __sig_store(sig.id, value)
}

/// Read `sig` *without* subscribing the enclosing scope to it. Use when an
/// effect needs the current value but must not re-run when it changes —
/// notably read-modify-write (`c.set(c.peek() + 1)` inside an effect).
fn peek<T>(sig: Signal<T>) -> T {
    arena.ensure()
    __sig_load(sig.id)
}

/// Run `body` with dependency tracking suspended: signals read inside it
/// become dependencies of nothing. Writes still notify as usual.
fn untrack(body: fn()) {
    track.mute_begin()
    body()
    track.mute_end()
}

// --- unstyled allocators ---
/// Kinds: 1 box/row/col, 2 grid, 3 label, 4 button, 5 spacer, 6 progress,
/// 7 toggle, 8 check, 9 overlay, 10 input, 11 scroll, 12 svg, 13 slider.

fn raw_row() -> Node {
    let id = arena.alloc_node(1)
    arena.nodes[id].dir = 0
    return node_handle(id)
}
fn raw_col() -> Node {
    let id = arena.alloc_node(1)
    arena.nodes[id].dir = 1
    return node_handle(id)
}
fn raw_box() -> Node {
    return node_handle(arena.alloc_node(1))
}
fn raw_label(text: string) -> Node {
    let id = arena.alloc_node(3)
    arena.nodes[id].text = text
    return node_handle(id)
}
fn raw_button(text: string) -> Node {
    let id = arena.alloc_node(4)
    arena.nodes[id].text = text
    return node_handle(id)
}
fn raw_spacer() -> Node {
    return node_handle(arena.alloc_node(5))
}
fn raw_progress() -> Node {
    return node_handle(arena.alloc_node(6))
}
fn raw_slider() -> Node {
    return node_handle(arena.alloc_node(13))
}
fn raw_toggle() -> Node {
    return node_handle(arena.alloc_node(7))
}
fn raw_check(markup: string) -> Node {
    let id = arena.alloc_node(8)
    arena.nodes[id].text = markup
    return node_handle(id)
}
fn raw_overlay() -> Node {
    let id = arena.alloc_node(9)
    arena.nodes[id].pos = 1
    arena.nodes[id].enter_fade = 1
    arena.mark_chrome()
    return node_handle(id)
}
fn raw_input(placeholder: string) -> Node {
    let id = arena.alloc_node(10)
    arena.nodes[id].text = placeholder
    arena.nodes[id].focusable = 1
    arena.nodes[id].capture_text = 1
    return node_handle(id)
}
fn raw_scroll() -> Node {
    let id = arena.alloc_node(11)
    arena.nodes[id].dir = 1
    arena.nodes[id].overflow = 2
    return node_handle(id)
}
fn raw_svg(markup: string) -> Node {
    let id = arena.alloc_node(12)
    arena.nodes[id].text = markup
    return node_handle(id)
}
fn raw_image(src: string) -> Node {
    let id = arena.alloc_node(14)
    arena.nodes[id].text = src
    return node_handle(id)
}
fn raw_grid(columns: int, gap: int) -> Node {
    let id = arena.alloc_node(2)
    arena.nodes[id].grid_cols = u16(columns)
    arena.nodes[id].gap = u16(gap)
    return node_handle(id)
}
fn raw_hover(node: Node, sig: Signal<int>) -> Node {
    arena.nodes[node.id].hover_sig = sig.id
    return node
}

/// Text currently in an input (typed buffer, else placeholder).
fn input_value(node: Node) -> string {
    return arena.input_shown(node.id)
}

/// Replace the typed buffer for `node`. No-op if it is not an input.
fn set_input(node: Node, text: string) -> Node {
    let mut slot = arena.nodes[node.id].edit_slot
    if slot < 0 {
        arena.stamp_edits()
        slot = arena.nodes[node.id].edit_slot
    }
    if slot >= 0 {
        platform.plat_edit_set(slot, text)
    }
    return node
}

// --- tree ---

/// Intern a handler or thunk, and record it as owned by the open rebuild
/// scope if there is one. A `For`/`refit` rebuild interns fresh closures per
/// row; when the host is torn down the recorded ids are freed and recycled,
/// so streaming lists do not leak handler envs.
fn intern_fn(h: fn()) -> int {
    let id = platform.plat_intern_fn(h)
    arena.record_intern(id, arena.scope_node)
    return id
}

fn intern_int(h: fn() -> int) -> int {
    let id = platform.plat_intern_int_fn(h)
    arena.record_intern(id, arena.scope_node)
    return id
}

fn intern_bool(h: fn() -> bool) -> int {
    let id = platform.plat_intern_bool_fn(h)
    arena.record_intern(id, arena.scope_node)
    return id
}

fn intern_str(h: fn() -> string) -> int {
    let id = platform.plat_intern_str_fn(h)
    arena.record_intern(id, arena.scope_node)
    return id
}

/// How many handler invokes were refused because the interned slot held a
/// closure of another signature. Zero is the contract. The intern table is
/// shared by the void / int / bool / string kinds, so a non-zero count means a
/// handler was interned as one kind and invoked as another — which used to be
/// undefined behaviour: a garbage return value on native (it landed in a signal
/// and read as a jittering UI) and a hard trap on wasm, which type-checks the
/// call. Exposed so a test can pin it at zero rather than hope.
fn intern_kind_mismatch_count() -> int {
    return platform.plat_intern_kind_mismatch_count()
}

/// Attach `node` under `parent`. Used by `ui_emit` for trailing blocks.
fn child(parent: Node, node: Node) -> Node {
    arena.ensure()
    push(arena.nodes[parent.id].kids, node.id)
    arena.nodes[node.id].parent = parent.id
    arena.mark_tree()
    return parent
}

/// Run `handler` now and again whenever a `Signal` it `get`s changes.
/// The closure only updates paint state on existing nodes — it must not
/// call `child` or rebuild the tree.
fn styled(node: Node, handler: fn()) -> Node {
    arena.ensure()
    let effect_id = track.alloc(intern_fn(handler), node.id)
    track.run(effect_id)
    return node
}

fn root(node: Node) -> Node {
    arena.ensure()
    arena.root_id = node.id
    return node
}

// --- style ---
/// Field writers used by `Box` / `apply_int`. Not app-facing.

fn grow(node: Node, weight: int) -> Node {
    arena.nodes[node.id].grow = weight
    return node
}
fn shrink(node: Node, weight: int) -> Node {
    arena.nodes[node.id].shrink = weight
    return node
}

/// Inset all four edges. Padding lives on the node rather than on a wrapper
/// box so a widget stays one node and layout stays one pass.
fn set_padding(node: Node, all: int) -> Node {
    arena.nodes[node.id].pad = u16(all)
    arena.nodes[node.id].pad_t = u16(all)
    arena.nodes[node.id].pad_r = u16(all)
    arena.nodes[node.id].pad_b = u16(all)
    arena.nodes[node.id].pad_l = u16(all)
    return node
}
/// Inset left and right only — the common case for control chrome, where
/// horizontal breathing room is set independently of height.
fn set_padding_x(node: Node, px: int) -> Node {
    arena.nodes[node.id].pad_l = u16(px)
    arena.nodes[node.id].pad_r = u16(px)
    return node
}
/// Inset top and bottom only, the vertical half of `set_padding_x`.
fn set_padding_y(node: Node, py: int) -> Node {
    arena.nodes[node.id].pad_t = u16(py)
    arena.nodes[node.id].pad_b = u16(py)
    return node
}
/// Inset one edge. The per-edge setters exist so a recipe can override a
/// single side without restating the other three.
fn set_padding_top(node: Node, px: int) -> Node {
    arena.nodes[node.id].pad_t = u16(px)
    return node
}
/// Inset one edge; see `set_padding_top`.
fn set_padding_right(node: Node, px: int) -> Node {
    arena.nodes[node.id].pad_r = u16(px)
    return node
}
/// Inset one edge; see `set_padding_top`.
fn set_padding_bottom(node: Node, px: int) -> Node {
    arena.nodes[node.id].pad_b = u16(px)
    return node
}
/// Inset one edge; see `set_padding_top`.
fn set_padding_left(node: Node, px: int) -> Node {
    arena.nodes[node.id].pad_l = u16(px)
    return node
}
fn margin(node: Node, all: int) -> Node {
    arena.nodes[node.id].m_t = all
    arena.nodes[node.id].m_r = all
    arena.nodes[node.id].m_b = all
    arena.nodes[node.id].m_l = all
    return node
}
fn marginX(node: Node, px: int) -> Node {
    arena.nodes[node.id].m_l = px
    arena.nodes[node.id].m_r = px
    return node
}
fn marginY(node: Node, py: int) -> Node {
    arena.nodes[node.id].m_t = py
    arena.nodes[node.id].m_b = py
    return node
}
fn marginTop(node: Node, px: int) -> Node {
    arena.nodes[node.id].m_t = px
    return node
}
fn marginRight(node: Node, px: int) -> Node {
    arena.nodes[node.id].m_r = px
    return node
}
fn marginBottom(node: Node, px: int) -> Node {
    arena.nodes[node.id].m_b = px
    return node
}
fn marginLeft(node: Node, px: int) -> Node {
    arena.nodes[node.id].m_l = px
    return node
}
fn border(node: Node, width: int) -> Node {
    // A negative width is the "unset" sentinel; a non-positive width means no
    // border, so it maps to 0 rather than a u16 trap.
    if width > 0 {
        arena.nodes[node.id].border_w = u16(width)
    } else {
        arena.nodes[node.id].border_w = 0
    }
    return node
}
fn border_color(node: Node, rgb: int) -> Node {
    arena.nodes[node.id].border_c = rgb
    return node
}

/// Space between children. Gap belongs to the parent, not to each child's
/// margin, so adding or removing a child cannot leave a stray edge gap.
fn set_spacing(node: Node, g: int) -> Node {
    arena.nodes[node.id].gap = u16(g)
    return node
}
/// Row-axis gap for wrapped and grid layouts, where the two axes need
/// different spacing and one `set_spacing` cannot express it.
fn set_spacing_row(node: Node, g: int) -> Node {
    arena.nodes[node.id].gap_row = u16(g)
    return node
}
/// Column-axis gap; the other half of `set_spacing_row`.
fn set_spacing_col(node: Node, g: int) -> Node {
    arena.nodes[node.id].gap_col = u16(g)
    return node
}

/// Default node width is 100% of the parent. `.set_width(px)` pins a pixel width
/// and clears the percentage. `.set_width(-1)` restores the 100% default.
fn set_width(node: Node, px: int) -> Node {
    if px < 0 {
        arena.nodes[node.id].explicit_width = -1
        arena.nodes[node.id].w_pct = 100
    } else {
        arena.nodes[node.id].explicit_width = px
        arena.nodes[node.id].w_pct = -1
    }
    return node
}
/// Pin a pixel height, clearing any percentage. The chaining form of the
/// `height` prop, for code that already holds a `Node` (recipes, engine
/// paths) and cannot go back through a props struct.
fn set_height(node: Node, px: int) -> Node {
    arena.nodes[node.id].explicit_height = px
    return node
}

/// Zero basis: the node's measured content no longer sets its row slot width;
/// `grow` then divides the whole free line evenly. This is the table recipe —
/// header labels and row cells all use `set_flex_basis_zero(...).grow(1)`, so every column
/// boundary comes from the row width alone, not from text lengths. Cells that
/// must keep a fixed pixel width use `.set_width(px)` instead.
fn set_flex_basis_zero(node: Node) -> Node {
    arena.nodes[node.id].w_pct = 0
    return node
}
/// `.set_width(px).set_height(px)` in one call. Named `size_px`, not `size`: themed widgets
/// expose `.size()` for the sm/md/lg token, and two chain methods sharing a
/// name and a `(Node, int)` shape resolve by import order — which is how
/// `.size(ui.sm())` once silently became a 0x0 box. The `_px` suffix also
/// keeps the unit at the call site, next to the themed token form.
fn size_px(node: Node, px: int) -> Node {
    return node.set_width(px).set_height(px)
}
fn width_pct(node: Node, percent_value: int) -> Node {
    arena.nodes[node.id].explicit_width = -1
    arena.nodes[node.id].w_pct = i8(percent_value)
    return node
}
fn height_pct(node: Node, percent_value: int) -> Node {
    arena.nodes[node.id].h_pct = i8(percent_value)
    return node
}
/// Floor the width. Min/max bounds are how a flexible child stays readable
/// when its parent shrinks, without giving up `grow`.
fn set_min_width(node: Node, px: int) -> Node {
    arena.nodes[node.id].min_w = px
    return node
}
/// Cap the width, so a growing child cannot run past a comfortable measure.
fn set_max_width(node: Node, px: int) -> Node {
    arena.nodes[node.id].max_w = px
    return node
}
/// Floor the height; the vertical counterpart of `set_min_width`.
fn set_min_height(node: Node, px: int) -> Node {
    arena.nodes[node.id].min_h = px
    return node
}
/// Cap the height, so scrollable content clips instead of stretching.
fn set_max_height(node: Node, px: int) -> Node {
    arena.nodes[node.id].max_h = px
    return node
}
/// Make a grid responsive. `px > 0` is a minimum *cell* width, in dp like
/// `gap` (not a scaled style prop — the layout it feeds is unscaled). `px == 0`
/// also turns it on but takes the cell width from the children: the widest
/// child's natural width is what a column has to hold, so the grid fits as
/// many as the content allows, capped by `columns`. `px < 0` turns it off and
/// restores the fixed `columns`.
///
/// Reached from `GridConfig.auto_columns`; public so a caller building a node
/// by hand can set it.
fn set_auto_columns(node: Node, px: int) -> Node {
    // Both fields move together, so `grid_auto != 0` never leaves a stale
    // floor behind for `grid_cols_at` to pick up.
    arena.nodes[node.id].grid_auto = 1
    arena.nodes[node.id].grid_min = 0
    if px > 0 {
        arena.nodes[node.id].grid_min = u16(px)
    }
    if px < 0 {
        arena.nodes[node.id].grid_auto = 0
    }
    return node
}
fn aspect(node: Node, aw: int, ah: int) -> Node {
    arena.nodes[node.id].aspect_w = aw
    arena.nodes[node.id].aspect_h = ah
    return node
}

fn flex_row(node: Node) -> Node {
    if int(arena.nodes[node.id].kind) != 2 {
        if int(arena.nodes[node.id].kind) != 9 {
            if int(arena.nodes[node.id].kind) != 11 {
                arena.nodes[node.id].kind = 1
            }
        }
    }
    arena.nodes[node.id].dir = 0
    arena.nodes[node.id].reverse = 0
    return node
}
fn flex_col(node: Node) -> Node {
    if int(arena.nodes[node.id].kind) != 2 {
        if int(arena.nodes[node.id].kind) != 9 {
            if int(arena.nodes[node.id].kind) != 11 {
                arena.nodes[node.id].kind = 1
            }
        }
    }
    arena.nodes[node.id].dir = 1
    arena.nodes[node.id].reverse = 0
    return node
}
fn flex_row_reverse(node: Node) -> Node {
    arena.nodes[node.id].dir = 0
    arena.nodes[node.id].reverse = 1
    return node
}
fn flex_col_reverse(node: Node) -> Node {
    arena.nodes[node.id].dir = 1
    arena.nodes[node.id].reverse = 1
    return node
}
fn flex_wrap(node: Node) -> Node {
    arena.nodes[node.id].wrap = 1
    return node
}
fn align_self(node: Node, mode: int) -> Node {
    arena.nodes[node.id].align_self = i8(mode)
    return node
}
fn span(node: Node, columns: int) -> Node {
    arena.nodes[node.id].span = u16(columns)
    return node
}

fn justify(node: Node, mode: int) -> Node {
    arena.nodes[node.id].justify = u8(mode)
    return node
}
fn align(node: Node, mode: int) -> Node {
    arena.nodes[node.id].align = u8(mode)
    return node
}

fn position(node: Node, mode: int) -> Node {
    arena.nodes[node.id].pos = u8(mode)
    return node
}
fn top(node: Node, px: int) -> Node {
    arena.nodes[node.id].pin_t = px
    return node
}
fn right(node: Node, px: int) -> Node {
    arena.nodes[node.id].pin_r = px
    return node
}
fn bottom(node: Node, px: int) -> Node {
    arena.nodes[node.id].pin_b = px
    return node
}
fn left(node: Node, px: int) -> Node {
    arena.nodes[node.id].pin_l = px
    return node
}
fn z_index(node: Node, z: int) -> Node {
    arena.nodes[node.id].z_index = i16(z)
    return node
}

/// Fill color as a packed rgb int. Takes an int, not a string, because it
/// is the post-parse form the scene writes — call sites pass `"#rrggbb"`
/// through the `background` prop and `parse_hex_color` converts once.
fn set_background(node: Node, rgb: int) -> Node {
    arena.nodes[node.id].bg = rgb
    return node
}

/// Second stop of a vertical gradient (`bg` → `bg2`). Solid fill when unset.
fn set_background_end(node: Node, rgb: int) -> Node {
    arena.nodes[node.id].bg2 = rgb
    return node
}
/// Foreground (text and glyph) color as a packed rgb int; the `color` prop
/// is the string-facing form.
fn set_color(node: Node, rgb: int) -> Node {
    arena.nodes[node.id].fg = rgb
    return node
}
fn radius(node: Node, px: int) -> Node {
    arena.nodes[node.id].radius = u16(px)
    return node
}

/// All four corners at once, clockwise from the top-left. `radius` stays the
/// uniform fallback for anything not set here.
fn radius4(node: Node, tl: int, tr: int, br: int, bl: int) -> Node {
    arena.set_corners(node.id, tl, tr, br, bl)
    return node
}

/// One corner: 0 top-left, 1 top-right, 2 bottom-right, 3 bottom-left.
fn radius_corner(node: Node, corner: int, px: int) -> Node {
    arena.set_corner(node.id, corner, px)
    return node
}

/// Round the top pair of corners, near `radius`'s bookkeeping: a top-rounded
/// sheet / tab header, with the bottom left square or whatever `radius` says.
fn radius_top(node: Node, px: int) -> Node {
    arena.set_corner(node.id, 0, px)
    arena.set_corner(node.id, 1, px)
    return node
}

/// Round the bottom pair of corners.
fn radius_bottom(node: Node, px: int) -> Node {
    arena.set_corner(node.id, 2, px)
    arena.set_corner(node.id, 3, px)
    return node
}

fn opacity(node: Node, percent_value: int) -> Node {
    arena.nodes[node.id].opacity = i16(percent_value)
    return node
}
fn overflow(node: Node, mode: int) -> Node {
    arena.nodes[node.id].overflow = u8(mode)
    return node
}
fn font(node: Node, px: int) -> Node {
    arena.nodes[node.id].font = u16(px)
    return node
}

/// Rotate a text node `deg` clockwise on screen around its top-left corner
/// (0 = horizontal). Used for chart axis labels that must not collide.
fn text_rot(node: Node, deg: int) -> Node {
    arena.nodes[node.id].text_rot = u16(deg)
    return node
}

/// Truncate this label with a trailing `…` when it is wider than its box,
/// instead of overflowing. Opt-in because overflow is the right default for
/// pinned and rotated chart text. Layout also lets a truncating label absorb
/// a row deficit, so `Table` cells, `Select` triggers, chips, and tabs
/// narrow rather than pushing siblings onto a second line.
fn text_ellipsis(node: Node) -> Node {
    arena.nodes[node.id].ellipsis = 1
    return node
}

// --- reactivity ---
/// `show` / `show_eq` / `show_ne` / `show_ge` / `show_le` hide a node from
/// layout when the predicate is false.

fn bind(label: Node, sig: Signal<int>) -> Node {
    arena.nodes[label.id].bind_sig = sig.id
    /* A bound number is measured as text on a label / button / input, so a
       write can change the box; flag it so the write re-runs layout. Elsewhere
       (a switch's tween, a scroll offset) the bind is paint-only. */
    let k = int(arena.nodes[label.id].kind)
    if k == 3 || k == 4 || k == 10 {
        arena.mark_sig_layout(sig.id)
    }
    arena.mark_chrome()
    return label
}

fn click() -> int {
    return 1
}

/// Attach a handler for an engine event code. The generic form behind
/// `on_click`; event codes keep the arena free of per-event fields.
fn on_event(node: Node, event: int, handler: fn()) -> Node {
    if event == 1 {
        arena.nodes[node.id].click_fn = intern_fn(handler)
    }
    return node
}

/// Click handler. `n.on_click(h)` is `n.on(zeus.click(), h)`.
fn on_click(node: Node, handler: fn()) -> Node {
    return on_event(node, click(), handler)
}

fn show(node: Node, sig: Signal<int>) -> Node {
    arena.nodes[node.id].show_sig = sig.id
    arena.nodes[node.id].show_mode = 0
    arena.mark_sig_layout(sig.id)
    arena.mark_chrome()
    return node
}
fn show_eq(node: Node, sig: Signal<int>, value: int) -> Node {
    arena.nodes[node.id].show_sig = sig.id
    arena.nodes[node.id].show_mode = 1
    arena.nodes[node.id].show_val = value
    arena.mark_sig_layout(sig.id)
    arena.mark_chrome()
    return node
}
fn show_ne(node: Node, sig: Signal<int>, value: int) -> Node {
    arena.nodes[node.id].show_sig = sig.id
    arena.nodes[node.id].show_mode = 2
    arena.nodes[node.id].show_val = value
    arena.mark_sig_layout(sig.id)
    arena.mark_chrome()
    return node
}
// --- keyboard ---
/// A chord on a focused node resolves to a named action; a handler on that
/// same node writes a signal. App remaps (`map_key` / `remap_key`) still use
/// the action name, so a shortcut can move without the Component changing.
/// Context is the family of the first action (`button.press` → `button`).
///
/// mode: 0 inc, 1 toggle, 2 set, 3 add — the same codes on_click_* uses.

/// Action name for a `key` prop: the caller's, else one derived from the
/// chord. The `key.` family becomes the keymap context, so every
/// prop-bound shortcut shares one context and the innermost focused node
/// wins — which is what "the same chord on two widgets" should do.
fn key_action_name(spec: string, action: string) -> string {
    if action.len > 0 {
        return action
    }
    return "key.{{spec}}"
}

/// Install a `key` prop: map the chord to an action, then bind the action to
/// `handler_fn` (an interned id). Node-scoped unless `is_global`.
fn install_key(node: Node, spec: string, action: string, handler_fn: int,
               is_global: bool) -> Node {
    if spec.len == 0 {
        return node
    }
    if handler_fn <= 0 {
        return node
    }
    let act = key_action_name(spec, action)
    match is_global {
        true => {
            // ctx 0 = matches whatever holds focus.
            platform.plat_map_key(spec, act, 0)
            on_action_global(act, signal_handle(0), 5, handler_fn)
        }
        _ => {
            key(node, spec, act)
            on_action(node, act, signal_handle(0), 5, handler_fn)
        }
    }
    return node
}

/// Repaint selectable chrome as `is_on` flips. Style props are plain data,
/// evaluated once at build, so a fill that tracks a selection has to be an
/// effect — this is the shared one, so every selectable widget (tab, radio,
/// toggle, nav item, page number) behaves identically. `label` may be
/// `empty_view()` when there is no text to re-ink. The colors are role
/// tokens, so light/dark still resolves at paint.
fn selected_chrome(node: Node, label: Node, is_on: fn() -> bool,
                   on_bg: string, off_bg: string,
                   on_fg: string, off_fg: string) -> Node {
    let fn_id = intern_bool(is_on)
    let node_id = node.id
    let label_id = label.id
    styled(node, || {
        let mut bg = off_bg
        let mut fg = off_fg
        if platform.plat_invoke_bool_fn(fn_id) != 0 {
            bg = on_bg
            fg = on_fg
        }
        if bg.len > 0 {
            apply_str(node_id, SET.Background, bg)
        }
        if label_id > 0 {
            if fg.len > 0 {
                apply_str(label_id, SET.Color, fg)
            }
        }
    })
    return node
}

/// Install a widget's `key` prop. Every recipe calls this on the node it
/// just built, which is what makes a shortcut available on any widget
/// instead of only the ones that shipped a bespoke helper.
fn apply_key(node: Node, spec: string, action: string, handler: fn(),
             handler_set: bool, is_global: bool) -> Node {
    if spec.len == 0 {
        return node
    }
    let mut kfn = 0
    match handler_set {
        true => { kfn = intern_fn(handler) }
        _ => { kfn = arena.nodes[node.id].click_fn }
    }
    return install_key(node, spec, action, kfn, is_global)
}

fn key_context(node: Node, name: string) -> Node {
    arena.nodes[node.id].key_ctx = platform.plat_key_intern(name)
    return node
}
fn focusable(node: Node) -> Node {
    arena.nodes[node.id].focusable = 1
    return node
}
fn capture_text(node: Node) -> Node {
    arena.nodes[node.id].capture_text = 1
    arena.nodes[node.id].focusable = 1
    return node
}
fn on_action(node: Node, action: string, sig: Signal<int>, mode: int, value: int) -> Node {}
fn on_action_global(action: string, sig: Signal<int>, mode: int, value: int) {}

/// Step `sig` by `delta`, clamped to lo..hi — arrow navigation over a range.
fn on_range(node: Node, action: string, sig: Signal<int>, delta: int, lo: int, hi: int) -> Node {}
fn map_key(spec: string, action: string, ctx: string) {}
fn remap_key(spec: string, action: string, ctx: string) {}

/// Chord → action on this node. The action family (`button.press` → `button`)
/// is the keymap context; `key_context` is only needed to override that name.
/// Implies `.focusable()` — a node with a key binding needs focus to receive
/// it, so components don't chain both.
fn key(node: Node, spec: string, action: string) -> Node {
    let mut ctx = arena.nodes[node.id].key_ctx
    if ctx == 0 {
        ctx = platform.plat_key_intern_action(action)
        arena.nodes[node.id].key_ctx = ctx
    }
    if ctx != 0 {
        platform.plat_map_key(spec, action, ctx)
    }
    arena.nodes[node.id].focusable = 1
    return node
}

fn on_key_set(node: Node, action: string, sig: Signal<int>, value: int) -> Node {
    return on_action(node, action, sig, 2, value)
}

fn on_key_add(node: Node, action: string, sig: Signal<int>, delta: int) -> Node {
    return on_action(node, action, sig, 3, delta)
}

fn on_key_toggle(node: Node, action: string, sig: Signal<int>) -> Node {
    return on_action(node, action, sig, 1, 0)
}

fn on_key_fn(node: Node, action: string) -> Node {
    return on_action(node, action, signal_handle(0), 5, arena.nodes[node.id].click_fn)
}

fn global_key_set(action: string, sig: Signal<int>, value: int) {
    on_action_global(action, sig, 2, value)
}

fn show_ge(node: Node, sig: Signal<int>, value: int) -> Node {
    arena.nodes[node.id].show_sig = sig.id
    arena.nodes[node.id].show_mode = 3
    arena.nodes[node.id].show_val = value
    arena.mark_sig_layout(sig.id)
    arena.mark_chrome()
    return node
}
fn show_le(node: Node, sig: Signal<int>, value: int) -> Node {
    arena.nodes[node.id].show_sig = sig.id
    arena.nodes[node.id].show_mode = 4
    arena.nodes[node.id].show_val = value
    arena.mark_sig_layout(sig.id)
    arena.mark_chrome()
    return node
}

fn hover(node: Node, sig: Signal<int>) -> Node {
    return raw_hover(node, sig)
}

fn pulse(node: Node) -> Node {
    arena.note_pulse(node.id)
    return node
}

fn hover_fade(node: Node) -> Node {
    arena.nodes[node.id].hover_fade = 1
    return node
}

/// Press feedback as a paint-only scale (97% while the pointer is down) on
/// top of the press wash. Needs `press = true` on the node; `Button` sets
/// both. No layout pass reads the scale, so pressing never reflows.
fn press_scale(node: Node) -> Node {
    arena.nodes[node.id].press_scale = 1
    return node
}

fn hover_off(node: Node) -> Node {
    arena.nodes[node.id].hover_fade = -1
    return node
}

fn enter_fade(node: Node) -> Node {
    arena.nodes[node.id].enter_fade = 1
    arena.mark_chrome()
    return node
}

/// Reveal the node top-down when it is shown: paint clips to an animated share
/// of its height and slides the content up by the rest. Paint-only — layout
/// gives the box its full height at once, so an opening disclosure never runs
/// the layout pass per frame. Hiding snaps (there is no reveal-out).
fn enter_reveal(node: Node) -> Node {
    arena.nodes[node.id].reveal = 1
    arena.mark_chrome()
    return node
}

// --- shared interaction state ---------------------------------------------
// One model for hover / pressed / focus-visible / disabled / loading /
// selected / invalid. Components set these once; the engine's paint and hit
// test consult the same overlay instead of each recipe re-deriving them.

/// Disabled: dimmed, no hover, no press. (`enabled` on a component already
/// sets this; `disabled` is for plain nodes and reactive overrides.)
fn disabled(node: Node, on: bool) -> Node {
    if on {
        arena.set_disabled(node.id, 1)
    } else {
        arena.set_disabled(node.id, 0)
    }
    return node
}

/// Loading: dimmed and non-interactive while work is in flight.
fn loading(node: Node, on: bool) -> Node {
    if on {
        arena.set_loading(node.id, 1)
    } else {
        arena.set_loading(node.id, 0)
    }
    return node
}

/// Invalid: validation failed (paint chrome reads the shared overlay).
fn invalid(node: Node, on: bool) -> Node {
    if on {
        arena.set_invalid(node.id, 1)
    } else {
        arena.set_invalid(node.id, 0)
    }
    return node
}

fn state_disabled(node: Node) -> bool {
    return arena.state_disabled_of(node.id) != 0
}
fn state_loading(node: Node) -> bool {
    return arena.state_loading_of(node.id) != 0
}
fn state_invalid(node: Node) -> bool {
    return arena.state_invalid_of(node.id) != 0
}
fn state_hovered(node: Node) -> bool {
    return arena.state_hovered_of(node.id) != 0
}
fn state_pressed(node: Node) -> bool {
    return arena.state_pressed_of(node.id) != 0
}
fn state_focus_visible(node: Node) -> bool {
    return arena.state_focus_visible_of(node.id) != 0
}
fn state_selected(node: Node) -> bool {
    return arena.state_selected_of(node.id) != 0
}

// --- paint-only motion -----------------------------------------------------
// Transforms and appearance are interpolated on the animation track pool and
// written into paint state only — no layout pass reads them, so an animation
// never re-runs a component or a signal effect. Retargeting keeps the current
// value as the new `from`.

/// Animate `node`'s scale to `to` percent (100 = identity) over `ms`.
fn animate_scale(node: Node, to: int, ms: int) -> Node {
    arena.anim_scale(node.id, to, ms)
    return node
}

/// Animate a horizontal paint translation (dp).
fn animate_x(node: Node, to: int, ms: int) -> Node {
    arena.anim_translate_x(node.id, to, ms)
    return node
}

/// Animate a vertical paint translation (dp).
fn animate_y(node: Node, to: int, ms: int) -> Node {
    arena.anim_translate_y(node.id, to, ms)
    return node
}

/// Animate a clockwise rotation in degrees about the node's centre.
fn animate_rotate(node: Node, to: int, ms: int) -> Node {
    arena.anim_rotate(node.id, to, ms)
    return node
}

/// Animate node opacity 0..100.
fn animate_opacity(node: Node, to: int, ms: int) -> Node {
    arena.anim_opacity(node.id, to, ms)
    return node
}

/// Animate the corner radius in dp.
fn animate_radius(node: Node, to: int, ms: int) -> Node {
    arena.anim_radius(node.id, to, ms)
    return node
}

/// Indeterminate rotation, `period` ms per turn, for a spinner. Paint rotates
/// it from the frame clock, so it keeps a frame live while visible and stays
/// deterministic on the first frame. Reduced motion settles it static.
fn spin(node: Node, period: int) -> Node {
    arena.note_spin(node.id, period)
    return node
}

/// Current animated paint values (tests / the inspector). Layout never reads
/// these, so reading one cannot cause a layout change.
fn motion_scale(node: Node) -> int {
    return int(arena.nodes[node.id].an_scale)
}
fn motion_x(node: Node) -> int {
    return int(arena.nodes[node.id].an_tx)
}
fn motion_y(node: Node) -> int {
    return int(arena.nodes[node.id].an_ty)
}
fn motion_rot(node: Node) -> int {
    return int(arena.nodes[node.id].an_rot)
}
/// The rotation a spinner paints right now (frame-clock phase).
fn motion_spin(node: Node) -> int {
    let per = int(arena.nodes[node.id].spin_ms)
    if per <= 0 {
        return 0
    }
    return (arena.now_ms % per) * 360 / per
}
fn motion_opacity(node: Node) -> int {
    return int(arena.nodes[node.id].opacity)
}
fn motion_radius(node: Node) -> int {
    return int(arena.nodes[node.id].radius)
}
fn keys(node: Node, sig: Signal<int>, lo: int, hi: int) -> Node {
    return node.key("right", "slider.inc").key("left", "slider.dec").focusable().on_range("slider.inc", sig, 1, lo, hi).on_range("slider.dec", sig, -1, lo, hi)
}
fn keys_page(node: Node, sig: Signal<int>) -> Node {
    return node.key("right", "page.next").key("left", "page.prev").focusable().on_key_add("page.next", sig, 1).on_key_add("page.prev", sig, -1)
}

// --- flex constants (public; implemented in geometry) ---

fn flex_start() -> int {
    return geometry.flex_start()
}
fn flex_center() -> int {
    return geometry.flex_center()
}
fn flex_end() -> int {
    return geometry.flex_end()
}
fn flex_between() -> int {
    return geometry.flex_between()
}
fn flex_around() -> int {
    return geometry.flex_around()
}
fn flex_evenly() -> int {
    return geometry.flex_evenly()
}
fn flex_stretch() -> int {
    return geometry.flex_stretch()
}
fn pos_relative() -> int {
    return geometry.pos_relative()
}
fn pos_absolute() -> int {
    return geometry.pos_absolute()
}
fn overflow_visible() -> int {
    return geometry.overflow_visible()
}
fn overflow_hidden() -> int {
    return geometry.overflow_hidden()
}
fn overflow_scroll() -> int {
    return geometry.overflow_scroll()
}
fn overflow_auto() -> int {
    return geometry.overflow_auto()
}
fn rgb(r: int, g: int, b: int) -> int {
    return geometry.rgb(r, g, b)
}

fn center(node: Node) -> Node {
    return node.justify(flex_center()).align(flex_center())
}

fn appearance() -> Signal<int> {
    arena.ensure()
    if arena.appearance_sid == 0 {
        let s = signal(1)
        arena.appearance_sid = s.id
    }
    return signal_handle(arena.appearance_sid)
}

fn theme(slot: int, light: int, dark: int) {
    arena.ensure()
    if slot < 0 {
        return
    }
    arena.theme_grow(slot)
    if slot < arena.theme_l.len {
        arena.theme_l[slot] = light
        arena.theme_d[slot] = dark
    }
}

/// Encode a theme role slot as a sentinel color. Widgets store the *role*,
/// not a resolved value, so flipping light/dark repaints without rebuilding
/// the tree — the paint pass resolves the slot each frame.
fn role_color(slot: int) -> int {
    if slot < 0 {
        return 0
    }
    return 2130706432 + slot
}

fn engine_key_apply(signal_id: int, mode: int, value: int, lo: int, hi: int) {
    arena.ensure()
    if mode == 5 {
        platform.plat_invoke_fn(value)
        return
    }
    if signal_id <= 0 {
        return
    }
    if signal_id >= arena.sigs.len {
        return
    }
    let mut next = arena.sigs[signal_id]
    if mode == 1 {
        if next == 0 {
            next = 1
        } else {
            next = 0
        }
    } else if mode == 2 {
        next = value
    } else if mode == 3 {
        next = next + value
    } else if mode == 4 {
        let mut vlo = lo
        let mut vhi = hi
        if vhi < vlo {
            let t = vlo
            vlo = vhi
            vhi = t
        }
        next = next + value
        if next < vlo {
            next = vlo
        }
        if next > vhi {
            next = vhi
        }
    } else {
        next = next + 1
    }
    arena.store_sig(signal_id, next)
}

fn refresh_lists() {
    let n = arena.nodes.len
    for i in 1..n {
        if arena.nodes[i].list_fn > 0 {
            platform.plat_invoke_fn(arena.nodes[i].list_fn)
        }
    }
}

fn virtual_stale() -> int {
    let n = arena.nodes.len
    for i in 1..n {
        if arena.nodes[i].row_h > 0 {
            if arena.nodes[i].list_fn > 0 {
                let w = virtual_window(i, arena.nodes[i].list_n, arena.nodes[i].row_h)
                if w.first != arena.nodes[i].list_lo {
                    return 1
                }
                if w.last != arena.nodes[i].list_hi {
                    return 1
                }
            }
        }
    }
    return 0
}

/// A refit host (chart, plot) whose measured width moved since its last
/// rebuild. Checked after the layout that measured it, so the refresh pass
/// rebuilds it with the width it will paint this very frame — no one-frame
/// lag and no empty band while a window is being resized.
fn refit_stale() -> int {
    let n = arena.nodes.len
    for i in 1..n {
        if arena.nodes[i].list_fn > 0 {
            if arena.nodes[i].w != arena.nodes[i].list_gen {
                return 1
            }
        }
    }
    return 0
}

fn engine_layout(width: int, height: int) {
    ensure_role_colors()
    arena.damage_frame_begin()
    // One frame of the async world first: steppers advance in-flight socket
    // state machines, then spawns and due timers fire. Callbacks set signals;
    // the rebuild and layout below paint their effect this very frame. Hosts
    // call this per frame (mac drawRect, web rAF, headless pump).
    async.tick()
    if arena.physics_step() != 0 {
        arena.mark_paint()
    }
    let mut resized = 0
    if width != arena.win_w {
        resized = 1
    }
    if height != arena.win_h {
        resized = 1
    }
    if has_view != 0 {
        arena.snapshot_focus()
        arena.snapshot_scroll()
        arena.reset_tree()
        platform.plat_key_reset()
        track.reset()
        let n = view_fn()
        arena.root_id = n.id
        arena.restore_scroll()
        arena.restore_focus()
        arena.mark_tree()
    }
    // A non-int signal write (array / string / bool) never passes through
    // `store_sig`, so its dirt is noted on the tracking module and drained here.
    if track.take_wrote() != 0 {
        arena.mark_layout()
        arena.mark_chrome()
    }
    // Layout runs only when the box model can have moved: a resize, a tree
    // build, or a discrete write that touched a layout prop. A frame whose
    // only dirt is PAINT — every animation frame — skips it entirely.
    let mut lay = 0
    if resized != 0 || arena.layout_dirty != 0 {
        lay = 1
    }
    // Anything that can move geometry anywhere repaints the whole surface. A
    // local repaint is only ever claimed for a paint-only change (Phase 1).
    if resized != 0 || lay != 0 {
        arena.damage_all()
    }
    if lay != 0 {
        arena.stamp_edits()
        layout.layout(width, height)
        arena.layout_dirty = 0
        arena.mark_paint()
        layout_gen = layout_gen + 1
    }
    // Windowed lists size their window from the scroller's laid-out height and
    // its scroll, and refit hosts (charts) rebuild when this frame's layout
    // moved their width. One refresh pass covers both; a second layout applies
    // the new rows / fresh chart width. A pure scroll frame that stays inside
    // the mounted window skips both.
    if lay != 0 || arena.virtual_dirty != 0 {
        if (virtual_stale() != 0) || (refit_stale() != 0) {
            refresh_lists()
            layout.layout(width, height)
            arena.layout_dirty = 0
        }
        arena.virtual_dirty = 0
    }
    if lay != 0 {
        // Positions moved, so pointer-over targets may have changed.
        arena.mark_chrome()
    }
    // The shared interaction-state pass: recompute hover/press/tween/fade
    // targets and (re)target their paint tracks. Event-driven, never per frame.
    if arena.chrome_dirty != 0 {
        arena.sync_chrome()
        arena.chrome_dirty = 0
    }
    if arena.mem_stats_on() != 0 {
        arena.mem_sample()
    }
}

fn engine_fill_focus() {
    arena.fill_focus_chain()
}

fn engine_focus_depth() -> int {
    return arena.chain_nodes.len
}

fn engine_focus_node(i: int) -> int {
    if i < 0 {
        return 0
    }
    if i >= arena.chain_nodes.len {
        return 0
    }
    return arena.chain_nodes[i]
}

fn engine_focus_ctx(i: int) -> int {
    if i < 0 {
        return 0
    }
    if i >= arena.chain_ctxs.len {
        return 0
    }
    return arena.chain_ctxs[i]
}

fn engine_focus_step(back: int) -> int {
    return arena.focus_step(back)
}

fn engine_focus_captures_text() -> int {
    return arena.focus_captures_text()
}

/// Node id that currently holds focus (0 = none). Stable across a keyed
/// reorder, because the row's node is moved rather than rebuilt.
fn engine_focus_id() -> int {
    return arena.focus_id
}

fn engine_key(key: int) -> int {
    return input.key(key)
}

/// Insert UTF-8 into the focused input (IME commit, paste). Headless tests
/// can call this instead of synthesizing one key per byte.
fn engine_insert(text: string) -> int {
    return input.insert_text(text)
}

/// IME composition overlay on the focused input. Empty clears the mark.
fn engine_marked(text: string) -> int {
    return input.mark_text(text)
}

fn engine_set_mods(mods: int) {
    arena.ev_mods = mods
}

fn engine_key_ev(key: int, mods: int) -> int {
    arena.ensure()
    arena.ev_mods = mods
    return platform.plat_key_ev(key, mods)
}

/// Key release, from hosts that deliver it. Runs the focused node's
/// `on_key_up`, then `on_key_press` — the down→up cycle.
fn engine_key_up(key: int, mods: int) -> int {
    arena.ensure()
    return input.key_handlers(key, mods, 1)
}

// --- engine trampolines ---
/// Cocoa calls these through zeus_plat.c (`loam_zeus_engine_*`). Do not use
/// from app code; use `App`, clicks, and signals instead.

fn engine_paint() {
    arena.damage_frame_begin()
    scene.paint()
}

/// One host frame with its own delta. `zeus_step(delta_ms)` in the runtime passes the
/// delta here; the cap keeps a backgrounded app from jumping when it wakes.
/// Tests and headless pumps call `engine_step()` (a nominal 16 ms).
fn engine_step_dt(dt_ms: int) -> int {
    let mut delta_ms = dt_ms
    if delta_ms <= 0 {
        delta_ms = 16
    }
    if delta_ms > 64 {
        delta_ms = 64
    }
    let d = scene.step(delta_ms)
    // A layout-driving `animate` reflows in this same frame so paint sees
    // the new box. Hover / press still skip layout: they never push a
    // layout-anim binding.
    if arena.take_layout_anim_moved() != 0 {
        apply_layout_anims()
        if arena.root_id > 0 {
            layout.layout(arena.win_w, arena.win_h)
            arena.layout_dirty = 0
            layout_gen = layout_gen + 1
        }
    }
    // While an async op is in flight or a spawn waits, hosts must keep
    // drawing frames: only a frame's tick advances them. Coasting scroll
    // is the same: keep frames until velocity and overscroll settle.
    if async.busy() != 0 {
        return 1
    }
    if arena.physics_live() != 0 {
        return 1
    }
    if arena.anim_live() != 0 {
        return 1
    }
    return d
}

fn engine_step() -> int {
    return engine_step_dt(16)
}

/// Milliseconds until the next async timer is due (0 = none; -1 = a spawn
/// waits). Native hosts that stop drawing when idle use this to schedule the
/// next frame exactly at the deadline. Coasts at ~60 fps while a scroller
/// is in motion.
fn engine_next_ms() -> int {
    if arena.physics_live() != 0 {
        return 16
    }
    if arena.anim_live() != 0 {
        return 16
    }
    if arena.spin_live() != 0 {
        return 16
    }
    // A shown scrollbar thumb needs one wake at its hide deadline.
    let bar = arena.bar_next_ms()
    let due = async.next_due()
    if bar > 0 {
        if due <= 0 || bar < due {
            return bar
        }
    }
    return due
}

/// Move `sig` toward `to` over `ms` milliseconds.
///
/// **Behaviour change (Phase 3):** the signal's *state* moves to `to` once —
/// every effect bound to `sig` re-runs once — and the moving value is a
/// paint-only overlay interpolated on the animation track pool. Effects no
/// longer re-run per frame, and nothing re-runs inside the tick at all. A new
/// call retargets an in-flight animation from its current value. `ms == 0`
/// jumps; before the first frame it jumps too (nothing animates at boot).
///
/// A layout prop the write lands on (width / height / a pin) does not jump
/// to `to`: it stays at its current length and tweens on the same track,
/// reflowing each frame. Paint-only readers (`Progress`, `anim_paint`) still
/// use the overlay. Hover / press never reflow.
fn animate(sig: Signal<int>, to: int, ms: int) {
    arena.anim_signal(sig.id, to, ms)
}

// --- Phase 3 proof harness ------------------------------------------------
/// Component-function runs since boot. Flat across an animation.
fn proof_components() -> int {
    return arena.component_runs
}
/// Reactive-effect runs since boot. Flat across an animation.
fn proof_effects() -> int {
    return track.runs
}
/// Signal setters fired from inside the animation tick. Must stay 0.
fn proof_signal_writes() -> int {
    return arena.anim_signal_writes
}
/// Active animation tracks.
fn proof_anim_live() -> int {
    return arena.anim_live_count()
}
/// 1 while an indeterminate spinner is visible and not reduced-motion-suppressed.
fn proof_spin_live() -> int {
    return arena.spin_live()
}
/// Allocations since boot (runtime allocator). A frame that only animates
/// allocates nothing, so this must not move while a track is running.
fn proof_allocs() -> int {
    return platform.plat_alloc_count()
}
/// The paint value a bound signal currently resolves to: the interpolated
/// overlay while `animate` runs, else the signal's state. Tests use it to see
/// the animation without a component thunk re-running.
fn anim_paint(sig: Signal<int>) -> int {
    return arena.sig_val(sig.id)
}

/// Shape a 0..1000 linear progress into the named `EASE` curve. Same helper
/// the track pool uses; tests lock samples so a control-point or solver
/// change is visible.
fn anim_ease(easing: int, t: int) -> int {
    return arena.anim_ease(easing, t)
}
/// Host / app reduced-motion preference: animations jump to their final value.
fn set_reduced_motion(on: bool) {
    arena.ensure()
    if on {
        arena.reduced = 1
    } else {
        arena.reduced = 0
    }
}

/// Host trampoline: the OS reports a reduced-motion preference (Cocoa, iOS,
/// web `prefers-reduced-motion`, Android animator scale).
fn engine_set_reduced_motion(on: int) {
    arena.ensure()
    arena.reduced = on
}

/// Host trampoline and test hook: set the safe-area insets the next layout
/// pass will read (`plat_inset_*`). iOS / Android already call the C setter
/// from the view; tests use this so a notched viewport is deterministic.
fn engine_set_insets(top: int, right: int, bottom: int, left: int) {
    arena.ensure()
    platform.plat_set_insets(top, right, bottom, left)
    arena.mark_layout()
}

/// Test hook: 1 = treat this process as an overlay-scroll (touch) host.
/// iOS / Android already compile that way; desktop tests use this so a
/// 44dp hit target can be asserted without a device.
fn engine_set_overlay_scroll(on: int) {
    arena.ensure()
    platform.plat_set_overlay_scroll(on)
}

/// One headless host frame: async tick, rebuild + layout, then paint. Tests
/// use this instead of calling `engine_layout` by hand.
fn pump_frame() {
    engine_layout(arena.win_w, arena.win_h)
    engine_paint()
}

fn engine_click(px: int, py: int) -> int {
    return input.click(px, py)
}

fn click_id(id: int) -> int {
    let mut i = id
    while i > 0 {
        if arena.nodes[i].click_fn > 0 {
            return click_node(i)
        }
        i = arena.nodes[i].parent
    }
    return click_node(id)
}

/// Click the centre of `id`, in *window* coordinates: `nodes[id].x/y` are
/// content coordinates, so a scrolled node needs its scrollers' offsets
/// removed or the point lands off screen.
fn click_node(id: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= arena.nodes.len {
        return 0
    }
    let o = layout.screen_origin(id)
    let x = o.x + arena.nodes[id].w / 2
    let y = o.y + arena.nodes[id].h / 2
    return input.click(x, y)
}

/// Node id whose `text` or `a11y_label` equals `label` (tests, headless
/// hosts). 0 when nothing visible matches. Hidden nodes are skipped.
fn engine_find_text(label: string) -> int {
    let n = arena.nodes.len
    for i in 1..n {
        if arena.want_show(i) == 0 {
            continue
        }
        if fmt.eq(arena.nodes[i].text, label) {
            return i
        }
        if fmt.eq(arena.nodes[i].a11y_label, label) {
            return i
        }
    }
    return 0
}

/// Ancestor-aware text presence for tests: 1 when a node whose ancestors are
/// all visible carries `label`. `engine_find_text` only checks the node's own
/// visibility, so it cannot see a child of a hidden container.
fn text_visible(label: string) -> bool {
    let n = arena.nodes.len
    for i in 1..n {
        if arena.shown_in_tree(i) == 0 {
            continue
        }
        if fmt.eq(arena.nodes[i].text, label) {
            return true
        }
        if fmt.eq(arena.nodes[i].a11y_label, label) {
            return true
        }
    }
    return false
}

/// Node id whose `a11y_role` equals `role` (tests, headless hosts); the
/// first match in tree order, 0 when none is visible.
fn engine_find_role(role: string) -> int {
    let n = arena.nodes.len
    for i in 1..n {
        if arena.want_show(i) == 0 {
            continue
        }
        if fmt.eq(arena.nodes[i].a11y_role, role) {
            return i
        }
    }
    return 0
}

let mut A11Y_out: []int = []int {}

fn a11y_push(s: string) {
    let mut i = 0
    while i < s.len {
        push(A11Y_out, s[i])
        i = i + 1
    }
}

fn a11y_num(v: int) {
    let mut x = v
    if x < 0 {
        push(A11Y_out, 45)
        x = 0 - x
    }
    if x == 0 {
        push(A11Y_out, 48)
        return
    }
    let mut buf = []int {}
    while x > 0 {
        push(buf, 48 + x % 10)
        x = x / 10
    }
    let mut k = buf.len
    while k > 0 {
        k = k - 1
        push(A11Y_out, buf[k])
    }
}

/// Counts layout passes. A host that mirrors the semantic tree (`engine_a11y_dump`)
/// polls this and only re-dumps when it moved: the dump builds a fresh string
/// every call and strings are never freed, so dumping per paint frame leaked
/// ~16 KB a frame on the web host.
let mut layout_gen: int = 0

fn engine_layout_gen() -> int {
    return layout_gen
}

/// Serialize the visible **semantic tree** for an accessibility mirror (§2.3):
/// one `depth<TAB>role<TAB>label<TAB>x<TAB>y<TAB>w<TAB>h` line per node
/// carrying a role, a label, or visible text. Geometry lets a native host
/// place accessible frames; the web mirror uses role and label only. The UI
/// stays canvas — hosts relay this to a visually-hidden DOM on web, or to
/// `NSAccessibility` on native. A node with a label but no role is a `text`
/// node; the label falls back to its visible text.
///
/// Builds a fresh string, and strings are never freed: a host that polls
/// (the web mirror) reads `engine_a11y_bytes` instead, which hands back the
/// refcounted byte buffer to copy and drop.
fn engine_a11y_dump() -> string {
    a11y_build()
    return string_from_bytes(A11Y_out)
}

/// The semantic-tree lines as bytes (same content as `engine_a11y_dump`), in
/// a `[]int` the host copies out and drops — no string, nothing leaks.
fn engine_a11y_bytes() -> []int {
    a11y_build()
    return A11Y_out
}

fn a11y_build() {
    A11Y_out = []int {}
    let n = arena.nodes.len
    let mut i = 1
    while i < n {
        if arena.want_show(i) != 0 {
            let role = arena.nodes[i].a11y_role
            let label = arena.nodes[i].a11y_label
            let txt = arena.nodes[i].text
            if role.len > 0 || label.len > 0 || txt.len > 0 {
                let mut r = role
                let mut l = label
                if l.len == 0 {
                    l = txt
                }
                if r.len == 0 {
                    r = "text"
                }
                let mut d = 0
                let mut p = arena.nodes[i].parent
                while p > 0 {
                    d = d + 1
                    p = arena.nodes[p].parent
                }
                a11y_num(d)
                push(A11Y_out, 9)
                a11y_push(r)
                push(A11Y_out, 9)
                a11y_push(l)
                push(A11Y_out, 9)
                a11y_num(arena.nodes[i].x)
                push(A11Y_out, 9)
                a11y_num(arena.nodes[i].y)
                push(A11Y_out, 9)
                a11y_num(arena.nodes[i].w)
                push(A11Y_out, 9)
                a11y_num(arena.nodes[i].h)
                push(A11Y_out, 10)
            }
        }
        i = i + 1
    }
}

/// Inspector dump of the retained tree (devtools §2.4): one
/// `id<TAB>parent<TAB>x<TAB>y<TAB>w<TAB>h<TAB>role<TAB>label` line per visible
/// node, in tree order. Geometry is what the last layout pass produced.
fn engine_tree_dump() -> string {
    A11Y_out = []int {}
    let n = arena.nodes.len
    let mut i = 1
    while i < n {
        if arena.want_show(i) != 0 {
            a11y_num(i)
            push(A11Y_out, 9)
            a11y_num(arena.nodes[i].parent)
            push(A11Y_out, 9)
            a11y_num(arena.nodes[i].x)
            push(A11Y_out, 9)
            a11y_num(arena.nodes[i].y)
            push(A11Y_out, 9)
            a11y_num(arena.nodes[i].w)
            push(A11Y_out, 9)
            a11y_num(arena.nodes[i].h)
            push(A11Y_out, 9)
            a11y_push(arena.nodes[i].a11y_role)
            push(A11Y_out, 9)
            let l = arena.nodes[i].a11y_label
            if l.len > 0 {
                a11y_push(l)
            } else {
                a11y_push(arena.nodes[i].text)
            }
            push(A11Y_out, 10)
        }
        i = i + 1
    }
    return string_from_bytes(A11Y_out)
}

/// Inspector dump of live signal values (devtools §2.4): one `id<TAB>value`
/// line per int-mirrored signal slot.
fn engine_signals_dump() -> string {
    A11Y_out = []int {}
    let n = arena.sigs.len
    let mut i = 0
    while i < n {
        a11y_num(i)
        push(A11Y_out, 9)
        a11y_num(arena.sigs[i])
        push(A11Y_out, 10)
        i = i + 1
    }
    return string_from_bytes(A11Y_out)
}

/// Restore signal values from an `engine_signals_dump()` snapshot. Returns how
/// many slots were applied. This is the hot-reload primitive (§2.5): save the
/// arena before a rebuild, restore after. Ids are positional, so the dev loop
/// should only restore when the new build's signal set still lines up.
fn engine_state_load(s: string) -> int {
    let mut i = 0
    let mut applied = 0
    while i < s.len {
        let mut id = 0
        let mut have_id = 0
        while i < s.len {
            let b = s[i]
            i = i + 1
            if b == 9 {
                break
            }
            if b == 10 {
                break
            }
            if b >= 48 {
                if b <= 57 {
                    id = id * 10 + (b - 48)
                    have_id = 1
                }
            }
        }
        let mut v = 0
        let mut vhave = 0
        let mut neg = 0
        while i < s.len {
            let b = s[i]
            if b == 10 {
                i = i + 1
                break
            }
            if b == 45 {
                neg = 1
            } else if b >= 48 {
                if b <= 57 {
                    v = v * 10 + (b - 48)
                    vhave = 1
                }
            }
            i = i + 1
        }
        if have_id == 1 {
            if vhave == 1 {
                if neg == 1 {
                    v = 0 - v
                }
                arena.store_sig(id, v)
                applied = applied + 1
            }
        }
    }
    return applied
}

/// Whether a node is currently shown by its own show binding (tests).
/// Hidden ancestors still hide it from paint and hit tests.
fn node_visible(id: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= arena.nodes.len {
        return 0
    }
    return arena.want_show(id)
}

/// Click the control whose label or `a11y_label` is `label`. Tests use this
/// instead of pixel coordinates.
fn engine_click_text(label: string) -> int {
    let id = engine_find_text(label)
    if id <= 0 {
        return 0
    }
    return click_id(id)
}

fn engine_scroll(px: int, py: int, dx: int, dy: int) -> int {
    return input.scroll(px, py, dx, dy)
}

/// Discrete scroll step (mouse wheel notch / web line wheel): applies the
/// delta with no momentum. Tests and hosts use this for input that must stop
/// exactly where it lands.
fn engine_scroll_step(px: int, py: int, dx: int, dy: int) -> int {
    return input.scroll_step(px, py, dx, dy)
}

/// Mouse-wheel notch: eases to the target over ~150 ms (browser feel).
fn engine_scroll_smooth(px: int, py: int, dx: int, dy: int) -> int {
    return input.scroll_smooth(px, py, dx, dy)
}

fn engine_drag(px: int, py: int) -> int {
    return input.drag(px, py)
}

fn engine_mouseup() {
    input.mouseup()
}

fn engine_hover(px: int, py: int) -> int {
    return input.hover(px, py)
}

fn engine_over_button() -> int {
    return input.over_button()
}

/// CSS cursor name under the pointer: the most recently created node with an
/// explicit `cursor` wins (children outrank parents). "" = default arrow.
fn engine_cursor() -> string {
    return input.cursor_at()
}

/// Set a cursor name directly on any node (native thumbs have no props).
fn cursor(n: Node, s: string) -> Node {
    arena.nodes[n.id].cursor = s
    return n
}

fn draw_count() -> int {
    return scene.draws.len
}

/// Op kind of draw `i` (tests): 1 fill, 2 text, 7 clip, 11 gradient, 12 shadow.
fn draw_op(i: int) -> int {
    return scene.draws[i].kind
}
/// Left edge of draw `i` (tests).
fn draw_x(i: int) -> int {
    return scene.draws[i].x
}
/// Top edge of draw `i` (tests).
fn draw_y(i: int) -> int {
    return scene.draws[i].y
}
/// Width of draw `i` (tests).
fn draw_w(i: int) -> int {
    return scene.draws[i].w
}
/// Height of draw `i` (tests).
fn draw_h(i: int) -> int {
    return scene.draws[i].h
}
/// Colour of draw `i` (tests).
fn draw_rgb(i: int) -> int {
    return scene.draws[i].rgb
}
/// Corner radius of draw `i` (tests).
fn draw_radius(i: int) -> int {
    return scene.draws[i].radius
}
/// Alpha of draw `i` (tests).
fn draw_alpha(i: int) -> int {
    return scene.draws[i].alpha
}
/// The `font` field of draw `i`: pixel size for text, stroke width for a
/// stroke, blur for a shadow, gradient axis for a gradient (tests).
fn draw_font(i: int) -> int {
    return scene.draws[i].font
}
/// The `value` field of draw `i` (tests).
fn draw_value(i: int) -> int {
    return scene.draws[i].value
}
/// The `text` field of draw `i` (tests).
fn draw_text(i: int) -> string {
    return scene.draws[i].text
}

/// Layout results for tests: the box of the node that matched
/// `engine_find_text`. Positions are window-space after the last layout.
fn node_x(id: int) -> int {
    return arena.nodes[id].x
}

/// A node's fill as the paint pass sees it: a stored role token resolved
/// against the current appearance. Tests use it to prove a theme switch
/// repaints without re-running any prop.
fn node_background_rgb(id: int) -> int {
    arena.ensure()
    return arena.paint_rgb(arena.nodes[id].bg)
}

/// A node's accessible label (or its text when it has none), for tests.
fn node_label(id: int) -> string {
    if arena.nodes[id].a11y_label.len > 0 {
        return arena.nodes[id].a11y_label
    }
    return arena.nodes[id].text
}

/// Resolved foreground (text / icon tint) of a node id, as `node_background_rgb`.
fn node_color_rgb(id: int) -> int {
    arena.ensure()
    return arena.fg_of(id)
}

/// Laid-out top edge of a node id. The id-based accessors exist for tests
/// and engine code that hold an id rather than a `Node`.
fn node_y(id: int) -> int {
    return arena.nodes[id].y
}

/// Laid-out width of a node id; see `node_y`.
fn node_width(id: int) -> int {
    return arena.nodes[id].w
}

/// Laid-out height of a node id; see `node_y`.
fn node_height(id: int) -> int {
    return arena.nodes[id].h
}

/// Parent id in the retained tree (0 = root). Tests walk scroll chains with this.
fn node_parent(id: int) -> int {
    return arena.nodes[id].parent
}

/// Engine kind: 11 is a scroll pane.
fn node_kind(id: int) -> int {
    return int(arena.nodes[id].kind)
}

/// Current vertical scroll offset of node `id` (tests, `scroll_to`).
fn node_scroll_y(id: int) -> int {
    return arena.nodes[id].scroll_y
}

/// Current horizontal scroll offset of node `id`.
fn node_scroll_x(id: int) -> int {
    return arena.nodes[id].scroll_x
}

/// Max vertical scroll of node `id` (`content - viewport`, 0 if no overflow).
fn node_scroll_max(id: int) -> int {
    return arena.scroll_max(id)
}

/// Live slot counts (diagnostics for tests). `nodes` includes dead slots
/// waiting to be recycled; `sigs` is the same for signals. A streaming `For`
/// that rebuilds without growing the tree keeps both constant.
fn arena_nodes() -> int {
    return arena.nodes.len
}

fn arena_sigs() -> int {
    return arena.sigs.len
}

/// Byte size of one arena node record (diagnostics for the Phase 11 layout
/// steps).
fn node_bytes() -> int {
    if arena.nodes.len == 0 {
        return 0
    }
    return __sizeof(arena.nodes[0])
}

/// Total bytes held by live arena node records.
fn arena_bytes() -> i64 {
    if arena.nodes.len == 0 {
        return 0
    }
    return i64(arena.nodes.len) * i64(__sizeof(arena.nodes[0]))
}

/// Phase 0 diagnostics: live (non-recycled) node count. Additive; no
/// allocation behavior reads it. See `docs/mem-baseline.md`.
fn mem_live_nodes() -> int {
    return arena.mem_live_nodes()
}

/// Phase 0 diagnostics: total arena bytes across every bucket (nodes, signals,
/// interning, animation, misc). Additive; no allocation behavior reads it.
fn mem_bytes() -> i64 {
    return arena.mem_total_bytes()
}

/// Phase 0 diagnostics: print the full arena bucket report on demand. Same
/// lines the on-exit report prints; for tests and probes that need to see which
/// bucket moved between frames.
fn mem_dump() {
    arena.mem_report()
}

/// Phase 1 damage diagnostics: 1 when the last frame repainted the whole
/// surface (layout, tree rebuild, resize, or an unmarked global change).
/// Additive; no paint behavior reads these.
fn damage_full() -> int {
    return arena.damage_full
}

/// Phase 1 damage diagnostics: rects contributed by the last frame's paint.
/// Empty when `damage_full()` is 1. Additive.
fn damage_count() -> int {
    return arena.damage.len
}

/// Phase 2 node-arena ceiling (see `arena.alloc_node`). Default 65535, the
/// `u16` id maximum. Additive diagnostics; `engine_set_node_cap` is a tuning /
/// test hook.
fn node_cap() -> int {
    return arena.node_cap_get()
}

fn node_overflow() -> int {
    return arena.node_overflow_get()
}

fn engine_set_node_cap(n: int) {
    arena.set_node_cap(n)
}

// --- Phase 4 raster diagnostics (additive) --------------------------------
// Thin wrappers so tests and probes can drive the framebuffer and the color
// tables without reaching into the module's globals.

fn raster_ensure(lw: int, lh: int, scale: int) {
    raster.raster_ensure(lw, lh, scale)
}

fn raster_width() -> int {
    return raster.raster_width()
}

fn raster_height() -> int {
    return raster.raster_height()
}

fn raster_scale() -> int {
    return raster.raster_scale()
}

fn raster_bytes() -> int {
    return raster.raster_bytes()
}

fn raster_generation() -> int {
    return raster.raster_generation()
}

fn raster_realloc_count() -> int {
    return raster.raster_realloc_count()
}

fn raster_get(x: int, y: int, c: int) -> int {
    return raster.raster_get(x, y, c)
}

fn raster_set(x: int, y: int, r: int, g: int, b: int) {
    raster.raster_set(x, y, r, g, b)
}

fn raster_blend(x: int, y: int, r: int, g: int, b: int, a: int) {
    raster.raster_blend(x, y, r, g, b, a)
}

fn raster_dither(x: int, y: int) -> int {
    return raster.raster_dither(x, y)
}

fn raster_srgb_to_lin(b: int) -> int {
    return raster.raster_srgb_to_lin(b)
}

fn raster_lin_to_srgb(b: int) -> int {
    return raster.raster_lin_to_srgb(b)
}

fn raster_clear(r: int, g: int, b: int) {
    raster.raster_clear(r, g, b)
}

fn raster_checksum() -> int {
    return raster.raster_checksum()
}

/// Fill a rounded rectangle as one region (whole surface).
fn raster_fill_round_rect_whole(x: int, y: int, w: int, h: int, rad: int,
                                cr: int, cg: int, cb: int, alpha: int) {
    raster.raster_round_rect(float(x), float(y), float(w), float(h), float(rad))
    raster.raster_fill_whole(cr, cg, cb, alpha)
}

/// Fill the same rounded rectangle in 256x256 tiles. Byte-identical to
/// `_whole` is the seam guarantee.
fn raster_fill_round_rect_tiled(x: int, y: int, w: int, h: int, rad: int,
                                cr: int, cg: int, cb: int, alpha: int) {
    raster.raster_round_rect(float(x), float(y), float(w), float(h), float(rad))
    raster.raster_fill_tiled(cr, cg, cb, alpha)
}

/// Fill a rounded rectangle with a linear gradient from `c0` to `c1`.
/// `axis` 0 is top-to-bottom, 1 is left-to-right.
fn raster_fill_round_rect_gradient(x: int, y: int, w: int, h: int, rad: int,
                                   c0: int, c1: int, axis: int, alpha: int) {
    raster.raster_round_rect(float(x), float(y), float(w), float(h), float(rad))
    raster.raster_fill_gradient_tiled(c0, c1, axis, alpha, x, y, x + w, y + h)
}

/// Draw a rounded-rect border. `bw` is the device-pixel thickness; a hairline
/// (<= 1px) snaps to the pixel grid.
fn raster_stroke_round_rect(x: int, y: int, w: int, h: int, rad: int, bw: int,
                            cr: int, cg: int, cb: int, alpha: int) {
    raster.raster_stroke_round_rect(float(x), float(y), float(w), float(h),
                                    float(rad), float(bw), cr, cg, cb, alpha)
}

/// The same border in DEVICE coordinates (float) for callers that compute
/// `logical * scale`, where edges are fractional. This is the path the renderer
/// uses, and the one hairline snapping exists for.
fn raster_stroke_round_rect_dev(x: float, y: float, w: float, h: float,
                                rad: float, bw: float,
                                cr: int, cg: int, cb: int, alpha: int) {
    raster.raster_stroke_round_rect(x, y, w, h, rad, bw, cr, cg, cb, alpha)
}

/// Draw a drop shadow for a rounded rect, under whatever is drawn next.
/// `dx`/`dy` are the device offset, `blur` the device blur radius, `alpha` the
/// peak opacity (0..255).
fn raster_shadow_rect(x: int, y: int, w: int, h: int, rad: int,
                      dx: int, dy: int, blur: int,
                      cr: int, cg: int, cb: int, alpha: int) {
    raster.raster_shadow_rect(float(x), float(y), float(w), float(h), float(rad),
                              float(dx), float(dy), float(blur), alpha, cr, cg, cb)
}

/// Clear the damage clip: the next tiled draws cover the whole surface again.
fn raster_clip_reset() {
    raster.raster_clip_reset()
}

/// Restrict the next tiled draws to a device-space box.
fn raster_clip_box(x0: int, y0: int, x1: int, y1: int) {
    raster.raster_clip_box(x0, y0, x1, y1)
}

/// Curve flattening tolerance in device pixels (0.25): the one source of truth
/// for every arc and rounded corner.
fn raster_flat_tol() -> float {
    return raster.raster_flat_tol()
}

// --- the raster scene pass (Phase 4) ---------------------------------------

/// Rasterize the current draw list into the framebuffer we own, at `scale`,
/// on a background colour. Returns how many ops were rasterized.
fn scene_rasterize(scale: int, br: int, bg: int, bb: int) -> int {
    return scene.rasterize(scale, br, bg, bb)
}

/// Ops of `kind` the raster pass could not rasterize yet. Counted, never
/// silent, so a gap is a number rather than something to notice in a picture.
fn scene_raster_unhandled(kind: int) -> int {
    return scene.raster_unhandled(kind)
}

fn scene_raster_unhandled_total() -> int {
    return scene.raster_unhandled_total()
}

/// Clips with a radius that the raster pass currently treats as square.
fn scene_raster_rounded_clips() -> int {
    return scene.raster_rounded_clip_count()
}

/// Register a decoded image slot under the `src` string draw ops carry, so the
/// raster pass blits from our own cache instead of the host.
fn scene_register_image(src: string, slot: int) -> int {
    return scene.raster_register_image(src, slot)
}

/// Load the font the raster pass draws text with (a file path). Until this is
/// called, text ops are counted as unhandled rather than dropped silently.
fn scene_load_font(src: string) -> int {
    return scene.raster_load_font(src)
}

fn scene_font_is_ready() -> int {
    return scene.raster_font_is_ready()
}

/// Glyphs the pass has composited from the atlas, and glyphs it wanted but
/// could not get.
fn scene_glyphs_drawn() -> int {
    return scene.raster_glyphs_drawn_count()
}

fn scene_glyphs_missing() -> int {
    return scene.raster_glyphs_missing_count()
}

// --- multi-contour fills (holes / winding) --------------------------------

fn raster_multi_begin() {
    raster.raster_multi_begin()
}

fn raster_multi_add_circle(cx: int, cy: int, r: int, sign: int) {
    raster.raster_multi_add_circle(float(cx), float(cy), float(r), sign)
}

fn raster_multi_add_poly(xs: []float, ys: []float, sign: int) {
    raster.raster_multi_add_poly(xs, ys, sign)
}

fn raster_multi_count() -> int {
    return raster.raster_multi_count()
}

fn raster_fill_multi(cr: int, cg: int, cb: int, alpha: int) {
    raster.raster_fill_multi(cr, cg, cb, alpha)
}

/// Add a glyph's contours to the multi-contour set. Points are in FONT UNITS;
/// `sc` is px/unitsPerEm and `(pen_x, pen_y)` the device-space baseline origin.
/// Winding signs are derived from contour orientation, so no sign is passed.
fn raster_multi_add_glyph(xs: []int, ys: []int, on: []int, ends: []int,
                          pen_x: float, pen_y: float, sc: float) {
    raster.raster_multi_add_glyph(xs, ys, on, ends, pen_x, pen_y, sc)
}

/// Rasterize the multi-contour set into an offscreen single-channel (R8) mask
/// over the device box [x0,x1) x [y0,y1). One tile a side at most. Returns 1 on
/// success. The mask is scratch for the caller: read it with the accessors
/// below, it is reused by the next call.
fn raster_multi_to_mask(x0: int, y0: int, x1: int, y1: int) -> int {
    return raster.raster_multi_to_mask(x0, y0, x1, y1)
}

fn raster_mask_w() -> int {
    return raster.raster_mask_w()
}

fn raster_mask_h() -> int {
    return raster.raster_mask_h()
}

/// Mask coverage 0..255 at a point in the mask's own space.
fn raster_mask_get(x: int, y: int) -> int {
    return raster.raster_mask_get(x, y)
}

// --- glyph atlas (Phase 4) --------------------------------------------------

/// Gamma-corrected coverage 0..255 for a raw coverage 0..255. Glyph coverage
/// goes through this on insert, so text weight is one documented constant.
fn atlas_gamma(c: int) -> int {
    return atlas.atlas_gamma(c)
}

/// Subpixel-x bucket: 1/4-px phase at sizes <= 16 LOGICAL px, 0 above.
fn atlas_subx_bucket(size_logical: int, frac_x: float) -> int {
    return atlas.atlas_subx_bucket(size_logical, frac_x)
}

/// Device offset (0, 0.25, 0.5, 0.75) baked in for a subpixel bucket.
fn atlas_subx_offset(bucket: int) -> float {
    return atlas.atlas_subx_offset(bucket)
}

/// Atlas slot for a key, or -1. A hit is promoted to most-recently-used.
fn atlas_lookup(font: int, gid: int, size: int, subx: int) -> int {
    return atlas.atlas_lookup(font, gid, size, subx)
}

/// Ensure a glyph is in the atlas (rasterizing on a miss) and return its slot,
/// or -1 when it cannot be atlased. `size` is the DEVICE pixel size; `subx` a
/// bucket from `atlas_subx_bucket`. The mask is stored relative to the pen, so
/// blit it at the integer pen position.
fn atlas_intern(font: int, gid: int, size: int, subx: int,
                xs: []int, ys: []int, on: []int, ends: []int, upm: int) -> int {
    return atlas.atlas_intern(font, gid, size, subx, xs, ys, on, ends, upm)
}

/// Composite an atlased glyph onto the framebuffer at an integer pen position.
fn atlas_blit(s: int, pen_x: int, pen_y: int, r: int, g: int, b: int, alpha: int) {
    atlas.atlas_blit(s, pen_x, pen_y, r, g, b, alpha)
}

fn atlas_cov(s: int, x: int, y: int) -> int {
    return atlas.atlas_cov(s, x, y)
}

fn atlas_glyph_w(s: int) -> int {
    return atlas.atlas_glyph_w(s)
}

fn atlas_glyph_h(s: int) -> int {
    return atlas.atlas_glyph_h(s)
}

fn atlas_glyph_origin_x(s: int) -> int {
    return atlas.atlas_glyph_origin_x(s)
}

fn atlas_glyph_origin_y(s: int) -> int {
    return atlas.atlas_glyph_origin_y(s)
}

/// Reset the atlas to a given square dimension. Test hook.
fn atlas_reset(dim: int) {
    atlas.atlas_reset(dim)
}

fn atlas_reset_default() {
    atlas.atlas_reset_default()
}

fn atlas_dim() -> int {
    return atlas.atlas_dim()
}

fn atlas_entry_count() -> int {
    return atlas.atlas_entry_count()
}

fn atlas_max_entries() -> int {
    return atlas.atlas_max_entries()
}

fn atlas_bytes() -> int {
    return atlas.atlas_bytes()
}

fn atlas_raster_count() -> int {
    return atlas.atlas_raster_count()
}

fn atlas_eviction_count() -> int {
    return atlas.atlas_eviction_count()
}

fn atlas_repack_count() -> int {
    return atlas.atlas_repack_count()
}

fn atlas_grow_count() -> int {
    return atlas.atlas_grow_count()
}

fn atlas_failure_count() -> int {
    return atlas.atlas_failure_count()
}

fn atlas_mem_bytes() -> i64 {
    return atlas.atlas_mem_bytes()
}

