/// Trend arrows for `Stat` deltas (lucide arrow-up-right / arrow-down-right).
const IC_TREND_UP: string =
"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M7 17 17 7'/><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M7 7h10v10'/></svg>"
const IC_TREND_DOWN: string =
"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m7 7 10 10'/><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M17 7v10H7'/></svg>"

/// A gap-arc loader ring (used by `Spinner`). Drawn as a 270° polyline: the
/// host SVG parsers are a line-only lucide subset (they skip `A`/`a` arcs), so
/// an arc motif would emit an `svg` op that draws nothing. At 16px the 19
/// chords are under a tenth of a pixel from a true arc.
const IC_LOADER: string =
"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M21 12L20.69 14.33L19.79 16.5L18.36 18.36L16.5 19.79L14.33 20.69L12 21L9.67 20.69L7.5 19.79L5.64 18.36L4.21 16.5L3.31 14.33L3 12L3.31 9.67L4.21 7.5L5.64 5.64L7.5 4.21L9.67 3.31L12 3'/></svg>"

/// Two offset sheets (`CopyButton`). Drawn as straight runs: the host SVG
/// readers skip `rect` and arc commands.
const IC_COPY: string =
"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M9 9h11v11H9z'/><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M5 15H4V4h11v1'/></svg>"

/// Magnifier (`SearchInput`).
const IC_SEARCH: string =
"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><circle cx='11' cy='11' r='7' fill='none' stroke='currentColor' stroke-width='1.5'/><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='m20 20-4-4'/></svg>"

