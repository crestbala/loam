const IC_EYE_OFF: string =
"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M2 12L5 8.2L8.5 5.8L12 5L15.5 5.8L19 8.2L22 12L19 15.8L15.5 18.2L12 19L8.5 18.2L5 15.8Z'/><circle cx='12' cy='12' r='3' fill='none' stroke='currentColor' stroke-width='1.5'/><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M3 3l18 18'/></svg>"

