//! zeusbase — the reactive core (signals, effects, derivations, context) and the
//! C boundary hooks the Zeus runtime implements. Everything the components and
//! `zeus` build on lives here, at the bottom of the stack, so a layer above can
//! name it without importing back up into `zeus`.
//!
//! `Node` and `Signal<T>` come from the `structs` leaf module; the internal
//! modules `arena`, `track`, and `platform` come from `zeuscore`. The C side
//! provides `loam_zeusbase_on_action`, `loam_zeusbase_on_range`, and friends
//! (see `packages/loam/runtime/zeus_plat.c`), and `zeus` re-exports them.
//!
//! Dependency direction is one-way: `zeus` imports this file, so this file must
//! never import `zeus` (that is an import cycle). Enums, consts, and fns
//! declared elsewhere reach here only by importing the module that declares
//! them — struct/type names resolve by name across loaded modules.

import "structs.loam"
import "enums.loam"
import "zeus_constants.loam"
import "zeuscore/geometry.loam"
import "zeuscore/platform.loam"
import "zeuscore/arena.loam"
import "zeuscore/layout.loam"
import "zeuscore/metrics.loam"
import "zeuscore/track.loam"
import "zeuscore/style.loam"
import "std:result"

// --- handles --------------------------------------------------------------

/// Wrap a raw arena slot as a `Signal<int>`. Same reason as `node_handle`:
/// the engine speaks ids, the API speaks handles.
fn signal_handle(id: int) -> Signal<int> {
    return Signal { id: id }
}

// --- signals (live Copy state) ---

/// Allocate a live cell. `T` is inferred from `value`.
///
/// Example:
/// ```
/// let count = zeus.signal(0)
/// zui.Button("+", on_click = fn() => count.set(count.get() + 1))
/// ```
/// Allocations made while a `For` / `refit` rebuild is running are owned by
/// that host (the C alloc hook records them) and are freed when the host
/// rebuilds or is torn down, so builders that create state do not grow the
/// signal arena.
fn signal<T>(value: T) -> Signal<T> {
    arena.ensure()
    let id = __sig_push(value)
    // The alloc hook filed this cell under the host rebuild scope; hand it to the
    // `scope` whose body is running if there is one, so a re-run frees it with
    // everything else the body created. One record, one owner, always.
    arena.record_sig(arena.owner_now(), id)
    return Signal { id: id }
}

/// Read the current value of `sig`. Reading inside a reactive scope (an
/// `effect`, a `computed`, or the thunk behind any widget prop) records
/// `sig` as a dependency of that scope, so a later `set` re-runs it.
/// Call as `sig.get()`.
fn get<T>(sig: Signal<T>) -> T {
    arena.ensure()
    // A memo behind `sig` may be stale; a read is the point of observation.
    track.pull(sig.id)
    track.note_read(sig.id)
    __sig_load(sig.id)
}
/// Write `value` into `sig`, then re-run every reactive scope that read it.
/// Writing the value it already holds is a no-op: nothing is notified, so
/// derivations built on `sig` do not recompute. Call as `sig.set(value)`.
fn set<T>(sig: Signal<T>, value: T) {
    arena.ensure()
    __sig_store(sig.id, value)
}

/// Read `sig` *without* subscribing the enclosing scope to it. Use when an
/// effect needs the current value but must not re-run when it changes —
/// notably read-modify-write (`c.set(c.peek() + 1)` inside an effect).
fn peek<T>(sig: Signal<T>) -> T {
    arena.ensure()
    track.pull(sig.id)
    __sig_load(sig.id)
}

/// Run `body` with dependency tracking suspended: signals read inside it
/// become dependencies of nothing. Writes still notify as usual.
fn untrack(body: fn()) {
    track.mute_begin()
    body()
    track.mute_end()
}

// --- interned handlers ----------------------------------------------------

/// Intern a handler or thunk, and record it as owned by the open rebuild
/// scope if there is one. A `For`/`refit` rebuild interns fresh closures per
/// row; when the host is torn down the recorded ids are freed and recycled,
/// so streaming lists do not leak handler envs.
fn intern_fn(h: fn()) -> int {
    let id = platform.plat_intern_fn(h)
    arena.record_intern(id, arena.owner_now())
    return id
}

fn intern_int(h: fn() -> int) -> int {
    let id = platform.plat_intern_int_fn(h)
    arena.record_intern(id, arena.owner_now())
    return id
}

fn intern_bool(h: fn() -> bool) -> int {
    let id = platform.plat_intern_bool_fn(h)
    arena.record_intern(id, arena.owner_now())
    return id
}

fn intern_str(h: fn() -> string) -> int {
    let id = platform.plat_intern_str_fn(h)
    arena.record_intern(id, arena.owner_now())
    return id
}

// --- scope owner ----------------------------------------------------------

/// Slot parents currently being built, innermost last. `ui_push` / `ui_pop`
/// bracket a `Box(...) { ... }` trailing block; the top of this stack is the
/// owner of any reactive scope created inside that block, so an effect dies
/// with the component's subtree instead of outliving it.
let mut ui_parents: []int = []int {}

fn ui_push(id: int) {
    push(ui_parents, id)
}

fn ui_pop() {
    if ui_parents.len > 0 {
        pop(ui_parents)
    }
}

/// Owner for a free-standing reactive scope: the `slot` parent currently
/// being built. An effect created inside a component therefore dies with
/// that component's subtree. 0 at top level — those live for the process.
fn effect_owner() -> int {
    if ui_parents.len > 0 {
        return ui_parents[ui_parents.len - 1]
    }
    return 0
}

// --- context (provide / inject) ---
// A `Context<T>` is a typed key. `provide` binds a value for the dynamic
// extent of `body`; `use_context` reads the topmost binding, or the default
// the context was created with. The bindings live in ordinary `Signal<T>`
// cells — the one generic store — so the open-scope stack itself is just ints
// (signal ids) and needs no per-type copy of the machinery.

/// A typed key for `provide` / `use_context`. The default travels on the
/// handle, so lookups need no side table; `T` must be Copy, as for `Signal`.
struct Context<T> {
    id: int,
    default_value: T,
}

let mut ctx_next_id: int = 1
/// Open `provide` scopes, as parallel stacks of (context id, value cell).
let mut ctx_stack_ctx: []int = []int {}
let mut ctx_stack_sig: []int = []int {}

/* The stack itself is untyped ints, so these helpers are concrete: a global
   read only from a generic body is not the one the codegen emits (see
   `signal` vs `computed`), and keeping the id bookkeeping here avoids that. */
fn ctx_take_id() -> int {
    let context_id = ctx_next_id
    ctx_next_id = ctx_next_id + 1
    return context_id
}

fn ctx_push(context_id: int, cell: int) {
    push(ctx_stack_ctx, context_id)
    push(ctx_stack_sig, cell)
}

fn ctx_pop() {
    pop(ctx_stack_ctx)
    pop(ctx_stack_sig)
}

/// Cell id of the topmost `provide` for `context_id`, or -1 when none is open.
fn ctx_cell(context_id: int) -> int {
    let n = ctx_stack_ctx.len
    let mut i = n
    while i > 0 {
        i = i - 1
        if ctx_stack_ctx[i] == context_id {
            return ctx_stack_sig[i]
        }
    }
    return -1
}

/// Create a typed context whose value is `default_value` until something `provide`s
/// one. `T` is inferred from `default_value`.
fn create_context<T>(default_value: T) -> Context<T> {
    arena.ensure()
    return Context { id: ctx_take_id(), default_value: default_value }
}

/// Make `value` the current binding of `ctx` for the dynamic extent of
/// `body`. Call as `provide(ctx, value, fn() { ... })`; scopes nest, and the
/// innermost binding wins.
fn provide<T>(ctx: Context<T>, value: T, body: fn()) {
    arena.ensure()
    let cell = signal(value)
    ctx_push(ctx.id, cell.id)
    body()
    ctx_pop()
}

/// The topmost provided value for `ctx`, else the default it was created with.
/// Reading a context does not subscribe the caller to anything.
fn use_context<T>(ctx: Context<T>) -> T {
    arena.ensure()
    let signal_id = ctx_cell(ctx.id)
    if signal_id < 0 {
        return ctx.default_value
    }
    // Read without subscribing: `__sig_load` is what `peek` wraps, and its
    // result type comes from the return type, so no `Signal<T>` value is
    // needed here.
    return __sig_load(signal_id)
}

// --- effects and derivations ---
// `styled` is the node-scoped effect every prop is built from. The two below
// are the free-standing forms: `effect` for a side effect, `computed` for a
// cached value. Both are ordinary reactive scopes — they read signals through
// `get`, so their dependencies are discovered, not declared.

/// Run `body` once now, then again whenever a signal it read changes.
/// Effects are the edges of the graph: `body` writes a signal, an arena
/// field, or the outside world — it never rebuilds the tree. Prefer a text
/// thunk (`Text("{{n.get()}}")`) for anything a widget can express; reach
/// for `effect` for the rest (logging, sync, imperative host calls).
///
/// ```
/// let n = zeus.signal(0)
/// zeus.effect(|| { fmt.println("n is now", n.get()) })
/// ```
fn effect(body: fn()) {
    effect_eid(body)
}

/// `effect`, returning the effect id so a `computed` can record itself as the
/// producer of its output signal (see `track.mark_produced`).
fn effect_eid(body: fn()) -> int {
    arena.ensure()
    let effect_id = track.alloc(intern_fn(body), effect_owner())
    // A nested scope outranks its parent, so a reader of what this effect
    // writes is flushed after it (glitch-free ordering).
    track.set_rank(effect_id, 1 + track.current_rank())
    track.run(effect_id)
    return effect_id
}

/// Batch `body`'s signal writes: each `set` re-runs no effect until the
/// outermost `batch` returns, then every affected effect runs once, in
/// dependency order. Use it when a handler writes several signals that feed
/// the same derivation, so it recomputes once instead of once per write.
///
/// ```
/// zeus.batch(fn() {
///     x.set(1)
///     y.set(2)
/// })
/// ```
fn batch(body: fn()) {
    track.batch_begin()
    body()
    track.batch_end()
}

/// Run `body` in a nested computation scope: it runs now and re-runs whenever a
/// signal it read changes, and **every reactive computation created inside it is
/// disposed before it re-runs**. Use it for a group of derived state that must
/// not outlive the run that created it (a per-run subscription, a transient
/// derivation). A plain `effect` instead keeps what it created across re-runs,
/// so its children are owned by the surrounding node, not by the effect.
///
/// The scope owns the arena too: signals and interned handlers created in its
/// body are recycled with it, so a scope that re-runs on every change does not
/// grow the arena. That is why structure belongs *outside* a scope — a re-run
/// must not build the tree.
///
/// ```
/// zeus.scope(|| {
///     let room = active_room.get()
///     zeus.effect(|| subscribe(room))   // disposed when `active_room` moves
/// })
/// ```
fn scope(body: fn()) {
    scope_eid(body)
}

/// `scope`, returning the scope's effect id.
fn scope_eid(body: fn()) -> int {
    arena.ensure()
    let effect_id = track.alloc_scope(intern_fn(body), effect_owner())
    track.set_rank(effect_id, 1 + track.current_rank())
    track.run(effect_id)
    return effect_id
}

/// Register `body` to run before the enclosing `effect` re-runs, so a
/// subscription the effect opened is closed before its body runs again.
/// Call inside an effect; a no-op outside one.
fn on_cleanup(body: fn()) {
    track.set_cleanup(track.current_eid(), intern_fn(body))
}

/// A cached derivation, generic over its value type. `calc` runs now, and
/// re-runs only when one of the signals *it* read actually changed value — not on
/// every read, and not when some unrelated signal moves. The result is a plain
/// `Signal<T>`, so a reader subscribes to the derivation rather than to its
/// inputs.
///
/// A derivation is lazy: when an input moves it is only marked stale, and the
/// body re-runs when something reads it (or when the frame's flush reaches one of
/// its readers). Each input's generation is recorded at read time, so a memo
/// whose inputs did not in fact move is skipped instead of recomputed.
///
/// ```
/// let first = zeus.signal("Ada")
/// let last = zeus.signal("Lovelace")
/// let full = zeus.computed(|| { "{{first.get()}} {{last.get()}}" })
/// zeus.Text("{{full.get()}}")
/// ```
fn computed<T>(calc: fn() -> T) -> Signal<T> {
    arena.ensure()
    // The owner that will dispose this memo: the innermost live `scope`, else the
    // host rebuild scope, else 0 (process-lifetime).
    let owner = arena.owner_now()
    // The output is reserved unbound: `T` may be a struct or a list with no
    // nameable default, and the first pull is what binds it.
    let out_id = platform.plat_sig_alloc_zero()
    // A closure can only be persisted through an environment that is a plain int
    // copy, and a `fn` value is not — so the body is stored in a raw signal cell
    // (whose payload is typed bytes) and rehydrated by id inside the thunk. That
    // is what makes one generic `computed<T>` possible for every `T`. The cell
    // builtins take a plain id, so no generic `signal` / `get` is instantiated at
    // a closure type.
    let holder_id = __sig_push(calc)
    let fn_id = platform.plat_intern_fn(|| {
        let reopened: fn() -> T = __sig_load(holder_id)
        let value: T = reopened()
        __sig_store(out_id, value)
    })
    // The runtime alloc hooks filed both cells under the host rebuild scope; hand
    // them to the scope that owns the memo row instead.
    arena.record_sig(owner, out_id)
    arena.record_sig(owner, holder_id)
    arena.record_intern(fn_id, owner)
    let effect_id = track.alloc_memo(fn_id, effect_owner())
    track.set_rank(effect_id, 1 + track.current_rank())
    track.mark_memo(out_id, effect_id)
    // Run once now, with the memo as the tracking scope, so it subscribes to the
    // signals it read.
    track.memo_recompute(effect_id, 1)
    let out: Signal<T> = Signal { id: out_id }
    return out
}

/// `computed` for a string derivation.
fn computed_str(calc: fn() -> string) -> Signal<string> {
    return computed(calc)
}

/// `computed` for a bool derivation.
fn computed_bool(calc: fn() -> bool) -> Signal<bool> {
    return computed(calc)
}

/// Wrap a raw arena slot as a `Node`. Ids are the only thing the engine
/// stores, so every allocator hands one back through here rather than
/// letting callers build a `Node` literal and desync from the arena.
fn node_handle(id: int) -> Node {
    return Node { id: id }
}
// --- unstyled allocators ---
/// Kinds: 1 box/row/col, 2 grid, 3 label, 4 button, 5 spacer, 6 progress,
/// 7 toggle, 8 check, 9 overlay, 10 input, 11 scroll, 12 svg, 13 slider.

fn raw_row() -> Node {
    let id = arena.alloc_node(1)
    arena.nodes[id].dir = 0
    return node_handle(id)
}
fn raw_col() -> Node {
    let id = arena.alloc_node(1)
    arena.nodes[id].dir = 1
    return node_handle(id)
}
fn raw_box() -> Node {
    return node_handle(arena.alloc_node(1))
}
fn raw_label(text: string) -> Node {
    let id = arena.alloc_node(3)
    arena.nodes[id].text = text
    return node_handle(id)
}
fn raw_button(text: string) -> Node {
    let id = arena.alloc_node(4)
    arena.nodes[id].text = text
    return node_handle(id)
}
fn raw_spacer() -> Node {
    return node_handle(arena.alloc_node(5))
}
fn raw_progress() -> Node {
    return node_handle(arena.alloc_node(6))
}
fn raw_slider() -> Node {
    return node_handle(arena.alloc_node(13))
}
fn raw_toggle() -> Node {
    return node_handle(arena.alloc_node(7))
}
fn raw_check(markup: string) -> Node {
    let id = arena.alloc_node(8)
    arena.nodes[id].text = markup
    return node_handle(id)
}
fn raw_overlay() -> Node {
    let id = arena.alloc_node(9)
    arena.nodes[id].pos = 1
    arena.nodes[id].enter_fade = 1
    arena.mark_chrome()
    return node_handle(id)
}
fn raw_input(placeholder: string) -> Node {
    let id = arena.alloc_node(10)
    arena.nodes[id].text = placeholder
    arena.nodes[id].focusable = 1
    arena.nodes[id].capture_text = 1
    return node_handle(id)
}
fn raw_scroll() -> Node {
    let id = arena.alloc_node(11)
    arena.nodes[id].dir = 1
    arena.nodes[id].overflow = 2
    return node_handle(id)
}
fn raw_svg(markup: string) -> Node {
    let id = arena.alloc_node(12)
    arena.nodes[id].text = markup
    return node_handle(id)
}
fn raw_image(src: string) -> Node {
    let id = arena.alloc_node(14)
    arena.nodes[id].text = src
    return node_handle(id)
}
fn raw_grid(columns: int, gap: int) -> Node {
    let id = arena.alloc_node(2)
    arena.nodes[id].grid_cols = u16(columns)
    arena.nodes[id].gap = u16(gap)
    return node_handle(id)
}
fn raw_hover(node: Node, sig: Signal<int>) -> Node {
    arena.nodes[node.id].hover_sig = sig.id
    return node
}

/// Text currently in an input (typed buffer, else placeholder).
fn input_value(node: Node) -> string {
    return arena.input_shown(node.id)
}

/// Replace the typed buffer for `node`. No-op if it is not an input.
fn set_input(node: Node, text: string) -> Node {
    let mut slot = arena.nodes[node.id].edit_slot
    if slot < 0 {
        arena.stamp_edits()
        slot = arena.nodes[node.id].edit_slot
    }
    if slot >= 0 {
        platform.plat_edit_set(slot, text)
    }
    return node
}

// --- tree ---

/// How many handler invokes were refused because the interned slot held a
/// closure of another signature. Zero is the contract. The intern table is
/// shared by the void / int / bool / string kinds, so a non-zero count means a
/// handler was interned as one kind and invoked as another — which used to be
/// undefined behaviour: a garbage return value on native (it landed in a signal
/// and read as a jittering UI) and a hard trap on wasm, which type-checks the
/// call. Exposed so a test can pin it at zero rather than hope.
fn intern_kind_mismatch_count() -> int {
    return platform.plat_intern_kind_mismatch_count()
}

/// Attach `node` under `parent`. Used by `ui_emit` for trailing blocks.
fn child(parent: Node, node: Node) -> Node {
    arena.ensure()
    push(arena.nodes[parent.id].kids, node.id)
    arena.nodes[node.id].parent = parent.id
    arena.mark_tree_at(parent.id)
    return parent
}

/// Run `handler` now and again whenever a `Signal` it `get`s changes.
/// The closure only updates paint state on existing nodes — it must not
/// call `child` or rebuild the tree.
fn styled(node: Node, handler: fn()) -> Node {
    arena.ensure()
    let effect_id = track.alloc(intern_fn(handler), node.id)
    track.run(effect_id)
    return node
}

// --- structural operators (per-node) ---
// One node at a time: insert / remove / move a single child. Zeus effects are
// barred from touching structure, so a list or an app reconciles through these
// rather than by re-running a build closure. `child` above is the append form;
// `insert_child(parent, node, count)` says the same thing at an explicit index.

/// Number of direct children of `node`.
fn child_count(node: Node) -> int {
    arena.ensure()
    if node.id <= 0 {
        return 0
    }
    if node.id >= arena.nodes.len {
        return 0
    }
    return arena.nodes[node.id].kids.len
}

/// The `i`-th direct child of `node` (0-based), or the empty handle when out of
/// range.
fn child_at(node: Node, i: int) -> Node {
    arena.ensure()
    if node.id <= 0 {
        return node_handle(0)
    }
    if node.id >= arena.nodes.len {
        return node_handle(0)
    }
    if i < 0 {
        return node_handle(0)
    }
    if i >= arena.nodes[node.id].kids.len {
        return node_handle(0)
    }
    return node_handle(arena.nodes[node.id].kids[i])
}

/// Position of `node` in `parent`'s children, or -1 when it is not one of them.
fn child_index(parent: Node, node: Node) -> int {
    arena.ensure()
    return arena.child_index(parent.id, node.id)
}

/// The parent of `node`, or the empty handle at the root.
fn parent_of(node: Node) -> Node {
    arena.ensure()
    if node.id <= 0 {
        return node_handle(0)
    }
    if node.id >= arena.nodes.len {
        return node_handle(0)
    }
    return node_handle(arena.nodes[node.id].parent)
}

/// Attach `node` under `parent` at `index` (clamped to `0..child_count`).
/// Detaches from any previous parent first, so a node has one parent. Returns
/// `parent` for chaining.
fn insert_child(parent: Node, node: Node, index: int) -> Node {
    arena.ensure()
    arena.child_insert(parent.id, node.id, index)
    return parent
}

/// Detach `node` from `parent`. No-op when `parent` does not hold it, so a
/// stale handle cannot pull a node out of an unrelated subtree.
fn remove_child(parent: Node, node: Node) -> Node {
    arena.ensure()
    if parent.id > 0 {
        if node.id > 0 {
            if node.id < arena.nodes.len {
                if arena.nodes[node.id].parent == parent.id {
                    arena.child_detach(node.id)
                }
            }
        }
    }
    return parent
}

/// Move `node` to position `index` under `parent`, which must already hold it.
/// Reorder without rebuilding: ids, focus, and per-row state survive.
fn move_child(parent: Node, node: Node, index: int) -> Node {
    arena.ensure()
    arena.child_move(parent.id, node.id, index)
    return parent
}

fn root(node: Node) -> Node {
    arena.ensure()
    arena.root_id = node.id
    return node
}

// --- style ---
/// Field writers used by `Box` / `apply_int`. Not app-facing.

fn grow(node: Node, weight: int) -> Node {
    arena.nodes[node.id].grow = weight
    return node
}
fn shrink(node: Node, weight: int) -> Node {
    arena.nodes[node.id].shrink = weight
    return node
}

/// Inset all four edges. Padding lives on the node rather than on a wrapper
/// box so a widget stays one node and layout stays one pass.
fn set_padding(node: Node, all: int) -> Node {
    arena.nodes[node.id].pad = u16(all)
    arena.nodes[node.id].pad_t = u16(all)
    arena.nodes[node.id].pad_r = u16(all)
    arena.nodes[node.id].pad_b = u16(all)
    arena.nodes[node.id].pad_l = u16(all)
    return node
}
/// Inset left and right only — the common case for control chrome, where
/// horizontal breathing room is set independently of height.
fn set_padding_x(node: Node, px: int) -> Node {
    arena.nodes[node.id].pad_l = u16(px)
    arena.nodes[node.id].pad_r = u16(px)
    return node
}
/// Inset top and bottom only, the vertical half of `set_padding_x`.
fn set_padding_y(node: Node, py: int) -> Node {
    arena.nodes[node.id].pad_t = u16(py)
    arena.nodes[node.id].pad_b = u16(py)
    return node
}
/// Inset one edge. The per-edge setters exist so a recipe can override a
/// single side without restating the other three.
fn set_padding_top(node: Node, px: int) -> Node {
    arena.nodes[node.id].pad_t = u16(px)
    return node
}
/// Inset one edge; see `set_padding_top`.
fn set_padding_right(node: Node, px: int) -> Node {
    arena.nodes[node.id].pad_r = u16(px)
    return node
}
/// Inset one edge; see `set_padding_top`.
fn set_padding_bottom(node: Node, px: int) -> Node {
    arena.nodes[node.id].pad_b = u16(px)
    return node
}
/// Inset one edge; see `set_padding_top`.
fn set_padding_left(node: Node, px: int) -> Node {
    arena.nodes[node.id].pad_l = u16(px)
    return node
}
fn margin(node: Node, all: int) -> Node {
    arena.nodes[node.id].m_t = all
    arena.nodes[node.id].m_r = all
    arena.nodes[node.id].m_b = all
    arena.nodes[node.id].m_l = all
    return node
}
fn marginX(node: Node, px: int) -> Node {
    arena.nodes[node.id].m_l = px
    arena.nodes[node.id].m_r = px
    return node
}
fn marginY(node: Node, py: int) -> Node {
    arena.nodes[node.id].m_t = py
    arena.nodes[node.id].m_b = py
    return node
}
fn marginTop(node: Node, px: int) -> Node {
    arena.nodes[node.id].m_t = px
    return node
}
fn marginRight(node: Node, px: int) -> Node {
    arena.nodes[node.id].m_r = px
    return node
}
fn marginBottom(node: Node, px: int) -> Node {
    arena.nodes[node.id].m_b = px
    return node
}
fn marginLeft(node: Node, px: int) -> Node {
    arena.nodes[node.id].m_l = px
    return node
}
fn border(node: Node, width: int) -> Node {
    // A negative width is the "unset" sentinel; a non-positive width means no
    // border, so it maps to 0 rather than a u16 trap.
    if width > 0 {
        arena.nodes[node.id].border_w = u16(width)
    } else {
        arena.nodes[node.id].border_w = 0
    }
    return node
}
fn border_color(node: Node, rgb: int) -> Node {
    arena.nodes[node.id].border_c = rgb
    return node
}

/// Space between children. Gap belongs to the parent, not to each child's
/// margin, so adding or removing a child cannot leave a stray edge gap.
fn set_spacing(node: Node, g: int) -> Node {
    arena.nodes[node.id].gap = u16(g)
    return node
}
/// Row-axis gap for wrapped and grid layouts, where the two axes need
/// different spacing and one `set_spacing` cannot express it.
fn set_spacing_row(node: Node, g: int) -> Node {
    arena.nodes[node.id].gap_row = u16(g)
    return node
}
/// Column-axis gap; the other half of `set_spacing_row`.
fn set_spacing_col(node: Node, g: int) -> Node {
    arena.nodes[node.id].gap_col = u16(g)
    return node
}

/// Default node width is 100% of the parent. `.set_width(px)` pins a pixel width
/// and clears the percentage. `.set_width(-1)` restores the 100% default.
fn set_width(node: Node, px: int) -> Node {
    if px < 0 {
        arena.nodes[node.id].explicit_width = -1
        arena.nodes[node.id].w_pct = 100
    } else {
        arena.nodes[node.id].explicit_width = px
        arena.nodes[node.id].w_pct = -1
    }
    return node
}
/// Pin a pixel height, clearing any percentage. The chaining form of the
/// `height` prop, for code that already holds a `Node` (recipes, engine
/// paths) and cannot go back through a props struct.
fn set_height(node: Node, px: int) -> Node {
    arena.nodes[node.id].explicit_height = px
    return node
}

/// Zero basis: the node's measured content no longer sets its row slot width;
/// `grow` then divides the whole free line evenly. This is the table recipe —
/// header labels and row cells all use `set_flex_basis_zero(...).grow(1)`, so every column
/// boundary comes from the row width alone, not from text lengths. Cells that
/// must keep a fixed pixel width use `.set_width(px)` instead.
fn set_flex_basis_zero(node: Node) -> Node {
    arena.nodes[node.id].w_pct = 0
    return node
}
/// `.set_width(px).set_height(px)` in one call. Named `size_px`, not `size`: themed widgets
/// expose `.size()` for the sm/md/lg token, and two chain methods sharing a
/// name and a `(Node, int)` shape resolve by import order — which is how
/// `.size(ui.sm())` once silently became a 0x0 box. The `_px` suffix also
/// keeps the unit at the call site, next to the themed token form.
fn size_px(node: Node, px: int) -> Node {
    return node.set_width(px).set_height(px)
}
fn width_pct(node: Node, percent_value: int) -> Node {
    arena.nodes[node.id].explicit_width = -1
    arena.nodes[node.id].w_pct = i8(percent_value)
    return node
}
fn height_pct(node: Node, percent_value: int) -> Node {
    arena.nodes[node.id].h_pct = i8(percent_value)
    return node
}
/// Floor the width. Min/max bounds are how a flexible child stays readable
/// when its parent shrinks, without giving up `grow`.
fn set_min_width(node: Node, px: int) -> Node {
    arena.nodes[node.id].min_w = px
    return node
}
/// Cap the width, so a growing child cannot run past a comfortable measure.
fn set_max_width(node: Node, px: int) -> Node {
    arena.nodes[node.id].max_w = px
    return node
}
/// Floor the height; the vertical counterpart of `set_min_width`.
fn set_min_height(node: Node, px: int) -> Node {
    arena.nodes[node.id].min_h = px
    return node
}
/// Cap the height, so scrollable content clips instead of stretching.
fn set_max_height(node: Node, px: int) -> Node {
    arena.nodes[node.id].max_h = px
    return node
}
/// Make a grid responsive. `px > 0` is a minimum *cell* width, in dp like
/// `gap` (not a scaled style prop — the layout it feeds is unscaled). `px == 0`
/// also turns it on but takes the cell width from the children: the widest
/// child's natural width is what a column has to hold, so the grid fits as
/// many as the content allows, capped by `columns`. `px < 0` turns it off and
/// restores the fixed `columns`.
///
/// Reached from `GridConfig.autoColumns`; public so a caller building a node
/// by hand can set it.
fn set_auto_columns(node: Node, px: int) -> Node {
    // Both fields move together, so `grid_auto != 0` never leaves a stale
    // floor behind for `grid_cols_at` to pick up.
    arena.nodes[node.id].grid_auto = 1
    arena.nodes[node.id].grid_min = 0
    if px > 0 {
        arena.nodes[node.id].grid_min = u16(px)
    }
    if px < 0 {
        arena.nodes[node.id].grid_auto = 0
    }
    return node
}
fn aspect(node: Node, aw: int, ah: int) -> Node {
    arena.nodes[node.id].aspect_w = aw
    arena.nodes[node.id].aspect_h = ah
    return node
}

fn flex_row(node: Node) -> Node {
    if int(arena.nodes[node.id].kind) != 2 {
        if int(arena.nodes[node.id].kind) != 9 {
            if int(arena.nodes[node.id].kind) != 11 {
                arena.nodes[node.id].kind = 1
            }
        }
    }
    arena.nodes[node.id].dir = 0
    arena.nodes[node.id].reverse = 0
    return node
}
fn flex_col(node: Node) -> Node {
    if int(arena.nodes[node.id].kind) != 2 {
        if int(arena.nodes[node.id].kind) != 9 {
            if int(arena.nodes[node.id].kind) != 11 {
                arena.nodes[node.id].kind = 1
            }
        }
    }
    arena.nodes[node.id].dir = 1
    arena.nodes[node.id].reverse = 0
    return node
}
fn flex_row_reverse(node: Node) -> Node {
    arena.nodes[node.id].dir = 0
    arena.nodes[node.id].reverse = 1
    return node
}
fn flex_col_reverse(node: Node) -> Node {
    arena.nodes[node.id].dir = 1
    arena.nodes[node.id].reverse = 1
    return node
}
fn flex_wrap(node: Node) -> Node {
    arena.nodes[node.id].wrap = 1
    return node
}
fn align_self(node: Node, mode: int) -> Node {
    arena.nodes[node.id].align_self = i8(mode)
    return node
}
fn span(node: Node, columns: int) -> Node {
    arena.nodes[node.id].span = u16(columns)
    return node
}

fn justify(node: Node, mode: int) -> Node {
    arena.nodes[node.id].justify = u8(mode)
    return node
}
fn align(node: Node, mode: int) -> Node {
    arena.nodes[node.id].align = u8(mode)
    return node
}

fn position(node: Node, mode: int) -> Node {
    arena.nodes[node.id].pos = u8(mode)
    return node
}
fn top(node: Node, px: int) -> Node {
    arena.nodes[node.id].pin_t = px
    return node
}
fn right(node: Node, px: int) -> Node {
    arena.nodes[node.id].pin_r = px
    return node
}
fn bottom(node: Node, px: int) -> Node {
    arena.nodes[node.id].pin_b = px
    return node
}
fn left(node: Node, px: int) -> Node {
    arena.nodes[node.id].pin_l = px
    return node
}
fn z_index(node: Node, z: int) -> Node {
    arena.nodes[node.id].z_index = i16(z)
    return node
}

/// Fill color as a packed rgb int. Takes an int, not a string, because it
/// is the post-parse form the scene writes — call sites pass `"#rrggbb"`
/// through the `background` prop and `parse_hex_color` converts once.
fn set_background(node: Node, rgb: int) -> Node {
    arena.nodes[node.id].bg = rgb
    return node
}

/// Second stop of a vertical gradient (`bg` → `bg2`). Solid fill when unset.
fn set_background_end(node: Node, rgb: int) -> Node {
    arena.nodes[node.id].bg2 = rgb
    return node
}
/// Foreground (text and glyph) color as a packed rgb int; the `color` prop
/// is the string-facing form.
fn set_color(node: Node, rgb: int) -> Node {
    arena.nodes[node.id].fg = rgb
    return node
}
fn radius(node: Node, px: int) -> Node {
    arena.nodes[node.id].radius = u16(px)
    return node
}

/// All four corners at once, clockwise from the top-left. `radius` stays the
/// uniform fallback for anything not set here.
fn radius4(node: Node, tl: int, tr: int, br: int, bl: int) -> Node {
    arena.set_corners(node.id, tl, tr, br, bl)
    return node
}

/// One corner: 0 top-left, 1 top-right, 2 bottom-right, 3 bottom-left.
fn radius_corner(node: Node, corner: int, px: int) -> Node {
    arena.set_corner(node.id, corner, px)
    return node
}

/// Round the top pair of corners, near `radius`'s bookkeeping: a top-rounded
/// sheet / tab header, with the bottom left square or whatever `radius` says.
fn radius_top(node: Node, px: int) -> Node {
    arena.set_corner(node.id, 0, px)
    arena.set_corner(node.id, 1, px)
    return node
}

/// Round the bottom pair of corners.
fn radius_bottom(node: Node, px: int) -> Node {
    arena.set_corner(node.id, 2, px)
    arena.set_corner(node.id, 3, px)
    return node
}

fn opacity(node: Node, percent_value: int) -> Node {
    arena.nodes[node.id].opacity = i16(percent_value)
    return node
}
fn overflow(node: Node, mode: int) -> Node {
    arena.nodes[node.id].overflow = u8(mode)
    return node
}
fn font(node: Node, px: int) -> Node {
    arena.nodes[node.id].font = u16(px)
    return node
}

/// Rotate a text node `deg` clockwise on screen around its top-left corner
/// (0 = horizontal). Used for chart axis labels that must not collide.
fn text_rot(node: Node, deg: int) -> Node {
    arena.nodes[node.id].text_rot = u16(deg)
    return node
}

/// Truncate this label with a trailing `…` when it is wider than its box,
/// instead of overflowing. Opt-in because overflow is the right default for
/// pinned and rotated chart text. Layout also lets a truncating label absorb
/// a row deficit, so `Table` cells, `Select` triggers, chips, and tabs
/// narrow rather than pushing siblings onto a second line.
fn text_ellipsis(node: Node) -> Node {
    arena.nodes[node.id].ellipsis = 1
    return node
}

// --- reactivity ---
/// `show` / `show_eq` / `show_ne` / `show_ge` / `show_le` hide a node from
/// layout when the predicate is false.

fn bind(label: Node, sig: Signal<int>) -> Node {
    arena.nodes[label.id].bind_sig = sig.id
    /* A bound number is measured as text on a label / button / input, so a
       write can change the box; flag it so the write re-runs layout. Elsewhere
       (a switch's tween, a scroll offset) the bind is paint-only. */
    let k = int(arena.nodes[label.id].kind)
    if k == 3 || k == 4 || k == 10 {
        arena.mark_sig_layout(sig.id)
    }
    // The chrome pass reads a bind (a switch's tween) with no effect in between,
    // so index it: a write marks the bound node, not the whole frame.
    arena.bind_chrome(sig.id, label.id)
    arena.mark_chrome()
    return label
}

fn click() -> int {
    return 1
}

/// Attach a handler for an engine event code. The generic form behind
/// `on_click`; event codes keep the arena free of per-event fields.
fn on_event(node: Node, event: int, handler: fn()) -> Node {
    if event == 1 {
        arena.nodes[node.id].click_fn = intern_fn(handler)
    }
    return node
}

/// Click handler. `n.on_click(h)` is `n.on(zeus.click(), h)`.
fn on_click(node: Node, handler: fn()) -> Node {
    return on_event(node, click(), handler)
}

fn show(node: Node, sig: Signal<int>) -> Node {
    arena.nodes[node.id].show_sig = sig.id
    arena.nodes[node.id].show_mode = 0
    arena.mark_sig_layout(sig.id)
    arena.mark_chrome()
    return node
}
fn show_eq(node: Node, sig: Signal<int>, value: int) -> Node {
    arena.nodes[node.id].show_sig = sig.id
    arena.nodes[node.id].show_mode = 1
    arena.nodes[node.id].show_val = value
    arena.mark_sig_layout(sig.id)
    arena.mark_chrome()
    return node
}
fn show_ne(node: Node, sig: Signal<int>, value: int) -> Node {
    arena.nodes[node.id].show_sig = sig.id
    arena.nodes[node.id].show_mode = 2
    arena.nodes[node.id].show_val = value
    arena.mark_sig_layout(sig.id)
    arena.mark_chrome()
    return node
}
// --- keyboard ---
/// A chord on a focused node resolves to a named action; a handler on that
/// same node writes a signal. App remaps (`map_key` / `remap_key`) still use
/// the action name, so a shortcut can move without the Component changing.
/// Context is the family of the first action (`button.press` → `button`).
///
/// mode: 0 inc, 1 toggle, 2 set, 3 add — the same codes on_click_* uses.

/// Action name for a `key` prop: the caller's, else one derived from the
/// chord. The `key.` family becomes the keymap context, so every
/// prop-bound shortcut shares one context and the innermost focused node
/// wins — which is what "the same chord on two widgets" should do.
fn key_action_name(spec: string, action: string) -> string {
    if action.len > 0 {
        return action
    }
    return "key.{{spec}}"
}

/// Install a `key` prop: map the chord to an action, then bind the action to
/// `handler_fn` (an interned id). Node-scoped unless `is_global`.
fn install_key(node: Node, spec: string, action: string, handler_fn: int,
               is_global: bool) -> Node {
    if spec.len == 0 {
        return node
    }
    if handler_fn <= 0 {
        return node
    }
    let act = key_action_name(spec, action)
    match is_global {
        true => {
            // ctx 0 = matches whatever holds focus.
            platform.plat_map_key(spec, act, 0)
            on_action_global(act, signal_handle(0), 5, handler_fn)
        }
        _ => {
            key(node, spec, act)
            on_action(node, act, signal_handle(0), 5, handler_fn)
        }
    }
    return node
}

// --- key bindings -----------------------------------------------------------
// An element's keyboard actions are one prop, `keys: []KeyBind`. A component
// appends the caller's bindings to its own (`keys_concat(own, p.keys)`), so
// both stay active, and the list is data a devtools pane can show.

/// One keyboard action on an element.
struct KeyBind {
    /// `"cmd+s"`, `"ctrl+shift+p"`, or a sequence like `"g d"`.
    chord: string,
    /// Name the chord resolves to, so an app can remap it with `remap_key`
    /// without touching the element. `""` = `"key.<chord>"`.
    action: string = "",
    /// What the chord runs. Absent = the element's `on_click`, so a button and
    /// its shortcut share one handler (`chord_click`).
    run: Option<fn()> = none,
    /// true = fires wherever focus is; false = only while focus is on this
    /// element or inside it.
    global: bool = false,
}

/// `spec` runs `run` while focus is on the element (or inside it).
fn chord(spec: string, action: string, run: fn()) -> KeyBind {
    return KeyBind(chord = spec, action = action, run = run)
}

/// `spec` runs `run` wherever focus is.
fn chord_global(spec: string, action: string, run: fn()) -> KeyBind {
    return KeyBind(chord = spec, action = action, run = run, global = true)
}

/// `spec` presses the element: it runs the element's `on_click`.
fn chord_click(spec: string) -> KeyBind {
    return KeyBind(chord = spec)
}

/// No bindings: the default of every `keys` prop.
fn no_keys() -> []KeyBind {
    return []KeyBind {}
}

/// `own` followed by `more`: a component's bindings plus its caller's.
fn keys_concat(own: []KeyBind, more: []KeyBind) -> []KeyBind {
    let mut out = []KeyBind {}
    for i in 0..own.len {
        push(out, own[i])
    }
    for i in 0..more.len {
        push(out, more[i])
    }
    return out
}

/// Install `keys` on `node`. A binding with no `run` uses the node's click
/// handler, so install after `on_click`.
fn install_keys(node: Node, keys: []KeyBind) -> Node {
    for i in 0..keys.len {
        let k = keys[i]
        let mut kfn = 0
        if result.is_some(k.run) {
            kfn = intern_fn(k.run.val)
        } else {
            kfn = arena.nodes[node.id].click_fn
        }
        install_key(node, k.chord, k.action, kfn, k.global)
    }
    return node
}

fn key_context(node: Node, name: string) -> Node {
    arena.nodes[node.id].key_ctx = platform.plat_key_intern(name)
    return node
}
fn focusable(node: Node) -> Node {
    arena.nodes[node.id].focusable = 1
    return node
}
fn capture_text(node: Node) -> Node {
    arena.nodes[node.id].capture_text = 1
    arena.nodes[node.id].focusable = 1
    return node
}

/// Chord → action on this node. The action family (`button.press` → `button`)
/// is the keymap context; `key_context` is only needed to override that name.
/// Implies `.focusable()` — a node with a key binding needs focus to receive
/// it, so components don't chain both.
fn key(node: Node, spec: string, action: string) -> Node {
    let mut ctx = arena.nodes[node.id].key_ctx
    if ctx == 0 {
        ctx = platform.plat_key_intern_action(action)
        arena.nodes[node.id].key_ctx = ctx
    }
    if ctx != 0 {
        platform.plat_map_key(spec, action, ctx)
    }
    arena.nodes[node.id].focusable = 1
    return node
}

fn on_key_set(node: Node, action: string, sig: Signal<int>, value: int) -> Node {
    return on_action(node, action, sig, 2, value)
}

fn on_key_add(node: Node, action: string, sig: Signal<int>, delta: int) -> Node {
    return on_action(node, action, sig, 3, delta)
}

fn on_key_toggle(node: Node, action: string, sig: Signal<int>) -> Node {
    return on_action(node, action, sig, 1, 0)
}

fn on_key_fn(node: Node, action: string) -> Node {
    return on_action(node, action, signal_handle(0), 5, arena.nodes[node.id].click_fn)
}

fn global_key_set(action: string, sig: Signal<int>, value: int) {
    on_action_global(action, sig, 2, value)
}

fn hover(node: Node, sig: Signal<int>) -> Node {
    return raw_hover(node, sig)
}

fn pulse(node: Node) -> Node {
    arena.note_pulse(node.id)
    return node
}

fn hover_fade(node: Node) -> Node {
    arena.nodes[node.id].hover_fade = 1
    return node
}

/// Press feedback as a paint-only scale (97% while the pointer is down) on
/// top of the press wash. Needs `press = true` on the node; `Button` sets
/// both. No layout pass reads the scale, so pressing never reflows.
fn press_scale(node: Node) -> Node {
    arena.nodes[node.id].press_scale = 1
    return node
}

/// Lift a node's shadow to elevation `level` while hovered (paint-only; the
/// hover wash is dropped in favour of the lift). `Card(interactive = true)`
/// sets it; any surface can take it.
fn hover_lift(node: Node, level: int) -> Node {
    let mut l = level
    if l < 0 {
        l = 0
    }
    if l > 4 {
        l = 4
    }
    arena.nodes[node.id].lift = u8(l)
    hover_fade(node)
    return node
}

fn hover_off(node: Node) -> Node {
    arena.nodes[node.id].hover_fade = -1
    return node
}

fn enter_fade(node: Node) -> Node {
    arena.nodes[node.id].enter_fade = 1
    arena.mark_chrome()
    return node
}

/// Reveal the node top-down when it is shown: paint clips to an animated share
/// of its height and slides the content up by the rest. Paint-only — layout
/// gives the box its full height at once, so an opening disclosure never runs
/// the layout pass per frame. Hiding snaps (there is no reveal-out).
fn enter_reveal(node: Node) -> Node {
    arena.nodes[node.id].reveal = 1
    arena.mark_chrome()
    return node
}

// --- shared interaction state ---------------------------------------------
// One model for hover / pressed / focus-visible / disabled / loading /
// selected / invalid. Components set these once; the engine's paint and hit
// test consult the same overlay instead of each recipe re-deriving them.

/// Disabled: dimmed, no hover, no press. (`enabled` on a component already
/// sets this; `disabled` is for plain nodes and reactive overrides.)
fn disabled(node: Node, on: bool) -> Node {
    if on {
        arena.set_disabled(node.id, 1)
    } else {
        arena.set_disabled(node.id, 0)
    }
    return node
}

/// Loading: dimmed and non-interactive while work is in flight.
fn loading(node: Node, on: bool) -> Node {
    if on {
        arena.set_loading(node.id, 1)
    } else {
        arena.set_loading(node.id, 0)
    }
    return node
}

/// Invalid: validation failed (paint chrome reads the shared overlay).
fn invalid(node: Node, on: bool) -> Node {
    if on {
        arena.set_invalid(node.id, 1)
    } else {
        arena.set_invalid(node.id, 0)
    }
    return node
}

fn state_disabled(node: Node) -> bool {
    return arena.state_disabled_of(node.id) != 0
}
fn state_loading(node: Node) -> bool {
    return arena.state_loading_of(node.id) != 0
}
fn state_invalid(node: Node) -> bool {
    return arena.state_invalid_of(node.id) != 0
}
fn state_hovered(node: Node) -> bool {
    return arena.state_hovered_of(node.id) != 0
}
fn state_pressed(node: Node) -> bool {
    return arena.state_pressed_of(node.id) != 0
}
fn state_focus_visible(node: Node) -> bool {
    return arena.state_focus_visible_of(node.id) != 0
}
fn state_selected(node: Node) -> bool {
    return arena.state_selected_of(node.id) != 0
}

// --- paint-only motion -----------------------------------------------------
// Transforms and appearance are interpolated on the animation track pool and
// written into paint state only — no layout pass reads them, so an animation
// never re-runs a component or a signal effect. Retargeting keeps the current
// value as the new `from`. `ease` is an `EASE` curve (`EASE.Standard` when
// omitted); `EASE.Spring` overshoots and settles, for things that snap.

/// Animate `node`'s scale to `to` percent (100 = identity) over `ms`.
fn animate_scale(node: Node, to: int, ms: int, ease: int = 1) -> Node {
    arena.anim_scale(node.id, to, ms, ease)
    return node
}

/// Animate a horizontal paint translation (dp).
fn animate_x(node: Node, to: int, ms: int, ease: int = 1) -> Node {
    arena.anim_translate_x(node.id, to, ms, ease)
    return node
}

/// Animate a vertical paint translation (dp).
fn animate_y(node: Node, to: int, ms: int, ease: int = 1) -> Node {
    arena.anim_translate_y(node.id, to, ms, ease)
    return node
}

/// Animate a clockwise rotation in degrees about the node's centre.
fn animate_rotate(node: Node, to: int, ms: int) -> Node {
    arena.anim_rotate(node.id, to, ms)
    return node
}

/// Animate node opacity 0..100.
fn animate_opacity(node: Node, to: int, ms: int, ease: int = 1) -> Node {
    arena.anim_opacity(node.id, to, ms, ease)
    return node
}

/// Animate the corner radius in dp.
fn animate_radius(node: Node, to: int, ms: int) -> Node {
    arena.anim_radius(node.id, to, ms)
    return node
}

/// Indeterminate rotation, `period` ms per turn, for a spinner. Paint rotates
/// it from the frame clock, so it keeps a frame live while visible and stays
/// deterministic on the first frame. Reduced motion settles it static.
fn spin(node: Node, period: int) -> Node {
    arena.note_spin(node.id, period)
    return node
}

/// Current animated paint values (tests / the inspector). Layout never reads
/// these, so reading one cannot cause a layout change.
fn motion_scale(node: Node) -> int {
    return int(arena.nodes[node.id].an_scale)
}
fn motion_x(node: Node) -> int {
    return int(arena.nodes[node.id].an_tx)
}
fn motion_y(node: Node) -> int {
    return int(arena.nodes[node.id].an_ty)
}
fn motion_rot(node: Node) -> int {
    return int(arena.nodes[node.id].an_rot)
}
/// The rotation a spinner paints right now (frame-clock phase).
fn motion_spin(node: Node) -> int {
    let per = int(arena.nodes[node.id].spin_ms)
    if per <= 0 {
        return 0
    }
    return (arena.now_ms % per) * 360 / per
}
fn motion_opacity(node: Node) -> int {
    return int(arena.nodes[node.id].opacity)
}
fn motion_radius(node: Node) -> int {
    return int(arena.nodes[node.id].radius)
}
fn keys(node: Node, sig: Signal<int>, lo: int, hi: int) -> Node {
    return node.key("right", "slider.inc").key("left", "slider.dec").focusable().on_range("slider.inc", sig, 1, lo, hi).on_range("slider.dec", sig, -1, lo, hi)
}
fn keys_page(node: Node, sig: Signal<int>) -> Node {
    return node.key("right", "page.next").key("left", "page.prev").focusable().on_key_add("page.next", sig, 1).on_key_add("page.prev", sig, -1)
}

// --- flex constants (public; implemented in geometry) ---

fn flex_start() -> int {
    return geometry.flex_start()
}
fn flex_center() -> int {
    return geometry.flex_center()
}
fn flex_end() -> int {
    return geometry.flex_end()
}
fn flex_between() -> int {
    return geometry.flex_between()
}
fn flex_around() -> int {
    return geometry.flex_around()
}
fn flex_evenly() -> int {
    return geometry.flex_evenly()
}
fn flex_stretch() -> int {
    return geometry.flex_stretch()
}
fn pos_relative() -> int {
    return geometry.pos_relative()
}
fn pos_absolute() -> int {
    return geometry.pos_absolute()
}
fn overflow_visible() -> int {
    return geometry.overflow_visible()
}
fn overflow_hidden() -> int {
    return geometry.overflow_hidden()
}
fn overflow_scroll() -> int {
    return geometry.overflow_scroll()
}
fn overflow_auto() -> int {
    return geometry.overflow_auto()
}
fn rgb(r: int, g: int, b: int) -> int {
    return geometry.rgb(r, g, b)
}

fn center(node: Node) -> Node {
    return node.justify(flex_center()).align(flex_center())
}

fn appearance() -> Signal<int> {
    arena.ensure()
    if arena.appearance_sid == 0 {
        let s = signal(1)
        arena.appearance_sid = s.id
    }
    return signal_handle(arena.appearance_sid)
}

fn theme(slot: int, light: int, dark: int) {
    arena.ensure()
    if slot < 0 {
        return
    }
    arena.theme_grow(slot)
    if slot < arena.theme_l.len {
        arena.theme_l[slot] = light
        arena.theme_d[slot] = dark
    }
}

/// Encode a theme role slot as a sentinel color. Widgets store the *role*,
/// not a resolved value, so flipping light/dark repaints without rebuilding
/// the tree — the paint pass resolves the slot each frame.
fn role_color(slot: int) -> int {
    if slot < 0 {
        return 0
    }
    return 2130706432 + slot
}

// --- reactive props ---
// A style prop is a thunk. Interning it yields an int id, which a plain `||`
// effect closure can capture — a `fn` value is not Copy and cannot be. The
// effect calls the thunk and re-applies one setter, so setting a signal
// repaints exactly the props that read it.


/// Does this write carry no value? Most props use -1 for "the caller did not
/// pass this", so one rule here replaces the same `if v >= 0` repeated in
/// every arm below. The flag-like setters opt out: they mean something at 0
/// and -1, so they always apply. `SET.Border` is deliberately not one of them:
/// its width is additive in `content_x`/`content_y`, so applying the unset `-1`
/// shifted every container's content by one pixel.
fn skip_unset(setter: int, v: int) -> bool {
    match setter {
        SET.Direction | SET.Wrap | SET.Safe | SET.ShowOn => { return false }
        /* The four pin offsets are the one geometry prop where a negative is a
           real value: `left = -3, top = -3` is how a 22px ring is centred on a
           16px dot. `v < 0` here silently dropped those, so the ring drew at the
           parent's origin and hung 3px down-right of the dot it was meant to
           circle. `-1` still means "unset" in the layout guards. */
        SET.Left | SET.Top | SET.Right | SET.Bottom => { return false }
        // A 0px glyph is not a size, so font rejects 0 as well.
        SET.Font => { return v <= 0 }
        _ => { return v < 0 }
    }
}

/// Geometry a layout-driving `animate` may tween. Flags (direction, wrap,
/// show) still jump: they are not a continuous length.
fn setter_tweens_layout(setter: int) -> bool {
    match setter {
        SET.Width | SET.Height | SET.MinWidth | SET.MaxWidth |
        SET.MinHeight | SET.MaxHeight | SET.Left | SET.Top | SET.Right |
        SET.Bottom => { return true }
        _ => { return false }
    }
}

fn layout_target_px(setter: int, v: int) -> int {
    match setter {
        SET.Width | SET.Height | SET.MinWidth | SET.MaxWidth |
        SET.MinHeight | SET.MaxHeight | SET.Left | SET.Top | SET.Right |
        SET.Bottom => { return scaled(v) }
        _ => { return v }
    }
}

fn layout_read(node_id: int, setter: int) -> int {
    match setter {
        SET.Width => {
            if arena.nodes[node_id].explicit_width >= 0 {
                return arena.nodes[node_id].explicit_width
            }
            return arena.nodes[node_id].w
        }
        SET.Height => {
            if arena.nodes[node_id].explicit_height >= 0 {
                return arena.nodes[node_id].explicit_height
            }
            return arena.nodes[node_id].h
        }
        SET.MinWidth => { return arena.nodes[node_id].min_w }
        SET.MaxWidth => { return arena.nodes[node_id].max_w }
        SET.MinHeight => { return arena.nodes[node_id].min_h }
        SET.MaxHeight => { return arena.nodes[node_id].max_h }
        SET.Left => { return arena.nodes[node_id].pin_l }
        SET.Top => { return arena.nodes[node_id].pin_t }
        SET.Right => { return arena.nodes[node_id].pin_r }
        SET.Bottom => { return arena.nodes[node_id].pin_b }
        _ => { return 0 }
    }
}

fn apply_int_px(node_id: int, setter: int, v: int) {
    let n = node_handle(node_id)
    match setter {
        SET.Width => { set_width(n, v) }
        SET.Height => { set_height(n, v) }
        SET.MinWidth => { set_min_width(n, v) }
        SET.MaxWidth => { set_max_width(n, v) }
        SET.MinHeight => { set_min_height(n, v) }
        SET.MaxHeight => { set_max_height(n, v) }
        SET.Left => { arena.nodes[node_id].pin_l = v }
        SET.Top => { arena.nodes[node_id].pin_t = v }
        SET.Right => { arena.nodes[node_id].pin_r = v }
        SET.Bottom => { arena.nodes[node_id].pin_b = v }
        _ => {}
    }
}

fn apply_layout_anims() {
    let n = arena.layout_anim_len()
    let mut i = 0
    while i < n {
        let a = arena.layout_anim_get(i)
        if a.live != 0 {
            apply_int_px(a.node_id, a.setter, a.current_value)
        }
        i = i + 1
    }
    arena.layout_anim_reap()
    arena.mark_layout()
}

fn apply_int(node_id: int, setter: int, v: int) {
    if skip_unset(setter, v) {
        return
    }
    apply_int_value(node_id, setter, v)
}

/// `apply_int` without the unset rule: `v` is always a real value. The
/// `style` prop writes through here, since an `Option` key already says
/// whether it was set, so `margin = Edges(left = -16)` is a bleed, not a skip.
fn apply_int_value(node_id: int, setter: int, v: int) {
    if arena.anim_bind_on() != 0 {
        if setter_tweens_layout(setter) {
            let from = layout_read(node_id, setter)
            let to = layout_target_px(setter, v)
            if arena.layout_anim_push(node_id, setter, from, to) != 0 {
                return
            }
        }
    }
    let n = node_handle(node_id)
    // The UI-scale knob is applied here, once, so recipes and callers both
    // write plain design px and never call `scaled` themselves. Only
    // geometry and type scale; weights, flags, colors and z-order do not —
    // so `scaled` is called in those arms only (scaling a packed color would
    // overflow the 32-bit default).
    match setter {
        SET.Width => { set_width(n, scaled(v)) }
        SET.Height => { set_height(n, scaled(v)) }
        SET.Padding => { set_padding(n, scaled(v)) }
        SET.PaddingX => { set_padding_x(n, scaled(v)) }
        SET.PaddingY => { set_padding_y(n, scaled(v)) }
        SET.PaddingTop => { set_padding_top(n, scaled(v)) }
        SET.PaddingRight => { set_padding_right(n, scaled(v)) }
        SET.PaddingBottom => { set_padding_bottom(n, scaled(v)) }
        SET.PaddingLeft => { set_padding_left(n, scaled(v)) }
        SET.Margin => { margin(n, scaled(v)) }
        SET.MarginX => { marginX(n, scaled(v)) }
        SET.MarginY => { marginY(n, scaled(v)) }
        SET.MarginTop => { marginTop(n, scaled(v)) }
        SET.MarginRight => { marginRight(n, scaled(v)) }
        SET.MarginBottom => { marginBottom(n, scaled(v)) }
        SET.MarginLeft => { marginLeft(n, scaled(v)) }
        SET.Spacing => { set_spacing(n, scaled(v)) }
        SET.GapRow => { set_spacing_row(n, scaled(v)) }
        SET.GapCol => { set_spacing_col(n, scaled(v)) }
        SET.Radius => { radius(n, scaled(v)) }
        SET.RadiusTop => { radius_top(n, scaled(v)) }
        SET.RadiusBottom => { radius_bottom(n, scaled(v)) }
        SET.Border => { arena.nodes[node_id].border_w = u16(v) }
        SET.Grow => { grow(n, v) }
        SET.AlignItems => { align(n, v) }
        SET.Justify => { justify(n, v) }
        SET.Font => { font(n, scaled(v)) }
        SET.Opacity => { opacity(n, v) }
        SET.Direction => {
            match v {
                1 => { flex_col(n) }
                _ => { flex_row(n) }
            }
        }
        SET.Background => { set_background(n, v) }
        SET.Color => { set_color(n, v) }
        SET.BorderColor => { border_color(n, v) }
        SET.MinWidth => { set_min_width(n, scaled(v)) }
        SET.MaxWidth => { set_max_width(n, scaled(v)) }
        SET.MinHeight => { set_min_height(n, scaled(v)) }
        SET.MaxHeight => { set_max_height(n, scaled(v)) }
        SET.Wrap => {
            match v {
                0 => {}
                _ => { flex_wrap(n) }
            }
        }
        SET.Safe => {
            match v {
                0 => { arena.nodes[node_id].safe = u8(0) }
                _ => { arena.nodes[node_id].safe = u8(1) }
            }
        }
        SET.Position => { arena.nodes[node_id].pos = u8(v) }
        SET.Left => { arena.nodes[node_id].pin_l = scaled(v) }
        SET.Top => { arena.nodes[node_id].pin_t = scaled(v) }
        SET.Right => { arena.nodes[node_id].pin_r = scaled(v) }
        SET.Bottom => { arena.nodes[node_id].pin_b = scaled(v) }
        SET.ZIndex => { arena.nodes[node_id].z_index = i16(v) }
        SET.Shrink => { shrink(n, v) }
        SET.ShowOn => {
            match v {
                0 | 1 => { arena.nodes[node_id].show_on = u8(v) }
                _ => {}
            }
        }
        SET.AlignSelf => { align_self(n, v) }
        SET.Span => { span(n, v) }
        SET.Overflow => { overflow(n, v) }
        SET.WidthPct => { width_pct(n, v) }
        SET.HeightPct => {
            arena.nodes[node_id].explicit_height = -1
            height_pct(n, v)
        }
        SET.Ellipsis => { arena.nodes[node_id].ellipsis = u8(v) }
        SET.CornerTL => { arena.set_corner(node_id, 0, scaled(v)) }
        SET.CornerTR => { arena.set_corner(node_id, 1, scaled(v)) }
        SET.CornerBR => { arena.set_corner(node_id, 2, scaled(v)) }
        SET.CornerBL => { arena.set_corner(node_id, 3, scaled(v)) }
        SET.WrapFlag => { arena.nodes[node_id].wrap = u8(v) }
        SET.SvgFit => { arena.nodes[node_id].font = u16(v) }
        SET.SvgLazy => { arena.nodes[node_id].wrap = u8(v) }
        SET.Elevation => {
            if v <= 0 {
                arena.nodes[node_id].elev = u8(0)
            } else {
                let mut lv = v
                if lv > 4 {
                    lv = 4
                }
                arena.nodes[node_id].elev = u8(lv)
                arena.nodes[node_id].elev_c = role_color(ROLE.Shadow)
            }
        }
        _ => {}
    }
    // Report the write so the frame marks this node (a paint-only property) or
    // layout, instead of the whole surface. See `arena.note_prop_write`.
    if setter_is_paint_only(setter) {
        arena.note_prop_write(node_id, 0)
    } else {
        arena.note_prop_write(node_id, 1)
    }
}

/// Setters that change only paint state: geometry is untouched, so a frame
/// that writes one skips `layout.layout()`. Everything else (sizes, padding,
/// border, text, font, position, show) can move the box model.
fn setter_is_paint_only(setter: int) -> bool {
    match setter {
        SET.Radius | SET.RadiusTop | SET.RadiusBottom | SET.Opacity | SET.Background | SET.Color | SET.BorderColor |
        SET.ZIndex | SET.SvgFit | SET.SvgLazy | SET.Elevation |
        SET.CornerTL | SET.CornerTR | SET.CornerBR | SET.CornerBL => { return true }
        _ => { return false }
    }
}

fn apply_str(node_id: int, setter: int, v: string) {
    match setter {
        SET.Text => {
            arena.nodes[node_id].text = v
            arena.note_prop_write(node_id, 1)
        }
        SET.A11yLabel => { arena.nodes[node_id].a11y_label = v }
        SET.A11yRole => { arena.nodes[node_id].a11y_role = v }
        SET.Cursor => { arena.nodes[node_id].cursor = v }
        _ => { apply_int(node_id, setter, parse_hex_color(v)) }
    }
}

/// Write a plain prop value straight onto the node. Style props are data, so
/// there is nothing to re-run: one assignment at build time.
fn set_prop_int(node: Node, setter: int, v: int) -> Node {
    apply_int(node.id, setter, v)
    return node
}

/// `set_prop_int` for string props (colors, labels, a11y).
fn set_prop_str(node: Node, setter: int, v: string) -> Node {
    apply_str(node.id, setter, v)
    return node
}

fn prop_int(node: Node, setter: int, thunk: fn() -> int) -> Node {
    let fn_id = intern_int(thunk)
    let node_id = node.id
    return styled(node, || { apply_int(node_id, setter, platform.plat_invoke_int_fn(fn_id)) })
}

fn prop_str(node: Node, setter: int, thunk: fn() -> string) -> Node {
    let fn_id = intern_str(thunk)
    let node_id = node.id
    return styled(node, || { apply_str(node_id, setter, platform.plat_invoke_str_fn(fn_id)) })
}
// --- UI scale (density + type, one knob) ---
/// Scale in percent; 100 is the design system's 1.0. Clamped to 50..200.
/// Applied once, in `apply_int`, as each geometry or type prop lands on a
/// node — so no widget multiplies anything itself. Read at build time, so
/// set it before building a retained tree; a `zeus.view` app re-reads it
/// every frame (zoom reacts live there).
let mut roles_ready: int = 0
let mut ui_scale: int = 100

fn set_scale(percent_value: int) {
    let mut v = percent_value
    if v < 50 {
        v = 50
    }
    if v > 200 {
        v = 200
    }
    ui_scale = v
}
/// A design px scaled by the UI-scale knob: `scaled(16)` is 16 at 100%,
/// 20 at 125%. Internal — `apply_int` calls it for every geometry and type
/// prop, which is the only place scaling happens. Widgets never call it.
fn scaled(v: int) -> int {
    return i32(i64(v) * i64(ui_scale) / i64(100))
}
/// `#rrggbb` / `#rgb` to packed RGB. -1 for empty or malformed, which every
/// style setter reads as "leave unset".
fn parse_hex_color(s: string) -> int {
    let n = s.len
    if n == 0 {
        return -1
    }
    // `@N` is a theme role (see `role_token`): keep it symbolic so the paint
    // pass can resolve it per appearance.
    if s[0] == 64 {
        let mut slot = 0
        for i in 1..n {
            let d = s[i] - 48
            if d < 0 || d > 9 {
                return -1
            }
            slot = slot * 10 + d
        }
        return role_color(slot)
    }
    if s[0] != 35 {
        return -1
    }
    let mut v = 0
    if n == 7 {
        for i in 1..7 {
            let d = hex_digit_value(s[i])
            if d < 0 {
                return -1
            }
            v = v * 16 + d
        }
        return v
    }
    if n == 4 {
        for i in 1..4 {
            let d = hex_digit_value(s[i])
            if d < 0 {
                return -1
            }
            v = v * 256 + d * 17
        }
        return v
    }
    return -1
}
/// One hex nibble, or -1 when the byte is not a hex digit — the -1 is what
/// lets `parse_hex_color` reject malformed colors instead of guessing.
fn hex_digit_value(c: int) -> int {
    if c >= 48 {
        if c <= 57 {
            return c - 48
        }
    }
    if c >= 97 {
        if c <= 102 {
            return c - 87
        }
    }
    if c >= 65 {
        if c <= 70 {
            return c - 55
        }
    }
    return -1
}
// --- declarative layer ---
//
// Components are plain `fn`s, hierarchy comes from trailing blocks, props are
// named arguments on a props struct, and every style prop is a thunk so a
// signal read inside it re-applies just that prop.

/// Pointer payload, staged by the engine and read inside a handler.
struct MouseEvent {
    x: int,
    y: int,
    button: int,
}

/// Keyboard payload, staged by the engine and read inside a handler.
struct KeyEvent {
    key: int,
    ctrl: bool,
    shift: bool,
    alt: bool,
}

/// `v` when the caller set it (>= 0), else the recipe's `fallback`. Both
/// sides stay thunks, so a themed default repaints on a palette switch just
/// like a caller-supplied one. This is how a recipe widget layers its own
/// look under whatever the caller passed.
fn px_or_default(v: int, fallback: int) -> int {
    if v >= 0 {
        return v
    }
    return fallback
}

/// `px_or` for colors and other strings: a non-empty `v` wins.
fn str_or_default(v: string, fallback: string) -> string {
    if v.len > 0 {
        return v
    }
    return fallback
}


/// The event payload for the handler now running. A handler is invoked with
/// no arguments, so `fn(e: MouseEvent)` is lowered to a `let` of this.
fn current_mouse() -> MouseEvent {
    return MouseEvent { x: arena.ev_x, y: arena.ev_y, button: arena.ev_button }
}

fn current_key() -> KeyEvent {
    return KeyEvent {
        key: arena.ev_key,
        ctrl: arena.ev_mods % 4 >= 2,
        shift: arena.ev_mods % 2 == 1,
        alt: arena.ev_mods % 8 >= 4,
    }
}

/// Default for the text/label thunks: an unset text prop reads as empty.
fn empty_text() -> string {
    return ""
}

/// Placeholder payload of an absent handler prop (`result.none(noop)`). Never
/// installed: the `Option` says whether the caller passed one.
fn noop() {
    return
}

/// `noop` for `fn(int)` handler props (`Menu.on_select`).
fn noop_int(i: int) {
    return
}

/// The element props of `Box` / `Component`, the DOM-attribute half of an
/// element: what it is, what it does, how it is reached. How it looks is one
/// `style` (`zeuscore/style.loam`).
struct BoxProps {
    /// CSS-subset style. A thunk, so a signal read inside it re-applies just the
    /// keys that changed.
    style: Option<fn() -> Style> = none,
    /// Filled with this element, for the controller (`ref()`, `focus(r)`).
    ref: Option<Ref> = none,
    /// Keyboard actions on this element (`chord(...)`, `chord_click(...)`).
    keys: []KeyBind = no_keys(),
    /// Accessibility role (`"button"`, `"dialog"`, ...).
    role: string = "",
    /// Accessible name. A thunk, so `label = "{{n}} items"` follows state.
    label: Option<fn() -> string> = none,
    /// `enabled = form_valid.get()` dims to 40% and disables the element.
    enabled: bool = true,
    /// Busy: inert (no click, hover or press) while true.
    loading: Option<fn() -> bool> = none,
    /// Tab stop. A thunk, so `focusable = active()` follows state.
    focusable: Option<fn() -> bool> = none,
    /// Roving tab stop (one per tab list / radio group): focusable only while
    /// true, and it takes focus when it becomes true while focus is already in
    /// the group (arrow keys); a pick made from outside leaves focus alone.
    roving: Option<fn() -> bool> = none,
    /// With `roving`: take focus whenever the pick lands here, from anywhere.
    /// For popups whose opening moves focus in (menu items), where the pick
    /// only changes through the user (open, hover, keys).
    rovingGrab: bool = false,
    /// Paint-only overlays merged over `style` while the element is hovered,
    /// pressed, keyboard-focused or disabled (in that order; later wins).
    /// Only background, color, opacity, border and elevation are honoured:
    /// hover must not reflow. An element with any of them paints no default
    /// hover wash or press overlay.
    /// Thunks, like `style`: an overlay that reads a signal follows it, and a
    /// thunk keeps `BoxProps` small (it is passed by value on every element).
    hoverStyle: Option<fn() -> Style> = none,
    pressStyle: Option<fn() -> Style> = none,
    focusStyle: Option<fn() -> Style> = none,
    disabledStyle: Option<fn() -> Style> = none,
    /// Interaction chrome for elements without state styles: no hover wash
    /// (`hoverOff`, the default), wash on hover (`hoverFade`), scale on press
    /// (`pressScale`), rise on hover (`lift`, 0..4), press feedback (`press`).
    hoverOff: bool = true,
    hoverFade: bool = false,
    pressScale: bool = false,
    lift: int = -1,
    press: bool = false,
    /// Entrance motion when the element appears: `Enter.Fade`,
    /// `Enter.Fade + Enter.Reveal`.
    enter: int = 0,
    /// Shown while true; the subtree is kept, and `enter` motion plays on
    /// each show. A thunk, so `visible = open.get()` follows `open`.
    visible: Option<fn() -> bool> = none,
    /// The signal a toggle / slider / bound label shows and edits.
    bind: Option<Signal<int>> = none,
    /// Label text. A thunk so a signal read inside it repaints just this
    /// attribute; the compiler lifts a plain expression into it.
    text: Option<fn() -> string> = none,
    /// Text input: the committed buffer, and Enter-inserts-newline.
    edit: Option<Signal<string>> = none,
    multiline: bool = false,
    /// Image: `Fit.*`, and decode only once on screen.
    fit: int = 0,
    lazy: bool = false,
    /// Keep the element inside the host's safe area (notch, home indicator).
    safe: bool = false,
    /// List hosts: fixed row height, and the hook that rebuilds the rows.
    rowHeight: int = 0,
    rebuild: Option<fn()> = none,
    on_click: Option<fn()> = none,
    on_mouse_down: Option<fn()> = none,
    on_mouse_up: Option<fn()> = none,
    /// Runs with `true` when the pointer enters and `false` when it leaves.
    on_hover: Option<fn(bool)> = none,
    on_key_down: Option<fn()> = none,
    on_key_up: Option<fn()> = none,
    on_key_press: Option<fn()> = none,
}



// --- Component ---
// Every widget is `Component(node, props)`: style thunks, events, bind,
// visible, press, then attach to the current slot parent. Trailing blocks
// lower to `slot`. Recipes allocate a raw node (or call Box) and pass
// props — they do not intern, write arena fields, or call prop_int.

// --- View frames -------------------------------------------------------------
// A component is a fn whose tail returns its tree, `return Element(...) { … }`.
// That tail lowers to a slot call, so the parser wraps the fn body in a frame:
//
//     let __zv = __view_begin()        // first statement of the fn
//     ...state, controller, keys...
//     return __view_end(__zv, || { slot(Element(...), || { … }) })
//
// The frame gives the component's state a pending owner (its root does not
// exist yet), logs the effects it allocates, builds the tree, finds the one
// root it attached, moves everything onto that root, and runs `on_mount`. A
// component's state therefore dies with its root, wherever it was created.

/// Open frames, innermost last.
let mut vf_token: []int = []int {}
let mut vf_prev_owner: []int = []int {}
let mut vf_parent: []int = []int {}
let mut vf_log: []int = []int {}
let mut vf_mount_at: []int = []int {}
let mut vf_root: []int = []int {}
let mut vf_roots: []int = []int {}
/// `on_mount` callbacks of every open frame, each frame's from `vf_mount_at`.
let mut mount_fns: []fn() = []fn() {}

/// The slot the next element attaches to (0 at the top level).
fn current_slot() -> int {
    if ui_parents.len > 0 {
        return ui_parents[ui_parents.len - 1]
    }
    return 0
}

/// Open a `View` frame. Emitted by the compiler; not called by hand.
fn __view_begin() -> int {
    arena.ensure()
    let token = arena.own_begin()
    push(vf_token, token)
    push(vf_prev_owner, arena.get_scope_node())
    push(vf_parent, current_slot())
    push(vf_log, track.log_begin())
    push(vf_mount_at, mount_fns.len)
    push(vf_root, 0)
    push(vf_roots, 0)
    arena.set_scope_node(token)
    return vf_token.len - 1
}

/// Build the view under frame `frame` and close it. Emitted by the compiler.
fn __view_end(frame: int, build: fn()) -> Node {
    build()
    let top = vf_token.len - 1
    if top != frame {
        panic("View frames closed out of order")
    }
    let built = vf_roots[top]
    if built != 1 {
        panic("View must build exactly one root element, built {{built}}")
    }
    let root = vf_root[top]
    // Mount callbacks run while the frame is still open, so whatever they
    // create (an effect, a handler) is owned by the root too. Refs are filled
    // by now: every element of the tree has been built.
    let start = vf_mount_at[top]
    let mut i = start
    while i < mount_fns.len {
        let f = mount_fns[i]
        f()
        i = i + 1
    }
    while mount_fns.len > start {
        pop(mount_fns)
    }
    arena.set_scope_node(vf_prev_owner[top])
    arena.own_end(vf_token[top], root)
    track.log_end(vf_log[top], vf_parent[top], root)
    let slot_id = vf_parent[top]
    pop(vf_token)
    pop(vf_prev_owner)
    pop(vf_parent)
    pop(vf_log)
    pop(vf_mount_at)
    pop(vf_root)
    pop(vf_roots)
    // A component whose View is another component (`Stat` is a `Card`): the
    // inner frame saw the attach, so report the root to the enclosing frame.
    view_note(root, slot_id)
    return node_handle(root)
}

/// `Component` reports each element it attaches; the innermost frame counts
/// the ones placed directly in its parent slot.
fn view_note(node_id: int, slot_id: int) {
    let top = vf_token.len - 1
    if top < 0 {
        return
    }
    if vf_parent[top] != slot_id {
        return
    }
    if vf_roots[top] == 0 {
        vf_root[top] = node_id
    }
    vf_roots[top] = vf_roots[top] + 1
}

/// Run `body` once the component's `View` has attached its root, so refs
/// are filled. Outside a `View` component it runs now.
fn on_mount(body: fn()) {
    if vf_token.len == 0 {
        body()
        return
    }
    push(mount_fns, body)
}

/// Entrance motion for the `enter` prop.
/// Flags; add them: `enter = Enter.Fade + Enter.Reveal`.
enum Enter {
    None = 0,
    Fade = 1,
    Reveal = 2,
}

/// The empty `Signal<int>`: the placeholder of optional signal props.
fn no_signal() -> Signal<int> {
    return Signal { id: 0 }
}

/// The 0/1 show signal the engine reads for a `visible` thunk: layout and
/// the enter / exit tracks read it raw. One effect, owned by `node`. The
/// engine may also write it (Escape on an overlay with no click handler).
fn visible_signal(node: Node, when: fn() -> bool) -> Signal<int> {
    let out = signal(0)
    let fid = intern_fn(|| {
        let v = if when() { 1 } else { 0 }
        if out.peek() != v {
            out.set(v)
        }
    })
    track.run(track.alloc(fid, node.id))
    return out
}

/// Placeholder for an absent `Option<Signal<bool>>`.
fn no_flag_signal() -> Signal<bool> {
    return Signal { id: 0 }
}

/// A 0/1 `Signal<int>` that follows `b`. For the engine paths that read an
/// int signal raw — `visible`, `bind`, the enter / exit tracks — under a
/// component whose public state is a `Signal<bool>`. One effect, owned by the
/// component that calls it. Read-only for the engine: an overlay it shows is
/// closed by Escape through the overlay's own `on_click`, which writes `b`.
fn flag_int(b: Signal<bool>) -> Signal<int> {
    let out = signal(0)
    effect(|| {
        let v = if b.get() { 1 } else { 0 }
        if out.peek() != v {
            out.set(v)
        }
    })
    return out
}

/// `no_signal` for `Signal<string>` props.
fn no_signal_str() -> Signal<string> {
    return Signal { id: 0 }
}

/// `no_signal` for `Signal<[]int>` props.
fn no_signal_ints() -> Signal<[]int> {
    return Signal { id: 0 }
}

/// `h` when `on`, else no handler: a prop that only some instances install
/// (`on_click = handler_if(sortable, cycle)`).
fn handler_if(on: bool, h: fn()) -> Option<fn()> {
    if on {
        return result.some(h)
    }
    return result.none(noop)
}

/// Run an optional handler; nothing when it is absent.
fn emit(h: Option<fn()>) {
    if result.is_some(h) {
        let f = h.val
        f()
    }
}

/// `emit` for a handler that takes a value (`on_select(index)`).
fn emit_with<T>(h: Option<fn(T)>, v: T) {
    if result.is_some(h) {
        let f = h.val
        f(v)
    }
}

/// Default of `on_hover`.
fn no_hover(on: bool) {
    return
}

/// Default of the optional `fn() -> bool` props.
fn no_flag() -> bool {
    return false
}

/// Run `body` as an effect bound to `node`; dropped after its first run when
/// it read no signal, so a constant costs no graph.
fn node_effect(node: Node, body: fn()) {
    let fid = intern_fn(body)
    let eid = track.alloc(fid, node.id)
    track.run(eid)
    if track.dep_count(eid) == 0 {
        arena.forget_intern(fid)
        track.dispose_eid(eid)
    }
}

/// The behaviour props of `BoxProps` (focus, hover, press, entrance).
fn install_behaviour(node: Node, p: BoxProps) {
    let node_id = node.id
    if result.is_some(p.focusable) {
        let f = p.focusable.val
        node_effect(node, || {
            if f() {
                arena.nodes[node_id].focusable = 1
            } else {
                arena.nodes[node_id].focusable = 0
            }
        })
    }
    if result.is_some(p.roving) {
        let r = p.roving.val
        let grab = p.rovingGrab
        node_effect(node, || {
            if r() {
                arena.nodes[node_id].focusable = 1
                if grab {
                    arena.claim_focus(node_id)
                } else {
                    arena.claim_roving_focus(node_id)
                }
            } else {
                arena.nodes[node_id].focusable = 0
            }
        })
    }
    if p.hoverFade {
        hover_fade(node)
    }
    if p.pressScale {
        press_scale(node)
    }
    if p.lift >= 0 {
        hover_lift(node, p.lift)
    }
    if p.enter % 2 == 1 {
        enter_fade(node)
    }
    if (p.enter / 2) % 2 == 1 {
        enter_reveal(node)
    }
    if result.is_some(p.label) {
        let l = p.label.val
        node_effect(node, || { apply_str(node_id, SET.A11yLabel, l()) })
    }
    if result.is_some(p.on_hover) {
        let h = p.on_hover.val
        let hs = signal(0)
        let primed = signal(0)
        hover(node, hs)
        node_effect(node, || {
            let on = hs.get() != 0
            if primed.peek() == 1 {
                h(on)
            } else {
                primed.set(1)
            }
        })
    }
    if result.is_some(p.loading) {
        let b = p.loading.val
        node_effect(node, || { loading(node_handle(node_id), b()) })
    }
}

// --- refs ------------------------------------------------------------------------
// A `Ref` is filled by the element given `ref = r`, so the controller can reach
// that element (measure it, focus it) without building it by hand. It is a
// signal cell: an effect that reads it re-runs when it fills.

/// A handle to an element, filled when the element builds.
struct Ref {
    id: int = 0,
}

/// A new, empty `Ref`. Owned like any state the component creates.
fn ref() -> Ref {
    let cell = signal(0)
    return Ref { id: cell.id }
}

/// The element `r` points at (`Node { id: 0 }` before it builds).
fn ref_node(r: Ref) -> Node {
    if r.id <= 0 {
        return node_handle(0)
    }
    return node_handle(signal_handle(r.id).peek())
}

fn ref_id(r: Ref) -> int {
    return ref_node(r).id
}

fn ref_fill(r: Ref, node_id: int) {
    if r.id > 0 {
        signal_handle(r.id).set(node_id)
    }
}

/// A laid-out box: position and size in dp.
struct Rect {
    x: int = 0,
    y: int = 0,
    w: int = 0,
    h: int = 0,
}

/// `r`'s box from the last layout (all zero before the first).
fn rect(r: Ref) -> Rect {
    let id = ref_id(r)
    if id <= 0 {
        return Rect {}
    }
    return Rect { x: arena.nodes[id].x, y: arena.nodes[id].y,
                  w: arena.nodes[id].w, h: arena.nodes[id].h }
}

/// Number of children of `r`.
fn child_total(r: Ref) -> int {
    let id = ref_id(r)
    if id <= 0 {
        return 0
    }
    return arena.nodes[id].kids.len
}

/// The box of `r`'s child `i`, relative to `r`'s content box (inside its
/// padding and border): where a pinned child of `r` would sit over it.
fn child_rect(r: Ref, i: int) -> Rect {
    let id = ref_id(r)
    if id <= 0 || i < 0 || i >= arena.nodes[id].kids.len {
        return Rect {}
    }
    let k = arena.nodes[id].kids[i]
    return Rect { x: arena.nodes[k].x - arena.content_x(id),
                  y: arena.nodes[k].y - arena.content_y(id),
                  w: arena.nodes[k].w, h: arena.nodes[k].h }
}

/// Run `body` after any layout that changed `r`'s width, the first one
/// included. Call from `on_mount`.
fn on_resize(r: Ref, body: fn()) {
    let id = ref_id(r)
    if id <= 0 {
        return
    }
    arena.nodes[id].list_fn = intern_fn(|| {
        let w = arena.nodes[id].w
        if w == arena.nodes[id].list_gen {
            return
        }
        arena.nodes[id].list_gen = w
        body()
    })
}

/// A ref to child `i` of `r` (empty when there is none): the element a
/// caller's slot built inside a component (`Popover`'s trigger). Call from
/// `on_mount`, once the children exist.
fn child_ref(r: Ref, i: int) -> Ref {
    let out = ref()
    let id = ref_id(r)
    if id > 0 && i >= 0 && i < arena.nodes[id].kids.len {
        ref_fill(out, arena.nodes[id].kids[i])
    }
    return out
}

/// Make `h` the click handler of `r`, replacing any it had: a `Menu` owns its
/// trigger's click.
fn set_on_click(r: Ref, h: fn()) {
    let id = ref_id(r)
    if id > 0 {
        arena.nodes[id].click_fn = intern_fn(h)
    }
}

/// Mirror `r`'s hover state into `sig` (1 while the pointer is over it).
fn watch_hover(r: Ref, sig: Signal<int>) {
    let id = ref_id(r)
    if id > 0 {
        hover(node_handle(id), sig)
    }
}

/// Float `r` beside `target` on `side` (`Place.*`), `gap` dp away, flipping
/// to the other side near a window edge. Call from `on_mount`.
fn anchor(r: Ref, target: Ref, side: int, gap: int) {
    let id = ref_id(r)
    let t = ref_id(target)
    if id > 0 && t > 0 {
        arena.anchor_to(id, t, side, gap)
    }
}

/// Jump `r`'s exit fade to its end, so a closing panel is gone this frame.
fn skip_exit(r: Ref) {
    arena.snap_exit(ref_id(r))
}

/// `skip_exit` for a node handle passed in from outside a component.
fn skip_exit_node(n: Node) {
    arena.snap_exit(n.id)
}

/// Children of the slot being built whose a11y role is `role`, so far: how a
/// table row knows whether it is odd without a counter of its own.
fn slot_count_role(role: string) -> int {
    let pid = current_slot()
    if pid <= 0 {
        return 0
    }
    let mut n = 0
    let kids = arena.nodes[pid].kids
    for i in 0..kids.len {
        if arena.nodes[kids[i]].a11y_role == role {
            n = n + 1
        }
    }
    return n
}

/// Move keyboard focus to `r`.
fn focus(r: Ref) {
    let id = ref_id(r)
    if id > 0 {
        arena.claim_focus(id)
    }
}

/// Keep Tab inside `r` (a modal) until `release_focus_trap(r)`.
fn trap_focus(r: Ref) {
    let id = ref_id(r)
    if id > 0 {
        arena.claim_trap(id)
    }
}

fn release_focus_trap(r: Ref) {
    let id = ref_id(r)
    if id > 0 {
        arena.release_trap(id)
    }
}

// --- the `style` prop ---------------------------------------------------------
// One effect per element evaluates its `style` thunk and writes only the keys
// whose value moved since the last run, through the same setters (and the same
// targeted invalidation) as every other prop: a background change is paint-only
// and damages one node. A style that read no signal on its first run is static:
// its effect is dropped right there and nothing is kept, so a plain
// `Style(gap = 8)` costs one write per key and no graph.

/// Install `style` on `node`. Called last in `Component`, so a key in `style`
/// wins over the matching flat prop and over kind chrome.
fn install_style(node: Node, style: fn() -> Style) {
    let node_id = node.id
    let fid = intern_fn(|| { style_run(node_id, style) })
    let eid = track.alloc(fid, node_id)
    track.run(eid)
    if track.dep_count(eid) == 0 {
        arena.forget_intern(fid)
        track.dispose_eid(eid)
        arena.style_forget(node_id)
    }
}

// --- state styles -------------------------------------------------------------
// `hoverStyle` & co. are merged over the base style by the same effect, which
// also reads the node's interaction mask (`arena.state_sync` writes it once a
// frame when hover / press / focus / disabled moved). A key only an overlay
// sets is restored, when the overlay lets go, to the value the node had under
// its base style: `rest`, read off the node once at install.

struct StateStyles {
    hover: Option<fn() -> Style>,
    press: Option<fn() -> Style>,
    focus: Option<fn() -> Style>,
    disabled: Option<fn() -> Style>,
}

fn has_state_styles(s: StateStyles) -> bool {
    return result.is_some(s.hover) || result.is_some(s.press) ||
        result.is_some(s.focus) || result.is_some(s.disabled)
}

/// The node's raw paint values, to restore a key an overlay set and released.
struct PaintRest {
    bg: int,
    fg: int,
    opacity: int,
    border_w: int,
    border_c: int,
    elev: int,
}

fn paint_rest(id: int) -> PaintRest {
    return PaintRest {
        bg: arena.nodes[id].bg,
        fg: arena.nodes[id].fg,
        opacity: int(arena.nodes[id].opacity),
        border_w: int(arena.nodes[id].border_w),
        border_c: arena.nodes[id].border_c,
        elev: int(arena.nodes[id].elev),
    }
}

/// The overlay for interaction mask `m` (`arena.STATE_*` bits).
fn state_overlay(s: StateStyles, m: int) -> Style {
    let mut o = Style {}
    if (m & arena.STATE_HOVER) != 0 && result.is_some(s.hover) {
        o = merge(o, paint_only(s.hover.val()))
    }
    if (m & arena.STATE_FOCUS) != 0 && result.is_some(s.focus) {
        o = merge(o, paint_only(s.focus.val()))
    }
    if (m & arena.STATE_PRESS) != 0 && result.is_some(s.press) {
        o = merge(o, paint_only(s.press.val()))
    }
    if (m & arena.STATE_DISABLED) != 0 && result.is_some(s.disabled) {
        o = merge(o, paint_only(s.disabled.val()))
    }
    return o
}

fn install_state_style(node: Node, base: fn() -> Style, states: StateStyles) {
    let node_id = node.id
    // Apply the base once so `rest` holds what the node looks like at rest.
    style_apply(node_id, Style {}, base())
    let rest = paint_rest(node_id)
    let mask = signal(0)
    let m0 = arena.state_watch(node_id, mask.id)
    if m0 != 0 {
        mask.set(m0)
    }
    let fid = intern_fn(|| { state_style_run(node_id, base, states, mask, rest) })
    let eid = track.alloc(fid, node_id)
    track.run(eid)
}

fn state_style_run(node_id: int, base: fn() -> Style, states: StateStyles,
                   mask: Signal<int>, rest: PaintRest) {
    let next = merge(base(), state_overlay(states, mask.get()))
    let last = arena.style_last(node_id)
    style_apply(node_id, last, next)
    state_restore(node_id, last, next, rest)
    arena.style_keep(node_id, next)
}

/// A paint key that was set last run and is absent now goes back to `rest`.
fn state_restore(id: int, a: Style, b: Style, rest: PaintRest) {
    if result.is_some(a.background) && !result.is_some(b.background) {
        apply_int_value(id, SET.Background, rest.bg)
    }
    if result.is_some(a.color) && !result.is_some(b.color) {
        apply_int_value(id, SET.Color, rest.fg)
    }
    if result.is_some(a.opacity) && !result.is_some(b.opacity) {
        apply_int_value(id, SET.Opacity, rest.opacity)
    }
    if result.is_some(a.border) && !result.is_some(b.border) {
        apply_int_value(id, SET.Border, rest.border_w)
        apply_int_value(id, SET.BorderColor, rest.border_c)
    }
    if result.is_some(a.elevation) && !result.is_some(b.elevation) {
        apply_int_value(id, SET.Elevation, rest.elev)
    }
}

/// One run of a style effect: diff against the last written `Style`.
fn style_run(node_id: int, style: fn() -> Style) {
    let next = style()
    style_apply(node_id, arena.style_last(node_id), next)
    arena.style_keep(node_id, next)
}

/// Write every key of `b` that is present and differs from `a`. An absent key
/// writes nothing, so a key that goes from present to absent keeps its last
/// value: give both branches a value (`if on { x } else { y }`).
fn style_apply(id: int, a: Style, b: Style) {
    let kind = int(arena.nodes[id].kind)
    st_int(id, SET.ShowOn, a.display, b.display)
    // Direction re-kinds a label into a box, so only containers take it.
    if kind == 1 || kind == 9 || kind == 11 {
        st_int(id, SET.Direction, a.direction, b.direction)
    }
    st_bool(id, SET.WrapFlag, a.wrap, b.wrap)
    st_int(id, SET.Spacing, a.gap, b.gap)
    st_int(id, SET.GapRow, a.rowGap, b.rowGap)
    st_int(id, SET.GapCol, a.columnGap, b.columnGap)
    st_int(id, SET.AlignItems, a.align, b.align)
    st_int(id, SET.Justify, a.justify, b.justify)
    st_int(id, SET.AlignSelf, a.alignSelf, b.alignSelf)
    st_int(id, SET.Grow, a.grow, b.grow)
    st_int(id, SET.Shrink, a.shrink, b.shrink)
    // Anything that grows may also shrink, unless the style says otherwise:
    // keeps a growing child from overflowing its row.
    if !result.is_some(b.shrink) && result.is_some(b.grow) && b.grow.val > 0 {
        if !result.is_some(a.grow) || a.grow.val != b.grow.val {
            apply_int_value(id, SET.Shrink, 1)
        }
    }
    st_int(id, SET.Span, a.span, b.span)
    st_len(id, SET.Width, SET.WidthPct, a.width, b.width)
    st_len(id, SET.Height, SET.HeightPct, a.height, b.height)
    st_int(id, SET.MinWidth, a.minWidth, b.minWidth)
    st_int(id, SET.MaxWidth, a.maxWidth, b.maxWidth)
    st_int(id, SET.MinHeight, a.minHeight, b.minHeight)
    st_int(id, SET.MaxHeight, a.maxHeight, b.maxHeight)
    st_ratio(id, a.aspect, b.aspect)
    st_box_edges(id, SET.Padding, SET.PaddingX, SET.PaddingY,
                 SET.PaddingTop, SET.PaddingRight, SET.PaddingBottom, SET.PaddingLeft,
                 a.padding, b.padding)
    st_box_edges(id, SET.Margin, SET.MarginX, SET.MarginY,
                 SET.MarginTop, SET.MarginRight, SET.MarginBottom, SET.MarginLeft,
                 a.margin, b.margin)
    st_int(id, SET.Position, a.position, b.position)
    st_edges(id, SET.Top, SET.Right, SET.Bottom, SET.Left, a.inset, b.inset)
    st_int(id, SET.ZIndex, a.zIndex, b.zIndex)
    st_int(id, SET.Overflow, a.overflow, b.overflow)
    st_str(id, SET.Background, a.background, b.background)
    st_str(id, SET.Color, a.color, b.color)
    st_int(id, SET.Opacity, a.opacity, b.opacity)
    st_corners(id, a.radius, b.radius)
    st_border(id, kind, a.border, b.border)
    st_int(id, SET.Elevation, a.elevation, b.elevation)
    // An image keeps its fit in the font slot.
    if kind != 14 {
        st_int(id, SET.Font, a.font, b.font)
    }
    st_bool(id, SET.Ellipsis, a.ellipsis, b.ellipsis)
    st_str(id, SET.Cursor, a.cursor, b.cursor)
}

fn st_int(id: int, setter: int, a: Option<int>, b: Option<int>) {
    if !result.is_some(b) {
        return
    }
    if result.is_some(a) && a.val == b.val {
        return
    }
    apply_int_value(id, setter, b.val)
}

fn st_bool(id: int, setter: int, a: Option<bool>, b: Option<bool>) {
    if !result.is_some(b) {
        return
    }
    if result.is_some(a) && a.val == b.val {
        return
    }
    if b.val {
        apply_int_value(id, setter, 1)
    } else {
        apply_int_value(id, setter, 0)
    }
}

/// A color or a name. `""` is a value too: a cleared background.
fn st_str(id: int, setter: int, a: Option<string>, b: Option<string>) {
    if !result.is_some(b) {
        return
    }
    if result.is_some(a) && a.val == b.val {
        return
    }
    match setter {
        SET.Background | SET.Color | SET.BorderColor => {
            apply_int_value(id, setter, parse_hex_color(b.val))
        }
        _ => { apply_str(id, setter, b.val) }
    }
}

/// `px` pins the length and clears a percentage; `pct` does the reverse.
fn st_len(id: int, px_setter: int, pct_setter: int, a: Option<Len>, b: Option<Len>) {
    if !result.is_some(b) {
        return
    }
    if result.is_some(a) && a.val.unit == b.val.unit && a.val.v == b.val.v {
        return
    }
    if b.val.unit == LenUnit.Pct {
        apply_int_value(id, pct_setter, b.val.v)
        return
    }
    if px_setter == SET.Height {
        apply_int_value(id, SET.HeightPct, -1)
    }
    apply_int_value(id, px_setter, b.val.v)
}

fn st_ratio(id: int, a: Option<Ratio>, b: Option<Ratio>) {
    if !result.is_some(b) {
        return
    }
    if result.is_some(a) && a.val.w == b.val.w && a.val.h == b.val.h {
        return
    }
    aspect(node_handle(id), b.val.w, b.val.h)
    arena.note_prop_write(id, 1)
}

/// Side by side: only the sides present in `b` and changed are written.
fn st_edges(id: int, top: int, right: int, bottom: int, left: int,
            a: Option<Edges>, b: Option<Edges>) {
    if !result.is_some(b) {
        return
    }
    let mut e = Edges {}
    if result.is_some(a) {
        e = a.val
    }
    st_int(id, top, e.top, b.val.top)
    st_int(id, right, e.right, b.val.right)
    st_int(id, bottom, e.bottom, b.val.bottom)
    st_int(id, left, e.left, b.val.left)
}

fn st_corners(id: int, a: Option<Corners>, b: Option<Corners>) {
    if !result.is_some(b) {
        return
    }
    if result.is_some(a) && corners_eq(a.val, b.val) {
        return
    }
    let c = b.val
    // The uniform radius takes the shared field (and the uniform paint path);
    // only corners that differ from it become overrides, as `radius` plus
    // `radius_top` always did.
    let mut base = -1
    if result.is_some(c.br) {
        base = c.br.val
    } else if result.is_some(c.tl) {
        base = c.tl.val
    }
    if base >= 0 {
        apply_int_value(id, SET.Radius, base)
    }
    corner_override(id, SET.CornerTL, c.tl, base)
    corner_override(id, SET.CornerTR, c.tr, base)
    corner_override(id, SET.CornerBR, c.br, base)
    corner_override(id, SET.CornerBL, c.bl, base)
}

fn corner_override(id: int, setter: int, v: Option<int>, base: int) {
    if result.is_some(v) && v.val != base {
        apply_int_value(id, setter, v.val)
    }
}

fn corners_eq(a: Corners, b: Corners) -> bool {
    return opt_int_eq(a.tl, b.tl) && opt_int_eq(a.tr, b.tr) && opt_int_eq(a.br, b.br) &&
           opt_int_eq(a.bl, b.bl)
}

fn opt_int_eq(a: Option<int>, b: Option<int>) -> bool {
    if result.is_some(a) != result.is_some(b) {
        return false
    }
    return !result.is_some(a) || a.val == b.val
}

/// Padding or margin: all four equal is the `all` setter, equal pairs the axis
/// setters, anything else per side, so a node's fields are written exactly as
/// the matching flat props wrote them.
fn st_box_edges(id: int, all: int, sx: int, sy: int, top: int, right: int, bottom: int,
                left: int, a: Option<Edges>, b: Option<Edges>) {
    if !result.is_some(b) {
        return
    }
    let e = b.val
    if result.is_some(a) && opt_int_eq(a.val.top, e.top) && opt_int_eq(a.val.right, e.right) &&
       opt_int_eq(a.val.bottom, e.bottom) && opt_int_eq(a.val.left, e.left) {
        return
    }
    let full = result.is_some(e.top) && result.is_some(e.right) && result.is_some(e.bottom) &&
               result.is_some(e.left)
    if full && e.top.val == e.right.val && e.top.val == e.bottom.val && e.top.val == e.left.val {
        apply_int_value(id, all, e.top.val)
        return
    }
    let mut done_x = false
    let mut done_y = false
    if result.is_some(e.left) && result.is_some(e.right) && e.left.val == e.right.val {
        apply_int_value(id, sx, e.left.val)
        done_x = true
    }
    if result.is_some(e.top) && result.is_some(e.bottom) && e.top.val == e.bottom.val {
        apply_int_value(id, sy, e.top.val)
        done_y = true
    }
    if !done_y {
        if result.is_some(e.top) {
            apply_int_value(id, top, e.top.val)
        }
        if result.is_some(e.bottom) {
            apply_int_value(id, bottom, e.bottom.val)
        }
    }
    if !done_x {
        if result.is_some(e.left) {
            apply_int_value(id, left, e.left.val)
        }
        if result.is_some(e.right) {
            apply_int_value(id, right, e.right.val)
        }
    }
}

fn st_border(id: int, kind: int, a: Option<Border>, b: Option<Border>) {
    if !result.is_some(b) {
        return
    }
    let w = b.val.width
    let c = b.val.color
    let mut aw = result.none(0)
    let mut ac = result.none("")
    if result.is_some(a) {
        aw = a.val.width
        ac = a.val.color
    }
    // Only boxes and buttons carry a border width (it insets their content).
    if kind == 1 || kind == 4 {
        st_int(id, SET.Border, aw, w)
    }
    if result.is_some(c) && (!result.is_some(ac) || ac.val != c.val) {
        apply_int_value(id, SET.BorderColor, parse_hex_color(c.val))
    }
}

/// Apply every style, event, bind, visible, and press prop, then attach
/// `node` to the current `slot` parent. Kind-specific chrome (native
/// thumbs, overlay float, text-input edit, list rebuild) is handled here
/// so widgets stay data.
fn Component(node: Node, p: BoxProps) -> Node {
    arena.ensure()
    arena.component_runs = arena.component_runs + 1
    shrink(node, 0)
    let k = int(arena.nodes[node.id].kind)
    // Containers lay out as a column unless their style says otherwise.
    if k == 1 || k == 9 || k == 11 {
        set_prop_int(node, SET.Direction, Direction.Column)
    }
    set_prop_int(node, SET.Safe, if p.safe { 1 } else { 0 })
    if k == 14 {
        set_prop_int(node, SET.SvgFit, p.fit)
        set_prop_int(node, SET.SvgLazy, if p.lazy { 1 } else { 0 })
    }
    // A disabled element paints at 40% so "not available" reads without every
    // recipe hand-dimming its colors (a style `opacity` still wins). The shared
    // state overlay records disabled once, so hover / press read one model.
    if p.enabled {
        arena.set_disabled(node.id, 0)
    } else {
        set_prop_int(node, SET.Opacity, 40)
        arena.set_disabled(node.id, 1)
    }
    if k == 10 {
        set_prop_int(node, SET.Wrap, if p.multiline { 1 } else { 0 })
    }
    set_prop_str(node, SET.A11yRole, p.role)
    if result.is_some(p.text) {
        prop_str(node, SET.Text, p.text.val)
    }
    if result.is_some(p.on_click) {
        arena.nodes[node.id].click_fn = intern_fn(p.on_click.val)
        arena.nodes[node.id].focusable = 1
    }
    if result.is_some(p.on_mouse_down) {
        arena.nodes[node.id].down_fn = intern_fn(p.on_mouse_down.val)
    }
    if result.is_some(p.on_mouse_up) {
        arena.nodes[node.id].up_fn = intern_fn(p.on_mouse_up.val)
    }
    // Installed after the click handler, so a `chord_click` binding has
    // something to call.
    install_keys(node, p.keys)
    if result.is_some(p.on_key_down) {
        arena.nodes[node.id].kdown_fn = intern_fn(p.on_key_down.val)
        arena.nodes[node.id].focusable = 1
    }
    if result.is_some(p.on_key_up) {
        arena.nodes[node.id].kup_fn = intern_fn(p.on_key_up.val)
        arena.nodes[node.id].focusable = 1
    }
    if result.is_some(p.on_key_press) {
        arena.nodes[node.id].kpress_fn = intern_fn(p.on_key_press.val)
        arena.nodes[node.id].focusable = 1
    }
    // `hoverOff` is a plain bool field, so interning a thunk here only to
    // invoke it on the next line allocated a closure env capturing the whole
    // BoxProps (624 B) on every Component — and the env outlives the interned
    // copy, so it leaked once per node build. Read the field directly.
    if p.hoverOff {
        hover_off(node)
    }
    if result.is_some(p.bind) {
        bind(node, p.bind.val)
    }
    if result.is_some(p.visible) {
        show(node, visible_signal(node, p.visible.val))
    }
    if p.press {
        arena.nodes[node.id].press = 1
    }
    if result.is_some(p.edit) {
        if p.edit.val.id > 0 {
            let sig = p.edit.val
            let node_id = node.id
            arena.nodes[node_id].edit_sig = sig.id
            arena.nodes[node_id].bind_fn = intern_fn(|| { set(sig, arena.input_committed(node_id)) })
            /* Seed the edit buffer from the bound signal. The signal is the
               field's text until the user edits it, and the C-side buffer is
               what every read goes through (`input_shown`, the caret, and the
               Backspace / Delete handlers), so without this the field draws its
               PLACEHOLDER while the signal holds a value — and a Backspace has
               an empty buffer to delete from, i.e. clearing does nothing. That
               is what made a restored draft (std:kv) or a pre-filled form look
               and behave empty.

               Only on a real difference: a rebuild re-runs this on every
               keystroke, and `plat_edit_set` resets the caret to the end and
               drops the selection, so an unconditional seed would make typing
               anywhere but the end jump to the end. When the buffer already
               holds what the signal holds, the two agree and there is nothing
               to adopt. */
            let seed = sig.get()
            if arena.input_committed(node_id) != seed {
                set_input(node, seed)
            }
        }
    }
    if p.rowHeight != 0 {
        arena.nodes[node.id].row_h = p.rowHeight
    }
    if result.is_some(p.rebuild) {
        arena.nodes[node.id].list_fn = intern_fn(p.rebuild.val)
    }
    if k == 7 {
        set_background(node, role_color(ROLE.Rule))
        set_color(node, role_color(ROLE.Ink))
        border_color(node, role_color(ROLE.Plate))
        arena.nodes[node.id].focusable = 1
    }
    if k == 13 {
        set_background(node, role_color(ROLE.Hard))
        set_color(node, role_color(ROLE.Ink))
        border_color(node, role_color(ROLE.Plate))
        if result.is_some(p.bind) {
            keys(node, p.bind.val, 0, 100)
        }
    }
    if k == 6 {
        set_background(node, role_color(ROLE.Hard))
        set_color(node, role_color(ROLE.Ink))
        border_color(node, role_color(ROLE.Plate))
    }
    if k == 9 {
        arena.nodes[node.id].dir = 1
        center(node)
        z_index(node, 50)
    }
    if k == 11 {
        if result.is_some(p.bind) {
            let node_id = node.id
            let signal_id = p.bind.val.id
            styled(node, || {
                let y = signal_handle(signal_id).get()
                if arena.nodes[node_id].scroll_y != y {
                    arena.nodes[node_id].vel_y = 0
                    arena.nodes[node_id].scroll_y = y
                    arena.clamp_scroll(node_id)
                }
            })
        }
    }
    let states = StateStyles {
        hover: p.hoverStyle,
        press: p.pressStyle,
        focus: p.focusStyle,
        disabled: p.disabledStyle,
    }
    if has_state_styles(states) {
        if result.is_some(p.pressStyle) {
            arena.nodes[node.id].press = 1
        }
        let mut base: fn() -> Style = no_style
        if result.is_some(p.style) {
            base = p.style.val
        }
        install_state_style(node, base, states)
    } else if result.is_some(p.style) {
        install_style(node, p.style.val)
    }
    install_behaviour(node, p)
    if result.is_some(p.ref) {
        ref_fill(p.ref.val, node.id)
    }
    let slot_id = current_slot()
    if slot_id > 0 {
        child(node_handle(slot_id), node)
    }
    view_note(node.id, slot_id)
    return node
}

/// Run `build` with `host` as the parent. Trailing blocks lower to this.
fn slot(host: Node, build: fn()) -> Node {
    ui_push(host.id)
    build()
    ui_pop()
    return host
}

/// Compiler trailing-block sugar until `slot` is the emitted name.
fn __ui_scope(node: Node, build: fn()) -> Node {
    return slot(node, build)
}

fn ui_emit(node: Node) -> Node {
    return Component(node)
}

struct TextProps {
    /// CSS-subset style: `color`, `font`, `wrap`, `ellipsis`, and the box keys
    /// (`grow`, `inset` for pinned chart text, ...).
    style: Option<fn() -> Style> = none,
    /// Filled with this label; see `BoxProps.ref`.
    ref: Option<Ref> = none,
    /// Paint this integer signal's live value (cheaper than a text thunk: no
    /// string is built per change).
    bind: Option<Signal<int>> = none,
    /// Accessibility role and name; see `BoxProps`.
    role: string = "",
    label: Option<fn() -> string> = none,
    /// Keyboard actions on this element (`chord(...)`, `chord_click(...)`).
    keys: []KeyBind = no_keys(),
}
/// A flex container. Trailing block is the slot.
fn Box(p: BoxProps) -> Node {
    return Component(raw_box(), p)
}

/// Static or reactive text. The label is a thunk, so a signal read inside it
/// is recorded against this label's own effect: setting the signal repaints
/// this one node. The compiler lifts a plain expression —
/// `Text("n={{count.get()}}")` — into that thunk, so callers write data.
fn Text(label: fn() -> string, p: TextProps) -> Node {
    return Component(raw_label(""), text = label, style = p.style, ref = p.ref, bind = p.bind,
                     label = p.label, role = p.role, keys = p.keys)
}
// --- elevation ------------------------------------------------------------
// The curves and the `Elev` record live in the core (`arena`), because the
// paint pass resolves a node's shadow and cannot import this module. These are
// the public spellings; they delegate so there is one home for the numbers.

/// Elevation for `level` 0..4, light appearance.
fn elevation(level: int) -> Elev {
    return arena.elevation(level)
}

/// Elevation for `level` 0..4, dark appearance. A dark UI needs a darker,
/// tighter shadow: the same alpha over a near-black surface is invisible, so
/// every level roughly doubles its opacity and pulls the blur in.
fn elevation_dark(level: int) -> Elev {
    return arena.elevation_dark(level)
}

/// Elevation resolved for the current appearance.
fn elev_now(level: int) -> Elev {
    return arena.elev_now(level)
}

// --- motion ---------------------------------------------------------------
/// Transition durations in milliseconds. Anything that moves uses one of
/// these three; a bespoke duration is a bug, not a refinement.
enum Motion {
    // Hover, press, focus — feedback that must feel instant.
    Fast = 100,
    // The default: state changes, indicators, switches.
    Base = 170,
    // Entrances and exits of large surfaces (dialog, drawer, toast).
    Slow = 270,
}

/// Easing curves. Integer ids — the curve itself lives in the animation
/// subsystem (`arena.anim_ease`), which evaluates a CSS cubic-bezier per
/// track without allocating. Control points are documented there.
enum EASE {
    // No shaping. Progress bars and crossfades of colour only.
    Linear = 0,
    // The workhorse: fast out, slow in. cubic-bezier(0.215, 0.61, 0.355, 1)
    // (ease-out cubic). Everything unspecified uses it.
    Standard = 1,
    // More pronounced deceleration, for entrances that should feel arrived.
    // cubic-bezier(0.23, 1, 0.32, 1) (ease-out quint).
    Emphasized = 2,
    // Overshoots and settles. Switch thumbs and anything that "snaps".
    // cubic-bezier(0.34, 1.56, 0.64, 1) (ease-out-back).
    Spring = 3,
}


/// Line box for `font` px at a `LEAD_*` percentage.
fn line_height(font: int, lead: int) -> int {
    return font * lead / 100
}

// --- typography ---

/// Set the typeface for every label the app draws. One family for the whole
/// app, applied by the host when it measures and draws — there is no
/// per-node family, because the design system uses one typeface and the
/// text ABI carries a pixel size only.
///
/// ```
/// zeus.set_font_family("Universal Sans")
/// ```
/// Pass `""` to fall back to the host's default UI font.
fn set_font_family(name: string) {
    arena.ensure()
    platform.plat_set_font_family(name)
}

/// Register a font the host does not ship, then make it current. `src` is a
/// file path on desktop or a URL on the web. Returns 1 when the host
/// accepted it, 0 when it did not — callers should keep working on the
/// fallback rather than assume the face is present.
///
/// ```
/// if zeus.load_font("Universal Sans", "./fonts/UniversalSans.woff2") == 0 {
///     zeus.set_font_family("Inter")
/// }
/// ```
fn load_font(family: string, src: string) -> int {
    arena.ensure()
    let ok = platform.plat_load_font(family, src)
    if ok != 0 {
        platform.plat_set_font_family(family)
    }
    return ok
}

/// Measure text in-tree from an external font, so every host computes the same
/// line box for the same (font, size, string). `src` is a file path on desktop
/// or a URL on the web.
///
/// Pair it with `load_font(family, src)` so the host *draws* with the same
/// face; this binds the bytes that layout measures with. Returns 1 when the
/// font was read and parsed, 0 when it could not be (the app then keeps host
/// measurement and should not assume the face is present).
///
/// ```
/// if zeus.use_font("./fonts/Inter.ttf") == 0 {
///     // host metrics remain in effect
/// }
/// ```
fn use_font(src: string) -> int {
    arena.ensure()
    return metrics.bind(platform.plat_font_bytes(src))
}

/// Bind already-loaded font bytes for in-tree measurement. The web host has no
/// filesystem, so a web app passes the bytes it fetched itself; desktop apps
/// can use `use_font` instead.
fn use_font_bytes(bytes: string) -> int {
    return metrics.bind(bytes)
}

/// Drop the external font; measurement falls back to the host default.
fn clear_font() {
    metrics.unbind()
}


/// Theme roles. `accent` is the live brand ramp's solid step — blue by
/// default, and whatever `set_accent` picks after that. Status tints (ok,
/// danger) stay semantic; the chart fields are the data-viz layer every chart
/// reads (stroke + area wash).
// --- C boundary hooks -----------------------------------------------------
// Bodyless: the runtime implements these (see `zeus_plat.c`), and `zeus`
// re-exports them. Named `on_*` / `*_key` because they are the keyboard and
// focus seams the host drives.

fn on_action(node: Node, action: string, sig: Signal<int>, mode: int, value: int) -> Node {}
fn on_action_global(action: string, sig: Signal<int>, mode: int, value: int) {}

/// Step `sig` by `delta`, clamped to lo..hi — arrow navigation over a range.
fn on_range(node: Node, action: string, sig: Signal<int>, delta: int, lo: int, hi: int) -> Node {}
fn map_key(spec: string, action: string, ctx: string) {}
fn remap_key(spec: string, action: string, ctx: string) {}
/// Foreground text. `ink` is the strongest ink.
fn ink() -> string { return role_token(ROLE.Ink) }

/// Primary: fills for default buttons, switches, selection. The accent ramp's
/// solid step (`register_accent`), blue by default.
fn accent() -> string { return role_token(ROLE.Accent) }

/// Destructive text (errors, destructive alerts).
fn danger() -> string { return role_token(ROLE.Danger) }

fn ok_bg() -> string { return role_token(ROLE.OkS3) }

fn ok_line() -> string { return role_token(ROLE.OkS6) }

fn ok_fill_solid() -> string { return role_token(ROLE.OkS9) }

fn ok_ink() -> string { return role_token(ROLE.OkS11) }

fn warn_bg() -> string { return role_token(ROLE.WarnS3) }

fn warn_line() -> string { return role_token(ROLE.WarnS6) }

fn warn_fill_solid() -> string { return role_token(ROLE.WarnS9) }

fn warn_ink() -> string { return role_token(ROLE.WarnS11) }

fn danger_bg() -> string { return role_token(ROLE.DangerS3) }

fn danger_line() -> string { return role_token(ROLE.DangerS6) }

fn danger_fill_solid() -> string { return role_token(ROLE.DangerS9) }

fn danger_ink() -> string { return role_token(ROLE.DangerS11) }

fn info_bg() -> string { return role_token(ROLE.InfoS3) }

fn info_line() -> string { return role_token(ROLE.InfoS6) }

fn info_fill_solid() -> string { return role_token(ROLE.InfoS9) }

fn info_ink() -> string { return role_token(ROLE.InfoS11) }

/// A color that names a theme slot instead of carrying a value. Resolved by
/// the paint pass, so it follows `appearance()` with no effect attached.
fn role_token(slot: int) -> string {
    return "@{{slot}}"
}

