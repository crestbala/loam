    on_solid = "#ffffff",
    accent = "#0a0a0a",
    accent_soft = "#f1f2f6",
    danger = "#ef4343",
    danger_solid = "#dc2828",
    success = "#21c45d",
    success_fill = "#e4f8ec",
    warn = "#e7b008",
    warn_fill = "#fdf7e6",
    warn_edge = "#fad66b",
    danger_edge = "#f69898",
    ok_solid = "#189044",
    on_fill = "#ffffff",
    scrim = "#000000",
    chart_edge = "#d5d9e2",
    chart1 = "#ff6308",
    chart2 = "#6c28d9",
    chart3 = "#0a1626",
    chart4 = "#477cc2",
    chart5 = "#23958f",
    fill1 = "#ffece1",
    fill2 = "#ede5fa",
    fill3 = "#e2e3e5",
    fill4 = "#e9eff8",
    fill5 = "#e5f2f2"
)

/// Dark is the xAI canvas: near-black edge to edge, white ink, hairline
/// borders. Values are the published xAI tokens — canvas `0 0% 4%`, card
/// `0 0% 10%`, soft `221 12% 14%`, mid `216 4% 22%`, hairline `221 12% 14%`,
/// body `222 19% 86%`, mute `216 4% 51%` — with the light-appropriate
/// sunset / dawn / dusk / twilight / breeze series for charts.
const DARK: Palette = Palette(
    bg = "#0a0a0a",
    card = "#1a1a1a",
    raised = "#1f2228",
    text = "#ffffff",
    muted = "#d5d9e2",
    faint = "#7d8187",
    line = "#1f2228",
    line_strong = "#36383a",
    wash = "#121212",
    on_solid = "#0a0a0a",
    accent = "#ffffff",
    accent_soft = "#1f2228",
    danger = "#e66565",
    danger_solid = "#dc2828",
    success = "#4ade80",
    success_fill = "#142c1d",
    warn = "#f8c630",
    warn_fill = "#2e2610",
    warn_edge = "#947005",
    danger_edge = "#9a1919",
    ok_solid = "#189044",
    on_fill = "#ffffff",
    scrim = "#000000",
    chart_edge = "#1f2228",
    chart1 = "#ff6308",
    chart2 = "#a689fa",
    chart3 = "#9cb8dd",
    chart4 = "#ffd085",
    chart5 = "#45d3cc",
    fill1 = "#361a0a",
    fill2 = "#262135",
    fill3 = "#242930",
    fill4 = "#362e20",
    fill5 = "#152e2d"
)
fn tint_of(kind: int) -> string {
    match kind {
        TINT.Ok => { return ok() }
        TINT.Mute => { return mute() }
        TINT.Dim => { return dim() }
        TINT.Danger => { return danger() }
        TINT.Warn => { return warn() }
        _ => { return ink() }
    }
}

fn empty_view() -> Node {
    return Node { id: 0 }
}
/// Move `sig` toward `to` over `ms` milliseconds.
///
/// **Behaviour change (Phase 3):** the signal's *state* moves to `to` once —
/// every effect bound to `sig` re-runs once — and the moving value is a
/// paint-only overlay interpolated on the animation track pool. Effects no
/// longer re-run per frame, and nothing re-runs inside the tick at all. A new
/// call retargets an in-flight animation from its current value. `ms == 0`
/// jumps; before the first frame it jumps too (nothing animates at boot).
///
/// A layout prop the write lands on (width / height / a pin) does not jump
/// to `to`: it stays at its current length and tweens on the same track,
/// reflowing each frame. Paint-only readers (`Progress`, `anim_paint`) still
/// use the overlay. Hover / press never reflow.
fn animate(sig: Signal<int>, to: int, ms: int) {
    arena.anim_signal(sig.id, to, ms)
}


/// 2D grid configuration.
struct GridConfig {
    /// Column count. In auto mode (see `auto_columns`) it is instead the cap
    /// on the count, and `0` means no cap — the width alone decides.
    /// `GridConfig {}`, like any count `< 1`, is a single column.
    columns: int = 0,
    gap: int = 0,
    padding: int = 0,
    /// The narrowest a cell may be, in points like `gap`. This is what makes
    /// the grid responsive: the count becomes how many cells at least this
    /// wide fit the width the grid is given, capped by `columns` and by the
    /// child count. With `gap = 12` and `auto_columns = 220`, a grid with 1000
    /// points of content width fits four cells (and `columns = 3` takes it back
    /// to three), 620 points fits two, 420 fits one. The gap is part of the
    /// cell, because `cols` cells leave `cols - 1` gaps.
    ///
    /// `0` is the same thing with the width taken from the children instead —
    /// a cell is as wide as the widest child wants to be — so the count
    /// follows the content and needs no number to pick. `-1` (the default)
    /// keeps the fixed `columns` behaviour.
    ///
    /// A constant, not a signal: a cell width is a layout parameter, so
    /// re-resolving it every frame would buy nothing.
    auto_columns: int = -1,
}

// --- C boundary hooks -----------------------------------------------------
// Bodyless: the runtime implements these (see `zeus_plat.c`), and `zeus`
// re-exports them. Named `on_*` / `*_key` because they are the keyboard and
// focus seams the host drives.

fn on_action(node: Node, action: string, sig: Signal<int>, mode: int, value: int) -> Node {}
fn on_action_global(action: string, sig: Signal<int>, mode: int, value: int) {}

/// Step `sig` by `delta`, clamped to lo..hi — arrow navigation over a range.
fn on_range(node: Node, action: string, sig: Signal<int>, delta: int, lo: int, hi: int) -> Node {}
fn map_key(spec: string, action: string, ctx: string) {}
fn remap_key(spec: string, action: string, ctx: string) {}
