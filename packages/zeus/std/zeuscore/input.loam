//! input — hit-test, click, scroll, drag, hover (GPUI input.rs / window events).
//!
//! Scroll: wheel `dx`/`dy` go to the innermost scroller that overflows on that
//! axis (table H vs page V). Leftover delta at a bound chains to the parent
//! scroller (nested feed vs page). Thumb drag: `drag_bar` 1 = vertical,
//! 2 = horizontal. Hit tests add `scroll_x`/`scroll_y` when walking into a pane.

import "arena.loam"
import "nodes.loam"
import "geometry.loam"
import "platform.loam"
import "runtime.loam"
import "std:unicode"

struct Click {
    signal_id: int,
    mode: int,
    setv: int,
}

/// 1 while a hit walk runs inside a floater (`hit_one_floater`): nested
/// floaters are then part of the walk. Outside it, the tree walk skips every
/// floater — `hit_floaters` already tested them, above the page, in z order,
/// exactly as paint stacks them.
let mut hit_in_floater: int = 0

/// Which thumb the last hit walk landed on: 1 vertical, 2 horizontal, 0 none.
/// Recorded where the test ran, in the scroller's own parent coordinates — a
/// nested scroller under a scrolled page cannot be re-tested with the window
/// point, which is what `click` used to do (and missed by the page's offset).
let mut hit_bar: int = 0
/// The floater the last `scroll_target` stopped in, 0 for none.
let mut scroll_stop: int = 0
/// Key codes `key_scroll` answers (`KeyEvent.key`), and an arrow's distance.
const KEY_SPACE: int = 32
const KEY_UP: int = 1002
const KEY_DOWN: int = 1003
const KEY_PAGE_UP: int = 1004
const KEY_PAGE_DOWN: int = 1005
const KEY_HOME: int = 1006
const KEY_END: int = 1007
const KEY_LINE: int = 64

fn hit_one_floater(id: int, sx: int, sy: int) -> int {
    if int(nodes.ui[id].ptr_pass) != 0 {
        return 0
    }
    if arena.ptr_in_float_clip(id) == 0 {
        return 0
    }
    let was = hit_in_floater
    hit_in_floater = 1
    let mut h = 0
    if nodes.is_window_floater(id) != 0 {
        h = hit_node(id, arena.ptr_x, arena.ptr_y)
    } else {
        h = hit_node(id, arena.ptr_x + sx, arena.ptr_y + sy)
    }
    hit_in_floater = was
    return h
}

/// The point a child walk should test `c` with: window coordinates for an
/// overlay or anchored popup, the parent's content coordinates otherwise.
fn kid_px(c: int, cx: int) -> int {
    if nodes.is_window_floater(c) != 0 {
        return arena.ptr_x
    }
    return cx
}

fn kid_py(c: int, cy: int) -> int {
    if nodes.is_window_floater(c) != 0 {
        return arena.ptr_y
    }
    return cy
}

fn hit_floaters(id: int, px: int, py: int) -> int {
    if id <= 0 {
        return 0
    }
    arena.floater_clear()
    arena.floater_collect(id, 0, 0, 0)
    arena.floater_sort(1)
    let n = arena.floater_id.len
    for i in 0..n {
        let h = hit_one_floater(
            arena.floater_id[i],
            arena.floater_screen_x[i],
            arena.floater_screen_y[i],
        )
        if h != 0 {
            return h
        }
    }
    return 0
}

fn hit_scrollbar(id: int, px: int, py: int) -> int {
    if platform.plat_overlay_scroll() != 0 {
        return 0
    }
    if arena.bar_live(id) == 0 {
        return 0
    }
    // The whole track, not just the thumb: a press off the thumb brings it there.
    let tx = arena.bar_x(id, nodes.box[id].x)
    let text_width = arena.bar_w_of(id)
    let ty = arena.bar_y(id, nodes.box[id].y)
    let text_height = arena.bar_track_h(id)
    if px < tx {
        return 0
    }
    if px >= tx + text_width {
        return 0
    }
    if py < ty {
        return 0
    }
    if py >= ty + text_height {
        return 0
    }
    return 1
}

fn hit_h_scrollbar(id: int, px: int, py: int) -> int {
    if platform.plat_overlay_scroll() != 0 {
        return 0
    }
    if arena.bar_live_x(id) == 0 {
        return 0
    }
    let tx = arena.bar_hx(id, nodes.box[id].x)
    let text_width = arena.bar_track_w(id)
    let ty = arena.bar_hy(id, nodes.box[id].y)
    let text_height = arena.bar_w_of(id)
    if px < tx {
        return 0
    }
    if px >= tx + text_width {
        return 0
    }
    if py < ty {
        return 0
    }
    if py >= ty + text_height {
        return 0
    }
    return 1
}

fn hit_node(id: int, px: int, py: int) -> int {
    if id <= 0 {
        return 0
    }
    if arena.want_show(id) == 0 {
        return 0
    }
    if int(nodes.tree[id].kind) == 11 {
        if arena.in_box(id, px, py) == 0 {
            return 0
        }
        if hit_h_scrollbar(id, px, py) != 0 {
            hit_bar = 2
            return id
        }
        if hit_scrollbar(id, px, py) != 0 {
            hit_bar = 1
            return id
        }
    }
    // An `overflow` box clips what it paints, so it clips what it hits.
    if nodes.lay[id].overflow == 1 {
        if arena.in_box(id, px, py) == 0 {
            return 0
        }
    }
    let mut cx = px
    let mut cy = py
    if int(nodes.tree[id].kind) == 11 {
        cx = px + nodes.scrl[id].scroll_x
        cy = py + nodes.scrl[id].scroll_y
    }
    let nk = nodes.tree[id].kids.len
    for j in 0..nk {
        let c = nodes.tree[id].kids[nk - 1 - j]
        if hit_in_floater == 0 && nodes.is_floater(c) != 0 {
            continue
        }
        let h = hit_node(c, kid_px(c, cx), kid_py(c, cy))
        if h != 0 {
            return h
        }
    }
    if arena.in_box(id, px, py) == 0 {
        return 0
    }
    if int(nodes.ui[id].ptr_pass) != 0 {
        return 0
    }
    if nodes.ui[id].click_sig > 0 {
        return id
    }
    if nodes.ui[id].click_fn > 0 {
        return id
    }
    // A node carrying only a pointer handler is hit-testable; children are
    // tried first, so this doubles as event bubbling.
    if nodes.ui[id].down_fn > 0 {
        return id
    }
    if nodes.ui[id].up_fn > 0 {
        return id
    }
    // So is one with a context-menu or drag hook (a region, a track).
    if arena.hook_node.len > 0 {
        if arena.hook_of(id, arena.HOOK_CONTEXT) > 0 || arena.hook_of(id, arena.HOOK_DRAG) > 0 {
            return id
        }
    }
    if int(nodes.tree[id].kind) == 4 {
        return id
    }
    if int(nodes.tree[id].kind) == 13 {
        if nodes.ui[id].bind_sig > 0 {
            return id
        }
    }
    if int(nodes.tree[id].kind) == 7 {
        if nodes.ui[id].click_sig > 0 {
            return id
        }
    }
    if int(nodes.tree[id].kind) == 8 {
        if nodes.ui[id].click_sig > 0 {
            return id
        }
    }
    if int(nodes.tree[id].kind) == 11 {
        return id
    }
    if int(nodes.tree[id].kind) == 10 {
        return id
    }
    if int(nodes.ui[id].focusable) != 0 {
        return id
    }
    return 0
}

/// Secondary click at (`px`, `py`): the nearest ancestor of the hit node with
/// an `on_context_menu` handler runs, with the point in `current_mouse()`
/// (`button` 2). Returns 1 when a handler ran, so the host suppresses its own
/// menu.
fn context_click(px: int, py: int) -> int {
    arena.ensure()
    arena.ptr_x = px
    arena.ptr_y = py
    if arena.root_id <= 0 || arena.hook_node.len == 0 {
        return 0
    }
    let mut hit = hit_floaters(arena.root_id, px, py)
    if hit <= 0 {
        hit = hit_node(arena.root_id, px, py)
    }
    // Over the scrim of something open, a secondary click dismisses it as a
    // primary one does, then lands on what it was covering.
    if hit > 0 && int(nodes.tree[hit].kind) == 9 && nodes.ui[hit].click_fn > 0 {
        arena.invoke_handler(nodes.ui[hit].click_fn, hit)
        arena.mark_chrome()
        hit = hit_floaters(arena.root_id, px, py)
        if hit <= 0 {
            hit = hit_node(arena.root_id, px, py)
        }
    }
    let id = arena.hook_owner(hit, arena.HOOK_CONTEXT)
    if id <= 0 {
        return 0
    }
    if arena.is_inert(id) != 0 {
        return 1
    }
    arena.ev_x = px
    arena.ev_y = py
    arena.ev_button = 2
    arena.invoke_handler(arena.hook_of(id, arena.HOOK_CONTEXT), id)
    arena.ev_button = 0
    arena.mark_chrome()
    return 1
}

/// What a finger at (`px`, `py`) grabs, without pressing it.
/// 1 = a slider or a scrollbar thumb: the gesture must not scroll the page.
/// 2 = an `on_drag` region (a text selection): a vertical pan may still scroll.
/// 0 = an ordinary control, or empty space.
fn grab(px: int, py: int) -> int {
    arena.ensure()
    arena.ptr_x = px
    arena.ptr_y = py
    if arena.root_id <= 0 {
        return 0
    }
    hit_bar = 0
    let mut id = hit_floaters(arena.root_id, px, py)
    if id <= 0 {
        hit_bar = 0
        id = hit_node(arena.root_id, px, py)
    }
    if id <= 0 {
        return 0
    }
    if arena.is_inert(id) != 0 {
        return 0
    }
    if int(nodes.tree[id].kind) == 11 && hit_bar != 0 {
        return 1
    }
    if int(nodes.tree[id].kind) == 13 && nodes.ui[id].bind_sig > 0 {
        return 1
    }
    if arena.hook_owner(id, arena.HOOK_DRAG) > 0 {
        return 2
    }
    return 0
}

fn click(px: int, py: int) -> int {
    arena.ensure()
    arena.ptr_x = px
    arena.ptr_y = py
    arena.drag_id = 0
    arena.drag_bar = 0
    // Pointer interaction dismisses the keyboard focus ring; tab/shift-tab
    // brings it back (desktop convention).
    arena.kb_focus = 0
    arena.mark_paint()
    if arena.root_id <= 0 {
        return 0
    }
    hit_bar = 0
    let mut id = hit_floaters(arena.root_id, px, py)
    if id <= 0 {
        hit_bar = 0
        id = hit_node(arena.root_id, px, py)
    }
    if id <= 0 {
        return 0
    }
    // A disabled / loading control swallows the click: nothing fires, no
    // press track starts, and the pointer does not fall through to what
    // sits under it.
    if arena.is_inert(id) != 0 {
        return 1
    }
    arena.press_target = id
    arena.claim_focus(id)
    if int(nodes.tree[id].kind) == 10 {
        let slot = arena.edit_ready(id)
        if slot >= 0 {
            let relx = px - nodes.box[id].x - i32(nodes.lay[id].pad_l) - i32(nodes.lay[id].border_w)
            let rely = py - nodes.box[id].y - i32(nodes.lay[id].pad_t) - i32(nodes.lay[id].border_w)
            let mut font = i32(nodes.look[id].font)
            if font < 8 {
                font = 14
            }
            runtime.edit_click(slot, relx, rely, arena.input_inner_w(id), font)
        }
    }
    if int(nodes.tree[id].kind) == 11 {
        if hit_bar == 2 {
            // Grab the thumb where it is: the drag moves it from its current
            // scroll, so the content never jumps under the pointer.
            arena.bar_track_press_x(id, px)
            arena.bar_on(id)
            arena.drag_id = id
            arena.drag_bar = 2
            arena.drag_ay = px
            arena.drag_as = nodes.scrl[id].scroll_x
            return 1
        }
        if hit_bar == 1 {
            // Grab the thumb where it is: the drag moves it from its current
            // scroll, so the content never jumps under the pointer.
            arena.bar_track_press_y(id, py)
            arena.bar_on(id)
            arena.drag_id = id
            arena.drag_bar = 1
            arena.drag_ay = py
            arena.drag_as = nodes.scrl[id].scroll_y
            return 1
        }
    }
    if int(nodes.tree[id].kind) == 13 {
        if nodes.ui[id].bind_sig > 0 {
            let kd = 14
            let travel = geometry.max2(nodes.box[id].w - kd, 1)
            let mut rel = px - nodes.box[id].x - kd / 2
            if rel < 0 {
                rel = 0
            }
            if rel > travel {
                rel = travel
            }
            let v = (rel * 100 + travel / 2) / travel
            let signal_id = nodes.ui[id].bind_sig
            arena.store_sig_paint(signal_id, v)
            arena.drag_id = id
            return 1
        }
    }
    // An `on_drag` region (a range slider's track) takes the press as the
    // first point of a drag; later points come through `drag`.
    let dr = arena.hook_owner(id, arena.HOOK_DRAG)
    if dr > 0 {
        arena.drag_id = dr
        arena.down_id = id
        arena.ev_x = px
        arena.ev_y = py
        arena.ev_button = 0
        arena.ev_drag_first = 1
        arena.invoke_handler(arena.hook_of(dr, arena.HOOK_DRAG), dr)
        arena.ev_drag_first = 0
        arena.mark_chrome()
        return 1
    }
    // Handlers read `current_mouse()` while they run. Set the point before
    // the click, not after, or a half-star (or any hit that cares where the
    // pointer landed) sees the previous event.
    arena.ev_x = px
    arena.ev_y = py
    arena.ev_button = 0
    let c1 = Click {
        signal_id: nodes.ui[id].click_sig,
        mode: int(nodes.ui[id].click_mode),
        setv: nodes.ui[id].click_set,
    }
    apply_click(c1)
    let c2 = Click {
        signal_id: nodes.ui[id].click2_sig,
        mode: int(nodes.ui[id].click2_mode),
        setv: nodes.ui[id].click2_set,
    }
    apply_click(c2)
    if nodes.ui[id].click_fn > 0 {
        arena.invoke_handler(nodes.ui[id].click_fn, id)
    }
    arena.down_id = id
    if nodes.ui[id].down_fn > 0 {
        arena.invoke_handler(nodes.ui[id].down_fn, id)
    }
    arena.mark_chrome()
    return 1
}

fn apply_click(c: Click) {
    if c.signal_id <= 0 {
        return
    }
    if c.signal_id >= arena.sigs.len {
        return
    }
    let mut next = arena.sigs[c.signal_id]
    if c.mode == 0 {
        next = next + 1
    } else if c.mode == 1 {
        if next == 0 {
            next = 1
        } else {
            next = 0
        }
    } else if c.mode == 2 {
        next = c.setv
    } else {
        next = next + c.setv
    }
    arena.store_sig(c.signal_id, next)
}

fn find_scroll_axis(id: int, px: int, py: int, horiz: int) -> int {
    if id <= 0 {
        return 0
    }
    if arena.want_show(id) == 0 {
        return 0
    }
    if arena.in_box(id, px, py) == 0 {
        return 0
    }
    let mut cy = py
    let mut cx = px
    if int(nodes.tree[id].kind) == 11 {
        cy = py + nodes.scrl[id].scroll_y
        cx = px + nodes.scrl[id].scroll_x
    }
    let nk = nodes.tree[id].kids.len
    for j in 0..nk {
        let c = nodes.tree[id].kids[nk - 1 - j]
        if hit_in_floater == 0 && nodes.is_floater(c) != 0 {
            continue
        }
        let s = find_scroll_axis(c, kid_px(c, cx), kid_py(c, cy), horiz)
        if s != 0 {
            return s
        }
    }
    if int(nodes.tree[id].kind) != 11 {
        return 0
    }
    if horiz != 0 {
        if nodes.scrolls_x(id) == 0 {
            return 0
        }
        if arena.scroll_max_x(id) > 0 {
            return id
        }
        return 0
    }
    if arena.scroll_max(id) > 0 {
        return id
    }
    return 0
}

/// The scroller a wheel at the pointer drives: one inside the topmost floater
/// under the pointer first (a long Select list over a scrolled page), else one
/// in the page. A capturing floater with no scroller of its own takes the
/// wheel and drives nothing, so the page under a popup does not slide.
fn scroll_target(px: int, py: int, horiz: int) -> int {
    arena.ptr_x = px
    arena.ptr_y = py
    arena.update_ptr_cover()
    scroll_stop = 0
    let f = arena.ptr_cover
    if f > 0 {
        let s = scroll_in_floater(f, arena.ptr_cover_sx, arena.ptr_cover_sy, px, py, horiz)
        if s > 0 || arena.floater_is_surface(f) != 0 {
            scroll_stop = f
            return s
        }
        // Page content in a higher layer, with nothing to scroll of its own. A
        // surface under it (an open Select's scrim) still holds the page.
        let under = arena.scroll_surface()
        if under > 0 {
            scroll_stop = under
            return scroll_in_floater(under, arena.surface_sx, arena.surface_sy, px, py, horiz)
        }
    }
    return find_scroll_axis(arena.root_id, px, py, horiz)
}

fn scroll_in_floater(f: int, sx: int, sy: int, px: int, py: int, horiz: int) -> int {
    let was = hit_in_floater
    hit_in_floater = 1
    let mut s = 0
    if nodes.is_window_floater(f) != 0 {
        s = find_scroll_axis(f, px, py, horiz)
    } else {
        s = find_scroll_axis(f, px + sx, py + sy, horiz)
    }
    hit_in_floater = was
    return s
}

/// Next overflowing scroller above `id` on the same axis (nested chaining).
/// The chain ends at the floater `scroll_target` resolved in (`scroll_stop`): a
/// list at its bound inside a Drawer or Dialog must not slide the page behind.
fn parent_scroll(id: int, horiz: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= nodes.tree.len {
        return 0
    }
    if id == scroll_stop {
        return 0
    }
    let mut p = nodes.tree[id].parent
    while p > 0 {
        if p >= nodes.tree.len {
            return 0
        }
        if int(nodes.tree[p].kind) == 11 {
            if horiz != 0 {
                if nodes.scrolls_x(p) != 0 {
                    if arena.scroll_max_x(p) > 0 {
                        return p
                    }
                }
            } else {
                if arena.scroll_max(p) > 0 {
                    return p
                }
            }
        }
        if p == scroll_stop {
            return 0
        }
        p = nodes.tree[p].parent
    }
    return 0
}

/// The scrollers a touch gesture holds, one per axis, 0 for none. Content slides
/// under a resting finger, so asking again each frame would hand the gesture to
/// whatever scroller passed beneath it.
let mut latch_y: int = 0
let mut latch_x: int = 0

/// Hold the scrollers under (`px`, `py`) for the gesture starting there. A
/// negative point lets go.
fn scroll_latch(px: int, py: int) {
    latch_y = 0
    latch_x = 0
    arena.ensure()
    if px < 0 || arena.root_id <= 0 {
        return
    }
    latch_y = scroll_target(px, py, 0)
    latch_x = scroll_target(px, py, 1)
}

/// The held scroller on an axis, or 0. A page swapped mid-gesture can leave the
/// id naming another kind of node, or none.
fn latched(horiz: int) -> int {
    let mut s = latch_y
    if horiz != 0 {
        s = latch_x
    }
    if s <= 0 || s >= nodes.tree.len {
        return 0
    }
    if int(nodes.tree[s].kind) != 11 {
        return 0
    }
    return s
}

/// Apply `delta` to the held scroller, or else the innermost overflowing one
/// under the pointer, then any leftover at a bound to each ancestor. Returns 1
/// if anything moved. `scroll_target` runs either way, because it settles the
/// floater that ends the chain.
fn chain_axis(px: int, py: int, delta: int, horiz: int, momentum: int) -> int {
    if delta == 0 {
        return 0
    }
    let mut s = scroll_target(px, py, horiz)
    let held = latched(horiz)
    if held > 0 {
        s = held
    }
    let mut rem = delta
    let mut changed = 0
    while s > 0 {
        if rem == 0 {
            return changed
        }
        let mut before = 0
        if horiz != 0 {
            before = nodes.scrl[s].scroll_x
            arena.apply_delta_x(s, rem, momentum)
            let used = nodes.scrl[s].scroll_x - before
            if used != 0 {
                changed = 1
                arena.bar_on(s)
            }
            rem = rem - used
        } else {
            before = nodes.scrl[s].scroll_y
            arena.apply_delta_y(s, rem, momentum)
            let used = nodes.scrl[s].scroll_y - before
            if used != 0 {
                changed = 1
                arena.bar_on(s)
            }
            rem = rem - used
        }
        if rem == 0 {
            return changed
        }
        s = parent_scroll(s, horiz)
    }
    return changed
}

/// Pan / precise-wheel scroll with momentum: the delta is applied now and
/// becomes the velocity the physics coast decays from (touch, trackpads).
fn scroll(px: int, py: int, dx: int, dy: int) -> int {
    arena.ensure()
    if arena.root_id <= 0 {
        return 0
    }
    arena.pan_held = 1
    let mut changed = 0
    if dy != 0 {
        if chain_axis(px, py, dy, 0, 1) != 0 {
            changed = 1
        }
    }
    if dx != 0 {
        if chain_axis(px, py, dx, 1, 1) != 0 {
            changed = 1
        }
    }
    return changed
}

/// Mouse-wheel notch with the browser feel: the delta moves a target and the
/// position eases to it (`physics_step`), retargeting on the next notch, which
/// reaches further for coming while the last is landing. Chains to the parent scroller when this one is at its edge.
/// Under reduced motion it is a plain step.
fn scroll_smooth(px: int, py: int, dx: int, dy: int) -> int {
    arena.ensure()
    if arena.root_id <= 0 {
        return 0
    }
    if arena.anim_reduced() != 0 {
        return scroll_step(px, py, dx, dy)
    }
    let mut changed = 0
    if dy != 0 {
        let mut s = scroll_target(px, py, 0)
        let mut rem = dy
        if s > 0 {
            rem = arena.wheel_notch(
                int(nodes.scrl[s].smooth) & 1,
                nodes.scrl[s].scroll_y,
                nodes.scrl[s].tgt_y,
                dy,
            )
        }
        while s > 0 && rem != 0 {
            let used = arena.apply_smooth_y(s, rem)
            if used != 0 {
                changed = 1
            }
            rem = rem - used
            s = parent_scroll(s, 0)
        }
    }
    if dx != 0 {
        let mut s = scroll_target(px, py, 1)
        let mut rem = dx
        if s > 0 {
            rem = arena.wheel_notch(
                int(nodes.scrl[s].smooth) & 2,
                nodes.scrl[s].scroll_x,
                nodes.scrl[s].tgt_x,
                dx,
            )
        }
        while s > 0 && rem != 0 {
            let used = arena.apply_smooth_x(s, rem)
            if used != 0 {
                changed = 1
            }
            rem = rem - used
            s = parent_scroll(s, 1)
        }
    }
    return changed
}

/// Discrete wheel click (mouse notches, web line/page wheels): the delta is
/// applied exactly and no velocity is stored, so the scroller never coasts
/// past where the user clicked.
fn scroll_step(px: int, py: int, dx: int, dy: int) -> int {
    arena.ensure()
    if arena.root_id <= 0 {
        return 0
    }
    let mut changed = 0
    if dy != 0 {
        if chain_axis(px, py, dy, 0, 0) != 0 {
            changed = 1
        }
    }
    if dx != 0 {
        if chain_axis(px, py, dx, 1, 0) != 0 {
            changed = 1
        }
    }
    return changed
}

fn drag(px: int, py: int) -> int {
    arena.ensure()
    if arena.drag_id <= 0 {
        return 0
    }
    if arena.drag_id >= nodes.tree.len {
        arena.drag_id = 0
        arena.drag_bar = 0
        return 0
    }
    let df = arena.hook_of(arena.drag_id, arena.HOOK_DRAG)
    if df > 0 {
        arena.ev_x = px
        arena.ev_y = py
        arena.invoke_handler(df, arena.drag_id)
        arena.mark_chrome()
        return 1
    }
    let kind = int(nodes.tree[arena.drag_id].kind)
    if kind == 13 {
        let kd = 14
        let travel = geometry.max2(nodes.box[arena.drag_id].w - kd, 1)
        let mut rel = px - nodes.box[arena.drag_id].x - kd / 2
        if rel < 0 {
            rel = 0
        }
        if rel > travel {
            rel = travel
        }
        let v = (rel * 100 + travel / 2) / travel
        let signal_id = nodes.ui[arena.drag_id].bind_sig
        arena.store_sig_paint(signal_id, v)
        return 1
    }
    if kind != 11 {
        // The dragged node was recycled into another kind by a tree rebuild
        // (shape changed mid-drag): cancel the drag.
        arena.drag_id = 0
        arena.drag_bar = 0
        return 0
    }
    if arena.drag_bar == 2 {
        let maxs = arena.scroll_max_x(arena.drag_id)
        let text_width = arena.bar_track_w(arena.drag_id)
        let thw = arena.bar_thumb_w(arena.drag_id)
        let range = geometry.max2(text_width - thw, 1)
        let mut nx = arena.drag_as + (px - arena.drag_ay) * maxs / range
        if nx < 0 {
            nx = 0
        }
        if nx > maxs {
            nx = maxs
        }
        nodes.scrl[arena.drag_id].scroll_x = nx
        arena.bar_on(arena.drag_id)
        arena.mark_scroll_node(arena.drag_id)
        return 1
    }
    let maxs = arena.scroll_max(arena.drag_id)
    let text_height = arena.bar_track_h(arena.drag_id)
    let thh = arena.bar_thumb_h(arena.drag_id)
    let range = geometry.max2(text_height - thh, 1)
    let mut ny = arena.drag_as + (py - arena.drag_ay) * maxs / range
    if ny < 0 {
        ny = 0
    }
    if ny > maxs {
        ny = maxs
    }
    nodes.scrl[arena.drag_id].scroll_y = ny
    arena.bar_on(arena.drag_id)
    arena.mark_scroll_node(arena.drag_id)
    return 1
}

fn mouseup() {
    if arena.pan_held != 0 {
        arena.pan_release()
    }
    // A released thumb lingers and fades like any scroll, instead of
    // vanishing the moment the pointer lets go.
    if arena.drag_bar != 0 && arena.drag_id > 0 {
        let held = arena.drag_id
        arena.drag_id = 0
        arena.drag_bar = 0
        arena.bar_on(held)
    }
    arena.drag_id = 0
    arena.drag_bar = 0
    let id = arena.down_id
    arena.down_id = 0
    arena.mark_chrome()
    if id <= 0 {
        return
    }
    if id >= nodes.tree.len {
        return
    }
    if nodes.ui[id].up_fn > 0 {
        arena.ev_button = 0
        arena.invoke_handler(nodes.ui[id].up_fn, id)
    }
}

/// Deliver a key to the focused node's `on_key_down` / `on_key_press`
/// handlers. Returns 1 if a handler ran, so the host repaints.
/** Keyboard activation of the focused control (Enter / Space): the same
 *  click dispatch a pointer press runs, minus hit-testing and pointer-only
 *  handlers. Returns 1 when the control consumed the key. Text fields never
 *  reach here (their own editing handles the keys). */
fn press_focused() -> int {
    let id = arena.focus_id
    if id <= 0 {
        return 0
    }
    if id >= nodes.tree.len {
        return 0
    }
    if arena.want_show(id) == 0 {
        return 0
    }
    if arena.is_inert(id) != 0 {
        return 1
    }
    if int(nodes.tree[id].kind) == 10 {
        return 0
    }
    let mut ran = 0
    let c1 = Click {
        signal_id: nodes.ui[id].click_sig,
        mode: int(nodes.ui[id].click_mode),
        setv: nodes.ui[id].click_set,
    }
    if c1.signal_id > 0 {
        apply_click(c1)
        ran = 1
    }
    let c2 = Click {
        signal_id: nodes.ui[id].click2_sig,
        mode: int(nodes.ui[id].click2_mode),
        setv: nodes.ui[id].click2_set,
    }
    if c2.signal_id > 0 {
        apply_click(c2)
        ran = 1
    }
    if nodes.ui[id].click_fn > 0 {
        arena.invoke_handler(nodes.ui[id].click_fn, id)
        ran = 1
    }
    return ran
}

fn key_handlers(k: int, mods: int, up: int) -> int {
    let id = arena.focus_id
    if id <= 0 {
        return 0
    }
    if id >= nodes.tree.len {
        return 0
    }
    arena.ev_key = k
    arena.ev_mods = mods
    let mut ran = 0
    if up != 0 {
        if nodes.ui[id].kup_fn > 0 {
            arena.invoke_handler(nodes.ui[id].kup_fn, id)
            ran = 1
        }
        if nodes.ui[id].kpress_fn > 0 {
            arena.invoke_handler(nodes.ui[id].kpress_fn, id)
            ran = 1
        }
        return ran
    }
    if nodes.ui[id].kdown_fn > 0 {
        arena.invoke_handler(nodes.ui[id].kdown_fn, id)
        ran = 1
    }
    return ran
}

/// The scroller keys drive: the one under the pointer, or the first in the
/// tree that has anywhere to go (a phone or a keyboard user has no pointer).
fn key_scroller() -> int {
    let s = scroll_target(arena.ptr_x, arena.ptr_y, 0)
    if s > 0 {
        return s
    }
    let n = nodes.tree.len
    for i in 1..n {
        if int(nodes.tree[i].kind) == 11 && arena.shown_in_tree(i) != 0 {
            if arena.scroll_max(i) > 0 {
                return i
            }
        }
    }
    return 0
}

/// The keys that move a page: PageUp / PageDown and Space (Shift+Space back) by
/// most of a screen, Home / End to the ends, the arrows by a few lines. Unclaimed
/// keys only: a focused control keeps what it uses, and the arrows need no focus.
fn key_scroll(k: int) -> int {
    let page = k == KEY_PAGE_UP || k == KEY_PAGE_DOWN || k == KEY_SPACE
    let end = k == KEY_HOME || k == KEY_END
    let arrow = (k == KEY_UP || k == KEY_DOWN) && arena.focus_id == 0
    if !page && !end && !arrow {
        return 0
    }
    let s = key_scroller()
    if s <= 0 {
        return 0
    }
    let shift = arena.ev_mods % 2 == 1
    let up = k == KEY_PAGE_UP || k == KEY_HOME || k == KEY_UP || (k == KEY_SPACE && shift)
    let mut d = KEY_LINE
    if page {
        d = nodes.box[s].h * 9 / 10
    }
    if end {
        d = arena.scroll_max(s)
    }
    if up {
        d = 0 - d
    }
    if arena.anim_reduced() != 0 {
        return arena.apply_delta_y(s, d, 0)
    }
    return if arena.apply_smooth_y(s, d) != 0 { 1 } else { 0 }
}

/// The innermost scroller from `s` up whose live bar strip is under the
/// pointer, on either axis (0 = none). Walking up is what lets the page's bar
/// answer while the pointer sits over a nested table that is not scrolling.
fn bar_strip_chain(s: int, px: int, py: int) -> int {
    let mut c = s
    let mut guard = 0
    while c > 0 && c < nodes.tree.len && guard < 64 {
        if int(nodes.tree[c].kind) == 11 {
            if arena.bar_strip_at(c, px, py) != 0 {
                return c
            }
        }
        c = nodes.tree[c].parent
        guard = guard + 1
    }
    return 0
}

/// The pointer is on a shown scrollbar's edge strip: make that bar hot (wider
/// thumb, visible track, no fade while it stays there). Desktop only. A bar
/// that is yielding to its chain's lead is never made hot.
fn bar_hover(px: int, py: int) {
    if platform.plat_overlay_scroll() != 0 {
        return
    }
    let mut hot = bar_strip_chain(scroll_target(px, py, 0), px, py)
    if hot == 0 {
        hot = bar_strip_chain(scroll_target(px, py, 1), px, py)
    }
    // A drag keeps the bar it holds.
    if arena.drag_bar != 0 {
        return
    }
    arena.bar_set_hot(hot)
}

fn hover(px: int, py: int) -> int {
    arena.ensure()
    arena.ptr_x = px
    arena.ptr_y = py
    if arena.root_id <= 0 {
        return 0
    }
    // One pointer model for every hover consumer: `ptr_in` maps through the
    // scroll offsets, honours clips, and is occluded by the topmost capturing
    // floater (`ptr_cover`). A hover signal is 1 while the pointer is over any
    // node bound to it, so a single pass over the nodes settles all of them.
    arena.update_ptr_cover()
    bar_hover(px, py)
    let mut sids = []int {}
    let mut overs = []int {}
    let mut changed = []int {}
    let mut dirty = 0
    let n = nodes.tree.len
    for i in 1..n {
        let signal_id = nodes.ui[i].hover_sig
        let hot = arena.is_hot(i)
        if signal_id <= 0 && hot == 0 {
            continue
        }
        let over = arena.ptr_in(i)
        if signal_id > 0 {
            let mut at = -1
            for k in 0..sids.len {
                if sids[k] == signal_id {
                    at = k
                }
            }
            if at < 0 {
                push(sids, signal_id)
                push(overs, over)
            } else if over != 0 {
                overs[at] = 1
            }
        }
        if hot != 0 {
            // A node whose wash is off target, or still easing toward some
            // target (which may be the one the pointer just left), re-syncs.
            let a = int(nodes.anim[i].hover_amt)
            if (over != 0 && a < 100) || (over == 0 && a > 0) || arena.hover_easing(i) != 0 {
                push(changed, i)
                dirty = 1
            }
        }
    }
    for k in 0..sids.len {
        if arena.sig_val(sids[k]) != overs[k] {
            arena.store_sig(sids[k], overs[k])
            dirty = 1
        }
    }
    // Retarget just the nodes whose hover changed: a pointer move moves no
    // box, so nothing else in the interaction-state pass can have changed.
    for k in 0..changed.len {
        arena.mark_chrome_id(changed[k])
    }
    return dirty
}

/// Pointer affordance: the host shows a hand cursor while the pointer is
/// inside an interactive node. This is decoupled from the hover wash
/// (`is_hot`, which `Box.hover_off` now silences by default): clickable
/// boxes and native thumbs claim the hand, while full-surface click
/// swallows (dialogs, picker panels) keep the arrow.
fn over_button() -> int {
    let n = nodes.tree.len
    for i in 1..n {
        if arena.want_show(i) == 0 {
            continue
        }
        if arena.ptr_in(i) == 0 {
            continue
        }
        let k = int(nodes.tree[i].kind)
        if k == 9 {
            continue
        }
        if k == 11 {
            continue
        }
        // Native thumbs: buttons, progress/toggle/check/slider.
        if k == 4 || k == 7 || k == 8 || k == 13 {
            return 1
        }
        // Explicit hover opt-in (Boxes with hover_off = false still wash).
        if int(nodes.anim[i].hover_fade) > 0 {
            return 1
        }
        // Click swallows that cover a whole surface act like the page,
        // not a control — no hand cursor over a dialog body.
        if nodes.ui[i].a11y_role == "dialog" {
            continue
        }
        if nodes.ui[i].click_sig > 0 || nodes.ui[i].click_fn > 0 {
            return 1
        }
    }
    return 0
}

/// CSS cursor name for the node under the pointer. Nodes with an explicit
/// cursor ("" = default) win; later-created nodes outrank earlier ones, so
/// children override parents. Returns "" when nothing claims a cursor.
fn cursor_at() -> string {
    if platform.plat_overlay_scroll() != 0 {
        return ""
    }
    let n = nodes.tree.len
    for i in 1..n {
        let id = n - i
        if arena.want_show(id) == 0 {
            continue
        }
        if arena.ptr_in(id) == 0 {
            continue
        }
        let k = int(nodes.tree[id].kind)
        if k == 9 {
            continue
        }
        if k == 11 {
            continue
        }
        if nodes.look[id].cursor.len > 0 {
            return nodes.look[id].cursor
        }
    }
    return ""
}

/// Move the caret one extended grapheme cluster. `dir` < 0 = left, > 0 =
/// right. Boundaries come from `std:unicode`, so a Tamil akshara or an emoji
/// ZWJ sequence moves as one unit instead of one code point (`docs/loam_zeus_v2.md`
/// §1.4, Phase 13).
fn edit_move_grapheme(slot: int, dir: int, extend: int) -> int {
    let text = runtime.edit_text(slot)
    let caret = runtime.edit_caret(slot)
    let mut pos = caret
    if dir < 0 {
        pos = unicode.prev_grapheme(text, caret)
    } else {
        pos = unicode.next_grapheme(text, caret)
    }
    runtime.edit_set_caret(slot, pos)
    if extend == 0 {
        runtime.edit_set_anchor(slot, pos)
    }
    return 1
}

/// Backspace one grapheme cluster, or the current selection.
fn edit_back_grapheme(slot: int) -> int {
    let caret = runtime.edit_caret(slot)
    if runtime.edit_anchor(slot) != caret {
        return runtime.edit_back(slot)
    }
    if caret <= 0 {
        return 0
    }
    let text = runtime.edit_text(slot)
    runtime.edit_set_anchor(slot, unicode.prev_grapheme(text, caret))
    return runtime.edit_back(slot)
}

/// Delete forward one grapheme cluster, or the current selection.
fn edit_del_grapheme(slot: int) -> int {
    let caret = runtime.edit_caret(slot)
    if runtime.edit_anchor(slot) != caret {
        return runtime.edit_del(slot)
    }
    let text = runtime.edit_text(slot)
    if caret >= text.len {
        return 0
    }
    runtime.edit_set_anchor(slot, unicode.next_grapheme(text, caret))
    return runtime.edit_del(slot)
}

fn key(k: int) -> int {
    // A key is not the press a roving pick may follow (`claim_roving_focus`).
    arena.press_target = 0
    let handled = key_handlers(k, arena.ev_mods, 0)
    if k == 27 {
        let mut changed = 0
        if arena.focus_id != 0 {
            arena.focus_id = 0
            arena.kb_focus = 0
            changed = 1
            arena.mark_paint()
        }
        let n = nodes.tree.len
        for i in 1..n {
            if int(nodes.tree[i].kind) == 9 {
                let signal_id = nodes.tree[i].show_sig
                if signal_id > 0 {
                    if arena.want_show(i) != 0 {
                        // An overlay with a click handler dismisses itself
                        // (the component's own state, e.g. a `Signal<bool>`);
                        // a bare one is hidden through its show signal.
                        if nodes.ui[i].click_fn > 0 {
                            arena.invoke_handler(nodes.ui[i].click_fn, i)
                        } else {
                            arena.store_sig(signal_id, 0)
                        }
                        changed = 1
                    }
                }
            }
        }
        return changed
    }
    // Tab: a mapped chord wins; otherwise single-line fields and non-input
    // controls move focus (shift = back). Multiline fields insert a tab and
    // fall through to the editing path below.
    if k == 9 {
        if handled != 0 {
            return 1
        }
        let mut insert = 0
        if arena.focus_captures_text() != 0 {
            let focus_node_id = arena.focus_id
            if focus_node_id > 0 {
                if focus_node_id < nodes.tree.len {
                    if int(nodes.tree[focus_node_id].kind) == 10 {
                        if int(nodes.lay[focus_node_id].wrap) != 0 {
                            insert = 1
                        }
                    }
                }
            }
        }
        if insert == 0 {
            return arena.focus_step(arena.ev_mods % 2)
        }
    } else {
        // Enter / Space activate the focused control when no keymap chord
        // consumed the key. Text fields handle their own keys below.
        if handled == 0 {
            if k == 13 || k == 32 {
                if arena.focus_captures_text() == 0 {
                    if press_focused() != 0 {
                        return 1
                    }
                }
            }
        }
    }
    if arena.focus_captures_text() == 0 {
        if handled != 0 {
            return handled
        }
        return key_scroll(k)
    }
    let id = arena.focus_id
    if id <= 0 {
        return 0
    }
    if int(nodes.tree[id].kind) != 10 {
        // A `capture_text` box edits in its own key handler.
        return handled
    }
    let slot = arena.edit_ready(id)
    if slot < 0 {
        return handled
    }
    // Cmd/Ctrl/Alt chords must not insert the letter. Cmd/Ctrl+A selects all
    // so the next Backspace clears the field (Input / TextArea / Combobox).
    let mods = arena.ev_mods
    let mut chord = 0
    if mods % 4 >= 2 {
        chord = 1
    }
    if mods % 8 >= 4 {
        chord = 1
    }
    if mods % 16 >= 8 {
        chord = 1
    }
    if chord != 0 {
        if k == 97 {
            let n = runtime.edit_len(slot)
            runtime.edit_set_anchor(slot, 0)
            runtime.edit_set_caret(slot, n)
            arena.mark_paint()
            return 1
        }
        return handled
    }
    let extend = arena.ev_mods % 2
    let mut edited = 0
    if k == 8 {
        edited = edit_back_grapheme(slot)
    } else if k == 127 {
        edited = edit_del_grapheme(slot)
    } else if k == 9 {
        edited = runtime.edit_append(slot, 9)
    } else if k == 10 {
        if int(nodes.lay[id].wrap) != 0 {
            edited = runtime.edit_append(slot, 10)
        }
    } else if k == 13 {
        if int(nodes.lay[id].wrap) != 0 {
            edited = runtime.edit_append(slot, 10)
        }
    } else if k == 1000 {
        edited = edit_move_grapheme(slot, -1, extend)
    } else if k == 1001 {
        edited = edit_move_grapheme(slot, 1, extend)
    } else if k == 1002 {
        edited = runtime.edit_move(slot, -3, extend)
    } else if k == 1003 {
        edited = runtime.edit_move(slot, 3, extend)
    } else if k == 1006 {
        edited = runtime.edit_move(slot, -2, extend)
    } else if k == 1007 {
        edited = runtime.edit_move(slot, 2, extend)
    } else if k >= 32 {
        if k < 127 {
            edited = runtime.edit_append(slot, k)
        }
    }
    if edited != 0 {
        /* `Input(bind = sig)` writes the edit buffer back on each edit; the
           signal store notifies only on a real change. Nav keys do not write. */
        let mut write = 1
        if k >= 1000 {
            if k <= 1007 {
                write = 0
            }
        }
        if write != 0 {
            if nodes.ui[id].bind_fn > 0 {
                arena.invoke_handler(nodes.ui[id].bind_fn, id)
            }
        }
        return 1
    }
    return handled
}

fn insert_text(s: string) -> int {
    arena.ensure()
    if arena.focus_captures_text() == 0 {
        return 0
    }
    let id = arena.focus_id
    // A box with `capture_text` that is not an input (a code editor) owns its
    // buffer: the text reaches its key handler as one KEY_TEXT (2000) event.
    if id > 0 && id < nodes.tree.len && int(nodes.tree[id].kind) != 10 {
        if nodes.ui[id].kdown_fn <= 0 || s.len == 0 {
            return 0
        }
        arena.ev_text = s
        arena.ev_key = 2000
        arena.ev_mods = 0
        arena.invoke_handler(nodes.ui[id].kdown_fn, id)
        arena.ev_text = ""
        arena.mark_paint()
        return 1
    }
    let slot = arena.edit_ready(id)
    if slot < 0 {
        return 0
    }
    if runtime.edit_insert(slot, s) == 0 {
        return 0
    }
    if nodes.ui[id].bind_fn > 0 {
        arena.invoke_handler(nodes.ui[id].bind_fn, id)
    }
    // Mac/iOS type through insertText, not key_ev. Combobox opens on its
    // kdown handler, so replay a printable key after the insert.
    if nodes.ui[id].kdown_fn > 0 {
        let mut k = 32
        if s.len > 0 {
            k = s[0]
        }
        arena.ev_key = k
        arena.invoke_handler(nodes.ui[id].kdown_fn, id)
    }
    return 1
}

fn mark_text(s: string) -> int {
    arena.ensure()
    if arena.focus_captures_text() == 0 {
        return 0
    }
    let id = arena.focus_id
    let slot = arena.edit_ready(id)
    if slot < 0 {
        return 0
    }
    return runtime.edit_mark(slot, s)
}
