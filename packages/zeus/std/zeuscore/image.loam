//! image — the image pipeline: decode on demand, downsample with a real filter,
//! and cache the result under a fixed byte budget.
//!
//! Two things this module is careful about, because they are where image
//! handling usually goes wrong on memory and on quality:
//!
//!   * **A thumbnail never keeps a full-resolution decode.** The source pixels
//!     live in ONE reusable scratch buffer (bounded by the largest image seen,
//!     not by the sum of them all) and die as soon as the resized result is
//!     cached. What the cache holds is always the size that will be drawn.
//!   * **The cache is a fixed budget, not a map that grows.** Entries are
//!     LRU-evicted to stay under `IMG_BUDGET_BYTES`, and a single image larger
//!     than the whole budget is refused loudly and counted rather than stored.
//!
//! Decoding is PNG, in Loam, with no graphics or image API: signature, chunk
//! CRCs, IHDR validation, IDAT assembly, the zlib wrapper (Adler-32 checked),
//! all five scanline filters, and premultiplied RGBA8 output. The DEFLATE
//! decoder covers **stored blocks**, which is what makes the container, the
//! filters and the buffers testable against spec-valid fixtures; Huffman-coded
//! DEFLATE is refused explicitly (`btype != 0`) rather than decoded wrongly, and
//! is the remaining decoder work.
//!
//! Resampling is separable Mitchell (B = C = 1/3), with the kernel scaled by the
//! downscale factor so the support widens with the reduction — that is what
//! makes a large downscale area-correct instead of aliased.

import "raster.loam"

/// Decoded source pixels: RGBA8, PREMULTIPLIED. Premultiplied is what keeps a
/// filtered transparent edge from bleeding its colour into the result (and it
/// matches the framebuffer's own premultiplied rule).
let mut png_px: []u8 = []u8 {}
let mut png_w: int = 0
let mut png_h: int = 0

/// Reusable scratch: the assembled IDAT stream and the unfiltered scanlines.
let mut png_idat: []u8 = []u8 {}
let mut png_raw: []u8 = []u8 {}
/// File offset just past the last IDAT payload, i.e. where its Adler-32 is not.
let mut png_adler_at: int = 0

let mut png_decodes: int = 0
let mut png_failures: int = 0
let mut png_why: string = ""

let mut crc_tab: []i64 = []i64 {}
let mut crc_ready: int = 0

// --- small readers ---------------------------------------------------------

fn png_u16(s: string, o: int) -> int {
    return s[o] * 256 + s[o + 1]
}

/// A 4-byte big-endian field, refused (as -1) rather than truncated when it
/// cannot fit an `int`. A malformed file must fail cleanly, never trap.
fn png_u32(s: string, o: int) -> int {
    if s[o] != 0 {
        return -1
    }
    return s[o + 1] * 65536 + s[o + 2] * 256 + s[o + 3]
}

/// A 4-byte big-endian field as i64 (CRCs and Adler-32 are full 32-bit).
fn png_u32_64(s: string, o: int) -> i64 {
    let mut v: i64 = i64(s[o]) * 16777216
    v = v + i64(s[o + 1]) * 65536
    v = v + i64(s[o + 2]) * 256
    v = v + i64(s[o + 3])
    return v
}

fn png_is_tag(s: string, o: int, a: int, b: int, c: int, d: int) -> int {
    if s[o] != a {
        return 0
    }
    if s[o + 1] != b {
        return 0
    }
    if s[o + 2] != c {
        return 0
    }
    if s[o + 3] != d {
        return 0
    }
    return 1
}

// --- CRC-32 and Adler-32 ---------------------------------------------------

/// Standard CRC-32 table, built once. Held as i64: the values are 32-bit and
/// every width in Loam traps on overflow.
fn png_crc_build() {
    if crc_ready != 0 {
        return
    }
    crc_ready = 1
    let mut n = 0
    while n < 256 {
        let mut c: i64 = i64(n)
        let mut k = 0
        while k < 8 {
            if c % 2 != 0 {
                c = i64(3988292384) ^ (c / 2)
            } else {
                c = c / 2
            }
            k = k + 1
        }
        push(crc_tab, c)
        n = n + 1
    }
}

fn png_crc_update(c: i64, b: int) -> i64 {
    let x = c ^ i64(b)
    return crc_tab[int(x % 256)] ^ (x / 256)
}

/// CRC-32 over a chunk's type and data.
fn png_chunk_crc(s: string, off: int, len: int) -> i64 {
    png_crc_build()
    let mut c: i64 = 4294967295
    let mut i = 0
    while i < 4 {
        c = png_crc_update(c, s[off + 4 + i])
        i = i + 1
    }
    i = 0
    while i < len {
        c = png_crc_update(c, s[off + 8 + i])
        i = i + 1
    }
    return 4294967295 - c
}

/// Adler-32 over the inflated bytes, compared with the 4 bytes at `o`. The
/// stored value is (sum2 << 16) | sum1, big-endian.
fn png_adler_ok(s: string, o: int, n: int) -> int {
    let mut sum1 = 1
    let mut sum2 = 0
    let mut i = 0
    while i < n {
        sum1 = (sum1 + int(png_raw[i])) % 65521
        sum2 = (sum2 + sum1) % 65521
        i = i + 1
    }
    if i64(sum2) * 65536 + i64(sum1) == png_u32_64(s, o) {
        return 1
    }
    return 0
}

// --- DEFLATE (stored blocks) -----------------------------------------------

/// Inflate a zlib stream made of stored blocks into `png_raw`. Returns the
/// inflated length, or -1 when the stream is not stored-block DEFLATE.
fn png_inflate() -> int {
    let n = png_idat.len
    if n < 6 {
        return -1
    }
    // CMF/FLG: deflate, 32K window, no preset dictionary, check bits valid.
    if int(png_idat[0]) != 120 {
        return -1
    }
    if (int(png_idat[0]) * 256 + int(png_idat[1])) % 31 != 0 {
        return -1
    }
    while png_raw.len > 0 {
        pop(png_raw)
    }
    let mut o = 2
    let mut final = 0
    while final == 0 {
        if o + 5 > n {
            return -1
        }
        let hdr = int(png_idat[o])
        final = hdr % 2
        let btype = (hdr / 2) % 4
        if btype != 0 {
            // Fixed/dynamic Huffman: refused, explicitly, not misdecoded.
            return -1
        }
        let len = int(png_idat[o + 1]) + int(png_idat[o + 2]) * 256
        let nlen = int(png_idat[o + 3]) + int(png_idat[o + 4]) * 256
        if len + nlen != 65535 {
            return -1
        }
        o = o + 5
        if o + len > n {
            return -1
        }
        let mut i = 0
        while i < len {
            push(png_raw, png_idat[o + i])
            i = i + 1
        }
        o = o + len
    }
    return png_raw.len
}

// --- filters ---------------------------------------------------------------

fn png_abs_i(v: int) -> int {
    if v < 0 {
        return 0 - v
    }
    return v
}

fn png_paeth(a: int, b: int, c: int) -> int {
    let p = a + b - c
    let pa = png_abs_i(p - a)
    let pb = png_abs_i(p - b)
    let pc = png_abs_i(p - c)
    if pa <= pb {
        if pa <= pc {
            return a
        }
    }
    if pb <= pc {
        return b
    }
    return c
}

/// Reverse the PNG scanline filters IN PLACE. The left and up neighbours are
/// already reconstructed when they are read, which is what makes in-place
/// correct.
fn png_unfilter(w: int, h: int, bpp: int) -> int {
    let stride = w * bpp
    let mut y = 0
    while y < h {
        let base = y * (stride + 1)
        let ft = int(png_raw[base])
        let mut k = 0
        while k < stride {
            let i = base + 1 + k
            let mut l = 0
            if k >= bpp {
                l = int(png_raw[i - bpp])
            }
            let mut u = 0
            if y > 0 {
                // The row above starts one filter byte earlier, so its byte `k`
                // is at i - (stride + 1), not i - stride.
                u = int(png_raw[i - stride - 1])
            }
            let mut ul = 0
            if y > 0 {
                if k >= bpp {
                    ul = int(png_raw[i - stride - 1 - bpp])
                }
            }
            let mut f = 0
            if ft == 1 {
                f = l
            } else if ft == 2 {
                f = u
            } else if ft == 3 {
                f = (l + u) / 2
            } else if ft == 4 {
                f = png_paeth(l, u, ul)
            } else if ft != 0 {
                return -1
            }
            png_raw[i] = u8((int(png_raw[i]) + f) % 256)
            k = k + 1
        }
        y = y + 1
    }
    return 1
}

// --- decode ----------------------------------------------------------------

/// Decode a PNG into `png_px` (RGBA8, premultiplied). Returns 1 on success; on
/// failure `png_why` says why and the counters record it. Supported: 8-bit
/// RGB/RGBA, non-interlaced, stored-block DEFLATE. Everything else is refused.
fn png_decode(src: string) -> int {
    png_w = 0
    png_h = 0
    png_why = ""
    while png_px.len > 0 {
        pop(png_px)
    }
    if src.len < 8 {
        png_why = "too short"
        png_failures = png_failures + 1
        return 0
    }
    if src[0] != 137 || src[1] != 80 || src[2] != 78 || src[3] != 71 {
        png_why = "bad signature"
        png_failures = png_failures + 1
        return 0
    }
    // The rest of the signature is not decoration: it tells us where the first
    // chunk starts.
    if src[4] != 13 || src[5] != 10 || src[6] != 26 || src[7] != 10 {
        png_why = "bad signature"
        png_failures = png_failures + 1
        return 0
    }
    let mut w = 0
    let mut h = 0
    let mut bpp = 0
    let mut have_ihdr = 0
    while png_idat.len > 0 {
        pop(png_idat)
    }
    png_adler_at = 0
    let mut off = 8
    let mut done = 0
    while done == 0 {
        if off + 12 > src.len {
            png_why = "truncated chunk header"
            png_failures = png_failures + 1
            return 0
        }
        let len = png_u32(src, off)
        if len < 0 {
            png_why = "oversized chunk"
            png_failures = png_failures + 1
            return 0
        }
        if off + 12 + len > src.len {
            png_why = "truncated chunk"
            png_failures = png_failures + 1
            return 0
        }
        if png_chunk_crc(src, off, len) != png_u32_64(src, off + 8 + len) {
            png_why = "bad chunk CRC"
            png_failures = png_failures + 1
            return 0
        }
        if png_is_tag(src, off + 4, 73, 72, 68, 82) == 1 {
            if len < 13 {
                png_why = "short IHDR"
                png_failures = png_failures + 1
                return 0
            }
            w = png_u32(src, off + 8)
            h = png_u32(src, off + 12)
            if w < 0 || h < 0 {
                png_why = "oversized dimensions"
                png_failures = png_failures + 1
                return 0
            }
            let depth = int(src[off + 16])
            let ct = int(src[off + 17])
            let comp = int(src[off + 18])
            let filt = int(src[off + 19])
            let inter = int(src[off + 20])
            if depth != 8 || comp != 0 || filt != 0 || inter != 0 {
                png_why = "unsupported IHDR"
                png_failures = png_failures + 1
                return 0
            }
            if ct == 2 {
                bpp = 3
            } else if ct == 6 {
                bpp = 4
            } else {
                png_why = "unsupported colour type"
                png_failures = png_failures + 1
                return 0
            }
            if w <= 0 || h <= 0 {
                png_why = "empty image"
                png_failures = png_failures + 1
                return 0
            }
            have_ihdr = 1
        } else if png_is_tag(src, off + 4, 73, 68, 65, 84) == 1 {
            if have_ihdr == 0 {
                png_why = "IDAT before IHDR"
                png_failures = png_failures + 1
                return 0
            }
            let mut i = 0
            while i < len {
                push(png_idat, u8(src[off + 8 + i]))
                i = i + 1
            }
            // The Adler-32 trails the LAST IDAT payload in the file.
            png_adler_at = off + 8 + len
        } else if png_is_tag(src, off + 4, 73, 69, 78, 68) == 1 {
            done = 1
        } else if png_is_tag(src, off + 4, 80, 76, 84, 69) == 1 {
            png_why = "palette image"
            png_failures = png_failures + 1
            return 0
        }
        off = off + 12 + len
    }
    if have_ihdr == 0 {
        png_why = "no IHDR"
        png_failures = png_failures + 1
        return 0
    }
    let stride = w * bpp
    let n = png_inflate()
    if n < 0 {
        png_why = "not stored-block DEFLATE"
        png_failures = png_failures + 1
        return 0
    }
    if n != h * (stride + 1) {
        png_why = "wrong inflated length"
        png_failures = png_failures + 1
        return 0
    }
    if png_adler_ok(src, png_adler_at - 4, n) != 1 {
        png_why = "bad Adler-32"
        png_failures = png_failures + 1
        return 0
    }
    if png_unfilter(w, h, bpp) != 1 {
        png_why = "bad filter type"
        png_failures = png_failures + 1
        return 0
    }
    // Unfiltered scanlines -> premultiplied RGBA8.
    let mut y = 0
    while y < h {
        let base = y * (stride + 1) + 1
        let mut x = 0
        while x < w {
            let p = base + x * bpp
            let r = int(png_raw[p])
            let g = int(png_raw[p + 1])
            let b = int(png_raw[p + 2])
            let mut a = 255
            if bpp == 4 {
                a = int(png_raw[p + 3])
            }
            push(png_px, u8((r * a + 127) / 255))
            push(png_px, u8((g * a + 127) / 255))
            push(png_px, u8((b * a + 127) / 255))
            push(png_px, u8(a))
            x = x + 1
        }
        y = y + 1
    }
    png_w = w
    png_h = h
    png_decodes = png_decodes + 1
    return 1
}

// --- decoded-source accessors ----------------------------------------------

fn png_width() -> int {
    return png_w
}

fn png_height() -> int {
    return png_h
}

/// Bytes currently in use by the decode scratch (source pixels + scanlines +
/// IDAT). The allocations are reused capacities, so this is a high-water-style
/// figure for the largest image decoded, not a per-image accumulation.
fn png_scratch_bytes() -> int {
    return png_px.len + png_raw.len + png_idat.len
}

fn png_decode_count() -> int {
    return png_decodes
}

fn png_failure_count() -> int {
    return png_failures
}

fn png_failure_reason() -> string {
    return png_why
}

/// Channel `c` (0 R, 1 G, 2 B, 3 A) of the decoded source at (x, y).
fn png_get(x: int, y: int, c: int) -> int {
    if x < 0 || y < 0 {
        return 0
    }
    if x >= png_w || y >= png_h {
        return 0
    }
    if c < 0 || c > 3 {
        return 0
    }
    return int(png_px[(y * png_w + x) * 4 + c])
}

// --- resampling: separable Mitchell (Phase 4) -------------------------------
//
// Bilinear alone aliases badly on a large downscale, so the kernel is WIDENED
// by the reduction factor: the support becomes 2 * scale source pixels, which
// makes the filter area-correct (each output pixel averages the input region it
// represents) instead of point-sampling it. Two passes, horizontal then
// vertical, with the same 1-D kernel.
//
// The filter runs on PREMULTIPLIED pixels, so a transparent edge cannot bleed
// its colour, and the result is unpremultiplied on the way into the cache so
// the framebuffer's existing straight-source blend can composite it.

let mut img_tmp: []u8 = []u8 {}
let mut wgt_i: []int = []int {}
let mut wgt_w: []float = []float {}
let mut img_resizes: int = 0

/// Mitchell-Netravali kernel with B = C = 1/3 (the usual "Mitchell" settings).
/// Defined for t >= 0; support is 2.
fn mitchell(t: float) -> float {
    let x = t
    let b = 1.0 / 3.0
    let c = 1.0 / 3.0
    if x < 1.0 {
        let a3 = 12.0 - 9.0 * b - 6.0 * c
        let a2 = 0.0 - 18.0 + 12.0 * b + 6.0 * c
        let a0 = 6.0 - 2.0 * b
        return (a3 * x * x * x + a2 * x * x + a0) / 6.0
    }
    if x < 2.0 {
        let b3 = 0.0 - b - 6.0 * c
        let b2 = 6.0 * b + 30.0 * c
        let b1 = 0.0 - 12.0 * b - 48.0 * c
        let b0 = 8.0 * b + 24.0 * c
        return (b3 * x * x * x + b2 * x * x + b1 * x + b0) / 6.0
    }
    return 0.0
}

/// Build the tap list and normalized weights for output index `i`, mapping
/// `in_n` source samples onto `out_n`. Out-of-range taps clamp to the edge.
fn mitchell_taps(i: int, in_n: int, out_n: int) {
    while wgt_i.len > 0 {
        pop(wgt_i)
    }
    while wgt_w.len > 0 {
        pop(wgt_w)
    }
    let scale = float(in_n) / float(out_n)
    let mut f = scale
    if f < 1.0 {
        f = 1.0
    }
    let radius = 2.0 * f
    let center = (float(i) + 0.5) * scale - 0.5
    let lo = i32(raster.raster_floor(center - radius))
    let hi = i32(raster.raster_ceil(center + radius))
    let mut sum = 0.0
    let mut k = lo
    while k <= hi {
        let w = mitchell(raster.raster_fabs((float(k) - center) / f))
        if w > 0.0 {
            push(wgt_i, k)
            push(wgt_w, w)
            sum = sum + w
        }
        k = k + 1
    }
    if sum <= 0.0 {
        // Degenerate (no tap landed): fall back to the nearest sample.
        push(wgt_i, i32(raster.raster_floor(center + 0.5)))
        push(wgt_w, 1.0)
        return
    }
    let mut j = 0
    while j < wgt_w.len {
        wgt_w[j] = wgt_w[j] / sum
        j = j + 1
    }
}

/// Horizontal pass: `sw`x`sh` source -> `dw`x`sh` into `out`.
fn mitchell_x(sp: []u8, sw: int, sh: int, dw: int, out: &mut []u8) {
    let mut y = 0
    while y < sh {
        let srow = y * sw
        let drow = y * dw
        let mut i = 0
        while i < dw {
            mitchell_taps(i, sw, dw)
            let o = (drow + i) * 4
            let mut c = 0
            while c < 4 {
                let mut acc = 0.0
                let mut t = 0
                while t < wgt_i.len {
                    let mut sx = wgt_i[t]
                    if sx < 0 {
                        sx = 0
                    }
                    if sx > sw - 1 {
                        sx = sw - 1
                    }
                    acc = acc + float(int(sp[(srow + sx) * 4 + c])) * wgt_w[t]
                    t = t + 1
                }
                out[o + c] = u8(raster.raster_clamp_byte(i32(acc + 0.5)))
                c = c + 1
            }
            i = i + 1
        }
        y = y + 1
    }
}

/// Vertical pass: `dw`x`sh` -> `dw`x`dh` into `out`.
fn mitchell_y(tp: []u8, dw: int, sh: int, dh: int, out: &mut []u8) {
    let mut i = 0
    while i < dh {
        mitchell_taps(i, sh, dh)
        let mut y = 0
        while y < dw {
            let o = (i * dw + y) * 4
            let mut c = 0
            while c < 4 {
                let mut acc = 0.0
                let mut t = 0
                while t < wgt_i.len {
                    let mut sy = wgt_i[t]
                    if sy < 0 {
                        sy = 0
                    }
                    if sy > sh - 1 {
                        sy = sh - 1
                    }
                    acc = acc + float(int(tp[(sy * dw + y) * 4 + c])) * wgt_w[t]
                    t = t + 1
                }
                out[o + c] = u8(raster.raster_clamp_byte(i32(acc + 0.5)))
                c = c + 1
            }
            y = y + 1
        }
        i = i + 1
    }
}

/// Resample `png_px` (`sw`x`sh`, premultiplied) into `dst` (`dw`x`dh`,
/// UNPREMULTIPLIED, the form the framebuffer blend wants).
fn mitchell_resize(sw: int, sh: int, dw: int, dh: int, dst: &mut []u8) {
    img_resizes = img_resizes + 1
    // Horizontal pass into the scratch, sized sh x dw.
    let need = sh * dw * 4
    while img_tmp.len < need {
        push(img_tmp, u8(0))
    }
    mitchell_x(png_px, sw, sh, dw, &mut img_tmp)
    // Vertical pass, then unpremultiply into the destination.
    mitchell_y(img_tmp, dw, sh, dh, dst)
    let mut p = 0
    while p < dst.len {
        let a = int(dst[p + 3])
        if a == 0 {
            dst[p] = u8(0)
            dst[p + 1] = u8(0)
            dst[p + 2] = u8(0)
        } else if a < 255 {
            dst[p] = u8((int(dst[p]) * 255 + a / 2) / a)
            dst[p + 1] = u8((int(dst[p + 1]) * 255 + a / 2) / a)
            dst[p + 2] = u8((int(dst[p + 2]) * 255 + a / 2) / a)
        }
        p = p + 4
    }
}

fn mitchell_resize_count() -> int {
    return img_resizes
}

// --- the resized-image cache: a fixed byte budget with LRU ------------------

const IMG_CACHE_MAX: int = 64
const IMG_BUDGET_DEFAULT: int = 8 * 1024 * 1024

let mut img_id: []int = []int {}
let mut img_dw: []int = []int {}
let mut img_dh: []int = []int {}
let mut img_live: []int = []int {}
let mut img_prev: []int = []int {}
let mut img_next: []int = []int {}
let mut img_free: []int = []int {}
let mut img_px: [][]u8 = [][]u8 {}

let mut img_head: int = -1
let mut img_tail: int = -1
let mut img_count: int = 0
let mut img_bytes: int = 0
let mut img_budget: int = IMG_BUDGET_DEFAULT
let mut img_ready: int = 0

let mut img_hits: int = 0
let mut img_misses: int = 0
let mut img_evicts: int = 0
let mut img_refusals: int = 0

fn img_init() {
    if img_ready != 0 {
        return
    }
    img_ready = 1
    let mut s = 0
    while s < IMG_CACHE_MAX {
        push(img_id, 0)
        push(img_dw, 0)
        push(img_dh, 0)
        push(img_live, 0)
        push(img_prev, -1)
        push(img_next, -1)
        push(img_px, []u8 {})
        s = s + 1
    }
    s = IMG_CACHE_MAX - 1
    while s >= 0 {
        push(img_free, s)
        s = s - 1
    }
}

fn img_lru_unlink(s: int) {
    let p = img_prev[s]
    let n = img_next[s]
    if p == -1 {
        img_head = n
    } else {
        img_next[p] = n
    }
    if n == -1 {
        img_tail = p
    } else {
        img_prev[n] = p
    }
    img_prev[s] = -1
    img_next[s] = -1
}

fn img_touch(s: int) {
    if img_head == s {
        return
    }
    img_lru_unlink(s)
    img_prev[s] = -1
    img_next[s] = img_head
    if img_head != -1 {
        img_prev[img_head] = s
    }
    img_head = s
    if img_tail == -1 {
        img_tail = s
    }
}

fn img_drop(s: int) {
    if img_live[s] == 0 {
        return
    }
    img_live[s] = 0
    img_lru_unlink(s)
    img_bytes = img_bytes - img_px[s].len
    img_px[s] = []u8 {}
    push(img_free, s)
    img_count = img_count - 1
    img_evicts = img_evicts + 1
}

fn img_find(id: int, dw: int, dh: int) -> int {
    let mut s = img_head
    while s != -1 {
        if img_live[s] == 1 {
            if img_id[s] == id {
                if img_dw[s] == dw {
                    if img_dh[s] == dh {
                        return s
                    }
                }
            }
        }
        s = img_next[s]
    }
    return -1
}

fn img_evict_one() -> int {
    if img_tail == -1 {
        return 0
    }
    img_drop(img_tail)
    return 1
}

/// Resized image for (id, dw, dh), decoding and resampling on a miss. Returns
/// the slot, or -1 when the image cannot be decoded or does not fit the budget.
fn img_get(id: int, encoded: string, dw: int, dh: int) -> int {
    img_init()
    if dw <= 0 || dh <= 0 {
        return -1
    }
    let have = img_find(id, dw, dh)
    if have >= 0 {
        img_touch(have)
        img_hits = img_hits + 1
        return have
    }
    img_misses = img_misses + 1
    let need = dw * dh * 4
    if need > img_budget {
        // One image larger than the whole budget: refused and counted, never
        // stored. This is also what stops a full-resolution decode from being
        // retained for a thumbnail.
        img_refusals = img_refusals + 1
        return -1
    }
    if png_decode(encoded) != 1 {
        return -1
    }
    while img_bytes + need > img_budget {
        if img_evict_one() == 0 {
            break
        }
    }
    if img_free.len == 0 {
        if img_evict_one() == 0 {
            img_refusals = img_refusals + 1
            return -1
        }
    }
    if img_free.len == 0 {
        img_refusals = img_refusals + 1
        return -1
    }
    let s = pop(img_free)
    img_id[s] = id
    img_dw[s] = dw
    img_dh[s] = dh
    img_px[s] = []u8 {}
    let mut n = 0
    while n < need {
        push(img_px[s], u8(0))
        n = n + 1
    }
    mitchell_resize(png_w, png_h, dw, dh, &mut img_px[s])
    img_live[s] = 1
    img_prev[s] = -1
    img_next[s] = img_head
    if img_head != -1 {
        img_prev[img_head] = s
    }
    img_head = s
    if img_tail == -1 {
        img_tail = s
    }
    img_count = img_count + 1
    img_bytes = img_bytes + need
    return s
}

/// Composite a cached image at (x, y) with `alpha` as a multiplier 0..255.
fn img_blit(s: int, x: int, y: int, alpha: int) {
    if s < 0 || s >= IMG_CACHE_MAX {
        return
    }
    if img_live[s] == 0 {
        return
    }
    if alpha <= 0 {
        return
    }
    let w = img_dw[s]
    let h = img_dh[s]
    let mut r = 0
    while r < h {
        let mut c = 0
        while c < w {
            let p = (r * w + c) * 4
            let a = int(img_px[s][p + 3]) * alpha / 255
            if a > 0 {
                raster.raster_blend(x + c, y + r, int(img_px[s][p]),
                                    int(img_px[s][p + 1]), int(img_px[s][p + 2]), a)
            }
            c = c + 1
        }
        r = r + 1
    }
}

fn img_w(s: int) -> int {
    if s < 0 || s >= IMG_CACHE_MAX {
        return 0
    }
    return img_dw[s]
}

fn img_h(s: int) -> int {
    if s < 0 || s >= IMG_CACHE_MAX {
        return 0
    }
    return img_dh[s]
}

fn img_get_px(s: int, x: int, y: int, c: int) -> int {
    if s < 0 || s >= IMG_CACHE_MAX {
        return 0
    }
    if img_live[s] == 0 {
        return 0
    }
    if x < 0 || y < 0 || x >= img_dw[s] || y >= img_dh[s] {
        return 0
    }
    if c < 0 || c > 3 {
        return 0
    }
    return int(img_px[s][(y * img_dw[s] + x) * 4 + c])
}

fn img_cache_count() -> int {
    return img_count
}

fn img_cache_bytes() -> int {
    return img_bytes
}

fn img_cache_budget() -> int {
    return img_budget
}

fn img_cache_capacity() -> int {
    return IMG_CACHE_MAX
}

fn img_hit_count() -> int {
    return img_hits
}

fn img_miss_count() -> int {
    return img_misses
}

fn img_eviction_count() -> int {
    return img_evicts
}

fn img_refusal_count() -> int {
    return img_refusals
}

fn img_set_budget(b: int) {
    img_init()
    img_budget = b
    while img_bytes > img_budget {
        if img_evict_one() == 0 {
            break
        }
    }
}

fn img_cache_clear() {
    img_init()
    while img_tail != -1 {
        img_drop(img_tail)
    }
    img_hits = 0
    img_misses = 0
    img_evicts = 0
    img_refusals = 0
}

/// Bytes held by the resized-image cache and its resample scratch.
fn img_mem_bytes() -> i64 {
    return i64(img_bytes) + i64(img_tmp.len)
}
