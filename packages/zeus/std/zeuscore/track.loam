//! Fine-grained reactivity: a tracking-scope stack and a signal → effect map.
//!
//! `styled` / any future tracked closure pushes an effect id. `get(sig)`
//! records that signal as a dependency. `set(sig)` re-runs only those
//! closures. Closures never rebuild the tree.

import "platform.loam"

let mut stack: []int = []int {}
let mut fn_ids: []int = []int {}
let mut node_ids: []int = []int {}
let mut dep_sig: []int = []int {}
let mut dep_eff: []int = []int {}
let mut ready: int = 0
/* Untracked-read depth. `peek` / `untrack` raise it so reads inside a
   reactive scope do not become dependency edges — a setter that reads the
   value it is about to overwrite must not subscribe the effect to itself. */
let mut mute: int = 0
/* Effects run, for the Phase 3 proof harness: an animating frame must not run
   a reactive scope, so this stays flat for the whole of an animation. */
let mut runs: int = 0
/* Set by `notify` (every signal write). A non-int signal is written straight
   from generated C (`loam_track_notify`), bypassing `arena.store_sig`, so the
   dirty channels are noted here and drained once per frame. A count, not a
   flag: `arena.store_sig` consumes its own contribution when it handled the
   dirt exactly (targeted invalidation), while a write the C seam made directly
   keeps its contribution so the frame still falls back to a layout mark. */
let mut wrote: int = 0
/* Effect rank: 1 + the rank of the effect that produced a signal this scope
   reads. A flush runs lower ranks first, so a reader of a `computed` runs
   after the computed's own effect recomputed its output — no stale derived
   value, without a full topological sort over the whole graph. */
let mut rank: []int = []int {}
/* `produced_by[signal_id]` = the effect that writes that signal (the internal
   effect of a `computed`), or 0. A reader that adds an edge to such a signal
   is ranked above the producer, in `note_read`. */
let mut produced_by: []int = []int {}
/* `set` inside `batch` defers its effects here (deduped); `batch_end` flushes
   them once, in rank order. */
let mut batch_depth: int = 0
let mut pending: []int = []int {}
/* Per-effect cleanup handler (an interned fn id, 0 = none), run before the
   effect re-runs and when its dependency edges are dropped. */
let mut cleanup_fn: []int = []int {}
/// The computation whose body allocated this effect (0 at the top level). A
/// `scope` re-run disposes its children first, so a nested computation never
/// outlives the run that created it.
let mut parent_eid: []int = []int {}
/// 1 for an effect created by `scope`: re-running it disposes its children.
let mut is_scope: []int = []int {}
/// Rows disposed by a scope re-run, reused by `alloc`, so a scope that re-runs on
/// every change does not grow the effect table.
let mut eid_free: []int = []int {}

fn boot() {
    if ready != 0 {
        return
    }
    ready = 1
    push(fn_ids, 0)
    push(node_ids, 0)
    push(rank, 0)
    push(cleanup_fn, 0)
    push(parent_eid, 0)
    push(is_scope, 0)
}

fn reset() {
    stack = []int {}
    fn_ids = []int {}
    node_ids = []int {}
    dep_sig = []int {}
    dep_eff = []int {}
    rank = []int {}
    produced_by = []int {}
    batch_depth = 0
    pending = []int {}
    cleanup_fn = []int {}
    parent_eid = []int {}
    is_scope = []int {}
    eid_free = []int {}
    mute = 0
    ready = 0
    boot()
}

fn alloc(fn_id: int, node_id: int) -> int {
    boot()
    let mut idx = 0
    if eid_free.len > 0 {
        // Reuse a row a scope re-run disposed.
        idx = eid_free[eid_free.len - 1]
        pop(eid_free)
        fn_ids[idx] = fn_id
        node_ids[idx] = node_id
        rank[idx] = 0
        cleanup_fn[idx] = 0
        is_scope[idx] = 0
    } else {
        push(fn_ids, fn_id)
        push(node_ids, node_id)
        push(rank, 0)
        push(cleanup_fn, 0)
        push(parent_eid, 0)
        push(is_scope, 0)
        idx = fn_ids.len - 1
    }
    // Parent is the computation whose body is running, if any.
    parent_eid[idx] = current_eid()
    return idx
}

/// `alloc` for a scope: re-running it disposes the computations it created.
fn alloc_scope(fn_id: int, node_id: int) -> int {
    let idx = alloc(fn_id, node_id)
    if idx > 0 {
        is_scope[idx] = 1
    }
    return idx
}

fn current_eid() -> int {
    if stack.len == 0 {
        return 0
    }
    return stack[stack.len - 1]
}

fn current_rank() -> int {
    let effect_id = current_eid()
    if effect_id <= 0 {
        return 0
    }
    if effect_id >= rank.len {
        return 0
    }
    return rank[effect_id]
}

fn set_rank(effect_id: int, r: int) {
    if effect_id <= 0 {
        return
    }
    if effect_id >= rank.len {
        return
    }
    rank[effect_id] = r
}

fn rank_of(effect_id: int) -> int {
    if effect_id < 0 {
        return 0
    }
    if effect_id >= rank.len {
        return 0
    }
    return rank[effect_id]
}

/// Record that effect `effect_id` writes signal `signal_id`, so a reader of `signal_id` is
/// ranked above it (see `note_read`).
fn mark_produced(signal_id: int, effect_id: int) {
    if signal_id <= 0 {
        return
    }
    while produced_by.len <= signal_id {
        push(produced_by, 0)
    }
    produced_by[signal_id] = effect_id
}

fn mute_begin() {
    mute = mute + 1
}

fn mute_end() {
    if mute > 0 {
        mute = mute - 1
    }
}

fn note_read(signal_id: int) {
    if mute != 0 {
        return
    }
    if stack.len == 0 {
        return
    }
    if signal_id <= 0 {
        return
    }
    let effect_id = stack[stack.len - 1]
    let n = dep_sig.len
    for i in 0..n {
        if dep_sig[i] == signal_id {
            if dep_eff[i] == effect_id {
                return
            }
        }
    }
    push(dep_sig, signal_id)
    push(dep_eff, effect_id)
    /* A new edge onto a signal an effect writes: read the derived value only
       after the producer has recomputed it. */
    if signal_id < produced_by.len {
        let p = produced_by[signal_id]
        if p > 0 {
            let want = rank_of(p) + 1
            if want > rank_of(effect_id) {
                set_rank(effect_id, want)
            }
        }
    }
}

/// Run and clear `effect_id`'s cleanup handler (`on_cleanup`). Called before the
/// effect re-runs and when its edges are dropped, so a subscription it opened
/// is closed before the body runs again.
fn run_cleanup(effect_id: int) {
    if effect_id <= 0 {
        return
    }
    if effect_id >= cleanup_fn.len {
        return
    }
    let fn_id = cleanup_fn[effect_id]
    if fn_id != 0 {
        platform.plat_invoke_fn(fn_id)
        cleanup_fn[effect_id] = 0
    }
}

fn set_cleanup(effect_id: int, fn_id: int) {
    if effect_id <= 0 {
        return
    }
    if effect_id >= cleanup_fn.len {
        return
    }
    cleanup_fn[effect_id] = fn_id
}

fn drop_eid_deps(effect_id: int) {
    run_cleanup(effect_id)
    let n = dep_sig.len
    if n == 0 {
        return
    }
    /* Swap-remove every edge of `effect_id` in one pass (no keep-list rebuilds). */
    let mut i = 0
    while i < dep_sig.len {
        if dep_eff[i] == effect_id {
            let last = dep_sig.len - 1
            dep_sig[i] = dep_sig[last]
            dep_eff[i] = dep_eff[last]
            pop(dep_sig)
            pop(dep_eff)
        } else {
            i = i + 1
        }
    }
}

/// Drop every dependency edge on a freed signal. A live effect must never
/// re-run from a signal id that was recycled onto another value.
fn drop_sig(signal_id: int) {
    if signal_id <= 0 {
        return
    }
    let n = dep_sig.len
    if n == 0 {
        return
    }
    let mut i = 0
    while i < dep_sig.len {
        if dep_sig[i] == signal_id {
            let last = dep_sig.len - 1
            dep_sig[i] = dep_sig[last]
            dep_eff[i] = dep_eff[last]
            pop(dep_sig)
            pop(dep_eff)
        } else {
            i = i + 1
        }
    }
}

/// Remove the effects of every torn-down node in `ids` (one batched sweep —
/// per-node sweeps made refit subtree drops ~25 ms). The interned handlers
/// behind the effects were recorded on the rebuild scope that created the
/// node and are freed there; this only drops the dependency edges and
/// compacts the tables. Effect ids are table positions, so surviving edges
/// are remapped.
fn member(v: int, ids: []int) -> int {
    let n = ids.len
    for i in 0..n {
        if ids[i] == v {
            return 1
        }
    }
    return 0
}

fn free_nodes_effects(ids: []int) {
    boot()
    let k = ids.len
    if k == 0 {
        return
    }
    let n = node_ids.len
    if n <= 1 {
        return
    }
    /* Allocation-free compaction: dead rows are swap-removed in place.
       Per removal, edges pointing at the dead row are dropped and edges of
       the tail row that filled the hole are rewritten — no per-drop table
       copies (those were ~200-260 KB per chart refit). */
    let mut i = 1
    while i < node_ids.len {
        if member(node_ids[i], ids) != 0 {
            let last = node_ids.len - 1
            if i == last {
                // Tail row is dead: pop it after dropping its edges.
                let mut e = 0
                while e < dep_sig.len {
                    if dep_eff[e] == i {
                        let el = dep_sig.len - 1
                        dep_sig[e] = dep_sig[el]
                        dep_eff[e] = dep_eff[el]
                        pop(dep_sig)
                        pop(dep_eff)
                    } else {
                        e = e + 1
                    }
                }
                pop(fn_ids)
                pop(node_ids)
                pop(rank)
                pop(cleanup_fn)
                pop(parent_eid)
                pop(is_scope)
            } else {
                // Drop the dead row's edges first, then fill the hole with
                // the tail row and follow its edges to the new position.
                let mut e = 0
                while e < dep_sig.len {
                    if dep_eff[e] == i {
                        let el = dep_sig.len - 1
                        dep_sig[e] = dep_sig[el]
                        dep_eff[e] = dep_eff[el]
                        pop(dep_sig)
                        pop(dep_eff)
                    } else {
                        e = e + 1
                    }
                }
                for q in 0..dep_sig.len {
                    if dep_eff[q] == last {
                        dep_eff[q] = i
                    }
                }
                // A child's parent is an effect index too, so it moves with the
                // row it names.
                for q in 0..parent_eid.len {
                    if parent_eid[q] == last {
                        parent_eid[q] = i
                    }
                }
                fn_ids[i] = fn_ids[last]
                node_ids[i] = node_ids[last]
                rank[i] = rank[last]
                cleanup_fn[i] = cleanup_fn[last]
                parent_eid[i] = parent_eid[last]
                is_scope[i] = is_scope[last]
                pop(fn_ids)
                pop(node_ids)
                pop(rank)
                pop(cleanup_fn)
                pop(parent_eid)
                pop(is_scope)
            }
            // The row swapped into `i` may itself be dead: re-check it.
        } else {
            i = i + 1
        }
    }
    // Compaction moved rows, so any recycled index no longer names a row.
    while eid_free.len > 0 {
        pop(eid_free)
    }
}

/// Dispose `e`'s nested computations (recursively), then `e` itself: free the
/// row so `alloc` can reuse it. The caller owns the removal of `e` from any
/// pending list; rows are guarded by `fn_ids[e] == 0` in `run`.
fn dispose_eid(e: int) {
    if e <= 0 {
        return
    }
    if e >= fn_ids.len {
        return
    }
    if fn_ids[e] == 0 {
        return
    }
    dispose_children(e)
    // Drops the edges and runs the cleanup handler.
    drop_eid_deps(e)
    // The row's interned handler is not needed by anyone else, so return it: a
    // scope that re-runs must not leak an intern id per run.
    if fn_ids[e] != 0 {
        platform.plat_intern_free(fn_ids[e])
    }
    fn_ids[e] = 0
    node_ids[e] = 0
    rank[e] = 0
    cleanup_fn[e] = 0
    parent_eid[e] = 0
    is_scope[e] = 0
    push(eid_free, e)
}

/// High-water size of the effect table. A scope that re-runs must reuse the rows
/// it disposed, so this stays flat; exposed for tests.
fn effect_rows() -> int {
    boot()
    return fn_ids.len
}

/// Dispose every computation whose body `e` allocated. Collected first, because
/// disposing rewrites the tables the scan reads.
fn dispose_children(e: int) {
    let mut kids = []int {}
    let n = parent_eid.len
    for i in 1..n {
        if parent_eid[i] == e {
            push(kids, i)
        }
    }
    let m = kids.len
    for k in 0..m {
        dispose_eid(kids[k])
    }
}

fn run(effect_id: int) {
    boot()
    if effect_id <= 0 {
        return
    }
    if effect_id >= fn_ids.len {
        return
    }
    if fn_ids[effect_id] == 0 {
        // A disposed row (a scope dropped it, or a batch still names it).
        return
    }
    // A scope re-run tears its nested computations down first, so a child never
    // survives the run that created it.
    if is_scope[effect_id] != 0 {
        dispose_children(effect_id)
    }
    runs = runs + 1
    drop_eid_deps(effect_id)
    push(stack, effect_id)
    platform.plat_invoke_fn(fn_ids[effect_id])
    if stack.len > 0 {
        pop(stack)
    }
}

fn run_node(node_id: int) {
    boot()
    let n = node_ids.len
    for i in 1..n {
        if node_ids[i] == node_id {
            run(i)
        }
    }
}

fn notify(signal_id: int) {
    notify_at(signal_id, 1)
}

/// Paint-only notify: the write must not force a layout pass (scroll/drag
/// positions, which an app may mirror into a signal).
fn notify_paint(signal_id: int) {
    notify_at(signal_id, 0)
}

fn notify_at(signal_id: int, mark: int) {
    if signal_id <= 0 {
        return
    }
    if mark != 0 {
        wrote = wrote + 1
    }
    let mut hit = []int {}
    let n = dep_sig.len
    for i in 0..n {
        if dep_sig[i] == signal_id {
            let e = dep_eff[i]
            let mut seen = 0
            let h = hit.len
            for j in 0..h {
                if hit[j] == e {
                    seen = 1
                }
            }
            if seen == 0 {
                push(hit, e)
            }
        }
    }
    if batch_depth > 0 {
        let h = hit.len
        for i in 0..h {
            pending_push(hit[i])
        }
        return
    }
    let q = sorted_by_rank(hit)
    let h = q.len
    for i in 0..h {
        run(q[i])
    }
}

// --- batching + ordered flush ---

/// Effects a batched write deferred, deduped. Order does not matter here —
/// `sorted_by_rank` decides the run order at flush time.
fn pending_push(effect_id: int) {
    let n = pending.len
    for i in 0..n {
        if pending[i] == effect_id {
            return
        }
    }
    push(pending, effect_id)
}

/// A copy of `ids` stably ordered by effect rank. Insertion sort: the dirty
/// set per flush is small, and ties must keep registration order.
fn sorted_by_rank(ids: []int) -> []int {
    let mut out = []int {}
    let n = ids.len
    for i in 0..n {
        push(out, ids[i])
    }
    let mut i = 1
    while i < n {
        let v = out[i]
        let vr = rank_of(v)
        let mut j = i
        while j > 0 {
            if rank_of(out[j - 1]) <= vr {
                break
            }
            out[j] = out[j - 1]
            j = j - 1
        }
        out[j] = v
        i = i + 1
    }
    return out
}

fn batch_begin() {
    batch_depth = batch_depth + 1
}

fn batch_end() {
    if batch_depth > 0 {
        batch_depth = batch_depth - 1
    }
    if batch_depth == 0 {
        let n = pending.len
        if n == 0 {
            return
        }
        let q = sorted_by_rank(pending)
        pending = []int {}
        let m = q.len
        for i in 0..m {
            run(q[i])
        }
    }
}

/// 1 once if any signal was written since the last call.
fn take_wrote() -> int {
    if wrote == 0 {
        return 0
    }
    wrote = 0
    return 1
}

/// Drop one write's `wrote` contribution. `arena.store_sig` calls this when it
/// marked the exact nodes itself, so the frame does not also force a layout for
/// that write. A non-int write the C seam made directly never consumes, so its
/// dirt still drains.
fn consume_wrote() {
    if wrote > 0 {
        wrote = wrote - 1
    }
}
