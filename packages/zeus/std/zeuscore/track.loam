//! Fine-grained reactivity: a tracking-scope stack and a signal → effect map.
//!
//! `styled` / any future tracked closure pushes an effect id. `get(sig)`
//! records that signal as a dependency. `set(sig)` re-runs only those
//! closures. Closures never rebuild the tree.

import "platform.loam"

let mut stack: []int = []int {}
let mut fn_ids: []int = []int {}
let mut node_ids: []int = []int {}
let mut dep_sig: []int = []int {}
let mut dep_eff: []int = []int {}
/* The generation `plat_sig_gen` reported for `dep_sig[i]` when the edge was
   recorded. A lazy memo compares these against the live generations to skip a
   recompute whose inputs did not actually move — the check-clean pass. */
let mut dep_gen: []int = []int {}
let mut ready: int = 0
/* Untracked-read depth. `peek` / `untrack` raise it so reads inside a
   reactive scope do not become dependency edges — a setter that reads the
   value it is about to overwrite must not subscribe the effect to itself. */
let mut mute: int = 0
/* Effects run, for the Phase 3 proof harness: an animating frame must not run
   a reactive scope, so this stays flat for the whole of an animation. */
let mut runs: int = 0
/* Set by `notify` (every signal write). A non-int signal is written straight
   from generated C (`loam_track_notify`), bypassing `arena.store_sig`, so the
   dirty channels are noted here and drained once per frame. A count, not a
   flag: `arena.store_sig` consumes its own contribution when it handled the
   dirt exactly (targeted invalidation), while a write the C seam made directly
   keeps its contribution so the frame still falls back to a layout mark. */
let mut wrote: int = 0
/* Effect rank: 1 + the rank of the effect that produced a signal this scope
   reads. A flush runs lower ranks first, so a reader of a `computed` runs
   after the computed's own effect recomputed its output — no stale derived
   value, without a full topological sort over the whole graph. */
let mut rank: []int = []int {}
/* `produced_by[signal_id]` = the effect that writes that signal (the internal
   effect of a `computed`), or 0. A reader that adds an edge to such a signal
   is ranked above the producer, in `note_read`. */
let mut produced_by: []int = []int {}
/* `set` inside `batch` defers its effects here (deduped); `batch_end` flushes
   them once, in rank order. */
let mut batch_depth: int = 0
let mut pending: []int = []int {}
/* Per-effect cleanup handler (an interned fn id, 0 = none), run before the
   effect re-runs and when its dependency edges are dropped. */
let mut cleanup_fn: []int = []int {}
/// The computation whose body allocated this effect (0 at the top level). A
/// `scope` re-run disposes its children first, so a nested computation never
/// outlives the run that created it.
let mut parent_eid: []int = []int {}
/// 1 for an effect created by `scope`: re-running it disposes its children.
let mut is_scope: []int = []int {}
/// Rows disposed by a scope re-run, reused by `alloc`, so a scope that re-runs on
/// every change does not grow the effect table.
let mut eid_free: []int = []int {}

// --- lazy memos -----------------------------------------------------------
// `computed<T>` is a *memo*: an effect whose body computes a value into an
// output signal. Unlike a plain effect it is not run when its inputs move — it
// is marked dirty, and its readers pull it when they run. `memo_state` is
// 0 clean, 1 dirty, 2 computing (the cycle guard). `memo_out[e]` is the output
// signal id, 0 for a non-memo effect.
let mut memo_out: []int = []int {}
let mut memo_state: []int = []int {}
/* 1 while a flush is draining `pending`. A write inside a running effect (a memo
   recompute's `set`) appends instead of recursing. */
let mut flushing: int = 0

/// Set by the arena: called when a `scope` re-runs, so the arena can free the
/// signals and interned handlers that scope's body created. A hook rather than a
/// call, because the arena depends on `track` and not the other way round.
let mut scope_disposer: fn(int) = fn(eid: int) {}

fn set_scope_disposer(f: fn(int)) {
    scope_disposer = f
}

fn boot() {
    if ready != 0 {
        return
    }
    ready = 1
    push(fn_ids, 0)
    push(node_ids, 0)
    push(rank, 0)
    push(cleanup_fn, 0)
    push(parent_eid, 0)
    push(is_scope, 0)
    push(memo_out, 0)
    push(memo_state, 0)
}

fn reset() {
    stack = []int {}
    fn_ids = []int {}
    node_ids = []int {}
    dep_sig = []int {}
    dep_eff = []int {}
    rank = []int {}
    produced_by = []int {}
    batch_depth = 0
    pending = []int {}
    cleanup_fn = []int {}
    parent_eid = []int {}
    is_scope = []int {}
    eid_free = []int {}
    dep_gen = []int {}
    memo_out = []int {}
    memo_state = []int {}
    flushing = 0
    mute = 0
    ready = 0
    boot()
}

fn alloc(fn_id: int, node_id: int) -> int {
    boot()
    let mut idx = 0
    if eid_free.len > 0 {
        // Reuse a row a scope re-run disposed.
        idx = eid_free[eid_free.len - 1]
        pop(eid_free)
        fn_ids[idx] = fn_id
        node_ids[idx] = node_id
        rank[idx] = 0
        cleanup_fn[idx] = 0
        is_scope[idx] = 0
        memo_out[idx] = 0
        memo_state[idx] = 0
    } else {
        push(fn_ids, fn_id)
        push(node_ids, node_id)
        push(rank, 0)
        push(cleanup_fn, 0)
        push(parent_eid, 0)
        push(is_scope, 0)
        push(memo_out, 0)
        push(memo_state, 0)
        idx = fn_ids.len - 1
    }
    // Parent is the computation whose body is running, if any.
    parent_eid[idx] = current_eid()
    return idx
}

/// `alloc` for a scope: re-running it disposes the computations it created.
fn alloc_scope(fn_id: int, node_id: int) -> int {
    let idx = alloc(fn_id, node_id)
    if idx > 0 {
        is_scope[idx] = 1
    }
    return idx
}

/// `alloc` for a memo (`computed<T>`): an effect whose body computes a value
/// into an output signal. A memo is never run by a notify — it is marked dirty
/// and its readers pull it. `mark_memo` binds it to the signal it feeds.
fn alloc_memo(fn_id: int, node_id: int) -> int {
    return alloc(fn_id, node_id)
}

/// Declare `effect_id` the producer of `signal_id` and mark it a memo. `pull`
/// uses `produced_by` to find the memo behind a signal; `step` uses `memo_out`
/// to walk from a stale memo to its readers.
fn mark_memo(signal_id: int, effect_id: int) {
    if effect_id <= 0 {
        return
    }
    if effect_id >= memo_out.len {
        return
    }
    mark_produced(signal_id, effect_id)
    memo_out[effect_id] = signal_id
    memo_state[effect_id] = 0
}

fn current_eid() -> int {
    if stack.len == 0 {
        return 0
    }
    return stack[stack.len - 1]
}

fn current_rank() -> int {
    let effect_id = current_eid()
    if effect_id <= 0 {
        return 0
    }
    if effect_id >= rank.len {
        return 0
    }
    return rank[effect_id]
}

/// The innermost `scope` whose body is running (0 when none). Walks the parent
/// chain, because a `scope` disposes its descendants transitively: a memo created
/// inside a plain `effect` inside a `scope` is still torn down by the scope. Used
/// to give a `computed<T>`'s arena cells the same owner as its memo row.
fn current_scope_eid() -> int {
    let mut e = current_eid()
    let mut guard = 0
    while e > 0 && guard < 64 {
        if e < is_scope.len {
            if is_scope[e] != 0 {
                return e
            }
        }
        if e >= parent_eid.len {
            return 0
        }
        if e >= fn_ids.len {
            return 0
        }
        if fn_ids[e] == 0 {
            return 0
        }
        e = parent_eid[e]
        guard = guard + 1
    }
    return 0
}

fn set_rank(effect_id: int, r: int) {
    if effect_id <= 0 {
        return
    }
    if effect_id >= rank.len {
        return
    }
    rank[effect_id] = r
}

fn rank_of(effect_id: int) -> int {
    if effect_id < 0 {
        return 0
    }
    if effect_id >= rank.len {
        return 0
    }
    return rank[effect_id]
}

/// Record that effect `effect_id` writes signal `signal_id`, so a reader of `signal_id` is
/// ranked above it (see `note_read`).
fn mark_produced(signal_id: int, effect_id: int) {
    if signal_id <= 0 {
        return
    }
    while produced_by.len <= signal_id {
        push(produced_by, 0)
    }
    produced_by[signal_id] = effect_id
}

fn mute_begin() {
    mute = mute + 1
}

fn mute_end() {
    if mute > 0 {
        mute = mute - 1
    }
}

fn note_read(signal_id: int) {
    if mute != 0 {
        return
    }
    if stack.len == 0 {
        return
    }
    if signal_id <= 0 {
        return
    }
    let effect_id = stack[stack.len - 1]
    let n = dep_sig.len
    for i in 0..n {
        if dep_sig[i] == signal_id {
            if dep_eff[i] == effect_id {
                return
            }
        }
    }
    push(dep_sig, signal_id)
    push(dep_eff, effect_id)
    push(dep_gen, platform.plat_sig_gen(signal_id))
    /* A new edge onto a signal an effect writes: read the derived value only
       after the producer has recomputed it. */
    if signal_id < produced_by.len {
        let p = produced_by[signal_id]
        if p > 0 {
            let want = rank_of(p) + 1
            if want > rank_of(effect_id) {
                set_rank(effect_id, want)
            }
        }
    }
}

/// Run and clear `effect_id`'s cleanup handler (`on_cleanup`). Called before the
/// effect re-runs and when its edges are dropped, so a subscription it opened
/// is closed before the body runs again.
fn run_cleanup(effect_id: int) {
    if effect_id <= 0 {
        return
    }
    if effect_id >= cleanup_fn.len {
        return
    }
    let fn_id = cleanup_fn[effect_id]
    if fn_id != 0 {
        platform.plat_invoke_fn(fn_id)
        cleanup_fn[effect_id] = 0
    }
}

fn set_cleanup(effect_id: int, fn_id: int) {
    if effect_id <= 0 {
        return
    }
    if effect_id >= cleanup_fn.len {
        return
    }
    cleanup_fn[effect_id] = fn_id
}

fn drop_eid_deps(effect_id: int) {
    run_cleanup(effect_id)
    let n = dep_sig.len
    if n == 0 {
        return
    }
    /* Swap-remove every edge of `effect_id` in one pass (no keep-list rebuilds). */
    let mut i = 0
    while i < dep_sig.len {
        if dep_eff[i] == effect_id {
            let last = dep_sig.len - 1
            dep_sig[i] = dep_sig[last]
            dep_eff[i] = dep_eff[last]
            dep_gen[i] = dep_gen[last]
            pop(dep_sig)
            pop(dep_eff)
            pop(dep_gen)
        } else {
            i = i + 1
        }
    }
}

/// Drop every dependency edge on a freed signal. A live effect must never
/// re-run from a signal id that was recycled onto another value. The signal's
/// producer mapping goes with it, so a recycled id cannot pull a dead memo.
fn drop_sig(signal_id: int) {
    if signal_id <= 0 {
        return
    }
    if signal_id < produced_by.len {
        produced_by[signal_id] = 0
    }
    let n = dep_sig.len
    if n == 0 {
        return
    }
    let mut i = 0
    while i < dep_sig.len {
        if dep_sig[i] == signal_id {
            let last = dep_sig.len - 1
            dep_sig[i] = dep_sig[last]
            dep_eff[i] = dep_eff[last]
            dep_gen[i] = dep_gen[last]
            pop(dep_sig)
            pop(dep_eff)
            pop(dep_gen)
        } else {
            i = i + 1
        }
    }
}

/// Remove the effects of every torn-down node in `ids` (one batched sweep —
/// per-node sweeps made refit subtree drops ~25 ms). The interned handlers
/// behind the effects were recorded on the rebuild scope that created the
/// node and are freed there; this only drops the dependency edges and
/// compacts the tables. Effect ids are table positions, so surviving edges
/// are remapped.
fn member(v: int, ids: []int) -> int {
    let n = ids.len
    for i in 0..n {
        if ids[i] == v {
            return 1
        }
    }
    return 0
}

fn free_nodes_effects(ids: []int) {
    boot()
    let k = ids.len
    if k == 0 {
        return
    }
    let n = node_ids.len
    if n <= 1 {
        return
    }
    /* Allocation-free compaction: dead rows are swap-removed in place.
       Per removal, edges pointing at the dead row are dropped and edges of
       the tail row that filled the hole are rewritten — no per-drop table
       copies (those were ~200-260 KB per chart refit). */
    let mut i = 1
    while i < node_ids.len {
        if member(node_ids[i], ids) != 0 {
            let last = node_ids.len - 1
            if i == last {
                // Tail row is dead: pop it after dropping its edges.
                let mut e = 0
                while e < dep_sig.len {
                    if dep_eff[e] == i {
                        let el = dep_sig.len - 1
                        dep_sig[e] = dep_sig[el]
                        dep_eff[e] = dep_eff[el]
                        dep_gen[e] = dep_gen[el]
                        pop(dep_sig)
                        pop(dep_eff)
                        pop(dep_gen)
                    } else {
                        e = e + 1
                    }
                }
                for q in 0..produced_by.len {
                    if produced_by[q] == last {
                        produced_by[q] = 0
                    }
                }
                pop(fn_ids)
                pop(node_ids)
                pop(rank)
                pop(cleanup_fn)
                pop(parent_eid)
                pop(is_scope)
                pop(memo_out)
                pop(memo_state)
            } else {
                // Drop the dead row's edges first, then fill the hole with
                // the tail row and follow its edges to the new position.
                let mut e = 0
                while e < dep_sig.len {
                    if dep_eff[e] == i {
                        let el = dep_sig.len - 1
                        dep_sig[e] = dep_sig[el]
                        dep_eff[e] = dep_eff[el]
                        dep_gen[e] = dep_gen[el]
                        pop(dep_sig)
                        pop(dep_eff)
                        pop(dep_gen)
                    } else {
                        e = e + 1
                    }
                }
                for q in 0..dep_sig.len {
                    if dep_eff[q] == last {
                        dep_eff[q] = i
                    }
                }
                // A child's parent is an effect index too, so it moves with the
                // row it names. `produced_by` names a memo row the same way, and
                // `pull` reads it, so it moves too.
                for q in 0..parent_eid.len {
                    if parent_eid[q] == last {
                        parent_eid[q] = i
                    }
                }
                for q in 0..produced_by.len {
                    if produced_by[q] == last {
                        produced_by[q] = i
                    }
                }
                fn_ids[i] = fn_ids[last]
                node_ids[i] = node_ids[last]
                rank[i] = rank[last]
                cleanup_fn[i] = cleanup_fn[last]
                parent_eid[i] = parent_eid[last]
                is_scope[i] = is_scope[last]
                memo_out[i] = memo_out[last]
                memo_state[i] = memo_state[last]
                pop(fn_ids)
                pop(node_ids)
                pop(rank)
                pop(cleanup_fn)
                pop(parent_eid)
                pop(is_scope)
                pop(memo_out)
                pop(memo_state)
            }
            // The row swapped into `i` may itself be dead: re-check it.
        } else {
            i = i + 1
        }
    }
    // Compaction moved rows, so any recycled index no longer names a row.
    while eid_free.len > 0 {
        pop(eid_free)
    }
}

/// Dispose `e`'s nested computations (recursively), then `e` itself: free the
/// row so `alloc` can reuse it. The caller owns the removal of `e` from any
/// pending list; rows are guarded by `fn_ids[e] == 0` in `run`.
fn dispose_eid(e: int) {
    if e <= 0 {
        return
    }
    if e >= fn_ids.len {
        return
    }
    if fn_ids[e] == 0 {
        return
    }
    dispose_children(e)
    // Drops the edges and runs the cleanup handler.
    drop_eid_deps(e)
    // The row's interned handler is not needed by anyone else, so return it: a
    // scope that re-runs must not leak an intern id per run.
    if fn_ids[e] != 0 {
        platform.plat_intern_free(fn_ids[e])
    }
    fn_ids[e] = 0
    node_ids[e] = 0
    rank[e] = 0
    cleanup_fn[e] = 0
    parent_eid[e] = 0
    is_scope[e] = 0
    memo_out[e] = 0
    memo_state[e] = 0
    push(eid_free, e)
}

/// High-water size of the effect table. A scope that re-runs must reuse the rows
/// it disposed, so this stays flat; exposed for tests.
fn effect_rows() -> int {
    boot()
    return fn_ids.len
}

/// Dispose every computation whose body `e` allocated. Collected first, because
/// disposing rewrites the tables the scan reads.
fn dispose_children(e: int) {
    let mut kids = []int {}
    let n = parent_eid.len
    for i in 1..n {
        if parent_eid[i] == e {
            push(kids, i)
        }
    }
    let m = kids.len
    for k in 0..m {
        dispose_eid(kids[k])
    }
}

fn run(effect_id: int) {
    boot()
    if effect_id <= 0 {
        return
    }
    if effect_id >= fn_ids.len {
        return
    }
    if fn_ids[effect_id] == 0 {
        // A disposed row (a scope dropped it, or a batch still names it).
        return
    }
    // A memo's body computes its value; run it directly (the eager entry points:
    // `run_node`, a fresh `computed`, the first pull after a batch).
    if memo_out[effect_id] != 0 {
        memo_recompute(effect_id, 1)
        return
    }
    // A scope re-run tears its nested computations down first, so a child never
    // survives the run that created it — and its cleanup handlers still exist
    // while they run. The arena cells the body owned go after that, once nothing
    // can name them.
    if is_scope[effect_id] != 0 {
        dispose_children(effect_id)
        scope_disposer(effect_id)
    }
    runs = runs + 1
    drop_eid_deps(effect_id)
    push(stack, effect_id)
    platform.plat_invoke_fn(fn_ids[effect_id])
    if stack.len > 0 {
        pop(stack)
    }
}

// --- lazy memos ------------------------------------------------------------

/// Invoke a memo's body: drop the edges it recorded last time (so this run
/// re-discovers its inputs and their generations) and run it with itself as the
/// tracking scope.
fn memo_body(effect_id: int) {
    runs = runs + 1
    drop_eid_deps(effect_id)
    push(stack, effect_id)
    platform.plat_invoke_fn(fn_ids[effect_id])
    if stack.len > 0 {
        pop(stack)
    }
}

/// 1 when any input a scope read has moved since it read it. Values are compared
/// by generation, not by identity — the runtime bumps a cell's generation only
/// when its value actually changed, so this is the change gate the eager
/// `computed` got for free from `set`. Inputs still being computed count as
/// changed, so a cycle settles instead of silently reading a half-built value.
fn inputs_changed(effect_id: int) -> int {
    // 1. Collect the inputs, and bring any upstream memo up to date before
    //    comparing, so a stale generation is not mistaken for an unchanged one.
    let mut ins = []int {}
    let n = dep_sig.len
    for i in 0..n {
        if dep_eff[i] == effect_id {
            push(ins, dep_sig[i])
        }
    }
    let m = ins.len
    if m == 0 {
        // Nothing recorded yet: it has never run and must.
        return 1
    }
    for i in 0..m {
        pull(ins[i])
    }
    // 2. Compare *after* the pulls. An upstream memo can re-enter and run this
    //    scope while it is being brought up to date; its recorded generations are
    //    then already fresh, and it must not run a second time.
    let mut changed = 0
    let mut any = 0
    let k = dep_sig.len
    for i in 0..k {
        if dep_eff[i] == effect_id {
            any = 1
            if platform.plat_sig_gen(dep_sig[i]) != dep_gen[i] {
                changed = 1
            }
        }
    }
    if any == 0 {
        return 1
    }
    return changed
}

/// Recompute memo `effect_id` if its inputs moved. `force` skips the check (the
/// first run of a `computed`, where there is nothing recorded to compare).
fn memo_recompute(effect_id: int, force: int) {
    if effect_id <= 0 {
        return
    }
    if effect_id >= fn_ids.len {
        return
    }
    if fn_ids[effect_id] == 0 {
        return
    }
    if memo_out[effect_id] == 0 {
        return
    }
    if memo_state[effect_id] == 2 {
        // Already computing: a cycle. Leave it be.
        return
    }
    if force == 0 {
        if memo_state[effect_id] == 0 {
            return
        }
        if inputs_changed(effect_id) == 0 {
            memo_state[effect_id] = 0
            return
        }
    }
    memo_state[effect_id] = 2
    memo_body(effect_id)
    // The body's `set` can re-enter and dirty the memo again; keep that.
    if memo_state[effect_id] == 2 {
        memo_state[effect_id] = 0
    }
}

/// Recompute the memo behind `signal_id` if it is stale. Called on every read
/// (`get` / `peek`), so a read that happens outside a flush — an event handler,
/// a `peek` inside an effect — sees a current value.
fn pull(signal_id: int) {
    if signal_id <= 0 {
        return
    }
    if signal_id >= produced_by.len {
        return
    }
    let effect_id = produced_by[signal_id]
    if effect_id <= 0 {
        return
    }
    if effect_id >= memo_out.len {
        return
    }
    // A recycled signal id must not pull a stale memo.
    if memo_out[effect_id] != signal_id {
        return
    }
    memo_recompute(effect_id, 0)
}

fn run_node(node_id: int) {
    boot()
    let n = node_ids.len
    for i in 1..n {
        if node_ids[i] == node_id {
            run(i)
        }
    }
}

fn notify(signal_id: int) {
    notify_at(signal_id, 1)
}

/// Paint-only notify: the write must not force a layout pass (scroll/drag
/// positions, which an app may mirror into a signal).
fn notify_paint(signal_id: int) {
    notify_at(signal_id, 0)
}

fn notify_at(signal_id: int, mark: int) {
    if signal_id <= 0 {
        return
    }
    if mark != 0 {
        wrote = wrote + 1
    }
    let mut hit = []int {}
    let n = dep_sig.len
    for i in 0..n {
        if dep_sig[i] == signal_id {
            let e = dep_eff[i]
            let mut seen = 0
            let h = hit.len
            for j in 0..h {
                if hit[j] == e {
                    seen = 1
                }
            }
            if seen == 0 {
                push(hit, e)
            }
        }
    }
    let h = hit.len
    if batch_depth > 0 {
        for i in 0..h {
            schedule(hit[i])
        }
        return
    }
    if flushing != 0 {
        // A write made from inside a running effect must propagate within that
        // write. The animation bind is the contract: `anim_signal` writes the
        // signal between `anim_bind_begin` / `anim_bind_end`, and the prop setter
        // only intercepts a layout prop as an animated one while that window is
        // open, so the effect that applies the prop has to run before it closes.
        let q = sorted_by_rank(hit)
        let m = q.len
        for i in 0..m {
            step(q[i])
        }
        return
    }
    for i in 0..h {
        schedule(hit[i])
    }
    flush()
}

/// Queue `effect_id` for this flush. Deduped: a signal with several edges to the
/// same effect (or several paths through a memo) schedules it once.
fn schedule(effect_id: int) {
    if effect_id <= 0 {
        return
    }
    if effect_id >= fn_ids.len {
        return
    }
    if fn_ids[effect_id] == 0 {
        return
    }
    pending_push(effect_id)
}

/// Drain `pending` in rank order until it empties. A memo encountered here is
/// *not* recomputed: it is marked stale and its readers are queued, so they pull
/// it when they run. A reader whose inputs turn out not to have moved is skipped,
/// which is the change gate a lazy memo would otherwise lose.
fn flush() {
    if flushing != 0 {
        return
    }
    flushing = 1
    while pending.len > 0 {
        let q = sorted_by_rank(pending)
        pending = []int {}
        let m = q.len
        for i in 0..m {
            step(q[i])
        }
    }
    flushing = 0
}

fn step(effect_id: int) {
    if effect_id <= 0 {
        return
    }
    if effect_id >= fn_ids.len {
        return
    }
    if fn_ids[effect_id] == 0 {
        return
    }
    if memo_out[effect_id] == 0 {
        if inputs_changed(effect_id) == 0 {
            return
        }
        run(effect_id)
        return
    }
    // A memo: it is dirty now, not recomputed now.
    if memo_state[effect_id] != 0 {
        return
    }
    memo_state[effect_id] = 1
    let out = memo_out[effect_id]
    let mut hit = []int {}
    let n = dep_sig.len
    for i in 0..n {
        if dep_sig[i] == out {
            let r = dep_eff[i]
            let mut seen = 0
            let h = hit.len
            for j in 0..h {
                if hit[j] == r {
                    seen = 1
                }
            }
            if seen == 0 {
                push(hit, r)
            }
        }
    }
    let h = hit.len
    for i in 0..h {
        schedule(hit[i])
    }
}

// --- batching + ordered flush ---

/// Effects a batched write deferred, deduped. Order does not matter here —
/// `sorted_by_rank` decides the run order at flush time.
fn pending_push(effect_id: int) {
    let n = pending.len
    for i in 0..n {
        if pending[i] == effect_id {
            return
        }
    }
    push(pending, effect_id)
}

/// A copy of `ids` stably ordered by effect rank. Insertion sort: the dirty
/// set per flush is small, and ties must keep registration order.
fn sorted_by_rank(ids: []int) -> []int {
    let mut out = []int {}
    let n = ids.len
    for i in 0..n {
        push(out, ids[i])
    }
    let mut i = 1
    while i < n {
        let v = out[i]
        let vr = rank_of(v)
        let mut j = i
        while j > 0 {
            if rank_of(out[j - 1]) <= vr {
                break
            }
            out[j] = out[j - 1]
            j = j - 1
        }
        out[j] = v
        i = i + 1
    }
    return out
}

fn batch_begin() {
    batch_depth = batch_depth + 1
}

fn batch_end() {
    if batch_depth > 0 {
        batch_depth = batch_depth - 1
    }
    if batch_depth == 0 {
        flush()
    }
}

/// 1 once if any signal was written since the last call.
fn take_wrote() -> int {
    if wrote == 0 {
        return 0
    }
    wrote = 0
    return 1
}

/// Drop one write's `wrote` contribution. `arena.store_sig` calls this when it
/// marked the exact nodes itself, so the frame does not also force a layout for
/// that write. A non-int write the C seam made directly never consumes, so its
/// dirt still drains.
fn consume_wrote() {
    if wrote > 0 {
        wrote = wrote - 1
    }
}
