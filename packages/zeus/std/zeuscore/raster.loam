//! raster — the software rasterizer's foundation.
//!
//! Zeus rasterizes every pixel itself, in Loam, into one buffer it owns. This
//! module is the bottom of that stack: the framebuffer, the color pipeline, and
//! the tables every fill and glyph composite reads.
//!
//! What lives here (Phase 4, first step):
//!   * ONE framebuffer we own — `physical_w * physical_h * 4`, BGRA8,
//!     premultiplied, reallocated only when the logical size or the backing
//!     scale actually changes. No second full-size buffer anywhere.
//!   * sRGB↔linear 256-entry tables, and a compositor that blends in linear
//!     space so light-on-dark and dark-on-light text keep the same weight. The
//!     framebuffer stays 8-bit; the tables are what make that correct.
//!   * Ordered 8×8 (Bayer) dithering, so a gradient written to 8-bit does not
//!     band.
//!
//! Geometry (analytic coverage, tiles, rounded rects, strokes), shadows, the
//! glyph atlas, and image decode build on this and land next. Nothing here
//! talks to a graphics API: the buffer is plain memory until a host blits it.

/// Rasterization tile edge, in device pixels. Coverage is always computed
/// against global geometry and only the *write* is clipped to the tile — this
/// constant is the size of that clip, not of the geometry.
const RASTER_TILE: int = 256

/// Ordered 8×8 Bayer matrix (values 0..63). Hardcoded: it is a fixed, tiny
/// pattern, and generating it from bit interleaves at init is more code than
/// the table is worth.
let mut bayer8: []int = []int {
    0, 32, 8, 40, 2, 34, 10, 42,
    48, 16, 56, 24, 50, 18, 58, 26,
    12, 44, 4, 36, 14, 46, 6, 38,
    60, 28, 52, 20, 62, 30, 54, 22,
    3, 35, 11, 43, 1, 33, 9, 41,
    51, 19, 59, 27, 49, 17, 57, 25,
    15, 47, 7, 39, 13, 45, 5, 37,
    63, 31, 55, 23, 61, 29, 53, 21,
}

/// sRGB byte → linear, scaled to 0..4095 (12-bit). 12 bits, not 8, because an
/// 8-bit linear domain cannot represent the dark end: sRGB bytes 1..12 all
/// collapse to linear 0, which crushes shadow detail and makes the tables
/// non-invertible. `lin_to_srgb` is indexed by that same 12-bit domain, so both
/// directions stay exact within one byte. Blending happens in this domain.
const RASTER_LIN_MAX: int = 4095
let mut srgb_to_lin: []int = []int {}
let mut lin_to_srgb: []int = []int {}
let mut raster_tables_ready: int = 0

/// The one framebuffer. `fb_w`/`fb_h` are physical pixels; `fb_scale` is the
/// backing scale it was allocated for (2 on retina).
let mut fb: []u8 = []u8 {}
let mut fb_w: int = 0
let mut fb_h: int = 0
let mut fb_scale: int = 0
let mut fb_logical_w: int = 0
let mut fb_logical_h: int = 0
/// Bumped on every reallocation, so a test can prove the buffer is reused
/// across frames and only reallocated on a real size/scale change.
let mut fb_gen: int = 0
let mut fb_reallocs: int = 0

const RASTER_LN2: float = 0.6931471805599453

/// Round to nearest, ties away from zero. The language has no `round` builtin.
fn raster_round(x: float) -> float {
    if x >= 0.0 {
        return float(i32(x + 0.5))
    }
    return float(i32(x - 0.5))
}

/// Natural log, range-reduced to [1,2) and summed with the atanh series.
fn raster_ln(x: float) -> float {
    if x <= 0.0 {
        return -1.0e30
    }
    let mut m = x
    let mut k = 0
    while m >= 2.0 {
        m = m * 0.5
        k = k + 1
    }
    while m < 1.0 {
        m = m * 2.0
        k = k - 1
    }
    let z = (m - 1.0) / (m + 1.0)
    let z2 = z * z
    let mut term = z
    let mut sum = 0.0
    let mut i = 1
    while i <= 27 {
        sum = sum + term / float(i)
        term = term * z2
        i = i + 2
    }
    return 2.0 * sum + float(k) * RASTER_LN2
}

/// Exponential, |r| reduced to ±ln2/2 and summed with a Taylor series.
fn raster_exp(x: float) -> float {
    if x > 300.0 {
        return 1.0e30
    }
    if x < 0.0 - 300.0 {
        return 0.0
    }
    let k = i32(raster_round(x / RASTER_LN2))
    let r = x - float(k) * RASTER_LN2
    let mut term = 1.0
    let mut sum = 1.0
    let mut i = 1
    while i <= 14 {
        term = term * r / float(i)
        sum = sum + term
        i = i + 1
    }
    let mut scale = 1.0
    let mut j = 0
    if k >= 0 {
        while j < k {
            scale = scale * 2.0
            j = j + 1
        }
    } else {
        while j < 0 - k {
            scale = scale * 0.5
            j = j + 1
        }
    }
    return sum * scale
}

/// a^b for a > 0. Only used to build the sRGB tables at init.
fn raster_pow(a: float, b: float) -> float {
    if a <= 0.0 {
        return 0.0
    }
    return raster_exp(b * raster_ln(a))
}

/// IEC 61966-2-1 sRGB transfer, encode side: linear 0..1 → sRGB 0..1.
fn raster_lin_to_srgb01(c: float) -> float {
    if c <= 0.0031308 {
        return c * 12.92
    }
    return 1.055 * raster_pow(c, 1.0 / 2.4) - 0.055
}

/// sRGB 0..1 → linear 0..1.
fn raster_srgb_to_lin01(c: float) -> float {
    if c <= 0.04045 {
        return c / 12.92
    }
    return raster_pow((c + 0.055) / 1.055, 2.4)
}

fn raster_clamp_byte(v: int) -> int {
    if v < 0 {
        return 0
    }
    if v > 255 {
        return 255
    }
    return v
}

fn raster_clamp_lin(v: int) -> int {
    if v < 0 {
        return 0
    }
    if v > RASTER_LIN_MAX {
        return RASTER_LIN_MAX
    }
    return v
}

/// Build the color tables once. Idempotent; safe to call from any entry point.
fn raster_build() {
    if raster_tables_ready != 0 {
        return
    }
    raster_tables_ready = 1
    let mut i = 0
    while i < 256 {
        let c = float(i) / 255.0
        push(srgb_to_lin, raster_clamp_lin(i32(raster_srgb_to_lin01(c) * float(RASTER_LIN_MAX) + 0.5)))
        i = i + 1
    }
    i = 0
    while i <= RASTER_LIN_MAX {
        let l = float(i) / float(RASTER_LIN_MAX)
        push(lin_to_srgb, raster_clamp_byte(i32(raster_lin_to_srgb01(l) * 255.0 + 0.5)))
        i = i + 1
    }
}

/// Allocate (or reuse) the framebuffer for a logical size at a backing scale.
///
/// Reallocates ONLY when the physical size or the scale changed — a frame at
/// the same size is a no-op, and dragging between a retina and a non-retina
/// screen (scale 2 → 1) reallocates and re-renders at the new scale.
fn raster_ensure(lw: int, lh: int, scale: int) {
    raster_build()
    let mut s = scale
    if s < 1 {
        s = 1
    }
    let pw = lw * s
    let ph = lh * s
    fb_logical_w = lw
    fb_logical_h = lh
    if fb_w == pw {
        if fb_h == ph {
            if fb_scale == s {
                if fb.len == pw * ph * 4 {
                    return
                }
            }
        }
    }
    fb_gen = fb_gen + 1
    fb_reallocs = fb_reallocs + 1
    fb_w = pw
    fb_h = ph
    fb_scale = s
    fb = []u8 {}
    let total = pw * ph * 4
    let mut n = 0
    while n < total {
        push(fb, u8(0))
        n = n + 1
    }
}

fn raster_ready() -> int {
    raster_build()
    return 1
}

/// Table accessors so callers never touch the vectors directly. `raster_srgb_to_lin`
/// returns the 12-bit linear value; `raster_lin_to_srgb` takes one.
fn raster_srgb_to_lin(b: int) -> int {
    raster_build()
    return srgb_to_lin[raster_clamp_byte(b)]
}

fn raster_lin_to_srgb(b: int) -> int {
    raster_build()
    return lin_to_srgb[raster_clamp_lin(b)]
}

fn raster_width() -> int {
    return fb_w
}

fn raster_height() -> int {
    return fb_h
}

fn raster_scale() -> int {
    return fb_scale
}

fn raster_bytes() -> int {
    return fb.len
}

fn raster_generation() -> int {
    return fb_gen
}

fn raster_realloc_count() -> int {
    return fb_reallocs
}

/// Tile edge in device pixels; the one source of truth for the tile grid.
fn raster_tile_size() -> int {
    return RASTER_TILE
}

fn raster_pixel_index(x: int, y: int) -> int {
    return (y * fb_w + x) * 4
}

/// Channel `c` (0 B, 1 G, 2 R, 3 A) of the pixel at (x, y).
fn raster_get(x: int, y: int, c: int) -> int {
    if x < 0 {
        return 0
    }
    if y < 0 {
        return 0
    }
    if x >= fb_w {
        return 0
    }
    if y >= fb_h {
        return 0
    }
    return int(fb[raster_pixel_index(x, y) + c])
}

/// Premultiplied opaque write.
fn raster_set(x: int, y: int, r: int, g: int, b: int) {
    if x < 0 {
        return
    }
    if y < 0 {
        return
    }
    if x >= fb_w {
        return
    }
    if y >= fb_h {
        return
    }
    let i = raster_pixel_index(x, y)
    fb[i] = u8(raster_clamp_byte(b))
    fb[i + 1] = u8(raster_clamp_byte(g))
    fb[i + 2] = u8(raster_clamp_byte(r))
    fb[i + 3] = u8(255)
}

/// Gamma-correct source-over of a straight (non-premultiplied) color with
/// alpha `a` (0..255) onto the premultiplied framebuffer.
///
/// Both colors go through the sRGB→linear table, are composited in linear
/// space, and come back through the linear→sRGB table. That is what keeps
/// light-on-dark and dark-on-light glyphs the same apparent weight; naive
/// byte blending in sRGB does not.
fn raster_blend(x: int, y: int, r: int, g: int, b: int, a: int) {
    if x < 0 {
        return
    }
    if y < 0 {
        return
    }
    if x >= fb_w {
        return
    }
    if y >= fb_h {
        return
    }
    if a <= 0 {
        return
    }
    if a >= 255 {
        raster_set(x, y, r, g, b)
        return
    }
    let i = raster_pixel_index(x, y)
    let sa = float(a) / 255.0
    let inv = 1.0 - sa
    let sl_r = float(srgb_to_lin[raster_clamp_byte(r)])
    let sl_g = float(srgb_to_lin[raster_clamp_byte(g)])
    let sl_b = float(srgb_to_lin[raster_clamp_byte(b)])
    let dl_r = float(srgb_to_lin[int(fb[i + 2])])
    let dl_g = float(srgb_to_lin[int(fb[i + 1])])
    let dl_b = float(srgb_to_lin[int(fb[i])])
    let ol_r = raster_clamp_lin(i32(sl_r * sa + dl_r * inv + 0.5))
    let ol_g = raster_clamp_lin(i32(sl_g * sa + dl_g * inv + 0.5))
    let ol_b = raster_clamp_lin(i32(sl_b * sa + dl_b * inv + 0.5))
    fb[i] = u8(lin_to_srgb[ol_b])
    fb[i + 1] = u8(lin_to_srgb[ol_g])
    fb[i + 2] = u8(lin_to_srgb[ol_r])
    let oa = raster_clamp_byte(i32(float(a) + float(int(fb[i + 3])) * inv + 0.5))
    fb[i + 3] = u8(oa)
}

/// Ordered-dither threshold for (x, y), 0..63. A gradient writer adds
/// `(dither(x,y) - 31) / 64` to its 0..255 value before rounding to a byte,
/// which removes visible banding for free.
fn raster_dither(x: int, y: int) -> int {
    let xi = x & 7
    let yi = y & 7
    return bayer8[yi * 8 + xi]
}

/// Quantize a 0..255 float channel to a byte with ordered dithering.
fn raster_quantize(x: int, y: int, v: float) -> int {
    let d = float(raster_dither(x, y) - 31) / 64.0
    return raster_clamp_byte(i32(v + d + 0.5))
}

// --- geometry: flattened convex paths, analytic coverage (Phase 4) ---------
//
// A filled shape is a convex path in DEVICE pixels (a rounded rect is four
// straight edges and four quarter arcs; a circle is one rounded rect). Coverage
// is the exact area of path ∩ pixel, so an edge that crosses a pixel diagonally
// is graded smoothly. This is analytic coverage — not 2x/4x point sampling.
//
// The one invariant tiles depend on: coverage is computed from the path's
// GLOBAL device coordinates and only the WRITE is clipped to the region passed
// in. So rasterizing in 256x256 tiles is byte-identical to rasterizing the
// whole surface at once, with no seams along tile boundaries. The tile test
// asserts exactly that.

const RASTER_PI: float = 3.14159265358979
const RASTER_HALF_PI: float = 1.5707963267949
const RASTER_TAU: float = 6.28318530717959
const RASTER_R2: float = 0.5
const RASTER_R3: float = 0.166666666666667
const RASTER_R4: float = 0.0416666666666667
const RASTER_R5: float = 0.00833333333333333
const RASTER_R6: float = 0.00138888888888889
const RASTER_R7: float = 0.000198412698412698
const RASTER_R8: float = 0.0000248015873015873
const RASTER_R9: float = 0.00000275573192239859
const RASTER_R10: float = 0.000000275573192239859

/// Flattening tolerance in DEVICE pixels: a curve is subdivided until its chord
/// error is under this, so a rounded corner stays smooth at every scale.
const RASTER_FLAT_TOL: float = 0.25

struct RPoint {
    x: float,
    y: float,
}

/// The current path (device pixels) and the scratch polygons used to clip it.
/// All three are popped to zero, never dropped, so a steady frame allocates
/// nothing.
let mut rp_path: []RPoint = []RPoint {}
let mut rp_clip_a: []RPoint = []RPoint {}
let mut rp_clip_out: []RPoint = []RPoint {}
let mut rp_active: []int = []int {}

fn raster_fabs(x: float) -> float {
    if x < 0.0 {
        return 0.0 - x
    }
    return x
}

/// Newton's method; `x > 0`. Used only to size curve subdivisions.
fn raster_sqrt(x: float) -> float {
    if x <= 0.0 {
        return 0.0
    }
    let mut g = x
    if g < 1.0 {
        g = 1.0
    }
    let mut i = 0
    while i < 26 {
        g = 0.5 * (g + x / g)
        i = i + 1
    }
    return g
}

fn raster_floor(x: float) -> float {
    let t = f32(i32(x))
    if t > x {
        return t - 1.0
    }
    return t
}

fn raster_ceil(x: float) -> float {
    let t = f32(i32(x))
    if t < x {
        return t + 1.0
    }
    return t
}

fn raster_min_f(a: float, b: float) -> float {
    if a < b {
        return a
    }
    return b
}

fn raster_max_f(a: float, b: float) -> float {
    if a > b {
        return a
    }
    return b
}

fn raster_min_i(a: int, b: int) -> int {
    if a < b {
        return a
    }
    return b
}

fn raster_max_i(a: int, b: int) -> int {
    if a > b {
        return a
    }
    return b
}

// sin/cos, reduced into the polynomial's interval (same approach as the PPM
// demos' mathf; there is no std:math and no libm seam).
fn raster_wrap(x: float) -> float {
    return x - RASTER_TAU * raster_round(x / RASTER_TAU)
}

fn raster_sin_kernel(t: float) -> float {
    let z = t * t
    return t * (1.0 - z * (RASTER_R3 - z * (RASTER_R5 - z * (RASTER_R7 - z * RASTER_R9))))
}

fn raster_cos_kernel(t: float) -> float {
    let z = t * t
    return 1.0 - z * (RASTER_R2 - z * (RASTER_R4 - z * (RASTER_R6 - z * (RASTER_R8 - z * RASTER_R10))))
}

fn raster_sin(x: float) -> float {
    let r = raster_wrap(x)
    let a = raster_fabs(r)
    let mut t = a
    if a > RASTER_HALF_PI {
        t = RASTER_PI - a
    }
    let s = raster_sin_kernel(t)
    if r < 0.0 {
        return 0.0 - s
    }
    return s
}

fn raster_cos(x: float) -> float {
    let r = raster_wrap(x)
    let mut a = raster_fabs(r)
    let mut s = 1.0
    if a > RASTER_HALF_PI {
        a = RASTER_PI - a
        s = 0.0 - 1.0
    }
    return s * raster_cos_kernel(a)
}

/// Append the arc from angle `a0` to `a1` on the circle (cx, cy, rad), both
/// endpoints included so a corner meets its straight edges exactly.
fn raster_arc(cx: float, cy: float, rad: float, a0: float, a1: float, nseg: int) {
    let mut k = 0
    while k <= nseg {
        let t = float(k) / float(nseg)
        let ang = a0 + (a1 - a0) * t
        push(rp_path, RPoint { x: cx + rad * raster_cos(ang), y: cy + rad * raster_sin(ang) })
        k = k + 1
    }
}

/// Build a clockwise rounded rectangle in device pixels. `rad` is clamped to
/// half the shorter side, and 0 gives a plain rectangle.
fn raster_round_rect(x: float, y: float, w: float, h: float, r: float) {
    while rp_path.len > 0 {
        pop(rp_path)
    }
    let short = raster_min_f(w, h) * 0.5
    let mut rad = r
    if rad > short {
        rad = short
    }
    if rad < 0.0 {
        rad = 0.0
    }
    if rad <= 0.0 {
        push(rp_path, RPoint { x: x, y: y })
        push(rp_path, RPoint { x: x + w, y: y })
        push(rp_path, RPoint { x: x + w, y: y + h })
        push(rp_path, RPoint { x: x, y: y + h })
        return
    }
    let mut theta = raster_sqrt(8.0 * RASTER_FLAT_TOL / rad)
    if theta < 0.05 {
        theta = 0.05
    }
    let mut nseg = i32(RASTER_HALF_PI / theta) + 1
    if nseg < 2 {
        nseg = 2
    }
    push(rp_path, RPoint { x: x + rad, y: y })
    push(rp_path, RPoint { x: x + w - rad, y: y })
    raster_arc(x + w - rad, y + rad, rad, 0.0 - RASTER_HALF_PI, 0.0, nseg)
    raster_arc(x + w - rad, y + h - rad, rad, 0.0, RASTER_HALF_PI, nseg)
    raster_arc(x + rad, y + h - rad, rad, RASTER_HALF_PI, RASTER_PI, nseg)
    raster_arc(x + rad, y + rad, rad, RASTER_PI, RASTER_PI + RASTER_HALF_PI, nseg)
}

/// Edge indices whose y-extent overlaps pixel row `py`, skipping degenerate
/// edges. Only the few edges in the row band are tested per pixel.
fn raster_row_active(py: int) {
    while rp_active.len > 0 {
        pop(rp_active)
    }
    let n = rp_path.len
    let y0 = float(py)
    let y1 = y0 + 1.0
    let mut i = 0
    while i < n {
        let a = rp_path[i]
        let b = rp_path[(i + 1) % n]
        let lo = raster_min_f(a.y, b.y)
        let hi = raster_max_f(a.y, b.y)
        if hi > lo {
            if hi > y0 {
                if lo < y1 {
                    push(rp_active, i)
                }
            }
        }
        i = i + 1
    }
}

/// Even-odd point-in-path at (x, y).
fn raster_point_inside(x: float, y: float) -> int {
    let n = rp_path.len
    let mut inside = 0
    let mut i = 0
    while i < n {
        let a = rp_path[i]
        let b = rp_path[(i + 1) % n]
        let a_lo = a.y <= y
        let b_lo = b.y <= y
        if a_lo != b_lo {
            let xint = a.x + (y - a.y) * (b.x - a.x) / (b.y - a.y)
            if x < xint {
                inside = 1 - inside
            }
        }
        i = i + 1
    }
    return inside
}

/// A Liang-Barsky result: the trimmed parameter interval and whether the
/// segment survives it.
struct LB {
    t0: float,
    t1: float,
    ok: int,
}

fn raster_lb(p: float, q: float, t0: float, t1: float) -> LB {
    if p == 0.0 {
        if q < 0.0 {
            return LB { t0: t0, t1: t1, ok: 0 }
        }
        return LB { t0: t0, t1: t1, ok: 1 }
    }
    let r = q / p
    if p < 0.0 {
        if r > t1 {
            return LB { t0: t0, t1: t1, ok: 0 }
        }
        let mut n0 = t0
        if r > n0 {
            n0 = r
        }
        return LB { t0: n0, t1: t1, ok: 1 }
    }
    if r < t0 {
        return LB { t0: t0, t1: t1, ok: 0 }
    }
    let mut n1 = t1
    if r < n1 {
        n1 = r
    }
    return LB { t0: t0, t1: n1, ok: 1 }
}

/// Does segment a→b touch the unit pixel square at (px, py)?
fn raster_edge_hits_square(a: RPoint, b: RPoint, px: int, py: int) -> int {
    let xmin = float(px)
    let xmax = xmin + 1.0
    let ymin = float(py)
    let ymax = ymin + 1.0
    let dx = b.x - a.x
    let dy = b.y - a.y
    let s1 = raster_lb(0.0 - dx, a.x - xmin, 0.0, 1.0)
    if s1.ok == 0 {
        return 0
    }
    let s2 = raster_lb(dx, xmax - a.x, s1.t0, s1.t1)
    if s2.ok == 0 {
        return 0
    }
    let s3 = raster_lb(0.0 - dy, a.y - ymin, s2.t0, s2.t1)
    if s3.ok == 0 {
        return 0
    }
    let s4 = raster_lb(dy, ymax - a.y, s3.t0, s3.t1)
    if s4.ok == 0 {
        return 0
    }
    return 1
}

fn raster_coord(p: RPoint, axis: int) -> float {
    if axis == 0 {
        return p.x
    }
    return p.y
}

fn raster_in_keep(v: float, bound: float, keep_ge: int) -> int {
    if keep_ge == 1 {
        if v >= bound {
            return 1
        }
        return 0
    }
    if v <= bound {
        return 1
    }
    return 0
}

/// Clip `rp_clip_a` by one half-plane into `rp_clip_out` (Sutherland-Hodgman;
/// valid because the path is convex, so clipping keeps it convex).
fn raster_clip_global(axis: int, bound: float, keep_ge: int) {
    while rp_clip_out.len > 0 {
        pop(rp_clip_out)
    }
    let n = rp_clip_a.len
    if n < 1 {
        return
    }
    let mut i = 0
    while i < n {
        let cur = rp_clip_a[i]
        let nxt = rp_clip_a[(i + 1) % n]
        let cv = raster_coord(cur, axis)
        let nv = raster_coord(nxt, axis)
        let cin = raster_in_keep(cv, bound, keep_ge)
        let nin = raster_in_keep(nv, bound, keep_ge)
        if cin == 1 {
            push(rp_clip_out, cur)
        }
        if cin != nin {
            let t = (bound - cv) / (nv - cv)
            push(rp_clip_out, RPoint { x: cur.x + t * (nxt.x - cur.x), y: cur.y + t * (nxt.y - cur.y) })
        }
        i = i + 1
    }
}

fn raster_copy_out_to_a() {
    while rp_clip_a.len > 0 {
        pop(rp_clip_a)
    }
    let n = rp_clip_out.len
    let mut i = 0
    while i < n {
        push(rp_clip_a, rp_clip_out[i])
        i = i + 1
    }
}

fn raster_poly_area(pts: []RPoint) -> float {
    let n = pts.len
    if n < 3 {
        return 0.0
    }
    let mut a = 0.0
    let mut i = 0
    while i < n {
        let j = (i + 1) % n
        a = a + pts[i].x * pts[j].y - pts[j].x * pts[i].y
        i = i + 1
    }
    return 0.5 * raster_fabs(a)
}

/// Exact coverage of pixel (px, py), 0..255: area of path ∩ pixel square.
fn raster_pixel_area(px: int, py: int) -> int {
    while rp_clip_a.len > 0 {
        pop(rp_clip_a)
    }
    let n = rp_path.len
    let mut i = 0
    while i < n {
        push(rp_clip_a, rp_path[i])
        i = i + 1
    }
    raster_clip_global(0, float(px), 1)
    raster_copy_out_to_a()
    raster_clip_global(0, float(px) + 1.0, 0)
    raster_copy_out_to_a()
    raster_clip_global(1, float(py), 1)
    raster_copy_out_to_a()
    raster_clip_global(1, float(py) + 1.0, 0)
    let area = raster_poly_area(rp_clip_out)
    let mut c = i32(area * 255.0 + 0.5)
    if c < 0 {
        c = 0
    }
    if c > 255 {
        c = 255
    }
    return c
}

/// Fill the current path, writing only inside [x0,x1) x [y0,y1). Coverage is
/// always from global geometry, so the region is a clip on the write only.
fn raster_fill_path(x0: int, y0: int, x1: int, y1: int, cr: int, cg: int, cb: int, alpha: int) {
    raster_build()
    let n = rp_path.len
    if n < 3 {
        return
    }
    if alpha <= 0 {
        return
    }
    let mut minx = rp_path[0].x
    let mut maxx = minx
    let mut miny = rp_path[0].y
    let mut maxy = miny
    let mut i = 1
    while i < n {
        minx = raster_min_f(minx, rp_path[i].x)
        maxx = raster_max_f(maxx, rp_path[i].x)
        miny = raster_min_f(miny, rp_path[i].y)
        maxy = raster_max_f(maxy, rp_path[i].y)
        i = i + 1
    }
    let bx0 = raster_max_f(float(x0), raster_floor(minx))
    let by0 = raster_max_f(float(y0), raster_floor(miny))
    let bx1 = raster_min_f(float(x1), raster_ceil(maxx))
    let by1 = raster_min_f(float(y1), raster_ceil(maxy))
    let mut py = i32(by0)
    let py_end = i32(by1)
    while py < py_end {
        raster_row_active(py)
        let yc = float(py) + 0.5
        let mut px = i32(bx0)
        let px_end = i32(bx1)
        while px < px_end {
            let mut hit = 0
            let na = rp_active.len
            let mut k = 0
            while k < na {
                let e = rp_active[k]
                if raster_edge_hits_square(rp_path[e], rp_path[(e + 1) % n], px, py) == 1 {
                    hit = 1
                }
                k = k + 1
            }
            let mut cov = 0
            if hit == 0 {
                if raster_point_inside(float(px) + 0.5, yc) == 1 {
                    cov = 255
                }
            } else {
                cov = raster_pixel_area(px, py)
            }
            if cov > 0 {
                let a = cov * alpha / 255
                if a > 0 {
                    raster_blend(px, py, cr, cg, cb, a)
                }
            }
            px = px + 1
        }
        py = py + 1
    }
}

/// Fill the current path as ONE region (whole surface).
fn raster_fill_whole(cr: int, cg: int, cb: int, alpha: int) {
    raster_fill_path(0, 0, fb_w, fb_h, cr, cg, cb, alpha)
}

/// Fill the current path in 256x256 tiles. Must be byte-identical to
/// `raster_fill_whole`: the tile is a write clip, never a geometry clip.
fn raster_fill_tiled(cr: int, cg: int, cb: int, alpha: int) {
    let mut ty = 0
    while ty < fb_h {
        let y1 = raster_min_i(ty + RASTER_TILE, fb_h)
        let mut tx = 0
        while tx < fb_w {
            let x1 = raster_min_i(tx + RASTER_TILE, fb_w)
            raster_fill_path(tx, ty, x1, y1, cr, cg, cb, alpha)
            tx = tx + RASTER_TILE
        }
        ty = ty + RASTER_TILE
    }
}

/// Set every pixel opaque. Test/probe helper and the frame's first clear.
fn raster_clear(r: int, g: int, b: int) {
    raster_build()
    let mut i = 0
    while i < fb.len {
        fb[i] = u8(raster_clamp_byte(b))
        fb[i + 1] = u8(raster_clamp_byte(g))
        fb[i + 2] = u8(raster_clamp_byte(r))
        fb[i + 3] = u8(255)
        i = i + 4
    }
}

/// Rolling hash of the whole framebuffer, so a test can prove two rendering
/// paths produced identical pixels without copying 20 MB around.
fn raster_checksum() -> int {
    let mut h: i64 = 0
    let mut i = 0
    while i < fb.len {
        h = (h * 131 + i64(int(fb[i]))) % 1000000007
        i = i + 1
    }
    return i32(h)
}

// --- multi-piece fills: a tile-sized coverage buffer (Phase 4) -------------
//
// A border is a RING — four straight runs plus four corner arcs — so it is not
// convex and cannot be one path. Compositing its convex pieces one by one would
// double-blend wherever two pieces share an edge (two half-covered pixels
// composited twice are darker than one fully covered pixel), which shows as a
// seam around every border. Instead the pieces ACCUMULATE signed coverage into
// this buffer and it is composited once. The buffer is tile-sized and reset per
// shape, so it is scratch, never a surface-sized intermediate.

let mut cov: []int = []int {}

fn raster_cov_ensure() {
    let want = RASTER_TILE * RASTER_TILE
    if cov.len == want {
        return
    }
    while cov.len > 0 {
        pop(cov)
    }
    let mut i = 0
    while i < want {
        push(cov, 0)
        i = i + 1
    }
}

fn raster_cov_zero(tw: int, th: int) {
    let mut y = 0
    while y < th {
        let row = y * RASTER_TILE
        let mut x = 0
        while x < tw {
            cov[row + x] = 0
            x = x + 1
        }
        y = y + 1
    }
}

/// Round to the nearest device pixel — hairline snapping (quality rule 8).
fn raster_snap(v: float) -> float {
    return raster_floor(v + 0.5)
}

/// Set the path to an axis-aligned rectangle (device pixels).
fn raster_set_rect(x: float, y: float, w: float, h: float) {
    while rp_path.len > 0 {
        pop(rp_path)
    }
    push(rp_path, RPoint { x: x, y: y })
    push(rp_path, RPoint { x: x + w, y: y })
    push(rp_path, RPoint { x: x + w, y: y + h })
    push(rp_path, RPoint { x: x, y: y + h })
}

/// Set the path to a quad (four points, convex).
fn raster_set_quad(ax: float, ay: float, bx: float, by: float,
                   cx: float, cy: float, dx: float, dy: float) {
    while rp_path.len > 0 {
        pop(rp_path)
    }
    push(rp_path, RPoint { x: ax, y: ay })
    push(rp_path, RPoint { x: bx, y: by })
    push(rp_path, RPoint { x: cx, y: cy })
    push(rp_path, RPoint { x: dx, y: dy })
}

/// Add the current path's coverage, clipped to the region [tx,tx+tw) x
/// [ty,ty+th), into the coverage buffer at stride RASTER_TILE. Same global-
/// geometry rule as `raster_fill_path`: the region limits the write only.
fn raster_accum_path(tx: int, ty: int, tw: int, th: int) {
    let n = rp_path.len
    if n < 3 {
        return
    }
    let mut minx = rp_path[0].x
    let mut maxx = minx
    let mut miny = rp_path[0].y
    let mut maxy = miny
    let mut i = 1
    while i < n {
        minx = raster_min_f(minx, rp_path[i].x)
        maxx = raster_max_f(maxx, rp_path[i].x)
        miny = raster_min_f(miny, rp_path[i].y)
        maxy = raster_max_f(maxy, rp_path[i].y)
        i = i + 1
    }
    let bx0 = raster_max_f(float(tx), raster_floor(minx))
    let by0 = raster_max_f(float(ty), raster_floor(miny))
    let bx1 = raster_min_f(float(tx + tw), raster_ceil(maxx))
    let by1 = raster_min_f(float(ty + th), raster_ceil(maxy))
    let mut py = i32(by0)
    let py_end = i32(by1)
    while py < py_end {
        raster_row_active(py)
        let yc = float(py) + 0.5
        let mut px = i32(bx0)
        let px_end = i32(bx1)
        while px < px_end {
            let mut hit = 0
            let na = rp_active.len
            let mut k = 0
            while k < na {
                let e = rp_active[k]
                if raster_edge_hits_square(rp_path[e], rp_path[(e + 1) % n], px, py) == 1 {
                    hit = 1
                }
                k = k + 1
            }
            let mut c = 0
            if hit == 0 {
                if raster_point_inside(float(px) + 0.5, yc) == 1 {
                    c = 255
                }
            } else {
                c = raster_pixel_area(px, py)
            }
            if c != 0 {
                let idx = (py - ty) * RASTER_TILE + (px - tx)
                cov[idx] = cov[idx] + c
            }
            px = px + 1
        }
        py = py + 1
    }
}

/// Composite the accumulated coverage for a region onto the framebuffer.
fn raster_composite_cov(tx: int, ty: int, tw: int, th: int, cr: int, cg: int, cb: int, alpha: int) {
    if alpha <= 0 {
        return
    }
    let mut y = 0
    while y < th {
        let row = y * RASTER_TILE
        let mut x = 0
        while x < tw {
            let mut c = cov[row + x]
            if c > 255 {
                c = 255
            }
            if c > 0 {
                let a = c * alpha / 255
                if a > 0 {
                    raster_blend(tx + x, ty + y, cr, cg, cb, a)
                }
            }
            x = x + 1
        }
        y = y + 1
    }
}

/// Accumulate one quarter-ring: the band between radius `ro` and `ri` over the
/// angle range [a0,a1], as a series of convex quads (the arc is flattened to the
/// same device tolerance as `raster_round_rect`).
fn raster_accum_corner(ccx: float, ccy: float, ro: float, ri: float,
                       a0: float, a1: float, tx: int, ty: int, tw: int, th: int) {
    let mut theta = raster_sqrt(8.0 * RASTER_FLAT_TOL / ro)
    if theta < 0.05 {
        theta = 0.05
    }
    let mut nseg = i32((a1 - a0) / theta) + 1
    if nseg < 2 {
        nseg = 2
    }
    let mut k = 0
    while k < nseg {
        let t0 = float(k) / float(nseg)
        let t1 = float(k + 1) / float(nseg)
        let g0 = a0 + (a1 - a0) * t0
        let g1 = a0 + (a1 - a0) * t1
        let ox0 = ccx + ro * raster_cos(g0)
        let oy0 = ccy + ro * raster_sin(g0)
        let ox1 = ccx + ro * raster_cos(g1)
        let oy1 = ccy + ro * raster_sin(g1)
        let ix0 = ccx + ri * raster_cos(g0)
        let iy0 = ccy + ri * raster_sin(g0)
        let ix1 = ccx + ri * raster_cos(g1)
        let iy1 = ccy + ri * raster_sin(g1)
        raster_set_quad(ox0, oy0, ox1, oy1, ix1, iy1, ix0, iy0)
        raster_accum_path(tx, ty, tw, th)
        k = k + 1
    }
}

/// Accumulate a rounded-rect border RING of thickness `bw` into the coverage
/// buffer, for region [tx,tx+tw) x [ty,ty+th). Four straight runs plus four
/// corner quarter-rings; accumulated, so shared edges never double-blend.
fn raster_accum_ring(x: float, y: float, w: float, h: float, rad: float, bw: float,
                     tx: int, ty: int, tw: int, th: int) {
    let short = raster_min_f(w, h) * 0.5
    let mut ro = rad
    if ro > short {
        ro = short
    }
    if ro < 0.0 {
        ro = 0.0
    }
    let mut ri = ro - bw
    if ri < 0.0 {
        ri = 0.0
    }
    let mut t = bw
    if t > raster_min_f(w, h) * 0.5 {
        t = raster_min_f(w, h) * 0.5
    }
    // straight runs (full thickness, between the corner arcs)
    if w - ro - ro > 0.0 {
        raster_set_rect(x + ro, y, w - ro - ro, t)
        raster_accum_path(tx, ty, tw, th)
        raster_set_rect(x + ro, y + h - t, w - ro - ro, t)
        raster_accum_path(tx, ty, tw, th)
    }
    if h - ro - ro > 0.0 {
        raster_set_rect(x, y + ro, t, h - ro - ro)
        raster_accum_path(tx, ty, tw, th)
        raster_set_rect(x + w - t, y + ro, t, h - ro - ro)
        raster_accum_path(tx, ty, tw, th)
    }
    if ro > 0.0 {
        raster_accum_corner(x + w - ro, y + ro, ro, ri, 0.0 - RASTER_HALF_PI, 0.0, tx, ty, tw, th)
        raster_accum_corner(x + w - ro, y + h - ro, ro, ri, 0.0, RASTER_HALF_PI, tx, ty, tw, th)
        raster_accum_corner(x + ro, y + h - ro, ro, ri, RASTER_HALF_PI, RASTER_PI, tx, ty, tw, th)
        raster_accum_corner(x + ro, y + ro, ro, ri, RASTER_PI, RASTER_PI + RASTER_HALF_PI, tx, ty, tw, th)
    }
}

/// Draw a rounded-rect border, tiled. A border whose device width rounds to one
/// pixel or less snaps its outer edges to the pixel grid, so it lands as one
/// crisp row instead of two half-lit ones (quality rule 8).
fn raster_stroke_round_rect(x: float, y: float, w: float, h: float, rad: float, bw: float,
                            cr: int, cg: int, cb: int, alpha: int) {
    raster_build()
    raster_cov_ensure()
    let hair = bw <= 1.5
    let mut sx = x
    let mut sy = y
    let mut sw = w
    let mut sh = h
    let mut t = bw
    if hair {
        sx = raster_snap(x)
        sy = raster_snap(y)
        sw = raster_snap(x + w) - sx
        sh = raster_snap(y + h) - sy
        t = 1.0
    }
    let mut ty = 0
    while ty < fb_h {
        let th = raster_min_i(ty + RASTER_TILE, fb_h) - ty
        let mut tx = 0
        while tx < fb_w {
            let tw = raster_min_i(tx + RASTER_TILE, fb_w) - tx
            raster_cov_zero(tw, th)
            raster_accum_ring(sx, sy, sw, sh, rad, t, tx, ty, tw, th)
            raster_composite_cov(tx, ty, tw, th, cr, cg, cb, alpha)
            tx = tx + RASTER_TILE
        }
        ty = ty + RASTER_TILE
    }
}

// --- shadows: single-channel alpha, 3 separable box passes (Phase 4) -------
//
// A drop shadow is one color at a soft alpha, so the only thing to compute is a
// single-channel alpha mask: the rounded rect's coverage, blurred. Three
// separable box blurs approximate a Gaussian closely and cost O(1) per pixel
// per pass, far cheaper than a true Gaussian kernel. The mask is scratch — one
// byte per pixel over the shadow's own support plus the tile, reset per draw —
// never RGBA and never surface-sized.

/// Single-channel alpha mask and the ping-pong buffer the separable passes use.
let mut shmask: []u8 = []u8 {}
let mut shbuf: []u8 = []u8 {}
let mut shcap: int = 0

fn raster_shadow_ensure(n: int) {
    if n <= shcap {
        return
    }
    while shmask.len > 0 {
        pop(shmask)
    }
    while shbuf.len > 0 {
        pop(shbuf)
    }
    let mut i = 0
    while i < n {
        push(shmask, u8(0))
        push(shbuf, u8(0))
        i = i + 1
    }
    shcap = n
}

/// Coverage (0..255) of the current path at one pixel — the same analytic test
/// the fills use, so the shadow mask matches the filled shape exactly. The
/// caller must have filled `rp_active` for this row first.
fn raster_path_cov_px(px: int, py: int) -> int {
    let n = rp_path.len
    let mut hit = 0
    let na = rp_active.len
    let mut k = 0
    while k < na {
        let e = rp_active[k]
        if raster_edge_hits_square(rp_path[e], rp_path[(e + 1) % n], px, py) == 1 {
            hit = 1
        }
        k = k + 1
    }
    if hit == 0 {
        if raster_point_inside(float(px) + 0.5, float(py) + 0.5) == 1 {
            return 255
        }
        return 0
    }
    return raster_pixel_area(px, py)
}

/// Fill `shmask` (exw x exh) with the current path's coverage.
fn raster_mask_fill(ex0: int, ey0: int, exw: int, exh: int) {
    // zero the window
    let mut i = 0
    while i < exw * exh {
        shmask[i] = u8(0)
        i = i + 1
    }
    let n = rp_path.len
    if n < 3 {
        return
    }
    let mut minx = rp_path[0].x
    let mut maxx = minx
    let mut miny = rp_path[0].y
    let mut maxy = miny
    let mut j = 1
    while j < n {
        minx = raster_min_f(minx, rp_path[j].x)
        maxx = raster_max_f(maxx, rp_path[j].x)
        miny = raster_min_f(miny, rp_path[j].y)
        maxy = raster_max_f(maxy, rp_path[j].y)
        j = j + 1
    }
    let bx0 = raster_max_f(float(ex0), raster_floor(minx))
    let by0 = raster_max_f(float(ey0), raster_floor(miny))
    let bx1 = raster_min_f(float(ex0 + exw), raster_ceil(maxx))
    let by1 = raster_min_f(float(ey0 + exh), raster_ceil(maxy))
    let mut py = i32(by0)
    let py_end = i32(by1)
    while py < py_end {
        raster_row_active(py)
        let mut px = i32(bx0)
        let px_end = i32(bx1)
        while px < px_end {
            let c = raster_path_cov_px(px, py)
            if c > 0 {
                shmask[(py - ey0) * exw + (px - ex0)] = u8(c)
            }
            px = px + 1
        }
        py = py + 1
    }
}

/// One separable box-blur pass, horizontal: shmask -> shbuf, edge-clamped.
fn raster_box_h(w: int, h: int, r: int) {
    let span = 2 * r + 1
    let mut y = 0
    while y < h {
        let base = y * w
        let mut sum = int(shmask[base]) * (r + 1)
        let mut i = 1
        while i <= r {
            let xx = i
            let cx = raster_min_i(xx, w - 1)
            sum = sum + int(shmask[base + cx])
            i = i + 1
        }
        let mut x = 0
        while x < w {
            shbuf[base + x] = u8(sum / span)
            let outi = x - r
            let ini = x + r + 1
            let co = raster_min_i(raster_max_i(outi, 0), w - 1)
            let ci = raster_min_i(raster_max_i(ini, 0), w - 1)
            sum = sum - int(shmask[base + co]) + int(shmask[base + ci])
            x = x + 1
        }
        y = y + 1
    }
}

/// One separable box-blur pass, vertical: shbuf -> shmask, edge-clamped.
fn raster_box_v(w: int, h: int, r: int) {
    let span = 2 * r + 1
    let mut x = 0
    while x < w {
        let mut sum = int(shbuf[x]) * (r + 1)
        let mut i = 1
        while i <= r {
            let yy = raster_min_i(i, h - 1)
            sum = sum + int(shbuf[yy * w + x])
            i = i + 1
        }
        let mut y = 0
        while y < h {
            shmask[y * w + x] = u8(sum / span)
            let outi = raster_min_i(raster_max_i(y - r, 0), h - 1)
            let ini = raster_min_i(raster_max_i(y + r + 1, 0), h - 1)
            sum = sum - int(shbuf[outi * w + x]) + int(shbuf[ini * w + x])
            y = y + 1
        }
        x = x + 1
    }
}

/// Draw a drop shadow for a rounded rect: the shape offset by (dx, dy), its
/// coverage blurred by three separable box passes, composited under whatever
/// the caller draws next. `blur` is the device-pixel blur radius, `alpha` the
/// peak shadow opacity (0..255).
fn raster_shadow_rect(x: float, y: float, w: float, h: float, rad: float,
                      dx: float, dy: float, blur: float, alpha: int,
                      cr: int, cg: int, cb: int) {
    raster_build()
    if alpha <= 0 {
        return
    }
    let mut pass = i32(blur / 3.0)
    if pass < 1 {
        pass = 1
    }
    let support = pass * 3
    let mut ty = 0
    while ty < fb_h {
        let th = raster_min_i(ty + RASTER_TILE, fb_h) - ty
        let mut tx = 0
        while tx < fb_w {
            let tw = raster_min_i(tx + RASTER_TILE, fb_w) - tx
            let ex0 = raster_max_i(tx - support, 0)
            let ey0 = raster_max_i(ty - support, 0)
            let ex1 = raster_min_i(tx + tw + support, fb_w)
            let ey1 = raster_min_i(ty + th + support, fb_h)
            let exw = ex1 - ex0
            let exh = ey1 - ey0
            if exw > 0 {
                if exh > 0 {
                    raster_shadow_ensure(exw * exh)
                    raster_round_rect(x + dx, y + dy, w, h, rad)
                    raster_mask_fill(ex0, ey0, exw, exh)
                    let mut p = 0
                    while p < 3 {
                        raster_box_h(exw, exh, pass)
                        raster_box_v(exw, exh, pass)
                        p = p + 1
                    }
                    let mut yy = 0
                    while yy < th {
                        let gy = ty + yy
                        let mut xx = 0
                        while xx < tw {
                            let gx = tx + xx
                            let c = int(shmask[(gy - ey0) * exw + (gx - ex0)])
                            if c > 0 {
                                let a = c * alpha / 255
                                if a > 0 {
                                    raster_blend(gx, gy, cr, cg, cb, a)
                                }
                            }
                            xx = xx + 1
                        }
                        yy = yy + 1
                    }
                }
            }
            tx = tx + RASTER_TILE
        }
        ty = ty + RASTER_TILE
    }
}
