//! arena — retained tree, signals, window/frame state (GPUI arena.rs).
//! The node tables themselves live in `nodes.loam`; layout, scene and input
//! read and write them there (`nodes.tree`, `nodes.lay`, `nodes.box`, ...).

import "geometry.loam"
import "nodes.loam"
import "platform.loam"
import "runtime.loam"
import "track.loam"
import "style.loam"
import "std:fmt"

/// Set by `bar_expire`: 1 while any scrollbar thumb is mid-fade, so the frame
/// marks itself dirty without a second pass over the nodes.
let mut bar_fading_live: int = 0
let mut sigs: []int = []int {}
/// Per-signal: 1 when a write can move geometry without an effect marking
/// layout on its behalf (a node's `show` / `visible` predicate, or a number a
/// bound label measures, reads the signal straight from layout). Grown lazily
/// to `sigs.len` — the C signal allocators own `sigs` and are not mirrored.
let mut affects_layout: []int = []int {}
let mut root_id: int = 0
let mut win_w: int = 640
let mut win_h: int = 480
let mut appearance_sid: int = 0
let mut inited: int = 0
let mut theme_l: []int = []int {}
let mut theme_d: []int = []int {}
let mut size_buffer: []int = []int {}
let mut size_layout: []int = []int {}
let mut focus_id: int = 0
/// The node the last pointer press landed on (0 after a key). A roving item
/// that was clicked becomes the pick only once its handler runs, after the
/// click's own focus claim found it not yet focusable; this lets the pick
/// claim focus for the press that made it.
let mut press_target: int = 0
let mut focus_at: int = -1
let mut chain_nodes: []int = []int {}
let mut chain_ctxs: []int = []int {}
let mut focus_ring: []int = []int {}
/// 1 = focus arrived by keyboard (tab/shift-tab); the painted focus ring
/// shows only then, and a pointer click clears it (desktop convention).
let mut kb_focus: int = 0
/// Modal focus trap (`Dialog`). Tab / shift-tab cycle inside this subtree
/// while it is shown; 0 = no trap. `trap_restore` is the focus to return
/// to when the trap releases.
let mut trap_id: int = 0
let mut trap_restore: int = 0
let mut paint_sy: int = 0
let mut paint_sx: int = 0
let mut drag_id: int = 0
let mut drag_ay: int = 0
let mut drag_as: int = 0
let mut drag_bar: int = 0
let mut pulse_t: int = 0
let mut ptr_x: int = 0
let mut ptr_y: int = 0
/// Staged input payload. The engine invokes argument-less interned handlers,
/// so `MouseEvent` / `KeyEvent` are read from here by `current_mouse()` /
/// `current_key()` inside the handler.
let mut ev_x: int = 0
let mut ev_y: int = 0
let mut ev_button: int = 0
let mut ev_key: int = 0
let mut ev_mods: int = 0
/// Text for a `KEY_TEXT` event: what was typed, pasted, or committed by an
/// IME into a `capture_text` box that is not an input.
let mut ev_text: string = ""
/// 1 while an `on_drag` handler runs for the press that starts the drag.
let mut ev_drag_first: int = 0
let mut down_id: int = 0
let mut paint_skip_z: int = 1
let mut safe_t: int = 0
let mut safe_r: int = 0
let mut safe_b: int = 0
let mut safe_l: int = 0

// --- rebuild-scope bookkeeping ---
// `Each` / `refit` hosts rebuild their subtree from a builder. Anything the
// builder allocates — signals (`sig_new`) and interned handlers (recorded via
// `record_intern`) — is owned by the host node for as long as the build
// stands; tearing the host down (rebuild or drop) frees those ids and makes
// them recyclable, so streaming lists do not grow the arena.
// `scope_node` is the host whose builder is currently running (0 = none).
let mut scope_node: int = 0
//
// Ownership records: one per signal or interned handler a build allocated,
// filed under its owner (a host node, `-effect_id` for a live scope, or a `View`
// frame's pending token). Each owner's records form a doubly linked list, and
// each signal / handler id maps to its record, so releasing, adopting or
// re-attributing touches only that owner's records. A flat list scanned per
// owner made dropping a 1000-row list quadratic (~400 ms).
// `r_kind` is 0 for a signal, 1 for a handler, -1 for a free slot. `r_seq` is a
// creation counter: `rec_mark()` reads it, and "since a mark" is `r_seq > mark`.
let mut r_key: []int = []int {}
let mut r_kind: []int = []int {}
let mut r_owner: []int = []int {}
let mut r_seq: []int = []int {}
let mut r_prev: []int = []int {}
let mut r_next: []int = []int {}
let mut r_free: []int = []int {}
let mut rec_seq: int = 0
let mut rec_live_sig: int = 0
let mut rec_live_fn: int = 0
/// Signal id / handler id -> its newest record slot, -1 for none.
let mut sig_rec: []int = []int {}
let mut fn_rec: []int = []int {}
/// Owner -> first record slot (-1 for none): node owners, scope owners
/// (`-eid`), and pending `View` tokens (`OWN_TOKEN_BASE - k`).
let mut own_node: []int = []int {}
let mut own_eff: []int = []int {}
let mut own_tok: []int = []int {}
/// Freed node ids, recycled by `alloc_node`.
let mut free_nodes: []int = []int {}

/* Ids freed by the current drop_children pass: effect teardown runs once per
   subtree (track.free_nodes_effects) instead of once per node — per-node
   table sweeps made every chart refit ~25 ms. */
let mut drop_pool: []int = []int {}

/// Hard ceiling on node slots: the arena never grows past this and never
/// silently appends. `u16` node ids (Phase 3) make 65535 the structural
/// maximum, so the cap is stated once, here. Raising it is a deliberate act;
/// hitting it is loud (see `alloc_node`) rather than a silent realloc-double.
let mut node_cap: int = 65535
/// 1 once `alloc_node` hit `node_cap`. The app keeps running; the widget that
/// asked for the failed slot gets the null handle (id 0) and does not render.
let mut node_overflow: int = 0

// --- dirty channels + frame clock (Phase 3) --------------------------------
//
// `paint_dirty` gates the draw pass, `layout_dirty` the layout pass. A frame
// with only PAINT dirt skips `layout.layout()` and every reactive scope: the
// value that changed was written straight into node paint state by an
// animation track, which never touches the signal graph. `chrome_dirty` asks
// the shared interaction-state pass to recompute hover/press/tween/fade tracks
// from discrete state; it is driven by events, not by the frame clock.
let mut paint_dirty: int = 1
let mut layout_dirty: int = 1
let mut tree_dirty: int = 1
let mut chrome_dirty: int = 1
/* 1 when this frame's paint dirt is frame-wide rather than attributable to
   marked nodes (`mark_paint`, a structural change, a whole-tree re-solve). Paint
   then re-records every op; with it clear, only the marked subtrees are
   re-recorded and the rest of the retained draw list is reused. */
let mut paint_all: int = 0
/* 1 while the per-node draw-op spans of the retained list are trustworthy.
   Cleared whenever the tree or a node changes hands (`mark_tree`, node alloc /
   free), because a span is keyed by node id. */
let mut paint_spans_ok: int = 0
/* 1 when a `view` app's last build may be out of date: a write no effect, bound
   node or host consumed (the view read the signal while it built, untracked), or
   a frame-wide structural mark. Targeted layout / paint / host dirt leaves it
   clear — the retained tree already follows those — so only this (or a resize
   the view read) rebuilds the view and resets the graph. */
let mut view_stale: int = 1
/// Nodes that only have a paint-marked *descendant* (bit 3). Kept so the bit can
/// be cleared at the end of the frame like the PAINT marks are.
let mut dirty_desc: []int = []int {}
// Phase 5: layout invalidation. `measure_gen` is bumped to invalidate every
// cached measure at once; `invalidate_path` marks just a node and its ancestors
// so a re-measure recomputes that path and skips every clean subtree.
// `dirty_layout_nodes` are the nodes a layout prop landed on this frame, and
// `layout_full` says the frame must re-solve the whole tree (a structural /
// resize / theme change) rather than a subtree.
let mut measure_gen: int = 1
let mut dirty_layout_nodes: []int = []int {}
let mut layout_full: int = 1
// Phase 6: one node-scoped invalidation channel. Prop effects and the
// interaction-state flags both call `invalidate`; the chrome pass can then be
// targeted at the flagged nodes instead of walking every hot target.
let mut dirty_chrome_nodes: []int = []int {}
let mut chrome_sync_count: int = 0
// `signal -> bound node`, so a write can mark the chrome of the nodes whose
// `bind` reads it (a switch's tween is read by the chrome pass, not an effect).
let mut bind_sig: []int = []int {}
let mut bind_node: []int = []int {}
/// Host consumers of a signal (a `Match` on its tag, an `Each` on its
/// items): the host's refresh hook, not an effect, reads the signal, so a write
/// would otherwise be unattributable and mark the whole frame. Indexed like
/// `bind_*`; `hosts_for_signal` asks the frame to run the host refresh pass.
let mut host_sig: []int = []int {}
let mut host_node: []int = []int {}
/// The host refresh pass must run this frame: a scroller moved (a windowed
/// list's visible window may have shifted), or a signal a host rebuilds from
/// was written (`hosts_for_signal`). Paint-only on its own; a host that does
/// rebuild marks itself.
let mut virtual_dirty: int = 0
/// Node ids whose PAINT bit was set since the last paint. The animation tick
/// appends here; `scene.paint` drains it. Ids are deduped by the PAINT bit.
let mut dirty_paint: []int = []int {}
/// Monotonic frame clock in ms, advanced by the host-supplied delta.
let mut now_ms: int = 0
/// Tracks with `pulse` (skeleton shimmer) currently alive.
let mut pulse_count: int = 0
/// Anchored floaters placed by the last layout (0 when none are on screen). A
/// scroll must re-place them so a popup stays next to its trigger; when there
/// are none, a scroll stays paint-only (`mark_scroll`).
let mut live_anchors: int = 0
/// A scroll moved while anchored floaters were on screen: re-place them (and
/// only them) before paint. The rule: a scroll offset is applied when boxes
/// are positioned, never by re-measuring — so a scroll stays layout-free.
let mut anchors_dirty: int = 0
/// Floater stack for one paint / hit pass. Sorted by z-index so a Select
/// menu (80) paints over a later Combobox field (50). Within one z-index,
/// anchored popups whose boxes are near each other then order by open time.
/// A popup that is not near them stays in tree order.
let mut floater_id: []int = []int {}
let mut floater_z: []int = []int {}
let mut floater_screen_x: []int = []int {}
let mut floater_screen_y: []int = []int {}
/// Paint-pass filters for `floater_collect`, set by `scene` per collection.
/// A floater inside a scroller is painted once: an in-place one (a z-indexed
/// field) by its nearest scroller, inline, shifted and clipped with it; a
/// window-level one (an overlay, an anchored popup) by the floaters section
/// on top of everything, or by the root when the root is the scroller.
/// `fc_skip_window` drops window-level floaters from this collection;
/// `fc_nested` is set while the walk is inside a scroller below the start.
let mut fc_skip_window: int = 0
let mut fc_nested: int = 0
/// Nodes with an indeterminate spin (`Spinner`) currently alive.
let mut spin_count: int = 0
/// Component-function runs (`Component`) and reactive-effect runs (`track.run`)
/// since boot. Animation must leave both flat (Phase 3 proof harness).
let mut component_runs: int = 0
/// 1 = reduced motion from the host. Animations jump to their final value.
let mut reduced: int = 0
/// 1 = a signal setter fired inside the animation tick (a hard invariant
/// violation). `store_sig` records it and, while `anim_assert != 0`, traps.
let mut anim_signal_writes: int = 0
let mut anim_assert: int = 1

// --- Phase 0 memory instrumentation ---------------------------------------
// See `docs/mem-baseline.md`. These counters only observe: no allocation or
// layout decision reads them, and with `ZEUS_MEM_STATS` off `mem_sample()` is
// never called, so a normal frame does no extra work. `mem_sample()` is invoked
// at the end of every layout while stats are on, which is what makes the
// high-water mark the peak of a whole frame rather than a spot reading.
//
// Phase 0 predates the persistent/scratch split (Phase 2), so "per bucket"
// here means the arena's independent global vectors, not two bump arenas.

/// Peak live node count over the sampled frames (0 until the first sample).
let mut mem_peak_nodes: int = 0
/// Peak arena bytes over the sampled frames.
let mut mem_peak_bytes: i64 = 0
/// Layouts sampled since boot.
let mut mem_frames: int = 0

fn ensure() {
    if inited != 0 {
        return
    }
    inited = 1
    if nodes.tree.len == 0 {
        nodes.push_blank()
    }
    if sigs.len == 0 {
        push(sigs, 0)
    }
    // A re-running `scope` frees the arena cells it owned; `track` cannot name
    // this module, so it calls back through this hook.
    track.set_scope_disposer(fn(eid: int) { release_owner(0 - eid) })
    track.set_guard_hook(fn(fid: int, node: int) -> string { return invoke_on(fid, node) })
    track.set_memo_stale_hook(fn(sid: int) {
        memo_host_hits = memo_host_hits + hosts_for_signal(sid)
    })
    anim_ensure()
}

/// Enter a rebuild scope: allocations from now on are owned by `node_id`.
/// Returns the previous scope so the caller can restore it after the build.
fn scope_begin(node_id: int) -> int {
    let previous = scope_node
    scope_node = node_id
    return previous
}

fn scope_end(previous: int) {
    scope_node = previous
}

/// An interned handler was created under a rebuild scope (or for `owner`):
/// record it so teardown can release its captured env. A negative `owner` is a
/// live-computation scope id, released by `release_owner`.
fn record_intern(id: int, owner: int) {
    if id <= 0 {
        return
    }
    if owner != 0 {
        rec_add(1, id, owner)
    }
}

// --- ownership record lists ---

fn slot_map_get(m: []int, k: int) -> int {
    if k >= 0 && k < m.len {
        return m[k]
    }
    return -1
}

fn own_head(owner: int) -> int {
    if owner > 0 {
        return slot_map_get(own_node, owner)
    }
    if owner > OWN_TOKEN_BASE {
        return slot_map_get(own_eff, 0 - owner)
    }
    return slot_map_get(own_tok, OWN_TOKEN_BASE - owner)
}

fn own_head_set(owner: int, slot: int) {
    if owner > 0 {
        while own_node.len <= owner {
            push(own_node, -1)
        }
        own_node[owner] = slot
    } else if owner > OWN_TOKEN_BASE {
        let k = 0 - owner
        while own_eff.len <= k {
            push(own_eff, -1)
        }
        own_eff[k] = slot
    } else {
        let k = OWN_TOKEN_BASE - owner
        while own_tok.len <= k {
            push(own_tok, -1)
        }
        own_tok[k] = slot
    }
}

/// Link `slot` at the front of `owner`'s list.
fn rec_link(slot: int, owner: int) {
    let h = own_head(owner)
    r_owner[slot] = owner
    r_prev[slot] = -1
    r_next[slot] = h
    if h >= 0 {
        r_prev[h] = slot
    }
    own_head_set(owner, slot)
}

fn rec_unlink(slot: int) {
    let p = r_prev[slot]
    let n = r_next[slot]
    if p >= 0 {
        r_next[p] = n
    } else {
        own_head_set(r_owner[slot], n)
    }
    if n >= 0 {
        r_prev[n] = p
    }
    r_prev[slot] = -1
    r_next[slot] = -1
}

fn rec_add(kind: int, key: int, owner: int) {
    let mut slot = 0
    if r_free.len > 0 {
        slot = r_free[r_free.len - 1]
        pop(r_free)
    } else {
        slot = r_key.len
        push(r_key, 0)
        push(r_kind, -1)
        push(r_owner, 0)
        push(r_seq, 0)
        push(r_prev, -1)
        push(r_next, -1)
    }
    rec_seq = rec_seq + 1
    r_key[slot] = key
    r_kind[slot] = kind
    r_seq[slot] = rec_seq
    rec_link(slot, owner)
    if kind == 0 {
        while sig_rec.len <= key {
            push(sig_rec, -1)
        }
        sig_rec[key] = slot
        rec_live_sig = rec_live_sig + 1
    } else {
        while fn_rec.len <= key {
            push(fn_rec, -1)
        }
        fn_rec[key] = slot
        rec_live_fn = rec_live_fn + 1
    }
}

/// Drop record `slot` (unlink, clear its key map, recycle the slot). Frees
/// nothing: the caller decides whether the id itself is released.
fn rec_drop(slot: int) {
    rec_unlink(slot)
    let k = r_key[slot]
    if r_kind[slot] == 0 {
        if slot_map_get(sig_rec, k) == slot {
            sig_rec[k] = -1
        }
        rec_live_sig = rec_live_sig - 1
    } else {
        if slot_map_get(fn_rec, k) == slot {
            fn_rec[k] = -1
        }
        rec_live_fn = rec_live_fn - 1
    }
    r_kind[slot] = -1
    push(r_free, slot)
}

/// Slots of `owner`'s records of `kind` (-1 = both), collected before any is
/// released, because releasing can file or drop records.
fn rec_of(owner: int, kind: int) -> []int {
    let mut out = []int {}
    let mut s = own_head(owner)
    let mut guard = 0
    while s >= 0 && guard < 100000000 {
        if kind < 0 || r_kind[s] == kind {
            push(out, s)
        }
        s = r_next[s]
        guard = guard + 1
    }
    return out
}

/// Release record `slot`: free its signal or handler, then drop the record.
fn rec_release(slot: int) {
    let k = r_key[slot]
    let kind = r_kind[slot]
    rec_drop(slot)
    if kind == 0 {
        runtime.sig_free(k)
        forget_sig_meta(k)
        track.drop_sig(k)
        anim_drop_sig(k)
    } else {
        runtime.intern_free(k)
    }
}

/// The current record sequence: records made after this are "since the mark".
fn rec_mark() -> int {
    return rec_seq
}

fn rec_reset() {
    r_key = []int {}
    r_kind = []int {}
    r_owner = []int {}
    r_seq = []int {}
    r_prev = []int {}
    r_next = []int {}
    r_free = []int {}
    rec_live_sig = 0
    rec_live_fn = 0
    sig_rec = []int {}
    fn_rec = []int {}
    own_node = []int {}
    own_eff = []int {}
    own_tok = []int {}
}

/// Re-attribute a signal to `owner`, replacing whatever the alloc hook recorded
/// for it (an id has exactly one owner). `computed<T>` uses this to hand its
/// output and body cells to the scope that will dispose its memo, so a re-running
/// `scope` frees them with the memo row instead of leaking two slots per run.
/// Drop the owner record of interned handler `id`: it was freed by its own
/// effect (a static style disposed after one run), so releasing the owner must
/// not free the id again once it has been handed to someone else.
fn forget_intern(id: int) {
    let slot = slot_map_get(fn_rec, id)
    if slot >= 0 {
        rec_drop(slot)
    }
}

fn record_sig(owner: int, signal_id: int) {
    if signal_id <= 0 {
        return
    }
    if owner == 0 {
        return
    }
    // An id has one owner: drop whatever the alloc hook recorded for it.
    let slot = slot_map_get(sig_rec, signal_id)
    if slot >= 0 {
        rec_drop(slot)
    }
    rec_add(0, signal_id, owner)
}

/// The owner a freshly created signal or handler is filed under: the innermost
/// live-computation `scope` (as a negative id, so it cannot collide with a node),
/// else the host rebuild scope, else 0 (process-lifetime). A no-op walk when the
/// reactive stack is empty, which is the common case at build time.
// --- view frames: pending ownership ------------------------------------------
// A `View` component creates its state before its root node exists. While its
// frame is open, `scope_node` is a pending token, so signals and interned
// handlers record under it; `own_end` moves those records onto the root, and
// freeing the root releases them.

/// Pending owners are below every scope eid (which are negative eids).
let mut own_next: int = -1000000000
const OWN_TOKEN_BASE: int = -1000000000
/// `own_root_of[node_id]` = 1 when the node owns records moved by `own_end`.
let mut owns_records: []int = []int {}

/// Open a pending owner; returns the token. The previous owner is restored by
/// `own_end`.
fn own_begin() -> int {
    own_next = own_next - 1
    return own_next
}

/// Move every record `token` holds onto `root`, and restore `previous` as the
/// build owner.
fn own_end(token: int, root: int) {
    let moving = rec_of(token, -1)
    let n = moving.len
    for i in 0..n {
        rec_unlink(moving[i])
        rec_link(moving[i], root)
    }
    if n > 0 && root > 0 {
        while owns_records.len <= root {
            push(owns_records, 0)
        }
        owns_records[root] = 1
    }
}

/// Owned signal + handler records, for tests: churning `View` components must
/// keep it flat.
fn owned_records() -> int {
    return rec_live_sig + rec_live_fn
}

/// Release what a freed `View` root owns.
fn own_release(id: int) {
    if id > 0 && id < owns_records.len && owns_records[id] == 1 {
        owns_records[id] = 0
        release_owner(id)
    }
}

/// The build owner: `scope_node` (a host node, or a `View` frame's pending
/// token), replaced for the body of a `scope`.
fn set_scope_node(v: int) {
    scope_node = v
}

fn get_scope_node() -> int {
    return scope_node
}

fn owner_now() -> int {
    let s = track.current_scope_eid()
    if s > 0 {
        return 0 - s
    }
    return scope_node
}

/// Free everything recorded under `owner`: the signals and interned handlers a
/// live computation scope created. Complements `track.dispose_eid`, which frees
/// the scope's effect rows; a negative owner is `-effect_id`.
fn release_owner(owner: int) {
    if owner == 0 {
        return
    }
    let mine = rec_of(owner, -1)
    for i in 0..mine.len {
        if r_kind[mine[i]] >= 0 && r_owner[mine[i]] == owner {
            rec_release(mine[i])
        }
    }
}

/// Free every signal a node's rebuilds allocated. Records are per build
/// scope, so an id has one owner: swap-remove matching owners in one pass —
/// rebuilding the keep-list on every release was O(all records) per chart
/// refit, which is what made window-resize frames crawl once the catalog
/// accumulated records.
fn release_sigs(node_id: int) {
    let mine = rec_of(node_id, 0)
    for i in 0..mine.len {
        if r_kind[mine[i]] == 0 && r_owner[mine[i]] == node_id {
            rec_release(mine[i])
        }
    }
}

/// Free every interned handler a node's rebuilds created, in one pass.
fn release_fns(node_id: int) {
    let mine = rec_of(node_id, 1)
    for i in 0..mine.len {
        if r_kind[mine[i]] == 1 && r_owner[mine[i]] == node_id {
            rec_release(mine[i])
        }
    }
}

/// Re-attribute the allocations made since a mark from `host` to `row`. An
/// incremental list reconcile sets the build scope to the host, builds one row,
/// then hands that row its own signals and interned handlers so removing the row
/// frees exactly them. Entries a nested scope already claimed (an `Each` inside the
/// row) keep their owner and are left alone.
fn adopt_records(host: int, row: int, mark: int) {
    if row <= 0 {
        return
    }
    let mine = rec_of(host, -1)
    for i in 0..mine.len {
        if r_seq[mine[i]] > mark {
            rec_unlink(mine[i])
            rec_link(mine[i], row)
        }
    }
}

// --- keyed-list identity ---
// Keyed `Each` mounts one child per unique key and reuses it across reorders,
// so focus and per-row state survive a move. The table maps `(host, key)` to
// the top-level child mounted for that key; entries live only while the host
// is alive (cleared by `key_clear` on teardown).
//
// Shape: one open-addressed hash table over parallel slot arrays (linear
// probing, power-of-two capacity, tombstones, 0.75 load), so a lookup costs
// O(1) no matter how many lists the app has mounted. Each host's slots are
// also threaded on a doubly linked chain (`kt_next` / `kt_prev`, head in
// `key_head[host]`), so a host's count is O(1) and its key list and teardown
// are O(its own keys), never O(every key in the app). A slot only moves on a
// grow, which rebuilds the chains.
let mut kt_used: []int = []int {}
let mut kt_hash: []int = []int {}
let mut kt_host: []int = []int {}
let mut kt_key: []string = []string {}
let mut kt_node: []int = []int {}
let mut kt_next: []int = []int {}
let mut kt_prev: []int = []int {}
/// Insertion serial of each slot. `release` drops every entry newer than its
/// mark, which is what the old append-only table got from truncation.
let mut kt_serial: []int = []int {}
/// Live entries, and live + tombstones (decides whether growing helps).
let mut kt_len: int = 0
let mut kt_filled: int = 0
let mut key_serial: int = 0
/// Per host node id: first slot of its chain (-1 = none) and its entry count.
let mut key_head: []int = []int {}
let mut key_cnt: []int = []int {}

/// FNV-1a over the key's bytes, seeded with the host. Computed in `i64` and
/// folded to 26 bits: `int` multiply is checked, so a full-width FNV step would
/// trap (same reasoning as `std:map`'s `hash_str`). Never 0.
fn kt_hash_of(host: int, k: string) -> int {
    let mut h: i64 = (531216261 ^ i64(host)) & 67108863
    let mut i = 0
    while i < k.len {
        let mut b = k[i]
        if b < 0 {
            b = 0 - b
        }
        h = h ^ i64(b)
        h = (h * 16777619) & 67108863
        i = i + 1
    }
    let out = i32(h)
    if out == 0 {
        return 1
    }
    return out
}

/// Slot of `(host, k)`, or -1.
fn kt_find(host: int, k: string) -> int {
    let cap = kt_used.len
    if cap == 0 {
        return -1
    }
    if host < 0 || host >= key_cnt.len {
        return -1
    }
    if key_cnt[host] == 0 {
        return -1
    }
    let h = kt_hash_of(host, k)
    let mut i = 0
    while i < cap {
        let s = (h + i) & (cap - 1)
        let u = kt_used[s]
        if u == 0 {
            return -1
        }
        if u == 1 {
            if kt_hash[s] == h {
                if kt_host[s] == host {
                    if kt_key[s] == k {
                        return s
                    }
                }
            }
        }
        i = i + 1
    }
    return -1
}

fn key_host_ensure(host: int) {
    while key_head.len <= host {
        push(key_head, -1)
        push(key_cnt, 0)
    }
}

/// Put `s` at the front of its host's chain.
fn kt_link(s: int) {
    let host = kt_host[s]
    key_host_ensure(host)
    let head = key_head[host]
    kt_prev[s] = -1
    kt_next[s] = head
    if head >= 0 {
        kt_prev[head] = s
    }
    key_head[host] = s
    key_cnt[host] = key_cnt[host] + 1
}

/// Take live slot `s` off its host's chain and leave a tombstone, so probe
/// chains through it stay intact.
fn kt_unlink(s: int) {
    let host = kt_host[s]
    let p = kt_prev[s]
    let n = kt_next[s]
    if p >= 0 {
        kt_next[p] = n
    } else {
        key_head[host] = n
    }
    if n >= 0 {
        kt_prev[n] = p
    }
    key_cnt[host] = key_cnt[host] - 1
    kt_used[s] = 2
    kt_hash[s] = 0
    kt_host[s] = 0
    kt_key[s] = ""
    kt_node[s] = 0
    kt_next[s] = -1
    kt_prev[s] = -1
    kt_len = kt_len - 1
}

/// Write a new entry into the first free slot on its probe; the caller has
/// checked it is absent and that the table has room.
fn kt_place(host: int, k: string, node: int, serial: int) {
    let cap = kt_used.len
    let h = kt_hash_of(host, k)
    let mut i = 0
    while i < cap {
        let s = (h + i) & (cap - 1)
        let u = kt_used[s]
        if u != 1 {
            if u == 0 {
                kt_filled = kt_filled + 1
            }
            kt_used[s] = 1
            kt_hash[s] = h
            kt_host[s] = host
            kt_key[s] = k
            kt_node[s] = node
            kt_serial[s] = serial
            kt_link(s)
            kt_len = kt_len + 1
            return
        }
        i = i + 1
    }
}

/// Resize to `cap` slots and re-insert every live entry (dropping
/// tombstones). Chains are rebuilt from scratch.
fn kt_rehash(cap: int) {
    let o_used = kt_used
    let o_host = kt_host
    let o_key = kt_key
    let o_node = kt_node
    let o_serial = kt_serial
    kt_used = []int {}
    kt_hash = []int {}
    kt_host = []int {}
    kt_key = []string {}
    kt_node = []int {}
    kt_next = []int {}
    kt_prev = []int {}
    kt_serial = []int {}
    let mut i = 0
    while i < cap {
        push(kt_used, 0)
        push(kt_hash, 0)
        push(kt_host, 0)
        push(kt_key, "")
        push(kt_node, 0)
        push(kt_next, -1)
        push(kt_prev, -1)
        push(kt_serial, 0)
        i = i + 1
    }
    let hn = key_head.len
    for j in 0..hn {
        key_head[j] = -1
        key_cnt[j] = 0
    }
    kt_len = 0
    kt_filled = 0
    let on = o_used.len
    for j in 0..on {
        if o_used[j] == 1 {
            kt_place(o_host[j], o_key[j], o_node[j], o_serial[j])
        }
    }
}

/// Make room for one more entry. A table that is mostly tombstones is rebuilt
/// at the same capacity, so add / remove churn does not grow it without bound.
fn kt_reserve() {
    let cap = kt_used.len
    if cap == 0 {
        kt_rehash(16)
        return
    }
    if (kt_filled + 1) * 4 < cap * 3 {
        return
    }
    if kt_len * 4 < cap {
        kt_rehash(cap)
    } else {
        kt_rehash(cap * 2)
    }
}

fn key_node(host: int, k: string) -> int {
    let s = kt_find(host, k)
    if s < 0 {
        return 0
    }
    return kt_node[s]
}

fn key_set(host: int, k: string, node: int) {
    let s = kt_find(host, k)
    if s >= 0 {
        kt_node[s] = node
        return
    }
    if host <= 0 {
        return
    }
    kt_reserve()
    key_serial = key_serial + 1
    kt_place(host, k, node, key_serial)
}

fn key_count(host: int) -> int {
    if host < 0 || host >= key_cnt.len {
        return 0
    }
    return key_cnt[host]
}

fn key_clear(host: int) {
    if host < 0 || host >= key_head.len {
        return
    }
    while key_head[host] >= 0 {
        kt_unlink(key_head[host])
    }
}

/// Drop one keyed entry.
fn key_forget(host: int, k: string) {
    let s = kt_find(host, k)
    if s >= 0 {
        kt_unlink(s)
    }
}

/// Every key currently mounted under `host`, in no particular order. An
/// incremental reconcile diffs this against the new key set to find removals.
fn key_keys(host: int) -> []string {
    let mut out = []string {}
    if host < 0 || host >= key_head.len {
        return out
    }
    let mut s = key_head[host]
    while s >= 0 {
        push(out, kt_key[s])
        s = kt_next[s]
    }
    return out
}

/// Drop every entry inserted after serial `serial` (a `Boundary` rollback).
fn key_drop_after(serial: int) {
    let cap = kt_used.len
    for s in 0..cap {
        if kt_used[s] == 1 {
            if kt_serial[s] > serial {
                kt_unlink(s)
            }
        }
    }
    key_serial = serial
}

fn key_reset() {
    kt_used = []int {}
    kt_hash = []int {}
    kt_host = []int {}
    kt_key = []string {}
    kt_node = []int {}
    kt_next = []int {}
    kt_prev = []int {}
    kt_serial = []int {}
    kt_len = 0
    kt_filled = 0
    key_head = []int {}
    key_cnt = []int {}
}

/// 1 when `keys` holds no duplicate. One hash per key into a scratch table of
/// indices, so O(n) where a pairwise scan is O(n^2).
fn keys_unique(keys: []string) -> int {
    let n = keys.len
    if n < 2 {
        return 1
    }
    let mut cap = 8
    while cap < n * 2 {
        cap = cap * 2
    }
    let mut slot = []int {}
    for i in 0..cap {
        push(slot, 0)
    }
    let mut hs = []int {}
    for i in 0..n {
        let h = kt_hash_of(0, keys[i])
        push(hs, h)
        let mut j = 0
        while j < cap {
            let s = (h + j) & (cap - 1)
            if slot[s] == 0 {
                slot[s] = i + 1
                break
            }
            let o = slot[s] - 1
            if hs[o] == h {
                if keys[o] == keys[i] {
                    return 0
                }
            }
            j = j + 1
        }
    }
    return 1
}

// --- fragments: keyed lists without a wrapper -------------------------------
// `Each` adds no box around its rows: they are ordinary children of the node
// the `Each` sits in, so a list in a row lays out as a row, in a grid as grid
// cells. The `Each` itself is one hidden marker node (it takes no space and no
// gap slot) placed right after its rows; it owns the key table, the refresh
// hook and the row order (`frag`). Freeing the parent frees rows and marker
// together, like any children.

/// Make `order` (then any of the host's rows still playing an exit) the
/// host's rows, laid into its parent directly before the marker. Nodes the
/// host held before and no longer lists leave the parent's children; freed
/// ids are dropped.
fn frag_set(host: int, order: []int) {
    let parent = nodes.frag_parent(host)
    let old = nodes.tree[host].frag
    let g = stamp_begin()
    let on = old.len
    for i in 0..on {
        let r = old[i]
        if r > 0 && r < nodes.tree.len {
            if nodes.tree[r].frag_of == host {
                stamp_set(r, g)
            }
        }
    }
    let n = order.len
    for i in 0..n {
        stamp_set(order[i], g)
    }
    let mut rows = order
    for i in 0..on {
        let r = old[i]
        if r > 0 && r < nodes.tree.len {
            if nodes.tree[r].frag_of == host &&
                nodes.tree[r].exiting != 0 &&
                int(nodes.tree[r].kind) != 0 {
                if kfor_in(order, r) == 0 {
                    push(rows, r)
                }
            }
        }
    }
    let rn = rows.len
    for i in 0..rn {
        nodes.tree[rows[i]].parent = parent
        nodes.tree[rows[i]].frag_of = host
    }
    nodes.tree[host].frag = rows
    if parent == host {
        nodes.tree[host].kids = rows
        mark_tree_at(host)
        return
    }
    let cur = nodes.tree[parent].kids
    let cn = cur.len
    let mut out = []int {}
    let mut placed = 0
    for i in 0..cn {
        let k = cur[i]
        if k == host {
            for j in 0..rn {
                push(out, rows[j])
            }
            push(out, host)
            placed = 1
        } else if k > 0 && k < nodes.tree.len {
            if stamp_has(k, g) == false && int(nodes.tree[k].kind) != 0 {
                push(out, k)
            }
        }
    }
    if placed == 0 {
        for j in 0..rn {
            push(out, rows[j])
        }
    }
    nodes.tree[parent].kids = out
    mark_tree_at(parent)
}

fn kfor_in(ids: []int, v: int) -> int {
    let n = ids.len
    for i in 0..n {
        if ids[i] == v {
            return 1
        }
    }
    return 0
}

// --- id stamps ---
// A membership test over node ids without a nested scan: `stamp_begin` opens a
// fresh generation, `stamp_set` marks an id, `stamp_has` asks. O(1) each, and
// opening a generation clears every earlier mark for free.
let mut stamp_at: []int = []int {}
let mut stamp_gen: int = 0

fn stamp_begin() -> int {
    stamp_gen = stamp_gen + 1
    return stamp_gen
}

fn stamp_set(id: int, g: int) {
    if id < 0 {
        return
    }
    while stamp_at.len <= id {
        push(stamp_at, 0)
    }
    stamp_at[id] = g
}

fn stamp_has(id: int, g: int) -> bool {
    if id < 0 || id >= stamp_at.len {
        return false
    }
    return stamp_at[id] == g
}

/// Tear down a node: free its subtree (sigs, interned handlers, effects) and
/// recycle the slot. Freed slots are blanked so global scans (hover, cursor,
/// refresh lists) treat them as empty. Effect cleanup is batched by the
/// enclosing drop_children, so this only recurses and recycles.
/// Masked text inputs (`PasswordInput`), by node id. Slots are re-stamped
/// across nodes, so the flag is pushed to the slot each time it is used
/// (`edit_sync_secure`) rather than stored on it once.
let mut secure_ids: []int = []int {}

fn secure_set(id: int, on: bool) {
    let mut i = 0
    while i < secure_ids.len {
        if secure_ids[i] == id {
            if !on {
                secure_ids[i] = secure_ids[secure_ids.len - 1]
                pop(secure_ids)
                mark_paint()
            }
            return
        }
        i = i + 1
    }
    if on {
        push(secure_ids, id)
        mark_paint()
    }
}

fn edit_sync_secure(id: int, slot: int) {
    let mut on = 0
    for i in 0..secure_ids.len {
        if secure_ids[i] == id {
            on = 1
        }
    }
    runtime.edit_set_secure(slot, on)
}

/// Pointer hooks that only a few nodes carry — `on_context_menu` (kind
/// `HOOK_CONTEXT`) and `on_drag` (`HOOK_DRAG`): node id → interned fn. A side
/// table, not node fields, so the common node pays nothing. The fn's lifetime
/// is its owner's, like any handler; a freed node drops its rows.
const HOOK_CONTEXT: int = 1
const HOOK_DRAG: int = 2
let mut hook_node: []int = []int {}
let mut hook_kind: []int = []int {}
let mut hook_fn: []int = []int {}

fn hook_set(id: int, kind: int, fn_id: int) {
    for i in 0..hook_node.len {
        if hook_node[i] == id && hook_kind[i] == kind {
            hook_fn[i] = fn_id
            return
        }
    }
    push(hook_node, id)
    push(hook_kind, kind)
    push(hook_fn, fn_id)
}

/// The `kind` hook on `id`, or 0.
fn hook_of(id: int, kind: int) -> int {
    for i in 0..hook_node.len {
        if hook_node[i] == id && hook_kind[i] == kind {
            return hook_fn[i]
        }
    }
    return 0
}

/// The nearest node at or above `id` carrying a `kind` hook, or 0.
fn hook_owner(id: int, kind: int) -> int {
    if hook_node.len == 0 {
        return 0
    }
    let mut at = id
    while at > 0 && at < nodes.tree.len {
        if hook_of(at, kind) > 0 {
            return at
        }
        at = nodes.tree[at].parent
    }
    return 0
}

/// Drop `id`'s rows when the node is freed, so a recycled id never inherits them.
fn hook_forget(id: int) {
    let mut i = 0
    while i < hook_node.len {
        if hook_node[i] == id {
            let last = hook_node.len - 1
            hook_node[i] = hook_node[last]
            hook_kind[i] = hook_kind[last]
            hook_fn[i] = hook_fn[last]
            pop(hook_node)
            pop(hook_kind)
            pop(hook_fn)
        } else {
            i = i + 1
        }
    }
}

fn free_node(id: int) {
    if id <= 0 {
        return
    }
    if id >= nodes.tree.len {
        return
    }
    if int(nodes.tree[id].kind) == 0 {
        return
    }
    // Its ops sit inside its parent's run: re-record that run (the paint pass
    // splices it) rather than the frame. The freed id's own span is never read
    // again — whatever reuses the id is attached under a parent that
    // `mark_tree_at` marks, so its run is re-recorded with a fresh span.
    let par = nodes.tree[id].parent
    if par > 0 && par < nodes.tree.len && int(nodes.tree[par].kind) != 0 {
        mark_paint_id(par)
    }
    let n = nodes.tree[id].kids.len
    for i in 0..n {
        free_node(nodes.tree[id].kids[i])
    }
    if nodes.tree[id].list_fn > 0 {
        release_sigs(id)
        release_fns(id)
        key_clear(id)
    }
    if hook_node.len > 0 {
        hook_forget(id)
    }
    if secure_ids.len > 0 {
        secure_set(id, false)
    }
    style_forget(id)
    state_unwatch(id)
    own_release(id)
    if focus_id == id {
        focus_id = 0
    }
    if down_id == id {
        down_id = 0
    }
    if drag_id == id {
        drag_id = 0
        drag_bar = 0
    }
    if int(nodes.tree[id].kind) == 10 {
        if nodes.ui[id].edit_slot >= 0 {
            runtime.edit_reset(nodes.ui[id].edit_slot)
        }
    }
    if int(nodes.look[id].pulse) != 0 {
        if pulse_count > 0 {
            pulse_count = pulse_count - 1
        }
    }
    if int(nodes.look[id].spin) != 0 {
        if spin_count > 0 {
            spin_count = spin_count - 1
        }
    }
    bind_forget(id)
    host_forget(id)
    if nodes.tree[id].list_mode == 1 {
        poll_forget(id)
    }
    geo_forget(id)
    push(drop_pool, id)
    nodes.blank_at(id)
    push(free_nodes, id)
}

fn reset_tree() {
    nodes.reset()
    style_rows = []Style {}
    style_free = []int {}
    style_row_of = []int {}
    state_sig_of = []int {}
    state_mask_of = []int {}
    state_ids = []int {}
    owns_records = []int {}
    dirty_layout_nodes = []int {}
    layout_full = 1
    invalidate_all()
    paint_all = 1
    paint_spans_ok = 0
    dirty_chrome_nodes = []int {}
    bind_sig = []int {}
    bind_node = []int {}
    poll_hosts = []int {}
    host_queue = []int {}
    geo_on = []int {}
    geo_force = []int {}
    geo_w = []int {}
    geo_h = []int {}
    geo_sx = []int {}
    geo_sy = []int {}
    bnd_msg = []string {}
    trap_trim(0)
    exit_nodes = []int {}
    exit_until = []int {}
    exit_hide = []int {}
    exit_save = [][]int {}
    physics_ms = now_ms
    root_id = 0
    focus_id = 0
    trap_id = 0
    trap_restore = 0
    paint_sy = 0
    paint_sx = 0
    // drag_id / drag_bar survive the rebuild on purpose: an active scrollbar
    // or slider drag must keep working across per-frame tree resets (nodes
    // are recreated with recycled ids in the same order, so the grabbed node
    // keeps its id while the tree shape is stable). `input.drag` cancels the
    // drag when the node was recycled into a different kind.
    scope_node = 0
    rec_reset()
    free_nodes = []int {}
    drop_pool = []int {}
    key_reset()
    anim_reset()
    mark_tree()
}

let mut scroll_save: []int = []int {}
let mut scroll_save_x: []int = []int {}
/// Engine clock at the last `physics_step`, so scroll easing and coast scale by
/// the frame's real delta instead of assuming one 16 ms frame.
let mut physics_ms: int = 0

fn snapshot_scroll() {
    scroll_save = []int {}
    scroll_save_x = []int {}
    let n = nodes.tree.len
    for i in 0..n {
        push(scroll_save, nodes.scrl[i].scroll_y)
        push(scroll_save_x, nodes.scrl[i].scroll_x)
    }
}

fn restore_scroll() {
    let n = nodes.tree.len
    let m = scroll_save.len
    let mx = scroll_save_x.len
    for i in 1..n {
        if i < m {
            nodes.scrl[i].scroll_y = scroll_save[i]
        }
        if i < mx {
            nodes.scrl[i].scroll_x = scroll_save_x[i]
        }
    }
}

fn drop_children(id: int) {
    if id <= 0 {
        return
    }
    if id >= nodes.tree.len {
        return
    }
    let n = nodes.tree[id].kids.len
    for i in 0..n {
        free_node(nodes.tree[id].kids[i])
    }
    nodes.tree[id].kids = []int {}
    flush_drops()
    mark_tree_at(id)
}

/// One effect-table sweep for a whole batch of freed nodes, plus the animation
/// tracks they owned. `free_node` appends to `drop_pool`; this drains it.
fn flush_drops() {
    if drop_pool.len == 0 {
        return
    }
    track.free_nodes_effects(drop_pool)
    anim_free_pool(drop_pool)
    drop_pool = []int {}
}

/// Free `id` and its whole subtree, releasing the signals and interned handlers
/// each node in it *owns*. `free_node` recycles slots but leaves per-node
/// ownership to the enclosing rebuild scope; an incremental list removal has no
/// such scope, so this walks the subtree and releases as it goes.
fn free_subtree_walk(id: int) {
    if id <= 0 {
        return
    }
    if id >= nodes.tree.len {
        return
    }
    if int(nodes.tree[id].kind) == 0 {
        return
    }
    let n = nodes.tree[id].kids.len
    for i in 0..n {
        free_subtree_walk(nodes.tree[id].kids[i])
    }
    release_sigs(id)
    release_fns(id)
    key_clear(id)
    free_node(id)
}

fn free_subtree(id: int) {
    free_subtree_walk(id)
    if drop_defer == 0 {
        flush_drops()
    }
}

/* A list reconcile frees many rows in a row. Each flush sweeps the whole
   effect table, so freeing rows one flush at a time was quadratic: between
   `defer_drops_begin` and `defer_drops_end`, freed subtrees share one sweep.
   Only loops that free and build nothing in between use it, so no effect can
   run against a freed node before the sweep. */
let mut drop_defer: int = 0

fn defer_drops_begin() {
    drop_defer = drop_defer + 1
}

fn defer_drops_end() {
    if drop_defer > 0 {
        drop_defer = drop_defer - 1
    }
    if drop_defer == 0 {
        flush_drops()
    }
}

/// Release the signals and interned handlers every node in `id`'s subtree owns,
/// without freeing the nodes. An incremental reconcile adopts records onto each
/// row, so a host that later falls back to a full rebuild must hand those
/// records back before the rebuild drops the rows.
fn release_subtree(id: int) {
    if id <= 0 {
        return
    }
    if id >= nodes.tree.len {
        return
    }
    if int(nodes.tree[id].kind) == 0 {
        return
    }
    let n = nodes.tree[id].kids.len
    for i in 0..n {
        release_subtree(nodes.tree[id].kids[i])
    }
    release_sigs(id)
    release_fns(id)
}

fn release_children_ownership(id: int) {
    if id <= 0 {
        return
    }
    if id >= nodes.tree.len {
        return
    }
    let n = nodes.tree[id].kids.len
    for i in 0..n {
        release_subtree(nodes.tree[id].kids[i])
    }
}

// --- per-node structural operators -----------------------------------------
// Zeus effects are barred from touching structure, so these are the *only* way
// a single node moves in the tree. A list reconciles by calling them one move
// at a time — it does not re-run a build closure. Each keeps `kids` and the
// child's `parent` in sync and marks the tree, so the next layout sees the new
// shape. Insert / detach rebuild the parent's `kids` vec (O(siblings)); there is
// no in-place `insert` builtin to lean on, and the sibling count is small.

/// Detach `child` from whatever parent holds it, preserving sibling order.
/// Returns 1 when it was attached, 0 when it was already free.
fn child_detach(child: int) -> int {
    if child <= 0 {
        return 0
    }
    if child >= nodes.tree.len {
        return 0
    }
    let parent = nodes.tree[child].parent
    if parent <= 0 {
        return 0
    }
    if parent >= nodes.tree.len {
        nodes.tree[child].parent = 0
        return 0
    }
    let kids = nodes.tree[parent].kids
    let n = kids.len
    let mut found = 0
    for i in 0..n {
        if kids[i] == child {
            found = 1
        }
    }
    if found == 0 {
        nodes.tree[child].parent = 0
        return 0
    }
    let mut out = []int {}
    for i in 0..n {
        if kids[i] != child {
            push(out, kids[i])
        }
    }
    nodes.tree[parent].kids = out
    nodes.tree[child].parent = 0
    mark_tree_at(parent)
    return 1
}

/// Insert `child` under `parent` at `at` (clamped to `0..kids.len`). A node has
/// one parent, so any previous attachment is dropped first, which also makes
/// this a move within the same host. Returns 1 on success, 0 on a bad handle.
fn child_insert(parent: int, child: int, at: int) -> int {
    if parent <= 0 {
        return 0
    }
    if child <= 0 {
        return 0
    }
    if parent >= nodes.tree.len {
        return 0
    }
    if child >= nodes.tree.len {
        return 0
    }
    if parent == child {
        return 0
    }
    child_detach(child)
    let kids = nodes.tree[parent].kids
    let n = kids.len
    let mut i = at
    if i < 0 {
        i = 0
    }
    if i > n {
        i = n
    }
    let mut out = []int {}
    let mut j = 0
    while j < i {
        push(out, kids[j])
        j = j + 1
    }
    push(out, child)
    while j < n {
        push(out, kids[j])
        j = j + 1
    }
    nodes.tree[parent].kids = out
    nodes.tree[child].parent = parent
    mark_tree_at(parent)
    return 1
}

/// Move `child` to position `at` under its current parent. No-op unless
/// `parent` already holds `child`, so a caller cannot silently reparent.
fn child_move(parent: int, child: int, at: int) -> int {
    if parent <= 0 {
        return 0
    }
    if child <= 0 {
        return 0
    }
    if parent == child {
        return 0
    }
    if child >= nodes.tree.len {
        return 0
    }
    if nodes.tree[child].parent != parent {
        return 0
    }
    return child_insert(parent, child, at)
}

/// Start a host rebuild: free everything the host's previous build owned
/// (signals, interned handlers, children) and open a build scope owned by
/// `id`. Pair with `rebuild_end`. This is the only entry point that tears a
/// subtree down, so callers outside the core never touch `drop_children`.
fn rebuild_begin(id: int) -> int {
    let previous = scope_begin(id)
    release_sigs(id)
    release_fns(id)
    drop_children(id)
    return previous
}

fn rebuild_end(previous: int) {
    scope_end(previous)
}

/// Snapshot of the allocator for `zui.Boundary`: everything allocated after
/// this point can be discarded by `release`.
struct ArenaMark {
    nodes: int,
    sigs: int,
    free: int,
    rec: int,
    keys: int,
    scope: int,
    root: int,
    focus: int,
    down: int,
    drag: int,
    drag_bar: int,
}

fn mark() -> ArenaMark {
    return ArenaMark {
        nodes: nodes.tree.len, sigs: sigs.len, free: free_nodes.len,
        rec: rec_seq,
        keys: key_serial,
        scope: scope_node, root: root_id, focus: focus_id,
        down: down_id, drag: drag_id, drag_bar: drag_bar,
    }
}

/// Roll the arena back to `m`: free handlers recorded since the mark, drop
/// signals allocated since it, and trim every growable table. Nodes freed or
/// mutated before the mark are left alone — this recovers the tree, it does not
/// undo C-seam side effects.
fn release(m: ArenaMark) {
    // Handlers recorded since the mark are freed; signal records since it are
    // dropped here and their signals freed by the trim below.
    for slot in 0..r_kind.len {
        if r_kind[slot] >= 0 && r_seq[slot] > m.rec {
            if r_kind[slot] == 1 {
                runtime.intern_free(r_key[slot])
            }
            rec_drop(slot)
        }
    }
    let mut s = sigs.len
    while s > m.sigs {
        s = s - 1
        runtime.sig_free(s)
        forget_sig_meta(s)
        track.drop_sig(s)
        anim_drop_sig(s)
    }
    key_drop_after(m.keys)
    while sigs.len > m.sigs { pop(sigs) }
    while free_nodes.len > m.free { pop(free_nodes) }
    while nodes.tree.len > m.nodes { nodes.pop_slot() }
    anim_drop_above(m.nodes)
    scope_node = m.scope
    root_id = m.root
    focus_id = m.focus
    down_id = m.down
    drag_id = m.drag
    drag_bar = m.drag_bar
    drop_pool = []int {}
}

/// Discard a boundary host's partial subtree, then roll the arena back.
fn rollback(id: int, m: ArenaMark) {
    drop_children(id)
    release(m)
}

/* Direct layout readers: the nodes whose `show` predicate or bound number reads
   a signal straight from layout. A write queues just those nodes
   (`mark_sig_readers`) instead of the whole tree. Per signal, a list of slots
   (`lr_head` -> `lr_node` / `lr_next`), pruned of nodes that no longer read it
   whenever the list is walked. */
let mut lr_head: []int = []int {}
let mut lr_node: []int = []int {}
let mut lr_next: []int = []int {}
let mut lr_free: []int = []int {}

/// 1 when `node` still reads `signal_id` directly from layout.
fn lr_reads(node: int, signal_id: int) -> int {
    if node <= 0 || node >= nodes.tree.len {
        return 0
    }
    if int(nodes.tree[node].kind) == 0 {
        return 0
    }
    if nodes.tree[node].show_sig == signal_id || nodes.ui[node].bind_sig == signal_id {
        return 1
    }
    return 0
}

/// Record that `node` reads `signal_id` from layout (and flag the signal).
fn mark_sig_layout_node(signal_id: int, node: int) {
    mark_sig_layout(signal_id)
    if signal_id <= 0 || signal_id >= sigs.len || node <= 0 {
        return
    }
    while lr_head.len <= signal_id {
        push(lr_head, -1)
    }
    let mut s = lr_head[signal_id]
    while s >= 0 {
        if lr_node[s] == node {
            return
        }
        s = lr_next[s]
    }
    let mut slot = 0
    if lr_free.len > 0 {
        slot = lr_free[lr_free.len - 1]
        pop(lr_free)
    } else {
        slot = lr_node.len
        push(lr_node, 0)
        push(lr_next, -1)
    }
    lr_node[slot] = node
    lr_next[slot] = lr_head[signal_id]
    lr_head[signal_id] = slot
}

/// Queue every live direct reader of `signal_id` for layout, and its parent
/// for paint (a node that appears or disappears changes its parent's run).
/// Drops readers that are gone. Returns how many were queued; 0 means the
/// readers are unknown and the caller falls back to a frame-wide layout.
fn mark_sig_readers(signal_id: int) -> int {
    if signal_id <= 0 || signal_id >= lr_head.len {
        return 0
    }
    let mut n = 0
    let mut prev = -1
    let mut s = lr_head[signal_id]
    while s >= 0 {
        let next = lr_next[s]
        let node = lr_node[s]
        if lr_reads(node, signal_id) != 0 {
            queue_layout(node, 0)
            let p = nodes.tree[node].parent
            if p > 0 {
                mark_paint_id(p)
            }
            n = n + 1
            prev = s
        } else {
            if prev >= 0 {
                lr_next[prev] = next
            } else {
                lr_head[signal_id] = next
            }
            push(lr_free, s)
        }
        s = next
    }
    return n
}

/// Mark `signal_id` as layout-affecting: a later write re-runs the layout solve.
fn mark_sig_layout(signal_id: int) {
    if signal_id <= 0 {
        return
    }
    if signal_id >= sigs.len {
        return
    }
    while affects_layout.len <= signal_id {
        push(affects_layout, 0)
    }
    affects_layout[signal_id] = 1
}

/// Drop the flag when a signal slot is freed, so a recycled id does not carry
/// a stale layout mark onto an unrelated value.
fn forget_sig_meta(signal_id: int) {
    if signal_id <= 0 {
        return
    }
    if signal_id < affects_layout.len {
        affects_layout[signal_id] = 0
    }
    if signal_id < lr_head.len {
        let mut s = lr_head[signal_id]
        while s >= 0 {
            push(lr_free, s)
            s = lr_next[s]
        }
        lr_head[signal_id] = -1
    }
    host_forget_sig(signal_id)
}

// --- targeted invalidation (Phase 4) ---------------------------------------
//
// A write used to mark the whole frame. Now the prop setters (`apply_int` /
// `apply_str`) report the node they wrote and `store_sig` marks exactly those
// nodes when every effect the write ran reported one, so the damage pass scopes
// to them and a paint-only property skips layout entirely. Anything it cannot
// attribute — an effect that mutated arena state directly, or a signal layout
// reads with no effect in between — falls back to the frame-wide mark, so
// under-marking is impossible.
/// Prop-setter writes since the last read, and how many of them can move the
/// box model. `store_sig` compares the first with `track.runs`.
let mut prop_writes: int = 0
let mut prop_layout: int = 0

/// Report that a prop write landed on `node_id`; `layout` is 1 when the property
/// can move the box model. A paint-only write marks the node's PAINT bit so the
/// damage pass scopes to it; a layout write still marks layout whole-tree
/// (until phase 5).
fn note_prop_write(node_id: int, layout: int) {
    prop_writes = prop_writes + 1
    track.reports = track.reports + 1
    if layout != 0 {
        prop_layout = prop_layout + 1
        invalidate(node_id, INV.Layout)
    } else {
        invalidate(node_id, INV.Paint)
    }
}

// --- one invalidation channel (Phase 6) ------------------------------------
//
// Every visual update goes through `invalidate`: the prop effects (above), the
// interaction-state flags, and the bound-signal chrome all name a node and what
// changed. `INV.Chrome` is node-scoped, so the interaction overlay recomputes
// only the flagged nodes; a filter-wide chrome pass is reserved for the events
// that can move every hot target (pointer, scroll, layout, a tree change).
enum INV {
    // Repaint this node (and its subtree's damage).
    Paint = 1,
    // The box model can have moved: invalidate the measure path.
    Layout = 2,
    // Retarget this node's hover / press / tween / fade tracks.
    Chrome = 3,
}

fn invalidate(id: int, kind: int) {
    if kind == INV.Layout {
        mark_layout_path(id)
    } else if kind == INV.Chrome {
        mark_chrome_id(id)
        mark_paint_id(id)
    } else {
        mark_paint_id(id)
    }
}

/// Queue `id` for the interaction-state pass without forcing a full walk.
/// Deduped, so a node flagged twice in a frame syncs once.
fn mark_chrome_id(id: int) {
    if id <= 0 {
        return
    }
    if id >= nodes.tree.len {
        return
    }
    let n = dirty_chrome_nodes.len
    for i in 0..n {
        if dirty_chrome_nodes[i] == id {
            return
        }
    }
    push(dirty_chrome_nodes, id)
}

fn chrome_ids_len() -> int {
    return dirty_chrome_nodes.len
}

fn clear_chrome_ids() {
    dirty_chrome_nodes = []int {}
}

/// Record that `node_id` binds `sig_id`, so a write to `sig_id` can mark that
/// node's chrome. A switch's tween is read by the chrome pass, not an effect, so
/// without this a write would have to force a whole-frame chrome walk.
fn bind_chrome(sig_id: int, node_id: int) {
    if sig_id <= 0 {
        return
    }
    if node_id <= 0 {
        return
    }
    push(bind_sig, sig_id)
    push(bind_node, node_id)
}

/// Register `node_id` as a host that rebuilds from `sig_id`. A write to the
/// signal is then attributed to the host: its refresh hook runs that frame and
/// the rebuild marks the host for a scoped layout, instead of the write marking
/// the frame whole because nothing the tracker knows about consumed it.
fn bind_host(sig_id: int, node_id: int) {
    if sig_id <= 0 {
        return
    }
    if node_id <= 0 {
        return
    }
    let n = host_sig.len
    for i in 0..n {
        if host_sig[i] == sig_id {
            if host_node[i] == node_id {
                return
            }
        }
    }
    push(host_sig, sig_id)
    push(host_node, node_id)
}

/// A write to `sig_id` reached its bound hosts: request the host refresh pass,
/// where each host's hook sees the new generation and rebuilds — marking
/// itself, so the layout that follows is scoped to it. Returns how many hosts
/// are bound — 0 means no host consumes the signal. Nothing is queued for
/// layout here: the host has not changed yet, and queueing it would re-solve
/// its subtree once before the hook and once after.
fn hosts_for_signal(sig_id: int) -> int {
    let mut hits = 0
    let n = host_sig.len
    for i in 0..n {
        if host_sig[i] == sig_id {
            let nd = host_node[i]
            if nd > 0 {
                if nd < nodes.tree.len {
                    if nodes.tree[nd].list_fn > 0 {
                        hits = hits + 1
                        if nodes.tree[nd].list_mode == 2 {
                            nodes.tree[nd].list_mode = 4
                            push(host_queue, nd)
                        } else if nd < geo_force.len {
                            // A polled geometry host reads it too: run it.
                            geo_force[nd] = 1
                        }
                    }
                }
            }
        }
    }
    if hits > 0 {
        virtual_dirty = 1
    }
    return hits
}

// --- error boundaries at run time ---
// `Boundary` catches a trap in its own build directly (`runtime.boundary`). A trap
// later — in a click handler, a key handler, an effect — happens long after
// that build returned, so it is caught here instead: every handler / effect
// invocation goes through `invoke_on`, which runs it behind a trap arm when its
// node sits under a boundary. A caught trap records the message on the
// boundary host and queues the host's refresh hook, which rebuilds it with the
// fallback at the next refresh pass — never mid-handler, while the subtree that
// trapped may still be on the stack.

/// 1 once any boundary exists: until then `invoke_on` skips the parent walk.
let mut bnd_any: int = 0
/// Pending fallback message per boundary host id ("" = healthy).
let mut bnd_msg: []string = []string {}
/// Guarded work in flight, innermost last: a handler / effect / refresh hook
/// under a boundary (`trap_build` 0), or a boundary's own build (1, with the
/// arena mark it rolls back to). Native traps are caught in-process and never
/// need this; on wasm a trap unwinds the whole stack to the host, which calls
/// `recover_trap` to find the boundary that should take it.
let mut trap_host: []int = []int {}
let mut trap_build: []int = []int {}
let mut trap_marks: []ArenaMark = []ArenaMark {}
/// Build-order number of each frame's boundary (0 for a handler frame).
let mut trap_seqs: []int = []int {}

/// Boundaries are numbered in build order (`boundary_next_seq`). A wasm trap
/// during startup cannot be recovered in place — the build that was cut short
/// is the whole app — so the web loader re-instantiates the module and
/// pre-seeds the failed boundary's number and message in the C seam (module
/// globals are re-initialised when `main` starts); that boundary then builds
/// its fallback without running `build` at all (`boundary_preset_msg`).
let mut bnd_seq: int = 0
/// The build-order number of the boundary the last `recover_trap` failed in
/// its build (0 when the trap was in a handler / effect / refresh).
let mut last_trap_seq: int = 0

fn boundary_next_seq() -> int {
    bnd_seq = bnd_seq + 1
    return bnd_seq
}

/// The pre-seeded message for boundary `seq`, or "".
fn boundary_preset_msg(seq: int) -> string {
    return runtime.boundary_preset(seq)
}

/// Mark `id` as a boundary host. Its refresh hook (push-only) builds the
/// fallback when a run-time trap is recorded against it.
fn boundary_open(id: int) {
    if id <= 0 || id >= nodes.tree.len {
        return
    }
    nodes.tree[id].bnd = 1
    bnd_any = 1
    while bnd_msg.len <= id {
        push(bnd_msg, "")
    }
    bnd_msg[id] = ""
}

/// Record a run-time trap against boundary `host` and queue its refresh. The
/// first message wins until the fallback is built.
fn boundary_fail(host: int, msg: string) {
    if host <= 0 || host >= nodes.tree.len {
        return
    }
    if nodes.tree[host].bnd == 0 {
        return
    }
    while bnd_msg.len <= host {
        push(bnd_msg, "")
    }
    if bnd_msg[host].len > 0 {
        return
    }
    // A copy: `msg` may point at the runtime's static panic buffer.
    bnd_msg[host] = "{{msg}}"
    if nodes.tree[host].list_mode == 2 {
        nodes.tree[host].list_mode = 4
        push(host_queue, host)
    }
    virtual_dirty = 1
    paint_dirty = 1
}

/// Take (and clear) the pending fallback message of boundary `host`.
fn boundary_take(host: int) -> string {
    if host <= 0 || host >= bnd_msg.len {
        return ""
    }
    let m = bnd_msg[host]
    bnd_msg[host] = ""
    return m
}

/// Invoke handler / effect body `fid` on behalf of `node`. Under a boundary it
/// runs behind a trap arm; a trap fails the boundary and returns the message.
/// Elsewhere it is a plain call, and a trap aborts as it always has.
fn invoke_on(fid: int, node: int) -> string {
    if fid <= 0 {
        return ""
    }
    if bnd_any == 0 {
        runtime.invoke_fn(fid)
        return ""
    }
    let b = nodes.boundary_of(node)
    if b == 0 {
        runtime.invoke_fn(fid)
        return ""
    }
    let depth = trap_host.len
    push(trap_host, b)
    push(trap_build, 0)
    push(trap_marks, mark())
    push(trap_seqs, 0)
    let scope0 = scope_node
    let ui0 = ui_depth_hook()
    let tm = track.mark()
    let msg = runtime.guard_fn(fid)
    trap_trim(depth)
    if msg.len > 0 {
        // The trap skipped every pop the body would have done.
        scope_node = scope0
        ui_trim_hook(ui0)
        track.unwind(tm)
        boundary_fail(b, msg)
    }
    return msg
}

/// The component layer's build stack (`zeusbase.ui_parents`), which this module
/// cannot name: its depth, and a trim back to a depth. Installed by zeusbase
/// on its first `ui_push`.
let mut ui_depth_hook: fn() -> int = fn() -> int { return 0 }
let mut ui_trim_hook: fn(int) = fn(d: int) {}

fn set_ui_hooks(depth: fn() -> int, trim: fn(int)) {
    ui_depth_hook = depth
    ui_trim_hook = trim
}

/// A handler call site: run `fid` for `node` through the guard.
fn invoke_handler(fid: int, node: int) {
    invoke_on(fid, node)
}

fn trap_trim(depth: int) {
    while trap_host.len > depth {
        pop(trap_host)
        pop(trap_build)
        pop(trap_marks)
        pop(trap_seqs)
    }
}

/// Boundary number `seq`'s build is starting (`m` is its rollback mark). Pair
/// with `build_leave`.
fn build_enter(host: int, m: ArenaMark, seq: int) {
    push(trap_host, host)
    push(trap_build, 1)
    push(trap_marks, m)
    push(trap_seqs, seq)
}

fn build_leave() {
    if trap_host.len > 0 {
        trap_trim(trap_host.len - 1)
    }
}

/// A trap unwound the whole call stack to the host (wasm). Hand it to the
/// innermost boundary that was at work — rolling back its partial build if the
/// trap hit there — and reset the transient state every export starts from.
/// Returns 1 when a boundary took it, 0 when nothing could (the app is in an
/// unknown state and the host should stop).
fn recover_trap(msg: string) -> int {
    let mut ok = 0
    let n = trap_host.len
    last_trap_seq = 0
    if n > 0 {
        let host = trap_host[n - 1]
        if trap_build[n - 1] != 0 {
            last_trap_seq = trap_seqs[n - 1]
            rollback(host, trap_marks[n - 1])
        }
        boundary_fail(host, msg)
        ok = 1
    }
    trap_trim(0)
    scope_node = 0
    ui_trim_hook(0)
    track.unwind(track.mark_zero())
    mark_tree()
    return ok
}

// --- presence: exit transitions ---------------------------------------------
// A node that declares an exit transition is not freed the moment `Each`,
// `Match` or a lazy `Show` removes it. It is pinned (absolutely positioned at
// the box it last laid out in, so its siblings reflow at once), made inert
// (no hit testing, no keys), frozen (its effects are disposed: it shows its
// last state), and its exit track runs. When the transition's time is up,
// `exit_tick` detaches and frees it. A removal that the host does by full
// rebuild still frees at once.
let mut exit_nodes: []int = []int {}
let mut exit_until: []int = []int {}
// Parallel to `exit_nodes`: 1 for a hide-exit (`exit_or_hide`), and the state
// it puts back when the transition ends.
let mut exit_hide: []int = []int {}
let mut exit_save: [][]int = [][]int {}

/// Declare `id`'s exit transition (see `anim.exit_fx`).
fn set_exit(id: int, fx: int, arg: int, ms: int) {
    if id <= 0 || id >= nodes.tree.len {
        return
    }
    nodes.anim[id].exit_fx = fx
    nodes.anim[id].exit_arg = arg
    nodes.anim[id].exit_ms = ms
}

/// A control-flow host is removing child `id`. With no exit transition (or
/// under reduced motion, or before the first frame) it is freed now and this
/// returns 0. Otherwise it starts exiting and returns 1: the caller keeps it
/// among the host's children until `exit_tick` frees it.
fn exit_or_free(id: int) -> int {
    if id <= 0 || id >= nodes.tree.len {
        return 0
    }
    if nodes.tree[id].exiting != 0 {
        // Already leaving. A hide-exit becomes a removal: freed at the end.
        let n = exit_nodes.len
        for i in 0..n {
            if exit_nodes[i] == id {
                exit_hide[i] = 0
            }
        }
        return 1
    }
    let fx = nodes.anim[id].exit_fx
    if fx == 0 || anim_reduced() != 0 || anim_booted == 0 || nodes.anim[id].exit_ms <= 0 {
        free_subtree(id)
        return 0
    }
    exit_start(id, 0, []int {})
    return 1
}

/// Start `id`'s exit: pin it where it laid out, make it inert, and run its
/// exit track. `hide` 1 keeps it alive (its effects too): when the track ends
/// it is hidden and `save` (from `exit_snapshot`) is put back.
fn exit_start(id: int, hide: int, save: []int) {
    let fx = nodes.anim[id].exit_fx
    let parent = nodes.tree[id].parent
    if parent > 0 && parent < nodes.tree.len {
        // Pin where it is: siblings take its slot at once.
        let x = nodes.box[id].x - content_x(parent)
        let y = nodes.box[id].y - content_y(parent)
        nodes.pin[id].pos = u8(1)
        nodes.pin[id].pin_l = x
        nodes.pin[id].pin_t = y
        nodes.pin[id].pin_r = -1
        nodes.pin[id].pin_b = -1
        nodes.lay[id].explicit_width = nodes.box[id].w
        nodes.lay[id].explicit_height = nodes.box[id].h
    }
    nodes.tree[id].exiting = 1
    if focus_id > 0 && nodes.in_exiting(focus_id) != 0 {
        focus_id = 0
    }
    if hide == 0 {
        // Freeze: nothing inside may re-run against signals its host is about
        // to free.
        let mut ids = []int {}
        nodes.subtree_ids(id, &mut ids)
        track.free_nodes_effects(ids)
    }
    let ms = nodes.anim[id].exit_ms
    anim_opacity(id, 0, ms, ease_exit())
    if fx == 2 {
        anim_translate_y(id, nodes.anim[id].exit_arg, ms, ease_exit())
    } else if fx == 3 {
        anim_scale(id, nodes.anim[id].exit_arg, ms, ease_exit())
    }
    push(exit_nodes, id)
    push(exit_until, now_ms + ms)
    push(exit_hide, hide)
    push(exit_save, save)
    if parent > 0 {
        mark_tree_at(parent)
    }
}

/// What an exit changes on `id`: position, pins, explicit size, and the
/// paint tracks it animates.
fn exit_snapshot(id: int) -> []int {
    return []int {
        i32(nodes.pin[id].pos), nodes.pin[id].pin_l, nodes.pin[id].pin_t, nodes.pin[id].pin_r,
        nodes.pin[id].pin_b,
        nodes.lay[id].explicit_width, nodes.lay[id].explicit_height,
        int(nodes.look[id].opacity), int(nodes.anim[id].an_scale) / prop_unit(APROP.ScalePct),
        int(nodes.anim[id].an_ty) / prop_unit(APROP.XlateY),
    }
}

/// Put back what `exit_snapshot` saved; `id` stops exiting.
fn exit_restore(id: int, save: []int) {
    nodes.tree[id].exiting = 0
    if save.len < 10 {
        return
    }
    nodes.pin[id].pos = u8(save[0])
    nodes.pin[id].pin_l = save[1]
    nodes.pin[id].pin_t = save[2]
    nodes.pin[id].pin_r = save[3]
    nodes.pin[id].pin_b = save[4]
    nodes.lay[id].explicit_width = save[5]
    nodes.lay[id].explicit_height = save[6]
    anim_schedule(id, APROP.OpacityAmt, save[7], 0, 0)
    anim_schedule(id, APROP.ScalePct, save[8], 0, 0)
    anim_schedule(id, APROP.XlateY, save[9], 0, 0)
    let parent = nodes.tree[id].parent
    if parent > 0 && parent < nodes.tree.len {
        mark_tree_at(parent)
    }
}

/// A host is hiding (not removing) child `id` — a `MatchKeep` arm moving
/// out of view. With no exit transition (or under reduced motion, or before
/// the first frame) this returns 0 and the caller hides it now. Otherwise it
/// plays its exit pinned and inert, stays alive, and is hidden — its layout
/// and paint state put back — when the transition ends; returns 1.
fn exit_or_hide(id: int) -> int {
    if id <= 0 || id >= nodes.tree.len {
        return 0
    }
    if nodes.tree[id].exiting != 0 {
        return 1
    }
    if nodes.anim[id].exit_fx == 0 ||
        anim_reduced() != 0 ||
        anim_booted == 0 ||
        nodes.anim[id].exit_ms <= 0 {
        return 0
    }
    exit_start(id, 1, exit_snapshot(id))
    return 1
}

/// Stop a hide-exit started by `exit_or_hide` (the host shows `id` again
/// before its exit ended): it snaps back, shown. 0 if `id` was not hiding.
fn exit_cancel(id: int) -> int {
    let n = exit_nodes.len
    for i in 0..n {
        if exit_nodes[i] == id && exit_hide[i] != 0 {
            let save = exit_save[i]
            exit_drop_at(i)
            exit_restore(id, save)
            return 1
        }
    }
    return 0
}

/// Remove entry `at` from the exit lists.
fn exit_drop_at(at: int) {
    let mut kn = []int {}
    let mut kt = []int {}
    let mut kh = []int {}
    let mut ks = [][]int {}
    let n = exit_nodes.len
    for i in 0..n {
        if i != at {
            push(kn, exit_nodes[i])
            push(kt, exit_until[i])
            push(kh, exit_hide[i])
            push(ks, exit_save[i])
        }
    }
    exit_nodes = kn
    exit_until = kt
    exit_hide = kh
    exit_save = ks
}

/// Free every node whose exit transition has run its course. Called once per
/// frame, before layout.
fn exit_tick() {
    if exit_nodes.len == 0 {
        return
    }
    let mut keep_n = []int {}
    let mut keep_t = []int {}
    let mut keep_h = []int {}
    let mut keep_s = [][]int {}
    let n = exit_nodes.len
    let mut done = []int {}
    let mut hidden = []int {}
    let mut hidden_s = [][]int {}
    for i in 0..n {
        let id = exit_nodes[i]
        if id > 0 && id < nodes.tree.len && nodes.tree[id].exiting != 0 {
            if now_ms < exit_until[i] {
                push(keep_n, id)
                push(keep_t, exit_until[i])
                push(keep_h, exit_hide[i])
                push(keep_s, exit_save[i])
            } else if exit_hide[i] != 0 {
                push(hidden, id)
                push(hidden_s, exit_save[i])
            } else {
                push(done, id)
            }
        }
    }
    exit_nodes = keep_n
    exit_until = keep_t
    exit_hide = keep_h
    exit_save = keep_s
    // A hide-exit ends hidden, with its layout and paint state put back for
    // the next time it is shown.
    let hn = hidden.len
    for i in 0..hn {
        let id = hidden[i]
        nodes.tree[id].show_on = u8(0)
        exit_restore(id, hidden_s[i])
    }
    if hn > 0 {
        floater_gen = floater_gen + 1
    }
    let dn = done.len
    for i in 0..dn {
        let id = done[i]
        // A parent freed in this same pass already took it.
        if nodes.tree[id].exiting != 0 {
            let parent = nodes.tree[id].parent
            let host = nodes.tree[id].frag_of
            if host > 0 && host < nodes.tree.len {
                let fr = nodes.tree[host].frag
                let mut keep = []int {}
                let fn2 = fr.len
                for j in 0..fn2 {
                    if fr[j] != id {
                        push(keep, fr[j])
                    }
                }
                nodes.tree[host].frag = keep
            }
            child_detach(id)
            free_subtree(id)
            if parent > 0 && parent < nodes.tree.len {
                mark_tree_at(parent)
            }
        }
    }
}

/// Exits still playing (the host keeps frames coming until they end).
fn exit_live() -> int {
    return exit_nodes.len
}

// --- host refresh registry ---
// A host refresh hook (`list_fn`) used to be found by walking every arena node
// on every layout. Now each hook is reachable from one of two lists:
//
// * `poll_hosts` — hooks whose input is geometry (a refit's measured width, a
//   windowed list's scroll window, `on_resize`). They still run after every
//   layout / scroll, but the walk is O(those hosts), not O(nodes).
// * `host_queue` — push-only hosts (`host_push`: `Each`,
//   `Match`), whose only input is a bound signal. `hosts_for_signal` queues one
//   when that signal is written; an unwritten list is never visited.
let mut poll_hosts: []int = []int {}
let mut host_queue: []int = []int {}
/* Geometry hosts (`host_geo`): a polled hook whose only inputs are its own box,
   its own scroll offset and the signals bound to it (`bind_host`). Its hook
   runs only when one of those moved — the box / scroll last seen is kept per
   node — or a bound signal was written (`geo_force`). Indexed by node id;
   0 / -1 = not a geometry host / never seen. */
let mut geo_on: []int = []int {}
let mut geo_force: []int = []int {}
let mut geo_w: []int = []int {}
let mut geo_h: []int = []int {}
let mut geo_sx: []int = []int {}
let mut geo_sy: []int = []int {}
/// Polled hooks run, and geometry hooks skipped because nothing they read
/// moved (diagnostics).
let mut poll_runs: int = 0
let mut geo_skips: int = 0

/// Declare polled host `id` a geometry host (see `geo_on`): its hook reads
/// only its own box and scroll, and its bound signals. Call after `set_list_fn`.
fn host_geo(id: int) {
    if id <= 0 || id >= nodes.tree.len {
        return
    }
    while geo_on.len <= id {
        push(geo_on, 0)
        push(geo_force, 0)
        push(geo_w, -1)
        push(geo_h, -1)
        push(geo_sx, -1)
        push(geo_sy, -1)
    }
    if geo_on[id] != 0 {
        return
    }
    geo_on[id] = 1
    geo_force[id] = 1
}

fn geo_forget(id: int) {
    if id > 0 && id < geo_on.len {
        geo_on[id] = 0
        geo_force[id] = 0
        geo_w[id] = -1
        geo_h[id] = -1
        geo_sx[id] = -1
        geo_sy[id] = -1
    }
}

/// 1 when geometry host `id` must run its hook: forced, or its box or scroll
/// moved since it last ran. Records what it saw. Non-geometry hosts always run.
fn geo_due(id: int) -> int {
    if id >= geo_on.len {
        return 1
    }
    if geo_on[id] == 0 {
        return 1
    }
    let w = nodes.box[id].w
    let h = nodes.box[id].h
    let sx = nodes.scrl[id].scroll_x
    let sy = nodes.scrl[id].scroll_y
    if geo_force[id] == 0 &&
        geo_w[id] == w &&
        geo_h[id] == h &&
        geo_sx[id] == sx &&
        geo_sy[id] == sy {
        geo_skips = geo_skips + 1
        return 0
    }
    geo_force[id] = 0
    geo_w[id] = w
    geo_h[id] = h
    geo_sx[id] = sx
    geo_sy[id] = sy
    return 1
}

/// Install `fid` as `id`'s refresh hook. A host not marked push-only is
/// registered for polling the first time it gets a hook.
fn set_list_fn(id: int, fid: int) {
    if id <= 0 || id >= nodes.tree.len {
        return
    }
    nodes.tree[id].list_fn = fid
    if nodes.tree[id].list_mode == 0 {
        nodes.tree[id].list_mode = 1
        push(poll_hosts, id)
    }
}

/// Mark `id` as a push-only host: its hook runs only when a signal bound with
/// `bind_host` is written. Call before the hook is installed. The host must
/// build its initial content itself — no pass runs it until the first write.
fn host_push(id: int) {
    if id <= 0 || id >= nodes.tree.len {
        return
    }
    if nodes.tree[id].list_mode == 1 {
        poll_forget(id)
    }
    nodes.tree[id].list_mode = 2
}

fn poll_forget(id: int) {
    let mut i = 0
    while i < poll_hosts.len {
        if poll_hosts[i] == id {
            poll_hosts[i] = poll_hosts[poll_hosts.len - 1]
            pop(poll_hosts)
        } else {
            i = i + 1
        }
    }
}

/// Run the refresh hooks this frame needs: every polled host, then every
/// queued push host. A hook may write a signal that queues another host (or
/// rebuild a subtree holding new hosts), so the queue drains until empty; the
/// round cap only guards against two hosts writing each other's signal
/// forever.
fn refresh_hosts() {
    // Ids can go stale under a hook (a rebuild frees and recycles nodes), so
    // each entry is re-checked at the moment it runs, and duplicates (a
    // rolled-back id registered again) are skipped by flipping the mode while
    // the pass is on it.
    let polled = poll_hosts
    let mut live = []int {}
    let n = polled.len
    for i in 0..n {
        let id = polled[i]
        if id > 0 && id < nodes.tree.len {
            if nodes.tree[id].list_mode == 1 {
                nodes.tree[id].list_mode = 3
                push(live, id)
            }
        }
    }
    poll_hosts = live
    let ln = live.len
    for i in 0..ln {
        let id = live[i]
        if id < nodes.tree.len {
            if nodes.tree[id].list_mode == 3 {
                nodes.tree[id].list_mode = 1
                if nodes.tree[id].list_fn > 0 && geo_due(id) != 0 {
                    poll_runs = poll_runs + 1
                    invoke_hook(id)
                }
            }
        }
    }
    let mut rounds = 0
    while host_queue.len > 0 && rounds < 64 {
        let q = host_queue
        host_queue = []int {}
        let qn = q.len
        for i in 0..qn {
            let id = q[i]
            if id > 0 && id < nodes.tree.len {
                if nodes.tree[id].list_mode == 4 {
                    nodes.tree[id].list_mode = 2
                    if nodes.tree[id].list_fn > 0 {
                        invoke_hook(id)
                    }
                }
            }
        }
        rounds = rounds + 1
    }
}

/// Run host `id`'s refresh hook through the trap guard. A boundary host's own
/// hook (which builds its fallback) is guarded by the boundary *above* it, so a
/// trapping fallback fails the outer boundary instead of re-queuing itself.
fn invoke_hook(id: int) {
    let mut owner = id
    if nodes.tree[id].bnd != 0 {
        owner = nodes.tree[id].parent
    }
    invoke_on(nodes.tree[id].list_fn, owner)
}

/// Drop a freed node's host entries so a recycled id cannot be queued for an
/// unrelated signal.
fn host_forget(node_id: int) {
    let mut i = 0
    while i < host_node.len {
        if host_node[i] == node_id {
            let last = host_node.len - 1
            host_sig[i] = host_sig[last]
            host_node[i] = host_node[last]
            pop(host_sig)
            pop(host_node)
        } else {
            i = i + 1
        }
    }
}

/// Drop a freed signal's host entries so a recycled slot cannot queue a host
/// for a value it never read.
fn host_forget_sig(sig_id: int) {
    let mut i = 0
    while i < host_sig.len {
        if host_sig[i] == sig_id {
            let last = host_sig.len - 1
            host_sig[i] = host_sig[last]
            host_node[i] = host_node[last]
            pop(host_sig)
            pop(host_node)
        } else {
            i = i + 1
        }
    }
}

/// Drop a freed node's bind entry so a recycled id cannot be marked for an
/// unrelated signal.
fn bind_forget(node_id: int) {
    let mut i = 0
    while i < bind_node.len {
        if bind_node[i] == node_id {
            let last = bind_node.len - 1
            bind_sig[i] = bind_sig[last]
            bind_node[i] = bind_node[last]
            pop(bind_sig)
            pop(bind_node)
        } else {
            i = i + 1
        }
    }
}

/// Mark the chrome (and paint) of every node bound to `sig_id`. Returns how many
/// nodes were marked — 0 means the signal has no direct bound consumer.
fn chrome_for_signal(sig_id: int) -> int {
    let mut hits = 0
    let n = bind_sig.len
    for i in 0..n {
        if bind_sig[i] == sig_id {
            let nd = bind_node[i]
            if nd > 0 {
                if nd < nodes.tree.len {
                    if nodes.ui[nd].bind_sig == sig_id {
                        mark_chrome_id(nd)
                        mark_paint_id(nd)
                        hits = hits + 1
                    }
                }
            }
        }
    }
    return hits
}

fn store_sig(id: int, value: int) {
    if id <= 0 {
        return
    }
    if id >= sigs.len {
        return
    }
    if sigs[id] == value {
        return
    }
    if in_anim_tick != 0 {
        // Hard invariant: the animation tick writes paint values, never state.
        anim_signal_writes = anim_signal_writes + 1
        if anim_assert != 0 {
            panic("zeus: signal set from the animation tick")
        }
    }
    sigs[id] = value
    runtime.sig_bind_int(id, value)
    note_write(id)
}

/// The accounting every state write shares. `store_sig` reaches it after binding
/// an int; a value the C seam bound (a string, a struct, a list — anything but
/// `int`) reaches it from generated code, which calls this by name. Both therefore
/// decide targeted-vs-frame-wide the same way: a non-int prop write is as
/// surgical as an int one, instead of draining a whole-frame mark once per frame.
///
/// `notify` runs every dependent effect now, and a prop effect reports the node it
/// wrote. Count what ran and what reported to decide targeted vs frame-wide. The
/// shared chrome pass still runs: it retargets hover / press / tween / fade tracks
/// (a switch's tween or a scrollbar, none of which move the box model).
/// Signal writes `note_write` attributed to their own nodes, ever. A nested
/// write that was attributed lets the outer write count as attributed too.
let mut targeted_writes: int = 0
/// Hosts queued through a `computed` the write made stale (`Each(xs.get(), ...)`
/// binds its host to that computed, not to `xs`), counted by the memo hook.
let mut memo_host_hits: int = 0

fn note_write(id: int) {
    if track.batch_depth > 0 {
        // `notify` only schedules inside a `batch`: settle once the deferred
        // effects ran (`batch_end`).
        track.notify(id)
        let n = batch_sigs.len
        for i in 0..n {
            if batch_sigs[i] == id {
                // One settle covers every write of `id`: drop this one's `wrote`.
                track.consume_wrote()
                return
            }
        }
        push(batch_sigs, id)
        return
    }
    let ran0 = track.runs
    let pw0 = prop_writes
    let tw0 = targeted_writes
    let mh0 = memo_host_hits
    track.notify(id)
    let ran = track.runs - ran0
    // An effect that only forwarded the value to another signal whose own
    // write was attributed (`flag_int`, `Show`) is as surgical as a prop
    // write: count those writes with the prop writes.
    let pw = prop_writes - pw0 + targeted_writes - tw0
    settle_write(id, ran, pw, memo_host_hits - mh0)
}

/// Decide what a write that ran `ran` effects (`pw` of them reported a node)
/// leaves dirty. Every node an effect touched marked itself as it wrote — a
/// prop setter or a chaining setter run from an effect (`zeusbase.touched`),
/// a scroll, a structural operator — so an effect run that reported nothing
/// touched nothing: a pure side effect, a forward to a signal that did not
/// move, a `style` whose keys all held. That costs no dirt (it used to cost
/// a frame-wide paint, chrome and layout). What still falls back:
/// - a signal layout reads *directly*, with no effect in between: frame-wide
///   layout;
/// - a write nothing consumed — no effect, bound node or host: frame-wide
///   paint, and a `view` app rebuilds (its build may have read it untracked).
fn settle_write(id: int, ran: int, pw: int, memo_hits: int) {
    // A prop write marked its own path (`note_prop_write` -> `mark_layout_path`),
    // so its dirt is already recorded. Only a signal layout reads *directly* —
    // with no effect in between — needs a frame-wide layout mark here.
    let mut direct_layout = 0
    if id < affects_layout.len {
        if affects_layout[id] != 0 {
            direct_layout = 1
        }
    }
    // A bound node's tween / selection is read by the chrome pass, not an effect,
    // so mark those nodes' chrome directly. A host (Match / Each) reads
    // its signal from its refresh hook: ask the frame to run the hooks, and the
    // host that rebuilds marks itself.
    let bound = chrome_for_signal(id)
    let hosts = hosts_for_signal(id) + memo_hits
    if pw < ran {
        silent_runs = silent_runs + ran - pw
    }
    let mut targeted = 0
    if direct_layout != 0 {
        // Layout reads this signal itself: queue the nodes that read it, or
        // the whole tree when they are unknown. A `view` build may also have
        // read it, so it rebuilds as before.
        if mark_sig_readers(id) > 0 {
            targeted = 1
            mark_chrome()
        } else {
            mark_layout()
        }
        view_stale = 1
    } else if ran > 0 {
        targeted = 1
    } else if edit_commit > 0 {
        // A text field committing its buffer: the field marked itself, and a
        // `view` build that read the signal untracked still rebuilds.
        targeted = 1
        view_stale = 1
    } else if bound > 0 || hosts > 0 {
        // No effect consumed the write, but a bound node or a host did:
        // targeted too.
        targeted = 1
    }
    if targeted != 0 {
        targeted_writes = targeted_writes + 1
        // The node's own marks carry the dirt; drop this write's `wrote` so the
        // frame neither forces a layout nor walks every chrome target.
        track.consume_wrote()
    } else {
        frame_wide_writes = frame_wide_writes + 1
        if direct_layout == 0 {
            mark_paint()
        }
        mark_chrome()
        // Nothing reported the write, so a `view` build may have read it.
        view_stale = 1
    }
}

/// > 0 while a text field commits its buffer into its bound signal.
let mut edit_commit: int = 0

/// Signals written inside the open `batch`, settled by `batch_end`.
let mut batch_sigs: []int = []int {}

/// Close a `batch`: the outermost one runs every deferred effect once, then
/// settles each write it deferred. A batch runs its effects together, so a
/// write counts as consumed when anything still reads it.
fn batch_end() {
    if track.batch_depth != 1 {
        track.batch_end()
        return
    }
    let mh0 = memo_host_hits
    track.batch_end()
    let ids = batch_sigs
    batch_sigs = []int {}
    let n = ids.len
    for i in 0..n {
        let r = track.reader_count(ids[i])
        // Diagnostics only: a batch cannot say which run reported what.
        settle_write(ids[i], r, r, memo_host_hits - mh0)
    }
}

/// Effect runs that reported no node (and so, now, left no dirt), and writes
/// that still fell back to a frame-wide mark. Diagnostics: a patch test holds
/// the second at zero.
let mut silent_runs: int = 0
let mut frame_wide_writes: int = 0

/// A paint-only signal write: the value moved but nothing about the tree's
/// geometry did (scroll offsets, drag positions). Effects still run — one that
/// changes a layout prop marks layout itself, through `note_prop_write`.
fn store_sig_paint(id: int, value: int) {
    if id <= 0 {
        return
    }
    if id >= sigs.len {
        return
    }
    if sigs[id] == value {
        return
    }
    sigs[id] = value
    runtime.sig_bind_int(id, value)
    let ran0 = track.runs
    let pw0 = prop_writes
    let lay0 = prop_layout
    track.notify_paint(id)
    let ran = track.runs - ran0
    let pw = prop_writes - pw0
    let lay = prop_layout - lay0
    // A layout prop the effect wrote marked its own path; otherwise fall back to
    // a frame-wide paint mark when the effect could not be attributed.
    if ran == 0 || pw < ran {
        // Unattributed: a `view` build may have read it.
        view_stale = 1
        if lay == 0 {
            mark_paint()
        }
    }
}

// --- animation track pool (Phase 3) ---------------------------------------
//
// One fixed-capacity arena of tracks; every animation in the system is a row
// here. A track is plain data — no signal, no closure, no per-frame allocation.
// `anim_tick(dt_ms)` advances all active tracks from the host-supplied delta
// (read once per frame, not once per track) and writes the current value into
// the node's paint state, setting that node's PAINT bit. It never calls
// `store_sig`: no effect re-runs and no component rebuilds while an animation
// plays. A state change schedules or retargets a track once, then the graph is
// idle until the next state change.
//
// `sig_paint` is the one overlay: a `SigVal` track interpolates a signal's
// *paint* value while the signal's logical value (and so every effect bound to
// it) has already moved to the target. That is what lets `colors.animate` stop
// re-running effects per frame without changing its signature.

// Which paint value a track drives. All are paint-only, so a frame that only
// ticks tracks skips layout entirely. `SigVal` keys `sig_paint` by signal id
// instead of node id.
enum APROP {
    // Hover wash 0..100 (anim.hover_amt).
    HoverAmt = 1,
    // Press overlay 0..100 (anim.press_amt).
    PressAmt = 2,
    // Switch / checkbox thumb travel 0..100 (anim.tween).
    SwitchTween = 3,
    // Mounted-surface fade 0..100 (anim.show_amt).
    EnterFade = 4,
    // 5 was the scrollbar fade; the thumb shows and hides in one frame now.
    // Signal paint overlay (sig_paint[signal_id]).
    SigVal = 6,
    // Paint transform / appearance, all paint-only (no layout pass reads them):
    // scale percent (100 = identity).
    ScalePct = 7,
    // Translate in dp (x / y).
    XlateX = 8,
    XlateY = 9,
    // Rotation in degrees.
    RotDeg = 10,
    // Node opacity 0..100.
    OpacityAmt = 11,
    // Corner radius in dp.
    RadiusPx = 12,
    // Reveal share 0..100 (anim.an_reveal).
    RevealAmt = 13,
    // Selection indicator offset and width, in 1/16 dp.
    IndX = 14,
    IndW = 15,
}

let TRACK_CAP = 512

struct Track {
    node: int,
    prop: int,
    from: int,
    to: int,
    current_value: int,
    elapsed: int,
    dur: int,
    easing: int,
    state: int,
    /// Spring state, used when `easing` names a spring (`spring_of`): position
    /// and velocity in 1/256 of the track's unit, per second for the velocity.
    /// Kept apart from `current_value` so a retarget inherits the speed.
    pos: int,
    vel: int,
}

let mut tracks: []Track = []Track {}
let mut track_free: []int = []int {}
let mut anim_active: int = 0
let mut sig_paint: []int = []int {}
let mut sig_anim: []int = []int {}
let mut anim_booted: int = 0
let mut in_anim_tick: int = 0

// Layout-driving `colors.animate`: a signal write that lands on Width / Height /
// a pin is recorded here so the tick can tween the node field and reflow.
// Hover still skips layout; only these bindings mark it (same idea as
// `live_anchors`). Cap is fixed, no per-frame allocation.
const LAYOUT_ANIM_CAP: int = 64

struct LayoutAnim {
    node_id: int,
    setter: int,
    from: int,
    to: int,
    current_value: int,
    signal_id: int,
    live: int,
    done: int,
}

let mut layout_anims: []LayoutAnim = []LayoutAnim {}
let mut live_layout_anims: int = 0
let mut in_anim_bind: int = 0
let mut anim_bind_sid: int = 0
let mut layout_anim_moved: int = 0

fn anim_ensure() {
    if tracks.len != 0 {
        return
    }
    for i in 0..TRACK_CAP {
        push(tracks, Track {
            node: 0,
            prop: 0,
            from: 0,
            to: 0,
            current_value: 0,
            elapsed: 0,
            dur: 0,
            easing: 0,
            state: 0,
            pos: 0,
            vel: 0,
        })
    }
    let mut i = 0
    while i < TRACK_CAP {
        push(track_free, TRACK_CAP - 1 - i)
        i = i + 1
    }
}

// `enter_fx` flags: the motion a surface adds to its fade. Values of the
// `Enter` enum divided by 4 (Fade and Reveal have their own fields).
/// `anim.tween` before a switch's first observation.
const TWEEN_UNSET: int = -1
const ENTER_POP: int = 1
const ENTER_RISE: int = 2
const ENTER_DROP: int = 4

// Easing codes, kept in step with `zeus.EASE`. arena cannot import zeus (the
// dependency runs the other way), so the values are repeated here as the
// numbers the shaper matches on.
fn ease_linear() -> int { return 0 }
fn ease_standard() -> int { return 1 }
fn ease_emphasized() -> int { return 2 }
fn ease_spring() -> int { return 3 }
// The physical springs and the exit curve, in step with `zeus.EASE`.
fn ease_snap() -> int { return 4 }
fn ease_pop() -> int { return 5 }
fn ease_bounce() -> int { return 6 }
fn ease_glide() -> int { return 7 }
fn ease_exit() -> int { return 8 }
// Durations in ms, in step with `zeus.Motion`.
fn motion_fast() -> int { return 100 }
fn motion_base() -> int { return 170 }
fn motion_slow() -> int { return 270 }

/// `Style.transition` value naming an easing instead of a time: this plus an
/// `EASE` code (`Motion.Pop`, ...).
const MOTION_EASED: int = 100000
/// The time a `Motion.Fall` exit takes: the scrim's own exit, so a sheet
/// leaving on it is still painted when it lands.
const FALL_MS: int = 170

/// How long a surface takes to go: shorter than it took to arrive, because
/// what leaves has already been read.
const ENTER_FADE_MS: int = 120
const EXIT_FADE_MS: int = 130
/// The scrim outlasts the panel it hosts: paint stops at a hidden scrim, so a
/// shorter fade would cut the panel's exit off.
const SCRIM_FADE_MS: int = 170
/// Where a `Enter.Pop` surface starts and leaves from (percent).
const POP_FROM: int = 96
const POP_TO: int = 98
/// How far `Enter.Rise` / `Enter.Drop` travel on the way in, and on the way out.
const RISE_DP: int = 12
const SINK_DP: int = 6

// Spring constants for unit mass: stiffness in 1/s², damping in 1/s. A
// spring has no duration: it stops when it has stopped, and `dur` is ignored.
fn spring_k(easing: int) -> int {
    if easing == ease_snap() { return 900 }
    if easing == ease_pop() { return 520 }
    if easing == ease_bounce() { return 600 }
    return 380
}
fn spring_c(easing: int) -> int {
    if easing == ease_snap() { return 54 }
    if easing == ease_pop() { return 30 }
    if easing == ease_bounce() { return 26 }
    return 34
}
fn is_spring(easing: int) -> bool {
    return easing >= ease_snap() && easing <= ease_glide()
}

/// Integration step in ms. Small against the stiffest spring (k 900, period
/// about 200 ms), and whole frames of 60 and 120 Hz divide it evenly.
const SPRING_STEP: int = 4
/// At rest, in 1/256 of a track's unit: closer than the eye can tell (half a
/// percent or degree, 1/8 dp, 0.1% of a scale), and all but stopped.
fn spring_near(prop: int) -> int {
    if prop == APROP.ScalePct {
        return 256
    }
    if prop == APROP.XlateX || prop == APROP.XlateY || prop == APROP.IndX || prop == APROP.IndW {
        return 512
    }
    return 128
}
const SPRING_SLOW: int = 16

/// Sub-units a track runs in, for paint values that would stair-step in
/// whole units: a percent of a 440dp panel is more than 4dp a step.
fn prop_unit(prop: int) -> int {
    if prop == APROP.ScalePct {
        return 10
    }
    if prop == APROP.XlateX || prop == APROP.XlateY || prop == APROP.IndX || prop == APROP.IndW {
        return 16
    }
    return 1
}

/// Cubic Bézier component at parameter `u` (0..1000): P0 = 0, P3 = 1000,
/// P1 = `c1`, P2 = `c2` (all permille; `c1`/`c2` may exceed 1000 for Spring).
/// i64 intermediates: 3 · 1000³ · ~2000 overflows i32.
fn bezier_comp(u: int, c1: int, c2: int) -> int {
    let s = 1000 - u
    let uu = i64(u)
    let ss = i64(s)
    let a = i64(3) * ss * ss * uu * i64(c1)
    let b = i64(3) * ss * uu * uu * i64(c2)
    let c = uu * uu * uu * i64(1000)
    return i32((a + b + c) / i64(1000000000))
}

/// `y` of cubic-bezier(x1, y1, x2, y2) at linear time `t`. Control points
/// and `t`/`y` are permille. Binary-searches the parameter so x(u) ≈ t.
fn bezier_at(t: int, x1: int, y1: int, x2: int, y2: int) -> int {
    let mut lo = 0
    let mut hi = 1000
    let mut i = 0
    while i < 16 {
        let mid = (lo + hi) / 2
        if bezier_comp(mid, x1, x2) < t {
            lo = mid
        } else {
            hi = mid
        }
        i = i + 1
    }
    return bezier_comp(hi, y1, y2)
}

/// One integration step of `dt` ms (semi-implicit Euler, stable at these
/// stiffnesses). i64: k × 1000dp in 1/256 overflows i32.
fn spring_accel(easing: int, x: int, v: int, to: int) -> i64 {
    let k = i64(spring_k(easing))
    let c = i64(spring_c(easing))
    return (i64(to) - i64(x)) * k - i64(v) * c
}

/// A spring's response at permille `t` of a nominal 500 ms, for `anim_ease`
/// callers that drive a value themselves. Tracks integrate directly.
fn spring_shape(easing: int, t: int) -> int {
    let mut x = 0
    let mut v = 0
    let goal = 256000
    let steps = t * 500 / 1000 / SPRING_STEP
    let mut i = 0
    while i < steps {
        v = v + i32(spring_accel(easing, x, v, goal) * i64(SPRING_STEP) / i64(1000))
        x = x + v * SPRING_STEP / 1000
        i = i + 1
    }
    return x / 256
}

/// Shape a linear 0..1000 progress into an eased 0..1000 (Spring may overshoot
/// mid-curve; the settled frame is always 1000). The first four `EASE` tokens
/// are CSS cubic-béziers of the named curves they stood for as polynomials.
fn anim_ease(easing: int, t: int) -> int {
    if t <= 0 {
        return 0
    }
    if t >= 1000 {
        return 1000
    }
    if easing == ease_linear() {
        return t
    }
    if easing == ease_exit() {
        // cubic-bezier(0.40, 0.00, 1.00, 0.60) — ease-in: it speeds up as it goes
        return bezier_at(t, 400, 0, 1000, 600)
    }
    if is_spring(easing) {
        return spring_shape(easing, t)
    }
    if easing == ease_emphasized() {
        // cubic-bezier(0.23, 1.00, 0.32, 1.00) — ease-out quint
        return bezier_at(t, 230, 1000, 320, 1000)
    }
    if easing == ease_spring() {
        // cubic-bezier(0.34, 1.56, 0.64, 1.00) — ease-out-back
        return bezier_at(t, 340, 1560, 640, 1000)
    }
    // Standard: cubic-bezier(0.215, 0.61, 0.355, 1.00) — ease-out cubic
    return bezier_at(t, 215, 610, 355, 1000)
}

// Live tracks per key, so `anim_find` answers "none" without scanning the
// pool. The chrome pass schedules hover / press for every hot target on every
// layout frame, and almost none of them is animating. A `SigVal` track is keyed
// by signal id, every other prop by node id, so the two counts are kept apart.
let mut trk_node: []int = []int {}
let mut trk_sig: []int = []int {}

fn trk_inc(node: int, prop: int) {
    if node < 0 {
        return
    }
    if prop == APROP.SigVal {
        while trk_sig.len <= node {
            push(trk_sig, 0)
        }
        trk_sig[node] = trk_sig[node] + 1
    } else {
        while trk_node.len <= node {
            push(trk_node, 0)
        }
        trk_node[node] = trk_node[node] + 1
    }
}

fn trk_dec(node: int, prop: int) {
    if node < 0 {
        return
    }
    if prop == APROP.SigVal {
        if node < trk_sig.len && trk_sig[node] > 0 {
            trk_sig[node] = trk_sig[node] - 1
        }
    } else if node < trk_node.len && trk_node[node] > 0 {
        trk_node[node] = trk_node[node] - 1
    }
}

fn trk_live(node: int, prop: int) -> int {
    if node < 0 {
        return 0
    }
    if prop == APROP.SigVal {
        if node < trk_sig.len {
            return trk_sig[node]
        }
        return 0
    }
    if node < trk_node.len {
        return trk_node[node]
    }
    return 0
}

/// 1 while `id`'s hover wash has a live track.
fn hover_easing(id: int) -> int {
    if trk_live(id, APROP.HoverAmt) == 0 {
        return 0
    }
    if anim_find(id, APROP.HoverAmt) >= 0 {
        return 1
    }
    return 0
}

fn anim_find(node: int, prop: int) -> int {
    if trk_live(node, prop) == 0 {
        return -1
    }
    let mut i = 0
    while i < tracks.len {
        if tracks[i].state == 1 {
            if tracks[i].node == node {
                if tracks[i].prop == prop {
                    return i
                }
            }
        }
        i = i + 1
    }
    return -1
}

fn anim_alloc() -> int {
    if track_free.len == 0 {
        return -1
    }
    let slot = track_free[track_free.len - 1]
    pop(track_free)
    return slot
}

fn anim_clamp100(v: int) -> int {
    if v < 0 {
        return 0
    }
    if v > 100 {
        return 100
    }
    return v
}

/// Current paint value a track on (`node`, `prop`) is at.
fn anim_read(node: int, prop: int) -> int {
    if prop == APROP.HoverAmt {
        return int(nodes.anim[node].hover_amt)
    }
    if prop == APROP.PressAmt {
        return int(nodes.anim[node].press_amt)
    }
    if prop == APROP.SwitchTween {
        if nodes.anim[node].tween == TWEEN_UNSET {
            return 0
        }
        return nodes.anim[node].tween
    }
    if prop == APROP.EnterFade {
        return int(nodes.anim[node].show_amt)
    }
    if prop == APROP.SigVal {
        if node < sig_paint.len {
            return sig_paint[node]
        }
        return 0
    }
    if prop == APROP.ScalePct {
        return int(nodes.anim[node].an_scale)
    }
    if prop == APROP.XlateX {
        return int(nodes.anim[node].an_tx)
    }
    if prop == APROP.XlateY {
        return int(nodes.anim[node].an_ty)
    }
    if prop == APROP.RotDeg {
        return int(nodes.anim[node].an_rot)
    }
    if prop == APROP.OpacityAmt {
        return int(nodes.look[node].opacity)
    }
    if prop == APROP.RadiusPx {
        return int(nodes.look[node].radius)
    }
    if prop == APROP.RevealAmt {
        return int(nodes.anim[node].an_reveal)
    }
    if prop == APROP.IndX {
        return nodes.anim[node].ind_x
    }
    if prop == APROP.IndW {
        return nodes.anim[node].ind_w
    }
    return 0
}

/// Write a paint value (the track tick's only side effect on the tree).
fn anim_store(node: int, prop: int, v: int) {
    if prop == APROP.HoverAmt {
        nodes.anim[node].hover_amt = u8(anim_clamp100(v))
    } else if prop == APROP.PressAmt {
        nodes.anim[node].press_amt = u8(anim_clamp100(v))
    } else if prop == APROP.SwitchTween {
        // A spring dips below 0 on the way back; -1 stays the "unset" mark.
        nodes.anim[node].tween = if v == TWEEN_UNSET { 0 } else { v }
    } else if prop == APROP.EnterFade {
        nodes.anim[node].show_amt = u8(anim_clamp100(v))
    } else if prop == APROP.SigVal {
        sig_paint_fit()
        if node < sig_paint.len {
            sig_paint[node] = v
            if node < sigs.len {
                if v == sigs[node] {
                    sig_anim[node] = 0
                } else {
                    sig_anim[node] = 1
                }
            }
        }
    } else if prop == APROP.ScalePct {
        // Permille. A track passes through here at sub-unit precision.
        let mut s = v
        if s < 1 {
            s = 1
        }
        if s > 10000 {
            s = 10000
        }
        nodes.anim[node].an_scale = u16(s)
    } else if prop == APROP.XlateX {
        nodes.anim[node].an_tx = v
    } else if prop == APROP.XlateY {
        nodes.anim[node].an_ty = v
    } else if prop == APROP.RotDeg {
        let mut r = v % 360
        if r < 0 {
            r = r + 360
        }
        nodes.anim[node].an_rot = u16(r)
    } else if prop == APROP.OpacityAmt {
        nodes.look[node].opacity = i16(anim_clamp100(v))
    } else if prop == APROP.RadiusPx {
        let mut r = v
        if r < 0 {
            r = 0
        }
        nodes.look[node].radius = u16(r)
    } else if prop == APROP.RevealAmt {
        nodes.anim[node].an_reveal = u8(anim_clamp100(v))
    } else if prop == APROP.IndX {
        nodes.anim[node].ind_x = v
    } else if prop == APROP.IndW {
        nodes.anim[node].ind_w = v
    }
}

fn sig_paint_fit() {
    while sig_paint.len < sigs.len {
        push(sig_paint, 0)
        push(sig_anim, 0)
    }
}

fn anim_reduced() -> int {
    return reduced
}

/// Retarget or start a track toward `to`. Retargeting keeps the current value
/// as the new `from`, so an interrupted transition never pops or restarts.
/// Before the first frame, and under reduced motion, the final value is written
/// once instead.
///
/// A spring retarget keeps its velocity too: reversed mid-flight, the value
/// carries on, slows and comes back, like anything with mass. `dur` is ignored
/// for a spring, except that zero still jumps.
fn anim_schedule(node: int, prop: int, to_units: int, dur: int, easing: int) {
    // An empty ref (an effect's first run, before its element mounts).
    if node <= 0 {
        return
    }
    anim_ensure()
    let to = to_units * prop_unit(prop)
    let current_value = anim_read(node, prop)
    let i = anim_find(node, prop)
    // Jump instead of animating before the first frame completes (cold boot),
    // for a zero duration, or under reduced motion.
    let mut jump = 0
    if anim_booted == 0 {
        jump = 1
    }
    if dur <= 0 {
        jump = 1
    }
    if anim_reduced() != 0 {
        jump = 1
    }
    if jump != 0 {
        if i >= 0 {
            tracks[i].state = 0
            anim_active = anim_active - 1
            trk_dec(tracks[i].node, tracks[i].prop)
            push(track_free, i)
        }
        anim_store(node, prop, to)
        if prop == APROP.SigVal {
            if node < sig_anim.len {
                sig_anim[node] = 0
            }
        }
        mark_paint_id(node)
        return
    }
    if i >= 0 {
        if tracks[i].to == to {
            return
        }
        // A track already on a spring keeps its exact place and speed; anything
        // else starts the spring from where it was painted, at rest.
        if !is_spring(tracks[i].easing) || !is_spring(easing) {
            tracks[i].pos = current_value * 256
            tracks[i].vel = 0
        }
        tracks[i].from = current_value
        tracks[i].current_value = current_value
        tracks[i].to = to
        tracks[i].elapsed = 0
        tracks[i].dur = dur
        tracks[i].easing = easing
        return
    }
    if current_value == to {
        return
    }
    let slot = anim_alloc()
    if slot < 0 {
        anim_store(node, prop, to)
        mark_paint_id(node)
        return
    }
    tracks[slot].node = node
    tracks[slot].prop = prop
    tracks[slot].from = current_value
    tracks[slot].current_value = current_value
    tracks[slot].to = to
    tracks[slot].elapsed = 0
    tracks[slot].dur = dur
    tracks[slot].easing = easing
    tracks[slot].state = 1
    tracks[slot].pos = current_value * 256
    tracks[slot].vel = 0
    anim_active = anim_active + 1
    trk_inc(node, prop)
}

/// A paint transform: scale percent toward `to` (100 = identity).
fn anim_scale(node: int, to: int, ms: int, easing: int = 1) {
    anim_schedule(node, APROP.ScalePct, to, ms, easing)
}

fn anim_translate_x(node: int, to: int, ms: int, easing: int = 1) {
    anim_schedule(node, APROP.XlateX, to, ms, easing)
}

fn anim_translate_y(node: int, to: int, ms: int, easing: int = 1) {
    anim_schedule(node, APROP.XlateY, to, ms, easing)
}

fn anim_rotate(node: int, to: int, ms: int, easing: int = 1) {
    anim_schedule(node, APROP.RotDeg, to, ms, easing)
}

fn anim_opacity(node: int, to: int, ms: int, easing: int = 1) {
    anim_schedule(node, APROP.OpacityAmt, to, ms, easing)
}

fn anim_radius(node: int, to: int, ms: int) {
    anim_schedule(node, APROP.RadiusPx, to, ms, ease_standard())
}

fn anim_bind_begin(signal_id: int) {
    in_anim_bind = 1
    anim_bind_sid = signal_id
}

fn anim_bind_end() {
    in_anim_bind = 0
    anim_bind_sid = 0
}

fn anim_bind_on() -> int {
    return in_anim_bind
}

fn layout_anim_ensure() {
    if layout_anims.len != 0 {
        return
    }
    let mut i = 0
    while i < LAYOUT_ANIM_CAP {
        push(layout_anims, LayoutAnim {
            node_id: 0, setter: 0, from: 0, to: 0, current_value: 0, signal_id: 0, live: 0, done: 0,
        })
        i = i + 1
    }
}

/// Record a layout prop that an in-flight `animate` just wrote. Keeps the
/// node at `from` and tweens toward `to` on the signal's track. Returns 1
/// when the write was intercepted (caller must not apply `to` this frame).
fn layout_anim_push(node_id: int, setter: int, from: int, to: int) -> int {
    if in_anim_bind == 0 {
        return 0
    }
    if from == to {
        return 0
    }
    layout_anim_ensure()
    let signal_id = anim_bind_sid
    let mut i = 0
    while i < layout_anims.len {
        if layout_anims[i].live != 0 {
            if layout_anims[i].node_id == node_id {
                if layout_anims[i].setter == setter {
                    layout_anims[i].from = layout_anims[i].current_value
                    layout_anims[i].to = to
                    layout_anims[i].signal_id = signal_id
                    layout_anims[i].done = 0
                    return 1
                }
            }
        }
        i = i + 1
    }
    i = 0
    while i < layout_anims.len {
        if layout_anims[i].live == 0 {
            layout_anims[i].node_id = node_id
            layout_anims[i].setter = setter
            layout_anims[i].from = from
            layout_anims[i].to = to
            layout_anims[i].current_value = from
            layout_anims[i].signal_id = signal_id
            layout_anims[i].live = 1
            layout_anims[i].done = 0
            live_layout_anims = live_layout_anims + 1
            return 1
        }
        i = i + 1
    }
    return 0
}

fn layout_anim_advance(signal_id: int, shaped: int) {
    if live_layout_anims == 0 {
        return
    }
    let mut i = 0
    while i < layout_anims.len {
        if layout_anims[i].live != 0 {
            if layout_anims[i].signal_id == signal_id {
                let a = layout_anims[i]
                let mut current_value = a.from + (a.to - a.from) * shaped / 1000
                let mut done = 0
                if shaped >= 1000 {
                    current_value = a.to
                    done = 1
                }
                layout_anims[i].current_value = current_value
                layout_anims[i].done = done
                layout_anim_moved = 1
                mark_layout()
            }
        }
        i = i + 1
    }
}

fn layout_anim_len() -> int {
    return layout_anims.len
}

fn layout_anim_get(i: int) -> LayoutAnim {
    return layout_anims[i]
}

fn layout_anim_reap() {
    let mut i = 0
    while i < layout_anims.len {
        if layout_anims[i].live != 0 {
            if layout_anims[i].done != 0 {
                layout_anims[i].live = 0
                live_layout_anims = live_layout_anims - 1
            }
        }
        i = i + 1
    }
}

fn take_layout_anim_moved() -> int {
    let v = layout_anim_moved
    layout_anim_moved = 0
    return v
}

fn live_layout_anims_count() -> int {
    return live_layout_anims
}

/// `colors.animate`: move a signal's *state* to `to` once (effects run once),
/// then interpolate its paint value on the track pool. A layout prop that
/// the same write lands on (width / height / a pin) stays at `from` and
/// tweens toward `to` on this track, reflowing each frame until it lands.
fn anim_signal(signal_id: int, to: int, ms: int) {
    if signal_id <= 0 {
        return
    }
    if signal_id >= sigs.len {
        return
    }
    let from = sig_val(signal_id)
    let mut jump = 0
    if anim_booted == 0 {
        jump = 1
    }
    if ms <= 0 {
        jump = 1
    }
    if anim_reduced() != 0 {
        jump = 1
    }
    if jump == 0 {
        anim_bind_begin(signal_id)
    }
    store_sig(signal_id, to)
    anim_bind_end()
    if from == to {
        return
    }
    sig_paint_fit()
    if signal_id < sig_paint.len {
        sig_paint[signal_id] = from
        sig_anim[signal_id] = 1
    }
    anim_schedule(signal_id, APROP.SigVal, to, ms, ease_standard())
    // Pool full or a jump inside `anim_schedule`: land layout props now.
    if anim_find(signal_id, APROP.SigVal) < 0 {
        layout_anim_advance(signal_id, 1000)
    }
}

/// 1 while any track is active (keeps the frame loop alive).
fn anim_live() -> int {
    return anim_active
}

fn anim_live_count() -> int {
    return anim_active
}

/// Advance every active track by `delta_ms` ms. Returns 1 when any track ran this
/// frame (including the frame a track settles on, so its final value is drawn).
fn anim_tick(delta_ms: int) -> int {
    anim_ensure()
    if anim_active == 0 {
        return 0
    }
    in_anim_tick = 1
    let mut i = 0
    while i < tracks.len {
        if tracks[i].state == 1 {
            let a = tracks[i]
            let mut dur = a.dur
            if dur <= 0 {
                dur = 1
            }
            let e = a.elapsed + delta_ms
            let is_sig = a.prop == APROP.SigVal
            if is_spring(a.easing) {
                spring_tick(i, a, delta_ms, is_sig)
            } else if e >= dur {
                tracks[i].current_value = a.to
                tracks[i].elapsed = dur
                tracks[i].state = 0
                anim_active = anim_active - 1
                trk_dec(tracks[i].node, tracks[i].prop)
                push(track_free, i)
                anim_store(a.node, a.prop, a.to)
                if is_sig {
                    layout_anim_advance(a.node, 1000)
                }
            } else {
                tracks[i].elapsed = e
                let shaped = anim_ease(a.easing, e * 1000 / dur)
                tracks[i].current_value = a.from + (a.to - a.from) * shaped / 1000
                anim_store(a.node, a.prop, tracks[i].current_value)
                if is_sig {
                    layout_anim_advance(a.node, shaped)
                }
            }
            if is_sig {
                mark_paint()
            } else {
                mark_paint_id(a.node)
            }
        }
        i = i + 1
    }
    in_anim_tick = 0
    return 1
}

/// Advance spring track `i` by `delta_ms`. `elapsed` carries the part of a
/// frame too short for a step, so 7 ms and 16 ms frames trace the same curve.
fn spring_tick(i: int, a: Track, delta_ms: int, is_sig: bool) {
    let goal = a.to * 256
    let mut x = a.pos
    let mut v = a.vel
    let mut budget = a.elapsed + delta_ms
    let near = spring_near(a.prop)
    let mut done = 0
    while done == 0 && budget >= SPRING_STEP {
        budget = budget - SPRING_STEP
        v = v + i32(spring_accel(a.easing, x, v, goal) * i64(SPRING_STEP) / i64(1000))
        x = x + v * SPRING_STEP / 1000
        let d = if x > goal { x - goal } else { goal - x }
        let sp = if v > 0 { v } else { 0 - v }
        if d < near && sp < near * SPRING_SLOW {
            done = 1
        }
    }
    if done != 0 {
        tracks[i].current_value = a.to
        tracks[i].pos = goal
        tracks[i].vel = 0
        tracks[i].state = 0
        anim_active = anim_active - 1
        trk_dec(a.node, a.prop)
        push(track_free, i)
        anim_store(a.node, a.prop, a.to)
        if is_sig {
            layout_anim_advance(a.node, 1000)
        }
        return
    }
    tracks[i].elapsed = budget
    tracks[i].pos = x
    tracks[i].vel = v
    let cur = if x >= 0 { (x + 128) / 256 } else { 0 - (128 - x) / 256 }
    tracks[i].current_value = cur
    anim_store(a.node, a.prop, cur)
    if is_sig {
        let span = a.to - a.from
        let shaped = if span != 0 {
            i32(i64(cur - a.from) * i64(1000) / i64(span))
        } else {
            1000
        }
        // Overshoot stays on the paint overlay: a layout prop never over-reaches.
        layout_anim_advance(a.node, if shaped >= 1000 { 999 } else { shaped })
    }
}

/// Drop tracks owned by a batched set of freed nodes (one sweep per subtree).
fn anim_free_pool(ids: []int) {
    if ids.len == 0 {
        return
    }
    let mut i = 0
    while i < tracks.len {
        if tracks[i].state == 1 {
            if tracks[i].prop != APROP.SigVal {
                if member(tracks[i].node, ids) != 0 {
                    tracks[i].state = 0
                    anim_active = anim_active - 1
                    trk_dec(tracks[i].node, tracks[i].prop)
                    push(track_free, i)
                }
            }
        }
        i = i + 1
    }
    i = 0
    while i < layout_anims.len {
        if layout_anims[i].live != 0 {
            if member(layout_anims[i].node_id, ids) != 0 {
                layout_anims[i].live = 0
                live_layout_anims = live_layout_anims - 1
            }
        }
        i = i + 1
    }
}

/// Drop the paint overlay for a signal that is being freed.
fn anim_drop_sig(signal_id: int) {
    if signal_id <= 0 {
        return
    }
    if signal_id < sig_anim.len {
        sig_anim[signal_id] = 0
        sig_paint[signal_id] = 0
    }
    let mut i = 0
    while i < tracks.len {
        if tracks[i].state == 1 {
            if tracks[i].prop == APROP.SigVal {
                if tracks[i].node == signal_id {
                    tracks[i].state = 0
                    anim_active = anim_active - 1
                    trk_dec(tracks[i].node, tracks[i].prop)
                    push(track_free, i)
                }
            }
        }
        i = i + 1
    }
}

/// Drop tracks for nodes at or above `n` (Boundary rollback trims the arena).
fn anim_drop_above(n: int) {
    let mut i = 0
    while i < tracks.len {
        if tracks[i].state == 1 {
            if tracks[i].prop != APROP.SigVal {
                if tracks[i].node >= n {
                    tracks[i].state = 0
                    anim_active = anim_active - 1
                    trk_dec(tracks[i].node, tracks[i].prop)
                    push(track_free, i)
                }
            }
        }
        i = i + 1
    }
}

/// Reset all tracks (view-mode rebuild drops the whole tree). Buffers are
/// reused, not dropped, so a per-frame rebuild does not reallocate them.
fn anim_reset() {
    anim_ensure()
    let mut i = 0
    while i < tracks.len {
        tracks[i].state = 0
        i = i + 1
    }
    for k in 0..trk_node.len {
        trk_node[k] = 0
    }
    for k in 0..trk_sig.len {
        trk_sig[k] = 0
    }
    while track_free.len > 0 {
        pop(track_free)
    }
    i = 0
    while i < TRACK_CAP {
        push(track_free, TRACK_CAP - 1 - i)
        i = i + 1
    }
    anim_active = 0
    while sig_paint.len > 0 {
        pop(sig_paint)
    }
    while sig_anim.len > 0 {
        pop(sig_anim)
    }
    while dirty_paint.len > 0 {
        pop(dirty_paint)
    }
    in_anim_tick = 0
}

/// The child of `id` a selection of `index` lands on, or 0. An `Each` puts its
/// rows here too, after its hidden marker, so the marker does not count.
fn ind_target(id: int, index: int) -> int {
    if index < 0 {
        return 0
    }
    let mut at = 0
    let n = nodes.tree[id].kids.len
    for i in 0..n {
        let c = nodes.tree[id].kids[i]
        if nodes.tree[c].frag_of != -1 && nodes.tree[c].exiting == 0 {
            if at == index {
                return c
            }
            at = at + 1
        }
    }
    return 0
}

/// Point the indicator at the selected child. A new selection travels on a
/// spring; a resize or a reflow follows at once, because nothing was chosen.
fn indicator_sync(id: int) {
    let sel = sig_val(nodes.anim[id].ind_sig)
    let t = ind_target(id, sel)
    if t <= 0 || nodes.box[t].w <= 0 {
        return
    }
    let x = nodes.box[t].x - nodes.box[id].x
    let w = nodes.box[t].w
    let seen = nodes.anim[id].ind_at
    let travel = (seen >= 0 && seen != sel) || anim_find(id, APROP.IndX) >= 0
    nodes.anim[id].ind_at = sel
    let ms = if travel { motion_fast() } else { 0 }
    anim_schedule(id, APROP.IndX, x, ms, ease_snap())
    anim_schedule(id, APROP.IndW, w, ms, ease_snap())
}

/// A surface with entrance motion is about to appear from nothing: put it
/// where it starts. Jumped, because it is not on screen yet.
fn enter_motion_begin(id: int) {
    let fx = int(nodes.anim[id].enter_fx)
    if fx == 0 || anim_reduced() != 0 {
        return
    }
    if (fx & ENTER_POP) != 0 {
        anim_schedule(id, APROP.ScalePct, POP_FROM, 0, 0)
    }
    if (fx & ENTER_RISE) != 0 {
        anim_schedule(id, APROP.XlateY, RISE_DP, 0, 0)
    }
    if (fx & ENTER_DROP) != 0 {
        anim_schedule(id, APROP.XlateY, 0 - RISE_DP, 0, 0)
    }
}

/// Spring to rest. From a closing surface this reverses with whatever speed
/// it had.
fn enter_motion_settle(id: int) {
    let fx = int(nodes.anim[id].enter_fx)
    if fx == 0 {
        return
    }
    if (fx & ENTER_POP) != 0 {
        anim_schedule(id, APROP.ScalePct, 100, motion_base(), ease_pop())
    }
    if (fx & (ENTER_RISE | ENTER_DROP)) != 0 {
        anim_schedule(id, APROP.XlateY, 0, motion_base(), ease_pop())
    }
}

/// Fall away while the fade runs, speeding up. A short way: it is already
/// going, and the eye has moved on.
fn enter_motion_leave(id: int) {
    let fx = int(nodes.anim[id].enter_fx)
    // A surface that never came, or is already gone, has nowhere to leave from.
    if fx == 0 || int(nodes.anim[id].show_amt) == 0 {
        return
    }
    if (fx & ENTER_POP) != 0 {
        anim_schedule(id, APROP.ScalePct, POP_TO, EXIT_FADE_MS, ease_exit())
    }
    if (fx & ENTER_RISE) != 0 {
        anim_schedule(id, APROP.XlateY, SINK_DP, EXIT_FADE_MS, ease_exit())
    }
    if (fx & ENTER_DROP) != 0 {
        anim_schedule(id, APROP.XlateY, 0 - SINK_DP, EXIT_FADE_MS, ease_exit())
    }
}

// Reused across passes so a full chrome pass writes into a buffer that keeps
// its capacity instead of allocating an id vector every frame.
let mut chrome_scan: []int = []int {}

/// Recompute one frame's chrome targets from discrete state and schedule the
/// tracks. Event-driven (pointer, signal, show change), never the per-frame
/// paint path.
/// Full pass: pointer motion, a scroll, a layout change or a tree change can
/// move every hot target, so every node is re-synced.
fn sync_chrome_all() {
    update_ptr_cover()
    let n = nodes.tree.len
    while chrome_scan.len > 0 {
        pop(chrome_scan)
    }
    for i in 1..n {
        push(chrome_scan, i)
    }
    sync_chrome_scan()
}

/// Re-sync only the flagged nodes: `invalidate(id, INV.Chrome)` queues a node
/// whose own state changed, and a write queues the nodes bound to its signal.
fn sync_chrome_targeted() {
    while chrome_scan.len > 0 {
        pop(chrome_scan)
    }
    let m = dirty_chrome_nodes.len
    for j in 0..m {
        push(chrome_scan, dirty_chrome_nodes[j])
    }
    dirty_chrome_nodes = []int {}
    sync_chrome_scan()
}

fn sync_chrome_scan() {
    let n = chrome_scan.len
    for j in 0..n {
        let i = chrome_scan[j]
        if i <= 0 {
            continue
        }
        if i >= nodes.tree.len {
            continue
        }
        if int(nodes.tree[i].kind) == 0 {
            continue
        }
        chrome_sync_count = chrome_sync_count + 1
        if is_hot(i) != 0 {
            let mut over = 0
            if ptr_in(i) != 0 {
                over = 100
            }
            // Arrives at once, lingers on the way out: a surface warms under
            // the pointer and cools after it.
            anim_schedule(
                i,
                APROP.HoverAmt,
                over,
                if over != 0 { motion_fast() } else { motion_slow() },
                ease_standard(),
            )
        }
        if int(nodes.anim[i].press) != 0 {
            let mut target_value = 0
            if down_id == i {
                target_value = 100
            }
            anim_schedule(
                i,
                APROP.PressAmt,
                target_value,
                if target_value != 0 { motion_fast() } else { motion_base() },
                ease_standard(),
            )
            if int(nodes.anim[i].press_scale) != 0 {
                // Opt-in only. Feedback, not a flourish: down and back on one
                // firm spring, with no rebound.
                if down_id == i {
                    anim_schedule(i, APROP.ScalePct, PRESS_SCALE, motion_fast(), ease_snap())
                } else {
                    anim_schedule(i, APROP.ScalePct, 100, motion_fast(), ease_snap())
                }
            }
        }
        let k = int(nodes.tree[i].kind)
        if k == 7 {
            let mut target_value = 0
            if bind_pct(i) > 0 {
                target_value = 100
            }
            if nodes.anim[i].tween == TWEEN_UNSET {
                nodes.anim[i].tween = target_value
            } else {
                anim_schedule(i, APROP.SwitchTween, target_value, motion_fast(), ease_snap())
            }
        }
        if k == 8 {
            let mut target_value = 0
            if sig_val(nodes.ui[i].bind_sig) != 0 {
                target_value = 100
            }
            if nodes.anim[i].tween < 0 {
                nodes.anim[i].tween = target_value
            } else {
                anim_schedule(i, APROP.SwitchTween, target_value, motion_fast(), ease_standard())
            }
        }
        if int(nodes.anim[i].ind_kind) != 0 {
            indicator_sync(i)
        }
        if int(nodes.anim[i].enter_fade) != 0 {
            // Shown means shown on screen: a Dialog panel is hidden by its
            // scrim's signal, not its own, so the walk up is what makes it
            // fade on every open (and out on every close), not just the first.
            let w = shown_in_tree(i)
            if int(nodes.anim[i].enter_fade) == 1 {
                // First observation after a build: settle. Cold boot writes the
                // final value and nothing animates (audit §10).
                if w != 0 {
                    nodes.anim[i].show_amt = u8(100)
                } else {
                    nodes.anim[i].show_amt = u8(0)
                }
                nodes.anim[i].enter_fade = u8(2)
            } else if w != 0 {
                let scrim = int(nodes.tree[i].kind) == 9
                if int(nodes.anim[i].show_amt) == 0 {
                    enter_motion_begin(i)
                }
                enter_motion_settle(i)
                anim_schedule(
                    i,
                    APROP.EnterFade,
                    100,
                    if scrim { SCRIM_FADE_MS } else { ENTER_FADE_MS },
                    ease_standard(),
                )
            } else if nodes.is_floater(i) != 0 || want_show(i) != 0 {
                // Exit: fade out. Paint keeps the node while `show_amt` > 0
                // (`want_paint`); the tree predicates already say hidden, so it
                // is inert. An in-flow node hidden by its *own* signal snaps
                // instead: layout collapsed it this frame, and a fade painted
                // over the neighbour that moved into its rect would look wrong.
                let scrim = int(nodes.tree[i].kind) == 9
                enter_motion_leave(i)
                anim_schedule(
                    i,
                    APROP.EnterFade,
                    0,
                    if scrim { SCRIM_FADE_MS } else { EXIT_FADE_MS },
                    ease_exit(),
                )
            } else {
                nodes.anim[i].show_amt = u8(0)
            }
        }
        if int(nodes.anim[i].reveal) != 0 {
            // Same shape as the fade: settle on first sight, then reveal on
            // show. Hidden snaps to 0 so the next open starts from the top;
            // there is no reveal-out, because layout has already collapsed an
            // in-flow node by the time paint could animate it.
            let w = shown_in_tree(i)
            if int(nodes.anim[i].reveal) == 1 {
                if w != 0 {
                    nodes.anim[i].an_reveal = u8(100)
                } else {
                    nodes.anim[i].an_reveal = u8(0)
                }
                nodes.anim[i].reveal = u8(2)
            } else if w != 0 {
                anim_schedule(i, APROP.RevealAmt, 100, motion_fast(), ease_glide())
            } else {
                nodes.anim[i].an_reveal = u8(0)
            }
        }
    }
}

fn mark_paint_id(id: int) {
    paint_dirty = 1
    if id <= 0 {
        return
    }
    if id >= nodes.tree.len {
        return
    }
    if (int(nodes.tree[id].dirty) & 1) != 0 {
        return
    }
    nodes.tree[id].dirty = u8(int(nodes.tree[id].dirty) | 1)
    push(dirty_paint, id)
    // Mark the ancestors too: paint uses the bit to tell a subtree that has to be
    // re-recorded from one whose retained draw ops can be reused as-is. Ancestor
    // marking is what makes a deep mark cost O(depth) instead of O(subtree).
    mark_descendants_of(id)
}

/// Record that node `id` has a paint-marked descendant, for `id` and every
/// ancestor. Deduped per node, so marking many siblings of one parent walks the
/// shared path once.
fn mark_descendants_of(id: int) {
    let mut p = id
    let mut guard = 0
    while p > 0 && guard < 512 {
        if p >= nodes.tree.len {
            return
        }
        p = nodes.tree[p].parent
        if p <= 0 {
            return
        }
        if p >= nodes.tree.len {
            return
        }
        if (int(nodes.tree[p].dirty) & 8) != 0 {
            return
        }
        nodes.tree[p].dirty = u8(int(nodes.tree[p].dirty) | 8)
        push(dirty_desc, p)
        guard = guard + 1
    }
}

// --- frame damage list (Phase 1) -------------------------------------------
// The window-space rects a frame must repaint, consumed by the rasterizer to
// rasterize only the tiles they touch, and by the blit to present only their
// region. One frame's worth is accumulated between frame boundaries:
// `damage_frame_begin` forgets the last frame, structural passes call
// `damage_all`, and paint adds a rect for every node it visits inside a
// paint-dirty subtree. Expansion is deliberately generous — a rect that is too
// small leaves a visible trail, one that is too large only costs fill rate.

/// Analytic AA coverage reaches one device pixel past a shape's edge.
const AA_BLEED: int = 1

struct Damage {
    x: int,
    y: int,
    w: int,
    h: int,
}

let mut damage: []Damage = []Damage {}
/// 1 = repaint the whole surface (layout, tree rebuild, resize, or an unknown
/// global change). Wins over the per-node rects.
let mut damage_full: int = 0
/// > 0 while paint is inside a paint-dirty subtree; every node painted then
/// contributes its rect, so a dirty container damages its descendants too.
let mut damage_cap: int = 0
/// 1 = a frame is open (its damage is being accumulated). Set on the first of
/// layout / paint in a frame, cleared when paint has presented it.
let mut damage_open: int = 0

/// Begin a frame's damage. Called by both `engine_layout` and `engine_paint`,
/// so a paint-only frame damages correctly and a layout-then-paint frame does
/// not reset the layout's `damage_all` between the two.
fn damage_frame_begin() {
    if damage_open != 0 {
        return
    }
    damage_open = 1
    while damage.len > 0 {
        pop(damage)
    }
    damage_full = 0
    damage_cap = 0
}

/// The frame has been presented; the next frame starts fresh. The list is left
/// readable until then so a consumer (rasterizer / blit / test) can inspect it.
fn damage_frame_end() {
    damage_open = 0
}

/// Repaint everything. The safe answer whenever geometry could have moved, or a
/// change is not known to be local.
fn damage_all() {
    damage_full = 1
}

fn damage_add(x: int, y: int, w: int, h: int) {
    if w <= 0 {
        return
    }
    if h <= 0 {
        return
    }
    push(damage, Damage { x: x, y: y, w: w, h: h })
}

/// How far a node's paint can reach past its box: its resolved shadow (blur
/// plus offset), any paint-transform travel, and AA bleed. Painting never
/// changes layout, so all of this is read from the node as it stands.
fn damage_node_pad(id: int) -> int {
    let mut p = AA_BLEED
    // The higher of the resting level and the hover lift: a lifted card's
    // shadow reaches further than its resting one.
    let mut e = int(nodes.look[id].elev)
    if int(nodes.look[id].lift) > e {
        e = int(nodes.look[id].lift)
    }
    if e > 0 {
        p = p + elev_reach(elev_now(e))
    }
    // Sub-dp units; rounded out, and one more for the part of a dp painted.
    let tx = int(nodes.anim[id].an_tx)
    let ty = int(nodes.anim[id].an_ty)
    if tx < 0 {
        p = p + (15 - tx) / 16
    } else {
        p = p + (tx + 15) / 16
    }
    if ty < 0 {
        p = p + (15 - ty) / 16
    } else {
        p = p + (ty + 15) / 16
    }
    // A scale above 100% grows the box. Measured whole, because the origin
    // may sit on an edge rather than at the centre.
    let sc = int(nodes.anim[id].an_scale)
    if sc > 1000 {
        let gx = nodes.box[id].w * (sc - 1000) / 1000 + 1
        let gy = nodes.box[id].h * (sc - 1000) / 1000 + 1
        if gx > p {
            p = gx
        }
        if gy > p {
            p = gy
        }
    }
    return p
}

/// Paint-time capture. `x`/`y` are the node's window-space draw origin — the
/// same numbers the draw list records — and `w`/`h` its box. Called for every
/// node paint visits; only nodes inside a dirty subtree are recorded.
fn damage_visit(id: int, x: int, y: int, w: int, h: int) {
    if damage_cap <= 0 {
        return
    }
    // A full repaint already covers every rect; recording them too would just
    // grow the buffer (16 B per damaged node) for nothing.
    if damage_full != 0 {
        return
    }
    let p = damage_node_pad(id)
    damage_add(x - p, y - p, w + 2 * p, h + 2 * p)
}

/// 1 while nothing at all has been recorded for this frame. Paint uses this to
/// fall back to a full repaint when something dirty was marked without a node.
fn damage_empty() -> int {
    if damage_full != 0 {
        return 0
    }
    if damage.len != 0 {
        return 0
    }
    return 1
}

fn mark_chrome() {
    chrome_dirty = 1
}

/// Mark a node's skeleton shimmer alive so the frame loop keeps running while
/// it is visible (the case that reaches `paint_alpha`).
fn note_pulse(id: int) {
    if id <= 0 {
        return
    }
    if id >= nodes.tree.len {
        return
    }
    if int(nodes.look[id].pulse) == 0 {
        pulse_count = pulse_count + 1
    }
    nodes.look[id].pulse = u8(1)
    mark_paint()
}

/// Shimmer phase 0..1000 for a pulsing node: a 1.6 s left-to-right sweep
/// on the frame clock, offset per node so a stack does not move in lockstep.
/// Reduced motion parks it a third of the way in.
const SHIMMER_MS: int = 1600

fn shimmer_phase(id: int) -> int {
    if reduced != 0 {
        return 333
    }
    return ((now_ms + nodes.tree[id].node_id * 120) % SHIMMER_MS) * 1000 / SHIMMER_MS
}

fn pulse_live() -> int {
    if reduced != 0 {
        return 0
    }
    if pulse_count > 0 {
        return 1
    }
    return 0
}

/// Mark a node's spinner alive: paint rotates it from the frame clock, and the
/// frame loop keeps running while it is visible. Reduced motion stops it.
fn note_spin(id: int, period: int) {
    if id <= 0 {
        return
    }
    if id >= nodes.tree.len {
        return
    }
    if int(nodes.look[id].spin) == 0 {
        spin_count = spin_count + 1
    }
    nodes.look[id].spin = u8(1)
    let mut d = period
    if d < 60 {
        d = 60
    }
    if d > 65535 {
        d = 65535
    }
    nodes.look[id].spin_ms = u16(d)
    mark_paint()
}

/// Undo `note_spin`: the node stops keeping the frame loop alive.
fn clear_spin(id: int) {
    if id <= 0 {
        return
    }
    if id >= nodes.tree.len {
        return
    }
    if int(nodes.look[id].spin) != 0 {
        if spin_count > 0 {
            spin_count = spin_count - 1
        }
    }
    nodes.look[id].spin = u8(0)
    mark_paint()
}

/// Tween a bound signal's *paint* value from `from` to its current state
/// over `ms`, without writing the signal. `Progress` uses it so a plain
/// `value.set(80)` eases instead of jumping; an in-flight tween retargets
/// from where it is.
fn anim_paint_from(signal_id: int, from: int, ms: int) {
    if signal_id <= 0 {
        return
    }
    if signal_id >= sigs.len {
        return
    }
    let to = sigs[signal_id]
    let mut jump = 0
    if anim_booted == 0 {
        jump = 1
    }
    if ms <= 0 {
        jump = 1
    }
    if anim_reduced() != 0 {
        jump = 1
    }
    if jump != 0 {
        return
    }
    sig_paint_fit()
    if signal_id >= sig_paint.len {
        return
    }
    let mut f = from
    if sig_anim[signal_id] != 0 {
        f = sig_paint[signal_id]
    }
    if f == to {
        return
    }
    sig_paint[signal_id] = f
    sig_anim[signal_id] = 1
    anim_schedule(signal_id, APROP.SigVal, to, ms, ease_glide())
}

fn spin_live() -> int {
    if reduced != 0 {
        return 0
    }
    if spin_count > 0 {
        return 1
    }
    return 0
}

/// A frame-wide paint mark: the caller cannot attribute the change to nodes, so
/// the pass re-records every op (and the retained spans are not reused).
fn mark_paint() {
    paint_dirty = 1
    paint_all = 1
}

/// A paint mark that *is* attributable: the nodes carry the dirt, so a frame
/// whose only dirt came through `mark_paint_id` / `invalidate` may re-record just
/// the marked subtrees and reuse the rest of the retained draw list.
fn mark_paint_targeted() {
    paint_dirty = 1
}

/// Can this frame's paint reuse the retained draw ops outside the marked
/// subtrees? Needs a targeted mark (not a frame-wide one) and spans that still
/// describe the retained list.
fn paint_can_patch() -> int {
    if paint_all != 0 {
        return 0
    }
    if paint_spans_ok == 0 {
        return 0
    }
    return 1
}

/// The paint pass records spans over the list it just built; from then on they
/// describe the retained list.
fn note_paint_spans() {
    paint_spans_ok = 1
}

/// Invalidate every cached measure. Called by the coarse layout events (a
/// structural change, a resize, a theme / scale change) — a re-measure after
/// this recomputes the whole tree.
fn invalidate_all() {
    measure_gen = measure_gen + 1
}

/// Record that a layout prop landed on `id`. Invalidates the path from `id` to
/// the root (so a re-measure recomputes it) without forcing a whole-tree
/// re-solve; `engine_layout` may then re-solve only `id`'s size-stable ancestor.
fn mark_layout_path(id: int) {
    queue_layout(id, 0)
}

/// Queue `id` for `layout.relayout`. `structural` is 1 for a change *under*
/// the node (its kid list moved) and 0 for a prop write *on* it. The queue
/// records the difference by sign — a structural entry is `-id` — because a
/// prop write can change how the parent sizes the node itself (`w_pct`,
/// `align_self`, a margin), so only a structural entry may resolve to the node
/// as its own boundary. Queued once per frame: a host that attaches a thousand
/// rows marks itself a thousand times, and `relayout` should see it once. A
/// prop write on an already-queued structural entry demotes it.
fn queue_layout(id: int, structural: int) {
    layout_dirty = 1
    floater_gen = floater_gen + 1
    if id <= 0 {
        return
    }
    if id >= nodes.tree.len {
        return
    }
    // Queued once per frame: `layout.relayout` only needs to know that the
    // frame's dirt names nodes, not which kind each entry is.
    if (int(nodes.tree[id].dirty) & 2) != 0 {
        return
    }
    nodes.tree[id].dirty = u8(int(nodes.tree[id].dirty) | 2)
    // The change landed on this node, so it carries the paint dirt too: a frame
    // that reuses retained ops outside the marked subtrees must re-record this
    // one rather than wait for the layout pass to mark it.
    mark_paint_id(id)
    nodes.invalidate_path(id)
    if structural != 0 {
        push(dirty_layout_nodes, 0 - id)
    } else {
        push(dirty_layout_nodes, id)
    }
}

/// A structural change under `id`: a child attached, detached or dropped, or
/// the kid list reordered. Scoped like a layout-prop write — the path to the
/// root is invalidated and `id` is queued for `layout.relayout`, which finds
/// the nearest box the change cannot have moved — rather than marking the
/// whole tree. Inside a host rebuild every attach under the host collapses
/// onto the host: it is the unit of change, and it is queued once.
fn mark_tree_at(id: int) {
    tree_dirty = 1
    // The node whose kid list moved re-records its run (spliced into the
    // retained list), so a new child is painted and a dropped one is not,
    // without a full record.
    mark_paint_id(id)
    // Hover / press targets may have moved with the structure.
    chrome_dirty = 1
    let mut at = id
    if scope_node > 0 {
        let mut p = id
        let mut guard = 0
        while p > 0 && p < nodes.tree.len {
            if p == scope_node {
                at = scope_node
                break
            }
            p = nodes.tree[p].parent
            guard = guard + 1
            if guard > 256 {
                break
            }
        }
    }
    if at <= 0 || at >= nodes.tree.len {
        mark_tree()
        return
    }
    queue_layout(at, 1)
}

/// Scroll moved: repaint now, and let the virtual-list window pass run.
fn mark_scroll() {
    paint_dirty = 1
    virtual_dirty = 1
    // An open popup is anchored to its trigger's *screen* rect, so a scroll
    // moves it. Re-place just the floaters (`layout.replace_anchored`) rather
    // than re-solve the tree: nothing else can have changed size.
    if live_anchors != 0 {
        anchors_dirty = 1
    }
}

/// A scroller's offset changed: the global scroll flags plus the scroller's own
/// PAINT bit. Marking the node is what makes damage capture cover its clipped
/// rect and everything it paints, so a scroll repaints locally instead of
/// needing a full-surface fallback (and cannot be masked by another node's
/// dirty mark).
fn mark_scroll_node(id: int) {
    mark_scroll()
    mark_paint_id(id)
}

fn mark_layout() {
    layout_dirty = 1
    floater_gen = floater_gen + 1
    paint_dirty = 1
    // A whole-tree re-solve can move any node, so paint cannot reuse anything.
    paint_all = 1
    invalidate_all()
    layout_full = 1
}

fn mark_tree() {
    tree_dirty = 1
    view_stale = 1
    layout_dirty = 1
    floater_gen = floater_gen + 1
    paint_dirty = 1
    chrome_dirty = 1
    invalidate_all()
    layout_full = 1
    paint_all = 1
    paint_spans_ok = 0
}

/// 1 when this frame's layout must re-solve the whole tree. Read and cleared by
/// `engine_layout`; `mark_layout` / `mark_tree` / a resize set it.
fn take_layout_full() -> int {
    let f = layout_full
    layout_full = 0
    return f
}

/// The nodes a layout prop landed on since the last call, copied and cleared.
/// `engine_layout` hands them to `layout.relayout`.
fn take_dirty_layout_nodes() -> []int {
    let out = dirty_layout_nodes
    dirty_layout_nodes = []int {}
    let n = out.len
    for i in 0..n {
        let mut id = out[i]
        if id < 0 {
            id = 0 - id
        }
        if id > 0 {
            if id < nodes.tree.len {
                nodes.tree[id].dirty = u8(int(nodes.tree[id].dirty) & 253)
            }
        }
    }
    return out
}

/// Drain the PAINT marks at the end of a paint pass. The buffer is popped, not
/// dropped, so a steady animation allocates nothing frame to frame.
fn clear_dirty() {
    let n = dirty_paint.len
    for i in 0..n {
        let id = dirty_paint[i]
        if id > 0 {
            if id < nodes.tree.len {
                nodes.tree[id].dirty = u8(int(nodes.tree[id].dirty) & 254)
            }
        }
    }
    while dirty_paint.len > 0 {
        pop(dirty_paint)
    }
    let m = dirty_desc.len
    for i in 0..m {
        let id = dirty_desc[i]
        if id > 0 {
            if id < nodes.tree.len {
                nodes.tree[id].dirty = u8(int(nodes.tree[id].dirty) & 247)
            }
        }
    }
    while dirty_desc.len > 0 {
        pop(dirty_desc)
    }
    paint_dirty = 0
    paint_all = 0
    tree_dirty = 0
}

fn alloc_node(kind: int) -> int {
    ensure()
    // No mark here: a node has no effect on the tree until it is attached, and
    // the attach (`zeusbase.child`, `child_insert`) marks the parent. A recycled
    // id's stale draw-op span is never read: the parent's paint mark stops the
    // patch walk above it, and the run it re-records writes the node a fresh
    // span.
    if free_nodes.len > 0 {
        let id = free_nodes[free_nodes.len - 1]
        pop(free_nodes)
        nodes.blank_at(id)
        nodes.tree[id].kind = u8(kind)
        nodes.tree[id].node_id = id
        return id
    }
    // Hard ceiling (Phase 2): refuse to grow past `node_cap`. Loud, once, and
    // non-fatal — the alternative (silent growth) is the failure mode this
    // guards. A caller that must build more virtualizes with `each` / `show`,
    // or raises the cap on purpose.
    if nodes.tree.len >= node_cap {
        if node_overflow == 0 {
            fmt.println(
                "zeus: node arena exhausted at",
                node_cap,
                "nodes — virtualize the list (Each / VirtualList) or raise node_cap",
            )
        }
        node_overflow = 1
        return 0
    }
    let id = nodes.tree.len
    nodes.push_blank()
    nodes.tree[id].kind = u8(kind)
    nodes.tree[id].node_id = id
    return id
}

/// Lower or raise the node cap. Test hook and deliberate tuning; 0 is ignored
/// so a stray call cannot lock the arena shut.
fn set_node_cap(n: int) {
    if n > 0 {
        node_cap = n
    }
}

fn node_cap_get() -> int {
    return node_cap
}

fn node_overflow_get() -> int {
    return node_overflow
}

// --- Phase 0 memory instrumentation (arena side) ---------------------------
// `__sizeof(x)` is a compile-time size for x's type and does not evaluate x, so
// the strides below are safe even when a vector is empty.

/// 1 when the host says arena stats are on (`-DZEUS_MEM_STATS` or env).
fn mem_stats_on() -> int {
    return runtime.mem_stats()
}

/// Bytes held by the signal table.
fn mem_sig_bytes() -> i64 {
    return i64(sigs.len) * i64(__sizeof(nodes.ui[0].bind_sig))
}

/// Bytes held by the rebuild-scope / keyed-`Each` interning tables.
fn mem_intern_bytes() -> i64 {
    let sz = i64(__sizeof(nodes.tree[0].node_id))
    let ssz = i64(__sizeof(nodes.look[0].text))
    let ints = r_key.len * 6 + sig_rec.len + fn_rec.len + own_node.len + own_eff.len + own_tok.len +
        kt_used.len * 7 + key_head.len * 2
    return i64(ints) * sz + i64(kt_key.len) * ssz
}

/// Bytes held by the animation tables (tracks, their free list, and the paint
/// / layout anim side lists).
fn mem_anim_bytes() -> i64 {
    let sz = i64(__sizeof(nodes.tree[0].node_id))
    let ints = track_free.len + sig_paint.len + sig_anim.len
    let a = i64(tracks.len) * i64(__sizeof(tracks[0]))
    let b = i64(layout_anims.len) * i64(__sizeof(layout_anims[0]))
    return a + b + i64(ints) * sz
}

/// Bytes held by the remaining small arena vectors: theme slots, focus chains,
/// scroll snapshots, floater stacks, dirty lists, and free lists. Phase 2 splits
/// these between the persistent and scratch arenas; Phase 0 only measures them.
fn mem_misc_bytes() -> i64 {
    let sz = i64(__sizeof(nodes.tree[0].node_id))
    let mut ints = theme_l.len + theme_d.len + size_buffer.len + size_layout.len
    ints = ints + chain_nodes.len + chain_ctxs.len + focus_ring.len
    ints = ints + free_nodes.len + drop_pool.len + dirty_paint.len
    ints = ints + floater_id.len + floater_z.len + floater_screen_x.len + floater_screen_y.len
    ints = ints + scroll_save.len + scroll_save_x.len
    return i64(ints) * sz + i64(damage.len) * i64(__sizeof(damage[0]))
}

/// Arena bytes across every bucket above (the draw list lives in `scene`; the
/// software rasterizer's atlas and image cache report through `std:zeusraster`).
fn mem_total_bytes() -> i64 {
    return nodes.mem_tree_bytes() + mem_sig_bytes() + mem_intern_bytes() + mem_anim_bytes() +
        mem_misc_bytes()
}

/// Update the high-water marks. Called once per layout while stats are on.
fn mem_sample() {
    mem_frames = mem_frames + 1
    let ln = nodes.mem_live_nodes()
    if ln > mem_peak_nodes {
        mem_peak_nodes = ln
    }
    let b = mem_total_bytes()
    if b > mem_peak_bytes {
        mem_peak_bytes = b
    }
}

/// Print the arena side of the Phase 0 report. The caller prints the draw list
/// and the host footprint. One line per bucket so `docs/mem-baseline.md` can
/// quote it verbatim.
fn mem_report() {
    fmt.println(
        "ZEUS_MEM live_nodes=",
        nodes.mem_live_nodes(),
        " node_slots=",
        nodes.tree.len,
        " frames=",
        mem_frames,
    )
    fmt.println(
        "ZEUS_MEM bytes tree=",
        nodes.mem_tree_bytes(),
        " signals=",
        mem_sig_bytes(),
        " interning=",
        mem_intern_bytes(),
        " animation=",
        mem_anim_bytes(),
        " misc=",
        mem_misc_bytes(),
    )
    fmt.println("ZEUS_MEM bytes total=", mem_total_bytes())
    fmt.println("ZEUS_MEM peak_nodes=", mem_peak_nodes, " peak_bytes=", mem_peak_bytes)
    fmt.println("ZEUS_MEM node_record_bytes=", nodes.node_record_bytes())
}

// --- app ---

fn theme_grow(slot: int) {
    if slot < 0 {
        return
    }
    let need = slot + 1
    if need <= theme_l.len {
        return
    }
    let n = need - theme_l.len
    for i in 0..n {
        push(theme_l, 0)
        push(theme_d, 0)
    }
}

// --- scoped theme and density ----------------------------------------------
// The role colors and the density knob are app-wide signals. A node can
// override either for its subtree: `scheme` (light / dark) is resolved at
// paint time — the painter enters each node's effective scheme — and the
// density signal is resolved by `density_at` from the node being built or the
// node whose style effect is running. Both are skipped entirely (one int test)
// until some node sets an override.

/// 1 once any node has set `scheme`; 1 once any has set `dens_sid`.
let mut scheme_scoped: int = 0
let mut dens_scoped: int = 0
/// The scheme paint is resolving against: -1 = follow `appearance()`, 0 light,
/// 1 dark.
let mut paint_dark: int = -1
/// The scoped role palette paint is resolving against (0 = none).
let mut paint_pal: int = 0

// Scoped role palettes, by id (index 0 unused): each is a short list of role
// slots with the light / dark rgb that replaces the app-wide one inside a
// subtree that names it (`zui.Scope(accent = ...)`).
let mut pal_slot: [][]int = [][]int { []int {} }
let mut pal_l: [][]int = [][]int { []int {} }
let mut pal_d: [][]int = [][]int { []int {} }

fn set_scheme(id: int, s: int) {
    if id <= 0 || id >= nodes.tree.len {
        return
    }
    nodes.tree[id].scheme = nodes.tree[id].scheme / 4 * 4 + s
    scheme_scoped = 1
    mark_paint()
}

/// A new, empty role palette; returns its id.
fn palette_new() -> int {
    push(pal_slot, []int {})
    push(pal_l, []int {})
    push(pal_d, []int {})
    return pal_slot.len - 1
}

/// Palette `p` paints role `slot` as `light` / `dark` (packed rgb).
fn palette_set(p: int, slot: int, light: int, dark: int) {
    if p <= 0 || p >= pal_slot.len {
        return
    }
    let n = pal_slot[p].len
    for i in 0..n {
        if pal_slot[p][i] == slot {
            pal_l[p][i] = light
            pal_d[p][i] = dark
            mark_paint()
            return
        }
    }
    push(pal_slot[p], slot)
    push(pal_l[p], light)
    push(pal_d[p], dark)
    mark_paint()
}

/// `id`'s subtree paints its roles from palette `p` (0 clears it).
fn set_palette(id: int, p: int) {
    if id <= 0 || id >= nodes.tree.len {
        return
    }
    nodes.tree[id].scheme = nodes.tree[id].scheme % 4 + p * 4
    scheme_scoped = 1
    mark_paint()
}

/// The palette `id` paints with: its own or the nearest ancestor's, 0 none.
fn palette_of(id: int) -> int {
    let mut c = id
    let mut hops = 0
    while c > 0 && c < nodes.tree.len && hops < 4096 {
        let p = nodes.tree[c].scheme / 4
        if p > 0 {
            return p
        }
        c = nodes.tree[c].parent
        hops = hops + 1
    }
    return 0
}

fn set_density_scope(id: int, sid: int) {
    if id <= 0 || id >= nodes.tree.len {
        return
    }
    nodes.tree[id].dens_sid = sid
    dens_scoped = 1
}

/// The scheme `id` paints with: its own override or the nearest ancestor's,
/// -1 when none sets one.
fn scheme_of(id: int) -> int {
    let mut c = id
    let mut hops = 0
    while c > 0 && c < nodes.tree.len && hops < 4096 {
        let s = nodes.tree[c].scheme % 4
        if s == 1 {
            return 0
        }
        if s == 2 {
            return 1
        }
        c = nodes.tree[c].parent
        hops = hops + 1
    }
    return -1
}

/// The painter is entering node `id`: resolve against its scheme. Returns the
/// value to hand back to `paint_scheme_leave` after its subtree.
fn paint_scheme_enter(id: int) -> int {
    let prev = paint_dark + 1 + paint_pal * 4
    if scheme_scoped != 0 {
        paint_dark = scheme_of(id)
        paint_pal = palette_of(id)
    }
    return prev
}

fn paint_scheme_leave(prev: int) {
    paint_dark = prev % 4 - 1
    paint_pal = prev / 4
}

/// The density signal for a node: the nearest scoped one at or above `node`,
/// continuing from `slot` (its build parent) when `node` is not attached yet —
/// a style effect first runs before its node joins the tree. 0 = the global.
fn density_at(node: int, slot: int) -> int {
    if dens_scoped == 0 {
        return 0
    }
    let mut c = node
    let mut next_slot = slot
    if c <= 0 {
        c = next_slot
        next_slot = 0
    }
    let mut hops = 0
    while c > 0 && c < nodes.tree.len && hops < 4096 {
        if nodes.tree[c].dens_sid > 0 {
            return nodes.tree[c].dens_sid
        }
        let p = nodes.tree[c].parent
        if p > 0 {
            c = p
        } else {
            c = next_slot
            next_slot = 0
        }
        hops = hops + 1
    }
    return 0
}

/// The node whose effect is running now (0 outside any effect).
fn effect_node_now() -> int {
    return track.current_node()
}

/// Paint-time color. The app registers light/dark RGB per slot; paint
/// resolves against appearance(), or against the scheme a scoped subtree
/// set (`paint_scheme_enter`).
fn paint_rgb(c: int) -> int {
    if c < 0 {
        return 0
    }
    if c < 2130706432 {
        return c
    }
    let slot = c - 2130706432
    if slot < 0 {
        return 0
    }
    let mut dark = 0
    if paint_dark >= 0 {
        dark = paint_dark
    } else if appearance_sid > 0 {
        if appearance_sid < sigs.len {
            dark = sigs[appearance_sid]
        }
    }
    if paint_pal > 0 && paint_pal < pal_slot.len {
        let ps = pal_slot[paint_pal]
        let pn = ps.len
        for i in 0..pn {
            if ps[i] == slot {
                if dark != 0 {
                    return pal_d[paint_pal][i]
                }
                return pal_l[paint_pal][i]
            }
        }
    }
    if dark != 0 {
        if slot < theme_d.len {
            return theme_d[slot]
        }
        return 0
    }
    if slot < theme_l.len {
        return theme_l[slot]
    }
    return 0
}

// --- elevation --------------------------------------------------------------
// Pure data, in the core so the paint pass can resolve a node's shadow without
// depending on the component module. `zeus.elevation` / `elev_now` delegate
// here, so the tokens have one home.
//
// Each level is two shadows: a tight KEY shadow that seats the surface on the
// page (`alpha` / `blur` / `dx` / `dy`), and a wide, soft AMBIENT one under it
// (`amb_*`) that carries the lift. Two layers are what make a surface read as
// a soft physical object rather than a cut-out with a smudge.
struct Elev {
    alpha: int,
    blur: int,
    dx: int,
    dy: int,
    amb_alpha: int = 0,
    amb_blur: int = 0,
    amb_dy: int = 0,
}

fn elevation(level: int) -> Elev {
    if level <= 0 { return Elev(alpha = 0, blur = 0, dx = 0, dy = 0) }
    if level == 1 {
        return Elev(alpha = 14, blur = 2, dx = 0, dy = 1, amb_alpha = 16, amb_blur = 20, amb_dy = 8)
    }
    if level == 2 {
        return Elev(alpha = 22, blur = 4, dx = 0, dy = 2, amb_alpha = 20, amb_blur = 18, amb_dy = 8)
    }
    if level == 3 {
        return Elev(
            alpha = 24,
            blur = 6,
            dx = 0,
            dy = 3,
            amb_alpha = 26,
            amb_blur = 32,
            amb_dy = 14,
        )
    }
    return Elev(alpha = 28, blur = 10, dx = 0, dy = 4, amb_alpha = 34, amb_blur = 52, amb_dy = 22)
}

fn elevation_dark(level: int) -> Elev {
    if level <= 0 { return Elev(alpha = 0, blur = 0, dx = 0, dy = 0) }
    if level == 1 {
        return Elev(alpha = 70, blur = 2, dx = 0, dy = 1, amb_alpha = 60, amb_blur = 20, amb_dy = 8)
    }
    if level == 2 {
        return Elev(alpha = 80, blur = 4, dx = 0, dy = 2, amb_alpha = 70, amb_blur = 18, amb_dy = 8)
    }
    if level == 3 {
        return Elev(
            alpha = 90,
            blur = 6,
            dx = 0,
            dy = 3,
            amb_alpha = 95,
            amb_blur = 30,
            amb_dy = 13,
        )
    }
    return Elev(alpha = 110, blur = 10, dx = 0, dy = 4, amb_alpha = 125, amb_blur = 48, amb_dy = 20)
}

/// How far `e` reaches past the box on its widest side (blur plus offset,
/// over both layers).
fn elev_reach(e: Elev) -> int {
    let mut dx = e.dx
    if dx < 0 {
        dx = 0 - dx
    }
    let mut dy = e.dy
    if dy < 0 {
        dy = 0 - dy
    }
    let mut key = e.blur + dy
    if dx > dy {
        key = e.blur + dx
    }
    let mut ady = e.amb_dy
    if ady < 0 {
        ady = 0 - ady
    }
    let amb = e.amb_blur + ady
    if amb > key {
        return amb
    }
    return key
}

/// Shadow for a node right now: its resting level, blended toward `lift`
/// by the eased hover amount.
fn elev_hover(id: int) -> Elev {
    let base = elev_now(int(nodes.look[id].elev))
    let lift = int(nodes.look[id].lift)
    if lift <= int(nodes.look[id].elev) {
        return base
    }
    let t = hover_paint(id)
    if t <= 0 {
        return base
    }
    let top = elev_now(lift)
    return Elev(
        alpha = base.alpha + (top.alpha - base.alpha) * t / 100,
        amb_alpha = base.amb_alpha + (top.amb_alpha - base.amb_alpha) * t / 100,
        amb_blur = base.amb_blur + (top.amb_blur - base.amb_blur) * t / 100,
        amb_dy = base.amb_dy + (top.amb_dy - base.amb_dy) * t / 100,
        blur = base.blur + (top.blur - base.blur) * t / 100,
        dx = base.dx + (top.dx - base.dx) * t / 100,
        dy = base.dy + (top.dy - base.dy) * t / 100,
    )
}

fn elev_now(level: int) -> Elev {
    let mut dark = 0
    if appearance_sid > 0 {
        if appearance_sid < sigs.len {
            dark = sigs[appearance_sid]
        }
    }
    if dark != 0 {
        return elevation_dark(level)
    }
    return elevation(level)
}

fn sig_val(id: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= sigs.len {
        return 0
    }
    if id < sig_anim.len {
        if sig_anim[id] != 0 {
            return sig_paint[id]
        }
    }
    return sigs[id]
}

fn bound_num(id: int) -> int {
    if nodes.ui[id].bind_sig > 0 {
        return sig_val(nodes.ui[id].bind_sig)
    }
    if nodes.ui[id].bind_sig < 0 {
        return nodes.ui[id].click_set
    }
    return 0
}

fn inset_here(id: int) -> int {
    if id == root_id {
        return 1
    }
    return int(nodes.pin[id].safe)
}

fn content_x(id: int) -> int {
    let mut x = nodes.box[id].x + i32(nodes.lay[id].pad_l) + i32(nodes.lay[id].border_w)
    if inset_here(id) != 0 {
        x = x + safe_l
    }
    return x
}
fn content_y(id: int) -> int {
    let mut y = nodes.box[id].y + i32(nodes.lay[id].pad_t) + i32(nodes.lay[id].border_w)
    if inset_here(id) != 0 {
        y = y + safe_t
    }
    return y
}
fn inner_w(id: int) -> int {
    let mut extra = 0
    if inset_here(id) != 0 {
        extra = safe_l + safe_r
    }
    return geometry.max2(nodes.box[id].w - nodes.box_pad_x(id) - extra, 0)
}
fn inner_h(id: int) -> int {
    let mut extra = 0
    if inset_here(id) != 0 {
        extra = safe_t + safe_b
    }
    return geometry.max2(nodes.box[id].h - nodes.box_pad_y(id) - extra, 0)
}

fn clamp_w(id: int, w: int) -> int {
    let mut v = w
    if nodes.lay[id].min_w >= 0 {
        if v < nodes.lay[id].min_w {
            v = nodes.lay[id].min_w
        }
    }
    if nodes.lay[id].max_w >= 0 {
        if v > nodes.lay[id].max_w {
            v = nodes.lay[id].max_w
        }
    }
    return geometry.max2(v, 0)
}
fn clamp_h(id: int, h: int) -> int {
    let mut v = h
    if nodes.lay[id].min_h >= 0 {
        if v < nodes.lay[id].min_h {
            v = nodes.lay[id].min_h
        }
    }
    if nodes.lay[id].max_h >= 0 {
        if v > nodes.lay[id].max_h {
            v = nodes.lay[id].max_h
        }
    }
    return geometry.max2(v, 0)
}

/// Default w_pct is 100: fill the parent in a column. In a row the same
/// default means content width so siblings sit side by side; `.set_width(px)` and
/// any width_pct other than 100 still win. A raster image never grows past
/// its decoded source size, so a widthless `Image` fills the container up to
/// the source width (web `max-width: 100%`) — that is how an uploaded photo
/// resizes to the device width without a caller-set `max_width`.
fn sized_w(c: int, avail: int, row: int) -> int {
    let mut w = nodes.box[c].inner_width
    if nodes.lay[c].explicit_width >= 0 {
        w = nodes.lay[c].explicit_width
    } else if int(nodes.lay[c].w_pct) >= 0 {
        if row != 0 {
            if int(nodes.lay[c].w_pct) == 100 {
                w = nodes.box[c].inner_width
            } else {
                w = avail * int(nodes.lay[c].w_pct) / 100
            }
        } else {
            w = avail * int(nodes.lay[c].w_pct) / 100
            if int(nodes.tree[c].kind) == 14 {
                if nodes.box[c].inner_width > 0 {
                    if w > nodes.box[c].inner_width {
                        w = nodes.box[c].inner_width
                    }
                }
            }
        }
    }
    return clamp_w(c, w)
}
fn sized_h(c: int, avail: int, w: int) -> int {
    let mut h = nodes.box[c].inner_height
    if nodes.lay[c].aspect_w > 0 {
        if nodes.lay[c].aspect_h > 0 {
            if nodes.lay[c].explicit_height < 0 {
                h = w * nodes.lay[c].aspect_h / nodes.lay[c].aspect_w
            }
        }
    }
    if int(nodes.lay[c].h_pct) >= 0 {
        h = avail * int(nodes.lay[c].h_pct) / 100
    } else if nodes.lay[c].explicit_height >= 0 {
        h = nodes.lay[c].explicit_height
    }
    return clamp_h(c, h)
}

fn skip_flow(id: int) -> int {
    if id <= 0 {
        return 1
    }
    if want_show(id) == 0 {
        return 1
    }
    if int(nodes.tree[id].kind) == 9 {
        return 1
    }
    if int(nodes.pin[id].pos) == 1 {
        return 1
    }
    return 0
}

fn size_fit(n: int) {
    let have = size_buffer.len
    if n > have {
        let extra = n - have
        for i in 0..extra {
            push(size_buffer, 0)
        }
    }
    let have2 = size_layout.len
    if n > have2 {
        let extra = n - have2
        for i in 0..extra {
            push(size_layout, 0)
        }
    }
}

/// Copy size_buffer into size_layout so nested flex layout can reuse size_buffer.
fn size_commit(n: int) {
    size_fit(n)
    let have = size_layout.len
    if n > have {
        let extra = n - have
        for i in 0..extra {
            push(size_layout, 0)
        }
    }
    for i in 0..n {
        size_layout[i] = size_buffer[i]
    }
}

fn want_show(id: int) -> int {
    if id <= 0 {
        return 0
    }
    if nodes.tree[id].show_sig <= 0 {
        /* No signal bound: the declarative `show` prop decides (or the
           default, visible). */
        return i32(nodes.tree[id].show_on)
    }
    if nodes.tree[id].show_sig >= sigs.len {
        return 1
    }
    let vv = sigs[nodes.tree[id].show_sig]
    let mode = nodes.tree[id].show_mode
    let val = nodes.tree[id].show_val
    if mode == 0 {
        if vv != 0 {
            return 1
        }
        return 0
    }
    if mode == 1 {
        if vv == val {
            return 1
        }
        return 0
    }
    if mode == 2 {
        if vv != val {
            return 1
        }
        return 0
    }
    if mode == 3 {
        if vv >= val {
            return 1
        }
        return 0
    }
    if mode == 4 {
        if vv <= val {
            return 1
        }
        return 0
    }
    return 1
}

/// Anchor a floating node (popover / tooltip / hover card) to `target`'s
/// screen rect. `side` is the preferred placement, `gap` the offset in dp.
fn anchor_to(id: int, target: int, side: int, gap: int) {
    if id <= 0 {
        return
    }
    if id >= nodes.tree.len {
        return
    }
    nodes.pin[id].anchor = target
    floater_gen = floater_gen + 1
    nodes.pin[id].place = u8(side)
    let mut g = gap
    if g < 0 {
        g = 0
    }
    nodes.pin[id].anchor_gap = u16(g)
    nodes.pin[id].flip = u8(1)
    mark_layout()
}

fn set_anchor_flip(id: int, on: int) {
    if id <= 0 {
        return
    }
    if id >= nodes.tree.len {
        return
    }
    nodes.pin[id].flip = u8(on)
    mark_layout()
}

/// Jump this node's exit fade — and every other enter_fade node that shares
/// its hide signal — to 0. A Menu pick must drop the panel in the same frame
/// (`on_select`); a scheduled Fast fade would leave labels over the heading.
fn snap_exit(id: int) {
    if id <= 0 {
        return
    }
    let mut current_value = id
    let mut host = 0
    let mut guard = 0
    while current_value > 0 {
        if current_value >= nodes.tree.len {
            break
        }
        if int(nodes.anim[current_value].enter_fade) != 0 {
            host = current_value
            break
        }
        current_value = nodes.tree[current_value].parent
        guard = guard + 1
        if guard > 64 {
            break
        }
    }
    if host == 0 {
        return
    }
    anim_schedule(host, APROP.EnterFade, 0, 0, 0)
    // The Menu scrim is a sibling Overlay, not an ancestor. Snap every
    // enter_fade sibling so a pick does not leave a fading scrim running.
    let par = nodes.tree[host].parent
    let n = nodes.tree.len
    for i in 1..n {
        if i != host {
            if nodes.tree[i].parent == par {
                if int(nodes.anim[i].enter_fade) != 0 {
                    anim_schedule(i, APROP.EnterFade, 0, 0, 0)
                }
            }
        }
    }
}

/// Paint visibility: `want_show`, or a hidden node whose exit fade has not
/// landed yet. Paint alone reads this; layout, hit-test, focus, and the tree
/// predicates keep `want_show`, so a closing floater is already inert.
fn want_paint(id: int) -> int {
    if want_show(id) != 0 {
        return 1
    }
    if id <= 0 {
        return 0
    }
    if id >= nodes.tree.len {
        return 0
    }
    if int(nodes.anim[id].enter_fade) == 2 {
        if int(nodes.anim[id].show_amt) > 0 {
            return 1
        }
    }
    return 0
}

/// 1 when `id` and every ancestor is visible. `want_show` is per-node; a hidden
/// container hides its subtree for paint, so a visibility check must walk up.
fn shown_in_tree(id: int) -> int {
    if id <= 0 {
        return 0
    }
    let mut current_value = id
    let mut guard = 0
    while current_value > 0 {
        if want_show(current_value) == 0 {
            return 0
        }
        current_value = nodes.tree[current_value].parent
        guard = guard + 1
        if guard > 64 {
            break
        }
    }
    return 1
}

fn ease_out(t: int) -> int {
    if t <= 0 {
        return 0
    }
    if t >= 100 {
        return 100
    }
    let u = 100 - t
    return 100 - u * u / 100
}

fn hover_paint(id: int) -> int {
    if state_watched(id) != 0 {
        return 0
    }
    return ease_out(int(nodes.anim[id].hover_amt))
}

// --- shared interaction state (Phase 3) -----------------------------------
//
// One model for the discrete states every interactive widget shares. Components
// set the flags through `set_interaction_state` (or the convenience setters),
// and paint / hit-test consult `interaction_state` instead of each recipe
// growing its own copy. The states are discrete, so changing one may use a
// signal; the *animation* of a state (the fade between them) still goes through
// the track pool.
enum UISTATE {
    // Pointer is over the node and it is not disabled.
    StHovered = 1,
    // Primary button is down on the node.
    StPressed = 2,
    // Focus arrived by keyboard (the painted ring is keyboard-only).
    StFocusVisible = 3,
    // Not available: no hover, no press, dimmed.
    StDisabled = 4,
    // Work in flight: dimmed and non-interactive.
    StLoading = 5,
    // Toggled on (tab / radio / switch / selected row).
    StSelected = 6,
    // Validation failed.
    StInvalid = 7,
}

fn state_bit(s: int) -> int {
    return 1 << (s - 1)
}

/// Bitmask of the shared interaction states for `id`.
fn interaction_state(id: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= nodes.tree.len {
        return 0
    }
    let mut m = 0
    if int(nodes.ui[id].disabled) != 0 {
        m = m | state_bit(UISTATE.StDisabled)
    }
    if int(nodes.ui[id].loading) != 0 {
        m = m | state_bit(UISTATE.StLoading)
    }
    if int(nodes.ui[id].invalid) != 0 {
        m = m | state_bit(UISTATE.StInvalid)
    }
    if (m & (state_bit(UISTATE.StDisabled) | state_bit(UISTATE.StLoading))) == 0 {
        if is_hot(id) != 0 {
            if ptr_in(id) != 0 {
                m = m | state_bit(UISTATE.StHovered)
            }
        }
        if int(nodes.anim[id].press) != 0 {
            if down_id == id {
                m = m | state_bit(UISTATE.StPressed)
            }
        }
    }
    if kb_focus != 0 {
        if focus_id == id {
            m = m | state_bit(UISTATE.StFocusVisible)
        }
    }
    if nodes.ui[id].bind_sig > 0 {
        if sig_val(nodes.ui[id].bind_sig) != 0 {
            m = m | state_bit(UISTATE.StSelected)
        }
    }
    return m
}

fn state_has(m: int, s: int) -> bool {
    if (m & state_bit(s)) != 0 {
        return true
    }
    return false
}

fn set_interaction_state(id: int, s: int, on: int) {
    if id <= 0 {
        return
    }
    if id >= nodes.tree.len {
        return
    }
    let mut v = 0
    if on != 0 {
        v = 1
    }
    // Read the current value before writing: a prop that re-asserts the same
    // state (every `Component` sets `disabled` on every build) is a no-op.
    let mut cur = 0
    if s == UISTATE.StDisabled {
        cur = int(nodes.ui[id].disabled)
    } else if s == UISTATE.StLoading {
        cur = int(nodes.ui[id].loading)
    } else if s == UISTATE.StInvalid {
        cur = int(nodes.ui[id].invalid)
    } else {
        return
    }
    if cur == v {
        return
    }
    if s == UISTATE.StDisabled {
        nodes.ui[id].disabled = u8(v)
    } else if s == UISTATE.StLoading {
        nodes.ui[id].loading = u8(v)
    } else {
        nodes.ui[id].invalid = u8(v)
    }
    // The interaction overlay is node-scoped: only this node's paint and chrome
    // change, so flag it on the one channel instead of walking every target.
    invalidate(id, INV.Paint)
    invalidate(id, INV.Chrome)
}

/// Nodes the last chrome pass visited, then reset. A targeted pass after a
/// signal write should visit only the affected nodes; the full pass visits all.
fn take_chrome_sync_count() -> int {
    let c = chrome_sync_count
    chrome_sync_count = 0
    return c
}

fn set_disabled(id: int, on: int) {
    set_interaction_state(id, UISTATE.StDisabled, on)
}

fn set_loading(id: int, on: int) {
    set_interaction_state(id, UISTATE.StLoading, on)
}

fn set_invalid(id: int, on: int) {
    set_interaction_state(id, UISTATE.StInvalid, on)
}

/// One shared-state predicate per bit, so a caller never needs the bit number.
fn state_disabled_of(id: int) -> int {
    if state_has(interaction_state(id), UISTATE.StDisabled) {
        return 1
    }
    return 0
}
fn state_loading_of(id: int) -> int {
    if state_has(interaction_state(id), UISTATE.StLoading) {
        return 1
    }
    return 0
}
fn state_invalid_of(id: int) -> int {
    if state_has(interaction_state(id), UISTATE.StInvalid) {
        return 1
    }
    return 0
}
fn state_hovered_of(id: int) -> int {
    if state_has(interaction_state(id), UISTATE.StHovered) {
        return 1
    }
    return 0
}
fn state_pressed_of(id: int) -> int {
    if state_has(interaction_state(id), UISTATE.StPressed) {
        return 1
    }
    return 0
}
fn state_focus_visible_of(id: int) -> int {
    if state_has(interaction_state(id), UISTATE.StFocusVisible) {
        return 1
    }
    return 0
}
fn state_selected_of(id: int) -> int {
    if state_has(interaction_state(id), UISTATE.StSelected) {
        return 1
    }
    return 0
}

fn hover_rgb() -> int {
    let mut dark = 0
    if appearance_sid > 0 {
        if appearance_sid < sigs.len {
            dark = sigs[appearance_sid]
        }
    }
    if dark != 0 {
        return 16777215
    }
    return 0
}

/// Scale a pressed `press_scale` node settles at (percent).
const PRESS_SCALE: int = 97

/// 1 when the shared overlay says the node takes no activation: disabled or
/// loading. Pointer clicks and Enter / Space consult this, so a component
/// never has to guard its own handler.
fn is_inert(id: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= nodes.tree.len {
        return 0
    }
    if int(nodes.ui[id].disabled) != 0 {
        return 1
    }
    if int(nodes.ui[id].loading) != 0 {
        return 1
    }
    if exit_nodes.len > 0 {
        if nodes.in_exiting(id) != 0 {
            return 1
        }
    }
    return 0
}

fn is_hot(id: int) -> int {
    if want_show(id) == 0 {
        return 0
    }
    // Touch hosts have no hover: paint already skips the wash, and this
    // early-out skips ptr_in / hover_amt / HoverAmt tracks per pointer move.
    if platform.plat_overlay_scroll() != 0 {
        return 0
    }
    // The shared overlay: a disabled or loading node never hovers.
    if int(nodes.ui[id].disabled) != 0 {
        return 0
    }
    if int(nodes.ui[id].loading) != 0 {
        return 0
    }
    // A node with state styles tracks hover itself (and paints no wash).
    if state_watched(id) != 0 {
        return 1
    }
    if int(nodes.anim[id].hover_fade) < 0 {
        return 0
    }
    let k = int(nodes.tree[id].kind)
    if k == 9 {
        return 0
    }
    if k == 11 {
        return 0
    }
    if int(nodes.anim[id].hover_fade) != 0 {
        return 1
    }
    if nodes.ui[id].click_sig > 0 {
        return 1
    }
    if nodes.ui[id].click_fn > 0 {
        return 1
    }
    if k == 4 {
        return 1
    }
    if k == 7 {
        return 1
    }
    if k == 8 {
        return 1
    }
    if k == 13 {
        return 1
    }
    return 0
}

fn ptr_in(id: int) -> int {
    if want_show(id) == 0 {
        return 0
    }
    // Occlusion: while the pointer is over a floater (a popup, a modal scrim),
    // only that floater's subtree can be under it (pointer capture).
    if ptr_cover > 0 {
        if nodes.is_or_under(id, ptr_cover) == 0 {
            return 0
        }
    }
    // A row of a closed menu keeps the box it last laid out in. Under a hidden
    // ancestor it is not there to hover: its `on_hover` reopened the menu.
    if ptr_in_box(id) == 0 {
        return 0
    }
    return shown_in_tree(id)
}

/// 1 when the pointer is inside `id`'s box and inside every clip above it
/// (a scroller's viewport, an `overflow` box), mapped through the scroll
/// offsets the paint pass applies. Clips stop at the nearest floater: it paints
/// after its parents' clips are restored. Window floaters (overlays, anchored
/// popups) also stop the scroll sum: they are placed in window coordinates.
fn ptr_in_box(id: int) -> int {
    // Pass 1: the scroll sum `paint` applies to `id` (scroller ancestors up to
    // the first window floater).
    let mut sx = 0
    let mut sy = 0
    if nodes.is_window_floater(id) == 0 {
        let mut p = nodes.tree[id].parent
        let mut guard = 0
        while p > 0 && guard < 64 {
            if int(nodes.tree[p].kind) == 11 {
                sx = sx + nodes.scrl[p].scroll_x
                sy = sy + nodes.scrl[p].scroll_y
            }
            if nodes.is_window_floater(p) != 0 {
                break
            }
            p = nodes.tree[p].parent
            guard = guard + 1
        }
    }
    if in_box(id, ptr_x + sx, ptr_y + sy) == 0 {
        return 0
    }
    // Pass 2: every clip between `id` and its nearest floater. An ancestor's
    // own position is in the space without its own scroll.
    if nodes.is_floater(id) != 0 {
        return ptr_in_float_clip(id)
    }
    let mut p = nodes.tree[id].parent
    let mut guard = 0
    while p > 0 && guard < 64 {
        if int(nodes.tree[p].kind) == 11 {
            sx = sx - nodes.scrl[p].scroll_x
            sy = sy - nodes.scrl[p].scroll_y
            if in_box(p, ptr_x + sx, ptr_y + sy) == 0 {
                return 0
            }
        } else if nodes.lay[p].overflow == 1 {
            if in_box(p, ptr_x + sx, ptr_y + sy) == 0 {
                return 0
            }
        }
        if nodes.is_floater(p) != 0 {
            return ptr_in_float_clip(p)
        }
        p = nodes.tree[p].parent
        guard = guard + 1
    }
    return 1
}

/// The topmost floater under the pointer that captures it, or 0. An overlay
/// (kind 9) is a full-window layer: it captures only when it paints a scrim or
/// takes clicks (a modal), so a toast layer does not swallow the page. A node
/// with `pointer_pass` set never captures.
let mut ptr_cover: int = 0
/// Screen offset of `ptr_cover` (the scroll its in-place floater keeps).
let mut ptr_cover_sx: int = 0
let mut ptr_cover_sy: int = 0

fn floater_captures(f: int, sx: int, sy: int) -> int {
    if int(nodes.ui[f].ptr_pass) != 0 {
        return 0
    }
    if ptr_in_float_clip(f) == 0 {
        return 0
    }
    if int(nodes.tree[f].kind) == 9 {
        if nodes.look[f].bg < 0 && nodes.ui[f].click_fn <= 0 && nodes.ui[f].click_sig <= 0 {
            return 0
        }
        return in_box(f, ptr_x, ptr_y)
    }
    if nodes.is_window_floater(f) != 0 {
        return in_box(f, ptr_x, ptr_y)
    }
    return in_box(f, ptr_x + sx, ptr_y + sy)
}

/// Recompute `ptr_cover` for the current pointer and boxes. Called when the
/// pointer moves and before the hover states re-sync (a scroll or a layout can
/// slide a popup under a still pointer).
fn update_ptr_cover() {
    ptr_cover = 0
    ptr_cover_sx = 0
    ptr_cover_sy = 0
    if root_id <= 0 {
        return
    }
    floater_clear()
    floater_collect(root_id, 0, 0, 0)
    floater_sort(1)
    let n = floater_id.len
    for i in 0..n {
        let f = floater_id[i]
        if floater_captures(f, floater_screen_x[i], floater_screen_y[i]) != 0 {
            ptr_cover = f
            ptr_cover_sx = floater_screen_x[i]
            ptr_cover_sy = floater_screen_y[i]
            return
        }
    }
}

fn paint_alpha(id: int) -> int {
    let mut a = int(nodes.look[id].opacity)
    // `pulse` used to be an alpha sawtooth here; the shimmer is now a
    // directional band painted over the fill (`scene.paint_shimmer`), so a
    // skeleton keeps its opacity.
    if int(nodes.anim[id].enter_fade) != 0 {
        a = a * int(nodes.anim[id].show_amt) / 100
    }
    // A fading floater only used to dim its own fill; child Text stayed at
    // 255 until the node dropped, so labels hung over the heading after the
    // panel was gone. Walk enter_fade ancestors so the subtree shares that
    // alpha. Kind 9 is the scrim: it fades its own fill, and the panel it
    // hosts carries enter_fade for the content — multiplying both would
    // square the Dialog / Drawer / Toast exit.
    let mut p = nodes.tree[id].parent
    let mut guard = 0
    while p > 0 {
        if p >= nodes.tree.len {
            break
        }
        if int(nodes.tree[p].kind) != 9 {
            if int(nodes.anim[p].enter_fade) != 0 {
                a = a * int(nodes.anim[p].show_amt) / 100
            }
        }
        // An exit transition fades the node's own opacity; the subtree it
        // takes with it fades along (a row root's labels, a kept arm's body).
        if nodes.tree[p].exiting != 0 {
            a = a * int(nodes.look[p].opacity) / 100
        }
        p = nodes.tree[p].parent
        guard = guard + 1
        if guard > 64 {
            break
        }
    }
    if a < 0 {
        a = 0
    }
    if a > 100 {
        a = 100
    }
    return a * 255 / 100
}

/// `an_scale` at rest (permille).
const SCALE_ONE: int = 1000
let mut origin_x: int = 0
let mut origin_y: int = 0

/// Where `id` scales and rotates about, in `origin_x` / `origin_y`: its centre,
/// or for a panel anchored to a trigger the edge facing it, level with the
/// trigger, so it grows out of what opened it. Read from the boxes, so a
/// panel that flipped to fit grows the right way.
fn paint_origin(id: int) {
    let w = nodes.box[id].w
    let h = nodes.box[id].h
    let x = draw_x(id)
    let y = draw_y(id)
    origin_x = x + w / 2
    origin_y = y + h / 2
    let a = nodes.pin[id].anchor
    if a <= 0 || a >= nodes.tree.len {
        return
    }
    let ax = nodes.box[a].x + nodes.box[a].w / 2 - paint_sx
    let ay = nodes.box[a].y + nodes.box[a].h / 2 - paint_sy
    origin_x = geometry.min2(geometry.max2(ax, x), x + w)
    if ay < y {
        origin_y = y
    } else if ay > y + h {
        origin_y = y + h
    }
}

fn draw_x(id: int) -> int {
    return nodes.box[id].x - paint_sx
}
fn draw_y(id: int) -> int {
    return nodes.box[id].y - paint_sy
}

/// Apple HIG 44pt minimum tappable area. Applied only on overlay-scroll
/// (iOS / Android) hosts, and only to nodes that already take a pointer.
const HIT_MIN: int = 44

fn hit_expand(id: int) -> int {
    if platform.plat_overlay_scroll() == 0 {
        return 0
    }
    if id <= 0 {
        return 0
    }
    if id >= nodes.tree.len {
        return 0
    }
    let k = int(nodes.tree[id].kind)
    if k == 9 {
        return 0
    }
    if k == 11 {
        return 0
    }
    if nodes.ui[id].click_fn > 0 {
        return 1
    }
    if nodes.ui[id].click_sig > 0 {
        return 1
    }
    if nodes.ui[id].down_fn > 0 {
        return 1
    }
    if nodes.ui[id].up_fn > 0 {
        return 1
    }
    if int(nodes.ui[id].focusable) != 0 {
        return 1
    }
    if k == 4 {
        return 1
    }
    if k == 7 {
        return 1
    }
    if k == 8 {
        return 1
    }
    if k == 10 {
        return 1
    }
    if k == 13 {
        return 1
    }
    return 0
}

fn in_box(id: int, px: int, py: int) -> int {
    let mut x = nodes.box[id].x
    let mut y = nodes.box[id].y
    let mut w = nodes.box[id].w
    let mut h = nodes.box[id].h
    if hit_expand(id) != 0 {
        if w < HIT_MIN {
            x = x - (HIT_MIN - w) / 2
            w = HIT_MIN
        }
        if h < HIT_MIN {
            y = y - (HIT_MIN - h) / 2
            h = HIT_MIN
        }
    }
    if px < x {
        return 0
    }
    if py < y {
        return 0
    }
    if px >= x + w {
        return 0
    }
    if py >= y + h {
        return 0
    }
    return 1
}

fn scroll_max(id: int) -> int {
    return geometry.max2(nodes.box[id].ext_h - nodes.box[id].h, 0)
}

fn scroll_max_x(id: int) -> int {
    return geometry.max2(nodes.box[id].ext_w - nodes.box[id].w, 0)
}

fn physics_axis_live(pos: int, vel: int, maxs: int) -> int {
    if vel != 0 {
        return 1
    }
    if pos < 0 {
        return 1
    }
    if pos > maxs {
        return 1
    }
    return 0
}

/// 1 if any scroller is coasting, easing to a wheel target, or overscrolled —
/// hosts should keep frames.
fn physics_live() -> int {
    let n = nodes.tree.len
    for i in 1..n {
        if int(nodes.tree[i].kind) == 11 {
            if int(nodes.scrl[i].smooth) != 0 {
                return 1
            }
            if physics_axis_live(
                nodes.scrl[i].scroll_x,
                nodes.scrl[i].vel_x,
                scroll_max_x(i),
            ) != 0 {
                return 1
            }
            if physics_axis_live(nodes.scrl[i].scroll_y, nodes.scrl[i].vel_y, scroll_max(i)) != 0 {
                return 1
            }
        }
    }
    return 0
}

struct Axis {
    pos: int,
    vel: int,
    dirty: int,
}

fn physics_axis(pos: int, vel: int, maxs: int, dt: int) -> Axis {
    // Frame-rate independent: advance the position and decay the velocity for the
    // frame's delta, with the 60 Hz values as the reference (dt == 16).
    let mut y = pos + vel * dt / 16
    let mut v = vel * (100 - dt / 2) / 100
    let mut dirty = 0
    // Hard clamp at the content bounds: momentum never overshoots, so the
    // viewport can never show a blank strip past the first/last content.
    if y < 0 {
        y = 0
        v = 0
        dirty = 1
    } else if y > maxs {
        y = maxs
        v = 0
        dirty = 1
    } else if v * v < 4 {
        v = 0
    } else {
        dirty = 1
    }
    return Axis { pos: y, vel: v, dirty: dirty }
}

/// One frame toward a wheel target: 35 % of the gap per 16 ms, at least 1 px, so
/// a 100 px notch lands smoothly and never stalls short. `dt` keeps the feel the
/// same on a 120 Hz display as on a 60 Hz one. Returns the new position; the
/// caller clears the bit when it equals the target.
fn smooth_axis(pos: int, target_value: int, dt: int) -> int {
    let d = target_value - pos
    if d == 0 {
        return pos
    }
    // 35 % of the gap per 16 ms, scaled by the frame's delta and capped below
    // 100 % so a long frame converges fast without overshooting the target.
    let mut f = 35 * dt / 16
    if f > 90 {
        f = 90
    }
    if f < 1 {
        f = 1
    }
    let mut step = d * f / 100
    if step == 0 {
        if d > 0 {
            step = 1
        } else {
            step = -1
        }
    }
    return pos + step
}

/// A finger is panning: from the first `input.scroll` to its `mouseup`. The
/// position is the finger's until then, so nothing coasts. Touch reports slower
/// than a fast screen draws, so most frames have no pan in them, and coasting
/// those moved the content at twice the finger's speed.
let mut pan_held: int = 0

/// One frame of momentum + rubber-band + wheel easing. Returns 1 if anything
/// moved. Thumb drag (`drag_bar`) owns the position until mouseup.
fn physics_step() -> int {
    if drag_id > 0 {
        if drag_bar != 0 {
            return 0
        }
    }
    // The frame's delta, from the engine clock (`scene.step` advances it). A host
    // that does not tick the clock falls back to a 60 Hz step.
    let mut dt = now_ms - physics_ms
    if dt <= 0 {
        dt = 16
    }
    if dt > 32 {
        dt = 32
    }
    physics_ms = now_ms
    let n = nodes.tree.len
    let mut dirty = 0
    for i in 1..n {
        if int(nodes.tree[i].kind) == 11 {
            let sm = int(nodes.scrl[i].smooth)
            if (sm & 1) != 0 {
                let ny = smooth_axis(nodes.scrl[i].scroll_y, nodes.scrl[i].tgt_y, dt)
                if ny != nodes.scrl[i].scroll_y {
                    nodes.scrl[i].scroll_y = ny
                    dirty = 1
                    bar_keep(i)
                    if nodes.ui[i].bind_sig > 0 {
                        store_sig_paint(nodes.ui[i].bind_sig, ny)
                    }
                }
                if ny == nodes.scrl[i].tgt_y {
                    nodes.scrl[i].smooth = u8(sm & 14)
                }
            }
            if (sm & 2) != 0 {
                let nx = smooth_axis(nodes.scrl[i].scroll_x, nodes.scrl[i].tgt_x, dt)
                if nx != nodes.scrl[i].scroll_x {
                    nodes.scrl[i].scroll_x = nx
                    dirty = 1
                    bar_keep(i)
                }
                if nx == nodes.scrl[i].tgt_x {
                    nodes.scrl[i].smooth = u8(int(nodes.scrl[i].smooth) & 13)
                }
            }
            // A pan that arrived this frame already moved the position to follow
            // the finger. Coasting from that same delta in the same frame would
            // apply it a SECOND time, which is what made a drag advance the
            // content at twice the finger's speed — and, because the finger's
            // velocity reverses constantly, what read as the UI vibrating.
            // A node a pan just drove is coasted from the next frame on, which
            // is also what a browser feels like (release, then glide).
            let sm2 = int(nodes.scrl[i].smooth)
            let panned_y = sm2 & 4
            let panned_x = sm2 & 8
            nodes.scrl[i].smooth = u8(sm2 & 3)
            // A resting finger has no speed left to release with.
            if pan_held != 0 {
                if panned_y == 0 {
                    nodes.scrl[i].vel_y = nodes.scrl[i].vel_y / 2
                }
                if panned_x == 0 {
                    nodes.scrl[i].vel_x = nodes.scrl[i].vel_x / 2
                }
                continue
            }
            if panned_y == 0 {
                let ay = physics_axis(
                    nodes.scrl[i].scroll_y,
                    nodes.scrl[i].vel_y,
                    scroll_max(i),
                    dt,
                )
                nodes.scrl[i].scroll_y = ay.pos
                nodes.scrl[i].vel_y = ay.vel
                if ay.dirty != 0 {
                    dirty = 1
                    bar_keep(i)
                    mark_paint_id(i)
                    if nodes.ui[i].bind_sig > 0 {
                        store_sig_paint(nodes.ui[i].bind_sig, ay.pos)
                    }
                }
            }
            if panned_x == 0 {
                let ax = physics_axis(
                    nodes.scrl[i].scroll_x,
                    nodes.scrl[i].vel_x,
                    scroll_max_x(i),
                    dt,
                )
                nodes.scrl[i].scroll_x = ax.pos
                nodes.scrl[i].vel_x = ax.vel
                if ax.dirty != 0 {
                    dirty = 1
                    bar_keep(i)
                    mark_paint_id(i)
                }
            }
        }
    }
    if dirty != 0 {
        mark_scroll()
    }
    return dirty
}

/// Move a wheel target by `d` (clamped to the content). Starts from the live
/// target when one is pending, so back-to-back notches add up instead of
/// restarting. Returns how much of `d` the scroller could take.
fn apply_smooth_y(id: int, d: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= nodes.tree.len {
        return 0
    }
    let mut from = nodes.scrl[id].scroll_y
    if (int(nodes.scrl[id].smooth) & 1) != 0 {
        from = nodes.scrl[id].tgt_y
    }
    let my = scroll_max(id)
    let mut t = from + d
    if t < 0 {
        t = 0
    }
    if t > my {
        t = my
    }
    if t == from {
        return 0
    }
    nodes.scrl[id].vel_y = 0
    nodes.scrl[id].tgt_y = t
    nodes.scrl[id].smooth = u8(int(nodes.scrl[id].smooth) | 1)
    bar_on(id)
    mark_paint()
    return t - from
}

fn apply_smooth_x(id: int, d: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= nodes.tree.len {
        return 0
    }
    let mut from = nodes.scrl[id].scroll_x
    if (int(nodes.scrl[id].smooth) & 2) != 0 {
        from = nodes.scrl[id].tgt_x
    }
    let mx = scroll_max_x(id)
    let mut t = from + d
    if t < 0 {
        t = 0
    }
    if t > mx {
        t = mx
    }
    if t == from {
        return 0
    }
    nodes.scrl[id].vel_x = 0
    nodes.scrl[id].tgt_x = t
    nodes.scrl[id].smooth = u8(int(nodes.scrl[id].smooth) | 2)
    bar_on(id)
    mark_paint()
    return t - from
}

/// Apply a pan delta. `momentum` 1 arms the coast (touch pans, precise
/// trackpads); 0 is a discrete wheel click, which must stop exactly where it
/// lands. Both clamp at the content bounds — a scroll ends at the first or
/// last content, never past it (no blank strip). Returns 1 if `scroll_y`
/// changed.
fn apply_delta_y(id: int, dy: int, momentum: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= nodes.tree.len {
        return 0
    }
    let my = scroll_max(id)
    let mut ny = nodes.scrl[id].scroll_y + dy
    let mut v = dy
    if momentum == 0 {
        v = 0
    }
    if ny < 0 {
        ny = 0
        v = 0
    }
    if ny > my {
        ny = my
        v = 0
    }
    nodes.scrl[id].vel_y = v
    // A direct scroll — a pan or a precise wheel step — is the finger taking
    // this axis over, so it CANCELS any pending wheel easing (bit 1). Leaving
    // that ease armed is the bug this comment exists for: the frames after the
    // finger's delta kept easing toward the notch's now-stale `tgt_y`, so a
    // downward scroll moved the content down and then back up. Bit 4 tells
    // `physics_step` this frame's delta has already been applied by the finger,
    // so the coast must not apply it a second time.
    let mut bits = int(nodes.scrl[id].smooth) & 10
    if momentum != 0 {
        bits = bits | 4
    }
    nodes.scrl[id].smooth = u8(bits)
    if ny == nodes.scrl[id].scroll_y {
        return 0
    }
    nodes.scrl[id].scroll_y = ny
    bar_on(id)
    mark_scroll_node(id)
    if nodes.ui[id].bind_sig > 0 {
        store_sig_paint(nodes.ui[id].bind_sig, ny)
    }
    return 1
}

fn apply_delta_x(id: int, dx: int, momentum: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= nodes.tree.len {
        return 0
    }
    let mx = scroll_max_x(id)
    let mut nx = nodes.scrl[id].scroll_x + dx
    let mut v = dx
    if momentum == 0 {
        v = 0
    }
    if nx < 0 {
        nx = 0
        v = 0
    }
    if nx > mx {
        nx = mx
        v = 0
    }
    nodes.scrl[id].vel_x = v
    // The x twin of the note in `apply_delta_y`: the finger cancels the x ease,
    // and bit 8 suppresses the same-frame coast.
    let mut bitsx = int(nodes.scrl[id].smooth) & 13
    if momentum != 0 {
        bitsx = bitsx | 8
    }
    nodes.scrl[id].smooth = u8(bitsx)
    if nx == nodes.scrl[id].scroll_x {
        return 0
    }
    nodes.scrl[id].scroll_x = nx
    bar_on(id)
    mark_scroll_node(id)
    return 1
}

fn clamp_scroll(id: int) {
    if id <= 0 {
        return
    }
    if id >= nodes.tree.len {
        return
    }
    if nodes.scrl[id].scroll_x < 0 {
        nodes.scrl[id].scroll_x = 0
    }
    if nodes.scrl[id].scroll_y < 0 {
        nodes.scrl[id].scroll_y = 0
    }
    let mx = scroll_max_x(id)
    let my = scroll_max(id)
    if nodes.scrl[id].scroll_x > mx {
        nodes.scrl[id].scroll_x = mx
    }
    if nodes.scrl[id].scroll_y > my {
        nodes.scrl[id].scroll_y = my
    }
    mark_scroll_node(id)
}

// --- scrollbar thumb -------------------------------------------------------
//
// A desktop overlay scrollbar, timed on the wall clock (an idle host sleeps,
// the engine clock lags; the thumb must not). A scroll shows it: an ease-out
// fade-in, a linger at full opacity, then an ease-in-out fade-out. A scroll
// during the fade-out fades back in from the live alpha instead of popping.
// Pointing at the bar's edge strip makes it "hot": the thumb widens and the
// track appears (both eased), and it stays shown until the pointer leaves.
// Nothing here is a track or a live frame: paint reads the stamps, and
// `bar_next_ms` wakes the host only while something is in flight.
//
// Nested scrollers (a table inside the page) share one gutter when their right
// edges meet, so only one bar per chain is live: the "lead", whichever was last
// scrolled, dragged or pointed at. Its ancestors and descendants yield — they
// fade out fast and stop taking hits — so the bar under the pointer is always
// the one that moves. Unrelated scrollers (side-by-side panes) never yield.

const BAR_FADE_IN: int = 120
const BAR_FADE_OUT: int = 300
const BAR_LINGER: int = 800
const BAR_ALPHA: int = 140
/// How fast a yielding bar clears out of the lead's way.
const BAR_YIELD_MS: int = 100
/// Thumb thickness at rest and when hot, and the hot strip along the edge.
const BAR_W: int = 4
const BAR_W_HOT: int = 8
const BAR_HOT_STRIP: int = 14
const BAR_HOT_MS: int = 140

/// The scroller whose bar leads its nested chain (0 = none yet).
let mut bar_lead: int = 0

/// The scroller whose bar the pointer is on (0 = none), the one it just left,
/// when that changed, and each one's hot amount (0..1000) at that moment.
let mut bar_hot: int = 0
let mut bar_hot_prev: int = 0
let mut bar_hot_t: int = 0
let mut bar_hot_a0: int = 0
let mut bar_prev_a0: int = 0

/// Ease-out cubic over `t` in 0..1000 (fast start, soft landing).
fn ease_out_k(t: int) -> int {
    let u = 1000 - geometry.min2(geometry.max2(t, 0), 1000)
    return 1000 - u * u / 1000 * u / 1000
}

/// Smoothstep over `t` in 0..1000 (soft start and end).
fn ease_io_k(t: int) -> int {
    let u = geometry.min2(geometry.max2(t, 0), 1000)
    return u * u / 1000 * (3000 - 2 * u) / 1000
}

/// How long the thumb stays after the last scroll before it is fully gone.
fn bar_hide() -> int {
    return BAR_LINGER + BAR_FADE_OUT
}

/// Scroll / drag / pointer bumped the bar: it takes the lead of its chain,
/// related bars yield, and it shows (`bar_show`).
fn bar_on(id: int) {
    if id <= 0 {
        return
    }
    if id >= nodes.tree.len {
        return
    }
    let now = platform.plat_now_ms()
    // The live alpha first: a bar that was yielding fades back in from where
    // it is, not from the alpha it had before it yielded.
    let a_live = bar_alpha(id)
    bar_yield_related(id, now)
    bar_lead = id
    bar_show(id, now, a_live)
}

/// Motion the scroller is still finishing (a wheel ease, a momentum coast)
/// keeps its bar up, unless it yielded: follow-on frames never take the lead
/// back from the bar the user moved to.
fn bar_keep(id: int) {
    if id <= 0 {
        return
    }
    if id >= nodes.tree.len {
        return
    }
    if bar_yields(id) != 0 {
        return
    }
    let now = platform.plat_now_ms()
    bar_show(id, now, bar_alpha(id))
}

/// Show the bar and push the hide deadline out. A fade-in starts on the
/// hidden edge, or from the live alpha `a_live` when the bar was fading out;
/// a stream of scroll events at full opacity restarts nothing.
fn bar_show(id: int, now: int, a_live: int) {
    if nodes.scrl[id].bar_t <= now {
        nodes.scrl[id].bar_s = now
        nodes.scrl[id].bar_a0 = 0
    } else if nodes.scrl[id].bar_t - now < BAR_FADE_OUT {
        nodes.scrl[id].bar_a0 = a_live
        nodes.scrl[id].bar_s = now
    }
    nodes.scrl[id].bar_t = now + bar_hide()
    mark_paint_id(id)
}

/// 1 when one of `a` / `b` contains the other (the same scroll chain).
fn bar_related(a: int, b: int) -> int {
    if a <= 0 || b <= 0 || a == b {
        return 0
    }
    let n = nodes.tree.len
    if a >= n || b >= n {
        return 0
    }
    let mut p = nodes.tree[a].parent
    let mut guard = 0
    while p > 0 && p < n && guard < 256 {
        if p == b {
            return 1
        }
        p = nodes.tree[p].parent
        guard = guard + 1
    }
    p = nodes.tree[b].parent
    guard = 0
    while p > 0 && p < n && guard < 256 {
        if p == a {
            return 1
        }
        p = nodes.tree[p].parent
        guard = guard + 1
    }
    return 0
}

/// 1 while `id`'s bar stands aside for the lead: the lead is a different,
/// still-shown scroller in the same chain.
fn bar_yields(id: int) -> int {
    let l = bar_lead
    if l <= 0 || l == id || l >= nodes.tree.len {
        return 0
    }
    if int(nodes.tree[l].kind) != 11 {
        return 0
    }
    if bar_active(l) == 0 {
        return 0
    }
    return bar_related(id, l)
}

/// The lead is about to move to `id`: every shown bar in its chain starts a
/// `BAR_YIELD_MS` fade from its live alpha (kept in `bar_a0`), so two thumbs
/// never sit in one gutter for longer than that. Runs before `bar_lead`
/// changes, so the alpha read is the one on screen. A held thumb never yields.
fn bar_yield_related(id: int, now: int) {
    let n = nodes.tree.len
    for i in 1..n {
        if i == id {
            continue
        }
        if nodes.scrl[i].bar_t <= now {
            continue
        }
        if drag_id == i && drag_bar != 0 {
            continue
        }
        if bar_related(i, id) == 0 {
            continue
        }
        if bar_hot == i {
            bar_hot = 0
            bar_hot_prev = i
            bar_prev_a0 = 0
            bar_hot_t = now
        }
        let cut = now + BAR_YIELD_MS
        if nodes.scrl[i].bar_t > cut {
            nodes.scrl[i].bar_a0 = bar_alpha(i)
            nodes.scrl[i].bar_s = now - BAR_FADE_IN
            nodes.scrl[i].bar_t = cut
        }
        mark_paint_id(i)
    }
}

/// 1 while the bar should be visible: mid-drag, hot, or before its deadline.
fn bar_active(id: int) -> int {
    if drag_id == id {
        if drag_bar != 0 {
            return 1
        }
    }
    if bar_hot == id {
        return 1
    }
    if nodes.scrl[id].bar_t > platform.plat_now_ms() {
        return 1
    }
    return 0
}

/// Hot amount 0..1000 of `id`'s bar: easing up while the pointer is on it,
/// easing down after it left, from wherever it was.
fn bar_hot_amt(id: int) -> int {
    if id <= 0 {
        return 0
    }
    let dt = geometry.min2(geometry.max2(platform.plat_now_ms() - bar_hot_t, 0), BAR_HOT_MS)
    let k = ease_out_k(dt * 1000 / BAR_HOT_MS)
    if id == bar_hot {
        return bar_hot_a0 + (1000 - bar_hot_a0) * k / 1000
    }
    if id == bar_hot_prev {
        return bar_prev_a0 * (1000 - k) / 1000
    }
    return 0
}

fn bar_hot_moving() -> int {
    if bar_hot == 0 && bar_hot_prev == 0 {
        return 0
    }
    if platform.plat_now_ms() - bar_hot_t < BAR_HOT_MS {
        return 1
    }
    return 0
}

/// The pointer moved onto (`id` > 0) or off (`id` 0) a scroller's bar strip.
fn bar_set_hot(id: int) {
    if id == bar_hot {
        return
    }
    let was = bar_hot
    let a_was = bar_hot_amt(was)
    let a_new = bar_hot_amt(id)
    bar_hot_prev = was
    bar_prev_a0 = a_was
    bar_hot = id
    bar_hot_a0 = a_new
    bar_hot_t = platform.plat_now_ms()
    if was > 0 && was < nodes.tree.len {
        // Leaving keeps it on screen for the linger, then fades it.
        bar_on(was)
    }
    if id > 0 && id < nodes.tree.len {
        bar_on(id)
    }
}

/// 1 when (`px`, `py`) in window space is on scroller `id`'s bar strip and
/// that bar is shown and not yielding.
fn bar_strip_at(id: int, px: int, py: int) -> int {
    if id <= 0 || id >= nodes.tree.len {
        return 0
    }
    let sy = screen_scroll_of(id)
    let x = nodes.box[id].x - scroll_sx
    let y = nodes.box[id].y - sy
    let w = nodes.box[id].w
    let h = nodes.box[id].h
    if px < x || py < y || px >= x + w || py >= y + h {
        return 0
    }
    if bar_live(id) != 0 && px >= x + w - BAR_HOT_STRIP {
        return 1
    }
    if bar_live_x(id) != 0 && py >= y + h - BAR_HOT_STRIP {
        return 1
    }
    return 0
}

/// Scroll above `id` (window floaters stop it), y in the return, x in
/// `scroll_sx` — the screen offset of a scroller's own box.
let mut scroll_sx: int = 0

fn screen_scroll_of(id: int) -> int {
    let mut sx = 0
    let mut sy = 0
    if nodes.is_window_floater(id) == 0 {
        let mut p = nodes.tree[id].parent
        let mut guard = 0
        while p > 0 && guard < 64 {
            if int(nodes.tree[p].kind) == 11 {
                sx = sx + nodes.scrl[p].scroll_x
                sy = sy + nodes.scrl[p].scroll_y
            }
            if nodes.is_window_floater(p) != 0 {
                break
            }
            p = nodes.tree[p].parent
            guard = guard + 1
        }
    }
    scroll_sx = sx
    return sy
}

/// Per-frame: clear deadlines that passed and ask for one paint to hide the
/// thumb. Returns 1 if any bar just hid. Also records whether any bar is
/// mid-fade (`bar_fading`) while it is already walking the nodes.
fn bar_expire() -> int {
    let n = nodes.tree.len
    let mut hid = 0
    let mut fading = bar_hot_moving()
    let now = platform.plat_now_ms()
    for i in 1..n {
        let t = nodes.scrl[i].bar_t
        if t != 0 {
            if t <= now && bar_hot != i {
                nodes.scrl[i].bar_t = 0
                mark_paint_id(i)
                hid = 1
            } else if t > now {
                let since = now - nodes.scrl[i].bar_s
                let remain = t - now
                if since < BAR_FADE_IN || (remain < BAR_FADE_OUT && bar_hot != i) {
                    fading = 1
                }
            }
        }
    }
    if fading != 0 {
        if bar_hot > 0 && bar_hot < n {
            mark_paint_id(bar_hot)
        }
        if bar_hot_prev > 0 && bar_hot_prev < n {
            mark_paint_id(bar_hot_prev)
        }
    } else if bar_fading_live != 0 {
        // The ease just ended between frames: paint its final value once, or
        // the thumb rests a step short (9dp wide, alpha 179).
        for i in 1..n {
            if nodes.scrl[i].bar_t > now || i == bar_hot || i == bar_hot_prev {
                mark_paint_id(i)
            }
        }
        hid = 1
    }
    bar_fading_live = fading
    return hid
}

/// Milliseconds until the host must paint the bar again; 0 when none is shown.
/// 16 while a fade or hot ease is in flight, else one wake at the start of the
/// soonest fade-out (no busy loop while a thumb sits at full opacity).
fn bar_next_ms() -> int {
    let n = nodes.tree.len
    let mut soon = 0
    if bar_hot_moving() != 0 {
        soon = 16
    }
    let now = platform.plat_now_ms()
    for i in 1..n {
        if nodes.scrl[i].bar_t > now && bar_hot != i {
            let since = now - nodes.scrl[i].bar_s
            let remain = nodes.scrl[i].bar_t - now
            let mut d = 0
            if since < BAR_FADE_IN {
                d = 16
            } else if remain <= BAR_FADE_OUT {
                d = 16
            } else {
                d = remain - BAR_FADE_OUT
            }
            if soon == 0 || d < soon {
                soon = d
            }
        }
    }
    return soon
}

/// 1 while any thumb is inside a fade window (a fade-in or fade-out is in
/// flight), so `scene.step` marks the frame dirty and the fade advances even
/// though no scroll position changed. Read from `bar_expire`'s pass.
fn bar_fading() -> int {
    return bar_fading_live
}

fn bar_visible(id: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= nodes.tree.len {
        return 0
    }
    if int(nodes.tree[id].kind) != 11 {
        return 0
    }
    if scroll_max(id) <= 0 {
        return 0
    }
    return bar_active(id)
}

/// `bar_visible`, minus a bar that is yielding to its chain's lead: the bar
/// the pointer can hover, grab and drag.
fn bar_live(id: int) -> int {
    if bar_visible(id) == 0 {
        return 0
    }
    if bar_yields(id) != 0 {
        return 0
    }
    return 1
}

fn bar_live_x(id: int) -> int {
    if bar_visible_x(id) == 0 {
        return 0
    }
    if bar_yields(id) != 0 {
        return 0
    }
    return 1
}

fn bar_visible_x(id: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= nodes.tree.len {
        return 0
    }
    if nodes.scrolls_x(id) == 0 {
        return 0
    }
    if scroll_max_x(id) <= 0 {
        return 0
    }
    return bar_active(id)
}

fn bar_alpha(id: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= nodes.tree.len {
        return 0
    }
    // Held by the pointer or under it: fully opaque, no fade.
    if drag_id == id {
        if drag_bar != 0 {
            return BAR_ALPHA
        }
    }
    if bar_hot == id {
        return BAR_ALPHA
    }
    let now = platform.plat_now_ms()
    if nodes.scrl[id].bar_t <= now {
        return 0
    }
    if bar_yields(id) != 0 {
        // Standing aside: a short fade from the alpha it had when it yielded.
        let left = geometry.min2(nodes.scrl[id].bar_t - now, BAR_YIELD_MS)
        return nodes.scrl[id].bar_a0 * ease_io_k(left * 1000 / BAR_YIELD_MS) / 1000
    }
    let mut a = BAR_ALPHA
    let since = now - nodes.scrl[id].bar_s
    if since < BAR_FADE_IN {
        let a0 = nodes.scrl[id].bar_a0
        a = a0 + (BAR_ALPHA - a0) * ease_out_k(since * 1000 / BAR_FADE_IN) / 1000
    }
    let remain = nodes.scrl[id].bar_t - now
    if remain < BAR_FADE_OUT {
        a = a * ease_io_k(remain * 1000 / BAR_FADE_OUT) / 1000
    }
    if a < 0 {
        a = 0
    }
    return a
}

/// Track alpha: the track shows only while the bar is hot or dragged.
fn bar_track_alpha(id: int) -> int {
    let mut amt = bar_hot_amt(id)
    if drag_id == id && drag_bar != 0 {
        amt = 1000
    }
    return bar_alpha(id) * amt / 1000 * 36 / BAR_ALPHA
}

/// Base thumb thickness: the gutter the track geometry is built on, so a
/// widening thumb never moves along its track.
fn bar_w() -> int {
    return BAR_W
}

/// Drawn (and hit) thickness of `id`'s thumb: widens while hot or dragged.
fn bar_w_of(id: int) -> int {
    let mut amt = bar_hot_amt(id)
    if drag_id == id && drag_bar != 0 {
        amt = 1000
    }
    return BAR_W + (BAR_W_HOT - BAR_W) * amt / 1000
}

fn bar_x(id: int, ox: int) -> int {
    return ox + nodes.box[id].w - bar_w_of(id) - 3
}

fn bar_y(id: int, oy: int) -> int {
    return oy + 4
}

fn bar_track_h(id: int) -> int {
    let mut text_height = nodes.box[id].h - 8
    if bar_visible_x(id) != 0 {
        text_height = text_height - bar_w() - 2
    }
    return geometry.max2(text_height, 8)
}

fn bar_thumb_h(id: int) -> int {
    let text_height = bar_track_h(id)
    let mut thh = 32
    if nodes.box[id].ext_h > 0 {
        thh = geometry.max2(text_height * nodes.box[id].h / nodes.box[id].ext_h, 32)
    }
    if thh > text_height {
        thh = text_height
    }
    return thh
}

fn bar_thumb_y(id: int, oy: int) -> int {
    let maxs = scroll_max(id)
    let text_height = bar_track_h(id)
    let thh = bar_thumb_h(id)
    if maxs <= 0 {
        return bar_y(id, oy)
    }
    return bar_y(id, oy) + (text_height - thh) * nodes.scrl[id].scroll_y / maxs
}

fn bar_hx(id: int, ox: int) -> int {
    return ox + 4
}

fn bar_hy(id: int, oy: int) -> int {
    return oy + nodes.box[id].h - bar_w_of(id) - 3
}

fn bar_track_w(id: int) -> int {
    let mut text_width = nodes.box[id].w - 8
    if bar_visible(id) != 0 {
        text_width = text_width - bar_w() - 2
    }
    return geometry.max2(text_width, 8)
}

fn bar_thumb_w(id: int) -> int {
    let text_width = bar_track_w(id)
    let mut thw = 32
    if nodes.box[id].ext_w > 0 {
        thw = geometry.max2(text_width * nodes.box[id].w / nodes.box[id].ext_w, 32)
    }
    if thw > text_width {
        thw = text_width
    }
    return thw
}

fn bar_thumb_x(id: int, ox: int) -> int {
    let maxs = scroll_max_x(id)
    let text_width = bar_track_w(id)
    let thw = bar_thumb_w(id)
    if maxs <= 0 {
        return bar_hx(id, ox)
    }
    return bar_hx(id, ox) + (text_width - thw) * nodes.scrl[id].scroll_x / maxs
}

fn fg_of(id: int) -> int {
    if nodes.look[id].fg >= 0 {
        return paint_rgb(nodes.look[id].fg)
    }
    return 0
}

fn bind_pct(id: int) -> int {
    let mut v = sig_val(nodes.ui[id].bind_sig)
    if v < 0 {
        v = 0
    }
    if v > 100 {
        v = 100
    }
    return v
}

/// The window-space rect clipping what `id`'s parent paints: the intersection
/// of every scroller / `overflow` box above it, up to the nearest floater.
/// Written to `clip_*`; returns 0 when nothing clips it.
let mut clip_x0: int = 0
let mut clip_y0: int = 0
let mut clip_x1: int = 0
let mut clip_y1: int = 0

fn parent_clip_rect(id: int) -> int {
    let mut any = 0
    let mut p = nodes.tree[id].parent
    let mut guard = 0
    while p > 0 && guard < 64 {
        if int(nodes.tree[p].kind) == 11 || nodes.lay[p].overflow == 1 {
            // `p`'s own window position: its box minus the scroll above it.
            let mut sx = 0
            let mut sy = 0
            if nodes.is_window_floater(p) == 0 {
                let mut q = nodes.tree[p].parent
                let mut g2 = 0
                while q > 0 && g2 < 64 {
                    if int(nodes.tree[q].kind) == 11 {
                        sx = sx + nodes.scrl[q].scroll_x
                        sy = sy + nodes.scrl[q].scroll_y
                    }
                    if nodes.is_window_floater(q) != 0 {
                        break
                    }
                    q = nodes.tree[q].parent
                    g2 = g2 + 1
                }
            }
            let x0 = nodes.box[p].x - sx
            let y0 = nodes.box[p].y - sy
            let x1 = x0 + nodes.box[p].w
            let y1 = y0 + nodes.box[p].h
            if any == 0 {
                clip_x0 = x0
                clip_y0 = y0
                clip_x1 = x1
                clip_y1 = y1
                any = 1
            } else {
                clip_x0 = geometry.max2(clip_x0, x0)
                clip_y0 = geometry.max2(clip_y0, y0)
                clip_x1 = geometry.min2(clip_x1, x1)
                clip_y1 = geometry.min2(clip_y1, y1)
            }
        }
        if nodes.is_floater(p) != 0 {
            break
        }
        p = nodes.tree[p].parent
        guard = guard + 1
    }
    return any
}

/// 1 unless `id` floats with `clip` set and the pointer is outside the clip
/// its parent paints under.
fn ptr_in_float_clip(id: int) -> int {
    if int(nodes.pin[id].fl_clip) == 0 {
        return 1
    }
    if parent_clip_rect(id) == 0 {
        return 1
    }
    if ptr_x < clip_x0 || ptr_y < clip_y0 || ptr_x >= clip_x1 || ptr_y >= clip_y1 {
        return 0
    }
    return 1
}

fn floater_clear() {
    let n = floater_id.len
    for i in 0..n {
        pop(floater_id)
        pop(floater_z)
        pop(floater_screen_x)
        pop(floater_screen_y)
    }
}

fn floater_push(id: int, sx: int, sy: int) {
    push(floater_id, id)
    push(floater_z, int(nodes.pin[id].z_index))
    push(floater_screen_x, sx)
    push(floater_screen_y, sy)
}

/* Hit-pass memo: a subtree the last walk found to hold no floater is stamped
   with `floater_gen` and skipped until the generation moves. A floater appears,
   shows or hides only through a layout-relevant change (a tree or layout mark,
   a prop write, a layout run), and each of those bumps the generation. A walk
   that pruned a scroller by the pointer saw only part of the subtree, so it
   stamps nothing above the prune. The paint pass keeps the full walk: it also
   visits nodes still fading out, which no layout event announces. */
let mut floater_gen: int = 1
let mut fc_prunes: int = 0
/// Next `open_ord` for an anchored popup that just became visible.
let mut popup_ord: int = 0
/// Gap, in dp, under which two anchored popups count as near. Overlap is
/// near. Farther apart, a newer popup does not climb over an older one.
const POPUP_NEAR: int = 8

/// Remember which anchored popup opened most recently. A fade keeps the old
/// order until the panel is gone, and the next show takes a fresh one.
fn note_popup_stack(id: int) {
    if id <= 0 || id >= nodes.pin.len {
        return
    }
    if nodes.pin[id].anchor <= 0 {
        return
    }
    if want_show(id) != 0 {
        if nodes.pin[id].open_ord == 0 || int(nodes.pin[id].popup_closed) != 0 {
            popup_ord = popup_ord + 1
            nodes.pin[id].open_ord = popup_ord
        }
        nodes.pin[id].popup_closed = u8(0)
        return
    }
    nodes.pin[id].popup_closed = u8(1)
    if want_paint(id) == 0 {
        nodes.pin[id].open_ord = 0
    }
}

fn floater_collect(id: int, sx: int, sy: int, paint: int) {
    if id <= 0 {
        return
    }
    note_popup_stack(id)
    if paint != 0 {
        if want_paint(id) == 0 {
            return
        }
    } else {
        if nodes.tree[id].fc_none == floater_gen {
            return
        }
        if want_show(id) == 0 {
            return
        }
    }
    let pushed0 = floater_id.len
    let prunes0 = fc_prunes
    if nodes.is_floater(id) != 0 {
        if paint == 0 {
            floater_push(id, sx, sy)
        } else if nodes.is_window_floater(id) != 0 {
            if fc_skip_window == 0 {
                floater_push(id, sx, sy)
            }
        } else if fc_nested == 0 {
            floater_push(id, sx, sy)
        }
        return
    }
    let mut cx = sx
    let mut cy = sy
    if paint == 0 {
        if int(nodes.tree[id].kind) == 11 {
            // Hit pass: a relative floater inside a scroller keeps its
            // parent's content coordinates, so carry the scroll down and
            // skip the scroller when the pointer is outside its viewport
            // (the old tree-order walk did both).
            if in_box(id, ptr_x + sx, ptr_y + sy) == 0 {
                fc_prunes = fc_prunes + 1
                return
            }
            cx = sx + nodes.scrl[id].scroll_x
            cy = sy + nodes.scrl[id].scroll_y
        }
    }
    let nk = nodes.tree[id].kids.len
    for i in 0..nk {
        let c = nodes.tree[id].kids[i]
        if paint != 0 && c > 0 && int(nodes.tree[c].kind) == 11 {
            // That scroller paints its own in-place floaters.
            let was = fc_nested
            fc_nested = 1
            floater_collect(c, cx, cy, paint)
            fc_nested = was
        } else {
            floater_collect(c, cx, cy, paint)
        }
    }
    if paint == 0 && floater_id.len == pushed0 && fc_prunes == prunes0 {
        nodes.tree[id].fc_none = floater_gen
    }
}

fn floater_swap(i: int, j: int) {
    let id = floater_id[i]
    let z = floater_z[i]
    let sx = floater_screen_x[i]
    let sy = floater_screen_y[i]
    floater_id[i] = floater_id[j]
    floater_z[i] = floater_z[j]
    floater_screen_x[i] = floater_screen_x[j]
    floater_screen_y[i] = floater_screen_y[j]
    floater_id[j] = id
    floater_z[j] = z
    floater_screen_x[j] = sx
    floater_screen_y[j] = sy
}

/// Insertion sort. `desc` 1 = high z first (hit-test), 0 = low z first (paint).
/// Equal z keeps tree order, then near popups reorder by open time.
fn floater_sort(desc: int) {
    let n = floater_id.len
    for i in 1..n {
        let mut j = i
        while j > 0 {
            let mut swap = 0
            if desc != 0 {
                if floater_z[j - 1] < floater_z[j] {
                    swap = 1
                }
            } else {
                if floater_z[j - 1] > floater_z[j] {
                    swap = 1
                }
            }
            if swap == 0 {
                break
            }
            floater_swap(j - 1, j)
            j = j - 1
        }
    }
    floater_near_order(desc)
}

/// 1 when the two floater boxes are within `POPUP_NEAR` dp, edges included.
/// Both are anchored panels, so the box is already in window coordinates.
fn floater_near(i: int, j: int) -> int {
    let a = floater_id[i]
    let b = floater_id[j]
    let ax = nodes.box[a].x
    let ay = nodes.box[a].y
    let bx = nodes.box[b].x
    let by = nodes.box[b].y
    if ax + nodes.box[a].w + POPUP_NEAR <= bx {
        return 0
    }
    if bx + nodes.box[b].w + POPUP_NEAR <= ax {
        return 0
    }
    if ay + nodes.box[a].h + POPUP_NEAR <= by {
        return 0
    }
    if by + nodes.box[b].h + POPUP_NEAR <= ay {
        return 0
    }
    return 1
}

/// Within one equal-z run, anchored popups that sit near each other paint
/// and hit in open order. `desc` 0 paints the newer one last (on top); `desc`
/// 1 hit-tests it first. A popup outside the cluster keeps its slot, so a
/// newer panel across the page does not climb over this one.
fn floater_near_run(lo: int, hi: int, desc: int) {
    let mut ids = []int {}
    for t in lo..hi {
        let id = floater_id[t]
        if nodes.pin[id].anchor > 0 && nodes.pin[id].open_ord > 0 {
            if nodes.box[id].w > 0 && nodes.box[id].h > 0 {
                push(ids, t)
            }
        }
    }
    let m = ids.len
    if m < 2 {
        return
    }
    let mut lab = []int {}
    for a in 0..m {
        push(lab, a)
    }
    for a in 0..m {
        let start = a + 1
        for b in start..m {
            if floater_near(ids[a], ids[b]) != 0 {
                let mut keep = lab[a]
                let mut drop = lab[b]
                if keep != drop {
                    if keep > drop {
                        let tmp = keep
                        keep = drop
                        drop = tmp
                    }
                    for c in 0..m {
                        if lab[c] == drop {
                            lab[c] = keep
                        }
                    }
                }
            }
        }
    }
    for a in 0..m {
        if lab[a] != a {
            continue
        }
        let mut count = 0
        for c in 0..m {
            if lab[c] == a {
                count = count + 1
            }
        }
        if count < 2 {
            continue
        }
        let mut slots = []int {}
        let mut ords = []int {}
        for c in 0..m {
            if lab[c] == a {
                push(slots, ids[c])
                push(ords, nodes.pin[floater_id[ids[c]]].open_ord)
            }
        }
        let mut order = []int {}
        for s in 0..count {
            push(order, s)
        }
        for s in 1..count {
            let mut k = s
            while k > 0 {
                let prev = ords[order[k - 1]]
                let cur = ords[order[k]]
                let mut do_swap = 0
                if desc != 0 {
                    if prev < cur {
                        do_swap = 1
                    }
                } else if prev > cur {
                    do_swap = 1
                }
                if do_swap == 0 {
                    break
                }
                let tmp = order[k - 1]
                order[k - 1] = order[k]
                order[k] = tmp
                k = k - 1
            }
        }
        let mut tmp_id = []int {}
        let mut tmp_z = []int {}
        let mut tmp_x = []int {}
        let mut tmp_y = []int {}
        for p in 0..count {
            let src = slots[order[p]]
            push(tmp_id, floater_id[src])
            push(tmp_z, floater_z[src])
            push(tmp_x, floater_screen_x[src])
            push(tmp_y, floater_screen_y[src])
        }
        for p in 0..count {
            let dst = slots[p]
            floater_id[dst] = tmp_id[p]
            floater_z[dst] = tmp_z[p]
            floater_screen_x[dst] = tmp_x[p]
            floater_screen_y[dst] = tmp_y[p]
        }
    }
}

/// Apply `floater_near_run` to each equal-z run. z-order itself stays put.
fn floater_near_order(desc: int) {
    let n = floater_id.len
    if n < 2 {
        return
    }
    let mut i = 0
    while i < n {
        let z = floater_z[i]
        let mut j = i + 1
        while j < n {
            if floater_z[j] != z {
                break
            }
            j = j + 1
        }
        if j - i >= 2 {
            floater_near_run(i, j, desc)
        }
        i = j
    }
}

/// Paint-time ring color for the keyboard-focused node. Theme slot 36 is
/// registered by the design system's `roles()` (foreground in both
/// appearances); before that it falls back to paint_rgb(0) = black.
fn focus_ring_rgb() -> int {
    return paint_rgb(2130706432 + 36)
}

fn is_focusable(id: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= nodes.tree.len {
        return 0
    }
    if int(nodes.ui[id].focusable) != 0 {
        return 1
    }
    if int(nodes.tree[id].kind) == 10 {
        return 1
    }
    return 0
}

/// Subtree Tab walks while a modal is open: the trapped node if it is still
/// shown in the tree, otherwise the window root.
fn focus_walk_root() -> int {
    if trap_id > 0 {
        if shown_in_tree(trap_id) != 0 {
            return trap_id
        }
    }
    return root_id
}

/// Install a modal trap on `id`. Saves the current focus and moves into the
/// first focusable descendant (or `id` itself).
fn claim_trap(id: int) {
    if id <= 0 {
        return
    }
    if trap_id != id {
        trap_restore = focus_id
        trap_id = id
    }
    let keep = focus_ring
    focus_ring = []int {}
    collect_focus(id)
    let mut first = 0
    let n = focus_ring.len
    let mut i = 0
    while i < n {
        if focus_ring[i] != id {
            first = focus_ring[i]
            break
        }
        i = i + 1
    }
    focus_ring = keep
    if first == 0 {
        first = id
    }
    claim_focus(first)
}

/// Release the trap if it is still `id`, and put focus back where it was.
fn release_trap(id: int) {
    if trap_id != id {
        return
    }
    trap_id = 0
    let back = trap_restore
    trap_restore = 0
    if back > 0 {
        claim_focus(back)
    }
}

fn collect_focus(id: int) {
    if id <= 0 {
        return
    }
    if id >= nodes.tree.len {
        return
    }
    if want_show(id) == 0 {
        return
    }
    if is_focusable(id) != 0 {
        push(focus_ring, id)
    }
    let nk = nodes.tree[id].kids.len
    for i in 0..nk {
        collect_focus(nodes.tree[id].kids[i])
    }
}

fn snapshot_focus() {
    focus_ring = []int {}
    collect_focus(focus_walk_root())
    focus_at = -1
    let n = focus_ring.len
    for i in 0..n {
        if focus_ring[i] == focus_id {
            focus_at = i
        }
    }
}

fn restore_focus() {
    focus_ring = []int {}
    collect_focus(focus_walk_root())
    if focus_at < 0 {
        focus_id = 0
        return
    }
    if focus_at >= focus_ring.len {
        focus_id = 0
        return
    }
    focus_id = focus_ring[focus_at]
}

fn claim_focus(id: int) {
    if id <= 0 {
        return
    }
    if id >= nodes.tree.len {
        return
    }
    if is_focusable(id) != 0 {
        if focus_id != id {
            mark_paint()
        }
        focus_id = id
        return
    }
    claim_focus(nodes.tree[id].parent)
}

/// A roving group moved its pick to `id`: carry focus along only if focus is
/// already in the group — on one of `id`'s siblings, or inside one — or the
/// pointer just pressed `id`. A pick set from elsewhere (a button, a route,
/// the group's own mount) must not pull focus away from where the user is.
fn claim_roving_focus(id: int) {
    if id <= 0 {
        return
    }
    if id >= nodes.tree.len {
        return
    }
    // The press that made this the pick: walk up from the pressed node.
    let mut t = press_target
    let mut tguard = 0
    while t > 0 && t < nodes.tree.len && tguard < 64 {
        if t == id {
            claim_focus(id)
            return
        }
        t = nodes.tree[t].parent
        tguard = tguard + 1
    }
    let group = nodes.tree[id].parent
    let mut f = focus_id
    let mut guard = 0
    while f > 0 && f < nodes.tree.len && guard < 64 {
        if nodes.tree[f].parent == group {
            claim_focus(id)
            return
        }
        f = nodes.tree[f].parent
        guard = guard + 1
    }
}

fn walk_focus_chain(id: int) {
    if id <= 0 {
        return
    }
    if id >= nodes.tree.len {
        return
    }
    push(chain_nodes, id)
    push(chain_ctxs, nodes.ui[id].key_ctx)
    walk_focus_chain(nodes.tree[id].parent)
}

fn fill_focus_chain() {
    chain_nodes = []int {}
    chain_ctxs = []int {}
    walk_focus_chain(focus_id)
    let depth = chain_nodes.len
    if depth == 0 {
        push(chain_nodes, 0)
        push(chain_ctxs, 0)
        return
    }
    if depth < 2 {
        return
    }
    let n = depth - 1
    for k in 0..n {
        let i = depth - 2 - k
        if chain_ctxs[i] == 0 {
            chain_ctxs[i] = chain_ctxs[i + 1]
        }
    }
}

fn focus_captures_text() -> int {
    if focus_id <= 0 {
        return 0
    }
    if focus_id >= nodes.tree.len {
        return 0
    }
    if want_show(focus_id) == 0 {
        return 0
    }
    if nodes.ui[focus_id].capture_text != 0 {
        return 1
    }
    if int(nodes.tree[focus_id].kind) == 10 {
        return 1
    }
    return 0
}

fn focus_step(back: int) -> int {
    focus_ring = []int {}
    collect_focus(focus_walk_root())
    let count = focus_ring.len
    if count == 0 {
        return 0
    }
    let mut at = -1
    for i in 0..count {
        if focus_ring[i] == focus_id {
            at = i
        }
    }
    let mut next = 0
    if at < 0 {
        if back != 0 {
            next = count - 1
        } else {
            next = 0
        }
    } else if back != 0 {
        next = at - 1
        if next < 0 {
            next = count - 1
        }
    } else {
        next = at + 1
        if next >= count {
            next = 0
        }
    }
    if focus_ring[next] == focus_id {
        return 0
    }
    focus_id = focus_ring[next]
    kb_focus = 1
    mark_paint()
    return 1
}

fn stamp_edits() {
    let n = nodes.tree.len
    let mut slot = 0
    for i in 0..n {
        if int(nodes.tree[i].kind) == 10 {
            nodes.ui[i].edit_slot = slot
            slot = slot + 1
        }
    }
}

fn input_shown(id: int) -> string {
    let slot = nodes.ui[id].edit_slot
    if slot < 0 {
        return nodes.look[id].text
    }
    edit_sync_secure(id, slot)
    let shown = runtime.edit_shown(slot)
    if shown.len > 0 {
        return shown
    }
    if secure_ids.len > 0 && runtime.edit_len(slot) > 0 {
        return shown
    }
    if runtime.edit_len(slot) > 0 {
        return runtime.edit_text(slot)
    }
    return nodes.look[id].text
}

/// 1 while an input paints its placeholder: no editor text and no masked
/// display string. `paint_input` dims it so it does not read as a value.
fn input_is_placeholder(id: int) -> int {
    let slot = nodes.ui[id].edit_slot
    if slot < 0 {
        return 1
    }
    edit_sync_secure(id, slot)
    if runtime.edit_shown(slot).len > 0 {
        return 0
    }
    if runtime.edit_len(slot) > 0 {
        return 0
    }
    return 1
}

fn input_committed(id: int) -> string {
    let slot = nodes.ui[id].edit_slot
    if slot < 0 {
        return ""
    }
    return runtime.edit_text(slot)
}

fn input_inner_w(id: int) -> int {
    let w = inner_w(id)
    if w < 1 {
        return 1
    }
    return w
}

fn edit_ready(id: int) -> int {
    if id <= 0 {
        return -1
    }
    if id >= nodes.tree.len {
        return -1
    }
    if int(nodes.tree[id].kind) != 10 {
        return -1
    }
    if nodes.ui[id].edit_slot < 0 {
        stamp_edits()
    }
    let slot = nodes.ui[id].edit_slot
    if slot < 0 {
        return -1
    }
    edit_sync_secure(id, slot)
    let mut font = i32(nodes.look[id].font)
    if font < 8 {
        font = 14
    }
    runtime.edit_metrics(slot, input_inner_w(id), font)
    return slot
}

// --- reactive style rows -------------------------------------------------
// A reactive `style` prop diffs each run against the last `Style` it wrote.
// Only reactive elements keep one (a static style is written once and keeps
// nothing), and a freed node returns its row, so the table stays as small as
// the number of live reactive styles. The node -> row index lives in its own
// table rather than in the node records, so an app with no reactive style pays
// nothing per node.

let mut style_rows: []Style = []Style {}
let mut style_free: []int = []int {}
/// `style_row_of[node_id]` = its row in `style_rows`, 0 = none. Grown on
/// demand, only when a reactive style is first kept.
let mut style_row_of: []int = []int {}

/// The row `id` holds, or 0.
fn style_row(id: int) -> int {
    if id > 0 && id < style_row_of.len {
        return style_row_of[id]
    }
    return 0
}

/// The last `Style` written to `id`, or an empty one (every key absent).
fn style_last(id: int) -> Style {
    let row = style_row(id)
    if row > 0 {
        return style_rows[row]
    }
    return Style {}
}

/// Record `s` as the last `Style` written to `id`.
fn style_keep(id: int, s: Style) {
    if id <= 0 || id >= nodes.tree.len {
        return
    }
    let mut row = style_row(id)
    if row == 0 {
        if style_rows.len == 0 {
            push(style_rows, Style {})
        }
        if style_free.len > 0 {
            row = style_free[style_free.len - 1]
            pop(style_free)
        } else {
            push(style_rows, Style {})
            row = style_rows.len - 1
        }
        while style_row_of.len <= id {
            push(style_row_of, 0)
        }
        style_row_of[id] = row
    }
    style_rows[row] = s
}

/// Return `id`'s row, if it holds one.
fn style_forget(id: int) {
    let row = style_row(id)
    if row > 0 {
        style_rows[row] = Style {}
        push(style_free, row)
        style_row_of[id] = 0
    }
}

/// Live reactive-style rows, for tests: churning reactive elements must not
/// grow it.
fn style_row_count() -> int {
    if style_rows.len == 0 {
        return 0
    }
    return style_rows.len - 1 - style_free.len
}

// --- state styles ---------------------------------------------------------
// A node with `hoverStyle` / `pressStyle` / `focusStyle` / `disabledStyle`
// owns a 0..15 mask signal that its style effect reads. The interaction state
// is derived on demand (pointer, press, focus, the disabled flag), so once a
// frame `state_sync` recomputes the mask of every watched node and writes the
// signal only when it moved: the style effect re-runs on a real transition.
// Such a node paints no default hover wash or press overlay: its state styles
// are its feedback.

/// Mask bits a state style can follow.
const STATE_HOVER: int = 1
const STATE_PRESS: int = 2
const STATE_FOCUS: int = 4
const STATE_DISABLED: int = 8

/// `state_sig_of[node_id]` = its mask signal, 0 = not watched.
let mut state_sig_of: []int = []int {}
let mut state_mask_of: []int = []int {}
/// Watched node ids, so the sync visits only them.
let mut state_ids: []int = []int {}

fn state_watched(id: int) -> int {
    if id > 0 && id < state_sig_of.len {
        if state_sig_of[id] > 0 {
            return 1
        }
    }
    return 0
}

/// The mask `id` shows now.
fn state_mask(id: int) -> int {
    let st = interaction_state(id)
    let mut m = 0
    if state_has(st, UISTATE.StHovered) {
        m = m | STATE_HOVER
    }
    if state_has(st, UISTATE.StPressed) {
        m = m | STATE_PRESS
    }
    if state_has(st, UISTATE.StFocusVisible) {
        m = m | STATE_FOCUS
    }
    if state_has(st, UISTATE.StDisabled) {
        m = m | STATE_DISABLED
    }
    return m
}

/// Start tracking `id`'s interaction state into `sig_id`. Returns the mask now.
fn state_watch(id: int, sig_id: int) -> int {
    if id <= 0 || id >= nodes.tree.len {
        return 0
    }
    while state_sig_of.len <= id {
        push(state_sig_of, 0)
        push(state_mask_of, 0)
    }
    if state_sig_of[id] == 0 {
        push(state_ids, id)
    }
    state_sig_of[id] = sig_id
    let m = state_mask(id)
    state_mask_of[id] = m
    return m
}

fn state_unwatch(id: int) {
    if state_watched(id) == 0 {
        return
    }
    state_sig_of[id] = 0
    state_mask_of[id] = 0
    let n = state_ids.len
    for i in 0..n {
        if state_ids[i] == id {
            state_ids[i] = state_ids[n - 1]
            pop(state_ids)
            return
        }
    }
}

/// Once a frame: write each watched node's mask signal if its state moved.
fn state_sync() {
    let n = state_ids.len
    for i in 0..n {
        let id = state_ids[i]
        let m = state_mask(id)
        if m != state_mask_of[id] {
            state_mask_of[id] = m
            store_sig(state_sig_of[id], m)
        }
    }
}

/// Watched nodes, for tests: churn must not grow it.
fn state_watch_count() -> int {
    return state_ids.len
}
