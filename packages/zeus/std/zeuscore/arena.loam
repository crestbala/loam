//! arena — retained tree, signals, window/frame state (GPUI arena.rs).
//! Layout, scene, and input read and write these globals as arena.nodes.
//!
//! UiNode.kind: 1 box, 2 grid, 3 label, 4 button, 5 spacer, 6 progress,
//! 7 toggle, 8 check, 9 overlay, 10 input, 11 scroll, 12 svg, 13 slider.
//! overflow: 0 visible, 1 hidden, 2 scroll-y auto, 3 scroll-xy auto.

import "geometry.loam"
import "platform.loam"
import "track.loam"

struct UiNode {
    kids: []int,
    text: string,
    a11y_label: string,
    a11y_role: string,
    /// CSS cursor shown while the pointer is over this node ("" = default).
    cursor: string,

    grow: int,
    shrink: int,
    bg: int,
    /// Second fill color for a vertical gradient (`bg` → `bg2`). `-1` = solid `bg`.
    bg2: int,
    fg: int,
    ew: int,
    eh: int,
    min_w: int,
    max_w: int,
    min_h: int,
    max_h: int,
    bind_sig: int,
    click_sig: int,
    click_set: int,
    click2_sig: int,
    click2_set: int,
    show_sig: int,
    show_val: int,
    hover_sig: int,
    x: int,
    y: int,
    w: int,
    h: int,
    iw: int,
    ih: int,
    nid: int,
    m_t: int,
    m_r: int,
    m_b: int,
    m_l: int,
    border_c: int,
    aspect_w: int,
    aspect_h: int,
    pin_t: int,
    pin_r: int,
    pin_b: int,
    pin_l: int,
    scroll_x: int,
    scroll_y: int,
    tw: int,
    th: int,
    /// 0..100 ease of the press overlay. Rest is 0, so DRAW goldens hold.
    aw: int,
    ah: int,
    /// Smooth wheel scroll: the position eases toward `tgt_x` / `tgt_y` each
    /// frame while the matching `smooth` bit (1 = y, 2 = x) is set. Bounded —
    /// a notch converges in ~150 ms and retargets on the next notch — unlike
    /// the momentum coast, which decays from a velocity.
    tgt_x: int,
    tgt_y: int,
    smooth: u8,
    /// Wall-clock deadline (ms) until which the scrollbar thumb is shown;
    /// 0 = hidden. Set on every scroll, no track: the thumb appears and
    /// disappears in one frame each, and `bar_next_ms` wakes the host once.
    bar_t: int,
    parent: int,
    key_ctx: int,
    edit_slot: int,
    click_fn: int,
    restyle_fn: int,
    tween: int,
    down_fn: int,
    up_fn: int,
    kdown_fn: int,
    kup_fn: int,
    kpress_fn: int,
    edit_sig: int,
    bind_fn: int,
    list_fn: int,
    list_gen: int,
    /// Windowed `For` / `VirtualList`: first rendered index, exclusive last,
    /// live item count, and the fixed row height used for spacers. `row_h`
    /// 0 means "not windowed" (build every child).
    list_lo: int,
    list_hi: int,
    list_n: int,
    row_h: int,
    /// Scroll physics. Wheel / pan writes a velocity; `physics_step` coasts
    /// and stops exactly at the content bounds (0..max — never past them, so
    /// no blank strip is ever revealed past the first/last content).
    vel_x: int,
    vel_y: int,
    /// Clockwise-on-screen degrees for text nodes (0 = horizontal).

    /// Style lengths in dp, unscaled (the DPI scale is applied at paint), so
    /// the stored value is the authored value. Each is at most the `u16`
    /// maximum (65535); an out-of-range literal is a compile error at the
    /// literal, not a runtime trap.
    pad: u16,
    padx: u16,
    pady: u16,
    pad_t: u16,
    pad_r: u16,
    pad_b: u16,
    pad_l: u16,
    gap: u16,
    gap_row: u16,
    gap_col: u16,
    radius: u16,
    /// Border width in dp. `-1` at the props layer is "unset" and maps to 0, so
    /// `content_x`/`content_y` never add a negative inset.
    border_w: u16,
    /// Font size in px. On svg nodes it also carries the `fit` mode.
    font: u16,
    span: u16,
    grid_cols: u16,
    grid_min: u16,
    opacity: i16,
    z_index: i16,
    text_rot: u16,

    kind: u8,
    dir: u8,
    justify: u8,
    pos: u8,
    wrap: u8,
    reverse: u8,
    click_mode: u8,
    click2_mode: u8,
    focusable: u8,
    pulse: u8,
    press_amt: u8,
    hover_amt: u8,
    show_amt: u8,
    enter_fade: u8,
    safe: u8,
    /// Dirty-channel bits (see `mark_paint` / `mark_layout`). Bit 0 PAINT,
    /// bit 1 LAYOUT, bit 2 TREE. A node is marked when a discrete write or an
    /// animation tick changes it; paint drains the marks.
    dirty: u8,
    /// Animated paint transform: scale percent (100 = identity), translate in
    /// dp, and rotation in degrees. Written only by paint-only tracks; the
    /// layout pass never reads them, so a transform never forces a layout.
    an_scale: u16,
    an_tx: i16,
    an_ty: i16,
    an_rot: u16,
    /// Paint-only reveal: 1 opts in (`enter_reveal`), `an_reveal` is the share
    /// of the laid-out height paint shows, 0..100, clipped from the top with
    /// the content slid up by the hidden part. Layout sees the full box at
    /// once; only paint catches up, so an opening disclosure never re-lays
    /// out per frame (the "animated height" the audit deferred).
    reveal: u8,
    an_reveal: u8,
    /// Indeterminate rotation (a `Spinner`): 1 = spin, period in ms. Driven by
    /// the frame clock in paint, like `pulse`, so it needs no track and is
    /// deterministic at `now_ms == 0`.
    spin_ms: u16,
    spin: u8,
    /// Anchor-based floating placement (popover / tooltip / hover card). When
    /// `anchor` > 0 the node is positioned at layout time against that node's
    /// screen rect: `place` is the preferred side, `anchor_gap` the offset in
    /// dp, and `flip` allows the opposite side when the preferred one would
    /// overflow.
    anchor: int,
    anchor_gap: u16,
    place: u8,
    flip: u8,
    /// Elevation 0..4. `elev_c` holds the shadow color's role sentinel so the
    /// paint pass resolves it per appearance (like every other role).
    elev: u8,
    elev_c: int,
    /// Interaction-state overlay flags (see `UISTATE` / `interaction_state`).
    /// Components do not reimplement these; one shared model reads them.
    disabled: u8,
    loading: u8,
    invalid: u8,
    w_pct: i8,
    h_pct: i8,
    align_self: i8,
    hover_fade: i8,
    align: u8,
    show_mode: u8,
    /// Declarative `show` prop result (0 hidden / 1 visible); consulted when
    /// no `show_sig` is bound. Signal shows (`show` / `show_eq` / `If`) win.
    show_on: u8,
    overflow: u8,
    grid_auto: u8,
    /// 1 = press overlay while this node is `down_id` (buttons).
    press: u8,
    capture_text: u8,
    ui_size: u8,
    ui_look: u8,
}

let mut nodes: []UiNode = []UiNode {}
let mut sigs: []int = []int {}
let mut root_id: int = 0
let mut win_w: int = 640
let mut win_h: int = 480
let mut appearance_sid: int = 0
let mut inited: int = 0
let mut theme_l: []int = []int {}
let mut theme_d: []int = []int {}
let mut szbuf: []int = []int {}
let mut szlay: []int = []int {}
let mut focus_id: int = 0
let mut focus_at: int = -1
let mut chain_nodes: []int = []int {}
let mut chain_ctxs: []int = []int {}
let mut focus_ring: []int = []int {}
/// 1 = focus arrived by keyboard (tab/shift-tab); the painted focus ring
/// shows only then, and a pointer click clears it (desktop convention).
let mut kb_focus: int = 0
let mut paint_sy: int = 0
let mut paint_sx: int = 0
let mut drag_id: int = 0
let mut drag_ay: int = 0
let mut drag_as: int = 0
let mut drag_bar: int = 0
let mut pulse_t: int = 0
let mut ptr_x: int = 0
let mut ptr_y: int = 0
/// Staged input payload. The engine invokes argument-less interned handlers,
/// so `MouseEvent` / `KeyEvent` are read from here by `current_mouse()` /
/// `current_key()` inside the handler.
let mut ev_x: int = 0
let mut ev_y: int = 0
let mut ev_button: int = 0
let mut ev_key: int = 0
let mut ev_mods: int = 0
let mut down_id: int = 0
let mut paint_skip_z: int = 1
let mut safe_t: int = 0
let mut safe_r: int = 0
let mut safe_b: int = 0
let mut safe_l: int = 0

// --- rebuild-scope bookkeeping ---
// `For` / `refit` hosts rebuild their subtree from a builder. Anything the
// builder allocates — signals (`sig_new`) and interned handlers (recorded via
// `record_intern`) — is owned by the host node for as long as the build
// stands; tearing the host down (rebuild or drop) frees those ids and makes
// them recyclable, so streaming lists do not grow the arena.
// `scope_node` is the host whose builder is currently running (0 = none).
let mut scope_node: int = 0
let mut rec_sid: []int = []int {}
let mut rec_owner: []int = []int {}
let mut rec_fid: []int = []int {}
let mut rec_fowner: []int = []int {}
/// Freed node ids, recycled by `alloc_node`.
let mut free_nodes: []int = []int {}

/* Ids freed by the current drop_children pass: effect teardown runs once per
   subtree (track.free_nodes_effects) instead of once per node — per-node
   table sweeps made every chart refit ~25 ms. */
let mut drop_pool: []int = []int {}

// --- dirty channels + frame clock (Phase 3) --------------------------------
//
// `paint_dirty` gates the draw pass, `layout_dirty` the layout pass. A frame
// with only PAINT dirt skips `layout.layout()` and every reactive scope: the
// value that changed was written straight into node paint state by an
// animation track, which never touches the signal graph. `chrome_dirty` asks
// the shared interaction-state pass to recompute hover/press/tween/fade tracks
// from discrete state; it is driven by events, not by the frame clock.
let mut paint_dirty: int = 1
let mut layout_dirty: int = 1
let mut tree_dirty: int = 1
let mut chrome_dirty: int = 1
/// A scroller moved: paint-only, but a windowed list's visible window may have
/// shifted, so the virtual refresh pass must run before paint.
let mut virt_dirty: int = 0
/// Node ids whose PAINT bit was set since the last paint. The animation tick
/// appends here; `scene.paint` drains it. Ids are deduped by the PAINT bit.
let mut dirty_paint: []int = []int {}
/// Monotonic frame clock in ms, advanced by the host-supplied delta.
let mut now_ms: int = 0
/// Tracks with `pulse` (skeleton shimmer) currently alive.
let mut pulse_count: int = 0
/// Anchored floaters placed by the last layout (0 when none are on screen). A
/// scroll must re-place them so a popup stays next to its trigger; when there
/// are none, a scroll stays paint-only (`mark_scroll`).
let mut live_anchors: int = 0
/// Nodes with an indeterminate spin (`Spinner`) currently alive.
let mut spin_count: int = 0
/// Component-function runs (`Component`) and reactive-effect runs (`track.run`)
/// since boot. Animation must leave both flat (Phase 3 proof harness).
let mut component_runs: int = 0
/// 1 = reduced motion from the host. Animations jump to their final value.
let mut reduced: int = 0
/// 1 = a signal setter fired inside the animation tick (a hard invariant
/// violation). `store_sig` records it and, while `anim_assert != 0`, traps.
let mut anim_signal_writes: int = 0
let mut anim_assert: int = 1

fn blank_node() -> UiNode {
    return UiNode {
        kind: 0, dir: 0, kids: []int {}, pad: 0, padx: 0, pady: 0,
        pad_t: 0, pad_r: 0, pad_b: 0, pad_l: 0, gap: 0, grow: 0, shrink: 1,
        bg: -1, bg2: -1, fg: -1, radius: 0, ew: -1, eh: -1, font: 0, justify: 0, align: 0,
        min_w: -1, max_w: -1, min_h: -1, max_h: -1, w_pct: 100, h_pct: -1,
        text: "", bind_sig: 0, click_sig: 0, click_mode: 0, click_set: 0,
        click2_sig: 0, click2_mode: 0, click2_set: 0,
        show_sig: 0, show_mode: 0, show_val: 0, show_on: 1, hover_sig: 0,
        x: 0, y: 0, w: 0, h: 0, iw: 0, ih: 0, nid: 0, pos: 0, overflow: 0,
        opacity: 100, span: 1, grid_cols: 0, grid_min: 0,
        m_t: 0, m_r: 0, m_b: 0, m_l: 0, border_w: 0, border_c: -1,
        gap_row: 0, gap_col: 0, aspect_w: 0, aspect_h: 0,
        wrap: 0, reverse: 0, align_self: -1,
        pin_t: -1, pin_r: -1, pin_b: -1, pin_l: -1,
        z_index: 0, grid_auto: 0, scroll_x: 0, scroll_y: 0, tw: 0, th: 0, pulse: 0, press: 0, press_amt: 0,
        aw: 0, ah: 0, bar_t: 0, tgt_x: 0, tgt_y: 0, smooth: 0, parent: 0, key_ctx: 0, focusable: 0, capture_text: 0, edit_slot: -1,
        dirty: 0,
        an_scale: 100, an_tx: 0, an_ty: 0, an_rot: 0, reveal: 0, an_reveal: 100,
        spin_ms: 900, spin: 0,
        anchor: 0, anchor_gap: 6, place: 0, flip: 1,
        elev: 0, elev_c: -1,
        disabled: 0, loading: 0, invalid: 0,
        click_fn: 0, ui_size: 1, ui_look: 1, restyle_fn: 0,
        hover_fade: 0, hover_amt: 0, tween: -1, enter_fade: 0, show_amt: 0,
        down_fn: 0, up_fn: 0, kdown_fn: 0, kup_fn: 0, kpress_fn: 0, edit_sig: 0, bind_fn: 0,
        safe: 0, list_fn: 0, list_gen: 0,
        list_lo: 0, list_hi: 0, list_n: 0, row_h: 0, vel_x: 0, vel_y: 0,
        a11y_label: "", a11y_role: "", cursor: "", text_rot: 0,
    }
}

fn ensure() {
    if inited != 0 {
        return
    }
    inited = 1
    if nodes.len == 0 {
        push(nodes, blank_node())
    }
    if sigs.len == 0 {
        push(sigs, 0)
    }
    anim_ensure()
}

/// Enter a rebuild scope: allocations from now on are owned by `nid`.
/// Returns the previous scope so the caller can restore it after the build.
fn scope_begin(nid: int) -> int {
    let prev = scope_node
    scope_node = nid
    return prev
}

fn scope_end(prev: int) {
    scope_node = prev
}

/// An interned handler was created under a rebuild scope (or for `owner`):
/// record it so teardown can release its captured env.
fn record_intern(id: int, owner: int) {
    if id <= 0 {
        return
    }
    if owner > 0 {
        push(rec_fid, id)
        push(rec_fowner, owner)
    }
}

/// Free every signal a node's rebuilds allocated. Records are per build
/// scope, so an id has one owner: swap-remove matching owners in one pass —
/// rebuilding the keep-list on every release was O(all records) per chart
/// refit, which is what made window-resize frames crawl once the catalog
/// accumulated records.
fn release_sigs(nid: int) {
    let n = rec_owner.len
    if n == 0 {
        return
    }
    let mut i = 0
    while i < rec_owner.len {
        if rec_owner[i] == nid {
            let sid = rec_sid[i]
            let last = rec_owner.len - 1
            rec_owner[i] = rec_owner[last]
            rec_sid[i] = rec_sid[last]
            pop(rec_owner)
            pop(rec_sid)
            platform.plat_sig_free(sid)
            track.drop_sig(sid)
            anim_drop_sig(sid)
        } else {
            i = i + 1
        }
    }
}

/// Free every interned handler a node's rebuilds created, in one pass.
fn release_fns(nid: int) {
    let n = rec_fowner.len
    if n == 0 {
        return
    }
    let mut i = 0
    while i < rec_fowner.len {
        if rec_fowner[i] == nid {
            let fid = rec_fid[i]
            let last = rec_fowner.len - 1
            rec_fowner[i] = rec_fowner[last]
            rec_fid[i] = rec_fid[last]
            pop(rec_fowner)
            pop(rec_fid)
            platform.plat_intern_free(fid)
        } else {
            i = i + 1
        }
    }
}

// --- keyed-list identity ---
// Keyed `For` mounts one child per unique key and reuses it across reorders,
// so focus and per-row state survive a move. `kh_node[i]` is the top-level
// child mounted for `kh_key[i]` under host `kh_host[i]`; entries live only
// while the host is alive (cleared by `key_clear` on teardown).
let mut kh_host: []int = []int {}
let mut kh_key: []string = []string {}
let mut kh_node: []int = []int {}

fn key_index(host: int, k: string) -> int {
    let mut i = 0
    while i < kh_host.len {
        if kh_host[i] == host {
            if kh_key[i] == k {
                return i
            }
        }
        i = i + 1
    }
    return -1
}

fn key_node(host: int, k: string) -> int {
    let i = key_index(host, k)
    if i < 0 {
        return 0
    }
    return kh_node[i]
}

fn key_set(host: int, k: string, node: int) {
    let i = key_index(host, k)
    if i >= 0 {
        kh_node[i] = node
        return
    }
    push(kh_host, host)
    push(kh_key, k)
    push(kh_node, node)
}

fn key_count(host: int) -> int {
    let mut c = 0
    let mut i = 0
    while i < kh_host.len {
        if kh_host[i] == host {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

fn key_clear(host: int) {
    let mut i = 0
    while i < kh_host.len {
        if kh_host[i] == host {
            let last = kh_host.len - 1
            kh_host[i] = kh_host[last]
            kh_key[i] = kh_key[last]
            kh_node[i] = kh_node[last]
            pop(kh_host)
            pop(kh_key)
            pop(kh_node)
        } else {
            i = i + 1
        }
    }
}

/// Tear down a node: free its subtree (sigs, interned handlers, effects) and
/// recycle the slot. Freed slots are blanked so global scans (hover, cursor,
/// refresh lists) treat them as empty. Effect cleanup is batched by the
/// enclosing drop_children, so this only recurses and recycles.
fn free_node(id: int) {
    if id <= 0 {
        return
    }
    if id >= nodes.len {
        return
    }
    if int(nodes[id].kind) == 0 {
        return
    }
    let n = nodes[id].kids.len
    for i in 0..n {
        free_node(nodes[id].kids[i])
    }
    if nodes[id].list_fn > 0 {
        release_sigs(id)
        release_fns(id)
        key_clear(id)
    }
    if focus_id == id {
        focus_id = 0
    }
    if down_id == id {
        down_id = 0
    }
    if drag_id == id {
        drag_id = 0
        drag_bar = 0
    }
    if int(nodes[id].kind) == 10 {
        if nodes[id].edit_slot >= 0 {
            platform.plat_edit_reset(nodes[id].edit_slot)
        }
    }
    if int(nodes[id].pulse) != 0 {
        if pulse_count > 0 {
            pulse_count = pulse_count - 1
        }
    }
    if int(nodes[id].spin) != 0 {
        if spin_count > 0 {
            spin_count = spin_count - 1
        }
    }
    push(drop_pool, id)
    nodes[id].kids = []int {}
    nodes[id] = blank_node()
    push(free_nodes, id)
}

fn reset_tree() {
    nodes = []UiNode {}
    push(nodes, blank_node())
    root_id = 0
    focus_id = 0
    paint_sy = 0
    paint_sx = 0
    // drag_id / drag_bar survive the rebuild on purpose: an active scrollbar
    // or slider drag must keep working across per-frame tree resets (nodes
    // are recreated with recycled ids in the same order, so the grabbed node
    // keeps its id while the tree shape is stable). `input.drag` cancels the
    // drag when the node was recycled into a different kind.
    scope_node = 0
    rec_sid = []int {}
    rec_owner = []int {}
    rec_fid = []int {}
    rec_fowner = []int {}
    free_nodes = []int {}
    drop_pool = []int {}
    kh_host = []int {}
    kh_key = []string {}
    kh_node = []int {}
    anim_reset()
    mark_tree()
}

let mut scroll_save: []int = []int {}
let mut scroll_save_x: []int = []int {}

fn snapshot_scroll() {
    scroll_save = []int {}
    scroll_save_x = []int {}
    let n = nodes.len
    for i in 0..n {
        push(scroll_save, nodes[i].scroll_y)
        push(scroll_save_x, nodes[i].scroll_x)
    }
}

fn restore_scroll() {
    let n = nodes.len
    let m = scroll_save.len
    let mx = scroll_save_x.len
    for i in 1..n {
        if i < m {
            nodes[i].scroll_y = scroll_save[i]
        }
        if i < mx {
            nodes[i].scroll_x = scroll_save_x[i]
        }
    }
}

fn drop_children(id: int) {
    if id <= 0 {
        return
    }
    if id >= nodes.len {
        return
    }
    let n = nodes[id].kids.len
    for i in 0..n {
        free_node(nodes[id].kids[i])
    }
    nodes[id].kids = []int {}
    // One effect-table sweep for the whole freed subtree: per-node sweeps
    // made refit drops ~25 ms once the table had accumulated records.
    track.free_nodes_effects(drop_pool)
    // Tracks owned by the freed nodes return to the pool in the same sweep.
    anim_free_pool(drop_pool)
    drop_pool = []int {}
    mark_tree()
}

/// Start a host rebuild: free everything the host's previous build owned
/// (signals, interned handlers, children) and open a build scope owned by
/// `id`. Pair with `rebuild_end`. This is the only entry point that tears a
/// subtree down, so callers outside the core never touch `drop_children`.
fn rebuild_begin(id: int) -> int {
    let prev = scope_begin(id)
    release_sigs(id)
    release_fns(id)
    drop_children(id)
    return prev
}

fn rebuild_end(prev: int) {
    scope_end(prev)
}

/// Snapshot of the allocator for `zeus.Boundary`: everything allocated after
/// this point can be discarded by `release`.
struct ArenaMark {
    nodes: int,
    sigs: int,
    free: int,
    rec_s: int,
    rec_o: int,
    rec_f: int,
    rec_fo: int,
    kh: int,
    khk: int,
    khn: int,
    scope: int,
    root: int,
    focus: int,
    down: int,
    drag: int,
    drag_bar: int,
}

fn mark() -> ArenaMark {
    return ArenaMark {
        nodes: nodes.len, sigs: sigs.len, free: free_nodes.len,
        rec_s: rec_sid.len, rec_o: rec_owner.len,
        rec_f: rec_fid.len, rec_fo: rec_fowner.len,
        kh: kh_host.len, khk: kh_key.len, khn: kh_node.len,
        scope: scope_node, root: root_id, focus: focus_id,
        down: down_id, drag: drag_id, drag_bar: drag_bar,
    }
}

/// Roll the arena back to `m`: free handlers recorded since the mark, drop
/// signals allocated since it, and trim every growable table. Nodes freed or
/// mutated before the mark are left alone — this recovers the tree, it does not
/// undo C-seam side effects.
fn release(m: ArenaMark) {
    let mut i = rec_fid.len
    while i > m.rec_f {
        i = i - 1
        platform.plat_intern_free(rec_fid[i])
    }
    let mut s = sigs.len
    while s > m.sigs {
        s = s - 1
        platform.plat_sig_free(s)
        track.drop_sig(s)
        anim_drop_sig(s)
    }
    while rec_sid.len > m.rec_s { pop(rec_sid) }
    while rec_owner.len > m.rec_o { pop(rec_owner) }
    while rec_fid.len > m.rec_f { pop(rec_fid) }
    while rec_fowner.len > m.rec_fo { pop(rec_fowner) }
    while kh_host.len > m.kh { pop(kh_host) }
    while kh_key.len > m.khk { pop(kh_key) }
    while kh_node.len > m.khn { pop(kh_node) }
    while sigs.len > m.sigs { pop(sigs) }
    while free_nodes.len > m.free { pop(free_nodes) }
    while nodes.len > m.nodes { pop(nodes) }
    anim_drop_above(m.nodes)
    scope_node = m.scope
    root_id = m.root
    focus_id = m.focus
    down_id = m.down
    drag_id = m.drag
    drag_bar = m.drag_bar
    drop_pool = []int {}
}

/// Discard a boundary host's partial subtree, then roll the arena back.
fn rollback(id: int, m: ArenaMark) {
    drop_children(id)
    release(m)
}

fn store_sig(id: int, value: int) {
    if id <= 0 {
        return
    }
    if id >= sigs.len {
        return
    }
    if sigs[id] == value {
        return
    }
    if in_anim_tick != 0 {
        // Hard invariant: the animation tick writes paint values, never state.
        anim_signal_writes = anim_signal_writes + 1
        if anim_assert != 0 {
            panic("zeus: signal set from the animation tick")
        }
    }
    sigs[id] = value
    platform.plat_sig_bind_int(id, value)
    track.notify(id)
    // A discrete state change: layout may follow (a width/show signal feeds
    // layout), and the shared chrome pass may need to retarget a track.
    mark_layout()
    mark_chrome()
}

/// A paint-only signal write: the value moved but nothing about the tree's
/// geometry did (scroll offsets, drag positions). Effects still run — one that
/// changes a layout prop marks layout itself, through `apply_int`.
fn store_sig_paint(id: int, value: int) {
    if id <= 0 {
        return
    }
    if id >= sigs.len {
        return
    }
    if sigs[id] == value {
        return
    }
    sigs[id] = value
    platform.plat_sig_bind_int(id, value)
    track.notify_paint(id)
    paint_dirty = 1
}

// --- animation track pool (Phase 3) ---------------------------------------
//
// One fixed-capacity arena of tracks; every animation in the system is a row
// here. A track is plain data — no signal, no closure, no per-frame allocation.
// `anim_tick(dt_ms)` advances all active tracks from the host-supplied delta
// (read once per frame, not once per track) and writes the current value into
// the node's paint state, setting that node's PAINT bit. It never calls
// `store_sig`: no effect re-runs and no component rebuilds while an animation
// plays. A state change schedules or retargets a track once, then the graph is
// idle until the next state change.
//
// `sig_paint` is the one overlay: a `SigVal` track interpolates a signal's
// *paint* value while the signal's logical value (and so every effect bound to
// it) has already moved to the target. That is what lets `zeus.animate` stop
// re-running effects per frame without changing its signature.

// Which paint value a track drives. All are paint-only, so a frame that only
// ticks tracks skips layout entirely. `SigVal` keys `sig_paint` by signal id
// instead of node id.
enum APROP {
    // Hover wash 0..100 (UiNode.hover_amt).
    HoverAmt = 1,
    // Press overlay 0..100 (UiNode.press_amt).
    PressAmt = 2,
    // Switch / checkbox thumb travel 0..100 (UiNode.tween).
    SwitchTween = 3,
    // Mounted-surface fade 0..100 (UiNode.show_amt).
    EnterFade = 4,
    // 5 was the scrollbar fade; the thumb shows and hides in one frame now.
    // Signal paint overlay (sig_paint[sid]).
    SigVal = 6,
    // Paint transform / appearance, all paint-only (no layout pass reads them):
    // scale percent (100 = identity).
    ScalePct = 7,
    // Translate in dp (x / y).
    XlateX = 8,
    XlateY = 9,
    // Rotation in degrees.
    RotDeg = 10,
    // Node opacity 0..100.
    OpacityAmt = 11,
    // Corner radius in dp.
    RadiusPx = 12,
    // Reveal share 0..100 (UiNode.an_reveal).
    RevealAmt = 13,
}

let TRACK_CAP = 512

struct Track {
    node: int,
    prop: int,
    from: int,
    to: int,
    cur: int,
    elapsed: int,
    dur: int,
    easing: int,
    state: int,
}

let mut tracks: []Track = []Track {}
let mut track_free: []int = []int {}
let mut anim_active: int = 0
let mut sig_paint: []int = []int {}
let mut sig_anim: []int = []int {}
let mut anim_booted: int = 0
let mut in_anim_tick: int = 0

fn anim_ensure() {
    if tracks.len != 0 {
        return
    }
    for i in 0..TRACK_CAP {
        push(tracks, Track { node: 0, prop: 0, from: 0, to: 0, cur: 0, elapsed: 0, dur: 0, easing: 0, state: 0 })
    }
    let mut i = 0
    while i < TRACK_CAP {
        push(track_free, TRACK_CAP - 1 - i)
        i = i + 1
    }
}

// Easing codes, kept in step with `zeus.EASE`. arena cannot import zeus (the
// dependency runs the other way), so the values are repeated here as the
// numbers the shaper matches on.
fn ease_linear() -> int { return 0 }
fn ease_standard() -> int { return 1 }
fn ease_emphasized() -> int { return 2 }
fn ease_spring() -> int { return 3 }
// Durations in ms, in step with `zeus.MOTION`.
fn motion_fast() -> int { return 120 }
fn motion_base() -> int { return 200 }
fn motion_slow() -> int { return 320 }

/// Shape a linear 0..1000 progress into an eased 0..1000 (Spring may overshoot).
fn anim_ease(easing: int, t: int) -> int {
    if t <= 0 {
        return 0
    }
    if t >= 1000 {
        return 1000
    }
    if easing == ease_linear() {
        return t
    }
    let u = 1000 - t
    if easing == ease_emphasized() {
        // ease-out quint: more pronounced deceleration than Standard.
        return 1000 - u * u / 1000 * u / 1000 * u / 1000
    }
    if easing == ease_spring() {
        // ease-out-back: overshoots past the target, then settles on it.
        let u2 = u * u / 1000
        let u3 = u2 * u / 1000
        return 1000 + 2701 * u3 / 1000 + 1701 * u2 / 1000
    }
    // Standard: ease-out cubic.
    return 1000 - u * u / 1000 * u / 1000
}

fn anim_find(node: int, prop: int) -> int {
    let mut i = 0
    while i < tracks.len {
        if tracks[i].state == 1 {
            if tracks[i].node == node {
                if tracks[i].prop == prop {
                    return i
                }
            }
        }
        i = i + 1
    }
    return -1
}

fn anim_alloc() -> int {
    if track_free.len == 0 {
        return -1
    }
    let slot = track_free[track_free.len - 1]
    pop(track_free)
    return slot
}

fn anim_clamp100(v: int) -> int {
    if v < 0 {
        return 0
    }
    if v > 100 {
        return 100
    }
    return v
}

/// Current paint value a track on (`node`, `prop`) is at.
fn anim_read(node: int, prop: int) -> int {
    if prop == APROP.HoverAmt {
        return int(nodes[node].hover_amt)
    }
    if prop == APROP.PressAmt {
        return int(nodes[node].press_amt)
    }
    if prop == APROP.SwitchTween {
        if nodes[node].tween < 0 {
            return 0
        }
        return nodes[node].tween
    }
    if prop == APROP.EnterFade {
        return int(nodes[node].show_amt)
    }
    if prop == APROP.SigVal {
        if node < sig_paint.len {
            return sig_paint[node]
        }
        return 0
    }
    if prop == APROP.ScalePct {
        return int(nodes[node].an_scale)
    }
    if prop == APROP.XlateX {
        return int(nodes[node].an_tx)
    }
    if prop == APROP.XlateY {
        return int(nodes[node].an_ty)
    }
    if prop == APROP.RotDeg {
        return int(nodes[node].an_rot)
    }
    if prop == APROP.OpacityAmt {
        return int(nodes[node].opacity)
    }
    if prop == APROP.RadiusPx {
        return int(nodes[node].radius)
    }
    if prop == APROP.RevealAmt {
        return int(nodes[node].an_reveal)
    }
    return 0
}

/// Write a paint value (the track tick's only side effect on the tree).
fn anim_store(node: int, prop: int, v: int) {
    if prop == APROP.HoverAmt {
        nodes[node].hover_amt = u8(anim_clamp100(v))
    } else if prop == APROP.PressAmt {
        nodes[node].press_amt = u8(anim_clamp100(v))
    } else if prop == APROP.SwitchTween {
        nodes[node].tween = v
    } else if prop == APROP.EnterFade {
        nodes[node].show_amt = u8(anim_clamp100(v))
    } else if prop == APROP.SigVal {
        sig_paint_fit()
        if node < sig_paint.len {
            sig_paint[node] = v
            if node < sigs.len {
                if v == sigs[node] {
                    sig_anim[node] = 0
                } else {
                    sig_anim[node] = 1
                }
            }
        }
    } else if prop == APROP.ScalePct {
        let mut s = v
        if s < 1 {
            s = 1
        }
        if s > 1000 {
            s = 1000
        }
        nodes[node].an_scale = u16(s)
    } else if prop == APROP.XlateX {
        nodes[node].an_tx = i16(v)
    } else if prop == APROP.XlateY {
        nodes[node].an_ty = i16(v)
    } else if prop == APROP.RotDeg {
        let mut r = v % 360
        if r < 0 {
            r = r + 360
        }
        nodes[node].an_rot = u16(r)
    } else if prop == APROP.OpacityAmt {
        nodes[node].opacity = i16(anim_clamp100(v))
    } else if prop == APROP.RadiusPx {
        let mut r = v
        if r < 0 {
            r = 0
        }
        nodes[node].radius = u16(r)
    } else if prop == APROP.RevealAmt {
        nodes[node].an_reveal = u8(anim_clamp100(v))
    }
}

fn sig_paint_fit() {
    while sig_paint.len < sigs.len {
        push(sig_paint, 0)
        push(sig_anim, 0)
    }
}

fn anim_reduced() -> int {
    return reduced
}

/// Retarget or start a track toward `to`. Retargeting keeps the current value
/// as the new `from`, so an interrupted transition never pops or restarts.
/// Before the first frame, and under reduced motion, the final value is written
/// once instead.
fn anim_schedule(node: int, prop: int, to: int, dur: int, easing: int) {
    anim_ensure()
    let cur = anim_read(node, prop)
    let i = anim_find(node, prop)
    // Jump instead of animating before the first frame completes (cold boot),
    // for a zero duration, or under reduced motion.
    let mut jump = 0
    if anim_booted == 0 {
        jump = 1
    }
    if dur <= 0 {
        jump = 1
    }
    if anim_reduced() != 0 {
        jump = 1
    }
    if jump != 0 {
        if i >= 0 {
            tracks[i].state = 0
            anim_active = anim_active - 1
            push(track_free, i)
        }
        anim_store(node, prop, to)
        if prop == APROP.SigVal {
            if node < sig_anim.len {
                sig_anim[node] = 0
            }
        }
        mark_paint_id(node)
        return
    }
    if i >= 0 {
        if tracks[i].to == to {
            return
        }
        tracks[i].from = cur
        tracks[i].cur = cur
        tracks[i].to = to
        tracks[i].elapsed = 0
        tracks[i].dur = dur
        tracks[i].easing = easing
        return
    }
    if cur == to {
        return
    }
    let slot = anim_alloc()
    if slot < 0 {
        anim_store(node, prop, to)
        mark_paint_id(node)
        return
    }
    tracks[slot].node = node
    tracks[slot].prop = prop
    tracks[slot].from = cur
    tracks[slot].cur = cur
    tracks[slot].to = to
    tracks[slot].elapsed = 0
    tracks[slot].dur = dur
    tracks[slot].easing = easing
    tracks[slot].state = 1
    anim_active = anim_active + 1
}

/// A paint transform: scale percent toward `to` (100 = identity).
fn anim_scale(node: int, to: int, ms: int) {
    anim_schedule(node, APROP.ScalePct, to, ms, ease_standard())
}

fn anim_translate_x(node: int, to: int, ms: int) {
    anim_schedule(node, APROP.XlateX, to, ms, ease_standard())
}

fn anim_translate_y(node: int, to: int, ms: int) {
    anim_schedule(node, APROP.XlateY, to, ms, ease_standard())
}

fn anim_rotate(node: int, to: int, ms: int) {
    anim_schedule(node, APROP.RotDeg, to, ms, ease_standard())
}

fn anim_opacity(node: int, to: int, ms: int) {
    anim_schedule(node, APROP.OpacityAmt, to, ms, ease_standard())
}

fn anim_radius(node: int, to: int, ms: int) {
    anim_schedule(node, APROP.RadiusPx, to, ms, ease_standard())
}


/// `zeus.animate`: move a signal's *state* to `to` once (effects run once),
/// then interpolate its paint value on the track pool.
fn anim_signal(sid: int, to: int, ms: int) {
    if sid <= 0 {
        return
    }
    if sid >= sigs.len {
        return
    }
    let from = sig_val(sid)
    store_sig(sid, to)
    if from == to {
        return
    }
    sig_paint_fit()
    if sid < sig_paint.len {
        sig_paint[sid] = from
        sig_anim[sid] = 1
    }
    anim_schedule(sid, APROP.SigVal, to, ms, ease_standard())
}

/// 1 while any track is active (keeps the frame loop alive).
fn anim_live() -> int {
    return anim_active
}

fn anim_live_count() -> int {
    return anim_active
}

/// Advance every active track by `dt` ms. Returns 1 when any track ran this
/// frame (including the frame a track settles on, so its final value is drawn).
fn anim_tick(dt: int) -> int {
    anim_ensure()
    if anim_active == 0 {
        return 0
    }
    in_anim_tick = 1
    let mut i = 0
    while i < tracks.len {
        if tracks[i].state == 1 {
            let a = tracks[i]
            let mut dur = a.dur
            if dur <= 0 {
                dur = 1
            }
            let e = a.elapsed + dt
            let is_sig = a.prop == APROP.SigVal
            if e >= dur {
                tracks[i].cur = a.to
                tracks[i].elapsed = dur
                tracks[i].state = 0
                anim_active = anim_active - 1
                push(track_free, i)
                anim_store(a.node, a.prop, a.to)
            } else {
                tracks[i].elapsed = e
                let shaped = anim_ease(a.easing, e * 1000 / dur)
                tracks[i].cur = a.from + (a.to - a.from) * shaped / 1000
                anim_store(a.node, a.prop, tracks[i].cur)
            }
            if is_sig {
                paint_dirty = 1
            } else {
                mark_paint_id(a.node)
            }
        }
        i = i + 1
    }
    in_anim_tick = 0
    return 1
}

/// Drop tracks owned by a batched set of freed nodes (one sweep per subtree).
fn anim_free_pool(ids: []int) {
    if ids.len == 0 {
        return
    }
    let mut i = 0
    while i < tracks.len {
        if tracks[i].state == 1 {
            if tracks[i].prop != APROP.SigVal {
                if member(tracks[i].node, ids) != 0 {
                    tracks[i].state = 0
                    anim_active = anim_active - 1
                    push(track_free, i)
                }
            }
        }
        i = i + 1
    }
}

/// Drop the paint overlay for a signal that is being freed.
fn anim_drop_sig(sid: int) {
    if sid <= 0 {
        return
    }
    if sid < sig_anim.len {
        sig_anim[sid] = 0
        sig_paint[sid] = 0
    }
    let mut i = 0
    while i < tracks.len {
        if tracks[i].state == 1 {
            if tracks[i].prop == APROP.SigVal {
                if tracks[i].node == sid {
                    tracks[i].state = 0
                    anim_active = anim_active - 1
                    push(track_free, i)
                }
            }
        }
        i = i + 1
    }
}

/// Drop tracks for nodes at or above `n` (Boundary rollback trims the arena).
fn anim_drop_above(n: int) {
    let mut i = 0
    while i < tracks.len {
        if tracks[i].state == 1 {
            if tracks[i].prop != APROP.SigVal {
                if tracks[i].node >= n {
                    tracks[i].state = 0
                    anim_active = anim_active - 1
                    push(track_free, i)
                }
            }
        }
        i = i + 1
    }
}

/// Reset all tracks (view-mode rebuild drops the whole tree). Buffers are
/// reused, not dropped, so a per-frame rebuild does not reallocate them.
fn anim_reset() {
    anim_ensure()
    let mut i = 0
    while i < tracks.len {
        tracks[i].state = 0
        i = i + 1
    }
    while track_free.len > 0 {
        pop(track_free)
    }
    i = 0
    while i < TRACK_CAP {
        push(track_free, TRACK_CAP - 1 - i)
        i = i + 1
    }
    anim_active = 0
    while sig_paint.len > 0 {
        pop(sig_paint)
    }
    while sig_anim.len > 0 {
        pop(sig_anim)
    }
    while dirty_paint.len > 0 {
        pop(dirty_paint)
    }
    in_anim_tick = 0
}

/// Recompute every chrome target from discrete state and schedule the tracks.
/// Event-driven (pointer, signal, show change), never the per-frame path.
fn sync_chrome() {
    let n = nodes.len
    for i in 1..n {
        if int(nodes[i].kind) == 0 {
            continue
        }
        if is_hot(i) != 0 {
            let mut over = 0
            if ptr_in(i) != 0 {
                over = 100
            }
            anim_schedule(i, APROP.HoverAmt, over, motion_fast(), ease_standard())
        }
        if int(nodes[i].press) != 0 {
            let mut tgt = 0
            if down_id == i {
                tgt = 100
            }
            anim_schedule(i, APROP.PressAmt, tgt, motion_fast(), ease_standard())
        }
        let k = int(nodes[i].kind)
        if k == 7 {
            let mut tgt = 0
            if bind_pct(i) > 0 {
                tgt = 100
            }
            if nodes[i].tween < 0 {
                nodes[i].tween = tgt
            } else {
                anim_schedule(i, APROP.SwitchTween, tgt, motion_base(), ease_spring())
            }
        }
        if k == 8 {
            let mut tgt = 0
            if sig_val(nodes[i].bind_sig) != 0 {
                tgt = 100
            }
            if nodes[i].tween < 0 {
                nodes[i].tween = tgt
            } else {
                anim_schedule(i, APROP.SwitchTween, tgt, motion_base(), ease_spring())
            }
        }
        if int(nodes[i].enter_fade) != 0 {
            // Shown means shown on screen: a Dialog panel is hidden by its
            // scrim's signal, not its own, so the walk up is what makes it
            // fade on every open (and out on every close), not just the first.
            let w = shown_in_tree(i)
            if int(nodes[i].enter_fade) == 1 {
                // First observation after a build: settle. Cold boot writes the
                // final value and nothing animates (audit §10).
                if w != 0 {
                    nodes[i].show_amt = u8(100)
                } else {
                    nodes[i].show_amt = u8(0)
                }
                nodes[i].enter_fade = u8(2)
            } else if w != 0 {
                anim_schedule(i, APROP.EnterFade, 100, motion_slow(), ease_emphasized())
            } else if is_floater(i) != 0 || want_show(i) != 0 {
                // Exit: fade out. Paint keeps the node while `show_amt` > 0
                // (`want_paint`); the tree predicates already say hidden, so it
                // is inert. An in-flow node hidden by its *own* signal snaps
                // instead: layout collapsed it this frame, and a fade painted
                // over the neighbour that moved into its rect would look wrong.
                anim_schedule(i, APROP.EnterFade, 0, motion_fast(), ease_standard())
            } else {
                nodes[i].show_amt = u8(0)
            }
        }
        if int(nodes[i].reveal) != 0 {
            // Same shape as the fade: settle on first sight, then reveal on
            // show. Hidden snaps to 0 so the next open starts from the top;
            // there is no reveal-out, because layout has already collapsed an
            // in-flow node by the time paint could animate it.
            let w = shown_in_tree(i)
            if int(nodes[i].reveal) == 1 {
                if w != 0 {
                    nodes[i].an_reveal = u8(100)
                } else {
                    nodes[i].an_reveal = u8(0)
                }
                nodes[i].reveal = u8(2)
            } else if w != 0 {
                anim_schedule(i, APROP.RevealAmt, 100, motion_base(), ease_emphasized())
            } else {
                nodes[i].an_reveal = u8(0)
            }
        }
    }
}

fn mark_paint_id(id: int) {
    paint_dirty = 1
    if id <= 0 {
        return
    }
    if id >= nodes.len {
        return
    }
    if (int(nodes[id].dirty) & 1) != 0 {
        return
    }
    nodes[id].dirty = u8(int(nodes[id].dirty) | 1)
    push(dirty_paint, id)
}

fn mark_chrome() {
    chrome_dirty = 1
}

/// Mark a node's skeleton shimmer alive so the frame loop keeps running while
/// it is visible (the case that reaches `paint_alpha`).
fn note_pulse(id: int) {
    if id <= 0 {
        return
    }
    if id >= nodes.len {
        return
    }
    if int(nodes[id].pulse) == 0 {
        pulse_count = pulse_count + 1
    }
    nodes[id].pulse = u8(1)
    paint_dirty = 1
}

fn pulse_live() -> int {
    if pulse_count > 0 {
        return 1
    }
    return 0
}

/// Mark a node's spinner alive: paint rotates it from the frame clock, and the
/// frame loop keeps running while it is visible. Reduced motion stops it.
fn note_spin(id: int, period: int) {
    if id <= 0 {
        return
    }
    if id >= nodes.len {
        return
    }
    if int(nodes[id].spin) == 0 {
        spin_count = spin_count + 1
    }
    nodes[id].spin = u8(1)
    let mut d = period
    if d < 60 {
        d = 60
    }
    if d > 65535 {
        d = 65535
    }
    nodes[id].spin_ms = u16(d)
    paint_dirty = 1
}

fn spin_live() -> int {
    if reduced != 0 {
        return 0
    }
    if spin_count > 0 {
        return 1
    }
    return 0
}

fn mark_paint() {
    paint_dirty = 1
}

/// Scroll moved: repaint now, and let the virtual-list window pass run.
fn mark_scroll() {
    paint_dirty = 1
    virt_dirty = 1
    // An open popup is anchored to its trigger's *screen* rect, so a scroll
    // moves it. Re-place the floaters (a layout pass) rather than let the popup
    // drift away from its button; with none on screen, a scroll stays
    // paint-only.
    if live_anchors != 0 {
        layout_dirty = 1
    }
}

fn mark_layout() {
    layout_dirty = 1
    paint_dirty = 1
}

fn mark_tree() {
    tree_dirty = 1
    layout_dirty = 1
    paint_dirty = 1
    chrome_dirty = 1
}

/// Drain the PAINT marks at the end of a paint pass. The buffer is popped, not
/// dropped, so a steady animation allocates nothing frame to frame.
fn clear_dirty() {
    let n = dirty_paint.len
    for i in 0..n {
        let id = dirty_paint[i]
        if id > 0 {
            if id < nodes.len {
                nodes[id].dirty = u8(int(nodes[id].dirty) & 254)
            }
        }
    }
    while dirty_paint.len > 0 {
        pop(dirty_paint)
    }
    paint_dirty = 0
    tree_dirty = 0
}

fn alloc_node(kind: int) -> int {
    ensure()
    mark_tree()
    if free_nodes.len > 0 {
        let id = free_nodes[free_nodes.len - 1]
        pop(free_nodes)
        nodes[id] = blank_node()
        nodes[id].kind = u8(kind)
        nodes[id].nid = id
        return id
    }
    let mut n = blank_node()
    n.kind = u8(kind)
    n.nid = nodes.len
    push(nodes, n)
    return nodes.len - 1
}

// --- app ---

fn theme_grow(slot: int) {
    if slot < 0 {
        return
    }
    let need = slot + 1
    if need <= theme_l.len {
        return
    }
    let n = need - theme_l.len
    for i in 0..n {
        push(theme_l, 0)
        push(theme_d, 0)
    }
}

/// Paint-time color. The app registers light/dark RGB per slot; paint
/// resolves against appearance().
fn paint_rgb(c: int) -> int {
    if c < 0 {
        return 0
    }
    if c < 2130706432 {
        return c
    }
    let slot = c - 2130706432
    if slot < 0 {
        return 0
    }
    let mut dark = 0
    if appearance_sid > 0 {
        if appearance_sid < sigs.len {
            dark = sigs[appearance_sid]
        }
    }
    if dark != 0 {
        if slot < theme_d.len {
            return theme_d[slot]
        }
        return 0
    }
    if slot < theme_l.len {
        return theme_l[slot]
    }
    return 0
}

// --- elevation --------------------------------------------------------------
// Pure data, in the core so the paint pass can resolve a node's shadow without
// depending on the component module. `zeus.elevation` / `elev_now` delegate
// here, so the tokens have one home.
struct Elev {
    alpha: int,
    blur: int,
    dx: int,
    dy: int,
}

fn elevation(level: int) -> Elev {
    if level <= 0 { return Elev(alpha = 0, blur = 0, dx = 0, dy = 0) }
    if level == 1 { return Elev(alpha = 18, blur = 3, dx = 0, dy = 1) }
    if level == 2 { return Elev(alpha = 24, blur = 8, dx = 0, dy = 2) }
    if level == 3 { return Elev(alpha = 34, blur = 18, dx = 0, dy = 6) }
    return Elev(alpha = 48, blur = 36, dx = 0, dy = 12)
}

fn elevation_dark(level: int) -> Elev {
    if level <= 0 { return Elev(alpha = 0, blur = 0, dx = 0, dy = 0) }
    if level == 1 { return Elev(alpha = 60, blur = 3, dx = 0, dy = 1) }
    if level == 2 { return Elev(alpha = 78, blur = 7, dx = 0, dy = 2) }
    if level == 3 { return Elev(alpha = 105, blur = 15, dx = 0, dy = 5) }
    return Elev(alpha = 140, blur = 30, dx = 0, dy = 10)
}

fn elev_now(level: int) -> Elev {
    let mut dark = 0
    if appearance_sid > 0 {
        if appearance_sid < sigs.len {
            dark = sigs[appearance_sid]
        }
    }
    if dark != 0 {
        return elevation_dark(level)
    }
    return elevation(level)
}

fn sig_val(id: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= sigs.len {
        return 0
    }
    if id < sig_anim.len {
        if sig_anim[id] != 0 {
            return sig_paint[id]
        }
    }
    return sigs[id]
}

fn bound_num(id: int) -> int {
    if nodes[id].bind_sig > 0 {
        return sig_val(nodes[id].bind_sig)
    }
    if nodes[id].bind_sig < 0 {
        return nodes[id].click_set
    }
    return 0
}

fn has_bound_num(id: int) -> int {
    if nodes[id].bind_sig != 0 {
        return 1
    }
    return 0
}

fn box_pad_x(id: int) -> int {
    let pl = i32(nodes[id].pad_l)
    let pr = i32(nodes[id].pad_r)
    let bw = i32(nodes[id].border_w)
    return pl + pr + bw + bw
}
fn box_pad_y(id: int) -> int {
    let pt = i32(nodes[id].pad_t)
    let pb = i32(nodes[id].pad_b)
    let bw = i32(nodes[id].border_w)
    return pt + pb + bw + bw
}
fn gap_x(id: int) -> int {
    if nodes[id].gap_col > 0 {
        return i32(nodes[id].gap_col)
    }
    return i32(nodes[id].gap)
}
fn gap_y(id: int) -> int {
    if nodes[id].gap_row > 0 {
        return i32(nodes[id].gap_row)
    }
    return i32(nodes[id].gap)
}
fn inset_here(id: int) -> int {
    if id == root_id {
        return 1
    }
    return int(nodes[id].safe)
}

fn content_x(id: int) -> int {
    let mut x = nodes[id].x + i32(nodes[id].pad_l) + i32(nodes[id].border_w)
    if inset_here(id) != 0 {
        x = x + safe_l
    }
    return x
}
fn content_y(id: int) -> int {
    let mut y = nodes[id].y + i32(nodes[id].pad_t) + i32(nodes[id].border_w)
    if inset_here(id) != 0 {
        y = y + safe_t
    }
    return y
}
fn inner_w(id: int) -> int {
    let mut extra = 0
    if inset_here(id) != 0 {
        extra = safe_l + safe_r
    }
    return geometry.max2(nodes[id].w - box_pad_x(id) - extra, 0)
}
fn inner_h(id: int) -> int {
    let mut extra = 0
    if inset_here(id) != 0 {
        extra = safe_t + safe_b
    }
    return geometry.max2(nodes[id].h - box_pad_y(id) - extra, 0)
}

fn clamp_w(id: int, w: int) -> int {
    let mut v = w
    if nodes[id].min_w >= 0 {
        if v < nodes[id].min_w {
            v = nodes[id].min_w
        }
    }
    if nodes[id].max_w >= 0 {
        if v > nodes[id].max_w {
            v = nodes[id].max_w
        }
    }
    return geometry.max2(v, 0)
}
fn clamp_h(id: int, h: int) -> int {
    let mut v = h
    if nodes[id].min_h >= 0 {
        if v < nodes[id].min_h {
            v = nodes[id].min_h
        }
    }
    if nodes[id].max_h >= 0 {
        if v > nodes[id].max_h {
            v = nodes[id].max_h
        }
    }
    return geometry.max2(v, 0)
}

fn child_align(p: int, c: int) -> int {
    if int(nodes[c].align_self) >= 0 {
        return int(nodes[c].align_self)
    }
    return i32(nodes[p].align)
}

fn has_w(id: int) -> int {
    if nodes[id].ew >= 0 {
        return 1
    }
    if int(nodes[id].w_pct) >= 0 {
        return 1
    }
    return 0
}
fn has_h(id: int) -> int {
    if nodes[id].eh >= 0 {
        return 1
    }
    if int(nodes[id].h_pct) >= 0 {
        return 1
    }
    return 0
}

/// Default w_pct is 100: fill the parent in a column. In a row the same
/// default means content width so siblings sit side by side; `.set_width(px)` and
/// any width_pct other than 100 still win. A raster image never grows past
/// its decoded source size, so a widthless `Image` fills the container up to
/// the source width (web `max-width: 100%`) — that is how an uploaded photo
/// resizes to the device width without a caller-set `max_width`.
fn sized_w(c: int, avail: int, row: int) -> int {
    let mut w = nodes[c].iw
    if nodes[c].ew >= 0 {
        w = nodes[c].ew
    } else if int(nodes[c].w_pct) >= 0 {
        if row != 0 {
            if int(nodes[c].w_pct) == 100 {
                w = nodes[c].iw
            } else {
                w = avail * int(nodes[c].w_pct) / 100
            }
        } else {
            w = avail * int(nodes[c].w_pct) / 100
            if int(nodes[c].kind) == 14 {
                if nodes[c].iw > 0 {
                    if w > nodes[c].iw {
                        w = nodes[c].iw
                    }
                }
            }
        }
    }
    return clamp_w(c, w)
}
fn sized_h(c: int, avail: int, w: int) -> int {
    let mut h = nodes[c].ih
    if nodes[c].aspect_w > 0 {
        if nodes[c].aspect_h > 0 {
            if nodes[c].eh < 0 {
                h = w * nodes[c].aspect_h / nodes[c].aspect_w
            }
        }
    }
    if int(nodes[c].h_pct) >= 0 {
        h = avail * int(nodes[c].h_pct) / 100
    } else if nodes[c].eh >= 0 {
        h = nodes[c].eh
    }
    return clamp_h(c, h)
}

fn skip_flow(id: int) -> int {
    if id <= 0 {
        return 1
    }
    if want_show(id) == 0 {
        return 1
    }
    if int(nodes[id].kind) == 9 {
        return 1
    }
    if int(nodes[id].pos) == 1 {
        return 1
    }
    return 0
}

fn fills_cross(c: int, row: int) -> int {
    let k = int(nodes[c].kind)
    if k == 3 {
        if row == 0 {
            return 1
        }
        return 0
    }
    if k == 1 {
        return 1
    }
    if k == 2 {
        return 1
    }
    if k == 5 {
        return 1
    }
    if k == 6 {
        return 1
    }
    if k == 10 {
        return 1
    }
    if k == 11 {
        return 1
    }
    if k == 13 {
        return 1
    }
    return 0
}

fn sz_fit(n: int) {
    let have = szbuf.len
    if n > have {
        let extra = n - have
        for i in 0..extra {
            push(szbuf, 0)
        }
    }
    let have2 = szlay.len
    if n > have2 {
        let extra = n - have2
        for i in 0..extra {
            push(szlay, 0)
        }
    }
}

/// Copy szbuf into szlay so nested flex layout can reuse szbuf.
fn sz_commit(n: int) {
    sz_fit(n)
    let have = szlay.len
    if n > have {
        let extra = n - have
        for i in 0..extra {
            push(szlay, 0)
        }
    }
    for i in 0..n {
        szlay[i] = szbuf[i]
    }
}

fn axis_frozen(c: int, row: int) -> int {
    if row != 0 {
        if nodes[c].ew >= 0 {
            return 1
        }
        return 0
    }
    if nodes[c].eh >= 0 {
        return 1
    }
    return 0
}

fn want_show(id: int) -> int {
    if id <= 0 {
        return 0
    }
    if nodes[id].show_sig <= 0 {
        /* No signal bound: the declarative `show` prop decides (or the
           default, visible). */
        return i32(nodes[id].show_on)
    }
    if nodes[id].show_sig >= sigs.len {
        return 1
    }
    let vv = sigs[nodes[id].show_sig]
    let mode = nodes[id].show_mode
    let val = nodes[id].show_val
    if mode == 0 {
        if vv != 0 {
            return 1
        }
        return 0
    }
    if mode == 1 {
        if vv == val {
            return 1
        }
        return 0
    }
    if mode == 2 {
        if vv != val {
            return 1
        }
        return 0
    }
    if mode == 3 {
        if vv >= val {
            return 1
        }
        return 0
    }
    if mode == 4 {
        if vv <= val {
            return 1
        }
        return 0
    }
    return 1
}

/// Anchor a floating node (popover / tooltip / hover card) to `target`'s
/// screen rect. `side` is the preferred placement, `gap` the offset in dp.
fn anchor_to(id: int, target: int, side: int, gap: int) {
    if id <= 0 {
        return
    }
    if id >= nodes.len {
        return
    }
    nodes[id].anchor = target
    nodes[id].place = u8(side)
    let mut g = gap
    if g < 0 {
        g = 0
    }
    nodes[id].anchor_gap = u16(g)
    nodes[id].flip = u8(1)
    mark_layout()
}

fn set_anchor_flip(id: int, on: int) {
    if id <= 0 {
        return
    }
    if id >= nodes.len {
        return
    }
    nodes[id].flip = u8(on)
    mark_layout()
}

/// Paint visibility: `want_show`, or a hidden node whose exit fade has not
/// landed yet. Paint alone reads this; layout, hit-test, focus, and the tree
/// predicates keep `want_show`, so a closing floater is already inert.
fn want_paint(id: int) -> int {
    if want_show(id) != 0 {
        return 1
    }
    if id <= 0 {
        return 0
    }
    if id >= nodes.len {
        return 0
    }
    if int(nodes[id].enter_fade) == 2 {
        if int(nodes[id].show_amt) > 0 {
            return 1
        }
    }
    return 0
}

/// 1 when `id` and every ancestor is visible. `want_show` is per-node; a hidden
/// container hides its subtree for paint, so a visibility check must walk up.
fn shown_in_tree(id: int) -> int {
    if id <= 0 {
        return 0
    }
    let mut cur = id
    let mut guard = 0
    while cur > 0 {
        if want_show(cur) == 0 {
            return 0
        }
        cur = nodes[cur].parent
        guard = guard + 1
        if guard > 64 {
            break
        }
    }
    return 1
}

fn ease_out(t: int) -> int {
    if t <= 0 {
        return 0
    }
    if t >= 100 {
        return 100
    }
    let u = 100 - t
    return 100 - u * u / 100
}

fn hover_paint(id: int) -> int {
    return ease_out(int(nodes[id].hover_amt))
}

// --- shared interaction state (Phase 3) -----------------------------------
//
// One model for the discrete states every interactive widget shares. Components
// set the flags through `set_interaction_state` (or the convenience setters),
// and paint / hit-test consult `interaction_state` instead of each recipe
// growing its own copy. The states are discrete, so changing one may use a
// signal; the *animation* of a state (the fade between them) still goes through
// the track pool.
enum UISTATE {
    // Pointer is over the node and it is not disabled.
    StHovered = 1,
    // Primary button is down on the node.
    StPressed = 2,
    // Focus arrived by keyboard (the painted ring is keyboard-only).
    StFocusVisible = 3,
    // Not available: no hover, no press, dimmed.
    StDisabled = 4,
    // Work in flight: dimmed and non-interactive.
    StLoading = 5,
    // Toggled on (tab / radio / switch / selected row).
    StSelected = 6,
    // Validation failed.
    StInvalid = 7,
}

fn state_bit(s: int) -> int {
    return 1 << (s - 1)
}

/// Bitmask of the shared interaction states for `id`.
fn interaction_state(id: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= nodes.len {
        return 0
    }
    let mut m = 0
    if int(nodes[id].disabled) != 0 {
        m = m | state_bit(UISTATE.StDisabled)
    }
    if int(nodes[id].loading) != 0 {
        m = m | state_bit(UISTATE.StLoading)
    }
    if int(nodes[id].invalid) != 0 {
        m = m | state_bit(UISTATE.StInvalid)
    }
    if (m & (state_bit(UISTATE.StDisabled) | state_bit(UISTATE.StLoading))) == 0 {
        if is_hot(id) != 0 {
            if ptr_in(id) != 0 {
                m = m | state_bit(UISTATE.StHovered)
            }
        }
        if int(nodes[id].press) != 0 {
            if down_id == id {
                m = m | state_bit(UISTATE.StPressed)
            }
        }
    }
    if kb_focus != 0 {
        if focus_id == id {
            m = m | state_bit(UISTATE.StFocusVisible)
        }
    }
    if nodes[id].bind_sig > 0 {
        if sig_val(nodes[id].bind_sig) != 0 {
            m = m | state_bit(UISTATE.StSelected)
        }
    }
    return m
}

fn state_has(m: int, s: int) -> bool {
    if (m & state_bit(s)) != 0 {
        return true
    }
    return false
}

fn set_interaction_state(id: int, s: int, on: int) {
    if id <= 0 {
        return
    }
    if id >= nodes.len {
        return
    }
    let mut v = 0
    if on != 0 {
        v = 1
    }
    if s == UISTATE.StDisabled {
        nodes[id].disabled = u8(v)
    } else if s == UISTATE.StLoading {
        nodes[id].loading = u8(v)
    } else if s == UISTATE.StInvalid {
        nodes[id].invalid = u8(v)
    }
    mark_paint()
    mark_chrome()
}

fn set_disabled(id: int, on: int) {
    set_interaction_state(id, UISTATE.StDisabled, on)
}

fn set_loading(id: int, on: int) {
    set_interaction_state(id, UISTATE.StLoading, on)
}

fn set_invalid(id: int, on: int) {
    set_interaction_state(id, UISTATE.StInvalid, on)
}

/// One shared-state predicate per bit, so a caller never needs the bit number.
fn state_disabled_of(id: int) -> int {
    if state_has(interaction_state(id), UISTATE.StDisabled) {
        return 1
    }
    return 0
}
fn state_loading_of(id: int) -> int {
    if state_has(interaction_state(id), UISTATE.StLoading) {
        return 1
    }
    return 0
}
fn state_invalid_of(id: int) -> int {
    if state_has(interaction_state(id), UISTATE.StInvalid) {
        return 1
    }
    return 0
}
fn state_hovered_of(id: int) -> int {
    if state_has(interaction_state(id), UISTATE.StHovered) {
        return 1
    }
    return 0
}
fn state_pressed_of(id: int) -> int {
    if state_has(interaction_state(id), UISTATE.StPressed) {
        return 1
    }
    return 0
}
fn state_focus_visible_of(id: int) -> int {
    if state_has(interaction_state(id), UISTATE.StFocusVisible) {
        return 1
    }
    return 0
}
fn state_selected_of(id: int) -> int {
    if state_has(interaction_state(id), UISTATE.StSelected) {
        return 1
    }
    return 0
}

fn hover_rgb() -> int {
    let mut dark = 0
    if appearance_sid > 0 {
        if appearance_sid < sigs.len {
            dark = sigs[appearance_sid]
        }
    }
    if dark != 0 {
        return 16777215
    }
    return 0
}

fn is_hot(id: int) -> int {
    if want_show(id) == 0 {
        return 0
    }
    // The shared overlay: a disabled or loading node never hovers.
    if int(nodes[id].disabled) != 0 {
        return 0
    }
    if int(nodes[id].loading) != 0 {
        return 0
    }
    if int(nodes[id].hover_fade) < 0 {
        return 0
    }
    let k = int(nodes[id].kind)
    if k == 9 {
        return 0
    }
    if k == 11 {
        return 0
    }
    if int(nodes[id].hover_fade) != 0 {
        return 1
    }
    if nodes[id].click_sig > 0 {
        return 1
    }
    if nodes[id].click_fn > 0 {
        return 1
    }
    if k == 4 {
        return 1
    }
    if k == 7 {
        return 1
    }
    if k == 8 {
        return 1
    }
    if k == 13 {
        return 1
    }
    return 0
}

fn ptr_in(id: int) -> int {
    if want_show(id) == 0 {
        return 0
    }
    let mut px = ptr_x
    let mut py = ptr_y
    let mut skip = 0
    if int(nodes[id].kind) == 9 {
        skip = 1
    }
    let mut p = nodes[id].parent
    for i in 0..32 {
        if p > 0 {
            if int(nodes[p].kind) == 9 {
                skip = 1
            }
            if skip == 0 {
                if int(nodes[p].kind) == 11 {
                    px = px + nodes[p].scroll_x
                    py = py + nodes[p].scroll_y
                }
            }
            p = nodes[p].parent
        }
    }
    return in_box(id, px, py)
}

fn paint_alpha(id: int) -> int {
    let mut a = int(nodes[id].opacity)
    if int(nodes[id].pulse) != 0 {
        // Skeleton shimmer, driven by the frame clock: a 2.4 s triangle wave
        // (the old frame-count period at 60 fps), phase-offset per node so a
        // run of skeletons does not pulse in lockstep.
        let mut p = (now_ms + nodes[id].nid * 80) % 2400
        if p > 1200 {
            p = 2400 - p
        }
        a = 8 + p * 92 / 1200
    }
    if int(nodes[id].enter_fade) != 0 {
        a = a * int(nodes[id].show_amt) / 100
    }
    if a < 0 {
        a = 0
    }
    if a > 100 {
        a = 100
    }
    return a * 255 / 100
}

fn draw_x(id: int) -> int {
    return nodes[id].x - paint_sx
}
fn draw_y(id: int) -> int {
    return nodes[id].y - paint_sy
}

fn in_box(id: int, px: int, py: int) -> int {
    if px < nodes[id].x {
        return 0
    }
    if py < nodes[id].y {
        return 0
    }
    if px >= nodes[id].x + nodes[id].w {
        return 0
    }
    if py >= nodes[id].y + nodes[id].h {
        return 0
    }
    return 1
}

fn scroll_max(id: int) -> int {
    return geometry.max2(nodes[id].ih - nodes[id].h, 0)
}

fn scroll_max_x(id: int) -> int {
    return geometry.max2(nodes[id].iw - nodes[id].w, 0)
}

/// 1 if this scroll node may overflow horizontally (`scroll_xy` / overflow 3).
fn scrolls_x(id: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= nodes.len {
        return 0
    }
    if int(nodes[id].kind) != 11 {
        return 0
    }
    if nodes[id].overflow == 3 {
        return 1
    }
    return 0
}

fn phys_axis_live(pos: int, vel: int, maxs: int) -> int {
    if vel != 0 {
        return 1
    }
    if pos < 0 {
        return 1
    }
    if pos > maxs {
        return 1
    }
    return 0
}

/// 1 if any scroller is coasting, easing to a wheel target, or overscrolled —
/// hosts should keep frames.
fn phys_live() -> int {
    let n = nodes.len
    for i in 1..n {
        if int(nodes[i].kind) == 11 {
            if int(nodes[i].smooth) != 0 {
                return 1
            }
            if phys_axis_live(nodes[i].scroll_x, nodes[i].vel_x, scroll_max_x(i)) != 0 {
                return 1
            }
            if phys_axis_live(nodes[i].scroll_y, nodes[i].vel_y, scroll_max(i)) != 0 {
                return 1
            }
        }
    }
    return 0
}

struct Axis {
    pos: int,
    vel: int,
    dirty: int,
}

fn physics_axis(pos: int, vel: int, maxs: int) -> Axis {
    let mut y = pos + vel
    let mut v = vel * 92 / 100
    let mut dirty = 0
    // Hard clamp at the content bounds: momentum never overshoots, so the
    // viewport can never show a blank strip past the first/last content.
    if y < 0 {
        y = 0
        v = 0
        dirty = 1
    } else if y > maxs {
        y = maxs
        v = 0
        dirty = 1
    } else if v * v < 4 {
        v = 0
    } else {
        dirty = 1
    }
    return Axis { pos: y, vel: v, dirty: dirty }
}

/// One frame toward a wheel target: 35 % of the gap, at least 1 px, so a
/// 100 px notch lands in ~11 frames and never stalls short. Returns the new
/// position; the caller clears the bit when it equals the target.
fn smooth_axis(pos: int, tgt: int) -> int {
    let d = tgt - pos
    if d == 0 {
        return pos
    }
    let mut step = d * 35 / 100
    if step == 0 {
        if d > 0 {
            step = 1
        } else {
            step = -1
        }
    }
    return pos + step
}

/// One frame of momentum + rubber-band + wheel easing. Returns 1 if anything
/// moved. Thumb drag (`drag_bar`) owns the position until mouseup.
fn physics_step() -> int {
    if drag_id > 0 {
        if drag_bar != 0 {
            return 0
        }
    }
    let n = nodes.len
    let mut dirty = 0
    for i in 1..n {
        if int(nodes[i].kind) == 11 {
            let sm = int(nodes[i].smooth)
            if (sm & 1) != 0 {
                let ny = smooth_axis(nodes[i].scroll_y, nodes[i].tgt_y)
                if ny != nodes[i].scroll_y {
                    nodes[i].scroll_y = ny
                    dirty = 1
                    bar_on(i)
                    if nodes[i].bind_sig > 0 {
                        store_sig_paint(nodes[i].bind_sig, ny)
                    }
                }
                if ny == nodes[i].tgt_y {
                    nodes[i].smooth = u8(sm & 2)
                }
            }
            if (sm & 2) != 0 {
                let nx = smooth_axis(nodes[i].scroll_x, nodes[i].tgt_x)
                if nx != nodes[i].scroll_x {
                    nodes[i].scroll_x = nx
                    dirty = 1
                    bar_on(i)
                }
                if nx == nodes[i].tgt_x {
                    nodes[i].smooth = u8(int(nodes[i].smooth) & 1)
                }
            }
            let ay = physics_axis(nodes[i].scroll_y, nodes[i].vel_y, scroll_max(i))
            let ax = physics_axis(nodes[i].scroll_x, nodes[i].vel_x, scroll_max_x(i))
            nodes[i].scroll_y = ay.pos
            nodes[i].vel_y = ay.vel
            nodes[i].scroll_x = ax.pos
            nodes[i].vel_x = ax.vel
            if ay.dirty != 0 {
                dirty = 1
                bar_on(i)
                if nodes[i].bind_sig > 0 {
                    store_sig_paint(nodes[i].bind_sig, ay.pos)
                }
            }
            if ax.dirty != 0 {
                dirty = 1
                bar_on(i)
            }
        }
    }
    if dirty != 0 {
        mark_scroll()
    }
    return dirty
}

/// Move a wheel target by `d` (clamped to the content). Starts from the live
/// target when one is pending, so back-to-back notches add up instead of
/// restarting. Returns how much of `d` the scroller could take.
fn apply_smooth_y(id: int, d: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= nodes.len {
        return 0
    }
    let mut from = nodes[id].scroll_y
    if (int(nodes[id].smooth) & 1) != 0 {
        from = nodes[id].tgt_y
    }
    let my = scroll_max(id)
    let mut t = from + d
    if t < 0 {
        t = 0
    }
    if t > my {
        t = my
    }
    if t == from {
        return 0
    }
    nodes[id].vel_y = 0
    nodes[id].tgt_y = t
    nodes[id].smooth = u8(int(nodes[id].smooth) | 1)
    bar_on(id)
    mark_paint()
    return t - from
}

fn apply_smooth_x(id: int, d: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= nodes.len {
        return 0
    }
    let mut from = nodes[id].scroll_x
    if (int(nodes[id].smooth) & 2) != 0 {
        from = nodes[id].tgt_x
    }
    let mx = scroll_max_x(id)
    let mut t = from + d
    if t < 0 {
        t = 0
    }
    if t > mx {
        t = mx
    }
    if t == from {
        return 0
    }
    nodes[id].vel_x = 0
    nodes[id].tgt_x = t
    nodes[id].smooth = u8(int(nodes[id].smooth) | 2)
    bar_on(id)
    mark_paint()
    return t - from
}

/// Apply a pan delta. `momentum` 1 arms the coast (touch pans, precise
/// trackpads); 0 is a discrete wheel click, which must stop exactly where it
/// lands. Both clamp at the content bounds — a scroll ends at the first or
/// last content, never past it (no blank strip). Returns 1 if `scroll_y`
/// changed.
fn apply_delta_y(id: int, dy: int, momentum: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= nodes.len {
        return 0
    }
    let my = scroll_max(id)
    let mut ny = nodes[id].scroll_y + dy
    let mut v = dy
    if momentum == 0 {
        v = 0
    }
    if ny < 0 {
        ny = 0
        v = 0
    }
    if ny > my {
        ny = my
        v = 0
    }
    nodes[id].vel_y = v
    if ny == nodes[id].scroll_y {
        return 0
    }
    nodes[id].scroll_y = ny
    bar_on(id)
    mark_scroll()
    if nodes[id].bind_sig > 0 {
        store_sig_paint(nodes[id].bind_sig, ny)
    }
    return 1
}

fn apply_delta_x(id: int, dx: int, momentum: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= nodes.len {
        return 0
    }
    let mx = scroll_max_x(id)
    let mut nx = nodes[id].scroll_x + dx
    let mut v = dx
    if momentum == 0 {
        v = 0
    }
    if nx < 0 {
        nx = 0
        v = 0
    }
    if nx > mx {
        nx = mx
        v = 0
    }
    nodes[id].vel_x = v
    if nx == nodes[id].scroll_x {
        return 0
    }
    nodes[id].scroll_x = nx
    bar_on(id)
    mark_scroll()
    return 1
}

fn clamp_scroll(id: int) {
    if id <= 0 {
        return
    }
    if id >= nodes.len {
        return
    }
    if nodes[id].scroll_x < 0 {
        nodes[id].scroll_x = 0
    }
    if nodes[id].scroll_y < 0 {
        nodes[id].scroll_y = 0
    }
    let mx = scroll_max_x(id)
    let my = scroll_max(id)
    if nodes[id].scroll_x > mx {
        nodes[id].scroll_x = mx
    }
    if nodes[id].scroll_y > my {
        nodes[id].scroll_y = my
    }
    mark_scroll()
}

/// How long the thumb stays after the last scroll before it hides.
fn bar_hide() -> int {
    return 900
}

/// Scroll / drag bumped the bar: show it now and push the hide deadline out.
/// No track and no fade — it appears this frame and vanishes at the deadline
/// (`bar_expire`), so an idle pane costs no frames.
fn bar_on(id: int) {
    if id <= 0 {
        return
    }
    if id >= nodes.len {
        return
    }
    nodes[id].bar_t = platform.plat_now_ms() + bar_hide()
    mark_paint_id(id)
}

/// 1 while the bar should be visible: mid-drag or before its deadline.
fn bar_active(id: int) -> int {
    if drag_id == id {
        if drag_bar != 0 {
            return 1
        }
    }
    if nodes[id].bar_t > platform.plat_now_ms() {
        return 1
    }
    return 0
}

/// Per-frame: clear deadlines that passed and ask for one paint to hide the
/// thumb. Returns 1 if any bar just hid.
fn bar_expire() -> int {
    let n = nodes.len
    let mut hid = 0
    let now = platform.plat_now_ms()
    for i in 1..n {
        if nodes[i].bar_t != 0 {
            if nodes[i].bar_t <= now {
                nodes[i].bar_t = 0
                mark_paint_id(i)
                hid = 1
            }
        }
    }
    return hid
}

/// Milliseconds until the soonest thumb hides; 0 when none is shown. Lets an
/// idle host wake exactly once to paint the hide instead of polling.
fn bar_next_ms() -> int {
    let n = nodes.len
    let mut soon = 0
    let now = platform.plat_now_ms()
    for i in 1..n {
        if nodes[i].bar_t > now {
            let d = nodes[i].bar_t - now
            if soon == 0 || d < soon {
                soon = d
            }
        }
    }
    return soon
}

fn bar_visible(id: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= nodes.len {
        return 0
    }
    if int(nodes[id].kind) != 11 {
        return 0
    }
    if scroll_max(id) <= 0 {
        return 0
    }
    return bar_active(id)
}

fn bar_visible_x(id: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= nodes.len {
        return 0
    }
    if scrolls_x(id) == 0 {
        return 0
    }
    if scroll_max_x(id) <= 0 {
        return 0
    }
    return bar_active(id)
}

fn bar_alpha(id: int) -> int {
    return 180
}

fn bar_w() -> int {
    return 6
}

fn bar_x(id: int, ox: int) -> int {
    return ox + nodes[id].w - bar_w() - 3
}

fn bar_y(id: int, oy: int) -> int {
    return oy + 4
}

fn bar_track_h(id: int) -> int {
    let mut th = nodes[id].h - 8
    if bar_visible_x(id) != 0 {
        th = th - bar_w() - 2
    }
    return geometry.max2(th, 8)
}

fn bar_thumb_h(id: int) -> int {
    let th = bar_track_h(id)
    let mut thh = 32
    if nodes[id].ih > 0 {
        thh = geometry.max2(th * nodes[id].h / nodes[id].ih, 32)
    }
    if thh > th {
        thh = th
    }
    return thh
}

fn bar_thumb_y(id: int, oy: int) -> int {
    let maxs = scroll_max(id)
    let th = bar_track_h(id)
    let thh = bar_thumb_h(id)
    if maxs <= 0 {
        return bar_y(id, oy)
    }
    return bar_y(id, oy) + (th - thh) * nodes[id].scroll_y / maxs
}

fn bar_hx(id: int, ox: int) -> int {
    return ox + 4
}

fn bar_hy(id: int, oy: int) -> int {
    return oy + nodes[id].h - bar_w() - 3
}

fn bar_track_w(id: int) -> int {
    let mut tw = nodes[id].w - 8
    if bar_visible(id) != 0 {
        tw = tw - bar_w() - 2
    }
    return geometry.max2(tw, 8)
}

fn bar_thumb_w(id: int) -> int {
    let tw = bar_track_w(id)
    let mut thw = 32
    if nodes[id].iw > 0 {
        thw = geometry.max2(tw * nodes[id].w / nodes[id].iw, 32)
    }
    if thw > tw {
        thw = tw
    }
    return thw
}

fn bar_thumb_x(id: int, ox: int) -> int {
    let maxs = scroll_max_x(id)
    let tw = bar_track_w(id)
    let thw = bar_thumb_w(id)
    if maxs <= 0 {
        return bar_hx(id, ox)
    }
    return bar_hx(id, ox) + (tw - thw) * nodes[id].scroll_x / maxs
}

fn fg_of(id: int) -> int {
    if nodes[id].fg >= 0 {
        return paint_rgb(nodes[id].fg)
    }
    return 0
}

fn bind_pct(id: int) -> int {
    let mut v = sig_val(nodes[id].bind_sig)
    if v < 0 {
        v = 0
    }
    if v > 100 {
        v = 100
    }
    return v
}

fn is_floater(id: int) -> int {
    if id <= 0 {
        return 0
    }
    if int(nodes[id].kind) == 9 {
        return 1
    }
    if int(nodes[id].z_index) > 0 {
        return 1
    }
    return 0
}

/// Paint-time ring color for the keyboard-focused node. Theme slot 36 is
/// registered by the design system's `roles()` (foreground in both
/// appearances); before that it falls back to paint_rgb(0) = black.
fn focus_ring_rgb() -> int {
    return paint_rgb(2130706432 + 36)
}

fn is_focusable(id: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= nodes.len {
        return 0
    }
    if int(nodes[id].focusable) != 0 {
        return 1
    }
    if int(nodes[id].kind) == 10 {
        return 1
    }
    return 0
}

fn collect_focus(id: int) {
    if id <= 0 {
        return
    }
    if id >= nodes.len {
        return
    }
    if want_show(id) == 0 {
        return
    }
    if is_focusable(id) != 0 {
        push(focus_ring, id)
    }
    let nk = nodes[id].kids.len
    for i in 0..nk {
        collect_focus(nodes[id].kids[i])
    }
}

fn snapshot_focus() {
    focus_ring = []int {}
    collect_focus(root_id)
    focus_at = -1
    let n = focus_ring.len
    for i in 0..n {
        if focus_ring[i] == focus_id {
            focus_at = i
        }
    }
}

fn restore_focus() {
    focus_ring = []int {}
    collect_focus(root_id)
    if focus_at < 0 {
        focus_id = 0
        return
    }
    if focus_at >= focus_ring.len {
        focus_id = 0
        return
    }
    focus_id = focus_ring[focus_at]
}

fn claim_focus(id: int) {
    if id <= 0 {
        return
    }
    if id >= nodes.len {
        return
    }
    if is_focusable(id) != 0 {
        if focus_id != id {
            mark_paint()
        }
        focus_id = id
        return
    }
    claim_focus(nodes[id].parent)
}

fn walk_focus_chain(id: int) {
    if id <= 0 {
        return
    }
    if id >= nodes.len {
        return
    }
    push(chain_nodes, id)
    push(chain_ctxs, nodes[id].key_ctx)
    walk_focus_chain(nodes[id].parent)
}

fn fill_focus_chain() {
    chain_nodes = []int {}
    chain_ctxs = []int {}
    walk_focus_chain(focus_id)
    let depth = chain_nodes.len
    if depth == 0 {
        push(chain_nodes, 0)
        push(chain_ctxs, 0)
        return
    }
    if depth < 2 {
        return
    }
    let n = depth - 1
    for k in 0..n {
        let i = depth - 2 - k
        if chain_ctxs[i] == 0 {
            chain_ctxs[i] = chain_ctxs[i + 1]
        }
    }
}

fn focus_captures_text() -> int {
    if focus_id <= 0 {
        return 0
    }
    if focus_id >= nodes.len {
        return 0
    }
    if want_show(focus_id) == 0 {
        return 0
    }
    if nodes[focus_id].capture_text != 0 {
        return 1
    }
    if int(nodes[focus_id].kind) == 10 {
        return 1
    }
    return 0
}

fn focus_step(back: int) -> int {
    focus_ring = []int {}
    collect_focus(root_id)
    let count = focus_ring.len
    if count == 0 {
        return 0
    }
    let mut at = -1
    for i in 0..count {
        if focus_ring[i] == focus_id {
            at = i
        }
    }
    let mut next = 0
    if at < 0 {
        if back != 0 {
            next = count - 1
        } else {
            next = 0
        }
    } else if back != 0 {
        next = at - 1
        if next < 0 {
            next = count - 1
        }
    } else {
        next = at + 1
        if next >= count {
            next = 0
        }
    }
    if focus_ring[next] == focus_id {
        return 0
    }
    focus_id = focus_ring[next]
    kb_focus = 1
    mark_paint()
    return 1
}

fn stamp_edits() {
    let n = nodes.len
    let mut slot = 0
    for i in 0..n {
        if int(nodes[i].kind) == 10 {
            nodes[i].edit_slot = slot
            slot = slot + 1
        }
    }
}

fn input_shown(id: int) -> string {
    let slot = nodes[id].edit_slot
    if slot < 0 {
        return nodes[id].text
    }
    let shown = platform.plat_edit_shown(slot)
    if shown.len > 0 {
        return shown
    }
    if platform.plat_edit_len(slot) > 0 {
        return platform.plat_edit_text(slot)
    }
    return nodes[id].text
}

fn input_committed(id: int) -> string {
    let slot = nodes[id].edit_slot
    if slot < 0 {
        return ""
    }
    return platform.plat_edit_text(slot)
}

fn input_inner_w(id: int) -> int {
    let w = inner_w(id)
    if w < 1 {
        return 1
    }
    return w
}

fn edit_ready(id: int) -> int {
    if id <= 0 {
        return -1
    }
    if id >= nodes.len {
        return -1
    }
    if int(nodes[id].kind) != 10 {
        return -1
    }
    if nodes[id].edit_slot < 0 {
        stamp_edits()
    }
    let slot = nodes[id].edit_slot
    if slot < 0 {
        return -1
    }
    let mut font = i32(nodes[id].font)
    if font < 8 {
        font = 14
    }
    platform.plat_edit_metrics(slot, input_inner_w(id), font)
    return slot
}
