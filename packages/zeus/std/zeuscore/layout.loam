//! layout — measure + flex/grid/absolute (GPUI taffy.rs).
//!
//! Kind 11 (`scroll`): children are not shrunk on the block axis, so extra
//! height becomes `scroll_y`. Horizontal overflow is off unless `overflow` is
//! auto (3 / `scroll_xy`): then children keep intrinsic width and `scroll_x`
//! can move. Page containers use vertical-only so they never grow an H bar.

import "arena.loam"
import "geometry.loam"
import "platform.loam"
import "metrics.loam"

fn flex_grow_shrink(id: int, extra: int, row: int) -> int {
    let nk = arena.nodes[id].kids.len
    if extra == 0 {
        return 0
    }
    if extra > 0 {
        let mut growsum = 0
        for i in 0..nk {
            let c = arena.nodes[id].kids[i]
            if arena.skip_flow(c) == 0 {
                if arena.axis_frozen(c, row) == 0 {
                    if arena.nodes[c].grow > 0 {
                        growsum = growsum + arena.nodes[c].grow
                    }
                }
            }
        }
        if growsum <= 0 {
            return extra
        }
        let mut left = extra
        let mut last = -1
        for i in 0..nk {
            let c = arena.nodes[id].kids[i]
            if arena.skip_flow(c) == 0 {
                if arena.axis_frozen(c, row) == 0 {
                    if arena.nodes[c].grow > 0 {
                        let add = extra * arena.nodes[c].grow / growsum
                        arena.size_buffer[i] = arena.size_buffer[i] + add
                        left = left - add
                        last = i
                    }
                }
            }
        }
        if last >= 0 {
            arena.size_buffer[last] = arena.size_buffer[last] + left
            return 0
        }
        return extra
    }
    let mut shrinksum = 0
    for i in 0..nk {
        let c = arena.nodes[id].kids[i]
        if arena.skip_flow(c) == 0 {
            if arena.axis_frozen(c, row) == 0 {
                if arena.nodes[c].shrink > 0 {
                    if arena.size_buffer[i] > 0 {
                        shrinksum = shrinksum + arena.nodes[c].shrink
                    }
                }
            }
        }
    }
    if shrinksum <= 0 {
        return extra
    }
    let need = -extra
    let mut left = need
    for i in 0..nk {
        let c = arena.nodes[id].kids[i]
        if arena.skip_flow(c) == 0 {
            if arena.axis_frozen(c, row) == 0 {
                if arena.nodes[c].shrink > 0 {
                    if arena.size_buffer[i] > 0 {
                        let cut = need * arena.nodes[c].shrink / shrinksum
                        if cut > arena.size_buffer[i] {
                            left = left - arena.size_buffer[i]
                            arena.size_buffer[i] = 0
                        } else {
                            arena.size_buffer[i] = arena.size_buffer[i] - cut
                            left = left - cut
                        }
                    }
                }
            }
        }
    }
    return -left
}

fn apply_input_wrap(id: int) {
    if int(arena.nodes[id].kind) != 10 {
        return
    }
    if int(arena.nodes[id].wrap) == 0 {
        return
    }
    let inner = arena.inner_w(id)
    if inner <= 0 {
        return
    }
    let mut ww = 0
    let mut hh = 0
    metrics.measure_wrap(arena.input_shown(id), i32(arena.nodes[id].font), inner, &mut ww, &mut hh)
    let need = hh + arena.box_pad_y(id)
    if need > arena.nodes[id].h {
        arena.nodes[id].h = arena.clamp_h(id, need)
    }
}

fn apply_label_wrap(id: int) {
    if int(arena.nodes[id].kind) != 3 {
        return
    }
    if int(arena.nodes[id].ellipsis) != 0 {
        // A truncating label stays on one line; paint ellipsizes it.
        return
    }
    if arena.has_bound_num(id) != 0 {
        return
    }
    let inner = arena.inner_w(id)
    if inner <= 0 {
        return
    }
    if inner >= arena.nodes[id].text_width {
        return
    }
    /* A squeezed label in a flex row must not grow to two lines under siblings. */
    if int(arena.nodes[id].wrap) == 0 {
        let p = arena.nodes[id].parent
        if p > 0 {
            if int(arena.nodes[p].dir) == 0 {
                if int(arena.nodes[p].kind) == 1 {
                    return
                }
            }
        }
    }
    let mut ww = 0
    let mut hh = 0
    metrics.measure_wrap(arena.nodes[id].text, i32(arena.nodes[id].font), inner, &mut ww, &mut hh)
    arena.nodes[id].wrap = 1
    let need = hh + arena.box_pad_y(id)
    if need > arena.nodes[id].h {
        arena.nodes[id].h = arena.clamp_h(id, need)
    }
}

fn grow_to_children(id: int) {
    let nk = arena.nodes[id].kids.len
    let mut max_b = 0
    for i in 0..nk {
        let c = arena.nodes[id].kids[i]
        if arena.skip_flow(c) == 0 {
            let b = arena.nodes[c].y + arena.nodes[c].h + arena.nodes[c].m_b - arena.nodes[id].y
            if b > max_b {
                max_b = b
            }
        }
    }
    let mut need = max_b + i32(arena.nodes[id].pad_b) + i32(arena.nodes[id].border_w)
    if arena.nodes[id].explicit_height >= 0 {
        if need < arena.nodes[id].explicit_height {
            need = arena.nodes[id].explicit_height
        }
    }
    if need > arena.nodes[id].h {
        arena.nodes[id].h = need
    }
}

fn stretch_cross(p: int, c: int, row: int) -> int {
    if row != 0 {
        if arena.has_h(c) != 0 {
            return 0
        }
    } else {
        if arena.has_w(c) != 0 {
            return 0
        }
    }
    let al = arena.child_align(p, c)
    if al == 6 {
        return 1
    }
    return 0
}

fn measure_text(id: int) {
    let mut text_width = 0
    let mut text_height = 0
    if arena.has_bound_num(id) != 0 {
        metrics.measure_int(arena.bound_num(id), i32(arena.nodes[id].font), &mut text_width, &mut text_height)
    } else if int(arena.nodes[id].kind) == 10 {
        metrics.measure(arena.input_shown(id), i32(arena.nodes[id].font), &mut text_width, &mut text_height)
    } else {
        metrics.measure(arena.nodes[id].text, i32(arena.nodes[id].font), &mut text_width, &mut text_height)
    }
    arena.nodes[id].text_width = text_width
    arena.nodes[id].text_height = text_height
}

fn measure_node(id: int) {
    if id <= 0 {
        return
    }
    // Skip a subtree whose measure is already current: a write invalidates only
    // the path it touched (`arena.invalidate_path`), so an unchanged sibling — or
    // a whole clean subtree — is not re-measured.
    if arena.nodes[id].measure_stamp == arena.measure_gen {
        return
    }
    arena.nodes[id].measure_stamp = arena.measure_gen
    if arena.want_show(id) == 0 {
        arena.nodes[id].inner_width = 0
        arena.nodes[id].inner_height = 0
        return
    }
    let k = int(arena.nodes[id].kind)
    let nk = arena.nodes[id].kids.len
    if k == 3 {
        measure_text(id)
        let mut inner_width = arena.nodes[id].text_width + arena.box_pad_x(id)
        let mut inner_height = arena.nodes[id].text_height + arena.box_pad_y(id)
        if arena.nodes[id].explicit_width >= 0 {
            inner_width = arena.nodes[id].explicit_width
        }
        if arena.nodes[id].explicit_height >= 0 {
            inner_height = arena.nodes[id].explicit_height
        }
        arena.nodes[id].inner_width = arena.clamp_w(id, inner_width)
        arena.nodes[id].inner_height = arena.clamp_h(id, inner_height)
        return
    }
    if k == 4 {
        measure_text(id)
        let mut inner_width = arena.nodes[id].text_width + i32(arena.nodes[id].pad_l) + i32(arena.nodes[id].pad_r)
        let mut inner_height = arena.nodes[id].text_height + i32(arena.nodes[id].pad_t) + i32(arena.nodes[id].pad_b)
        if arena.nodes[id].explicit_width >= 0 {
            inner_width = arena.nodes[id].explicit_width
        }
        if arena.nodes[id].explicit_height >= 0 {
            inner_height = arena.nodes[id].explicit_height
        }
        arena.nodes[id].inner_width = arena.clamp_w(id, inner_width)
        arena.nodes[id].inner_height = arena.clamp_h(id, inner_height)
        return
    }
    if k == 10 {
        measure_text(id)
        let mut inner_width = arena.nodes[id].text_width + arena.box_pad_x(id)
        let mut inner_height = arena.nodes[id].text_height + arena.box_pad_y(id)
        if arena.nodes[id].explicit_width >= 0 {
            inner_width = arena.nodes[id].explicit_width
        }
        if arena.nodes[id].explicit_height >= 0 {
            inner_height = arena.nodes[id].explicit_height
        }
        arena.nodes[id].inner_width = arena.clamp_w(id, inner_width)
        arena.nodes[id].inner_height = arena.clamp_h(id, inner_height)
        return
    }
    if k == 5 {
        let mut inner_width = 0
        let mut inner_height = 0
        if arena.nodes[id].explicit_width >= 0 {
            inner_width = arena.nodes[id].explicit_width
        }
        if arena.nodes[id].explicit_height >= 0 {
            inner_height = arena.nodes[id].explicit_height
        }
        arena.nodes[id].inner_width = arena.clamp_w(id, inner_width)
        arena.nodes[id].inner_height = arena.clamp_h(id, inner_height)
        return
    }
    if k == 6 {
        let mut inner_width = 0
        let mut inner_height = 0
        if arena.nodes[id].explicit_width >= 0 {
            inner_width = arena.nodes[id].explicit_width
        }
        if arena.nodes[id].explicit_height >= 0 {
            inner_height = arena.nodes[id].explicit_height
        }
        arena.nodes[id].inner_width = arena.clamp_w(id, inner_width)
        arena.nodes[id].inner_height = arena.clamp_h(id, inner_height)
        return
    }
    if k == 7 {
        let mut inner_width = 0
        let mut inner_height = 0
        if arena.nodes[id].explicit_width >= 0 {
            inner_width = arena.nodes[id].explicit_width
        }
        if arena.nodes[id].explicit_height >= 0 {
            inner_height = arena.nodes[id].explicit_height
        }
        arena.nodes[id].inner_width = arena.clamp_w(id, inner_width)
        arena.nodes[id].inner_height = arena.clamp_h(id, inner_height)
        return
    }
    if k == 8 {
        let mut inner_width = 0
        let mut inner_height = 0
        if arena.nodes[id].explicit_width >= 0 {
            inner_width = arena.nodes[id].explicit_width
        }
        if arena.nodes[id].explicit_height >= 0 {
            inner_height = arena.nodes[id].explicit_height
        }
        arena.nodes[id].inner_width = arena.clamp_w(id, inner_width)
        arena.nodes[id].inner_height = arena.clamp_h(id, inner_height)
        return
    }
    if k == 12 {
        let mut inner_width = 0
        let mut inner_height = 0
        if arena.nodes[id].explicit_width >= 0 {
            inner_width = arena.nodes[id].explicit_width
        }
        if arena.nodes[id].explicit_height >= 0 {
            inner_height = arena.nodes[id].explicit_height
        }
        arena.nodes[id].inner_width = arena.clamp_w(id, inner_width)
        arena.nodes[id].inner_height = arena.clamp_h(id, inner_height)
        return
    }
    if k == 14 {
        /* Intrinsic size comes from the host (0 until it decodes the source).
           Recording it as the aspect ratio lets an `Image` with only a width
           keep its height, and a widthless image shrink to the container /
           device width (see `sized_w`) instead of collapsing to zero. */
        let mut sw = 0
        let mut sh = 0
        platform.plat_image_size(arena.nodes[id].text, &mut sw, &mut sh)
        arena.nodes[id].aspect_w = 0
        arena.nodes[id].aspect_h = 0
        if sw > 0 {
            if sh > 0 {
                arena.nodes[id].aspect_w = sw
                arena.nodes[id].aspect_h = sh
            }
        }
        let mut inner_width = sw
        let mut inner_height = 0
        if arena.nodes[id].explicit_width >= 0 {
            inner_width = arena.nodes[id].explicit_width
        }
        if arena.nodes[id].explicit_height >= 0 {
            inner_height = arena.nodes[id].explicit_height
        }
        /* No explicit height: the box height follows the aspect ratio at the
           width layout gives it, which is not known yet. Report 0 here and
           let the parent `grow_to_children` upward — claiming `sh` would
           reserve the source height and leave a gap under a shrunk image. */
        arena.nodes[id].inner_width = arena.clamp_w(id, inner_width)
        arena.nodes[id].inner_height = arena.clamp_h(id, inner_height)
        return
    }
    if k == 13 {
        let mut inner_width = 0
        let mut inner_height = 0
        if arena.nodes[id].explicit_width >= 0 {
            inner_width = arena.nodes[id].explicit_width
        }
        if arena.nodes[id].explicit_height >= 0 {
            inner_height = arena.nodes[id].explicit_height
        }
        arena.nodes[id].inner_width = arena.clamp_w(id, inner_width)
        arena.nodes[id].inner_height = arena.clamp_h(id, inner_height)
        return
    }
    for i in 0..nk {
        measure_node(arena.nodes[id].kids[i])
    }
    if k == 2 {
        let mut nflow = 0
        let mut cw = 0
        let mut rh = 0
        for i in 0..nk {
            let c = arena.nodes[id].kids[i]
            if arena.skip_flow(c) == 0 {
                nflow = nflow + 1
                cw = geometry.max2(cw, arena.nodes[c].inner_width)
                rh = geometry.max2(rh, arena.nodes[c].inner_height)
            }
        }
        let gx = arena.gap_x(id)
        let gy = arena.gap_y(id)
        /* Intrinsic width: the flow children in one row. An auto grid measures
           at that natural (widest) column count, because the width that would
           narrow it is not known yet — the parent assigns it after measuring.
           `layout_grid` makes the real choice, and grows the height when that
           choice lands on more rows than this guess. */
        let natural = nflow * cw + gx * geometry.max2(nflow - 1, 0)
        let cols = grid_cols_at(id, natural, nflow, cw)
        let mut rows = 0
        if nflow > 0 {
            rows = (nflow + cols - 1) / cols
        }
        let mut inner_width = cols * cw + gx * geometry.max2(cols - 1, 0) + arena.box_pad_x(id)
        let mut inner_height = rows * rh + gy * geometry.max2(rows - 1, 0) + arena.box_pad_y(id)
        if arena.nodes[id].explicit_width >= 0 {
            inner_width = arena.nodes[id].explicit_width
        }
        if arena.nodes[id].explicit_height >= 0 {
            inner_height = arena.nodes[id].explicit_height
        }
        arena.nodes[id].inner_width = arena.clamp_w(id, inner_width)
        arena.nodes[id].inner_height = arena.clamp_h(id, inner_height)
        return
    }
    let mut acc = 0
    let mut cross = 0
    let mut first = 1
    for i in 0..nk {
        let c = arena.nodes[id].kids[i]
        if arena.skip_flow(c) == 0 {
            if first == 0 {
                if int(arena.nodes[id].dir) == 0 {
                    acc = acc + arena.gap_x(id)
                } else {
                    acc = acc + arena.gap_y(id)
                }
            }
            first = 0
            if int(arena.nodes[id].dir) == 0 {
                acc = acc + arena.nodes[c].inner_width + arena.nodes[c].m_l + arena.nodes[c].m_r
                cross = geometry.max2(cross, arena.nodes[c].inner_height + arena.nodes[c].m_t + arena.nodes[c].m_b)
            } else {
                acc = acc + arena.nodes[c].inner_height + arena.nodes[c].m_t + arena.nodes[c].m_b
                cross = geometry.max2(cross, arena.nodes[c].inner_width + arena.nodes[c].m_l + arena.nodes[c].m_r)
            }
        }
    }
    let mut inner_width = 0
    let mut inner_height = 0
    if int(arena.nodes[id].dir) == 0 {
        inner_width = acc + arena.box_pad_x(id)
        inner_height = cross + arena.box_pad_y(id)
    } else {
        inner_width = cross + arena.box_pad_x(id)
        inner_height = acc + arena.box_pad_y(id)
    }
    if arena.nodes[id].explicit_width >= 0 {
        inner_width = arena.nodes[id].explicit_width
    }
    if arena.nodes[id].explicit_height >= 0 {
        inner_height = arena.nodes[id].explicit_height
    }
    arena.nodes[id].inner_width = arena.clamp_w(id, inner_width)
    arena.nodes[id].inner_height = arena.clamp_h(id, inner_height)
}

fn layout_flex_row(id: int) {
    let nk = arena.nodes[id].kids.len
    if nk <= 0 {
        return
    }
    let mut nflow = 0
    for i in 0..nk {
        if arena.skip_flow(arena.nodes[id].kids[i]) == 0 {
            nflow = nflow + 1
        }
    }
    if nflow <= 0 {
        return
    }
    arena.size_fit(nk)
    let inner_width = arena.inner_w(id)
    let inner_height = arena.inner_h(id)
    let gx = arena.gap_x(id)
    let mut fixed = gx * geometry.max2(nflow - 1, 0)
    for i in 0..nk {
        let c = arena.nodes[id].kids[i]
        arena.size_buffer[i] = 0
        if arena.skip_flow(c) == 0 {
            arena.size_buffer[i] = row_child_w(id, c, inner_width)
            fixed = fixed + arena.size_buffer[i] + arena.nodes[c].m_l + arena.nodes[c].m_r
        }
    }
    let mut extra = inner_width - fixed
    if extra < 0 {
        // Rows shrink before they wrap: flexible children (grow = 1) narrow
        // to keep the row on one line. What they cannot absorb still wraps.
        extra = row_flex_absorb(id, nk, extra)
        if extra < 0 {
            layout_flex_row_wrap(id)
            return
        }
    }
    extra = flex_grow_shrink(id, extra, 1)
    for i in 0..nk {
        arena.nodes[arena.nodes[id].kids[i]].aw = arena.size_buffer[i]
    }
    let mut ox = 0
    let mut between = 0
    if extra > 0 {
        if nflow > 0 {
            let mode = int(arena.nodes[id].justify)
            if mode == 1 {
                ox = extra / 2
            } else if mode == 2 {
                ox = extra
            } else if mode == 3 {
                if nflow > 1 {
                    between = extra / (nflow - 1)
                }
            } else if mode == 4 {
                between = extra / nflow
                ox = between / 2
            } else if mode == 5 {
                between = extra / (nflow + 1)
                ox = between
            }
        }
    }
    let x0 = arena.content_x(id)
    let y0 = arena.content_y(id)
    let mut cx = x0 + ox
    for j in 0..nk {
        let mut i = j
        if int(arena.nodes[id].reverse) != 0 {
            i = nk - 1 - j
        }
        let c = arena.nodes[id].kids[i]
        if arena.skip_flow(c) == 0 {
            let al = arena.child_align(id, c)
            let aw = arena.nodes[c].aw
            let mut ch = arena.sized_h(c, inner_height, aw)
            if stretch_cross(id, c, 1) != 0 {
                ch = geometry.max2(inner_height - arena.nodes[c].m_t - arena.nodes[c].m_b, 0)
            }
            let cy = geometry.cross_origin(al, y0, inner_height, ch + arena.nodes[c].m_t + arena.nodes[c].m_b) + arena.nodes[c].m_t
            layout_node(c, cx + arena.nodes[c].m_l, cy, aw, ch)
            cx = cx + arena.nodes[c].w + arena.nodes[c].m_l + arena.nodes[c].m_r + gx + between
        }
    }
    grow_to_children(id)
}

fn is_flex_row(id: int) -> int {
    if int(arena.nodes[id].dir) != 0 {
        return 0
    }
    if int(arena.nodes[id].kind) == 1 {
        return 1
    }
    if int(arena.nodes[id].kind) == 9 {
        return 1
    }
    return 0
}

/// Width a flow child wants on the row's main axis, measured the same way in
/// every pass (layout pre-pass, wrap measurement).
fn row_child_w(id: int, c: int, inner_width: int) -> int {
    let avail = inner_width - arena.nodes[c].m_l - arena.nodes[c].m_r
    return geometry.fit_avail(arena.sized_w(c, inner_width, 1), avail)
}

/// A row child may give up main-axis width to keep the row on one line:
/// flexible children (no explicit width) that are allowed to shrink. These
/// are exactly the children `grow = 1` marks as elastic (with `shrink = 1`
/// where the widget default of 0 would refuse to narrow).
fn row_can_absorb(c: int) -> int {
    if arena.axis_frozen(c, 1) != 0 {
        return 0
    }
    // A truncating label narrows to whatever the row has left instead of
    // overflowing or pushing its siblings onto a second line; paint then
    // draws the ellipsis.
    if int(arena.nodes[c].ellipsis) != 0 {
        return 1
    }
    if arena.nodes[c].grow <= 0 {
        return 0
    }
    if arena.nodes[c].shrink <= 0 {
        return 0
    }
    return 1
}

/// Absorb a main-axis deficit (`extra < 0`) by narrowing flexible children,
/// never below `min_w`. Returns the leftover deficit (still negative) when
/// the children cannot take it all — the caller wraps those instead.
fn row_flex_absorb(id: int, nk: int, extra: int) -> int {
    let need = -extra
    let mut cap = 0
    for i in 0..nk {
        let c = arena.nodes[id].kids[i]
        if arena.skip_flow(c) == 0 {
            if row_can_absorb(c) != 0 {
                let mut floor = 0
                if arena.nodes[c].min_w >= 0 {
                    floor = arena.nodes[c].min_w
                }
                let room = arena.size_buffer[i] - floor
                if room > 0 {
                    cap = cap + room
                }
            }
        }
    }
    if cap <= 0 {
        return extra
    }
    if cap < need {
        return extra
    }
    let mut left = need
    let mut last = -1
    for i in 0..nk {
        let c = arena.nodes[id].kids[i]
        if arena.skip_flow(c) == 0 {
            if row_can_absorb(c) != 0 {
                let mut floor = 0
                if arena.nodes[c].min_w >= 0 {
                    floor = arena.nodes[c].min_w
                }
                let room = arena.size_buffer[i] - floor
                if room > 0 {
                    let cut = need * room / cap
                    arena.size_buffer[i] = arena.size_buffer[i] - cut
                    left = left - cut
                    last = i
                }
            }
        }
    }
    if last >= 0 {
        arena.size_buffer[last] = arena.size_buffer[last] - left
    }
    return 0
}

/// Height a row needs when children wrap at `outer_w` (includes padding).
fn wrap_row_h(id: int, outer_w: int) -> int {
    let nk = arena.nodes[id].kids.len
    let inner_width = geometry.max2(outer_w - arena.box_pad_x(id), 0)
    let gx = arena.gap_x(id)
    let gy = arena.gap_y(id)
    // If the flexible children can absorb the overflow, the row stays on one
    // line — mirror layout_flex_row's shrink decision so column parents give
    // the row exactly the height it will occupy.
    let mut accw = 0
    let mut nflow = 0
    let mut cap = 0
    let mut line_h = 0
    for i in 0..nk {
        let c = arena.nodes[id].kids[i]
        if arena.skip_flow(c) == 0 {
            let cw = row_child_w(id, c, inner_width)
            let span = cw + arena.nodes[c].m_l + arena.nodes[c].m_r
            if nflow > 0 {
                accw = accw + gx
            }
            accw = accw + span
            nflow = nflow + 1
            let ch = arena.sized_h(c, line_h, cw)
            let mh = ch + arena.nodes[c].m_t + arena.nodes[c].m_b
            if mh > line_h {
                line_h = mh
            }
            if row_can_absorb(c) != 0 {
                let mut floor = 0
                if arena.nodes[c].min_w >= 0 {
                    floor = arena.nodes[c].min_w
                }
                let room = cw - floor
                if room > 0 {
                    cap = cap + room
                }
            }
        }
    }
    if accw > inner_width {
        if cap >= accw - inner_width {
            let mut total = line_h + arena.box_pad_y(id)
            if arena.nodes[id].explicit_height >= 0 {
                if total < arena.nodes[id].explicit_height {
                    total = arena.nodes[id].explicit_height
                }
            }
            return arena.clamp_h(id, total)
        }
    }
    let mut x = 0
    let mut total = 0
    let mut first = 1
    let mut nline = 0
    for i in 0..nk {
        let c = arena.nodes[id].kids[i]
        if arena.skip_flow(c) == 0 {
            let cw = row_child_w(id, c, inner_width)
            let ch = arena.sized_h(c, line_h, cw)
            let span = cw + arena.nodes[c].m_l + arena.nodes[c].m_r
            if first == 0 {
                if x + span > inner_width {
                    total = total + line_h
                    nline = nline + 1
                    x = 0
                    line_h = 0
                }
            }
            first = 0
            let mh = ch + arena.nodes[c].m_t + arena.nodes[c].m_b
            if mh > line_h {
                line_h = mh
            }
            x = x + span + gx
        }
    }
    if first == 0 {
        total = total + line_h
        nline = nline + 1
    }
    if nline > 1 {
        total = total + gy * (nline - 1)
    }
    total = total + arena.box_pad_y(id)
    if arena.nodes[id].explicit_height >= 0 {
        if total < arena.nodes[id].explicit_height {
            total = arena.nodes[id].explicit_height
        }
    }
    return arena.clamp_h(id, total)
}

fn wrap_mark_line(id: int, lo: int, hi: int, line_h: int) {
    for j in lo..hi {
        let c = arena.nodes[id].kids[j]
        if arena.skip_flow(c) == 0 {
            arena.nodes[c].ah = line_h
        }
    }
}

fn layout_flex_row_wrap(id: int) {
    let nk = arena.nodes[id].kids.len
    let inner_width = arena.inner_w(id)
    let inner_height = arena.inner_h(id)
    let gx = arena.gap_x(id)
    let gy = arena.gap_y(id)
    let x0 = arena.content_x(id)
    let y0 = arena.content_y(id)
    arena.size_fit(nk)
    let mut x = 0
    let mut line_h = 0
    let mut line_start = 0
    let mut first = 1
    for i in 0..nk {
        let c = arena.nodes[id].kids[i]
        if arena.skip_flow(c) == 0 {
            let avail = inner_width - arena.nodes[c].m_l - arena.nodes[c].m_r
            let mut cw = geometry.fit_avail(arena.sized_w(c, inner_width, 1), avail)
            let mut ch = arena.sized_h(c, inner_height, cw)
            let span = cw + arena.nodes[c].m_l + arena.nodes[c].m_r
            if first == 0 {
                if x + span > inner_width {
                    wrap_mark_line(id, line_start, i, line_h)
                    x = 0
                    line_h = 0
                    line_start = i
                }
            }
            first = 0
            arena.nodes[c].aw = cw
            let mh = ch + arena.nodes[c].m_t + arena.nodes[c].m_b
            if mh > line_h {
                line_h = mh
            }
            x = x + span + gx
        }
    }
    wrap_mark_line(id, line_start, nk, line_h)
    x = 0
    let mut y = 0
    line_start = 0
    first = 1
    for i in 0..nk {
        let c = arena.nodes[id].kids[i]
        if arena.skip_flow(c) == 0 {
            let cw = arena.nodes[c].aw
            let span = cw + arena.nodes[c].m_l + arena.nodes[c].m_r
            if first == 0 {
                if x + span > inner_width {
                    y = y + arena.nodes[arena.nodes[id].kids[line_start]].ah + gy
                    x = 0
                    line_start = i
                }
            }
            first = 0
            let lh = arena.nodes[c].ah
            let mut ch = arena.sized_h(c, inner_height, cw)
            let al = arena.child_align(id, c)
            if stretch_cross(id, c, 1) != 0 {
                ch = geometry.max2(lh - arena.nodes[c].m_t - arena.nodes[c].m_b, 0)
            }
            let cy = geometry.cross_origin(al, y0 + y, lh, ch + arena.nodes[c].m_t + arena.nodes[c].m_b) + arena.nodes[c].m_t
            layout_node(c, x0 + x + arena.nodes[c].m_l, cy, cw, ch)
            x = x + span + gx
        }
    }
    grow_to_children(id)
}

fn layout_flex_col(id: int) {
    let nk = arena.nodes[id].kids.len
    if nk <= 0 {
        return
    }
    let mut nflow = 0
    for i in 0..nk {
        if arena.skip_flow(arena.nodes[id].kids[i]) == 0 {
            nflow = nflow + 1
        }
    }
    if nflow <= 0 {
        return
    }
    arena.size_fit(nk)
    let inner_width = arena.inner_w(id)
    let inner_height = arena.inner_h(id)
    let gy = arena.gap_y(id)
    let mut fixed = gy * geometry.max2(nflow - 1, 0)
    for i in 0..nk {
        let c = arena.nodes[id].kids[i]
        arena.size_buffer[i] = 0
        if arena.skip_flow(c) == 0 {
            let avail = inner_width - arena.nodes[c].m_l - arena.nodes[c].m_r
            let mut cw = arena.sized_w(c, inner_width, 0)
            if arena.scrolls_x(id) != 0 {
                if arena.nodes[c].inner_width > cw {
                    cw = arena.clamp_w(c, arena.nodes[c].inner_width)
                }
            } else {
                if stretch_cross(id, c, 0) != 0 {
                    cw = arena.clamp_w(c, avail)
                }
                cw = geometry.fit_avail(cw, avail)
            }
            let mut ch = arena.sized_h(c, inner_height, cw)
            if is_flex_row(c) != 0 {
                let wh = wrap_row_h(c, cw)
                if wh > ch {
                    ch = wh
                }
            }
            arena.size_buffer[i] = ch
            fixed = fixed + arena.size_buffer[i] + arena.nodes[c].m_t + arena.nodes[c].m_b
        }
    }
    let mut extra = inner_height - fixed
    if int(arena.nodes[id].kind) == 11 {
        if extra < 0 {
            extra = 0
        }
    }
    extra = flex_grow_shrink(id, extra, 0)
    for i in 0..nk {
        arena.nodes[arena.nodes[id].kids[i]].ah = arena.size_buffer[i]
    }
    let mut oy = 0
    let mut between = 0
    if extra > 0 {
        if nflow > 0 {
            let mode = int(arena.nodes[id].justify)
            if mode == 1 {
                oy = extra / 2
            } else if mode == 2 {
                oy = extra
            } else if mode == 3 {
                if nflow > 1 {
                    between = extra / (nflow - 1)
                }
            } else if mode == 4 {
                between = extra / nflow
                oy = between / 2
            } else if mode == 5 {
                between = extra / (nflow + 1)
                oy = between
            }
        }
    }
    let x0 = arena.content_x(id)
    let y0 = arena.content_y(id)
    let mut cy = y0 + oy
    for j in 0..nk {
        let mut i = j
        if int(arena.nodes[id].reverse) != 0 {
            i = nk - 1 - j
        }
        let c = arena.nodes[id].kids[i]
        if arena.skip_flow(c) == 0 {
            let al = arena.child_align(id, c)
            let avail = inner_width - arena.nodes[c].m_l - arena.nodes[c].m_r
            let mut cw = arena.sized_w(c, inner_width, 0)
            if arena.scrolls_x(id) != 0 {
                if arena.nodes[c].inner_width > cw {
                    cw = arena.clamp_w(c, arena.nodes[c].inner_width)
                }
            } else {
                if stretch_cross(id, c, 0) != 0 {
                    cw = arena.clamp_w(c, avail)
                }
                cw = geometry.fit_avail(cw, avail)
            }
            let cx = geometry.cross_origin(al, x0, inner_width, cw + arena.nodes[c].m_l + arena.nodes[c].m_r) + arena.nodes[c].m_l
            layout_node(c, cx, cy + arena.nodes[c].m_t, cw, arena.nodes[c].ah)
            cy = cy + arena.nodes[c].h + arena.nodes[c].m_t + arena.nodes[c].m_b + gy + between
        }
    }
    if nflow > 0 {
        let content = cy - gy - between - arena.nodes[id].y + i32(arena.nodes[id].pad_b) + i32(arena.nodes[id].border_w)
        if int(arena.nodes[id].kind) == 11 {
            arena.nodes[id].ext_h = geometry.max2(content, arena.nodes[id].h)
            if arena.scrolls_x(id) != 0 {
                let mut content_w = arena.nodes[id].w
                for i in 0..nk {
                    let c = arena.nodes[id].kids[i]
                    if arena.skip_flow(c) == 0 {
                        let right = arena.nodes[c].x + arena.nodes[c].w + arena.nodes[c].m_r - arena.nodes[id].x + i32(arena.nodes[id].pad_r) + i32(arena.nodes[id].border_w)
                        if right > content_w {
                            content_w = right
                        }
                    }
                }
                arena.nodes[id].ext_w = geometry.max2(content_w, arena.nodes[id].w)
            } else {
                arena.nodes[id].ext_w = arena.nodes[id].w
                arena.nodes[id].scroll_x = 0
            }
            arena.clamp_scroll(id)
        } else if content > arena.nodes[id].h {
            arena.nodes[id].h = content
        }
    }
}

/// Column count a grid resolves to, shared by `measure_node` and
/// `layout_grid` so the two cannot disagree.
///
/// `grid_auto == 0` is the fixed case: `grid_cols` is the count, floored at 1
/// (`grid_cols == 0`, i.e. `GridConfig {}`, means a single column).
///
/// `grid_auto != 0` is auto mode, where a column is a *cell* of a minimum
/// width and the count is however many such cells fit the width `inner_width` has,
/// capped by `grid_cols` when the caller gave one and by `flow` children so
/// the last row is never empty tracks.
///
/// The cell width is `grid_min` when the caller set one. With no floor it is
/// `nat` — the widest child's natural width — because a column has to be at
/// least wide enough for what goes in it; that is the same rule `measure_node`
/// uses to guess the grid's own width, so the two agree by construction. If
/// neither is available (`nat <= 0`: the children report no width of their
/// own) the count falls back to `grid_cols`, which is the fixed behaviour.
///
/// The gap is part of the cell (`cell + gx`), matching the packing in
/// `layout_grid`, where `cols` cells plus `cols - 1` gaps span `inner_width`.
///
/// `flow` is how many children will actually be placed. `0` means the caller
/// has none to offer (measure saw no flow children) — the cap is skipped
/// rather than collapsing the count to nothing.
fn grid_cols_at(id: int, inner_width: int, flow: int, nat: int) -> int {
    let mut cols = i32(arena.nodes[id].grid_cols)
    if arena.nodes[id].grid_auto != 0 {
        let mut cell = i32(arena.nodes[id].grid_min)
        if cell <= 0 {
            cell = nat
        }
        if cell > 0 {
            cell = cell + arena.gap_x(id)
            cols = (inner_width + arena.gap_x(id)) / cell
        }
        if cols < 1 {
            cols = 1
        }
        if arena.nodes[id].grid_cols > 0 {
            if cols > i32(arena.nodes[id].grid_cols) {
                cols = i32(arena.nodes[id].grid_cols)
            }
        }
        if flow > 0 {
            if cols > flow {
                cols = flow
            }
        }
    } else if cols < 1 {
        cols = 1
    }
    return cols
}

fn layout_grid(id: int) {
    let nk = arena.nodes[id].kids.len
    let inner_width = arena.inner_w(id)
    let inner_height = arena.inner_h(id)
    let gx = arena.gap_x(id)
    let gy = arena.gap_y(id)
    /* Count flow children before choosing columns: a hidden child must not
       claim a track, or every visible cell would be that much narrower. The
       widest of them is the natural cell width when no floor was given. */
    let mut flow = 0
    let mut nat = 0
    for i in 0..nk {
        let c = arena.nodes[id].kids[i]
        if arena.skip_flow(c) == 0 {
            flow = flow + 1
            nat = geometry.max2(nat, arena.nodes[c].inner_width)
        }
    }
    let cols = grid_cols_at(id, inner_width, flow, nat)
    let mut cw = inner_width
    if cols > 0 {
        cw = (inner_width - gx * (cols - 1)) / cols
    }
    if cw < 0 {
        cw = 0
    }
    let x0 = arena.content_x(id)
    let y0 = arena.content_y(id)
    let mut col = 0
    let mut y = y0
    let mut rh = 0
    let mut placed = 0
    for i in 0..nk {
        let c = arena.nodes[id].kids[i]
        if arena.skip_flow(c) == 0 {
            let mut sp = i32(arena.nodes[c].span)
            if sp < 1 {
                sp = 1
            }
            if sp > cols {
                sp = cols
            }
            if col + sp > cols {
                y = y + rh + gy
                rh = 0
                col = 0
            }
            let cx = x0 + col * (cw + gx)
            let cww = cw * sp + gx * (sp - 1)
            let ch = arena.sized_h(c, inner_height, cww)
            layout_node(c, cx, y, cww, ch)
            rh = geometry.max2(rh, arena.nodes[c].h)
            col = col + sp
            placed = 1
        }
    }
    if placed != 0 {
        let content = y + rh - arena.nodes[id].y + i32(arena.nodes[id].pad_b) + i32(arena.nodes[id].border_w)
        if content > arena.nodes[id].h {
            arena.nodes[id].h = content
        }
    }
}

fn layout_abs(p: int) {
    let nk = arena.nodes[p].kids.len
    let inner_width = arena.inner_w(p)
    let inner_height = arena.inner_h(p)
    let ox = arena.content_x(p)
    let oy = arena.content_y(p)
    for i in 0..nk {
        let c = arena.nodes[p].kids[i]
        if c > 0 {
            if arena.want_show(c) != 0 {
                if int(arena.nodes[c].pos) == 1 {
                    if int(arena.nodes[c].kind) != 9 {
                        /* `row = 1` asks `sized_w` for the CONTENT width. The
                           `row = 0` form means "fill the parent", which is how
                           a column stretches a flow child — and it is what made
                           every absolutely positioned box with no explicit
                           width render as a full-width div: the tooltip bubble
                           was as wide as the window, and so was a popover with
                           an unset `width`. An absolute node shrink-wraps unless
                           it says otherwise; an explicit `width` or an explicit
                           percentage still wins inside `sized_w`. */
                        let mut w = arena.sized_w(c, inner_width, 1)
                        let mut h = arena.sized_h(c, inner_height, w)
                        let mut x = ox
                        let mut y = oy
                        /* `-1` is "unset", not "zero" — the guard used to be
                           `>= 0`, which also swallowed every real NEGATIVE
                           offset. That is why `left = -3, top = -3` (the ring
                           around the accent dot) sat still: the ring drew at the
                           parent's origin and hung 3px down-right of the dot. */
                        if arena.nodes[c].pin_l != -1 {
                            x = ox + arena.nodes[c].pin_l
                        }
                        if arena.nodes[c].pin_t != -1 {
                            y = oy + arena.nodes[c].pin_t
                        }
                        if arena.nodes[c].pin_l != -1 {
                            if arena.nodes[c].pin_r != -1 {
                                w = arena.clamp_w(c, inner_width - arena.nodes[c].pin_l - arena.nodes[c].pin_r)
                            }
                        }
                        if arena.nodes[c].pin_t != -1 {
                            if arena.nodes[c].pin_b != -1 {
                                h = arena.clamp_h(c, inner_height - arena.nodes[c].pin_t - arena.nodes[c].pin_b)
                            }
                        }
                        if arena.nodes[c].pin_r != -1 {
                            if arena.nodes[c].pin_l == -1 {
                                x = ox + inner_width - w - arena.nodes[c].pin_r
                            }
                        }
                        if arena.nodes[c].pin_b != -1 {
                            if arena.nodes[c].pin_t == -1 {
                                y = oy + inner_height - h - arena.nodes[c].pin_b
                            }
                        }
                        layout_node(c, x, y, w, h)
                    }
                }
            }
        }
    }
}

fn layout_overlays(id: int) {
    if id <= 0 {
        return
    }
    if arena.want_show(id) == 0 {
        return
    }
    let nk = arena.nodes[id].kids.len
    for i in 0..nk {
        let c = arena.nodes[id].kids[i]
        if arena.want_show(c) != 0 {
            if int(arena.nodes[c].kind) == 9 {
                let ox = arena.safe_l
                let oy = arena.safe_t
                let mut ow = arena.win_w - arena.safe_l - arena.safe_r
                let mut oh = arena.win_h - arena.safe_t - arena.safe_b
                if ow < 0 {
                    ow = 0
                }
                if oh < 0 {
                    oh = 0
                }
                layout_node(c, ox, oy, ow, oh)
                arena.nodes[c].x = ox
                arena.nodes[c].y = oy
                arena.nodes[c].w = ow
                arena.nodes[c].h = oh
            }
            layout_overlays(c)
        }
    }
}

fn layout_node(id: int, x: int, y: int, w: int, h: int) {
    if id <= 0 {
        return
    }
    arena.nodes[id].x = x
    arena.nodes[id].y = y
    arena.nodes[id].lay_h = h
    arena.nodes[id].w = arena.clamp_w(id, w)
    arena.nodes[id].h = arena.clamp_h(id, h)
    apply_label_wrap(id)
    apply_input_wrap(id)
    let k = int(arena.nodes[id].kind)
    if k == 1 {
        if int(arena.nodes[id].dir) == 0 {
            layout_flex_row(id)
        } else {
            layout_flex_col(id)
        }
    } else if k == 9 {
        if int(arena.nodes[id].dir) == 0 {
            layout_flex_row(id)
        } else {
            layout_flex_col(id)
        }
    } else if k == 11 {
        layout_flex_col(id)
    } else if k == 2 {
        layout_grid(id)
    }
    layout_abs(id)
}

fn layout(width: int, height: int) {
    arena.ensure()
    if width > 0 {
        arena.win_w = width
    }
    if height > 0 {
        arena.win_h = height
    }
    arena.safe_t = platform.plat_inset_top()
    arena.safe_r = platform.plat_inset_right()
    arena.safe_b = platform.plat_inset_bottom()
    arena.safe_l = platform.plat_inset_left()
    if arena.root_id <= 0 {
        return
    }
    measure_node(arena.root_id)
    layout_node(arena.root_id, 0, 0, arena.win_w, arena.win_h)
    layout_overlays(arena.root_id)
    // Floaters are re-placed every layout, and a scroll re-runs layout while any
    // are on screen (`arena.mark_scroll`), so a popup stays next to its trigger.
    arena.live_anchors = 0
    place_anchored(arena.root_id)
}

// --- subtree re-solve --------------------------------------------------------
//
// A frame's layout dirt names nodes: a prop write landed on one, or a host's kid
// list moved under one. `relayout` finds, for each, the nearest ancestor whose
// *box* the change cannot have moved — the boundary — and re-solves only that
// subtree, from the exact call its parent made (`x`, `y`, `w`, `lay_h`).
//
// A box is unmovable on an axis when the re-measure left the node's natural
// size on that axis unchanged (then nothing above it can have changed either),
// or when the parent imposes that axis regardless of the natural size — a
// percent width in a column, a cross-axis stretch — *and* the parent's own box
// on that axis is unmovable in turn, because a column's natural width is the
// widest child's and the change may have moved it. So the test runs top-down
// along the path from the root, whose box is the window.
//
// Two cases are declined outright. A flex row under a column: the column
// sizes it from `wrap_row_h`, which depends on the children's widths in order,
// not on any natural size. And a prop-written node as its own boundary: the
// write may have changed how the parent sizes it (`w_pct`, `align_self`, a
// margin), which no natural size reflects. Finally the re-solve is checked:
// if the boundary's box did not hold — a wrapped label made the column taller,
// or shorter — the change reaches above it, and the frame falls back to the
// whole tree. Under-solving is the one failure that leaves a stale box.

/// The natural size of every node on a dirty path, taken before the re-measure
/// overwrites it. Indexed by node id, grown lazily; bit 2 of `dirty` marks the
/// nodes taken this frame.
let mut nat_w0: []int = []int {}
let mut nat_h0: []int = []int {}

fn snapshot_natural(id: int) {
    while nat_w0.len <= id {
        push(nat_w0, 0)
        push(nat_h0, 0)
    }
    nat_w0[id] = arena.nodes[id].inner_width
    nat_h0[id] = arena.nodes[id].inner_height
}

/// 1 when the parent `q` hands `p` its width regardless of `p`'s natural width.
fn imposed_w(q: int, p: int) -> int {
    if arena.nodes[p].explicit_width >= 0 {
        return 0
    }
    if arena.skip_flow(p) != 0 {
        return 0
    }
    let qk = int(arena.nodes[q].kind)
    let mut col = 0
    if qk == 11 {
        col = 1
    } else if qk == 1 || qk == 9 {
        if int(arena.nodes[q].dir) != 0 {
            col = 1
        }
    } else {
        return 0
    }
    if col == 0 {
        // A row sizes a child from its natural width, then shrinks / grows the
        // line; a percent other than 100 is the one width it hands down.
        if int(arena.nodes[p].w_pct) >= 0 {
            if int(arena.nodes[p].w_pct) != 100 {
                return 1
            }
        }
        return 0
    }
    // A column: a percent width is the available width's share (an image is
    // capped at its source width, so not that), and a stretch is the available
    // width — unless the column scrolls sideways, where a child keeps its
    // natural width.
    if arena.scrolls_x(q) != 0 {
        return 0
    }
    if int(arena.nodes[p].w_pct) >= 0 {
        if int(arena.nodes[p].kind) != 14 {
            return 1
        }
    }
    if stretch_cross(q, p, 0) != 0 {
        return 1
    }
    return 0
}

/// 1 when the parent `q` hands `p` its height regardless of `p`'s natural height.
fn imposed_h(q: int, p: int) -> int {
    if arena.nodes[p].explicit_height >= 0 {
        return 0
    }
    if arena.skip_flow(p) != 0 {
        return 0
    }
    let qk = int(arena.nodes[q].kind)
    if qk != 1 && qk != 9 {
        return 0
    }
    if int(arena.nodes[q].dir) != 0 {
        // A column sizes a child from its natural height (plus a grow share
        // that depends on it).
        return 0
    }
    if int(arena.nodes[p].h_pct) >= 0 {
        return 1
    }
    if stretch_cross(q, p, 1) != 0 {
        return 1
    }
    return 0
}

/// A flex row under a column: its assigned height is `wrap_row_h`, a function
/// of the children's widths in order, which no natural size captures.
fn wraps_under_column(p: int) -> int {
    if is_flex_row(p) == 0 {
        return 0
    }
    let q = arena.nodes[p].parent
    if q <= 0 {
        return 0
    }
    let qk = int(arena.nodes[q].kind)
    if qk == 11 {
        return 1
    }
    if qk == 1 || qk == 9 {
        if int(arena.nodes[q].dir) != 0 {
            return 1
        }
    }
    return 0
}

/// The boundary for one dirty node: the nearest ancestor (itself included when
/// `own` is 1) whose box the change cannot have moved. 0 when the change can
/// reach the root, or the node is not under it.
fn find_boundary(d: int, own: int) -> int {
    let root = arena.root_id
    // The path root -> d, so the axis test can run top-down.
    let mut path = []int {}
    let mut p = d
    let mut guard = 0
    while p > 0 && p < arena.nodes.len {
        push(path, p)
        if p == root {
            break
        }
        p = arena.nodes[p].parent
        guard = guard + 1
        if guard > 256 {
            return 0
        }
    }
    if path.len == 0 {
        return 0
    }
    if path[path.len - 1] != root {
        return 0
    }
    // Top-down: `w_ok` / `h_ok` are the parent's verdicts as the walk descends.
    let mut w_ok = 1
    let mut h_ok = 1
    let mut i = path.len - 1
    let mut best = 0
    while i >= 0 {
        let n = path[i]
        if n != root {
            let q = arena.nodes[n].parent
            let mut nw = 0
            let mut nh = 0
            if int(arena.nodes[n].kind) == 11 {
                // A scroller measures with its `dir` (a row by default) but
                // lays out as a column, so its natural size does not describe
                // its box: only an explicit box is known to hold.
                if arena.nodes[n].explicit_width >= 0 {
                    nw = 1
                }
                if arena.nodes[n].explicit_height >= 0 {
                    nh = 1
                }
            } else {
                if n < nat_w0.len {
                    if arena.nodes[n].inner_width == nat_w0[n] {
                        nw = 1
                    }
                    if arena.nodes[n].inner_height == nat_h0[n] {
                        nh = 1
                    }
                }
            }
            let mut w2 = nw
            let mut h2 = nh
            if w2 == 0 && w_ok != 0 {
                w2 = imposed_w(q, n)
            }
            if h2 == 0 && h_ok != 0 {
                h2 = imposed_h(q, n)
            }
            w_ok = w2
            h_ok = h2
            if arena.want_show(n) == 0 {
                // Hidden: nothing under it is laid out or painted, so the
                // change cannot reach past it. Its re-solve is skipped.
                return n
            }
            let mut can = 1
            if n == d && own == 0 {
                can = 0
            }
            if wraps_under_column(n) != 0 {
                can = 0
            }
            if w_ok != 0 && h_ok != 0 && can != 0 {
                best = n
            }
            if w_ok == 0 && h_ok == 0 {
                // Nothing below can recover an axis the parent does not impose.
                return best
            }
        }
        if i == 0 {
            break
        }
        i = i - 1
    }
    return best
}

/// Re-solve only the subtrees a frame's layout dirt touched. `dirty` is
/// `arena.take_dirty_layout_nodes()`: a structural entry is `-id`. Returns 0
/// when a change can reach the root (or a floater is anchored), leaving the
/// caller to re-solve the whole tree.
fn relayout(dirty: []int) -> int {
    let n = dirty.len
    if n == 0 {
        return 0
    }
    if arena.live_anchors > 0 {
        return 0
    }
    let root = arena.root_id
    if root <= 0 {
        return 0
    }
    // 1. Snapshot the natural size along every dirty path, before any
    //    re-measure. Bit 2 of `dirty` dedupes shared path prefixes.
    let mut taken = []int {}
    for i in 0..n {
        let mut p = dirty[i]
        if p < 0 {
            p = 0 - p
        }
        let mut guard = 0
        while p > 0 && p < arena.nodes.len {
            if (int(arena.nodes[p].dirty) & 4) != 0 {
                break
            }
            arena.nodes[p].dirty = u8(int(arena.nodes[p].dirty) | 4)
            push(taken, p)
            snapshot_natural(p)
            p = arena.nodes[p].parent
            guard = guard + 1
            if guard > 256 {
                break
            }
        }
    }
    // 2. Re-measure. Only the invalidated paths recompute; a clean subtree
    //    returns at its stamp.
    measure_node(root)
    // 3. A boundary per dirty node. A node freed since it was queued (a row
    //    dropped by its host) is skipped; the host carries the mark.
    let mut bounds = []int {}
    let mut ok = 1
    for i in 0..n {
        let mut d = dirty[i]
        let mut own = 0
        if d < 0 {
            d = 0 - d
            own = 1
        }
        if d <= 0 || d >= arena.nodes.len {
            ok = 0
            break
        }
        if int(arena.nodes[d].kind) == 0 {
            continue
        }
        let b = find_boundary(d, own)
        if b <= 0 {
            ok = 0
            break
        }
        let mut seen = 0
        let m = bounds.len
        for j in 0..m {
            if bounds[j] == b {
                seen = 1
            }
        }
        if seen == 0 {
            push(bounds, b)
        }
    }
    let t = taken.len
    for i in 0..t {
        arena.nodes[taken[i]].dirty = u8(int(arena.nodes[taken[i]].dirty) & 251)
    }
    if ok == 0 {
        return 0
    }
    // 4. Re-solve each boundary from the call its parent made, skipping one
    //    that sits inside another. If the box did not hold, the change reaches
    //    above the boundary: whole tree.
    let m = bounds.len
    for i in 0..m {
        let a = bounds[i]
        let mut nested = 0
        let mut p = arena.nodes[a].parent
        let mut guard = 0
        while p > 0 {
            for j in 0..m {
                if bounds[j] == p {
                    nested = 1
                }
            }
            p = arena.nodes[p].parent
            guard = guard + 1
            if guard > 256 {
                break
            }
        }
        if nested != 0 {
            continue
        }
        if arena.want_show(a) == 0 {
            continue
        }
        let bx = arena.nodes[a].x
        let by = arena.nodes[a].y
        let bw = arena.nodes[a].w
        let bh = arena.nodes[a].h
        layout_node(a, bx, by, bw, arena.nodes[a].lay_h)
        if arena.nodes[a].w != bw {
            return 0
        }
        if arena.nodes[a].h != bh {
            return 0
        }
        // Everything the re-solve can have moved is inside the boundary: mark
        // it so the damage pass repaints that subtree rather than falling back
        // to full.
        arena.mark_paint_id(a)
    }
    arena.live_anchors = 0
    place_anchored(arena.root_id)
    return 1
}

/// Screen origin of `id` in window points: its content-space x/y less every
/// scroller offset above it (the inverse of `ptr_in`'s screen-to-content walk).
struct Pt {
    x: int,
    y: int,
}

fn screen_origin(id: int) -> Pt {
    let sc = screen_scroll(id)
    return Pt { x: arena.nodes[id].x - sc.x, y: arena.nodes[id].y - sc.y }
}

/// Sum of the scroll offsets of `id`'s kind-11 ancestors. `screen_origin`
/// removes these to reach window coordinates; a floater positioned in window
/// coordinates adds them back to store content coordinates (see `place_node`).
fn screen_scroll(id: int) -> Pt {
    let mut sx = 0
    let mut sy = 0
    let mut p = arena.nodes[id].parent
    let mut guard = 0
    while p > 0 {
        if int(arena.nodes[p].kind) == 11 {
            sx = sx + arena.nodes[p].scroll_x
            sy = sy + arena.nodes[p].scroll_y
        }
        p = arena.nodes[p].parent
        guard = guard + 1
        if guard > 64 {
            break
        }
    }
    return Pt { x: sx, y: sy }
}

/// Position one anchored floater against its anchor's screen rect, flipping to
/// the opposite side when the preferred one would leave the safe-area rect.
/// Runs after the normal layout and re-lays-out the moved subtree.
fn place_node(id: int) {
    let a = arena.nodes[id].anchor
    if a <= 0 {
        return
    }
    if a >= arena.nodes.len {
        return
    }
    if arena.want_show(id) == 0 {
        return
    }
    let o = screen_origin(a)
    let ax = o.x
    let ay = o.y
    let aw = arena.nodes[a].w
    let ah = arena.nodes[a].h
    let w = arena.nodes[id].w
    let h = arena.nodes[id].h
    let gap = int(arena.nodes[id].anchor_gap)
    let top = arena.safe_t
    let bottom = arena.win_h - arena.safe_b
    let left = arena.safe_l
    let right = arena.win_w - arena.safe_r
    let code = int(arena.nodes[id].place)
    // 0 below, 1 above, 2 end (right), 3 start (left) — menus, popovers, selects,
    // and the tooltip's own side placements. 4..9 are the tooltip placements
    // proper: above (4,5,6) or below (7,8,9) the trigger, aligned to its START,
    // CENTRE or END along the cross axis. That alignment is what the six
    // top-left / top-centre / top-right / bottom-* names are, and it rides in
    // the same byte as the side so no per-node field had to be added.
    let mut side = code
    let mut cross = -1 /* -1 = the side's own default (start for above/below) */
    if code >= 4 {
        if code <= 6 {
            side = 1
            cross = code - 4
        } else {
            side = 0
            cross = code - 7
        }
    }
    let mut x = ax
    let mut y = ay + ah + gap
    if side == 1 {
        y = ay - h - gap
    } else if side == 2 {
        x = ax + aw + gap
        y = ay
    } else if side == 3 {
        x = ax - w - gap
        y = ay
    }
    if cross == 1 {
        x = ax + aw / 2 - w / 2
    } else if cross == 2 {
        x = ax + aw - w
    }
    if int(arena.nodes[id].flip) != 0 {
        if y + h > bottom {
            let alt = ay - h - gap
            if alt >= top {
                y = alt
            }
        }
        if y < top {
            let alt = ay + ah + gap
            if alt + h <= bottom {
                y = alt
            }
        }
        if x + w > right {
            let altx = ax + aw - w
            if altx >= left {
                x = altx
            }
        }
        if x < left {
            x = left
        }
    }
    // Keep the panel inside the *safe* rect on each axis where the trigger is
    // still visible. (0, 0) is the desktop origin; on a notched host the
    // usable origin is (left, top). A trigger scrolled out of the safe area
    // takes the floater with it rather than pinning it to an edge.
    if (ay + ah > top) && (ay < bottom) {
        if y < top {
            y = top
        }
    }
    if (ax + aw > left) && (ax < right) {
        if x < left {
            x = left
        }
    }
    // `x` / `y` are *window* coordinates, which is what the flip test above
    // needs and what the paint pass expects: an anchored floater is painted with
    // the scrollers' offsets reset, so it does not drift by the scroll amount.
    arena.nodes[id].x = x
    arena.nodes[id].y = y
    layout_node(id, x, y, w, h)
    arena.live_anchors = arena.live_anchors + 1
}

fn place_anchored(id: int) {
    if id <= 0 {
        return
    }
    let nk = arena.nodes[id].kids.len
    for i in 0..nk {
        let c = arena.nodes[id].kids[i]
        if c > 0 {
            if arena.nodes[c].anchor > 0 {
                place_node(c)
            }
            place_anchored(c)
        }
    }
}
