//! metrics — in-tree text measurement (`docs/loam_zeus_v2.md` §1.4, Phase 13).
//!
//! When a font is bound (`zeus.use_font` / `bind`), measurement parses its
//! tables with `std:font`, so every host computes the same line box for the
//! same (font, size, string) — the point of moving metrics in-tree. Unbound, it
//! falls through to the host's own measurement (`platform.plat_measure`), which
//! is exactly the behavior before Phase 13.
//!
//! Drawing is still the host's job (`platform.plat_text`). These metrics are
//! what layout sizes boxes with; until the draw path is also moved in-tree,
//! a bound font can differ slightly from what the host draws.

import "platform.loam"
import "std:font"
import "std:unicode"

/// Font bytes for in-tree metrics, or `""` when unbound.
let mut metrics_font: string = ""

// --- text-measure cache ---------------------------------------------------
// Layout measures every label each time it runs, and a wrap measures word by
// word through the host. The result depends only on (string, px, max width)
// and the current face, so it is cached here, direct-mapped (16k slots: a
// large app has thousands of distinct labels, and 4k thrashed): a collision
// evicts, and a hit compares the whole key. Anything that changes the face
// (`bind`, `unbind`, a family change, a host font arriving late) calls
// `reset_cache`. `tc_wrap` tells a single-line measure from a wrapped one.

const TC_SIZE: int = 16384
let mut tc_key: []string = []string {}
let mut tc_px: []int = []int {}
let mut tc_mw: []int = []int {}
let mut tc_wrap: []int = []int {}
let mut tc_w: []int = []int {}
let mut tc_h: []int = []int {}
/// Host or font measurements made (cache misses), and cache hits, since boot.
let mut tc_misses: int = 0
let mut tc_hits: int = 0

fn tc_ensure() {
    if tc_key.len == TC_SIZE {
        return
    }
    for i in 0..TC_SIZE {
        push(tc_key, "")
        push(tc_px, -1)
        push(tc_mw, 0)
        push(tc_wrap, 0)
        push(tc_w, 0)
        push(tc_h, 0)
    }
}

/// Drop every cached measurement.
fn reset_cache() {
    for i in 0..tc_px.len {
        tc_px[i] = -1
        tc_key[i] = ""
    }
}

/// Slot for a key: FNV-1a over the bytes, folded to the table size (the
/// product is taken in `i64` because `int` multiplication is checked).
fn tc_slot(s: string, px: int, max_w: int, wrap: int) -> int {
    let mut h: i64 = 2166136261
    for i in 0..s.len {
        h = h ^ i64(s[i] & 255)
        h = (h * 16777619) & 4294967295
    }
    h = h ^ (i64(px) * 31 + i64(max_w) * 2 + i64(wrap))
    h = (h * 16777619) & 4294967295
    return i32((h ^ (h >> 12)) & i64(TC_SIZE - 1))
}

/// Measure through the cache: one line when `wrap` is 0, wrapped to `max_w`
/// when 1, and one line by the host's own face (never the bound font) when 2.
fn tc_measure(s: string, px: int, max_w: int, wrap: int, w: &mut int, h: &mut int) {
    tc_ensure()
    let k = tc_slot(s, px, max_w, wrap)
    if tc_px[k] == px && tc_mw[k] == max_w && tc_wrap[k] == wrap && tc_key[k] == s {
        tc_hits = tc_hits + 1
        *w = tc_w[k]
        *h = tc_h[k]
        return
    }
    tc_misses = tc_misses + 1
    let mut mw = 0
    let mut mh = 0
    if wrap == 0 {
        measure_raw(s, px, &mut mw, &mut mh)
    } else if wrap == 2 {
        platform.plat_measure(s, px, &mut mw, &mut mh)
    } else if metrics_font.len > 0 {
        font.measure_wrap(metrics_font, px, s, max_w, &mut mw, &mut mh)
    } else {
        platform.plat_measure_wrap(s, px, max_w, &mut mw, &mut mh)
    }
    tc_key[k] = s
    tc_px[k] = px
    tc_mw[k] = max_w
    tc_wrap[k] = wrap
    tc_w[k] = mw
    tc_h[k] = mh
    *w = mw
    *h = mh
}

/// Bind font bytes (a `.ttf` / `.otf` the app or host loaded). Returns 1 when
/// the bytes parse as a font with a usable `hmtx`, 0 otherwise — the caller
/// then keeps host measurement.
fn bind(bytes: string) -> int {
    if bytes.len == 0 {
        return 0
    }
    if font.units_per_em(bytes) <= 0 {
        return 0
    }
    if font.num_hmetrics(bytes) <= 0 {
        return 0
    }
    metrics_font = bytes
    reset_cache()
    return 1
}

/// Drop the bound font; measurement falls back to the host.
fn unbind() {
    metrics_font = ""
    reset_cache()
}

/// 1 when in-tree metrics are active.
fn bound() -> int {
    return metrics_font.len
}

/// Decimal string of `v`, so bound numeric labels measure in-tree too.
fn decimal(v: int) -> string {
    let mut n = i64(v)
    let mut out = []int {}
    if n < 0 {
        out.push(45)
        n = -n
    }
    let mut rev = []int {}
    if n == 0 {
        rev.push(48)
    }
    for k in 0..20 {
        if n > 0 {
            rev.push(48 + i32(n % 10))
            n = n / 10
        }
    }
    let mut i = rev.len
    for k in 0..rev.len {
        i = i - 1
        out.push(rev[i])
    }
    return string_from_bytes(out)
}

/// Measure one line of `s` at `px`. `w`/`h` are out-params (the shape layout
/// already uses).
fn measure(s: string, px: int, w: &mut int, h: &mut int) {
    tc_measure(s, px, 0, 0, w, h)
}

fn measure_raw(s: string, px: int, w: &mut int, h: &mut int) {
    if metrics_font.len > 0 {
        font.measure(metrics_font, px, s, w, h)
        return
    }
    platform.plat_measure(s, px, w, h)
}

/// Measure the decimal form of `v` at `px`.
fn measure_int(v: int, px: int, w: &mut int, h: &mut int) {
    if metrics_font.len > 0 {
        font.measure(metrics_font, px, decimal(v), w, h)
        return
    }
    platform.plat_measure_int(v, px, w, h)
}

/// Measure `s` wrapped to `max_w`, for the height a label grows to.
fn measure_wrap(s: string, px: int, max_w: int, w: &mut int, h: &mut int) {
    tc_measure(s, px, max_w, 1, w, h)
}

/// Measure one line of `s` as the host draws it, ignoring any bound font. Paint
/// positions the words of wrapped text with this, so they sit where the host's
/// glyphs land.
fn measure_host(s: string, px: int, w: &mut int, h: &mut int) {
    tc_measure(s, px, 0, 2, w, h)
}

// --- ellipsis -------------------------------------------------------------

/// `…` (U+2026) as UTF-8 bytes: one glyph, so an ellipsized label keeps a
/// stable trailing width in every font that has it.
fn ellipsis_mark() -> string {
    return string_from_bytes([]int { 226, 128, 166 })
}

/// Bytes of `s` in `[a, b)`.
fn sub_bytes(s: string, a: int, b: int) -> string {
    let mut out = []int {}
    let mut i = a
    while i < b {
        push(out, s[i])
        i = i + 1
    }
    return string_from_bytes(out)
}

/// Truncate `s` to fit `max_w` at `px`, appending `…`, cutting only at a
/// grapheme boundary so the result is always valid UTF-8. `full_w` is the
/// pre-measured width of the whole string (a node's `text_width`), so a caller that
/// already measured it does not pay for a second pass. `w` / `h` receive the
/// width and height of the returned string.
///
/// Returns `s` unchanged when it already fits, and `""` when not even the
/// ellipsis glyph fits — an empty cell reads better than a mark that spills.
fn ellipsize(s: string, px: int, max_w: int, full_w: int, w: &mut int, h: &mut int) -> string {
    if s.len == 0 || full_w <= max_w {
        *w = full_w
        return s
    }
    let mark = ellipsis_mark()
    let mut mw = 0
    let mut mh = 0
    measure(mark, px, &mut mw, &mut mh)
    if max_w <= mw {
        *w = 0
        *h = mh
        return ""
    }
    // Binary search the longest grapheme prefix that still leaves room for
    // the mark. `grapheme_start` maps a cluster count to a byte offset.
    let total = unicode.grapheme_count(s)
    let mut lo = 0
    let mut hi = total
    while lo < hi {
        let mid = (lo + hi + 1) / 2
        let cand = sub_bytes(s, 0, unicode.grapheme_start(s, mid))
        let mut cw = 0
        let mut ch = 0
        measure(cand, px, &mut cw, &mut ch)
        if cw + mw <= max_w {
            lo = mid
        } else {
            hi = mid - 1
        }
    }
    let mut merged = []int {}
    let cut = unicode.grapheme_start(s, lo)
    for i in 0..cut {
        push(merged, s[i])
    }
    for i in 0..mark.len {
        push(merged, mark[i])
    }
    let res = string_from_bytes(merged)
    let mut rw = 0
    let mut rh = 0
    measure(res, px, &mut rw, &mut rh)
    *w = rw
    *h = rh
    return res
}
