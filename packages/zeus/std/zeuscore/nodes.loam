//! nodes — the node tables. A node is an id into eight parallel tables, one
//! per concern; every table has the same length (`tree.len`) and slot 0 is the
//! null node. This module imports nothing: it holds the records, the slot
//! helpers, and the queries that read only the tables. Everything that needs
//! signals, dirty channels or the frame clock lives in `arena` and above.
//!
//! tree.kind: 1 box, 2 grid, 3 label, 4 button, 5 spacer, 6 progress,
//! 7 toggle, 8 check, 9 overlay, 10 input, 11 scroll, 12 svg, 13 slider.
//! overflow: 0 visible, 1 hidden, 2 scroll-y auto, 3 scroll-xy auto.

// Within a record, fields are grouped widest-first (slices and strings, then
// 4-, 2- and 1-byte), so the padding stays small.

/// Structure and lifecycle: parent / kids, kind, show, dirty bits, the
/// `Each` / virtual-list window, scoped scheme and density.
struct TreeRec {
    kids: []int,
    /// A `Each` marker's rows, in order (see `frag_set`). They live in the
    /// marker's parent's `kids`, not in this node's.
    frag: []int,
    show_sig: int,
    show_val: int,
    node_id: int,
    parent: int,
    list_fn: int,
    list_gen: int,
    /// How the frame reaches `list_fn` (see `set_list_fn`): 0 not yet
    /// registered, 1 polled after every layout / scroll, 2 push-only (runs when
    /// a bound signal is written), 4 push-only and queued for this frame.
    list_mode: int,
    /// 1 on a `Boundary` host: a trap in a handler or effect owned by a node
    /// under it swaps it to its fallback (`invoke_on`).
    bnd: int,
    /// 1 while the node plays its exit transition: inert, frozen, freed when
    /// the transition ends (`exit_or_free`).
    exiting: int,
    /// Scoped appearance for the subtree (`set_scheme`): `scheme % 4` is 0
    /// inherit, 1 light, 2 dark; `scheme / 4` is a scoped role palette
    /// (`set_palette`), 0 none. Resolved at paint time, so it costs nothing
    /// until used.
    scheme: int,
    /// Scoped density signal for the subtree (`set_density_scope`), 0 none.
    dens_sid: int,
    /// `arena.floater_gen` when the last hit-pass walk found no floater in this
    /// subtree (see `arena.floater_collect`).
    fc_none: int,
    /// The `Each` marker whose rows include this node (0 = none).
    frag_of: int,
    /// Windowed `Each` / `VirtualList`: first rendered index, exclusive last,
    /// live item count, and the fixed row height used for spacers. `row_h`
    /// 0 means "not windowed" (build every child).
    list_lo: int,
    list_hi: int,
    list_n: int,
    row_h: int,
    kind: u8,
    /// Dirty-channel bits (see `mark_paint` / `mark_layout`). Bit 0 PAINT,
    /// bit 1 queued in `dirty_layout_nodes`, bit 2 layout-stale (on an invalidated path since its last layout),
    /// bit 3 paint-descendant. A node is marked when a discrete write or an
    /// animation tick changes it; paint drains the marks. Bit 3 is set on a
    /// node's ancestors when it is paint-marked, so the paint pass can tell a
    /// subtree it must re-record from one whose retained draw ops it can reuse.
    dirty: u8,
    show_mode: u8,
    /// Declarative `show` prop result (0 hidden / 1 visible); consulted when
    /// no `show_sig` is bound. Signal shows (`show` / `show_eq` / `If`) win.
    show_on: u8,
}

/// Layout inputs: sizing, padding, border width, flow direction, alignment,
/// gap and overflow. Owned by layout.
struct LayRec {
    grow: int,
    shrink: int,
    explicit_width: int,
    explicit_height: int,
    min_w: int,
    max_w: int,
    min_h: int,
    max_h: int,
    aspect_w: int,
    aspect_h: int,
    /// Style lengths in dp, unscaled (the DPI scale is applied at paint), so
    /// the stored value is the authored value. Each is at most the `u16`
    /// maximum (65535); an out-of-range literal is a compile error at the
    /// literal, not a runtime trap.
    pad: u16,
    padx: u16,
    pady: u16,
    pad_t: u16,
    pad_r: u16,
    pad_b: u16,
    pad_l: u16,
    gap: u16,
    gap_row: u16,
    gap_col: u16,
    /// Border width in dp. `-1` at the props layer is "unset" and maps to 0, so
    /// `content_x`/`content_y` never add a negative inset.
    border_w: u16,
    dir: u8,
    justify: u8,
    wrap: u8,
    reverse: u8,
    align: u8,
    overflow: u8,
    w_pct: i8,
    h_pct: i8,
    /// 1 when the width percent was set on purpose (`width = pct(n)`), not
    /// the 100 every node starts with. A wrapping row gives an explicit 100
    /// a full line; the default still sizes to the content.
    w_pct_set: u8,
}

/// Placement inputs: margins, align-self, absolute pins, grid cell, safe
/// area, z order, anchor and floating attach. Owned by layout.
struct PinRec {
    m_t: int,
    m_r: int,
    m_b: int,
    m_l: int,
    pin_t: int,
    pin_r: int,
    pin_b: int,
    pin_l: int,
    /// Anchor-based floating placement (popover / tooltip / hover card). When
    /// `anchor` > 0 the node is positioned at layout time against that node's
    /// screen rect: `place` is the preferred side, `anchor_gap` the offset in
    /// dp, and `flip` allows the opposite side when the preferred one would
    /// overflow.
    anchor: int,
    /// Open order of an anchored popup. 0 while it is closed. Among popups
    /// that share a z-index and sit near each other, a higher order paints
    /// and hits above a lower one. A popup that is not near them keeps tree
    /// order (`arena.floater_near_order`).
    open_ord: int,
    span: u16,
    grid_cols: u16,
    grid_min: u16,
    z_index: i16,
    anchor_gap: u16,
    pos: u8,
    safe: u8,
    place: u8,
    flip: u8,
    /// 1 after this popup was last seen hidden. The next show takes a new
    /// `open_ord`, including when an exit fade still holds the old one.
    popup_closed: u8,
    grid_auto: u8,
    align_self: i8,
    /// Floating box (`Style.floating`): target (`FloatTo`: 0 in flow, 1
    /// parent, 2 window, 3 `anchor`), packed attach points `1 + at * 9 + on`
    /// (0 = unset), offset, expand, and clip-to-parent.
    fl_to: u8,
    fl_pts: u8,
    fl_clip: u8,
    fl_x: i16,
    fl_y: i16,
    fl_ew: i16,
    fl_eh: i16,
}

/// Layout output: the laid-out box, natural and content extents, the
/// measured text size and the measure stamp. Written only by layout.
struct BoxRec {
    x: int,
    y: int,
    w: int,
    h: int,
    inner_width: int,
    inner_height: int,
    /// A scroller's content extent, written by layout: how far it can scroll
    /// is `ext - box`. Kept apart from `inner_*` (the natural size measure
    /// computes), which is a different number.
    ext_w: int,
    ext_h: int,
    text_width: int,
    text_height: int,
    /// Wrap scratch: a flex-wrap child's assigned width, and its line's height.
    aw: int,
    ah: int,
    /// The box `layout_node` was last called with, and the layout epoch of that
    /// call. Same box, same epoch and no invalidation inside (`dirty` bit 2):
    /// the subtree would lay out exactly as before, so `layout_node` skips it.
    la_x: int,
    la_y: int,
    la_w: int,
    la_h: int,
    la_ep: int,
    /// The measure generation `inner_width` / `inner_height` were computed for.
    /// `measure_node` skips a node whose stamp is current, so a layout frame
    /// re-measures only the path a write invalidated (see `invalidate_path`).
    measure_stamp: int,
}

/// Paint inputs: colors, radii, borders, elevation, opacity, text, font,
/// cursor. Owned by the scene.
struct LookRec {
    text: string,
    /// CSS cursor shown while the pointer is over this node ("" = default).
    cursor: string,
    bg: int,
    /// Second fill color for a vertical gradient (`bg` → `bg2`). `-1` = solid `bg`.
    bg2: int,
    fg: int,
    border_c: int,
    /// Shadow color of `elev`, as a role sentinel.
    elev_c: int,
    radius: u16,
    /// Per-corner radius overrides, clockwise from the top-left. `0xFFFF`
    /// means "use the uniform `radius`", so the all-unset default paints
    /// exactly as before. See `set_corner` / `radius_at`.
    rad_tl: u16,
    rad_tr: u16,
    rad_br: u16,
    rad_bl: u16,
    /// Font size in px. On svg nodes it also carries the `fit` mode.
    font: u16,
    opacity: i16,
    /// Clockwise-on-screen degrees for text nodes (0 = horizontal).
    text_rot: u16,
    /// Indeterminate rotation (a `Spinner`): 1 = spin, period in ms. Driven by
    /// the frame clock in paint, like `pulse`, so it needs no track and is
    /// deterministic at `now_ms == 0`.
    spin_ms: u16,
    /// Opt-in paint truncation: when the label is wider than its box, draw a
    /// trailing `…` at a grapheme boundary instead of overflowing. Table
    /// cells, select triggers, chips, and tabs opt in. Layout also lets such
    /// a node absorb a row deficit, so it narrows rather than wrapping its
    /// siblings (`row_can_absorb`).
    ellipsis: u8,
    pulse: u8,
    spin: u8,
    /// Elevation 0..4. `elev_c` holds the shadow color's role sentinel so the
    /// paint pass resolves it per appearance (like every other role).
    elev: u8,
    /// Elevation level the node lifts to while hovered (0 = no lift). Paint
    /// blends the resting `elev` shadow toward it on the hover track; the
    /// hover wash is skipped, since the lift is the feedback.
    lift: u8,
    /// `TextAlign` of a single-line label (0 left, 1 center, 2 right).
    t_align: u8,
    /// Per-side border widths (paint only, no layout space) and the rule
    /// between flow children. Color is `border_c`.
    bd_t: u8,
    bd_r: u8,
    bd_b: u8,
    bd_l: u8,
    bd_between: u8,
}

/// Scroll state: offsets, wheel targets, coast velocity, scrollbar stamps.
struct ScrlRec {
    scroll_x: int,
    scroll_y: int,
    /// Smooth wheel scroll: the position eases toward `tgt_x` / `tgt_y` each
    /// frame while the matching `smooth` bit (1 = y, 2 = x) is set. Bounded —
    /// a notch converges in ~150 ms and retargets on the next notch — unlike
    /// the momentum coast, which decays from a velocity.
    tgt_x: int,
    tgt_y: int,
    /// Wall-clock deadline (ms) until which the scrollbar thumb is shown;
    /// 0 = hidden. Set on every scroll; `bar_s` is the wall-clock time the
    /// bar *appeared*, so paint can fade it in from 0 and out again over the
    /// tail of the deadline. No track and no per-frame state: `bar_alpha`
    /// reads the two stamps, and `bar_next_ms` wakes the host for the fade
    /// frames and then the hide.
    bar_t: int,
    bar_s: int,
    /// Thumb alpha the current fade-in started from (0 from hidden; the live
    /// alpha when a scroll interrupts a fade-out), so it never pops.
    bar_a0: int,
    /// Scroll physics. Wheel / pan writes a velocity; `physics_step` coasts
    /// and stops exactly at the content bounds (0..max — never past them, so
    /// no blank strip is ever revealed past the first/last content).
    vel_x: int,
    vel_y: int,
    /// Scroll state bits:
    ///   1 = y is easing to `tgt_y`, 2 = x is easing to `tgt_x`,
    ///   4 = a pan drove y THIS frame, 8 = a pan drove x this frame.
    /// Bits 4/8 exist so `physics_step` can tell a delta it has already applied
    /// (the pan) from one it still owes (the coast). Without them a drag was
    /// applied twice in the same frame and the content outran the finger.
    smooth: u8,
}

/// Animated paint state: interaction amounts, transforms, reveal, exit.
struct AnimRec {
    tween: int,
    /// Exit transition (`exit_fade` / `exit_slide` / `exit_scale`): 0 none,
    /// 1 fade, 2 fade + slide by `exit_arg` dp, 3 fade + scale to `exit_arg`%.
    exit_fx: int,
    exit_ms: int,
    exit_arg: int,
    /// Animated paint transform: scale permille (1000 = identity), translate
    /// in 1/16 dp, and rotation in degrees. Finer than the API's percent and
    /// dp, so slow motion glides instead of stepping. Written only by
    /// paint-only tracks; the layout pass never reads them, so a transform
    /// never forces a layout.
    an_scale: u16,
    an_tx: i32,
    an_ty: i32,
    an_rot: u16,
    /// 0..100 ease of the press overlay. Rest is 0, so DRAW goldens hold.
    press_amt: u8,
    hover_amt: u8,
    show_amt: u8,
    enter_fade: u8,
    /// What moves with the fade, `arena.ENTER_*` flags (the `Enter` enum).
    enter_fx: u8,
    /// `slide_indicator`: 1 pill behind the selected child, 2 line under it,
    /// 0 none. `ind_sig` is the selection and `ind_at` the one last seen (-1
    /// before any); `ind_x` / `ind_w` are where it paints, in 1/16 dp from
    /// this node's box.
    ind_kind: u8,
    ind_sig: int,
    ind_at: int,
    ind_x: int,
    ind_w: int,
    /// Paint-only reveal: 1 opts in (`enter_reveal`), `an_reveal` is the share
    /// of the laid-out height paint shows, 0..100, clipped from the top with
    /// the content slid up by the hidden part. Layout sees the full box at
    /// once; only paint catches up, so an opening disclosure never re-lays
    /// out per frame (the "animated height" the audit deferred).
    reveal: u8,
    an_reveal: u8,
    /// 1 = press overlay while this node is `down_id` (buttons).
    press: u8,
    /// 1 = the press also scales the node to `PRESS_SCALE` percent on the
    /// paint-only ScalePct track (themed buttons). Off for plain `press`
    /// nodes so a checkbox / row does not shrink.
    press_scale: u8,
    hover_fade: i8,
}

/// Element-layer state: handlers, bound signals, focus, editing, a11y,
/// interaction flags.
struct UiRec {
    a11y_label: string,
    /// Where this node links to, for the markup a page shows before its wasm.
    href: string,
    a11y_role: string,
    bind_sig: int,
    click_sig: int,
    click_set: int,
    click2_sig: int,
    click2_set: int,
    hover_sig: int,
    key_ctx: int,
    edit_slot: int,
    click_fn: int,
    restyle_fn: int,
    down_fn: int,
    up_fn: int,
    kdown_fn: int,
    kup_fn: int,
    kpress_fn: int,
    edit_sig: int,
    bind_fn: int,
    click_mode: u8,
    click2_mode: u8,
    focusable: u8,
    /// Interaction-state overlay flags (see `UISTATE` / `interaction_state`).
    /// Components do not reimplement these; one shared model reads them.
    disabled: u8,
    /// Checked / selected / pressed, for assistive tech only: 0 = the role
    /// has no such state, 1 = off, 2 = on. Set by the `checked` prop.
    a11y_state: u8,
    loading: u8,
    invalid: u8,
    capture_text: u8,
    ui_size: u8,
    ui_look: u8,
    /// 1 = pointer passes through this floater to what lies under it: it
    /// never occludes hover and never takes a hit itself.
    ptr_pass: u8,
}

let mut tree: []TreeRec = []TreeRec {}
let mut lay: []LayRec = []LayRec {}
let mut pin: []PinRec = []PinRec {}
let mut box: []BoxRec = []BoxRec {}
let mut look: []LookRec = []LookRec {}
let mut scrl: []ScrlRec = []ScrlRec {}
let mut anim: []AnimRec = []AnimRec {}
let mut ui: []UiRec = []UiRec {}

fn blank_tree() -> TreeRec {
    return TreeRec {
        kids: []int {}, frag: []int {}, parent: 0, node_id: 0, kind: 0, frag_of: 0,
        dirty: 0, show_sig: 0, show_val: 0, show_mode: 0, show_on: 1, exiting: 0,
        bnd: 0, scheme: 0, dens_sid: 0, list_fn: 0, list_gen: 0, list_mode: 0,
        list_lo: 0, list_hi: 0, list_n: 0, row_h: 0, fc_none: 0,
    }
}

fn blank_lay() -> LayRec {
    return LayRec {
        grow: 0, shrink: 1, explicit_width: -1, explicit_height: -1, min_w: -1,
        max_w: -1, min_h: -1, max_h: -1, w_pct: 100, h_pct: -1, aspect_w: 0,
        aspect_h: 0, pad: 0, padx: 0, pady: 0, pad_t: 0, pad_r: 0, pad_b: 0, pad_l: 0,
        border_w: 0, dir: 0, justify: 0, align: 0, wrap: 0, reverse: 0, gap: 0,
        gap_row: 0, gap_col: 0, overflow: 0, w_pct_set: 0,
    }
}

fn blank_pin() -> PinRec {
    return PinRec {
        m_t: 0, m_r: 0, m_b: 0, m_l: 0, align_self: -1, pos: 0, pin_t: -1, pin_r: -1,
        pin_b: -1, pin_l: -1, span: 1, grid_cols: 0, grid_min: 0, grid_auto: 0,
        safe: 0, z_index: 0, anchor: 0, open_ord: 0, anchor_gap: 6, place: 0, flip: 1,
        popup_closed: 0, fl_to: 0, fl_pts: 0, fl_clip: 0, fl_x: 0, fl_y: 0, fl_ew: 0,
        fl_eh: 0,
    }
}

fn blank_box() -> BoxRec {
    return BoxRec {
        x: 0, y: 0, w: 0, h: 0, inner_width: 0, inner_height: 0, ext_w: 0, ext_h: 0,
        aw: 0, ah: 0, text_width: 0, text_height: 0, la_x: 0, la_y: 0, la_w: 0, la_h: 0, la_ep: 0,
        measure_stamp: 0,
    }
}

fn blank_look() -> LookRec {
    return LookRec {
        bg: -1, bg2: -1, fg: -1, border_c: -1, radius: 0, rad_tl: 65535, rad_tr: 65535,
        rad_br: 65535, rad_bl: 65535, bd_t: 0, bd_r: 0, bd_b: 0, bd_l: 0,
        bd_between: 0, elev: 0, elev_c: -1, lift: 0, opacity: 100, text: "", font: 0,
        text_rot: 0, t_align: 0, ellipsis: 0, pulse: 0, spin: 0, spin_ms: 900,
        cursor: "",
    }
}

fn blank_scrl() -> ScrlRec {
    return ScrlRec {
        scroll_x: 0, scroll_y: 0, tgt_x: 0, tgt_y: 0, vel_x: 0, vel_y: 0, smooth: 0,
        bar_t: 0, bar_s: 0, bar_a0: 0,
    }
}

fn blank_anim() -> AnimRec {
    return AnimRec {
        tween: -1, press_amt: 0, hover_amt: 0, show_amt: 0, enter_fade: 0, enter_fx: 0,
        ind_kind: 0, ind_sig: 0, ind_at: -1, ind_x: 0, ind_w: 0,
        an_scale: 1000, an_tx: 0, an_ty: 0, an_rot: 0, reveal: 0, an_reveal: 100,
        exit_fx: 0, exit_ms: 0, exit_arg: 0, press: 0, press_scale: 0, hover_fade: 0,
    }
}

fn blank_ui() -> UiRec {
    return UiRec {
        bind_sig: 0, click_sig: 0, click_set: 0, click_mode: 0, click2_sig: 0,
        click2_set: 0, click2_mode: 0, hover_sig: 0, key_ctx: 0, edit_slot: -1,
        edit_sig: 0, click_fn: 0, restyle_fn: 0, down_fn: 0, up_fn: 0, kdown_fn: 0,
        kup_fn: 0, kpress_fn: 0, bind_fn: 0, focusable: 0, capture_text: 0,
        disabled: 0, loading: 0, invalid: 0, a11y_label: "", href: "", a11y_role: "",
        a11y_state: 0, ptr_pass: 0, ui_size: 1, ui_look: 1,
    }
}

/// Append one blank slot to every table; the new id is `tree.len - 1`.
fn push_blank() {
    push(tree, blank_tree())
    push(lay, blank_lay())
    push(pin, blank_pin())
    push(box, blank_box())
    push(look, blank_look())
    push(scrl, blank_scrl())
    push(anim, blank_anim())
    push(ui, blank_ui())
}

/// Reset slot `id` in every table to its blank record.
fn blank_at(id: int) {
    tree[id] = blank_tree()
    lay[id] = blank_lay()
    pin[id] = blank_pin()
    box[id] = blank_box()
    look[id] = blank_look()
    scrl[id] = blank_scrl()
    anim[id] = blank_anim()
    ui[id] = blank_ui()
}

/// Drop the last slot from every table (arena rollback).
fn pop_slot() {
    pop(tree)
    pop(lay)
    pop(pin)
    pop(box)
    pop(look)
    pop(scrl)
    pop(anim)
    pop(ui)
}

/// Bytes of one node across all eight tables.
fn node_record_bytes() -> int {
    return __sizeof(blank_tree()) + __sizeof(blank_lay()) + __sizeof(blank_pin()) +
        __sizeof(blank_box()) + __sizeof(blank_look()) + __sizeof(blank_scrl()) +
        __sizeof(blank_anim()) + __sizeof(blank_ui())
}

// --- per-corner radius ----------------------------------------------------
// Four `u16` overrides, one per corner, plus the uniform `radius` as the
// fallback. A lane of `0xFFFF` is "unset", the all-unset default, so an
// untouched node resolves every corner to `radius` and `paint_fill_box` keeps
// its old op. (`int` is 32-bit here, so a packed four-corner value would need
// `i64`; four `u16` fields cost the same and need no shifts.)

const RAD_UNSET: int = 65535

/// Set corner `c` (0 tl, 1 tr, 2 br, 3 bl) to `r`, or clear it to the
/// uniform radius when `r` is negative.
fn set_corner(id: int, c: int, r: int) {
    if id <= 0 {
        return
    }
    if id >= tree.len {
        return
    }
    let mut v = RAD_UNSET
    if r >= 0 {
        if r < RAD_UNSET {
            v = r
        }
    }
    let b = u16(v)
    if c == 0 {
        look[id].rad_tl = b
    } else if c == 1 {
        look[id].rad_tr = b
    } else if c == 2 {
        look[id].rad_br = b
    } else if c == 3 {
        look[id].rad_bl = b
    }
}

/// All four corners at once, clockwise from the top-left.
fn set_corners(id: int, tl: int, tr: int, br: int, bl: int) {
    set_corner(id, 0, tl)
    set_corner(id, 1, tr)
    set_corner(id, 2, br)
    set_corner(id, 3, bl)
}

/// Resolved radius of corner `c`: its override, or the uniform `radius`.
fn radius_at(id: int, c: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= tree.len {
        return 0
    }
    let mut v = int(look[id].rad_tl)
    if c == 1 {
        v = int(look[id].rad_tr)
    } else if c == 2 {
        v = int(look[id].rad_br)
    } else if c == 3 {
        v = int(look[id].rad_bl)
    }
    if v == RAD_UNSET {
        return int(look[id].radius)
    }
    return v
}

/// 1 when any corner carries an override. An untouched node is 0, which is
/// what keeps the uniform paint path byte-identical.
fn corners_set(id: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= tree.len {
        return 0
    }
    if look[id].rad_tl == u16(65535) {
        if look[id].rad_tr == u16(65535) {
            if look[id].rad_br == u16(65535) {
                if look[id].rad_bl == u16(65535) {
                    return 0
                }
            }
        }
    }
    return 1
}

/// Largest resolved corner. The ops that take one radius and no per-corner
/// form (shadow, stroke, the press overlay) use this, so a rounded box gets a
/// rounded shadow instead of a square one.
fn radius_max(id: int) -> int {
    let mut m = radius_at(id, 0)
    for c in 1..4 {
        let v = radius_at(id, c)
        if v > m {
            m = v
        }
    }
    return m
}

/// Empty every table and push the null slot 0.
fn reset() {
    tree = []TreeRec {}
    lay = []LayRec {}
    pin = []PinRec {}
    box = []BoxRec {}
    look = []LookRec {}
    scrl = []ScrlRec {}
    anim = []AnimRec {}
    ui = []UiRec {}
    push_blank()
}

// --- queries over the tables ---------------------------------------------

/// The node a fragment `host`'s rows live in: its parent, or the host itself
/// when it has none (an `Each` used as a root).
fn frag_parent(host: int) -> int {
    let p = tree[host].parent
    if p > 0 && p < tree.len {
        return p
    }
    return host
}

/// Position of `child` in `parent`'s kid list, or -1 when it is not a child.
fn child_index(parent: int, child: int) -> int {
    if parent <= 0 {
        return -1
    }
    if parent >= tree.len {
        return -1
    }
    let n = tree[parent].kids.len
    for i in 0..n {
        if tree[parent].kids[i] == child {
            return i
        }
    }
    return -1
}

/// Nearest boundary host at or above `node`, or 0.
fn boundary_of(node: int) -> int {
    let mut id = node
    let mut hops = 0
    while id > 0 && id < tree.len && hops < 4096 {
        if tree[id].bnd != 0 {
            return id
        }
        id = tree[id].parent
        hops = hops + 1
    }
    return 0
}

/// Collect `id`'s subtree ids into `out`.
fn subtree_ids(id: int, out: &mut []int) {
    if id <= 0 || id >= tree.len {
        return
    }
    push(out, id)
    let n = tree[id].kids.len
    for i in 0..n {
        subtree_ids(tree[id].kids[i], out)
    }
}

/// 1 when `id` or an ancestor is playing its exit transition.
fn in_exiting(id: int) -> int {
    let mut c = id
    let mut hops = 0
    while c > 0 && c < tree.len && hops < 4096 {
        if tree[c].exiting != 0 {
            return 1
        }
        c = tree[c].parent
        hops = hops + 1
    }
    return 0
}

/// 1 when `id` is `top` or lies under it.
fn is_or_under(id: int, top: int) -> int {
    let mut p = id
    let mut guard = 0
    while p > 0 && guard < 256 {
        if p == top {
            return 1
        }
        p = tree[p].parent
        guard = guard + 1
    }
    return 0
}

/// Invalidate `id` and its ancestors: a size change at `id` can move each
/// ancestor's inner size, so their cached measure is stale. Off-path subtrees
/// keep their stamp and are skipped by the next `measure_node`.
fn invalidate_path(id: int) {
    let mut p = id
    let mut guard = 0
    while p > 0 {
        if p < tree.len {
            box[p].measure_stamp = -1
            tree[p].dirty = u8(int(tree[p].dirty) | 4)
        }
        p = tree[p].parent
        guard = guard + 1
        if guard > 256 {
            break
        }
    }
}

/// Paint-marked node bits: bit 0 = this node, bit 3 = a descendant of it.
fn node_paint_bits(id: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= tree.len {
        return 0
    }
    return int(tree[id].dirty) & 9
}

fn box_pad_x(id: int) -> int {
    let pl = i32(lay[id].pad_l)
    let pr = i32(lay[id].pad_r)
    let bw = i32(lay[id].border_w)
    return pl + pr + bw + bw
}

fn box_pad_y(id: int) -> int {
    let pt = i32(lay[id].pad_t)
    let pb = i32(lay[id].pad_b)
    let bw = i32(lay[id].border_w)
    return pt + pb + bw + bw
}

fn gap_x(id: int) -> int {
    if lay[id].gap_col > 0 {
        return i32(lay[id].gap_col)
    }
    return i32(lay[id].gap)
}

fn gap_y(id: int) -> int {
    if lay[id].gap_row > 0 {
        return i32(lay[id].gap_row)
    }
    return i32(lay[id].gap)
}

fn child_align(p: int, c: int) -> int {
    if int(pin[c].align_self) >= 0 {
        return int(pin[c].align_self)
    }
    return i32(lay[p].align)
}

fn has_w(id: int) -> int {
    if lay[id].explicit_width >= 0 {
        return 1
    }
    if int(lay[id].w_pct) >= 0 {
        return 1
    }
    return 0
}

fn has_h(id: int) -> int {
    if lay[id].explicit_height >= 0 {
        return 1
    }
    if int(lay[id].h_pct) >= 0 {
        return 1
    }
    return 0
}

fn fills_cross(c: int, row: int) -> int {
    let k = int(tree[c].kind)
    if k == 3 {
        if row == 0 {
            return 1
        }
        return 0
    }
    if k == 1 {
        return 1
    }
    if k == 2 {
        return 1
    }
    if k == 5 {
        return 1
    }
    if k == 6 {
        return 1
    }
    if k == 10 {
        return 1
    }
    if k == 11 {
        return 1
    }
    if k == 13 {
        return 1
    }
    return 0
}

fn axis_frozen(c: int, row: int) -> int {
    if row != 0 {
        if lay[c].explicit_width >= 0 {
            return 1
        }
        return 0
    }
    if lay[c].explicit_height >= 0 {
        return 1
    }
    return 0
}

/// 1 if this scroll node may overflow horizontally (`scroll_xy` / overflow 3).
fn scrolls_x(id: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= tree.len {
        return 0
    }
    if int(tree[id].kind) != 11 {
        return 0
    }
    if lay[id].overflow == 3 {
        return 1
    }
    return 0
}

fn is_floater(id: int) -> int {
    if id <= 0 {
        return 0
    }
    if int(tree[id].kind) == 9 {
        return 1
    }
    if int(pin[id].z_index) > 0 {
        return 1
    }
    // An anchored or floating node is placed in window coordinates
    // (`place_node`), so it must paint and hit-test from the floater pass,
    // never inline under a scroller's offset — even with no explicit `zIndex`.
    if is_placed(id) != 0 {
        return 1
    }
    return 0
}

/// 1 for a node `layout.place_node` positions against a target: an anchored
/// popup or a floating box.
fn is_placed(id: int) -> int {
    if pin[id].anchor > 0 || int(pin[id].fl_to) != 0 {
        return 1
    }
    return 0
}

/// An overlay, an anchored popup or a floating box: placed in window
/// coordinates.
fn is_window_floater(id: int) -> int {
    if int(tree[id].kind) == 9 || is_placed(id) != 0 {
        return 1
    }
    return 0
}

/// Node slots holding a live node: id 0 (the sentinel) and every recycled slot
/// in `free_nodes` are excluded, so this is the tree's real node count.
fn mem_live_nodes() -> int {
    let mut c = 0
    let n = tree.len
    for i in 1..n {
        if int(tree[i].kind) != 0 {
            c = c + 1
        }
    }
    return c
}

/// Bytes held by the node store: the `nodes` slot vector plus every node's
/// child-index vector. Those are the only per-node allocations in the tree.
fn mem_tree_bytes() -> i64 {
    let sz = i64(__sizeof(tree[0].node_id))
    let mut b = i64(tree.len) * i64(node_record_bytes())
    for i in 1..tree.len {
        b = b + i64(tree[i].kids.len) * sz
    }
    return b
}

fn has_bound_num(id: int) -> int {
    if ui[id].bind_sig != 0 {
        return 1
    }
    return 0
}
