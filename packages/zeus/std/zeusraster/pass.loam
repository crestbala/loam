//! pass — the software raster pass: the scene's draw list, rasterized in Loam
//! into the one framebuffer `raster.loam` owns, then handed to a host through
//! `plat_blit`. It reads `scene.draws` and nothing else of the engine, so the
//! core never imports it: apps that replay the list through their host pay
//! nothing for it. Reached through `std:zeusraster`.

import "../zeuscore/arena.loam"
import "../zeuscore/platform.loam"
import "../zeuscore/scene.loam"
import "atlas.loam"
import "image.loam"
import "raster.loam"
import "svg.loam"
import "std:font"
import "std:sys"
import "std:unicode"

// --- rasterize: the same draw list, rasterized by US (Phase 4) -------------
//
// `present()` hands the list to the host, which draws it with a 2D API. This is
// the other consumer of the SAME list: the Loam rasterizer, into the one buffer
// we own, at the backing scale. Nothing about paint changes; a frame simply has
// two possible consumers, and this one needs no drawing API at all.
//
// Ground rules:
//   * Every op is emitted in LOGICAL units and scaled here, so the list stays
//     resolution-independent (quality rule 1: rasterize at physical pixels).
//   * An op this pass cannot yet rasterize is COUNTED per kind, never skipped
//     silently: a gap has to show up as a number, not as a missing thing in a
//     screenshot someone has to notice.
//   * The device clip box is the only clip state. `save` duplicates it and
//     `restore` pops, which is exactly the nesting the list uses.

let mut rs_scale: int = 1
let mut rs_drawn: int = 0
let mut rs_unhandled: []int = []int {}
/// Clips whose radius > 0, which this pass currently treats as square.
let mut rs_rounded_clips: int = 0
let mut rs_clip_depth: int = 0
/// Four ints per clip level: x0, y0, x1, y1 in device pixels.
let mut rs_clip: []int = []int {}
let mut rs_r: int = 0
let mut rs_g: int = 0
let mut rs_b: int = 0
/// Images the app has decoded and registered, so a draw op's `src` can be
/// rasterized from the cache instead of the host.
let mut rs_img_src: []string = []string {}
let mut rs_img_slot: []int = []int {}

/// The font the pass draws with. The engine has one global family (the host
/// holds it for its own text), so the raster pass holds one font too — the one
/// the app hands it, parsed and rasterized in Loam, no CoreText anywhere.
let mut rs_font: string = ""
let mut rs_font_id: int = 1
let mut rs_font_upm: int = 0
let mut rs_font_asc: int = 0
let mut rs_font_desc: int = 0
let mut rs_font_ok: int = 0
let mut rs_glyphs_drawn: int = 0
let mut rs_glyphs_missing: int = 0

/// Load the font the raster pass draws text with. `src` is a file path. Returns
/// 1 when the file parsed as a TrueType/OpenType font.
fn raster_font_load(src: string) -> int {
    let s = sys.read_file(src)
    if s.len == 0 {
        return 0
    }
    let upm = font.units_per_em(s)
    if upm <= 0 {
        return 0
    }
    rs_font = s
    rs_font_upm = upm
    rs_font_asc = font.ascender(s)
    rs_font_desc = font.descender(s)
    rs_font_ok = 1
    return 1
}

fn raster_font_ready() -> int {
    return rs_font_ok
}

fn raster_font_ascender_px(px: int) -> int {
    if rs_font_upm <= 0 {
        return 0
    }
    return i32(i64(rs_font_asc) * i64(px) / i64(rs_font_upm))
}

fn raster_glyphs_drawn() -> int {
    return rs_glyphs_drawn
}

fn raster_glyphs_missing() -> int {
    return rs_glyphs_missing
}

/// Draw one text op: glyph by glyph through the atlas, at a quarter-pixel pen so
/// small text gets subpixel positioning, compositing with the same
/// gamma-correct blend as everything else.
///
/// `xd`/`yd` are DEVICE pixels of the line box's top-left (the convention every
/// host uses — the web host draws at `y + ascent` with an alphabetic baseline),
/// so the baseline is derived here from the font's own ascent. `kind` is the
/// draw op's kind, so a pass with no font loaded reports the gap on the right
/// counter rather than dropping pixels silently.
fn rs_text_dev(xd: int, yd: int, logical: int, alpha: int, text: string, s: int, kind: int) {
    if rs_font_ok == 0 {
        rs_note_unhandled(kind)
        return
    }
    if logical <= 0 {
        return
    }
    let px = logical * s
    let baseline = yd + raster_font_ascender_px(px)
    // Quarter-pixel pen: an advance of 7.5px must not lose its half pixel, or
    // small text comes out visibly uneven.
    let mut pen = xd * 4
    let mut i = 0
    while i < text.len {
        let cp = unicode.codepoint(text, i)
        let gid = font.glyph_index(rs_font, cp)
        let mut adv = 0
        if gid > 0 {
            adv = font.advance_px(rs_font, gid, px)
            let ix = pen / 4
            let mut bucket = 0
            if logical <= 16 {
                bucket = pen % 4
            }
            let mut slot = atlas.atlas_lookup(rs_font_id, gid, px, bucket)
            if slot < 0 {
                let o = font.glyph_outline(rs_font, gid)
                if o.ok == 1 {
                    slot = atlas.atlas_intern(
                        rs_font_id,
                        gid,
                        px,
                        bucket,
                        o.xs,
                        o.ys,
                        o.on,
                        o.ends,
                        rs_font_upm,
                    )
                }
            }
            if slot >= 0 {
                atlas.atlas_blit(slot, ix, baseline, rs_r, rs_g, rs_b, alpha)
                rs_glyphs_drawn = rs_glyphs_drawn + 1
            } else {
                // A space (or any whitespace) has no outline; that is not a
                // missing glyph, so it must not be counted as one — a wrapped
                // paragraph is full of them. A glyph whose outline really could
                // not be parsed (a composite, so far) still counts.
                if cp != 32 && cp != 9 && cp != 10 && cp != 13 {
                    rs_glyphs_missing = rs_glyphs_missing + 1
                }
            }
        } else {
            rs_glyphs_missing = rs_glyphs_missing + 1
        }
        pen = pen + adv * 4
        i = unicode.next_cp(text, i)
    }
    rs_drawn = rs_drawn + 1
}

fn rs_text(d: Draw, s: int) {
    rs_text_dev(d.x * s, d.y * s, d.font, d.alpha, d.text, s, d.kind)
}

fn rs_int_str(v: int) -> string {
    let mut b: []int = []int {}
    let mut w = v
    if w < 0 {
        push(b, 45)
        w = 0 - w
    }
    if w == 0 {
        push(b, 48)
        return string_from_bytes(b)
    }
    let mut dg: []int = []int {}
    let mut t = w
    while t > 0 {
        push(dg, 48 + t % 10)
        t = t / 10
    }
    let m = dg.len
    let mut i = 0
    while i < m {
        push(b, dg[m - 1 - i])
        i = i + 1
    }
    return string_from_bytes(b)
}

fn rs_text_int(d: Draw, s: int) {
    rs_text_dev(d.x * s, d.y * s, d.font, d.alpha, rs_int_str(d.value), s, d.kind)
}

/// Advance width, in device pixels, of `text[a..b)`.
fn rs_span_w(px: int, text: string, a: int, b: int) -> int {
    let mut w = 0
    let mut i = a
    while i < b {
        let cp = unicode.codepoint(text, i)
        w = w + font.advance_px(rs_font, font.glyph_index(rs_font, cp), px)
        i = unicode.next_grapheme(text, i)
    }
    return w
}

fn rs_slice(text: string, a: int, b: int) -> string {
    let mut out: []int = []int {}
    let mut i = a
    while i < b {
        push(out, text[i])
        i = i + 1
    }
    return string_from_bytes(out)
}

// --- wrapped text ---------------------------------------------------------
//
// The same greedy word wrap the host does: break at spaces and tabs, `\n` is a
// hard break, a space that would push the line past `max_w` is consumed by the
// break. Lines are drawn as whole strings so the pen can carry subpixel
// positions across a line (the host restarts each word on an integer).

let mut rw_start: []int = []int {}
let mut rw_end: []int = []int {}

fn rs_text_wrap(d: Draw, s: int) {
    if rs_font_ok == 0 {
        rs_note_unhandled(d.kind)
        return
    }
    let logical = d.font
    if logical <= 0 {
        return
    }
    let px = logical * s
    let max_w = d.w * s
    let text = d.text
    while rw_start.len > 0 {
        pop(rw_start)
        pop(rw_end)
    }
    let sw = font.advance_px(rs_font, font.glyph_index(rs_font, 32), px)
    let mut line_start = 0
    let mut line_end = 0
    let mut line_w = 0
    let mut i = 0
    while i < text.len {
        let c = text[i]
        if c == 10 {
            push(rw_start, line_start)
            push(rw_end, line_end)
            line_start = i + 1
            line_end = line_start
            line_w = 0
            i = i + 1
            continue
        }
        if c == 32 || c == 9 {
            if line_w > 0 {
                if line_w + sw > max_w {
                    push(rw_start, line_start)
                    push(rw_end, line_end)
                    // Do not start the next line with the space we broke at.
                    line_start = i + 1
                    line_end = line_start
                    line_w = 0
                } else {
                    line_w = line_w + sw
                    line_end = i + 1
                }
            }
            i = i + 1
            continue
        }
        let mut j = i
        while j < text.len {
            let cj = text[j]
            if cj == 32 || cj == 9 || cj == 10 {
                break
            }
            j = j + 1
        }
        let ww = rs_span_w(px, text, i, j)
        if line_w > 0 {
            if line_w + ww > max_w {
                push(rw_start, line_start)
                push(rw_end, line_end)
                line_start = i
                line_end = i
                line_w = 0
            }
        }
        line_w = line_w + ww
        line_end = j
        i = j
    }
    if line_end > line_start {
        push(rw_start, line_start)
        push(rw_end, line_end)
    }
    let lh = font.line_height(rs_font, px)
    let n = rw_start.len
    let mut k = 0
    while k < n {
        let line = rs_slice(text, rw_start[k], rw_end[k])
        rs_text_dev(d.x * s, d.y * s + k * lh, logical, d.alpha, line, s, d.kind)
        k = k + 1
    }
}

fn rs_init() {
    if rs_unhandled.len > 0 {
        return
    }
    let mut i = 0
    while i < 16 {
        push(rs_unhandled, 0)
        i = i + 1
    }
    i = 0
    while i < 65 * 4 {
        push(rs_clip, 0)
        i = i + 1
    }
}

/// Split a 0xRRGGBB op colour into the channels the rasterizer takes.
fn rs_split(rgb: int) {
    rs_r = rgb / 65536 % 256
    rs_g = rgb / 256 % 256
    rs_b = rgb % 256
}

fn rs_note_unhandled(kind: int) {
    if kind >= 0 {
        if kind < 16 {
            rs_unhandled[kind] = rs_unhandled[kind] + 1
        }
    }
}

/// Set the rasterizer's clip box to the top of the stack.
fn rs_apply_clip() {
    let o = (rs_clip_depth - 1) * 4
    raster.raster_clip_box(rs_clip[o], rs_clip[o + 1], rs_clip[o + 2], rs_clip[o + 3])
}

/// Intersect the top clip with a logical rect at the current scale, in
/// place. A clip is canvas-style: `save` (op 6) pushes a level, the clip
/// narrows that level, and one `restore` pops it. Pushing here as well left
/// every save + clip + restore one level deep, so whatever painted after a
/// nested clip stayed clipped to it.
fn rs_clip_push(x: int, y: int, w: int, h: int, radius: int, scale: int) {
    let o = (rs_clip_depth - 1) * 4
    let nx0 = rs_clip[o]
    let ny0 = rs_clip[o + 1]
    let nx1 = rs_clip[o + 2]
    let ny1 = rs_clip[o + 3]
    let cx0 = x * scale
    let cy0 = y * scale
    let cx1 = (x + w) * scale
    let cy1 = (y + h) * scale
    let no = o
    let mut ax0 = nx0
    if cx0 > ax0 {
        ax0 = cx0
    }
    let mut ay0 = ny0
    if cy0 > ay0 {
        ay0 = cy0
    }
    let mut ax1 = nx1
    if cx1 < ax1 {
        ax1 = cx1
    }
    let mut ay1 = ny1
    if cy1 < ay1 {
        ay1 = cy1
    }
    if ax1 < ax0 {
        ax1 = ax0
    }
    if ay1 < ay0 {
        ay1 = ay0
    }
    rs_clip[no] = ax0
    rs_clip[no + 1] = ay0
    rs_clip[no + 2] = ax1
    rs_clip[no + 3] = ay1
    if radius > 0 {
        rs_rounded_clips = rs_rounded_clips + 1
    }
    rs_apply_clip()
}

/// One quarter-disc as a convex wedge polygon: centre, then the arc. Four of
/// these plus the cross make a rect with four independent corner radii, which
/// is what a per-corner `fill4` is.
fn rs_quarter(cx: float, cy: float, rad: float, a0: float, a1: float) {
    let mut xs: []float = []float {}
    let mut ys: []float = []float {}
    push(xs, cx)
    push(ys, cy)
    let mut n = i32(raster.raster_sqrt(8.0 * raster.raster_flat_tol() / rad))
    if n < 2 {
        n = 2
    }
    if n > 64 {
        n = 64
    }
    let mut k = 0
    while k <= n {
        let t = a0 + (a1 - a0) * float(k) / float(n)
        push(xs, cx + rad * raster.raster_cos(t))
        push(ys, cy + rad * raster.raster_sin(t))
        k = k + 1
    }
    raster.raster_multi_add_poly(xs, ys, 1)
}

fn rs_quarter_rect(
    x: float,
    y: float,
    w: float,
    h: float,
    tl: float,
    tr: float,
    br: float,
    bl: float
) {
    // Clamp each radius to half the smaller extent, exactly as the host paths
    // do, so a 999 "pill" corner behaves the same here.
    let mut half = w
    if h < half {
        half = h
    }
    let lim = half / 2.0
    let mut rtl = tl
    let mut rtr = tr
    let mut rbr = br
    let mut rbl = bl
    if rtl > lim {
        rtl = lim
    }
    if rtr > lim {
        rtr = lim
    }
    if rbr > lim {
        rbr = lim
    }
    if rbl > lim {
        rbl = lim
    }
    // Five convex bands between the corners, then one wedge per corner. Every
    // piece is convex and they accumulate with the same sign into the coverage
    // buffer, so the overlaps composite once instead of double-blending.
    rs_rect(x + rtl, y, w - rtl - rtr, rtl)
    rs_rect(x + rbl, y + h - rbl, w - rbl - rbr, rbl)
    rs_rect(x, y + rtl, rtl, h - rtl - rbl)
    rs_rect(x + w - rtr, y + rtr, rtr, h - rtr - rbr)
    rs_rect(x + rtl, y + rtl, w - rtl - rtr, h - rtl - rbl)
    let pi = 3.141592653589793
    if rtl > 0.0 {
        rs_quarter(x + rtl, y + rtl, rtl, pi, pi + pi / 2.0)
    }
    if rtr > 0.0 {
        rs_quarter(x + w - rtr, y + rtr, rtr, pi + pi / 2.0, 2.0 * pi)
    }
    if rbr > 0.0 {
        rs_quarter(x + w - rbr, y + h - rbr, rbr, 0.0, pi / 2.0)
    }
    if rbl > 0.0 {
        rs_quarter(x + rbl, y + h - rbl, rbl, pi / 2.0, pi)
    }
}

fn rs_rect(x: float, y: float, w: float, h: float) {
    if w <= 0.0 || h <= 0.0 {
        return
    }
    let mut xs: []float = []float {}
    let mut ys: []float = []float {}
    push(xs, x)
    push(xs, x + w)
    push(xs, x + w)
    push(xs, x)
    push(ys, y)
    push(ys, y)
    push(ys, y + h)
    push(ys, y + h)
    raster.raster_multi_add_poly(xs, ys, 1)
}

/// Register a decoded image slot under the `src` string a draw op carries, so
/// `rasterize()` can blit it from the cache. Returns the number registered.
fn raster_register_image(src: string, slot: int) -> int {
    rs_init()
    push(rs_img_src, src)
    push(rs_img_slot, slot)
    return rs_img_src.len
}

fn rs_image_slot(src: string) -> int {
    let mut i = rs_img_src.len - 1
    while i >= 0 {
        if rs_img_src[i] == src {
            return rs_img_slot[i]
        }
        i = i - 1
    }
    return -1
}

/// Rasterize the current draw list into the framebuffer at `scale`, on a
/// background colour. Returns the number of ops rasterized; per-kind counts of
/// what was not are available through `raster_unhandled`.
fn rasterize(scale: int, br: int, bg: int, bb: int) -> int {
    rs_init()
    rs_scale = scale
    if rs_scale < 1 {
        rs_scale = 1
    }
    let s = rs_scale
    let fw = raster.raster_width()
    let fh = raster.raster_height()
    rs_clip_depth = 1
    rs_clip[0] = 0
    rs_clip[1] = 0
    rs_clip[2] = fw
    rs_clip[3] = fh
    rs_apply_clip()
    raster.raster_clear(br, bg, bb)
    rs_drawn = 0
    rs_rounded_clips = 0
    let n = scene.draws.len
    for i in 0..n {
        let d = scene.draws[i]
        rs_split(d.rgb)
        if d.kind == 0 {
            raster.raster_round_rect(
                float(d.x * s),
                float(d.y * s),
                float(d.w * s),
                float(d.h * s),
                float(d.radius * s),
            )
            raster.raster_fill_tiled(rs_r, rs_g, rs_b, 255)
            rs_drawn = rs_drawn + 1
        } else if d.kind == 1 {
            raster.raster_round_rect(
                float(d.x * s),
                float(d.y * s),
                float(d.w * s),
                float(d.h * s),
                float(d.radius * s),
            )
            raster.raster_fill_tiled(rs_r, rs_g, rs_b, d.alpha)
            rs_drawn = rs_drawn + 1
        } else if d.kind == 2 {
            rs_text(d, s)
        } else if d.kind == 3 {
            rs_text_int(d, s)
        } else if d.kind == 4 {
            rs_text_wrap(d, s)
        } else if d.kind == 5 {
            // SVG: parsed and rasterized here, in Loam, from the markup the op
            // carries — no host SVG reader, no NSBezierPath, no CGPath.
            let added = svg.svg_add(d.text, d.x * s, d.y * s, d.w * s, d.h * s, d.rgb, d.alpha)
            if added >= 0 {
                rs_drawn = rs_drawn + 1
            } else {
                rs_note_unhandled(d.kind)
            }
        } else if d.kind == 14 {
            raster.raster_multi_begin()
            rs_quarter_rect(
                float(d.x * s),
                float(d.y * s),
                float(d.w * s),
                float(d.h * s),
                float(d.radius % 65536 * s),
                float(d.radius / 65536 * s),
                float(d.value % 65536 * s),
                float(d.value / 65536 * s),
            )
            raster.raster_fill_multi(rs_r, rs_g, rs_b, d.alpha)
            rs_drawn = rs_drawn + 1
        } else if d.kind == 11 {
            // A gradient: the op carries the second stop in `value` and the axis
            // in `font`.
            raster.raster_round_rect(
                float(d.x * s),
                float(d.y * s),
                float(d.w * s),
                float(d.h * s),
                float(d.radius * s),
            )
            raster.raster_fill_gradient_tiled(
                d.rgb,
                d.value,
                d.font,
                d.alpha,
                d.x * s,
                d.y * s,
                (d.x + d.w) * s,
                (d.y + d.h) * s,
            )
            rs_drawn = rs_drawn + 1
        } else if d.kind == 13 {
            raster.raster_stroke_round_rect(
                float(d.x * s),
                float(d.y * s),
                float(d.w * s),
                float(d.h * s),
                float(d.radius * s),
                float(d.font * s),
                rs_r,
                rs_g,
                rs_b,
                d.alpha,
            )
            rs_drawn = rs_drawn + 1
        } else if d.kind == 12 {
            raster.raster_shadow_rect(
                float(d.x * s),
                float(d.y * s),
                float(d.w * s),
                float(d.h * s),
                float(d.radius * s),
                float((d.value % 256 - 128) * s),
                float((d.value / 256 - 128) * s),
                float(d.font * s),
                d.alpha,
                rs_r,
                rs_g,
                rs_b,
            )
            rs_drawn = rs_drawn + 1
        } else if d.kind == 6 {
            // save: duplicate the clip box
            let o = (rs_clip_depth - 1) * 4
            let mut dd = rs_clip_depth
            if dd > 63 {
                dd = 63
            }
            let no = dd * 4
            rs_clip[no] = rs_clip[o]
            rs_clip[no + 1] = rs_clip[o + 1]
            rs_clip[no + 2] = rs_clip[o + 2]
            rs_clip[no + 3] = rs_clip[o + 3]
            rs_clip_depth = dd + 1
            rs_drawn = rs_drawn + 1
        } else if d.kind == 7 {
            rs_clip_push(d.x, d.y, d.w, d.h, d.radius, s)
            rs_drawn = rs_drawn + 1
        } else if d.kind == 8 {
            if rs_clip_depth > 1 {
                rs_clip_depth = rs_clip_depth - 1
            }
            rs_apply_clip()
            rs_drawn = rs_drawn + 1
        } else if d.kind == 10 {
            let slot = rs_image_slot(d.text)
            if slot >= 0 {
                image.img_blit(slot, d.x * s, d.y * s, d.alpha)
                rs_drawn = rs_drawn + 1
            } else {
                rs_note_unhandled(d.kind)
            }
        } else {
            rs_note_unhandled(d.kind)
        }
    }
    return rs_drawn
}

fn raster_scene_count() -> int {
    return rs_drawn
}

/// The one blit of a finished frame: hand the framebuffer we rasterized into to
/// the host, which wraps those very bytes (no copy) and shows them. Returns 1
/// when a host presented, 0 when none is listening — headless, or a host that
/// has no blit path (Linux / iOS / Android / web today).
///
/// `gen` is the buffer's generation, so a host rebuilds its wrapper only when
/// the buffer was reallocated (a size or backing-scale change), never per frame.
/// Nothing here touches a graphics API: this is the platform syscall boundary,
/// the single point where our pixels leave the engine.
fn raster_blit() -> int {
    let w = raster.raster_width()
    let h = raster.raster_height()
    if w <= 0 || h <= 0 {
        return 0
    }
    return platform.plat_blit(
        raster.raster_buffer(),
        w,
        h,
        raster.raster_generation(),
        raster.raster_scale(),
    )
}

/// Load the font the raster pass draws text with (a file path). Returns 1 on
/// success. Until this is called, text ops are COUNTED as unhandled rather than
/// dropped silently.
fn raster_load_font(src: string) -> int {
    return raster_font_load(src)
}

fn raster_font_is_ready() -> int {
    return raster_font_ready()
}

fn raster_glyphs_drawn_count() -> int {
    return rs_glyphs_drawn
}

fn raster_glyphs_missing_count() -> int {
    return rs_glyphs_missing
}

/// How many ops of `kind` this pass could not rasterize.
fn raster_unhandled(kind: int) -> int {
    rs_init()
    if kind < 0 || kind > 15 {
        return 0
    }
    return rs_unhandled[kind]
}

fn raster_unhandled_total() -> int {
    rs_init()
    let mut t = 0
    let mut i = 0
    while i < 16 {
        t = t + rs_unhandled[i]
        i = i + 1
    }
    return t
}

fn raster_rounded_clip_count() -> int {
    return rs_rounded_clips
}

// --- damage -> tile selection (Phase 4) ------------------------------------
//
// The rasterizer should visit only the tiles a frame's damage touches. This
// turns the Phase 1 damage list into that tile set: one flag per tile, reset
// per frame, so nothing is built on the graph — just a list of tile origins.
// A full-damage frame selects every tile. Deduping means overlapping or nested
// damage rects (a dirty container damages its subtree) never rasterize a tile
// twice.

let mut dt_flag: []int = []int {}
let mut dt_x: []int = []int {}
let mut dt_y: []int = []int {}
let mut dt_cols: int = 0
let mut dt_rows: int = 0

/// Build the frame's tile list from `arena.damage`. Returns the tile count.
fn damage_tiles_build() -> int {
    let w = raster.raster_width()
    let h = raster.raster_height()
    let ts = raster.raster_tile_size()
    while dt_x.len > 0 {
        pop(dt_x)
    }
    while dt_y.len > 0 {
        pop(dt_y)
    }
    if w <= 0 {
        return 0
    }
    if h <= 0 {
        return 0
    }
    dt_cols = (w + ts - 1) / ts
    dt_rows = (h + ts - 1) / ts
    let total = dt_cols * dt_rows
    while dt_flag.len < total {
        push(dt_flag, 0)
    }
    while dt_flag.len > total {
        pop(dt_flag)
    }
    let mut i = 0
    while i < total {
        dt_flag[i] = 0
        i = i + 1
    }
    if arena.damage_full != 0 {
        let mut ty = 0
        while ty < h {
            let mut tx = 0
            while tx < w {
                push(dt_x, tx)
                push(dt_y, ty)
                tx = tx + ts
            }
            ty = ty + ts
        }
        return dt_x.len
    }
    let n = arena.damage.len
    let mut k = 0
    while k < n {
        let d = arena.damage[k]
        let mut cx0 = d.x
        let mut cy0 = d.y
        let mut cx1 = d.x + d.w
        let mut cy1 = d.y + d.h
        if cx0 < 0 {
            cx0 = 0
        }
        if cy0 < 0 {
            cy0 = 0
        }
        if cx1 > w {
            cx1 = w
        }
        if cy1 > h {
            cy1 = h
        }
        if cx1 > cx0 {
            if cy1 > cy0 {
                let tcx0 = cx0 / ts
                let tcy0 = cy0 / ts
                let tcx1 = (cx1 - 1) / ts
                let tcy1 = (cy1 - 1) / ts
                let mut tcy = tcy0
                while tcy <= tcy1 {
                    let mut tcx = tcx0
                    while tcx <= tcx1 {
                        let idx = tcy * dt_cols + tcx
                        if dt_flag[idx] == 0 {
                            dt_flag[idx] = 1
                            push(dt_x, tcx * ts)
                            push(dt_y, tcy * ts)
                        }
                        tcx = tcx + 1
                    }
                    tcy = tcy + 1
                }
            }
        }
        k = k + 1
    }
    return dt_x.len
}

fn damage_tiles_count() -> int {
    return dt_x.len
}

fn damage_tiles_x(i: int) -> int {
    return dt_x[i]
}

fn damage_tiles_y(i: int) -> int {
    return dt_y[i]
}
