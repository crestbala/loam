fn add(a: int, b: int) -> int {
    return a + b
}

#[test]
fn adds() {
    assert_eq_int(add(1, 2), 3)
}
=== theme.loam 326
//! Theme tokens: palette roles. `zeus.theme(ROLE.X, light, dark)` sets
//! both appearances; widgets resolve the role per appearance at paint time.

import "std:zeus"

fn install() {
    zeus.theme(ROLE.Accent, 0x2563EB, 0x60A5FA)
    zeus.theme(ROLE.Paper, 0xFFFFFF, 0x111318)
    zeus.theme(ROLE.Ink, 0x111318, 0xF3F4F6)
}
