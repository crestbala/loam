=== app.loam 395
//! my-app — application entry. One entry, every host.
//!
//! `zeli routes` generates app_routes.loam from routes/; this file
//! mounts it. `zeli build` emits all five targets from here.

import "std:zeus"
import "app_routes.loam" as approutes
import "server/api.loam" as api
import "tests/smoke.loam" as smoketest

fn main() {
    zeus.App("my-app", fn() {
        approutes.app()
    })
}
=== app_routes.loam 2065
// Generated by `zeli routes`. Do not edit.
import "std:zeus"
import "std:router"
import "routes/blog/layout.loam" as r_blog_layout
import "routes/blog/page.loam" as r_blog_page
import "routes/blog/[slug]/page.loam" as r_blog_slug_page
import "routes/(marketing)/about/page.loam" as r_marketing_about_page
import "routes/(marketing)/pricing/page.loam" as r_marketing_pricing_page
import "routes/layout.loam" as r_root_layout
import "routes/not-found.loam" as r_root_not_found
import "routes/page.loam" as r_root_page

fn b_root_page(p: Params) {
    r_root_page.page(p)
}

fn m_root_page(p: Params) -> Meta {
    return r_root_page.meta(p)
}

fn b_marketing_about_page(p: Params) {
    r_marketing_about_page.page(p)
}

fn m_marketing_about_page(p: Params) -> Meta {
    return r_marketing_about_page.meta(p)
}

fn b_marketing_pricing_page(p: Params) {
    r_marketing_pricing_page.page(p)
}

fn m_marketing_pricing_page(p: Params) -> Meta {
    return r_marketing_pricing_page.meta(p)
}

fn b_blog_page(p: Params) {
    r_blog_layout.layout(fn() { r_blog_page.page(p) })
}

fn m_blog_page(p: Params) -> Meta {
    return r_blog_page.meta(p)
}

fn b_blog_slug_page(p: Params) {
    r_blog_layout.layout(fn() { r_blog_slug_page.page(p) })
}

fn m_blog_slug_page(p: Params) -> Meta {
    return r_blog_slug_page.meta(p)
}

fn p_blog_slug_page() -> []string {
    return r_blog_slug_page.paths()
}

fn routes() -> []Route {
    return []Route {
        Route { pattern: "/", build: b_root_page, meta: m_root_page },
        Route { pattern: "/about", build: b_marketing_about_page, meta: m_marketing_about_page },
        Route { pattern: "/pricing", build: b_marketing_pricing_page, meta: m_marketing_pricing_page },
        Route { pattern: "/blog", build: b_blog_page, meta: m_blog_page },
        Route { pattern: "/blog/:slug", build: b_blog_slug_page, meta: m_blog_slug_page, paths: p_blog_slug_page },
    }
}

fn app() {
    r_root_layout.layout(fn() {
        router.Router(routes(), RouterProps { not_found: fn() { r_root_not_found.not_found() } })
    })
}
