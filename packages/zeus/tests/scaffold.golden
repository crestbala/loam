=== components/card.loam 265
//! Shared component, no routing knowledge: a fn that builds into the
//! current host.

import "std:zeus"

fn Card(text: string) {
    let box = zeus.Box(background = "#FFFFFF", padding = 12, spacing = 4)
    zeus.slot(box, fn() {
        zeus.Text(text)
    })
}
