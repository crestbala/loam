=== routes/layout.loam 388
//! Root shell: theme + nav. Retained across navigation, so its state
//! survives — only the page slot rebuilds.

import "std:zeus"
import "../theme.loam" as theme

fn layout(build: fn()) {
    theme.install()
    let box = zeus.Box(align_direction = DIRECTION.Column, padding = 12, spacing = 8)
    zeus.slot(box, fn() {
        zeus.Text("my-app")
    })
    zeus.slot(box, build)
}
