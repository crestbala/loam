// In-language tests for the pieces `zeli serve` is built from: the source filter a
// change-driven reload applies, the SSE frame the server pushes, and the snippet
// that waits for one instead of asking.
//
// No port is bound here — the request handler is exercised once the server
// lands, and `zeli serve --build-only` has its own differential gate against the
// TypeScript CLI.
//
//     loamc test packages/zeus/cli/serve_tests.loam

import "std:str"
import "std:sys"
import "std:test"
import "zeli.loam" as zeli
import "chunks.loam" as chunks

/** *Shorthand, so the assertions below read as the behaviour they check. */
fn has(hay: string, needle: string) -> bool {
    return zeli.contains_str(hay, needle)
}

#[test]
fn watches_app_and_framework_sources() {
    let none = []string {}
    test.assert(zeli.is_watched_source("examples/zeus/myapp/app.loam", none))
    test.assert(zeli.is_watched_source("examples/zeus/myapp/routes/blog/page.loam", none))
    test.assert(zeli.is_watched_source("examples/zeus/myapp/routes/pricing/page.loam", none))
    test.assert(zeli.is_watched_source("packages/zeus/src/zeus.loam", none))
}

#[test]
fn ignores_output_caches_and_non_sources() {
    let none = []string {}
    /* The build output lives inside a watched root, so this filter is the only
       thing standing between an edit and a rebuild loop. */
    test.assert(!zeli.is_watched_source("examples/zeus/myapp/build/web/app.wasm", none))
    test.assert(!zeli.is_watched_source("examples/zeus/myapp/build/web/index.html", none))
    test.assert(!zeli.is_watched_source("examples/zeus/myapp/build/web/x.loam", none))
    test.assert(!zeli.is_watched_source("examples/zeus/myapp/.zeus/meta_dump.loam", none))
    test.assert(!zeli.is_watched_source("examples/zeus/myapp/.git/x.loam", none))
    test.assert(!zeli.is_watched_source("packages/zeus/node_modules/p/x.loam", none))
    test.assert(!zeli.is_watched_source("examples/zeus/myapp/app_routes.loam.bak", none))
}

#[test]
fn the_generated_route_table_is_not_a_source() {
    /* serve regenerates this before every build, so watching it would rebuild on
       every rebuild, forever. The check is by name, and holds under a root. */
    let none = []string {}
    let roots = []string { "/app" }
    test.assert(!zeli.is_watched_source("examples/zeus/myapp/app_routes.loam", none))
    test.assert(!zeli.is_watched_source("/app/app_routes.loam", roots))
    test.assert(zeli.is_watched_source("/app/routes/page.loam", roots))
}

#[test]
fn judges_a_path_relative_to_its_root() {
    let roots = []string { "/home/u/.src/loam/app" }
    test.assert(zeli.is_watched_source("/home/u/.src/loam/app/routes/page.loam", roots))
    test.assert(!zeli.is_watched_source("/home/u/.src/loam/app/build/web/x.loam", roots))
}

#[test]
fn sse_frame_carries_the_revision() {
    test.assert_eq_str(zeli.sse_frame(7), "data: 7\n\n")
}

#[test]
fn snippet_subscribes_and_waits() {
    let s = zeli.live_snippet()
    test.assert(has(s, zeli.live_path()))
    test.assert(has(s, "EventSource"))
    test.assert(!has(s, "setInterval"))
    test.assert(!has(s, "fetch("))
}

// --- the live channel ---

#[test]
fn a_subscription_is_left_open() {
    let head = zeli.live_head()
    test.assert(has(head, "200 OK"))
    test.assert(has(head, "Content-Type: text/event-stream"))
    /* No length and no close: the reply's whole purpose is to keep the
       connection, and a length would tell the page it is complete. */
    test.assert(!has(head, "Content-Length"))
    test.assert(!has(head, "Connection: close"))
}

// --- the reply the serve server frames ---

#[test]
fn a_reply_carries_a_length_and_no_policy() {
    let r = zeli.serve_http_reply(200, "text/html; charset=utf-8", "<p>hi</p>")
    test.assert(has(r, "HTTP/1.1 200 OK"))
    test.assert(has(r, "Content-Length: 9"))
    test.assert(has(r, "Cache-Control: no-store"))
    /* `http.http_reply` hardens every reply with `Content-Security-Policy:
       default-src 'none'`, which would block the app's own loader.js and the
       injected snippet. This reply must not. */
    test.assert(!has(r, "Content-Security-Policy"))
}

// --- the upstream RPC address ---

#[test]
fn an_rpc_address_splits_into_host_and_port() {
    let a = zeli.rpc_addr_of("127.0.0.1:8080")
    test.assert_eq_str(a.host, "127.0.0.1")
    test.assert_eq_int(a.port, 8080)
    /* A malformed address reads as port 0, which nothing listens on, so it fails
       the way an absent backend does rather than by connecting somewhere. */
    test.assert_eq_int(zeli.rpc_addr_of("nonsense").port, 0)
}

#[test]
fn the_backend_address_follows_the_environment() {
    let set = sys.env("LOAM_RPC_ADDR")
    if set == "" {
        test.assert_eq_str(zeli.serve_rpc_addr(), "127.0.0.1:8080")
    } else {
        test.assert_eq_str(zeli.serve_rpc_addr(), set)
    }
}

// --- the request handler, over a scratch build output ---
//
// The same build output the live server is given, for the same cases: no port is
// bound, so the routing, content types, injection and SPA fallback are exercised
// through `serve_reply`, which is where the live server delegates them.

let snip = "<!--LIVE-->"

fn fixture(root: string) {
    sys.remove_path(root)
    sys.mkdir(cat(root, "/blog"))
    sys.write_file(
        cat(root, "/index.html"),
        "<html><body><canvas id=\"zeus\"></canvas></body></html>",
    )
    sys.write_file(cat(root, "/blog/index.html"), "<html><body><h1>blog</h1></body></html>")
    /* `.wasm` and `.js` are told apart by suffix, so the bytes only have to be
       something the suffix does not explain away. */
    sys.write_file(cat(root, "/app.wasm"), "asm")
    sys.write_file(cat(root, "/loader.js"), "// loader")
}

#[test]
fn serves_the_root_shell_with_the_snippet() {
    let root = "packages/loam/tests/tmp/serveweb"
    fixture(root)
    let r = zeli.serve_reply(root, "/", snip)
    test.assert_eq_int(r.status, 200)
    test.assert(has(r.content_type, "text/html"))
    test.assert(has(r.body, snip))
    test.assert(has(r.body, "canvas id=\"zeus\""))
}

#[test]
fn a_nested_path_serves_its_own_index() {
    let root = "packages/loam/tests/tmp/serveweb"
    fixture(root)
    test.assert(has(zeli.serve_reply(root, "/blog", snip).body, "<h1>blog</h1>"))
    test.assert(has(zeli.serve_reply(root, "/blog/", snip).body, "<h1>blog</h1>"))
}

#[test]
fn module_and_script_types_are_the_ones_a_browser_insists_on() {
    let root = "packages/loam/tests/tmp/serveweb"
    fixture(root)
    let wasm = zeli.serve_reply(root, "/app.wasm", snip)
    test.assert_eq_str(wasm.content_type, "application/wasm")
    test.assert_eq_str(wasm.body, "asm")
    test.assert_eq_str(zeli.serve_reply(root, "/loader.js", snip).content_type, "text/javascript")
}

#[test]
fn an_unknown_path_falls_back_to_the_shell() {
    let root = "packages/loam/tests/tmp/serveweb"
    fixture(root)
    let r = zeli.serve_reply(root, "/does-not-exist", snip)
    test.assert_eq_int(r.status, 200)
    test.assert(has(r.body, snip))
}

#[test]
fn the_snippet_lands_before_the_closing_body() {
    let root = "packages/loam/tests/tmp/serveweb"
    fixture(root)
    let body = zeli.serve_reply(root, "/blog/", snip).body
    test.assert(has(body, "<!--LIVE--></body>"))
}

// --- compressed replies ---

#[test]
fn accept_encoding_is_read_by_token() {
    test.assert(zeli.accepts_coding("gzip, deflate, br", "br"))
    test.assert(zeli.accepts_coding("br;q=0.5", "br"))
    test.assert(!zeli.accepts_coding("br;q=0", "br"))
    test.assert(!zeli.accepts_coding("br;q=0.0", "br"))
    test.assert(!zeli.accepts_coding("gzip", "br"))
    /* A name that only contains the coding is another coding. */
    test.assert(!zeli.accepts_coding("xbr", "br"))
    test.assert(!zeli.accepts_coding("", "br"))
}

/* `s` with each `|` a NUL, the separator in parsed headers. A string literal
   has no way to write one: `\\0` is a plain `0`. */
fn nuls(s: string) -> string {
    let mut out = []int {}
    for i in 0..s.len {
        out.push(if s[i] == 124 { 0 } else { s[i] })
    }
    return string_from_bytes(out)
}

#[test]
fn accept_encoding_comes_from_the_parsed_headers() {
    test.assert_eq_str(zeli.accept_encoding(nuls("host|x|accept-encoding|gzip, br|")), "gzip, br")
    test.assert_eq_str(zeli.accept_encoding(nuls("host|x|")), "")
}

#[test]
fn a_compressed_copy_answers_a_client_that_takes_it() {
    let root = "packages/loam/tests/tmp/servebr"
    fixture(root)
    sys.write_file(cat(root, "/app.wasm.br"), "BR")
    let r = zeli.serve_reply_for(root, "/app.wasm", snip, "gzip, br")
    test.assert_eq_str(r.encoding, "br")
    test.assert_eq_str(r.body, "BR")
    test.assert_eq_str(r.content_type, "application/wasm")
    let plain = zeli.serve_reply_for(root, "/app.wasm", snip, "gzip")
    test.assert_eq_str(plain.encoding, "")
    test.assert_eq_str(plain.body, "asm")
}

#[test]
fn a_page_that_takes_a_snippet_is_never_a_compressed_copy() {
    let root = "packages/loam/tests/tmp/servebr"
    fixture(root)
    sys.write_file(cat(root, "/index.html.br"), "BR")
    let dev = zeli.serve_reply_for(root, "/", snip, "br")
    test.assert_eq_str(dev.encoding, "")
    test.assert(has(dev.body, snip))
    /* `preview` has no snippet, so it sends what a host would. */
    let prod = zeli.serve_reply_for(root, "/", "", "br")
    test.assert_eq_str(prod.encoding, "br")
    test.assert(has(prod.content_type, "text/html"))
}

#[test]
fn an_encoded_reply_says_so() {
    let r = zeli.serve_http_encoded(200, "application/wasm", "br", "no-cache", "x")
    test.assert(has(r, "Content-Encoding: br\r\n"))
    test.assert(has(r, "Vary: Accept-Encoding\r\n"))
    test.assert(has(r, "Cache-Control: no-cache\r\n"))
    test.assert(!has(zeli.serve_http_reply(200, "text/plain", "x"), "Content-Encoding"))
}

// --- preview ---

#[test]
fn preview_caches_as_the_release_headers_ask() {
    test.assert(has(zeli.preview_cache("/_zeus/app.abc.wasm"), "immutable"))
    test.assert_eq_str(zeli.preview_cache("/"), "no-cache")
    test.assert_eq_str(zeli.preview_cache("/app.wasm"), "no-cache")
}

#[test]
fn vercel_gets_the_release_headers_too() {
    let dir = "/tmp/zeli_serve_tests_vercel"
    sys.remove_path(dir)
    sys.mkdir(dir)
    let v = zeli.vercel_config(dir)
    test.assert(has(v, "/_zeus/(.*)"))
    test.assert(has(v, "immutable"))
    test.assert(!has(v, "rewrites"))
    sys.remove_path(dir)
}

#[test]
fn a_backend_becomes_vercel_rewrites() {
    let dir = "/tmp/zeli_serve_tests_vercel"
    sys.remove_path(dir)
    sys.mkdir(dir)
    sys.write_file(
        cat(dir, "/zeus.toml"),
        "backend = \"https://api.test\"\nbackend_paths = \"/api/:path* /Rpc/:path+\"\n",
    )
    let v = zeli.vercel_config(dir)
    test.assert(has(v, "{\"source\":\"/api/:path*\",\"destination\":\"https://api.test/api/:path*\"}"))
    test.assert(has(v, "{\"source\":\"/Rpc/:path+\",\"destination\":\"https://api.test/Rpc/:path+\"}"))
    sys.remove_path(dir)
}

#[test]
fn a_plain_page_names_its_files_up_front() {
    let h = zeli.plain_page("a<b", zeli.plain_assets("app"))
    test.assert(has(h, "<title>a&lt;b</title>"))
    test.assert(has(h, "rel=\"preload\" href=\"/loader.js\" as=\"script\""))
    test.assert(has(h, "data-wasm=\"/app.wasm\""))
}

// --- stripping the loader ---

#[test]
fn strip_js_drops_comments_and_indentation() {
    test.assert_eq_str(zeli.strip_js("a(); // x\n\n  c();\n  /* y */ b();\n"), "a();\nc();\n b();\n")
    /* A comment across lines can end a statement, so its break stays. */
    test.assert_eq_str(zeli.strip_js("a /* x\n y */ b"), "a \n b")
}

#[test]
fn strip_js_leaves_literals_alone() {
    let cases = []string {
        "let u = \"http://x\";",
        "let u = 'a /* b */';",
        "let e = \"\\\" // \";",
        "let r = /[/*]\\/\\/x/.test(s);",
        "let t = `// ${a /* c */ ? \"//\" : `/*${b}*/`} //`;",
        "return /\\/\\//.test(s);",
    }
    test.assert_eq_str(zeli.strip_js(cases[0]), cases[0])
    test.assert_eq_str(zeli.strip_js(cases[1]), cases[1])
    test.assert_eq_str(zeli.strip_js(cases[2]), cases[2])
    test.assert_eq_str(zeli.strip_js(cases[3]), cases[3])
    test.assert_eq_str(zeli.strip_js(cases[5]), cases[5])
    /* The comment in the `${}` is code, so only it goes. */
    test.assert_eq_str(zeli.strip_js(cases[4]), "let t = `// ${a  ? \"//\" : `/*${b}*/`} //`;")
}

#[test]
fn strip_js_tells_division_from_a_regular_expression() {
    test.assert_eq_str(zeli.strip_js("let x = a / b; // c"), "let x = a / b; ")
    test.assert_eq_str(zeli.strip_js("let x = f(a) / 2 / 3; // c"), "let x = f(a) / 2 / 3; ")
}

// --- the release shell ---

#[test]
fn page_colour_is_css_hex() {
    test.assert_eq_str(zeli.css_hex("1184529"), "#121311")
    test.assert_eq_str(zeli.css_hex("255"), "#0000ff")
    /* No colour from the dump: the plain light page. */
    test.assert_eq_str(zeli.css_hex(""), "#fafafa")
}

#[test]
fn hashed_assets_cache_forever_and_pages_do_not() {
    let h = zeli.web_headers()
    test.assert(has(h, "/_zeus/*\n  Cache-Control: public, max-age=31536000, immutable"))
    /* The catch-all rule sets no cache, so a page is checked on every visit. */
    test.assert(has(h, "\n/*\n  X-Content-Type-Options: nosniff"))
}

// --- route chunks ---

/* The shape emitted C has: functions in the first column, and a `main` that
   opens behind `#if`. */
fn fixture_c() -> string {
    let mut lines = []string {}
    lines.push("static inline int loam_core(void) {")
    lines.push("    return 1;")
    lines.push("}")
    lines.push("int loam_shell(void) {")
    lines.push("    return loam_core() + loam_widget();")
    lines.push("}")
    lines.push("int loam_widget(void) {")
    lines.push("    return 2;")
    lines.push("}")
    lines.push("int loam_b_home(void) {")
    lines.push("    return loam_core() + loam_home_only() + loam_widget();")
    lines.push("}")
    lines.push("int loam_home_only(void) {")
    lines.push("    return loam_clos_1();")
    lines.push("}")
    lines.push("void loam_clos_1(void *_env) {")
    lines.push("    return;")
    lines.push("}")
    lines.push("int loam_b_docs(void) {")
    lines.push("    return loam_docs_only();")
    lines.push("}")
    lines.push("int loam_docs_only(void) {")
    lines.push("    return 3;")
    lines.push("}")
    lines.push("#if defined(__wasm32__)")
    lines.push("int main(void)")
    lines.push("#else")
    lines.push("int main(int argc, char **argv)")
    lines.push("#endif")
    lines.push(" {")
    lines.push("    return loam_shell();")
    lines.push("}")
    return str.join(lines, "\n")
}

fn fixture_plan(min_size: int) -> Plan {
    let mut g = chunks.parse_c(fixture_c())
    let roots = chunks.roots_of(&mut g, "")
    let entries = []int { chunks.find_suffix(&g, "b_home"), chunks.find_suffix(&g, "b_docs") }
    return chunks.plan(&g, roots, entries, min_size)
}

fn has_fn(g: &Graph, c: Chunk, name: string) -> bool {
    for i in 0..c.fns.len {
        if g.names[c.fns[i]] == name {
            return true
        }
    }
    return false
}

#[test]
fn main_is_a_root_though_it_opens_behind_an_if() {
    let mut g = chunks.parse_c(fixture_c())
    test.assert(chunks.find_suffix(&g, "shell") >= 0)
    let roots = chunks.roots_of(&mut g, "")
    test.assert(roots.len > 0)
    test.assert_eq_str(g.names[roots[0]], "main")
}

#[test]
fn a_route_keeps_its_own_code_and_the_shell_keeps_the_primary() {
    let g = chunks.parse_c(fixture_c())
    let p = fixture_plan(1)
    test.assert_eq_int(p.chunks.len, 2)
    /* A closure goes where the code that names it goes. */
    let home = p.route_chunks[0]
    test.assert_eq_int(home.len, 1)
    test.assert(has_fn(&g, p.chunks[home[0]], "loam_home_only"))
    test.assert(has_fn(&g, p.chunks[home[0]], "loam_clos_1"))
    /* The layout reaches this too, so no route's chunk may take it. */
    test.assert(!has_fn(&g, p.chunks[home[0]], "loam_widget"))
    test.assert(!has_fn(&g, p.chunks[home[0]], "loam_core"))
}

#[test]
fn chunks_too_small_to_fetch_stay_in_the_primary() {
    let p = fixture_plan(1000000)
    test.assert_eq_int(p.chunks.len, 0)
    test.assert_eq_int(p.route_chunks[0].len, 0)
}

#[test]
fn a_route_with_nothing_unique_needs_no_chunks() {
    let mut g = chunks.parse_c(
        "int loam_b_a(void) {\n    return 0;\n}\nint loam_b_b(void) {\n    return 0;\n}\n",
    )
    let entries = []int { chunks.find_suffix(&g, "b_a"), chunks.find_suffix(&g, "b_b") }
    let p = chunks.plan(&g, []int {}, entries, 1000)
    test.assert_eq_int(p.chunks.len, 0)
}

#[test]
fn a_saved_appearance_is_read_with_the_key_the_loader_writes() {
    let s = zeli.appearance_script()
    test.assert(has(s, "zeus-appearance"))
    test.assert(has(s, "--zeus-paper"))
    let loader = sys.read_file("packages/zeus/hosts/web/loader.js")
    test.assert(has(loader, "APPEARANCE_KEY = \"zeus-appearance\""))
}

fn chunk_of(name: string, users: int) -> Chunk {
    let mut routes = []int {}
    for i in 0..users {
        push(routes, i)
    }
    return Chunk { name: name, fns: []int {}, routes: routes, size: 0 }
}

#[test]
fn idle_fetch_takes_shared_small_chunks_most_shared_first() {
    let p = Plan {
        chunks: []Chunk {
            chunk_of("one_route", 1),
            chunk_of("some", 2),
            chunk_of("too_big", 4),
            chunk_of("most", 3),
        },
        route_chunks: [][]int { []int {}, []int {}, []int {}, []int {} },
    }
    let got = chunks.idle_chunks(&p, []int { 1000, 1000, 500000, 1000 })
    test.assert_eq_int(got.len, 2)
    test.assert_eq_str(p.chunks[got[0]].name, "most")
    test.assert_eq_str(p.chunks[got[1]].name, "some")
}

#[test]
fn prepaint_keeps_reading_order_links_and_drops_icons() {
    let outline = "14\t20\t60\t100\t/more\tBody & more\n0\t4\t0\t16\t\t<svg/>\n32\t20\t10\t100\t\tTitle\n22\t20\t40\t100\t\tSection\n"
    let html = zeli.prepaint_html(outline)
    test.assert_eq_str(
        html,
        "<h1>Title</h1>\n<h2>Section</h2>\n<p><a href=\"/more\">Body &amp; more</a></p>\n",
    )
}

#[test]
fn prepaint_keeps_highlighted_code_together() {
    let outline = "14\t20\t10\t50\t\tBefore\n13\t20\t30\t20\t\tlet\n13\t40\t30\t8\t\t \n13\t48\t30\t8\t\tx\n13\t20\t50\t60\t\t// note\n14\t20\t70\t50\t\tAfter\n"
    let html = zeli.prepaint_html(outline)
    test.assert_eq_str(html, "<p>Before</p>\n<pre>\nlet x\n// note\n</pre>\n<p>After</p>\n")
}

#[test]
fn prepaint_is_empty_for_a_page_with_no_words() {
    test.assert_eq_str(zeli.prepaint_html("0\t4\t0\t16\t\t<svg/>\n"), "")
}

#[test]
fn touch_fetch_takes_the_smallest_of_the_rest_up_to_its_budget() {
    let p = Plan {
        chunks: []Chunk {
            chunk_of("shared", 3),
            chunk_of("large", 1),
            chunk_of("small", 1),
            chunk_of("mid", 1),
            chunk_of("over", 1),
        },
        route_chunks: [][]int { []int {}, []int {}, []int {} },
    }
    let sizes = []int { 1000, 120000, 40000, 90000, 300000 }
    let got = chunks.touch_chunks(&p, sizes, []int { 0 })
    test.assert_eq_int(got.len, 3)
    test.assert_eq_str(p.chunks[got[0]].name, "small")
    test.assert_eq_str(p.chunks[got[1]].name, "mid")
    test.assert_eq_str(p.chunks[got[2]].name, "large")
}

// --- numbers, substring ids, and the processes a native target lives in ---

#[test]
fn ints_round_trip_through_text() {
    /* `int_str` exists for the pid and count a shell command carries, so the
       round trip with `int_of` is the whole contract. */
    test.assert_eq_str(zeli.int_str(0), "0")
    test.assert_eq_str(zeli.int_str(7), "7")
    test.assert_eq_str(zeli.int_str(5173), "5173")
    test.assert_eq_int(zeli.int_of(zeli.int_str(98765)), 98765)
    /* A negative has no meaning here — no pid, no port — and clamps to 0 rather
       than emitting a minus the callers would have to think about. */
    test.assert_eq_str(zeli.int_str(-4), "0")
}

#[test]
fn an_id_is_read_out_of_a_tagged_text() {
    let plist = "<key>CFBundleExecutable</key><string>app</string>\n<key>CFBundleIdentifier</key><string>com.loam.demo</string>\n"
    test.assert(zeli.idx_of(plist, "CFBundleIdentifier") > 0)
    test.assert_eq_int(zeli.idx_of(plist, "nope"), -1)
    test.assert_eq_str(
        zeli.between(plist, "<key>CFBundleIdentifier</key><string>", 60 /* < */ ),
        "com.loam.demo",
    )
    test.assert_eq_str(zeli.between(plist, "<key>NotThere</key><string>", 60), "")
    let gradle = "android {\n    namespace 'com.loam.zeus'\n    defaultConfig {\n        applicationId \"com.loam.myapp\"\n"
    test.assert_eq_str(zeli.between(gradle, "applicationId \"", 34 /* " */ ), "com.loam.myapp")
}

#[test]
fn the_simulator_id_comes_from_the_bundle() {
    /* The id belongs to the compiler's naming rules, so `serve` reads it back
       out of the `.app` it just built rather than re-deriving it. */
    let root = "packages/loam/tests/tmp/servebundle"
    sys.remove_path(root)
    sys.mkdir(cat(root, "/build/ios/app.app"))
    test.assert_eq_str(zeli.ios_bundle_id(root, "app"), "")
    sys.write_file(
        cat(root, "/build/ios/app.app/Info.plist"),
        "<key>CFBundleIdentifier</key><string>com.loam.app</string>",
    )
    test.assert_eq_str(zeli.ios_bundle_id(root, "app"), "com.loam.app")
}

#[test]
fn the_device_id_comes_from_the_gradle_tree() {
    let root = "packages/loam/tests/tmp/servegradle"
    sys.remove_path(root)
    sys.mkdir(cat(root, "/build/android/app/app"))
    test.assert_eq_str(zeli.android_app_id(root, "app"), "")
    sys.write_file(
        cat(root, "/build/android/app/app/build.gradle"),
        "    defaultConfig {\n        applicationId \"com.loam.app\"\n    }\n",
    )
    test.assert_eq_str(zeli.android_app_id(root, "app"), "com.loam.app")
}

#[test]
fn a_launched_process_is_stoppable() {
    /* The mechanism a native target rests on, with a process that cannot be
       confused with the app: `$!` has to be the command itself, or `stop_pid`
       signals a wrapper and leaves the app running. */
    let log = "packages/loam/tests/tmp/serve_spawn.log"
    sys.remove_path(log)
    let pid = zeli.launch_app("/bin/sleep 30", log)
    test.assert(pid > 0)
    test.assert(zeli.pid_alive(pid))
    test.assert(zeli.stop_pid(pid))
    test.assert(!zeli.pid_alive(pid))
    /* A pid that is already gone is not an error: stopping what is not there is
       the state a stop is trying to reach. */
    test.assert(zeli.stop_pid(pid))
    test.assert(!zeli.pid_alive(0))
    test.assert(!zeli.pid_alive(-1))
}

#[test]
fn run_jobs_reports_each_command_in_order() {
    let dir = "/tmp/zeli_jobs_test"
    sys.remove_path(dir)
    let jobs = zeli.run_jobs(dir, []string { "echo one", "echo two; exit 3", "echo three" })
    test.assert(jobs.len == 3)
    test.assert(jobs[0].ok && has(jobs[0].log, "one"))
    test.assert(!jobs[1].ok && has(jobs[1].log, "two"))
    test.assert(jobs[2].ok && has(jobs[2].log, "three"))
    sys.remove_path(dir)
}

/* `sys.exec` refuses a command over 8 KB and says nothing, which is the size a
   web build's per-chunk `wasm-opt` commands reach. */
#[test]
fn run_jobs_takes_more_than_one_exec_can_hold() {
    let dir = "/tmp/zeli_jobs_big_test"
    sys.remove_path(dir)
    let mut filler = ""
    for i in 0..1000 {
        filler = "{{filler}}x"
    }
    let mut cmds = []string {}
    for i in 0..12 {
        push(cmds, "echo {{filler}} >/dev/null; echo job{{i}}")
    }
    let jobs = zeli.run_jobs(dir, cmds)
    test.assert(jobs.len == 12)
    for i in 0..12 {
        test.assert(jobs[i].ok)
        test.assert(has(jobs[i].log, "job{{i}}"))
    }
    sys.remove_path(dir)
}

#[test]
fn panel_times_read_in_tenths() {
    test.assert_eq_str(zeli.ui_time(0), "0.0s")
    test.assert_eq_str(zeli.ui_time(2150), "2.1s")
    test.assert_eq_str(zeli.ui_time(61900), "61.9s")
}

#[test]
fn panel_report_follows_the_build_env() {
    test.assert_eq_str(zeli.ui_env("LOAM_DEV=1", ""), "LOAM_DEV=1")
    test.assert_eq_str(zeli.ui_env("", "/a"), "LOAM_PROGRESS='/a'")
    test.assert_eq_str(zeli.ui_env("LOAM_DEV=1", "/a"), "LOAM_DEV=1 LOAM_PROGRESS='/a'")
}

#[test]
fn panel_stays_off_outside_a_terminal() {
    /* What the suite and every log file rely on: `say` is a plain print. */
    zeli.ui_open("Web", true)
    test.assert(!zeli.ui_on)
}

#[test]
fn the_compiler_reports_its_steps() {
    let dir = "/tmp/zeli_progress_test"
    sys.remove_path(dir)
    sys.mkdir(dir)
    let src = "{{dir}}/p.loam"
    sys.write_file(src, "fn main() {\n}\n")
    sys.exec("LOAM_PROGRESS={{dir}}/log {{zeli.loam_path()}} {{src}} -o {{dir}}/p 2>&1")
    let log = sys.read_file("{{dir}}/log")
    test.assert(has(log, "check\n"))
    test.assert(has(log, "modules "))
    test.assert(has(log, "codegen\n"))
    test.assert(has(log, "cc\n"))
    sys.remove_path(dir)
}

#[test]
fn hashes_come_back_in_the_order_asked() {
    let dir = "/tmp/zeli_hash_test"
    sys.remove_path(dir)
    sys.mkdir(dir)
    sys.write_file("{{dir}}/b.txt", "bee")
    sys.write_file("{{dir}}/a.txt", "ay")
    let both = zeli.short_hashes(dir, []string { "b.txt", "a.txt" })
    test.assert_eq_str(both[0], zeli.short_hash("{{dir}}/b.txt"))
    test.assert_eq_str(both[1], zeli.short_hash("{{dir}}/a.txt"))
    test.assert(both[0].len == 12)
    sys.remove_path(dir)
}

#[test]
fn a_command_keeps_only_its_own_cache() {
    /* The old layout left every generation as a loose file in `.zeus/cc`, and */
    /* serve, build, and preview each left a wasm under `.zeus/out`. A new */
    /* command keeps the slots it will compile and the wasm kind it publishes. */
    let root = "/tmp/zeli_retire_cache"
    sys.remove_path(root)
    sys.mkdir("{{root}}/.zeus/cc/serve-web")
    sys.mkdir("{{root}}/.zeus/cc/build")
    sys.mkdir("{{root}}/.zeus/cc/meta")
    sys.mkdir("{{root}}/.zeus/out/serve")
    sys.mkdir("{{root}}/.zeus/out/build")
    sys.mkdir("{{root}}/.zeus/out/release")
    sys.write_file("{{root}}/.zeus/cc/old.o", "stale")
    sys.write_file("{{root}}/.zeus/cc/serve-web/unit.o", "live")
    sys.write_file("{{root}}/.zeus/cc/build/unit.o", "other")
    sys.write_file("{{root}}/.zeus/out/serve/app.wasm", "serve")
    sys.write_file("{{root}}/.zeus/out/release/app.wasm", "release")
    sys.write_file("{{root}}/.zeus/meta_dump", "dump")
    zeli.retire_caches(root, []string { "serve-web", "meta", "server" }, "serve")
    test.assert(sys.exists("{{root}}/.zeus/cc/serve-web/unit.o") == 1)
    test.assert(sys.exists("{{root}}/.zeus/cc/meta") == 1)
    test.assert(sys.exists("{{root}}/.zeus/cc/build") == 0)
    test.assert(sys.exists("{{root}}/.zeus/cc/old.o") == 0)
    test.assert(sys.exists("{{root}}/.zeus/out/serve/app.wasm") == 1)
    test.assert(sys.exists("{{root}}/.zeus/out/release") == 0)
    test.assert(sys.exists("{{root}}/.zeus/out/build") == 0)
    test.assert(sys.exists("{{root}}/.zeus/meta_dump") == 1)
    sys.mkdir("{{root}}/.zeus/out/serve")
    sys.mkdir("{{root}}/.zeus/out/release")
    sys.write_file("{{root}}/.zeus/out/serve/app.wasm", "serve")
    sys.write_file("{{root}}/.zeus/out/release/app.wasm", "release")
    zeli.retire_caches(root, []string { "meta" }, "release")
    test.assert(sys.exists("{{root}}/.zeus/cc/serve-web") == 0)
    test.assert(sys.exists("{{root}}/.zeus/out/serve") == 0)
    test.assert(sys.exists("{{root}}/.zeus/out/release/app.wasm") == 1)
    test.assert(sys.exists("{{root}}/.zeus/cc/meta") == 1)
    sys.remove_path(root)
}

#[test]
fn serve_and_build_do_not_share_a_shard_slot() {
    let root = "/tmp/zeli_shard_slot"
    test.assert(has(zeli.shard_env(root, "serve-web"), "/.zeus/cc/serve-web"))
    test.assert(has(zeli.shard_env(root, "build"), "/.zeus/cc/build"))
    test.assert(has(zeli.shard_env(root, "meta"), "/.zeus/cc/meta"))
    test.assert(has(zeli.server_build_env(root), "/.zeus/cc/server"))
    test.assert(has(zeli.serve_build_env(root, "web"), "/.zeus/cc/serve-web"))
    test.assert(has(zeli.serve_build_env(root, "macos"), "/.zeus/cc/serve-macos"))
    test.assert(has(zeli.serve_build_env(root, "macos"), "LOAM_DEV=1 "))
    let plain = "/tmp/zeli_shard_app"
    sys.remove_path(plain)
    sys.mkdir(plain)
    let slots = zeli.serve_cache_slots(plain, "web")
    test.assert(zeli.index_of(slots, "serve-web") >= 0)
    test.assert(zeli.index_of(slots, "server") >= 0)
    test.assert(zeli.index_of(slots, "meta") < 0)
    sys.mkdir("{{plain}}/routes")
    let routed = zeli.serve_cache_slots(plain, "web")
    test.assert(zeli.index_of(routed, "meta") >= 0)
    test.assert_eq_str(zeli.serve_out_kind(plain, "macos"), "")
    sys.remove_path(plain)
}

// A route with no `meta` ends in `build`, right before the closing brace.
#[test]
fn route_builders_stop_at_the_closing_brace() {
    let dir = "/tmp/zeli_route_builders"
    sys.mkdir(dir)
    sys.write_file("{{dir}}/app_routes.loam", "fn routes() -> []Route {\n    return []Route {\n        Route { pattern: \"/\", build: b_root_page },\n        Route { pattern: \"/a\", build: b_a_page, meta: m_a_page },\n    }\n}\n")
    let got = zeli.route_builders(dir)
    assert_eq_int(got.len, 2)
    assert_eq_str(got[0], "b_root_page")
    assert_eq_str(got[1], "b_a_page")
}
