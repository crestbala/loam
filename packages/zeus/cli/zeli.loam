//! zeli — the Loam/Zeus CLI, written in Loam.
//!
//! Built as `bin/zeli` by `make`, and the only implementation of these commands
//! there is: it was ported from a TypeScript one that has since been removed, so
//! running a CLI command no longer needs a second language or a second runtime.
//!
//!     zeli fmt [dir]        format every .loam under a tree (default: .)
//!     zeli routes <appdir>  write <appdir>/app_routes.loam from routes/
//!     zeli new <name> [dir] write a new app and generate its route table
//!
//! A command here owns its own walking, quoting and reporting rather than
//! borrowing the shell: `sys.exec` is the one seam that goes through `sh`, so
//! every path is quoted on the way in.

import "std:async"
import "std:fmt"
import "std:http"
import "std:json"
import "std:net"
import "std:str"
import "std:sys"
import "chunks.loam" as chunks

/// `p` without its last path segment ("" when it has none).
fn dir_of(p: string) -> string {
    let mut cut = -1
    for i in 0..p.len {
        if p[i] == 47 {
            cut = i
        }
    }
    if cut < 0 {
        return ""
    }
    let mut b = []int {}
    for i in 0..cut {
        push(b, p[i])
    }
    return string_from_bytes(b)
}

/// `dir` with `name` under it. Interpolation rather than `+`: Loam has no string
/// concatenation operator, and this is the idiom for building a path.
fn join(dir: string, name: string) -> string {
    if dir == "" {
        return name
    }
    if dir == "/" {
        return "/{{name}}"
    }
    return "{{dir}}/{{name}}"
}

/// `s` as one word for the shell: single-quoted, with an embedded quote closed,
/// backslash-escaped and reopened (`'` -> `'\''`), which is the only character a
/// single-quoted word cannot carry. This tree really does contain paths like
/// `routes/(marketing)/about/page.loam`, so nothing here may reach `sh` bare.
fn shell_quote(s: string) -> string {
    let mut b = []int {}
    push(b, 39) /* ' */
    for i in 0..s.len {
        let c = s[i]
        if c == 39 {
            push(b, 39)
            push(b, 92) /* \ */
            push(b, 39)
            push(b, 39)
        } else {
            push(b, c)
        }
    }
    push(b, 39)
    return string_from_bytes(b)
}

fn starts_with(s: string, prefix: string) -> bool {
    if prefix.len > s.len {
        return false
    }
    for i in 0..prefix.len {
        if s[i] != prefix[i] {
            return false
        }
    }
    return true
}

/// `a` with `b` after it. Strings are values here and a helper cannot append to
/// one, so building text is a pure function returning a new string.
fn cat(a: string, b: string) -> string {
    let mut x = []int {}
    for i in 0..a.len {
        push(x, a[i])
    }
    for i in 0..b.len {
        push(x, b[i])
    }
    return string_from_bytes(x)
}

/// `s[a..b]` as a new string (empty when the range is empty or backwards).
fn slice(s: string, a: int, b: int) -> string {
    let mut x = []int {}
    if a < b {
        for i in a..b {
            push(x, s[i])
        }
    }
    return string_from_bytes(x)
}

fn ends_with(s: string, suffix: string) -> bool {
    if suffix.len > s.len {
        return false
    }
    let off = s.len - suffix.len
    for i in 0..suffix.len {
        if s[i + off] != suffix[i] {
            return false
        }
    }
    return true
}

/// Is this a hidden entry (`.git`, `.zeus`, …)? A walk never enters one.
fn is_dot(name: string) -> bool {
    if name.len == 0 {
        return false
    }
    return name[0] == 46 /* . */
}

/// A directory a walk never descends into: build output and vendored packages.
/// Keeping this list identical to the TypeScript CLI's is what makes the two
/// implementations see the same set of files.
fn skip_dir(name: string) -> bool {
    if name == "build" {
        return true
    }
    if name == "vendor" {
        return true
    }
    if name == "node_modules" {
        return true
    }
    return false
}

/// Every `.loam` under `dir`, directories-first order of sorted listings.
fn loam_sources(dir: string) -> []string {
    let mut out = []string {}
    let entries = sys.list_dir(dir)
    for i in 0..entries.len {
        let name = entries[i]
        if is_dot(name) {
            continue
        }
        if skip_dir(name) {
            continue
        }
        let p = join(dir, name)
        if sys.is_dir(p) == 1 {
            let sub = loam_sources(p)
            for j in 0..sub.len {
                push(out, sub[j])
            }
        } else {
            if ends_with(name, ".loam") {
                push(out, p)
            }
        }
    }
    return out
}

/// `bin/loam-fmt`, next to this binary: the CLI is run as `./bin/zeli`
/// from the repo, or as a bare name from `PATH`. Both have to work, so this
/// prefers the sibling of `argv[0]` and falls back to the name.
fn formatter_path() -> string {
    let d = dir_of(sys.arg(0))
    if d != "" {
        let sibling = join(d, "loam-fmt")
        if sys.exists(sibling) == 1 {
            return sibling
        }
    }
    return "loam-fmt"
}

/// `zeli fmt [dir]` — run `loam-fmt` over every `.loam` under `dir` and write
/// the canonical form back in place.
///
/// Files the build generates are left alone: formatting one would only be undone
/// by the next build. The output matches the TypeScript CLI line for line on the
/// success path, which is what the suite checks.
fn fmt(dir: string) -> int {
    let tool = formatter_path()
    if sys.exists(tool) == 0 {
        fmt.println("zeli: missing", tool, "— run `make` first")
        return 1
    }
    let files = loam_sources(dir)
    if files.len == 0 {
        fmt.println("zeli: no .loam files under", dir)
        return 0
    }
    let mut changed = 0
    let mut failed = 0
    for i in 0..files.len {
        let f = files[i]
        let src = sys.read_file(f)
        if starts_with(src, "// Generated by `zeli") {
            continue
        }
        let out = sys.exec("{{shell_quote(tool)}} {{shell_quote(f)}} 2>&1")
        if sys.exec_status() != 0 {
            fmt.println("zeli:", f, ":", out)
            failed += 1
            continue
        }
        if !fmt.eq(out, src) {
            sys.write_file(f, out)
            fmt.println("zeli: formatted", f)
            changed += 1
        }
    }
    if failed == 0 {
        fmt.println("zeli:", files.len, "file(s),", changed, "formatted")
    } else {
        fmt.println("zeli:", files.len, "file(s),", changed, "formatted,", failed, "failed")
    }
    if failed != 0 {
        return 1
    }
    return 0
}

// --- shared: paths and text ---
//
// The TypeScript CLI leans on `node:path` and on `String.replace` / `split` /
// `trim`. There is no `std:str`, so the few shapes it actually needs live here,
// written on the byte level like the rest of this file. Every one of them has to
// agree with its Node counterpart exactly: the commands that use them are the
// ones whose output the suite diffs against the TypeScript CLI.

/// `p` with `.` segments dropped, `..` resolved against what precedes them, and
/// no trailing `/`. An empty result means "here". `path.resolve` normalises this
/// way, and it is what makes the printed paths equal to the TypeScript CLI's.
///
/// Written as its own scan rather than on `segments`, which is declared further
/// down with the route helpers.
fn normalize(p: string) -> string {
    let abs = starts_with(p, "/")
    let mut parts = []string {}
    let mut start = 0
    let mut i = 0
    while i <= p.len {
        if i == p.len || p[i] == 47 {
            push(parts, slice(p, start, i))
            start = i + 1
        }
        i += 1
    }
    let mut out = []string {}
    for i in 0..parts.len {
        let s = parts[i]
        if s == "" || s == "." {
            continue
        }
        if s == ".." {
            if out.len > 0 {
                if out[out.len - 1] != ".." {
                    /* Drop the segment this one cancels. */
                    let mut kept = []string {}
                    for j in 0..out.len - 1 {
                        push(kept, out[j])
                    }
                    out = kept
                    continue
                }
            }
            /* Nothing to cancel: keep it only in a relative path, so `/..`
               cannot escape the root. */
            if abs {
                continue
            }
        }
        push(out, s)
    }
    let mut r = ""
    if abs {
        r = "/"
    }
    for i in 0..out.len {
        if i > 0 {
            r = cat(r, "/")
        }
        r = cat(r, out[i])
    }
    return r
}

/// `p` as an absolute path: itself when it already is one, else under the
/// working directory. The `path.resolve` of the TypeScript CLI.
fn abs_path(p: string) -> string {
    if starts_with(p, "/") {
        return normalize(p)
    }
    let cwd = sys.cwd()
    if cwd == "" {
        return normalize(p)
    }
    return normalize(cat(cat(cwd, "/"), p))
}

/// `p` relative to `base` when `base` is a prefix of it, else `p`. Both are
/// expected to be normalised already. `path.relative`, used to print paths the
/// way the TypeScript CLI does.
fn rel_to(base: string, p: string) -> string {
    if base == "" {
        return p
    }
    if !starts_with(p, base) {
        return p
    }
    let rest = slice(p, base.len, p.len)
    if rest == "/" {
        return "."
    }
    if starts_with(rest, "/") {
        return slice(rest, 1, rest.len)
    }
    return rest
}

/// The last segment of `p` (`path.basename`).
fn base_name(p: string) -> string {
    let mut cut = -1
    for i in 0..p.len {
        if p[i] == 47 {
            cut = i
        }
    }
    return slice(p, cut + 1, p.len)
}

/// `s` without `suf` when it ends with it (`path.basename(p, suf)`).
fn drop_suffix(s: string, suf: string) -> string {
    if !ends_with(s, suf) {
        return s
    }
    return slice(s, 0, s.len - suf.len)
}

/// `s` without one trailing `/` (`s.replace(/\/$/, "")`). Only one: the pattern
/// has no `g`, and `base` in `--base` can end with a single slash.
fn strip_slash(s: string) -> string {
    if ends_with(s, "/") {
        return slice(s, 0, s.len - 1)
    }
    return s
}

/// `s` without one leading `/` (`s.replace(/^\//, "")`).
fn strip_lead_slash(s: string) -> string {
    if starts_with(s, "/") {
        return slice(s, 1, s.len)
    }
    return s
}

/// `s` split on `\n`. A trailing newline yields no final empty line, which is
/// what the callers here want: the metadata dump ends with one.
fn split_lines(s: string) -> []string {
    let mut out = []string {}
    let mut start = 0
    for i in 0..s.len {
        if s[i] == 10 {
            push(out, slice(s, start, i))
            start = i + 1
        }
    }
    if start < s.len {
        push(out, slice(s, start, s.len))
    }
    return out
}

/// `s` split on the byte `ch`, keeping empty pieces (`String.split`).
fn split_on(s: string, ch: int) -> []string {
    let mut out = []string {}
    let mut start = 0
    for i in 0..s.len {
        if s[i] == ch {
            push(out, slice(s, start, i))
            start = i + 1
        }
    }
    push(out, slice(s, start, s.len))
    return out
}

/// `s` without leading or trailing whitespace (`String.trim`). Carriage returns
/// count, so a line that came through a CRLF file or a pipe is still clean.
fn trim(s: string) -> string {
    let mut a = 0
    while a < s.len {
        let c = s[a]
        if c == 32 || c == 9 || c == 13 || c == 10 {
            a += 1
        } else {
            break
        }
    }
    let mut b = s.len
    while b > a {
        let c = s[b - 1]
        if c == 32 || c == 9 || c == 13 || c == 10 {
            b -= 1
        } else {
            break
        }
    }
    return slice(s, a, b)
}

/// `1` when `word` sits in `s` at `at` — a local scan, so this needs nothing
/// from the route helpers further down.
fn at_word(s: string, at: int, word: string) -> int {
    if at + word.len > s.len {
        return 0
    }
    for i in 0..word.len {
        if s[at + i] != word[i] {
            return 0
        }
    }
    return 1
}

/// `s` with every occurrence of `from` replaced by `to`. `from` must not be
/// empty; the scan does not rescan what it inserted.
fn replace_all(s: string, from: string, to: string) -> string {
    if from.len == 0 {
        return s
    }
    let mut r = ""
    let mut i = 0
    while i < s.len {
        if at_word(s, i, from) == 1 {
            r = cat(r, to)
            i += from.len
        } else {
            r = cat(r, slice(s, i, i + 1))
            i += 1
        }
    }
    return r
}

/// `s` safe in an HTML attribute or text node. The order is the TypeScript
/// CLI's: the ampersand first, so the entities it writes are not escaped again.
fn esc(s: string) -> string {
    let mut r = replace_all(s, "&", "&amp;")
    r = replace_all(r, "<", "&lt;")
    r = replace_all(r, ">", "&gt;")
    r = replace_all(r, "\"", "&quot;")
    return r
}

/// `needle` in `hay`. The server asks it of a request's content type, and
/// the tests ask it of the injected snippet.
fn contains_str(hay: string, needle: string) -> bool {
    if needle.len > hay.len {
        return false
    }
    for i in 0..hay.len - needle.len + 1 {
        let mut same = true
        for j in 0..needle.len {
            if hay[i + j] != needle[j] {
                same = false
            }
        }
        if same {
            return true
        }
    }
    return false
}

/// Where `needle` first sits in `hay`, or `-1`. `contains_str` answers the
/// yes/no question; this is the one that has to say where, for the ids the CLI
/// reads back out of an artifact the compiler wrote.
fn idx_of(hay: string, needle: string) -> int {
    if needle.len == 0 || needle.len > hay.len {
        return -1
    }
    for i in 0..hay.len - needle.len + 1 {
        let mut same = true
        for j in 0..needle.len {
            if hay[i + j] != needle[j] {
                same = false
            }
        }
        if same {
            return i
        }
    }
    return -1
}

/// The text between `open` and the next `stop` byte, or `""` when `open` is not
/// there. `Info.plist` and `build.gradle` are both read this way: one tagged
/// value out of a file whose shape belongs to the compiler.
fn between(text: string, open: string, stop: int) -> string {
    let at = idx_of(text, open)
    if at < 0 {
        return ""
    }
    let mut bs = []int {}
    let mut i = at + open.len
    while i < text.len && text[i] != stop {
        push(bs, text[i])
        i += 1
    }
    return string_from_bytes(bs)
}

/// Every line of `s` prefixed with `pad`. The two-space indent the CLI puts
/// under a `failed` line, so compiler output stays readable in a terminal.
fn indent_lines(s: string, pad: string) -> string {
    let lines = split_lines(s)
    let mut r = ""
    for i in 0..lines.len {
        if i > 0 {
            r = cat(r, "\n")
        }
        r = cat(cat(r, pad), lines[i])
    }
    return r
}

/// `lines` joined with `\n` and closed with one, which is how the generated
/// files in this tree end.
fn join_lines(lines: []string) -> string {
    let mut r = ""
    for i in 0..lines.len {
        if i > 0 {
            r = cat(r, "\n")
        }
        r = cat(r, lines[i])
    }
    return cat(r, "\n")
}

/// `p` is an absolute `http:`/`https:` URL (`/^https?:\/\//`).
fn is_http(s: string) -> bool {
    if starts_with(s, "http://") {
        return true
    }
    return starts_with(s, "https://")
}

/// `base` and `p` joined into an absolute canonical URL, or `p` alone when it
/// is already one or no `--base` was given.
fn canonical_url(base: string, p: string) -> string {
    if is_http(p) {
        return p
    }
    if base == "" {
        return p
    }
    if starts_with(p, "/") {
        return cat(strip_slash(base), p)
    }
    return cat(cat(strip_slash(base), "/"), p)
}

/// The repository root. `bin/zeli` sits in `<repo>/bin`, so two levels up from
/// the binary; with no directory in `argv[0]` (a bare `zeli` from
/// `PATH`) the working directory is the best answer available.
fn repo_root() -> string {
    let bin = dir_of(sys.arg(0))
    if bin == "" {
        return abs_path(".")
    }
    let up = dir_of(bin)
    if up == "" {
        return abs_path(".")
    }
    return abs_path(up)
}

/// `bin/loamc`, the compiler this CLI drives. It is looked up beside this
/// binary and not through `PATH`, so a checkout can never pick up a different
/// compiler than the one it built.
fn loam_path() -> string {
    return join(repo_root(), "bin/loamc")
}

/// The TypeScript CLI's `die`: report and exit 2. The message goes to stdout
/// here rather than stderr — `std:fmt` has no stderr writer, and the suite
/// normalises the two streams when it diffs the CLIs.
fn die(msg: string) {
    say(msg)
    sys.exit(2)
}

/// `die` with captured output indented under the headline.
fn die_extra(head: string, body: string) {
    if body == "" {
        die(head)
    }
    say(cat(cat(head, "\n"), indent_lines(body, "  ")))
    sys.exit(2)
}

/// Run `bin/loamc` with `args` (already quoted) from the repo root, stderr
/// merged into stdout. `env` is a `NAME=1` prefix, or `""`.
///
/// The headless switches are unset: they are compile-time — they decide whether
/// a GUI host is linked — and the test runner exports them for *running*
/// fixtures. A user build must not inherit them, or it silently produces a
/// windowless binary.
///
/// `env` is applied to the `loamc` word itself, never to the `cd`: an
/// assignment before `cd` scopes to that builtin alone and the compiler then
/// runs without it — which for `LOAM_NO_DCE` means DCE silently returns and the
/// metadata dump fails to compile.
fn run_loam(env: string, args: string) -> string {
    return sys.exec(loam_cmd(env, args))
}

/// The shell command `run_loam` runs, for a caller running several at once.
fn loam_cmd(env: string, args: string) -> string {
    let mut envs = ""
    if env != "" {
        envs = cat(env, " ")
    }
    return "unset ZEUS_HEADLESS LOAM_HEADLESS MAYA_HEADLESS; cd {{shell_quote(repo_root())}} && {{envs}}{{shell_quote(loam_path())}} {{args}} 2>&1"
}

/// What one command in `run_jobs` did: whether it exited 0, and its output.
struct JobResult {
    ok: bool,
    log: string,
}

/// Run shell commands side by side and return when all have finished, in the
/// order given. `dir` holds each one's output and exit status until they are
/// read back; a single command runs inline and leaves nothing there.
///
/// A compile is one clang on one core, so a build made of several gets the
/// machine's other cores this way, and it costs as long as its slowest command
/// rather than the sum of them.
fn run_jobs(dir: string, cmds: []string) -> []JobResult {
    let mut out = []JobResult {}
    if cmds.len == 1 && !ui_on {
        let log = sys.exec(cat(cat("( ", cmds[0]), " ) 2>&1"))
        push(out, JobResult { ok: sys.exec_status() == 0, log: log })
        return out
    }
    sys.mkdir(dir)
    let mut script = ""
    for i in 0..cmds.len {
        sys.remove_path(join(dir, "job{{i}}.rc"))
        let base = shell_quote(join(dir, "job{{i}}"))
        // Renamed into place: `wait_jobs` takes an .rc that exists to be whole.
        script = cat(
            script,
            "( ( {{cmds[i]}} ) >{{base}}.log 2>&1; echo $? >{{base}}.tmp; mv -f {{base}}.tmp {{base}}.rc ) &\n",
        )
    }
    // From a file: `sys.exec` refuses a command over 8 KB, and a web build's
    // chunks reach that.
    let file = join(dir, "jobs.sh")
    sys.write_file(file, cat(script, "wait\n"))
    if ui_on {
        sys.exec("sh {{shell_quote(file)}} >/dev/null 2>&1 &")
        wait_jobs(dir, cmds.len)
    } else {
        sys.exec("sh {{shell_quote(file)}}")
    }
    for i in 0..cmds.len {
        let base = join(dir, "job{{i}}")
        let rc = trim(read_text_if_present(cat(base, ".rc")))
        push(out, JobResult { ok: rc == "0", log: read_text_if_present(cat(base, ".log")) })
    }
    return out
}

/// Keep the panel moving until all `n` jobs under `dir` have an exit status.
fn wait_jobs(dir: string, n: int) {
    while true {
        let mut done = 0
        for i in 0..n {
            done += sys.exists(join(dir, "job{{i}}.rc"))
        }
        ui_poll(dir, done, n)
        if done == n {
            return
        }
        async.sleep(15)
    }
}

/// Run `cmd` from the repo root, stderr merged into stdout.
fn run_here(cmd: string) -> string {
    return sys.exec("cd {{shell_quote(repo_root())}} && {{cmd}} 2>&1")
}

// --- the build panel ---
//
// In a terminal a build draws a live box: a bar per thing being built, with its
// percent and the time it took, a status line, and what is being served. It stays
// at the bottom of the terminal: `say` puts a log line above it, so a running
// app's output scrolls past without tearing it. Anywhere else (a pipe, a log file,
// the test suite) `ui_on` stays false and `say` is `fmt.println`.
//
// The bars read two sources while `run_jobs` polls: `loamc` reports each step to
// a `LOAM_PROGRESS` file (driver.c), and the steps zeli runs itself are `ui_step`s.
// A compile that is not cut into units reports nothing between its start and its
// end, so its bar runs on how long the last such compile took.

let UI_RUN: int = 0
let UI_OK: int = 1
let UI_FAILED: int = 2
/// How long a single compile is assumed to take before one has been timed.
let UI_FIRST_GUESS_MS: int = 15000
let UI_MAX_WIDTH: int = 86
/// Where the right column starts, counted from the right border.
let UI_RIGHT_ROOM: int = 28
/// Below this the right column is dropped; below `UI_MIN_WIDTH`, the panel.
let UI_WIDE: int = 72
let UI_MIN_WIDTH: int = 44
let UI_LABEL_COL: int = 12

/// One line of the panel.
struct Bar {
    label: string,
    /// The file `loamc` reports to; empty for a bar zeli moves itself.
    progress: string,
    /// Bytes of `progress` already applied.
    read: int,
    /// The `run_jobs` index this bar waits on, or -1.
    job: int,
    /// Whether that job is the end of the bar, or only of its first step.
    job_ends: bool,
    /// Percent now, and where the current step began and ends.
    pct: int,
    lo: int,
    hi: int,
    note: string,
    state: int,
    started: i64,
    ms: int,
    /// Set during a compile that reports nothing: `pct` follows the clock.
    timed_from: i64,
    guess_ms: int,
}

let mut ui_on: bool = false
let mut ui_serving_mode: bool = false
let mut ui_esc: string = ""
let mut ui_color: bool = true
let mut ui_width: int = 0
let mut ui_bars: []Bar = []Bar {}
/// The bar for what follows the compile, or -1.
let mut ui_bundle: int = -1
/// What the running jobs are, when each finished job moves `ui_bundle` along.
let mut ui_counting: string = ""
let mut ui_drawn: int = 0
let mut ui_frame_last: string = ""
let mut ui_platform: string = ""
let mut ui_url: string = ""
let mut ui_modules: int = 0
let mut ui_units: int = 0
let mut ui_t0: i64 = 0
/// The status once nothing is running: its text, and what makes it a failure.
let mut ui_status: string = ""
let mut ui_status_bad: bool = false
let mut ui_status_ms: int = -1

/// Turn the panel on, if stdout can show one and is wide enough.
fn ui_open(platform: string, serving: bool) {
    if sys.stdout_tty() == 0 {
        return
    }
    let size = split_on(trim(sys.exec("stty size </dev/tty 2>/dev/null")), 32)
    let mut cols = 80
    if size.len == 2 && int_of(size[1]) > 0 {
        cols = int_of(size[1])
    }
    if cols - 1 < UI_MIN_WIDTH {
        return
    }
    // The language has no escape for ESC.
    let mut esc = []int {}
    push(esc, 27)
    ui_esc = string_from_bytes(esc)
    ui_color = sys.env_set("NO_COLOR") == 0
    ui_width = if cols - 1 < UI_MAX_WIDTH { cols - 1 } else { UI_MAX_WIDTH }
    ui_platform = platform
    ui_serving_mode = serving
    ui_on = true
}

/// Leave the panel where it is and go back to plain output.
fn ui_close() {
    ui_draw()
    ui_on = false
    ui_drawn = 0
}

/// Start a fresh set of bars.
fn ui_build_begin() {
    if ui_on {
        ui_bars = []Bar {}
        ui_bundle = -1
        ui_t0 = async.now_ms()
        ui_status = ""
        ui_status_bad = false
        ui_status_ms = -1
    }
}

/// Add a bar and return its index. An empty `report` is a bar zeli moves itself.
fn ui_add(label: string, report: string, job: int, job_ends: bool, note: string) -> int {
    if !ui_on {
        return -1
    }
    let mut guess = UI_FIRST_GUESS_MS
    if report != "" {
        let last = int_of(trim(read_text_if_present(cat(report, ".ms"))))
        if last > 0 {
            guess = last
        }
    }
    let now = async.now_ms()
    push(ui_bars, Bar {
        label: label,
        progress: report,
        read: 0,
        job: job,
        job_ends: job_ends,
        pct: 0,
        lo: 0,
        hi: 0,
        note: note,
        state: UI_RUN,
        started: now,
        ms: 0,
        timed_from: 0,
        guess_ms: guess,
    })
    return ui_bars.len - 1
}

/// The `LOAM_PROGRESS` file for `name`, emptied, or `""` with the panel off.
fn ui_report_file(appdir: string, name: string) -> string {
    if !ui_on {
        return ""
    }
    let zdir = join(appdir, ".zeus")
    sys.mkdir(zdir)
    let file = join(zdir, "progress.{{name}}")
    sys.remove_path(file)
    return file
}

/// `file` as an assignment for `loam_cmd`, after any assignments in `env`.
fn ui_env(env: string, file: string) -> string {
    if file == "" {
        return env
    }
    let set = cat("LOAM_PROGRESS=", shell_quote(file))
    if env == "" {
        return set
    }
    return cat(cat(env, " "), set)
}

/// Move bar `i` to `pct`, with the next step ending at `hi`.
fn ui_step(i: int, pct: int, hi: int, note: string) {
    if ui_on && i >= 0 {
        ui_bars[i].pct = pct
        ui_bars[i].lo = pct
        ui_bars[i].hi = hi
        ui_bars[i].note = note
        ui_draw()
    }
}

fn ui_bar_end(i: int, state: int) {
    if ui_on && i >= 0 && ui_bars[i].state == UI_RUN {
        ui_bars[i].state = state
        ui_bars[i].job = -1
        ui_bars[i].ms = int(async.now_ms() - ui_bars[i].started)
        if state == UI_OK {
            ui_bars[i].pct = 100
            if ui_bars[i].timed_from != 0 {
                let took = int(async.now_ms() - ui_bars[i].timed_from)
                sys.write_file(cat(ui_bars[i].progress, ".ms"), "{{took}}\n")
            }
        }
        ui_draw()
    }
}

/// End every bar still running as failed, for a build that is over.
fn ui_stop_bars() {
    for i in 0..ui_bars.len {
        ui_bar_end(i, UI_FAILED)
    }
}

/// Set the line under the bars.
fn ui_set_status(text: string, bad: bool, ms: int) {
    if ui_on {
        ui_status = text
        ui_status_bad = bad
        ui_status_ms = ms
        ui_draw()
    }
}

/// How long the build since `ui_build_begin` took.
fn ui_build_ms() -> int {
    return int(async.now_ms() - ui_t0)
}

/// Apply one line of a `LOAM_PROGRESS` file to bar `i`.
fn ui_apply(i: int, line: string) {
    let w = split_on(line, 32)
    let stage = w[0]
    if stage == "check" {
        ui_step(i, 2, 2, "Checking")
    } else if stage == "modules" && w.len == 2 {
        ui_modules = int_of(w[1])
        ui_step(i, 6, 6, "Checked {{ui_modules}} modules")
    } else if stage == "codegen" {
        ui_step(i, 8, 8, "Generating C")
    } else if stage == "pch" {
        ui_step(i, 12, 12, "Compiling headers")
    } else if stage == "units" && w.len == 3 {
        let done = int_of(w[1])
        let total = int_of(w[2])
        ui_units = total
        if total > 0 {
            ui_step(i, 15 + 75 * done / total, 90, "Compiling {{done}}/{{total}} units")
        }
    } else if stage == "link" {
        ui_step(i, 92, 92, "Linking")
    } else if stage == "cc" {
        ui_bars[i].timed_from = async.now_ms()
        ui_step(i, 15, 97, "Compiling")
    }
}

/// Bring every bar up to date, given that `done` of `total` jobs under `dir` have
/// finished, and redraw.
fn ui_poll(dir: string, done: int, total: int) {
    for i in 0..ui_bars.len {
        if ui_bars[i].state != UI_RUN {
            continue
        }
        if ui_bars[i].progress != "" {
            let body = read_text_if_present(ui_bars[i].progress)
            let mut end = body.len
            while end > ui_bars[i].read && body[end - 1] != 10 {
                end -= 1
            }
            if end > ui_bars[i].read {
                let ls = split_lines(slice(body, ui_bars[i].read, end))
                for k in 0..ls.len {
                    if ls[k] != "" {
                        ui_apply(i, ls[k])
                    }
                }
                ui_bars[i].read = end
            }
        }
        if ui_bars[i].timed_from != 0 {
            let spent = int(async.now_ms() - ui_bars[i].timed_from)
            // Stops short of the end: the guess may be low, and only the job finishes it.
            let share = 95 * spent / ui_bars[i].guess_ms
            let capped = if share > 95 { 95 } else { share }
            ui_bars[i].pct = 15 + (ui_bars[i].hi - 15) * capped / 100
        }
        let job = ui_bars[i].job
        if job >= 0 {
            let rc = join(dir, "job{{job}}.rc")
            if sys.exists(rc) == 1 {
                if !ui_bars[i].job_ends {
                    ui_bars[i].job = -1
                    ui_bars[i].pct = ui_bars[i].hi
                } else if trim(read_text_if_present(rc)) == "0" {
                    ui_bar_end(i, UI_OK)
                } else {
                    ui_bar_end(i, UI_FAILED)
                }
            }
        } else if i == ui_bundle && ui_counting != "" {
            ui_bars[i].note = "{{ui_counting}} {{done}}/{{total}}"
            ui_bars[i].pct = ui_bars[i].lo + (ui_bars[i].hi - ui_bars[i].lo) * done / total
        }
    }
    ui_draw()
}

fn ui_paint(code: string, text: string) -> string {
    if !ui_color {
        return text
    }
    return "{{ui_esc}}[{{code}}m{{text}}{{ui_esc}}[0m"
}

fn ui_dim(text: string) -> string {
    return ui_paint("2", text)
}

fn ui_amber(text: string) -> string {
    return ui_paint("33", text)
}

/// `text`, cut to `n` bytes. It is ASCII: target names.
fn ui_clip(text: string, n: int) -> string {
    if text.len <= n {
        return text
    }
    return cat(slice(text, 0, n - 3), "...")
}

fn ui_repeat(text: string, n: int) -> string {
    let mut out = ""
    for i in 0..n {
        out = cat(out, text)
    }
    return out
}

/// Move to column `col` of this line. Emoji are not the same width on every
/// terminal, so nothing to the right of one is placed by counting.
fn ui_col(col: int) -> string {
    return "{{ui_esc}}[{{col}}G"
}

/// `ms` as `2.1s`.
fn ui_time(ms: int) -> string {
    return "{{ms / 1000}}.{{ms % 1000 / 100}}s"
}

/// `done`, `failed` or `running`, by a bar's state.
fn ui_tone(state: int, done: string, failed: string, running: string) -> string {
    if state == UI_OK {
        return done
    }
    return if state == UI_FAILED { failed } else { running }
}

/// The bar's cells, then its percent and time.
fn ui_cells(b: Bar, width: int) -> string {
    let fill = width * b.pct / 100
    let color = ui_tone(b.state, "32", "31", "36")
    let cells = cat(
        ui_paint(color, ui_repeat("━", fill)),
        ui_paint("2", ui_repeat("─", width - fill)),
    )
    let mark = ui_tone(b.state, "✓", "✗", "")
    let ms = if b.state == UI_RUN { int(async.now_ms() - b.started) } else { b.ms }
    let digits = "{{b.pct}}"
    return "{{cells}} {{ui_pad_left(digits, 3)}}% {{mark}} {{ui_dim(ui_time(ms))}}"
}

fn ui_pad_left(text: string, n: int) -> string {
    return cat(ui_repeat(" ", n - text.len), text)
}

/// The status row, from the first bar still running or else what was last set.
fn ui_status_row() -> string {
    for i in 0..ui_bars.len {
        if ui_bars[i].state == UI_RUN {
            let note = if ui_bars[i].note == "" { "Starting" } else { ui_bars[i].note }
            return "{{ui_amber(note)}} {{ui_dim(ui_time(ui_build_ms()))}}"
        }
    }
    let color = if ui_status_bad { "31" } else { "33" }
    let text = ui_paint(color, if ui_status == "" { "Finishing" } else { ui_status })
    if ui_status_ms < 0 {
        return text
    }
    return "{{text}} {{ui_dim(ui_time(ui_status_ms))}}"
}

/// The right column, one entry per row.
fn ui_facts() -> []string {
    let mut out = []string {}
    if ui_width < UI_WIDE {
        return out
    }
    push(out, "Platform: {{ui_amber(ui_clip(ui_platform, UI_RIGHT_ROOM - 12))}}")
    if ui_modules > 0 {
        let units = if ui_units > 0 { " ({{ui_units}} units)" } else { "" }
        let count = "{{ui_modules}}{{units}}"
        push(out, "Modules: {{ui_amber(count)}}")
    }
    if ui_url != "" {
        push(out, "Open: {{ui_amber(ui_url)}}")
    }
    return out
}

fn ui_line(left: string, fact: string) -> string {
    let side = ui_paint("2", "│")
    let mut out = "{{side}} {{left}}"
    if fact != "" {
        out = cat(out, cat(ui_col(ui_width - UI_RIGHT_ROOM), fact))
    }
    return cat(cat(out, ui_col(ui_width)), "{{side}}\n")
}

/// The whole panel, one string so it reaches the terminal in one write.
fn ui_frame() -> string {
    let hint = if ui_serving_mode { " Ctrl-C to stop ─" } else { "" }
    let hint_cells = if ui_serving_mode { 17 } else { 0 }
    let width = ui_width - 2
    let rule = ui_repeat("─", width - 7 - hint_cells)
    let mut out = ui_paint("2", "╭─ zeli {{rule}}{{hint}}╮\n")
    let facts = ui_facts()
    let room = if ui_width < UI_WIDE { ui_width } else { ui_width - UI_RIGHT_ROOM }
    let cells = room - UI_LABEL_COL - 16
    let mut rows = ui_bars.len + 1
    if facts.len > rows {
        rows = facts.len
    }
    for r in 0..rows {
        let fact = if r < facts.len { facts[r] } else { "" }
        let mut left = ""
        if r < ui_bars.len {
            let label = cat(ui_bars[r].label, ":")
            left = cat(cat(label, ui_col(UI_LABEL_COL)), ui_cells(ui_bars[r], cells))
        } else if r == ui_bars.len {
            left = cat(cat("Status:", ui_col(UI_LABEL_COL)), ui_status_row())
        }
        out = cat(out, ui_line(left, fact))
    }
    return cat(out, ui_dim(cat(cat("╰", ui_repeat("─", width)), "╯\n")))
}

/// Clear the panel and leave the cursor where it began.
fn ui_erase() {
    if ui_drawn > 0 {
        fmt.write("\r{{ui_esc}}[{{ui_drawn}}A{{ui_esc}}[J")
    }
}

fn ui_write_frame(frame: string) {
    fmt.write(frame)
    ui_frame_last = frame
    ui_drawn = 0
    for i in 0..frame.len {
        if frame[i] == 10 {
            ui_drawn += 1
        }
    }
}

/// Redraw if anything on the panel changed.
fn ui_draw() {
    if ui_on {
        let frame = ui_frame()
        if frame != ui_frame_last {
            ui_erase()
            ui_write_frame(frame)
        }
    }
}

/// A line of output: above the panel when there is one.
fn say(msg: string) {
    if ui_drawn == 0 {
        fmt.println(msg)
        return
    }
    ui_erase()
    fmt.println(msg)
    ui_write_frame(ui_frame())
}

/// A line the panel already shows while serving.
fn chat(msg: string) {
    if !ui_on || !ui_serving_mode {
        say(msg)
    }
}

// --- routes ---
//
// `app_routes.loam` is a build artifact of the `routes/` tree: one import per
// route file, one builder per page (wrapped in the layouts above it), a route
// table, and `app()` applying the root layout once around the router. The output
// is byte-for-byte what the TypeScript CLI produces, which the suite checks by
// diffing the two on real apps.

fn is_word(c: int) -> int {
    if c >= 97 && c <= 122 {
        return 1 /* a-z */
    }
    if c >= 65 && c <= 90 {
        return 1 /* A-Z */
    }
    if c >= 48 && c <= 57 {
        return 1 /* 0-9 */
    }
    if c == 95 {
        return 1 /* _ */
    }
    return 0
}

fn is_group(seg: string) -> bool {
    if seg.len < 2 {
        return false
    }
    if seg[0] != 40 {
        return false /* ( */
    }
    return seg[seg.len - 1] == 41 /* ) */
}

fn is_param(seg: string) -> bool {
    if seg.len < 2 {
        return false
    }
    if seg[0] != 91 {
        return false /* [ */
    }
    return seg[seg.len - 1] == 93 /* ] */
}

fn dash_to_underscore(s: string) -> string {
    let mut x = []int {}
    for i in 0..s.len {
        if s[i] == 45 {
            push(x, 95)
        } else {
            push(x, s[i])
        }
    }
    return string_from_bytes(x)
}

/// `s` from `i`, with spaces and tabs skipped.
fn after_spaces(s: string, i: int) -> int {
    let mut j = i
    while j < s.len {
        if s[j] == 32 || s[j] == 9 {
            j += 1
        } else {
            break
        }
    }
    return j
}

fn match_at(s: string, i: int, word: string) -> int {
    if i + word.len > s.len {
        return 0
    }
    for k in 0..word.len {
        if s[i + k] != word[k] {
            return 0
        }
    }
    return 1
}

/// `1` when the source defines `fn <name> (`. This is what the TypeScript CLI
/// tests with `\bfn\s+name\s*\(`, and it decides whether the route table wires
/// up `meta` / `paths` for a page.
fn has_fn(src: string, name: string) -> int {
    let mut i = 0
    while i + 2 < src.len {
        if src[i] == 102 && src[i + 1] == 110 {
            if i == 0 || is_word(src[i - 1]) == 0 {
                let j = after_spaces(src, i + 2)
                if match_at(src, j, name) == 1 {
                    let k = after_spaces(src, j + name.len)
                    if k < src.len {
                        if src[k] == 40 {
                            return 1 /* ( */
                        }
                    }
                }
            }
        }
        i += 1
    }
    return 0
}

/// `rel` split on `/` (empty when it is empty).
fn segments(rel: string) -> []string {
    let mut out = []string {}
    if rel == "" {
        return out
    }
    let mut start = 0
    let mut i = 0
    while i <= rel.len {
        if i == rel.len || rel[i] == 47 {
            push(out, slice(rel, start, i))
            start = i + 1
        }
        i += 1
    }
    return out
}

/// The URL pattern a route directory serves: `(group)` segments drop out and
/// `[x]` becomes `:x`.
fn url_for(rel: string) -> string {
    let segs = segments(rel)
    let mut url = ""
    for i in 0..segs.len {
        let seg = segs[i]
        if is_group(seg) {
            continue
        }
        if is_param(seg) {
            url = cat(cat(url, "/:"), slice(seg, 1, seg.len - 1))
        } else {
            url = cat(cat(url, "/"), seg)
        }
    }
    if url == "" {
        return "/"
    }
    return url
}

/// The import alias for a route file: `(group)` and `[param]` lose their
/// brackets and `-` becomes `_`.
fn alias_for(rel: string, kind: string) -> string {
    let mut name = "root"
    let segs = segments(rel)
    for i in 0..segs.len {
        let mut bit = segs[i]
        if is_group(bit) || is_param(bit) {
            bit = slice(bit, 1, bit.len - 1)
        }
        bit = dash_to_underscore(bit)
        if name == "root" && i == 0 {
            name = bit
        } else {
            name = cat(cat(name, "_"), bit)
        }
    }
    return cat(cat(cat("r_", name), "_"), kind)
}

/// `rel` under `root` ("" keeps `root` itself).
fn under(root: string, rel: string) -> string {
    if rel == "" {
        return root
    }
    return join(root, rel)
}

/// `rel` cut after its `keep`-th segment.
fn first_segments(rel: string, keep: int) -> string {
    let mut seen = 0
    let mut i = 0
    while i < rel.len {
        if rel[i] == 47 {
            seen += 1
            if seen == keep {
                return slice(rel, 0, i)
            }
        }
        i += 1
    }
    return rel
}

fn segment_count(rel: string) -> int {
    if rel == "" {
        return 0
    }
    let mut n = 1
    for i in 0..rel.len {
        if rel[i] == 47 {
            n += 1
        }
    }
    return n
}

fn index_of(keys: []string, key: string) -> int {
    for i in 0..keys.len {
        if keys[i] == key {
            return i
        }
    }
    return -1
}

/// `1` when `a` sorts after `b` byte for byte — the order the TypeScript CLI's
/// `Array.sort()` gives for these paths.
fn str_gt(a: string, b: string) -> int {
    let mut n = a.len
    if b.len < n {
        n = b.len
    }
    let mut i = 0
    while i < n {
        if a[i] != b[i] {
            if a[i] > b[i] {
                return 1
            }
            return 0
        }
        i += 1
    }
    if a.len > b.len {
        return 1
    }
    return 0
}

/// Does this directory hold a file the route table cares about?
fn is_route_dir(here: string) -> int {
    if sys.exists(join(here, "page.loam")) == 1 {
        return 1
    }
    if sys.exists(join(here, "layout.loam")) == 1 {
        return 1
    }
    if sys.exists(join(here, "not-found.loam")) == 1 {
        return 1
    }
    return 0
}

/// Every directory under `routes/` that holds a route file, as a path relative
/// to `routes/` ("" for the root), parents before children so a layout is always
/// known by the time the page beneath it is wrapped.
fn route_dirs(routes: string, rel: string) -> []string {
    let mut out = []string {}
    let here = under(routes, rel)
    if is_route_dir(here) == 1 {
        push(out, rel)
    }
    let entries = sys.list_dir(here)
    for i in 0..entries.len {
        let name = entries[i]
        if is_dot(name) {
            continue
        }
        if sys.is_dir(join(here, name)) == 1 {
            let sub = route_dirs(routes, under(rel, name))
            for j in 0..sub.len {
                push(out, sub[j])
            }
        }
    }
    return out
}

/// Write `<appdir>/app_routes.loam` from the `routes/` tree and return its
/// path, or `""` after reporting why not. The worker behind both
/// `zeli routes` and `zeli new`, which reports differently — which is why this
/// one does not print on success.
fn generate(appdir: string) -> string {
    let routes_dir = join(appdir, "routes")
    if sys.is_dir(routes_dir) == 0 {
        fmt.println("zeli: no routes/ directory in", appdir)
        return ""
    }
    let out = join(appdir, "app_routes.loam")
    let dirs = route_dirs(routes_dir, "")

    /* Imports (every route file) and layouts, as parallel arrays: a helper here
       cannot append to a vector passed in, so each list is built locally. */
    let mut imp_alias = []string {}
    let mut imp_path = []string {}
    let mut lay_rel = []string {}
    let mut lay_alias = []string {}
    let mut pages = []string {}
    let mut page_alias = []string {}
    let mut page_meta = []int {}
    let mut page_paths = []int {}
    let mut page_live = []int {}
    let mut nf_root = ""

    for d in 0..dirs.len {
        let rel = dirs[d]
        let here = under(routes_dir, rel)
        if sys.exists(join(here, "layout.loam")) == 1 {
            let al = alias_for(rel, "layout")
            push(lay_rel, rel)
            push(lay_alias, al)
            push(imp_alias, al)
            push(imp_path, join("routes", under(rel, "layout.loam")))
        }
        if sys.exists(join(here, "page.loam")) == 1 {
            let al = alias_for(rel, "page")
            push(pages, rel)
            push(page_alias, al)
            push(imp_alias, al)
            push(imp_path, join("routes", under(rel, "page.loam")))
            let src = sys.read_file(join(here, "page.loam"))
            push(page_meta, has_fn(src, "meta"))
            push(page_paths, has_fn(src, "paths"))
            /* `fn PageLive()` instead of `fn Page(p: Params)`: the page reads
               its params through `router.param_live`, so the route is `live`
               and its slot is kept across a params-only navigation. The
               signature is the contract — a page without the argument cannot
               take a snapshot of it. */
            push(page_live, has_fn(src, "PageLive"))
        }
        if sys.exists(join(here, "not-found.loam")) == 1 {
            let al = alias_for(rel, "not_found")
            push(imp_alias, al)
            push(imp_path, join("routes", under(rel, "not-found.loam")))
            if rel == "" {
                nf_root = al
            }
        }
    }
    if pages.len == 0 {
        fmt.println("zeli: no page.loam under", routes_dir)
        return ""
    }

    let mut lines = []string {}
    push(lines, "// Generated by `zeli routes`. Do not edit.")
    push(lines, "import \"std:zeus\"")
    push(lines, "import \"std:router\"")
    /* Imports sorted by alias, emitted by repeatedly taking the smallest alias
       after the last one written. */
    let mut last = ""
    let mut emitted = 0
    while emitted < imp_alias.len {
        let mut best = -1
        for i in 0..imp_alias.len {
            if str_gt(imp_alias[i], last) == 0 {
                continue
            }
            if best < 0 {
                best = i
            } else {
                if str_gt(imp_alias[best], imp_alias[i]) == 1 {
                    best = i
                }
            }
        }
        if best < 0 {
            break
        }
        push(lines, cat(cat(cat("import \"", imp_path[best]), "\" as "), imp_alias[best]))
        last = imp_alias[best]
        emitted += 1
    }
    push(lines, "")

    for p in 0..pages.len {
        let rel = pages[p]
        let al = page_alias[p]
        let stem = slice(al, 2, al.len)
        let mut body = cat(al, ".Page(p)")
        if page_live[p] == 1 {
            body = cat(al, ".PageLive()")
        }
        /* Outside in: the page's own layout first, then each one above it. */
        let mut keep = segment_count(rel)
        while keep >= 1 {
            let idx = index_of(lay_rel, first_segments(rel, keep))
            if idx >= 0 {
                body = cat(cat(cat(lay_alias[idx], ".Layout(fn() { "), body), " })")
            }
            keep -= 1
        }
        push(lines, cat(cat("fn b_", stem), "(p: Params) -> Node {"))
        push(lines, cat("    return ", body))
        push(lines, "}")
        push(lines, "")
        if page_meta[p] == 1 {
            push(lines, cat(cat("fn m_", stem), "(p: Params) -> Meta {"))
            push(lines, cat(cat("    return ", al), ".meta(p)"))
            push(lines, "}")
            push(lines, "")
        }
        if page_paths[p] == 1 {
            push(lines, cat(cat("fn p_", stem), "() -> []string {"))
            push(lines, cat(cat("    return ", al), ".paths()"))
            push(lines, "}")
            push(lines, "")
        }
    }

    push(lines, "fn routes() -> []Route {")
    push(lines, "    return []Route {")
    for p in 0..pages.len {
        let stem = slice(page_alias[p], 2, page_alias[p].len)
        let mut extra = ""
        if page_meta[p] == 1 {
            extra = cat("meta: m_", stem)
        }
        if page_paths[p] == 1 {
            if extra != "" {
                extra = cat(extra, ", ")
            }
            extra = cat(extra, cat("paths: p_", stem))
        }
        if page_live[p] == 1 {
            if extra != "" {
                extra = cat(extra, ", ")
            }
            extra = cat(extra, "live: true")
        }
        let mut tail = ""
        if extra != "" {
            tail = cat(", ", extra)
        }
        push(
            lines,
            cat(
                cat(
                    cat(
                        cat(cat("        Route { pattern: \"", url_for(pages[p])), "\", build: b_"),
                        stem,
                    ),
                    tail,
                ),
                " },",
            ),
        )
    }
    push(lines, "    }")
    push(lines, "}")
    push(lines, "")

    /* The root layout wraps the router once, so its state survives navigation;
       a root not-found overrides the router's default. */
    let mut props = ""
    if nf_root != "" {
        props = cat(cat(" RouterProps { notFound: fn() { ", nf_root), ".NotFound() } }")
    }
    let router = cat(cat("router.Router(routes(),", props), ")")
    let root_lay = index_of(lay_rel, "")
    push(lines, "fn app() -> Node {")
    if root_lay >= 0 {
        push(lines, cat(cat("    return ", lay_alias[root_lay]), ".Layout(fn() {"))
        push(lines, cat("        ", router))
        push(lines, "    })")
    } else {
        push(lines, cat("    return ", router))
    }
    push(lines, "}")

    let mut text = ""
    for i in 0..lines.len {
        if i > 0 {
            text = cat(text, "\n")
        }
        text = cat(text, lines[i])
    }
    text = cat(text, "\n")
    sys.write_file(out, text)
    return out
}

/// `zeli routes <appdir>` — regenerate the route table and say so.
fn routes(appdir: string) -> int {
    let out = generate(appdir)
    if out == "" {
        return 2
    }
    fmt.println("zeli: wrote", out)
    return 0
}

// --- serve: the reload channel ---
//
// `zeli serve` builds one target and watches the sources, so an edit is reflected
// without a manual rebuild: the web target reloads the page, and a native or
// device target is stopped and started again. This section holds the pieces the
// reload channel is made of; they are pure (`is_watched_source`, `sse_frame`,
// `live_snippet`) so they can be read and tested as source rather than only
// through a running server.

/// The decimal integer in `s`, or `-1` when it holds none. Only what `--port`
/// needs: an optional run of leading spaces, then digits.
fn int_of(s: string) -> int {
    let mut i = 0
    while i < s.len {
        if s[i] == 32 || s[i] == 9 {
            i += 1
        } else {
            break
        }
    }
    let mut n = 0
    let mut digits = 0
    while i < s.len {
        let c = s[i]
        if c < 48 || c > 57 {
            break
        }
        n = n * 10 + (c - 48)
        digits += 1
        i += 1
    }
    if digits == 0 {
        return -1
    }
    return n
}

/// `n` in decimal, as a string — the reverse of `int_of`. `std:fmt` writes an
/// integer to stdout instead of returning it, and what is needed here is one
/// inside a shell command: a pid to signal, a count to report.
fn int_str(n: int) -> string {
    let mut v = n
    if v < 0 {
        v = 0
    }
    let mut rev = []int {}
    if v == 0 {
        push(rev, 48 /* 0 */ )
    }
    while v > 0 {
        push(rev, 48 + (v % 10))
        v = v / 10
    }
    let mut out = []int {}
    let mut i = rev.len
    while i > 0 {
        i -= 1
        push(out, rev[i])
    }
    return string_from_bytes(out)
}

/// The Server-Sent Events channel the injected snippet subscribes to.
fn live_path() -> string {
    return "/.zeli-live"
}

/// One SSE frame. `EventSource.onmessage` receives the payload as `data`.
fn sse_frame(rev: int) -> string {
    return "data: {{rev}}\n\n"
}

/// The live-reload script injected into every served HTML page.
///
/// The server pushes a frame per successful rebuild, so an idle tab holds one
/// open connection and does nothing — no `setInterval`, no request a second.
/// `EventSource` reconnects by itself if the server restarts. The first
/// frame on connect is the current revision: a baseline, not a reload. Only a
/// later, different revision reloads, and it saves the signal arena first so an
/// edit does not throw away app state.
fn live_snippet() -> string {
    return "<script>(function(){var r=null,s=new EventSource('{{live_path()}}');s.onmessage=function(e){if(r===null){r=e.data;return}if(e.data!==r){r=e.data;try{if(window.__zeus_save)window.__zeus_save()}catch(x){}location.reload()}}})()</script>"
}

/// Does a path under one of `roots` belong to the serve build's input set?
///
/// Only `.loam` sources count, and never anything under an output or cache dir —
/// a rebuild writes into `<appdir>/build/`, which sits *inside* a watched root,
/// so an unfiltered watch would rebuild forever. The skip list is the one the
/// walk uses, which is what keeps "the sources" one idea across the commands.
///
/// `app_routes.loam` is rejected by name as well: it is the route table serve
/// *generates* before every build, so it is an output like `build/` and not a
/// source. Watching it closes a loop — the rebuild rewrites it, the rewrite is an
/// event, the event is a rebuild — which runs until the server is stopped.
///
/// The decision is made on the path *relative* to the root it was under, so a
/// checkout that happens to live under a dotted directory still reloads. With no
/// roots the whole path is judged, which is all a path with no known root can be
/// held to.
fn is_watched_source(file: string, roots: []string) -> bool {
    let mut rel = file
    for i in 0..roots.len {
        if starts_with(rel, cat(roots[i], "/")) {
            rel = slice(rel, roots[i].len + 1, rel.len)
            break
        }
    }
    if !ends_with(rel, ".loam") {
        return false
    }
    if base_name(rel) == "app_routes.loam" {
        return false /* generated by this command, not a source */
    }
    let segs = segments(rel)
    for i in 0..segs.len {
        if is_dot(segs[i]) {
            return false /* .git/, .zeus/ */
        }
        if skip_dir(segs[i]) {
            return false /* build/, vendor/, node_modules/ */
        }
    }
    return true
}

/// The file's text, or `""` when it is not there. The before/after read that
/// tells serve whether the route table it regenerates actually changed.
fn read_text_if_present(p: string) -> string {
    if sys.exists(p) == 0 {
        return ""
    }
    return sys.read_file(p)
}

/// A regenerated route table: whether it worked, and whether it differs from
/// what was there before.
struct Regen {
    ok: bool,
    changed: bool,
}

/// Regenerate `<appdir>/app_routes.loam` and report whether it changed.
///
/// The route table is a build artifact of the `routes/` tree, not a file to
/// maintain: serve regenerates it before every build, so adding
/// `routes/pricing/page.loam` is enough — nothing to run, nothing to keep in
/// sync by hand.
fn generate_tracked(appdir: string) -> Regen {
    let out = join(appdir, "app_routes.loam")
    let before = read_text_if_present(out)
    if generate(appdir) == "" {
        return Regen { ok: false, changed: false }
    }
    return Regen { ok: true, changed: read_text_if_present(out) != before }
}

/// One serve build: whether it worked, and whether the route table it regenerated
/// moved.
struct BuildStep {
    ok: bool,
    routes_changed: bool,
}

/// The build a *watched* target gets: the compiler's development profile, which
/// skips the optimizer and dead-strip. Those exist for the shipped binary, and in
/// a loop that recompiles on every edit they are most of the edit's cost. Only
/// `serve` asks for it, so nothing built by `zeli build` changes.
///
/// Web stays at `-Oz`, which here is faster than the lower levels; the post-link
/// optimizer is what `split_web` skips.
///
/// Every serve build also compiles in units cached under `.zeus/cc`
/// (`LOAM_SHARD`, see driver.c), so an edit recompiles the code it changed.
fn serve_build_env(appdir: string, target: string) -> string {
    let shards = shard_env(appdir)
    if target == "web" {
        return shards
    }
    return "LOAM_DEV=1 {{shards}}"
}

/// Where this app's compiled units live: under `.zeus`, because a build clears
/// `build/` and the point is for them to outlast one.
fn shard_env(appdir: string) -> string {
    return cat("LOAM_SHARD=", shell_quote(join(join(appdir, ".zeus"), "cc")))
}

/// Regenerate the route table and typecheck the entry: the part of a build that
/// is not the compiler, and the part every target needs before it can be built
/// or launched.
fn serve_prepare(appdir: string) -> BuildStep {
    let step = serve_routes(appdir)
    if !step.ok || check_entry(find_entry(appdir)) {
        return step
    }
    return BuildStep { ok: false, routes_changed: step.routes_changed }
}

/// Regenerate the route table, when the app has one.
fn serve_routes(appdir: string) -> BuildStep {
    if sys.exists(join(appdir, "routes")) == 0 {
        return BuildStep { ok: true, routes_changed: false }
    }
    let r = generate_tracked(appdir)
    return BuildStep { ok: r.ok, routes_changed: r.changed }
}

/// Build one target into `build/<target>/` and, for web, refresh the HTML shell.
///
/// A failed prepare or compile is reported and is not fatal: `serve` keeps the
/// last build that worked — the page it serves, or the process it started — up,
/// so the error is on the terminal while the thing you were looking at stays
/// where it was. Only the route table failing to generate stops the build here,
/// because the entry imports it and nothing downstream can name it.
///
/// There is no separate check here: the compile below runs the same frontend and
/// reports the same errors, so a check first would only pay for it twice.
fn serve_build(appdir: string, target: string) -> BuildStep {
    ui_build_begin()
    let step = serve_routes(appdir)
    if !step.ok {
        ui_set_status("Route table failed", true, -1)
        return step
    }
    let entry = find_entry(appdir)
    let stem = drop_suffix(base_name(entry), ".loam")
    let dir = join(join(appdir, "build"), target)
    sys.mkdir(dir)
    let out = join(dir, out_name(target, stem))
    // Dev splits like a release, so the Network tab shows what visitors get.
    let split = target == "web" && can_split(appdir)
    let mut flags = target_flags(target)
    if split {
        flags = cat(flags, " --wasm-split-input")
    }
    let mut args = ""
    if flags != "" {
        args = cat(flags, " ")
    }
    args = cat(cat(cat(args, shell_quote(entry)), " -o "), shell_quote(out))
    let report = ui_report_file(appdir, target)
    ui_add("App", report, 0, true, "Starting")
    let mut cmds = []string { loam_cmd(ui_env(serve_build_env(appdir, target), report), args) }
    if target == "web" {
        push(cmds, meta_compile_cmd(appdir))
        ui_bundle = ui_add("Bundle", "", 1, false, "Reading route metadata")
        ui_step(ui_bundle, 0, 20, "Reading route metadata")
    }
    let jobs = run_jobs(join(appdir, ".zeus"), cmds)
    if !jobs[0].ok {
        ui_stop_bars()
        ui_set_status("Build failed", true, ui_build_ms())
        say(trim(jobs[0].log))
        return BuildStep { ok: false, routes_changed: step.routes_changed }
    }
    if target == "web" {
        require_meta(jobs[1])
    }
    if split {
        // Hashes change with every edit, so clear the last build's files.
        let assets = join(dir, "_zeus")
        sys.exec("rm -rf {{shell_quote(assets)}}")
        emit_web_shell(appdir, split_web(appdir, dir, stem, ""), "")
        report_web_sizes(dir)
    } else if target == "web" {
        emit_web_shell(appdir, plain_assets(stem), "")
    }
    ui_bar_end(ui_bundle, UI_OK)
    return BuildStep { ok: true, routes_changed: step.routes_changed }
}

/// Where a launched app's output goes: `build/<target>/<stem>.log`. The CLI owns
/// this rather than leaving it on the terminal, because that file is the only
/// place a trap survives the window closing.
fn app_log(appdir: string, target: string, stem: string) -> string {
    return cat(join(join(join(appdir, "build"), target), stem), ".log")
}

/// This process's own pid. A shell it starts reports its parent, and `serve` is
/// alive to be reported: the watchdog below needs a handle on it.
fn self_pid() -> int {
    return int_of(trim(sys.exec("echo $PPID")))
}

/// Tie a launched app to this process: if `serve` goes away — Ctrl-C, a crash,
/// a `kill -9` — the app goes with it.
///
/// The app cannot be relied on to *hear* the interrupt: a shell starts a
/// background job with `SIGINT` ignored and `exec` inherits that, which is why
/// Ctrl-C used to leave it running. `launch_app` resets the disposition, and this
/// is the belt to those braces — the watchdog polls both pids and kills the app
/// once either is gone. It exits by itself, so a rebuild leaves none behind.
fn guard_app(self: int, app: int) -> bool {
    if self <= 0 || app <= 0 {
        return false
    }
    let me = int_str(self)
    let them = int_str(app)
    let cmd = "sh -c 'while kill -0 {{me}} 2>/dev/null && kill -0 {{them}} 2>/dev/null; do sleep 1; done; kill {{them}} 2>/dev/null' >/dev/null 2>&1 &"
    sys.exec(cmd)
    return true
}

/// Start `cmd` in the background with its output appended to `log`, and return
/// its pid (0 when the shell would not start it). `cmd` is a shell word — the
/// caller quotes the path it passes — so a test can hand it anything runnable.
///
/// `&` on a single command makes the shell fork and `exec` it, so the pid it
/// reports back is the app's own and `stop_pid` reaches the app rather than a
/// wrapper around it. The output goes to a file rather than to the pipe
/// `sys.exec` reads: otherwise that read would not return until the app exited.
///
/// The app is started as a shell *background job*, which means it inherits
/// `SIGINT` ignored — and a non-interactive shell cannot reset a signal that was
/// ignored on entry, so the app cannot be made to hear Ctrl-C from here. That is
/// why `guard_app` exists: the app dies because `serve` did, not because it got
/// the same signal. Doing better needs a spawn that skips the shell.
fn launch_app(cmd: string, log: string) -> int {
    let out = sys.exec(cat(cat(cat(cat(cmd, " >> "), shell_quote(log)), " 2>&1 & echo $!"), ""))
    let pid = int_of(trim(out))
    if pid <= 0 {
        say("zeli: cannot start {{cmd}}")
    }
    return pid
}

/// Is `pid` still running? `kill -0` asks the kernel without signalling, and
/// says so through its exit status — the text it returns is not read.
fn pid_alive(pid: int) -> bool {
    if pid <= 0 {
        return false
    }
    let out = sys.exec(cat(cat("kill -0 ", int_str(pid)), " 2>/dev/null"))
    if out.len >= 0 && sys.exec_status() == 0 {
        return true
    }
    return false
}

/// Stop `pid` and wait for it to go: `SIGTERM` first, `SIGKILL` only if the app
/// is still there. Returns whether it is gone.
fn stop_pid(pid: int) -> bool {
    if pid <= 0 {
        return true
    }
    let out = sys.exec(cat(cat("kill ", int_str(pid)), " 2>/dev/null"))
    let mut waited = 0
    while waited < 20 && pid_alive(pid) {
        async.sleep(50)
        waited += 1
    }
    if pid_alive(pid) {
        let forced = sys.exec(cat(cat("kill -9 ", int_str(pid)), " 2>/dev/null"))
        async.sleep(50)
    }
    return !pid_alive(pid)
}

/// True when something is already accepting connections at `addr`. A connect
/// that fails is "nothing there", which is what a serve that has to start the
/// backend needs to tell apart from one the operator started already.
fn backend_listening(addr: string) -> bool {
    let hp = rpc_addr_of(addr)
    if hp.port <= 0 {
        return false
    }
    let fd = net.tcp_connect(hp.host, hp.port)
    if fd < 0 {
        return false
    }
    net.tcp_close(fd)
    return true
}

/// Build and start `<appdir>/server/main.loam` on the RPC address, once.
///
/// The UI talks to that process and has no way to say the process is missing,
/// so a page that fetches data otherwise sits on its loading line. An address
/// that is already open is left alone: that backend is not ours to stop.
/// Returns the pid we started, `0` when there is nothing to start, and `-1`
/// when the build or the listen failed.
fn ensure_backend(appdir: string) -> int {
    let entry = join(join(appdir, "server"), "main.loam")
    if sys.exists(entry) == 0 {
        return 0
    }
    let addr = serve_rpc_addr()
    if backend_listening(addr) {
        say("zeli: rpc backend {{addr}} already listening")
        return 0
    }
    let dir = join(join(appdir, "build"), "server")
    sys.mkdir(dir)
    let bin = join(dir, "main")
    let log = app_log(appdir, "server", "main")
    chat("zeli: building rpc backend…")
    let built = run_loam(
        serve_build_env(appdir, "macos"),
        cat(cat(shell_quote(entry), " -o "), shell_quote(bin)),
    )
    if sys.exec_status() != 0 {
        say(trim(built))
        say("zeli: rpc backend failed to build")
        return -1
    }
    let pid = launch_app(shell_quote(bin), log)
    if pid <= 0 {
        return -1
    }
    let mut waited = 0
    while waited < 50 && !backend_listening(addr) {
        if !pid_alive(pid) {
            say(trim(sys.read_file(log)))
            say("zeli: rpc backend exited before it listened on {{addr}}")
            return -1
        }
        async.sleep(100)
        waited += 1
    }
    if !backend_listening(addr) {
        stop_pid(pid)
        say("zeli: rpc backend did not listen on {{addr}}")
        return -1
    }
    guard_app(self_pid(), pid)
    chat("zeli: rpc backend {{addr}} (pid {{pid}})")
    tail_add(log, "server")
    return pid
}

/// `zeli serve <appdir> [--target T] [--port N] [--build-only]`
///
/// Builds one target and watches `.loam` sources — the app plus the framework
/// `std/` trees — so an edit is reflected without a manual rebuild. An app
/// with `server/main.loam` gets that backend on the RPC address first, so the
/// window and the data come up from this one command:
///
///   web      serves `build/web` on localhost, and every HTML page subscribes to
///            the live channel, so the browser is *told* about a rebuild
///   macos    runs the native binary, started again on every rebuild
///   server   the same, for a service entry
///   ios      builds the `.app` and installs it on the booted simulator
///   android  builds the Gradle tree and installs it on the attached device
///
/// The device targets are the one place where the packaging is not ours: it is
/// the compiler's host code, so `serve` runs `loamc --target=T --run <entry>`,
/// which is also where a missing SDK reports itself, in its own words.
fn serve(appdir: string, target: string, port: int, build_only: bool) -> int {
    if sys.exists(loam_path()) == 0 {
        die("zeli: missing {{loam_path()}} — run `make` in {{repo_root()}} first")
    }
    if !known_target(target) {
        die("zeli: unknown target '{{target}}' (want {{target_list()}})")
    }
    let entry = find_entry(appdir)
    let stem = drop_suffix(base_name(entry), ".loam")
    ui_open(platform_name(target), !build_only)
    if target == "web" && !build_only {
        ui_url = "http://127.0.0.1:{{port}}"
    }
    // Start from an empty `build/<target>`; the watch rebuilds that follow
    // write over it in place, so the running app and its log stay put.
    fresh_target_dir(appdir, target)
    chat("zeli: initial build…")
    if target == "ios" || target == "android" {
        return serve_device(appdir, target, stem, entry, build_only)
    }
    let first = serve_build(appdir, target)
    if first.routes_changed {
        chat("zeli: routes -> app_routes.loam")
    }
    if !first.ok {
        return 1
    }
    if build_only {
        chat("zeli: serve build ok (--build-only)")
        ui_set_status("Built {{stem}} ✓", false, ui_build_ms())
        ui_close()
        return 0
    }
    let built_ms = ui_build_ms()
    ui_set_status("Starting backend", false, -1)
    if ensure_backend(appdir) < 0 {
        ui_set_status("Backend failed", true, -1)
        return 1
    }
    ui_set_status("Serving {{stem}} 🚀", false, built_ms)
    if target == "web" {
        let vite = vite_host(appdir)
        if vite != "" {
            return serve_vite(appdir, vite, port)
        }
        return serve_web(appdir, port)
    }
    return serve_native(appdir, target, stem)
}

// --- serve: an app's own Vite host ---
//
// An app that ships `web/vite.config.js` owns its web dev server: the config
// compiles `web/app.loam`, watches the sources, reloads the page, and proxies
// its RPC paths. `serve` still does the rest — the compiler check, the backend,
// and tying the server's life to its own — so `zeli serve --target web` is the
// one command either way.

/// `<appdir>/web` when it holds a `vite.config.js`, else "".
fn vite_host(appdir: string) -> string {
    let dir = join(appdir, "web")
    if sys.exists(join(dir, "vite.config.js")) == 1 {
        return dir
    }
    return ""
}

/// Run the app's Vite server on `port` until it exits or `serve` does, echoing
/// its output. `npm install` runs first when `node_modules` is missing.
fn serve_vite(appdir: string, webdir: string, port: int) -> int {
    if sys.exists(join(webdir, "node_modules")) == 0 {
        say("zeli: npm install (vite) in {{rel_to(repo_root(), webdir)}}…")
        let out = sys.exec("cd {{shell_quote(webdir)}} && npm install 2>&1")
        if sys.exec_status() != 0 {
            say(trim(out))
            say("zeli: npm install failed")
            return 1
        }
    }
    let log = app_log(appdir, "web", "vite")
    sys.mkdir(dir_of(log))
    sys.write_file(log, "")
    // `exec` so the pid is Vite's own and `guard_app` reaches it.
    let cmd = "cd {{shell_quote(webdir)}} && exec ./node_modules/.bin/vite --port {{port}} --strictPort"
    let self = self_pid()
    let pid = launch_app(cmd, log)
    if pid <= 0 {
        return 1
    }
    guard_app(self, pid)
    let addr = "127.0.0.1:{{port}}"
    let mut shown = 0
    let mut waited = 0
    // The config compiles the wasm before it listens; give it a minute.
    while waited < 600 && !backend_listening(addr) {
        shown = echo_log(log, shown)
        if !pid_alive(pid) {
            say("zeli: vite exited before it listened on {{addr}}")
            return 1
        }
        async.sleep(100)
        waited += 1
    }
    chat("zeli: serve on http://{{addr}} (Vite, pid {{pid}})  (Ctrl-C to stop)")
    while pid_alive(pid) {
        shown = echo_log(log, shown)
        tail_pump()
        async.sleep(250)
    }
    echo_log(log, shown)
    say("zeli: vite exited (pid {{pid}})")
    return 1
}

// --- serve: logs in the terminal ---
//
// Everything an app logs lands in this terminal, labelled by where it came
// from: the native app's and the backend's output files are followed here, and
// a browser build posts its lines to `log_path()` on the dev server. Nothing is
// shown in the app's window or the browser console.

let mut tail_paths: []string = []string {}
let mut tail_tags: []string = []string {}
let mut tail_from: []int = []int {}
let mut tail_at: i64 = 0

/// Follow `path` from its current end, printing new lines as `tag │ line`.
/// A path already followed keeps its place (a restarted app appends to it).
fn tail_add(path: string, tag: string) {
    for i in 0..tail_paths.len {
        if tail_paths[i] == path {
            return
        }
    }
    push(tail_paths, path)
    push(tail_tags, tag)
    push(tail_from, sys.read_file(path).len)
}

/// Print the complete lines each followed file gained; a partial last line
/// waits for its newline.
fn tail_pump() {
    let now = async.now_ms()
    if int(now - tail_at) < 200 {
        return
    }
    tail_at = now
    for i in 0..tail_paths.len {
        let body = sys.read_file(tail_paths[i])
        if body.len < tail_from[i] {
            // Truncated (a fresh log): start over.
            tail_from[i] = 0
        }
        let mut end = body.len
        while end > tail_from[i] && body[end - 1] != 10 {
            end -= 1
        }
        if end > tail_from[i] {
            print_tagged(tail_tags[i], slice(body, tail_from[i], end))
            tail_from[i] = end
        }
    }
}

/// Each non-empty line of `text` as `tag │ line`.
fn print_tagged(tag: string, text: string) {
    let ls = split_lines(text)
    for i in 0..ls.len {
        if trim(ls[i]) != "" {
            say("{{tag}} │ {{ls[i]}}")
        }
    }
}

/// Where a browser build posts its log lines (`std:log` and `fmt.println`),
/// newline-separated. Served by `serve_web`; an app's own Vite config serves it
/// too (see examples/zeus/vidget/web/vite.config.js).
fn log_path() -> string {
    return "/__zeus/log"
}

/// Print what `log` gained past byte `from`; returns the new length.
fn echo_log(log: string, from: int) -> int {
    let body = sys.read_file(log)
    if body.len > from {
        let fresh = trim(slice(body, from, body.len))
        if fresh != "" {
            say(fresh)
        }
    }
    return body.len
}

// --- serve: watching the sources ---
//
// `std:sys` gives the kernel half of a watch and holds no state; which paths are
// held, which id is which path, and what a change means is here. The registry is
// two parallel vectors rather than a struct, because a helper cannot append to a
// vector handed to it.

/// Paths a registration is held for, parallel to `watch_ids`.
let mut watch_paths: []string = []string {}

/// The id `sys.watch_add` returned for `watch_paths[i]`. It is a descriptor, so
/// closing one is `sys.watch_close`.
let mut watch_ids: []int = []int {}

/// The path a registration id stands for, or `""` when it is not ours.
fn watch_path_of(id: int) -> string {
    for i in 0..watch_ids.len {
        if watch_ids[i] == id {
            return watch_paths[i]
        }
    }
    return ""
}

/// Hold a registration for `p`, and report whether it was new.
///
/// Re-arming must never stack a second watch on a path already held: the second
/// descriptor would report the same edit again, and a rebuild that triggers
/// itself never settles.
fn add_watch(h: int, p: string) -> int {
    for i in 0..watch_paths.len {
        if watch_paths[i] == p {
            return 0
        }
    }
    let id = sys.watch_add(h, p)
    if id == 0 {
        return 0
    }
    push(watch_paths, p)
    push(watch_ids, id)
    return 1
}

/// Register `dir`, everything under it, and report the `.loam` files that were
/// not held before.
///
/// The directories are registered so an *added* entry is seen, and the files so
/// an *edited* one is; neither watch covers the other's case. A dotted name and
/// the build/cache/vendor names are never entered, which is what keeps a rebuild
/// from writing into what it watches.
fn watch_arm_dir(h: int, dir: string) -> []string {
    let mut added = []string {}
    add_watch(h, dir)
    let entries = sys.list_dir(dir)
    for i in 0..entries.len {
        let name = entries[i]
        if is_dot(name) || skip_dir(name) {
            continue
        }
        let p = join(dir, name)
        if sys.is_dir(p) == 1 {
            let sub = watch_arm_dir(h, p)
            for j in 0..sub.len {
                push(added, sub[j])
            }
        } else {
            if ends_with(name, ".loam") {
                if add_watch(h, p) == 1 {
                    push(added, p)
                }
            }
        }
    }
    return added
}

/// Drop registrations whose path is gone and report them.
///
/// A deleted route has to wake the reload as much as an added one, and its
/// descriptor would otherwise hold a slot for a path that can never fire again.
fn watch_forget_missing() -> []string {
    let mut gone = []string {}
    let mut kept_paths = []string {}
    let mut kept_ids = []int {}
    for i in 0..watch_paths.len {
        if sys.exists(watch_paths[i]) == 0 {
            push(gone, watch_paths[i])
            sys.watch_close(watch_ids[i])
        } else {
            push(kept_paths, watch_paths[i])
            push(kept_ids, watch_ids[i])
        }
    }
    watch_paths = kept_paths
    watch_ids = kept_ids
    return gone
}

/// The sources `hits` names, each once, and only the ones a reload reacts to.
fn watch_keep(hits: []string, roots: []string) -> []string {
    let mut out = []string {}
    for i in 0..hits.len {
        if !is_watched_source(hits[i], roots) {
            continue
        }
        let mut dup = false
        for j in 0..out.len {
            if out[j] == hits[i] {
                dup = true
            }
        }
        if !dup {
            push(out, hits[i])
        }
    }
    return out
}

/// The source paths one change touched, or none when nothing happened in
/// `wait_ms`.
///
/// Waits for the first event and then drains the rest at once, because a single
/// save arrives as several events and reporting them one at a time would start a
/// rebuild each. A file event names the file; a directory event names only the
/// directory, so its entries are listed — that is the only way a brand-new route
/// file can be named at all, and the only way a deleted one can be.
fn watch_batch(h: int, roots: []string, wait_ms: int) -> []string {
    let mut hits = []string {}
    let mut dirs = []string {}
    let mut ev = sys.watch_next(h, wait_ms)
    while ev != 0 {
        let p = watch_path_of(ev)
        if p != "" {
            if sys.is_dir(p) == 1 {
                push(dirs, p)
            } else {
                push(hits, p)
            }
        }
        ev = sys.watch_next(h, 0)
    }
    if hits.len == 0 && dirs.len == 0 {
        return hits
    }
    for i in 0..dirs.len {
        let added = watch_arm_dir(h, dirs[i])
        for j in 0..added.len {
            push(hits, added[j])
        }
    }
    let gone = watch_forget_missing()
    for i in 0..gone.len {
        push(hits, gone[i])
    }
    return watch_keep(hits, roots)
}

/// What a rebuild reacts to: the app, and the framework `std/` trees it imports
/// from. `is_watched_source` judges a path relative to these, so a checkout that
/// lives under a dotted directory still reloads.
fn serve_roots(appdir: string) -> []string {
    let packages = join(repo_root(), "packages")
    let mut out = []string { appdir }
    push(out, join(join(packages, "zeus"), "std"))
    push(out, join(join(packages, "http"), "std"))
    push(out, join(join(packages, "loam"), "std"))
    return out
}

// --- serve: serving build/web ---

/// One serve reply: what to write back for a request.
struct HttpReply {
    status: int,
    content_type: string,
    body: string,
}

/// The content type the build output is served with. `.wasm` and `.js` are the
/// two that matter: a browser refuses to instantiate a module served with the
/// wrong one.
fn serve_content_type(file: string) -> string {
    if ends_with(file, ".wasm") {
        return "application/wasm"
    }
    if ends_with(file, ".js") {
        return "text/javascript"
    }
    return "application/octet-stream"
}

/// Resolve one serve request against `web`, the build output directory.
///
/// Pure but for reading the file it lands on, so it can be tested without a
/// socket: a nested path serves its own `index.html`, a missing path falls back
/// to the root shell (SPA-style), HTML gets the live-reload snippet, and the
/// module and script types are the ones a browser insists on.
fn serve_reply(web: string, pathname: string, snippet: string) -> HttpReply {
    let mut rel = strip_lead_slash(pathname)
    if rel == "" || ends_with(rel, "/") {
        rel = cat(rel, "index.html")
    }
    let mut file = join(web, rel)
    /* A directory, or an extensionless route, serves its own index.html. */
    if !ends_with(file, ".html") {
        let idx = join(file, "index.html")
        if sys.exists(idx) == 1 {
            file = idx
        }
    }
    if sys.exists(file) == 0 {
        file = join(web, "index.html")
    }
    if sys.exists(file) == 0 {
        return HttpReply { status: 404, content_type: "text/plain", body: "not found" }
    }
    let text = sys.read_file(file)
    if ends_with(file, ".html") {
        return HttpReply {
            status: 200,
            content_type: "text/html; charset=utf-8",
            body: replace_all(text, "</body>", cat(snippet, "</body>")),
        }
    }
    return HttpReply { status: 200, content_type: serve_content_type(file), body: text }
}

/// Read one request off `fd`: up to the end of the headers, then however many
/// body bytes `content-length` asks for. A server reads one request per
/// connection, so this is allowed to be simple.
fn read_request(fd: int) -> string {
    let mut acc = ""
    let mut head = -1
    for k in 0..64 {
        head = find_headers_end(acc)
        if head >= 0 {
            break
        }
        let chunk = net.tcp_read(fd, 4096)
        if chunk.len == 0 {
            return acc
        }
        acc = cat(acc, chunk)
    }
    if head < 0 {
        return acc
    }
    let want = request_body_len(acc, head)
    while acc.len - head < want {
        let chunk = net.tcp_read(fd, 4096)
        if chunk.len == 0 {
            break
        }
        acc = cat(acc, chunk)
    }
    return acc
}

/// The index just past the `\r\n\r\n` that ends a request's headers, or `-1`
/// while they are still incomplete.
fn find_headers_end(s: string) -> int {
    for i in 0..s.len {
        if i + 3 < s.len && s[i] == 13 && s[i + 1] == 10 && s[i + 2] == 13 && s[i + 3] == 10 {
            return i + 4
        }
    }
    return -1
}

/// The byte `c` as lower case, for a header name compare.
fn lower_byte(c: int) -> int {
    if c >= 65 && c <= 90 {
        return c + 32
    }
    return c
}

/// The `content-length` a request's headers ask for, or `0` when it asks for no
/// body. `head` is where the headers end, so only they are scanned.
fn request_body_len(s: string, head: int) -> int {
    let name = "content-length:"
    let mut i = 0
    while i + name.len <= head {
        let mut same = true
        for j in 0..name.len {
            if lower_byte(s[i + j]) != name[j] {
                same = false
            }
        }
        if same {
            return int_of(slice(s, i + name.len, head))
        }
        i += 1
    }
    return 0
}

/// One HTTP/1.1 reply for the server.
///
/// Written here rather than through `http.http_reply` because that one hardens
/// every reply with `Content-Security-Policy: default-src 'none'`. That is right
/// for an RPC endpoint and wrong for a page: it would block the app's own
/// `loader.js` and the live-reload snippet injected into the shell. `no-store`
/// is the other thing a server wants — a cached `app.wasm` is a rebuild the
/// browser never sees.
fn serve_http_reply(status: int, ctype: string, body: string) -> string {
    let head = "HTTP/1.1 {{status}} {{http.reason_phrase(status)}}\r\nContent-Type: {{ctype}}\r\nContent-Length: {{body.len}}\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n"
    return cat(head, body)
}

/// Answer one connection and hang up. A server has no keep-alive to hold,
/// and a page's own requests are separate connections anyway — *except* a live
/// channel subscription, which is the one reply that is deliberately left open.
fn serve_http_one(fd: int, web: string, snippet: string, rev: int) {
    let raw = read_request(fd)
    if raw.len == 0 {
        net.tcp_close(fd)
        return
    }
    let req = http.parse_http11(raw)
    if req.err != 0 {
        net.tcp_write(fd, serve_http_reply(400, "text/plain; charset=utf-8", "bad request"))
        net.tcp_close(fd)
        return
    }
    if req.path == live_path() {
        live_subscribe(fd, rev)
        return
    }
    if req.method == "POST" && req.path == log_path() {
        print_tagged("web", req.body)
        net.tcp_write(fd, serve_http_reply(204, "text/plain; charset=utf-8", ""))
        net.tcp_close(fd)
        return
    }
    /* The app's RPC is same-origin (for wasm `default_addr()` returns ""), so a
       browser build POSTs its gRPC-Web call here rather than to the backend.
       Without this it would be answered by the SPA fallback below. */
    if req.method == "POST" && contains_str(req.ctype, "grpc-web") {
        serve_proxy_rpc(fd, serve_rpc_addr(), req.path, req.query, req.ctype, req.body)
        net.tcp_close(fd)
        return
    }
    let reply = serve_reply(web, req.path, snippet)
    net.tcp_write(fd, serve_http_reply(reply.status, reply.content_type, reply.body))
    net.tcp_close(fd)
}

// --- serve: the live-reload channel ---
//
// A page subscribes once and is then *told* about a rebuild, so an idle tab
// holds one open connection and makes no request at all. A subscription is the
// one reply that is never closed: its descriptor is kept here and written to
// once per successful rebuild, and a write that fails is the page going away.

/// Descriptors of the pages subscribed to the live channel.
let mut live_clients: []int = []int {}

/// The headers a subscription is answered with.
///
/// No `content-length` and no `connection: close`, because the point is to hold
/// the connection open — and a reply built by `serve_http_reply` would end it.
fn live_head() -> string {
    return "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nCache-Control: no-store\r\nConnection: keep-alive\r\n\r\n"
}

/// Take one page's subscription. The first frame is the revision the page boots
/// into: a baseline, not a reload, so only a *later* revision reloads.
fn live_subscribe(fd: int, rev: int) {
    if net.tcp_write(fd, cat(live_head(), sse_frame(rev))) < 0 {
        net.tcp_close(fd)
        return
    }
    push(live_clients, fd)
}

/// One frame to every subscribed page, dropping the ones that have gone away.
fn live_push(rev: int) {
    let mut kept = []int {}
    for i in 0..live_clients.len {
        if net.tcp_write(live_clients[i], sse_frame(rev)) >= 0 {
            push(kept, live_clients[i])
        } else {
            net.tcp_close(live_clients[i])
        }
    }
    live_clients = kept
}

// --- serve: forwarding the app's RPC ---

/// A `host:port` split into its two halves. Named for the RPC address it comes
/// from rather than for its shape: a struct name is shared across every module
/// in a build, and `std:http` already has a `HostPort`.
struct RpcAddr {
    host: string,
    port: int,
}

/// `addr` as a host and a port. A missing port reads as `0`, which no backend
/// listens on, so a malformed address fails the same way an absent one does.
fn rpc_addr_of(addr: string) -> RpcAddr {
    for i in 0..addr.len {
        if addr[i] == 58 /* : */ {
            return RpcAddr { host: slice(addr, 0, i), port: int_of(slice(addr, i + 1, addr.len)) }
        }
    }
    return RpcAddr { host: addr, port: 0 }
}

/// Where the app's own backend listens. The same override `default_addr()` in
/// `std:http` honours, so both ends agree without configuration.
fn serve_rpc_addr() -> string {
    let a = sys.env("LOAM_RPC_ADDR")
    if a == "" {
        return "127.0.0.1:8080"
    }
    return a
}

/// Forward one gRPC-Web request to the app's backend, verbatim.
///
/// The reply is relayed as the backend framed it rather than rebuilt here: a
/// gRPC-Web response carries its status in trailers, and a status and body
/// copied out of it would drop exactly the part the client is waiting for.
///
/// No CORS handling is needed — the hop from the browser is same-origin and this
/// hop is server-to-server. A missing backend is a 502, so it shows up as a
/// failure rather than as silence.
fn serve_proxy_rpc(
    fd: int,
    addr: string,
    path: string,
    query: string,
    ctype: string,
    body: string
) {
    let hp = rpc_addr_of(addr)
    let up = net.tcp_connect(hp.host, hp.port)
    if up < 0 {
        serve_rpc_unreachable(fd, addr)
        return
    }
    let mut target = path
    if query != "" {
        target = cat(cat(target, "?"), query)
    }
    let mut out = "POST {{target}} HTTP/1.1\r\nHost: {{addr}}\r\nContent-Type: {{ctype}}\r\nx-grpc-web: 1\r\nContent-Length: {{body.len}}\r\nConnection: close\r\n\r\n"
    out = cat(out, body)
    if net.tcp_write(up, out) < 0 {
        net.tcp_close(up)
        serve_rpc_unreachable(fd, addr)
        return
    }
    let resp = http.h1_read_all(up)
    net.tcp_close(up)
    if resp.len == 0 {
        serve_rpc_unreachable(fd, addr)
        return
    }
    net.tcp_write(fd, resp)
}

/// The reply for a backend that is not there. Named rather than inlined because
/// both the connect and the send can be the thing that fails.
fn serve_rpc_unreachable(fd: int, addr: string) {
    say("zeli: rpc backend {{addr}} unreachable")
    net.tcp_write(
        fd,
        serve_http_reply(502, "text/plain; charset=utf-8", "rpc backend {{addr}} unreachable\n"),
    )
}

/// Watch the sources, rebuild on change, and serve `build/web` on localhost.
///
/// One loop, no threads: it waits a tick on the watcher, rebuilds if anything
/// moved, then answers whatever connections are waiting. A change is picked up
/// within a tick and a request is answered within a tick, and neither can starve
/// the other.
fn serve_web(appdir: string, port: int) -> int {
    let roots = serve_roots(appdir)
    let h = serve_watch(appdir)
    let listener = net.tcp_listen(port)
    if listener < 0 {
        die("zeli: cannot bind 127.0.0.1:{{port}}")
    }
    let web = join(join(appdir, "build"), "web")
    let snippet = live_snippet()
    let mut rev = 1
    chat("zeli: serve on http://127.0.0.1:{{port}}  (Ctrl-C to stop)")
    while true {
        tail_pump()
        let batch = watch_batch(h, roots, 50)
        if batch.len > 0 {
            chat("zeli: {{batch.len}} source file(s) changed, rebuilding…")
            let r = serve_build(appdir, "web")
            if r.routes_changed {
                chat("zeli: routes -> app_routes.loam")
            }
            if !r.ok {
                say("zeli: build failed — still serving rev {{rev}}")
            } else {
                rev += 1
                chat("zeli: rebuilt (rev {{rev}})")
                ui_set_status("Serving rev {{rev}} 🚀", false, ui_build_ms())
                live_push(rev)
            }
        }
        let mut waiting = net.tcp_poll(listener, 1, 0)
        while waiting == 1 {
            let fd = net.tcp_accept(listener)
            if fd > 0 {
                serve_http_one(fd, web, snippet, rev)
            }
            waiting = net.tcp_poll(listener, 1, 0)
        }
    }
    return 0
}

// --- serve: native and device targets ---
//
// A native target is a process this CLI starts and stops, so a rebuild is `stop`
// then `start`; a device target is one the platform starts, so a rebuild is
// "install and launch" again. Both watch the same sources and go through the same
// `serve_build`, so a build error is reported once, the same way, whatever the
// target is.

/// The kernel watcher over the app's sources, or exit. Every target watches the
/// same set — what differs is what a change does — so opening it lives here.
fn serve_watch(appdir: string) -> int {
    let roots = serve_roots(appdir)
    let h = sys.watch_open()
    if h == 0 {
        die("zeli: no kernel watcher on this host — `zeli serve` needs one")
    }
    for i in 0..roots.len {
        watch_arm_dir(h, roots[i])
    }
    return h
}

/// The name the panel gives a target.
fn platform_name(target: string) -> string {
    if target == "web" {
        return "Web"
    }
    if target == "macos" {
        return "macOS"
    }
    if target == "ios" {
        return "iOS"
    }
    if target == "android" {
        return "Android"
    }
    if target == "server" {
        return "Server"
    }
    return target
}

/// `serve` for a native target: one process, started again on every rebuild.
///
/// The app is checked on as well as the sources — a native app that traps leaves
/// nothing on screen to say why, so that notice and the log are the whole report.
/// A build that fails does not touch the process that is already up.
fn serve_native(appdir: string, target: string, stem: string) -> int {
    let roots = serve_roots(appdir)
    let h = serve_watch(appdir)
    let bin = join(join(join(appdir, "build"), target), stem)
    let log = app_log(appdir, target, stem)
    let self = self_pid()
    let mut pid = launch_app(shell_quote(bin), log)
    if pid <= 0 {
        return 1
    }
    guard_app(self, pid)
    tail_add(log, target)
    chat(
        "zeli: serve on {{target}} (pid {{pid}}) — logs below, also in {{rel_to(repo_root(), log)}}  (Ctrl-C to stop)",
    )
    let mut said_exited = false
    let mut tick = 0
    while true {
        tail_pump()
        let batch = watch_batch(h, roots, 50)
        if batch.len > 0 {
            chat("zeli: {{batch.len}} source file(s) changed, rebuilding…")
            said_exited = false
            let r = serve_build(appdir, target)
            if r.routes_changed {
                chat("zeli: routes -> app_routes.loam")
            }
            if !r.ok {
                if pid_alive(pid) {
                    say("zeli: build failed — pid {{pid}} still up")
                } else {
                    say("zeli: build failed — pid {{pid}} is gone")
                }
            } else {
                let gone = stop_pid(pid)
                pid = launch_app(shell_quote(bin), log)
                if pid <= 0 {
                    return 1
                }
                guard_app(self, pid)
                ui_set_status("Running pid {{pid}} 🚀", false, ui_build_ms())
                if gone {
                    chat("zeli: restarted (pid {{pid}})")
                } else {
                    say("zeli: restarted (pid {{pid}}) — the old process would not stop")
                }
            }
        }
        /* An app that exits on its own — a trap, or a service that returns — is
           reported once and then left alone: starting it again on its own clock
           would turn a crash into a spin. */
        tick += 1
        if tick % 20 == 0 && !pid_alive(pid) && !said_exited {
            say("zeli: app exited (pid {{pid}})")
            ui_set_status("App exited", true, -1)
            said_exited = true
        }
    }
    return 0
}

/// The id a platform needs to stop its app, read back out of the artifact the
/// build just wrote: the `.app`'s `Info.plist` for the simulator, `app/build.gradle`
/// for the device. Those ids are the compiler's naming rules, so reading them
/// back is what keeps this from being a second copy of those rules.
fn ios_bundle_id(appdir: string, stem: string) -> string {
    let plist = join(join(join(join(appdir, "build"), "ios"), cat(stem, ".app")), "Info.plist")
    if sys.exists(plist) == 0 {
        return ""
    }
    return between(sys.read_file(plist), "<key>CFBundleIdentifier</key><string>", 60 /* < */ )
}

/// The `applicationId` the Gradle tree was generated with.
fn android_app_id(appdir: string, stem: string) -> string {
    let gradle = join(
        join(join(join(join(appdir, "build"), "android"), stem), "app"),
        "build.gradle",
    )
    if sys.exists(gradle) == 0 {
        return ""
    }
    return between(sys.read_file(gradle), "applicationId \"", 34 /* " */ )
}

/// Stop the instance the last install left running, so what the screen shows is
/// the build just made. Both platforms keep the old process across an install,
/// so without this an edit would land on disk and never appear.
///
/// Best effort: a device that has never run this app has nothing to stop, and the
/// toolchain is allowed to say no. Either way it is not a failed serve.
fn stop_device(appdir: string, target: string, stem: string) -> bool {
    if target == "ios" {
        let bid = ios_bundle_id(appdir, stem)
        if bid == "" {
            return false
        }
        let out = sys.exec(cat(
            cat("xcrun simctl terminate booted ", shell_quote(bid)),
            " >/dev/null 2>&1",
        ))
        return sys.exec_status() == 0
    }
    let pkg = android_app_id(appdir, stem)
    if pkg == "" {
        return false
    }
    let out = sys.exec(cat(cat("adb shell am force-stop ", shell_quote(pkg)), " >/dev/null 2>&1"))
    return sys.exec_status() == 0
}

/// One device launch: `loamc --target=T --run <entry>` builds the artifact,
/// installs it, and starts it. It is passed the same `-o` the `build` command
/// uses so both leave the artifact in one place — which is also where
/// `stop_device` reads the id back from.
fn serve_device_run(appdir: string, target: string, stem: string, entry: string) -> bool {
    stop_device(appdir, target, stem)
    let out = join(join(join(appdir, "build"), target), stem)
    let mut args = cat(cat(cat(cat("--target=", target), " --run "), shell_quote(entry)), " -o ")
    args = cat(args, shell_quote(out))
    ui_build_begin()
    let report = ui_report_file(appdir, target)
    ui_add("App", report, 0, true, "Starting")
    let env = ui_env(serve_build_env(appdir, target), report)
    let jobs = run_jobs(join(appdir, ".zeus"), []string { loam_cmd(env, args) })
    if !jobs[0].ok {
        ui_set_status("Build failed", true, ui_build_ms())
        say(trim(jobs[0].log))
        return false
    }
    chat("zeli: {{target}} -> {{rel_to(repo_root(), out)}}")
    ui_set_status("Running on {{target}} 🚀", false, ui_build_ms())
    return true
}

/// `serve` for ios / android. The watch and the build are the ones every target
/// uses; the step is "build, install, launch" rather than a process this CLI
/// holds, so there is no pid to stop — the platform's runtime owns the app.
fn serve_device(
    appdir: string,
    target: string,
    stem: string,
    entry: string,
    build_only: bool
) -> int {
    if build_only {
        let r = serve_build(appdir, target)
        if r.routes_changed {
            chat("zeli: routes -> app_routes.loam")
        }
        if !r.ok {
            return 1
        }
        chat("zeli: serve build ok (--build-only)")
        return 0
    }
    let roots = serve_roots(appdir)
    let h = serve_watch(appdir)
    let first = serve_prepare(appdir)
    if first.routes_changed {
        chat("zeli: routes -> app_routes.loam")
    }
    if !first.ok {
        return 1
    }
    if !serve_device_run(appdir, target, stem, entry) {
        return 1
    }
    chat("zeli: serving {{target}}  (Ctrl-C to stop)")
    while true {
        let batch = watch_batch(h, roots, 50)
        if batch.len > 0 {
            chat("zeli: {{batch.len}} source file(s) changed, rebuilding…")
            let r = serve_prepare(appdir)
            if r.routes_changed {
                chat("zeli: routes -> app_routes.loam")
            }
            if !r.ok {
                say("zeli: build failed — the last install is still on the device")
            } else {
                if serve_device_run(appdir, target, stem, entry) {
                    chat("zeli: reinstalled")
                } else {
                    say("zeli: build failed — the last install is still on the device")
                }
            }
        }
    }
    return 0
}

// --- pkg sync: vendored packages and the lockfile ---
//
// `import "pkg:name"` resolves to `vendor/name/name.loam`, so a package has to be
// *materialized* before anything typechecks. `loam.deps` says where each one
// comes from and `loam.lock` records what was actually used, which is what makes
// a vendored tree reproducible without the network being up.

/// A `loam.deps` line split into its `name source [rev]` fields.
struct Dep {
    name: string,
    source: string,
    rev: string,
}

/// `line` without its comment, trimmed. A `#` anywhere starts one.
fn dep_line(line: string) -> string {
    let mut cut = line.len
    for i in 0..line.len {
        if line[i] == 35 /* # */ {
            cut = i
            break
        }
    }
    return trim(slice(line, 0, cut))
}

/// `s` split on runs of spaces and tabs, with empty pieces dropped. A dependency
/// line is written in whitespace, not in one particular byte.
fn split_ws(s: string) -> []string {
    let mut out = []string {}
    let mut i = 0
    while i < s.len {
        if s[i] == 32 || s[i] == 9 {
            i += 1
            continue
        }
        let start = i
        while i < s.len {
            if s[i] == 32 || s[i] == 9 {
                break
            }
            i += 1
        }
        push(out, slice(s, start, i))
    }
    return out
}

/// The fields of a non-empty `loam.deps` line. A missing `source` or `rev` reads
/// as empty, which the caller reports in its own words.
fn dep_of(line: string) -> Dep {
    let toks = split_ws(line)
    let mut name = ""
    let mut source = ""
    let mut rev = ""
    if toks.len > 0 {
        name = toks[0]
    }
    if toks.len > 1 {
        source = toks[1]
    }
    if toks.len > 2 {
        rev = toks[2]
    }
    return Dep { name: name, source: source, rev: rev }
}

/// A package name: an identifier, and unlike an app name a `-` is not allowed in
/// one, because `import "pkg:name"` has to be spellable as a path segment.
fn valid_pkg_name(name: string) -> bool {
    if name.len == 0 {
        return false
    }
    let c0 = name[0]
    if is_alpha(c0) == 0 && c0 != 95 /* _ */ {
        return false
    }
    for i in 1..name.len {
        let c = name[i]
        if is_alpha(c) == 0 && is_digit(c) == 0 && c != 95 {
            return false
        }
    }
    return true
}

/// Copy the tree at `src` to `dst`, skipping `.git`. A vendored package should
/// not carry the clone's history, which would be a second copy of the objects.
fn copy_tree(src: string, dst: string) {
    sys.mkdir(dst)
    let entries = sys.list_dir(src)
    for i in 0..entries.len {
        let name = entries[i]
        if name == ".git" {
            continue
        }
        let from = join(src, name)
        let to = join(dst, name)
        if sys.is_dir(from) == 1 {
            copy_tree(from, to)
        } else {
            sys.write_file(to, sys.read_file(from))
        }
    }
}

/// The first twelve characters of `s` — how a commit is shortened for a log
/// line, long enough to be unmistakable and short enough to read.
fn short_sha(s: string) -> string {
    if s.len <= 12 {
        return s
    }
    return slice(s, 0, 12)
}

/// `git <args>` from the repo root, stderr merged into the captured output. A
/// clone needs a cwd; a `-C <dir>` call does not, but running both the same way
/// keeps the exit status handling in one place.
fn run_git(args: string) -> string {
    return run_here(cat("git ", args))
}

/// `zeli pkg sync <appdir>`
///
/// Reads `<appdir>/loam.deps` — one `name source [rev]` per line, `#` comments —
/// and materializes each package under `<appdir>/vendor/<name>/`, writing
/// `<appdir>/loam.lock`.
///
/// A `path:../dir` source is copied locally, so a checkout with no network still
/// syncs; anything else is a git URL, cloned from the repo root and pinned to its
/// HEAD (or to `rev`) commit. One package failing does not stop the others — the
/// lock file is still written and the exit code says something went wrong.
fn pkg_sync(appdir: string) -> int {
    let deps = join(appdir, "loam.deps")
    if sys.exists(deps) == 0 {
        die("zeli: no loam.deps in {{appdir}}")
    }
    let vendor = join(appdir, "vendor")
    sys.mkdir(vendor)
    let mut lock = []string { "# Generated by `zeli pkg sync`. Do not edit." }
    let mut names = []string {}
    let mut ok = true
    let lines = split_lines(sys.read_file(deps))
    for i in 0..lines.len {
        let line = dep_line(lines[i])
        if line == "" {
            continue
        }
        let d = dep_of(line)
        if !valid_pkg_name(d.name) {
            die("zeli: bad package name '{{d.name}}'")
        }
        if index_of(names, d.name) >= 0 {
            die("zeli: duplicate package '{{d.name}}'")
        }
        push(names, d.name)
        let dest = join(vendor, d.name)
        if d.source == "" {
            say("zeli: {{d.name}}: missing source")
            ok = false
            continue
        }
        if starts_with(d.source, "path:") {
            let src = abs_path(join(appdir, slice(d.source, 5, d.source.len)))
            if sys.exists(src) == 0 {
                say("zeli: {{d.name}}: missing {{src}}")
                ok = false
                continue
            }
            sys.remove_path(dest)
            copy_tree(src, dest)
            push(lock, "{{d.name}}\t{{d.source}}\tlocal")
            say("zeli: {{d.name}} <- {{rel_to(repo_root(), src)}} (local)")
        } else {
            sys.remove_path(dest)
            let mut clone = "clone --quiet "
            clone = cat(cat(clone, shell_quote(d.source)), " ")
            clone = cat(clone, shell_quote(dest))
            let log = run_git(clone)
            if sys.exec_status() != 0 {
                say(cat(
                    cat(cat("zeli: ", d.name), ": git clone failed\n"),
                    indent_lines(trim(log), "  "),
                ))
                ok = false
                continue
            }
            if d.rev != "" {
                let mut co = cat("-C ", shell_quote(dest))
                co = cat(cat(cat(co, " checkout --quiet "), shell_quote(d.rev)), "")
                run_git(co)
                if sys.exec_status() != 0 {
                    say("zeli: {{d.name}}: cannot checkout '{{d.rev}}'")
                    ok = false
                }
            }
            let mut head = cat("-C ", shell_quote(dest))
            head = cat(head, " rev-parse HEAD")
            let sha = trim(run_git(head))
            push(lock, "{{d.name}}\t{{d.source}}\t{{sha}}")
            say("zeli: {{d.name}} <- {{d.source}}@{{short_sha(sha)}}")
        }
    }
    sys.write_file(join(appdir, "loam.lock"), join_lines(lock))
    if ok {
        return 0
    }
    return 1
}

// --- new: scaffold the app layout ---
//
// Byte-for-byte what `zeli new` writes from TypeScript, templates included.
// Every file that names the app interpolates it.

fn is_alpha(c: int) -> int {
    if c >= 97 && c <= 122 {
        return 1 /* a-z */
    }
    if c >= 65 && c <= 90 {
        return 1 /* A-Z */
    }
    return 0
}

fn is_digit(c: int) -> int {
    if c >= 48 && c <= 57 {
        return 1 /* 0-9 */
    }
    return 0
}

/// A legal app name: `[A-Za-z_][A-Za-z0-9_-]*`. It becomes a directory, a TOML
/// value and an identifier, so the rule is the strict one.
fn valid_name(name: string) -> bool {
    if name.len == 0 {
        return false
    }
    let c0 = name[0]
    if is_alpha(c0) == 0 {
        if c0 != 95 /* _ */ {
            return false
        }
    }
    for i in 1..name.len {
        let c = name[i]
        if is_alpha(c) == 1 || is_digit(c) == 1 {
            continue
        }
        if c == 95 || c == 45 {
            continue /* _ - */
        }
        return false
    }
    return true
}

/// One scaffolded file: where it goes, relative to the app directory, and its
/// whole contents. A vector of these rather than a map, which Loam has no need
/// of here — the order is the write order and only the count is reported.
struct ScaffoldFile {
    rel: string,
    body: string,
}

/// The tree `zeli new` writes: an entry for every host, the `routes/` tree the
/// router is generated from, a component, an RPC surface and a smoke test.
///
/// Every file that names the app interpolates it — `zeus.toml`, `app.loam`, the
/// root layout's nav and the welcome page. A template used to keep a literal
/// `myapp` there, which stayed invisible only because the one scaffolded app in
/// the tree is called `myapp`; the suite now checks the name lands.
fn scaffold_files(name: string) -> []ScaffoldFile {
    let mut out = []ScaffoldFile {}
    push(out, ScaffoldFile {
        rel: "zeus.toml",
        body: "name = \"{{name}}\"\ntargets = [\"web\", \"macos\", \"ios\"]\nroutes = \"routes\"\ntheme = \"theme.loam\"\nrevalidate = 60\n",
    })
    push(out, ScaffoldFile {
        rel: ".gitignore",
        body: ".zeus/\nbuild/\nvendor/\napp_routes.loam\n",
    })
    push(out, ScaffoldFile {
        rel: "app.loam",
        body: "//! {{name}} — application entry. One entry, every host.\n//!\n//! `zeli routes` generates app_routes.loam from routes/; this file\n//! mounts it. `zeli build` emits all five targets from here.\n\nimport \"std:zeus\"\nimport \"app_routes.loam\" as approutes\nimport \"server/api.loam\" as api\nimport \"tests/smoke.loam\" as smoketest\n\nfn main() {\n    zeus.App(\"{{name}}\", fn() {\n        approutes.app()\n    })\n}\n",
    })
    push(out, ScaffoldFile {
        rel: "theme.loam",
        body: "//! Theme tokens: palette roles. `zeus.theme(ROLE.X, light, dark)` sets\n//! both appearances; widgets resolve the role per appearance at paint time.\n\nimport \"std:zeus\"\n\nfn install() {\n    zeus.theme(ROLE.Accent, 0x2563EB, 0x60A5FA)\n    zeus.theme(ROLE.Paper, 0xFFFFFF, 0x111318)\n    zeus.theme(ROLE.Ink, 0x111318, 0xF3F4F6)\n}\n",
    })
    push(out, ScaffoldFile {
        rel: "routes/layout.loam",
        body: "//! Root shell: theme + nav. Retained across navigation, so its state\n//! survives — only the page slot rebuilds.\n\nimport \"std:zeus\"\nimport \"../theme.loam\" as theme\n\nfn Layout(build: fn()) -> Node {\n    theme.install()\n    return zeus.Box(style = Style(direction = Direction.Column, gap = 8, padding = 12)) {\n        zeus.Text(\"{{name}}\")\n        build()\n    }\n}\n",
    })
    push(out, ScaffoldFile {
        rel: "routes/page.loam",
        body: "import \"std:zeus\"\nimport \"std:router\"\nimport \"../components/card.loam\" as card\n\nfn Page(p: Params) -> Node {\n    return card.Card(\"Welcome to {{name}}.\")\n}\n\nfn meta(p: Params) -> Meta {\n    return Meta { title: \"{{name}}\", description: \"A Zeus app.\" }\n}\n",
    })
    push(out, ScaffoldFile {
        rel: "routes/loading.loam",
        body: "//! Shown while a route's loaders are pending.\n\nimport \"std:zeus\"\n\nfn Loading() -> Node {\n    return zeus.Text(\"loading...\")\n}\n",
    })
    push(out, ScaffoldFile {
        rel: "routes/error.loam",
        body: "//! Route error page. A trap in a page's build lands here (see zui.Boundary).\n\nimport \"std:zeus\"\n\nfn Error(msg: string) -> Node {\n    return zeus.Text(\"something went wrong\")\n}\n",
    })
    push(out, ScaffoldFile {
        rel: "routes/not-found.loam",
        body: "import \"std:zeus\"\n\nfn NotFound() -> Node {\n    return zeus.Text(\"not found\")\n}\n",
    })
    push(out, ScaffoldFile {
        rel: "routes/blog/layout.loam",
        body: "import \"std:zeus\"\n\nfn Layout(build: fn()) -> Node {\n    return zeus.Box(style = Style(direction = Direction.Column, gap = 4, padding = 8)) {\n        zeus.Text(\"blog\")\n        build()\n    }\n}\n",
    })
    push(out, ScaffoldFile {
        rel: "routes/blog/loader.loam",
        body: "//! Blog list query. Make `posts` a `#[server] fn` to fetch it from the\n//! backend; it stays a plain fn here so the scaffold runs on every host.\n\nfn posts() -> []string {\n    return []string { \"hello world\", \"second post\" }\n}\n",
    })
    push(out, ScaffoldFile {
        rel: "routes/blog/page.loam",
        body: "import \"std:zeus\"\nimport \"std:router\"\nimport \"loader.loam\" as blog_loader\n\nfn Page(p: Params) -> Node {\n    return zeus.Box(style = Style(direction = Direction.Column)) {\n        let ps = blog_loader.posts()\n        for i in 0..ps.len {\n            zeus.Text(ps[i])\n        }\n    }\n}\n\nfn meta(p: Params) -> Meta {\n    return Meta { title: \"Blog\" }\n}\n",
    })
    push(out, ScaffoldFile {
        rel: "routes/blog/[slug]/loader.loam",
        body: "//! One post by slug. In a real app this is\n//! `#[server] fn get_post(slug: string) -> Post`.\n\nfn get_post(slug: string) -> string {\n    return slug\n}\n",
    })
    push(out, ScaffoldFile {
        rel: "routes/blog/[slug]/page.loam",
        body: "import \"std:zeus\"\nimport \"std:router\"\nimport \"loader.loam\" as post_loader\n\nfn Page(p: Params) -> Node {\n    let slug = router.param(p, \"slug\")\n    return zeus.Text(post_loader.get_post(slug))\n}\n\n// Static routes are enumerated at build time from `paths()`.\nfn paths() -> []string {\n    return []string { \"/blog/hello-world\", \"/blog/second\" }\n}\n\nfn meta(p: Params) -> Meta {\n    return Meta { title: router.param(p, \"slug\") }\n}\n",
    })
    push(out, ScaffoldFile {
        rel: "routes/blog/[slug]/error.loam",
        body: "import \"std:zeus\"\n\nfn Error(msg: string) -> Node {\n    return zeus.Text(\"post not available\")\n}\n",
    })
    push(out, ScaffoldFile {
        rel: "routes/(marketing)/about/page.loam",
        body: "import \"std:zeus\"\nimport \"std:router\"\n\nfn Page(p: Params) -> Node {\n    return zeus.Text(\"about\")\n}\n\nfn meta(p: Params) -> Meta {\n    return Meta { title: \"About\" }\n}\n",
    })
    push(out, ScaffoldFile {
        rel: "routes/(marketing)/pricing/page.loam",
        body: "import \"std:zeus\"\nimport \"std:router\"\n\nfn Page(p: Params) -> Node {\n    return zeus.Text(\"pricing\")\n}\n\nfn meta(p: Params) -> Meta {\n    return Meta { title: \"Pricing\" }\n}\n",
    })
    push(out, ScaffoldFile {
        rel: "components/card.loam",
        body: "//! Shared component, no routing knowledge: a fn that builds into the\n//! current host.\n\nimport \"std:zeus\"\n\nfn Card(text: string) -> Node {\n    return zeus.Box(style = Style(gap = 4, padding = 12, background = \"#FFFFFF\")) {\n        zeus.Text(text)\n    }\n}\n",
    })
    push(out, ScaffoldFile {
        rel: "server/api.loam",
        body: "//! RPC surface: `#[proto]` contracts and `#[server]` fns. The entry\n//! imports this, so the same source compiles to a direct call on native\n//! and an RPC boundary on the client.\n\nimport \"std:http\"\n\n#[proto]\nstruct HelloReq {\n    name: string,\n}\n\n#[proto]\nstruct HelloResp {\n    greeting: string,\n}\n\n#[server]\nfn hello(req: HelloReq) -> HelloResp {\n    return HelloResp { greeting: req.name }\n}\n",
    })
    push(out, ScaffoldFile {
        rel: "server/db.loam",
        body: "//! Database access belongs here, behind `#[server]` fns so handles and\n//! secrets never reach a client binary.\n",
    })
    push(out, ScaffoldFile {
        rel: "assets/README.md",
        body: "# assets\n\nImages, fonts, and icons live here. `zeli build` will compile them into\ntyped handles (`assets.hero`) once the asset pipeline lands.\n",
    })
    push(out, ScaffoldFile {
        rel: "public/robots.txt",
        body: "User-agent: *\nAllow: /\n",
    })
    push(out, ScaffoldFile {
        rel: "tests/smoke.loam",
        body: "//! `#[test]` fns. Import this from the entry and run `loam test app.loam`.\n\nimport \"std:test\"\n\nfn add(a: int, b: int) -> int {\n    return a + b\n}\n\n#[test]\nfn adds() {\n    assert_eq_int(add(1, 2), 3)\n}\n",
    })
    return out
}

/// `zeli new <name> [dir]` — write the scaffold, then generate its route table,
/// because the entry imports `app_routes.loam` and a fresh app has to typecheck
/// under `loamc` (and the LSP) before anyone builds it.
///
/// Refuses a target that exists and holds anything: `zeli new` never merges
/// into an app it did not write.
fn scaffold(appdir: string, name: string) -> int {
    if !valid_name(name) {
        say("zeli: bad app name '{{name}}'")
        return 2
    }
    if sys.exists(appdir) == 1 {
        if sys.dir_count(appdir) > 0 {
            say("zeli: {{appdir}} already exists and is not empty")
            return 2
        }
    }
    let files = scaffold_files(name)
    for i in 0..files.len {
        let p = join(appdir, files[i].rel)
        let parent = dir_of(p)
        if parent != "" {
            sys.mkdir(parent)
        }
        sys.write_file(p, files[i].body)
    }
    if generate(appdir) == "" {
        return 2
    }
    let n = files.len + 1
    say("zeli: created {{name}} ({{n}} files)")
    say("  cd {{rel_to(sys.cwd(), appdir)}} && zeli serve")
    return 0
}

// --- build: targets, the compiler gate, and the web shell ---

/// The target names, in the order the TypeScript CLI lists them (`ALL_TARGETS`).
/// `server` is the native binary a backend runs, so five targets come out of one
/// entry.
fn all_targets() -> []string {
    return []string { "web", "macos", "ios", "android", "server" }
}

/// The same list as one string, for the `want ...` half of an error.
fn target_list() -> string {
    let ts = all_targets()
    let mut r = ""
    for i in 0..ts.len {
        if i > 0 {
            r = cat(r, ", ")
        }
        r = cat(r, ts[i])
    }
    return r
}

fn known_target(t: string) -> bool {
    let ts = all_targets()
    for i in 0..ts.len {
        if ts[i] == t {
            return true
        }
    }
    return false
}

/// The targets an app declares in `zeus.toml` (`targets = ["web", "macos"]`),
/// which is what `zeli build` builds when no `--targets` is given. Every target
/// comes out of the one entry, so declaring one is all it takes to get it; with
/// no `zeus.toml` or no `targets` line, all of them. An unknown name is fatal,
/// like a misspelt `--targets`.
fn app_targets(appdir: string) -> []string {
    let toml = sys.read_file(join(appdir, "zeus.toml"))
    let lines = split_on(toml, 10)
    for i in 0..lines.len {
        let l = trim(lines[i])
        if starts_with(l, "targets") {
            let eq = split_on(l, 61 /* = */ )
            if eq.len >= 2 {
                let mut names = []int {}
                let v = eq[1]
                for j in 0..v.len {
                    let c = v[j]
                    // Keep the names and their commas; drop brackets, quotes, spaces.
                    if c != 91 && c != 93 && c != 34 && c != 39 && c != 32 {
                        push(names, c)
                    }
                }
                return parse_targets(string_from_bytes(names), true)
            }
        }
    }
    return all_targets()
}

/// `--targets a,b` as a list. An unknown name is fatal; with no argument at all
/// every target is built.
fn parse_targets(arg: string, given: bool) -> []string {
    if !given {
        return all_targets()
    }
    let parts = split_on(arg, 44 /* , */ )
    let mut out = []string {}
    for i in 0..parts.len {
        let t = trim(parts[i])
        if !known_target(t) {
            die("zeli: unknown target '{{parts[i]}}' (want {{target_list()}})")
        }
        push(out, t)
    }
    return out
}

/// The extra `loamc` flags for a target: wasm for the browser, the two mobile
/// targets by name, and none at all for macos / server, which are native.
fn target_flags(t: string) -> string {
    if t == "web" {
        return "--target=wasm32"
    }
    if t == "ios" {
        return "--target=ios"
    }
    if t == "android" {
        return "--target=android"
    }
    return ""
}

/// What a target's build artifact is called: a `.wasm` module for the browser,
/// the entry's stem everywhere else.
fn out_name(t: string, stem: string) -> string {
    if t == "web" {
        return cat(stem, ".wasm")
    }
    return stem
}

// --- macos: an app bundle next to the binary ---
//
// A bare Mach-O opens in Terminal when double-clicked; Finder launches an app
// only from a `.app` bundle. So a macos build also writes
// `build/macos/<Title>.app`: Info.plist, the binary, an icon, an ad-hoc
// signature. From zeus.toml: `title` (bundle and menu name; default the
// capitalised `name`) and `bundle_id` (default `com.loam.<name>`). From the
// app dir: `assets/icon.icns`, or `assets/icon.svg` rendered with the system's
// own tools; `macos/Info.plist.part`, raw plist keys added to the dict (document
// types, usage strings).

/// A string setting from zeus.toml (`key = "value"`), or "".
fn toml_str(appdir: string, key: string) -> string {
    let lines = split_on(sys.read_file(join(appdir, "zeus.toml")), 10)
    for i in 0..lines.len {
        let kv = split_on(lines[i], 61 /* = */ )
        if kv.len >= 2 && trim(kv[0]) == key {
            let v = trim(kv[1])
            if v.len >= 2 && v[0] == 34 && v[v.len - 1] == 34 {
                return slice_str(v, 1, v.len - 1)
            }
            return v
        }
    }
    return ""
}

fn slice_str(s: string, a: int, b: int) -> string {
    let mut x = []int {}
    for i in a..b {
        push(x, s[i])
    }
    return string_from_bytes(x)
}

/// The app's display name: `title`, else `name` with its first letter raised.
fn bundle_title(appdir: string) -> string {
    let t = toml_str(appdir, "title")
    if t != "" {
        return t
    }
    let mut n = toml_str(appdir, "name")
    if n == "" {
        n = base_name(appdir)
    }
    let mut x = []int {}
    for i in 0..n.len {
        let c = n[i]
        push(x, if i == 0 && c >= 97 && c <= 122 { c - 32 } else { c })
    }
    return string_from_bytes(x)
}

fn bundle_id(appdir: string) -> string {
    let id = toml_str(appdir, "bundle_id")
    if id != "" {
        return id
    }
    let mut n = toml_str(appdir, "name")
    if n == "" {
        n = base_name(appdir)
    }
    let mut x = []int {}
    for i in 0..n.len {
        let c = n[i]
        if (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 45 {
            push(x, c)
        } else if c >= 65 && c <= 90 {
            push(x, c + 32)
        }
    }
    return cat("com.loam.", string_from_bytes(x))
}

/// AppKit draws an SVG into a transparent square PNG (macOS 14+ reads SVG).
/// Quick Look's thumbnailer would paint it on white, which shows in the Dock.
fn icon_render_js() -> string {
    return "ObjC.import('AppKit')\nfunction run(argv) {\n    var size = parseInt(argv[2], 10)\n    var img = $.NSImage.alloc.initWithContentsOfFile(argv[0])\n    if (!img || img.isNil()) { throw new Error('cannot read ' + argv[0]) }\n    var rep = $.NSBitmapImageRep.alloc.initWithBitmapDataPlanesPixelsWidePixelsHighBitsPerSampleSamplesPerPixelHasAlphaIsPlanarColorSpaceNameBytesPerRowBitsPerPixel(null, size, size, 8, 4, true, false, $.NSDeviceRGBColorSpace, 0, 0)\n    $.NSGraphicsContext.saveGraphicsState\n    $.NSGraphicsContext.setCurrentContext($.NSGraphicsContext.graphicsContextWithBitmapImageRep(rep))\n    img.drawInRectFromRectOperationFraction($.NSMakeRect(0, 0, size, size), $.NSZeroRect, $.NSCompositingOperationSourceOver, 1)\n    $.NSGraphicsContext.restoreGraphicsState\n    var png = rep.representationUsingTypeProperties($.NSBitmapImageFileTypePNG, $())\n    if (!png.writeToFileAtomically(argv[1], true)) { throw new Error('cannot write ' + argv[1]) }\n}\n"
}

/// `svg` → `.icns` at `out`: render at 1024, scale an iconset with `sips`,
/// pack it with `iconutil`. False (and no file) when any step fails.
fn render_icns(svg: string, out: string) -> bool {
    let work = trim(sys.exec("mktemp -d \"${TMPDIR:-/tmp}/zeli-icon.XXXXXX\""))
    if work == "" {
        return false
    }
    let js = join(work, "render.js")
    sys.write_file(js, icon_render_js())
    let png = join(work, "icon.png")
    let set = join(work, "icon.iconset")
    let mut script = "set -e; mkdir -p {{shell_quote(set)}}; osascript -l JavaScript {{shell_quote(js)}} {{shell_quote(svg)}} {{shell_quote(png)}} 1024 >/dev/null; "
    let sizes = []int { 16, 32, 128, 256, 512 }
    for i in 0..sizes.len {
        let s = sizes[i]
        let d = s * 2
        script = cat(
            script,
            "sips -z {{s}} {{s}} {{shell_quote(png)}} --out {{shell_quote(set)}}/icon_{{s}}x{{s}}.png >/dev/null; ",
        )
        script = cat(
            script,
            "sips -z {{d}} {{d}} {{shell_quote(png)}} --out {{shell_quote(set)}}/icon_{{s}}x{{s}}@2x.png >/dev/null; ",
        )
    }
    script = cat(script, "iconutil -c icns {{shell_quote(set)}} -o {{shell_quote(out)}}")
    sys.exec("sh -c {{shell_quote(script)}} 2>/dev/null")
    let ok = sys.exec_status() == 0 && sys.exists(out) == 1
    sys.exec("rm -rf {{shell_quote(work)}}")
    return ok
}

/// Wrap the macos binary `bin` into `build/macos/<Title>.app`; the bundle's
/// path, or "" when it could not be written.
fn macos_bundle(appdir: string, bin: string) -> string {
    let title = bundle_title(appdir)
    if title == "" {
        return ""
    }
    let app = join(join(join(appdir, "build"), "macos"), cat(title, ".app"))
    let contents = join(app, "Contents")
    let res = join(contents, "Resources")
    let macos = join(contents, "MacOS")
    let exe = join(macos, title)
    sys.exec(
        "rm -rf {{shell_quote(app)}} && mkdir -p {{shell_quote(macos)}} {{shell_quote(res)}} && cp {{shell_quote(bin)}} {{shell_quote(exe)}}",
    )
    if sys.exec_status() != 0 {
        return ""
    }
    sys.write_file(join(contents, "PkgInfo"), "APPL????")
    let mut icon_key = ""
    let icns = join(res, cat(title, ".icns"))
    let given = join(join(appdir, "assets"), "icon.icns")
    let svg = join(join(appdir, "assets"), "icon.svg")
    if sys.exists(given) == 1 {
        sys.exec("cp {{shell_quote(given)}} {{shell_quote(icns)}}")
    } else if sys.exists(svg) == 1 && !render_icns(svg, icns) {
        say("zeli: macos: could not render assets/icon.svg; the app has no icon")
    }
    if sys.exists(icns) == 1 {
        icon_key = "    <key>CFBundleIconFile</key><string>{{title}}</string>\n"
    }
    let part = join(join(appdir, "macos"), "Info.plist.part")
    let mut extra = ""
    if sys.exists(part) == 1 {
        extra = sys.read_file(part)
    }
    let mut version = toml_str(appdir, "version")
    if version == "" {
        version = "1.0"
    }
    let plist = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n    <key>CFBundleName</key><string>{{title}}</string>\n    <key>CFBundleDisplayName</key><string>{{title}}</string>\n    <key>CFBundleIdentifier</key><string>{{bundle_id(appdir)}}</string>\n    <key>CFBundleExecutable</key><string>{{title}}</string>\n    <key>CFBundlePackageType</key><string>APPL</string>\n    <key>CFBundleShortVersionString</key><string>{{version}}</string>\n    <key>CFBundleVersion</key><string>{{version}}</string>\n{{icon_key}}    <key>LSMinimumSystemVersion</key><string>11.0</string>\n    <key>NSHighResolutionCapable</key><true/>\n    <key>NSSupportsAutomaticGraphicsSwitching</key><true/>\n{{extra}}</dict>\n</plist>\n"
    let info = join(contents, "Info.plist")
    sys.write_file(info, plist)
    sys.exec("plutil -lint -s {{shell_quote(info)}}")
    if sys.exec_status() != 0 {
        say("zeli: macos: Info.plist is not valid (check macos/Info.plist.part)")
        return ""
    }
    // Ad-hoc: lets Gatekeeper and Apple silicon run the locally built bundle.
    sys.exec("codesign --force --sign - {{shell_quote(app)}} >/dev/null 2>&1")
    return app
}

/// `<appdir>/app.loam`, else `<appdir>/<dirname>.loam`, else `main.loam`.
fn find_entry(appdir: string) -> string {
    let base = base_name(appdir)
    let first = join(appdir, "app.loam")
    if sys.exists(first) == 1 {
        return first
    }
    let second = join(appdir, cat(base, ".loam"))
    if sys.exists(second) == 1 {
        return second
    }
    let third = join(appdir, "main.loam")
    if sys.exists(third) == 1 {
        return third
    }
    die("zeli: no entry .loam in {{appdir}} (looked for app.loam / {{base}}.loam / main.loam)")
    return ""
}

/// `loamc check <entry>` — the frontend only, no codegen.
///
/// Every command that runs or emits an app gates on this first, so a type error
/// fails once, up front, instead of once per target — or not at all when a
/// target's host toolchain is missing and its failure looks like the same thing.
fn check_entry(entry: string) -> bool {
    let out = run_loam("", cat("check ", shell_quote(entry)))
    if sys.exec_status() == 0 {
        return true
    }
    say("zeli: {{rel_to(repo_root(), entry)}} failed the compiler check")
    let body = trim(out)
    if body != "" {
        say(indent_lines(body, "  "))
    }
    return false
}

/// Remove `<appdir>/build/<target>` if a previous build left it, and make it
/// again empty, so nothing from an older build (a stale binary, a bundle, a
/// log) survives into this one. Only ever a directory under `build/`.
fn fresh_target_dir(appdir: string, target: string) -> string {
    let dir = join(join(appdir, "build"), target)
    if target != "" && sys.exists(dir) == 1 {
        if sys.remove_path(dir) != 0 {
            say("zeli: could not remove {{rel_to(repo_root(), dir)}}")
        } else {
            chat("zeli: removed previous {{rel_to(repo_root(), dir)}}")
        }
    }
    sys.mkdir(dir)
    return dir
}

/// `zeli build <appdir> [--targets web,macos,...] [--base https://host] [--release]`
///
/// Generates the route table when `routes/` exists, then compiles the app for
/// each target into `<appdir>/build/<target>/`, which is removed first when a
/// previous build left it. After a successful web build it
/// emits one HTML shell per route plus `sitemap.xml` / `robots.txt`.
///
/// Targets whose host toolchain is missing (iOS/Android SDKs) fail individually
/// and the rest still build, so one missing SDK does not cost you the others.
/// The exit code is 1 only when nothing built.
///
/// A routed web build reuses `serve`'s cached units and a lighter `wasm-opt`, so a
/// rebuild takes about a second or two. `--release` (`full`) is the smallest output
/// instead: one whole-program compile and `-Oz`, several times slower.
fn build(appdir: string, targets: []string, base: string, full: bool) -> int {
    if sys.exists(loam_path()) == 0 {
        die("zeli: missing {{loam_path()}} — run `make` in {{repo_root()}} first")
    }
    if sys.exists(join(appdir, "routes")) == 1 {
        if generate(appdir) == "" {
            return 2
        }
    }
    let entry = find_entry(appdir)
    if !check_entry(entry) {
        return 1
    }
    let stem = drop_suffix(base_name(entry), ".loam")
    let routed = sys.exists(join(appdir, "routes")) == 1
    ui_open(platform_list(targets), false)
    ui_build_begin()

    // Every compile runs at once, after which each target finishes in the order
    // it was asked for, so the report reads the same as a build done one by one.
    // Native targets with the same flags are one program: it is compiled once.
    let mut cmds = []string {}
    let mut job_of = []int {}
    let mut outs = []string {}
    let mut native = -1
    let mut native_report = ""
    let mut wants_web = false
    for i in 0..targets.len {
        let t = targets[i]
        let dir = fresh_target_dir(appdir, t)
        let out = join(dir, out_name(t, stem))
        push(outs, out)
        let mut flags = target_flags(t)
        let report = ui_report_file(appdir, t)
        if flags == "" && native >= 0 {
            let shared = job_of[native]
            push(job_of, shared)
            ui_add(t, native_report, shared, true, "Starting")
            continue
        }
        if flags == "" {
            native = i
            native_report = report
        }
        if t == "web" {
            wants_web = true
            flags = cat(flags, " --wasm-release")
            if routed {
                flags = cat(flags, " --wasm-split-input")
            }
            if !has_tool("wasm-opt") || !has_tool("wasm-split") {
                die("zeli: wasm-opt and wasm-split are needed for a web release: install binaryen.")
            }
        }
        let mut args = cat(cat(shell_quote(entry), " -o "), shell_quote(out))
        if flags != "" {
            args = cat(cat(flags, " "), args)
        }
        ui_add(t, report, cmds.len, true, "Starting")
        push(job_of, cmds.len)
        // A routed web build is optimized again after the split, so its compile
        // can come from cached units, as in `serve`. `--release` and anything else
        // ship what one whole-program compile leaves, which is smaller and slower.
        let compile_env = if t == "web" && routed && !full { shard_env(appdir) } else { "" }
        push(cmds, loam_cmd(ui_env(compile_env, report), args))
    }
    let meta_job = cmds.len
    if wants_web && routed {
        push(cmds, meta_compile_cmd(appdir))
        ui_bundle = ui_add("Bundle", "", meta_job, false, "Reading route metadata")
        ui_step(ui_bundle, 0, 20, "Reading route metadata")
    }
    let jobs = run_jobs(join(appdir, ".zeus"), cmds)

    let mut built = 0
    for i in 0..targets.len {
        let t = targets[i]
        let out = outs[i]
        let mut ok = jobs[job_of[i]].ok
        if ok && i != native && target_flags(t) == "" {
            sys.exec("cp {{shell_quote(outs[native])}} {{shell_quote(out)}}")
            ok = sys.exec_status() == 0
        }
        if ok {
            say("zeli: {{t}} ok -> {{rel_to(repo_root(), out)}}")
            built += 1
            if t == "web" && routed {
                require_meta(jobs[meta_job])
                let web = join(join(appdir, "build"), "web")
                emit_web_shell(appdir, split_web(appdir, web, stem, release_opt(full)), base)
                report_web_sizes(web)
                ui_bar_end(ui_bundle, UI_OK)
            }
            if t == "macos" && sys.target() == "native" && sys.exists("/usr/bin/codesign") == 1 {
                let bundle = macos_bundle(appdir, out)
                if bundle != "" {
                    say("zeli: macos app -> {{rel_to(repo_root(), bundle)}}")
                }
            }
        } else {
            let body = trim(jobs[job_of[i]].log)
            if body == "" {
                say("zeli: {{t}} failed")
            } else {
                say(cat("zeli: {{t}} failed\n", indent_lines(body, "  ")))
            }
        }
    }
    let n = targets.len
    say("zeli: built {{built}}/{{n}} target(s)")
    ui_stop_bars()
    let cheer = if built == n { " ✓" } else { " ✗" }
    ui_set_status("Built {{built}}/{{n}} targets{{cheer}}", built == 0, ui_build_ms())
    ui_close()
    if built > 0 {
        return 0
    }
    return 1
}

// --- web shell: one HTML file per route, plus sitemap + robots ---

/// One route's metadata, as the dump prints it. All strings — `collect_meta`
/// gives a missing or mistyped field the empty string, which is what every use
/// site here treats as "not set".
struct MetaRec {
    path: string,
    title: string,
    description: string,
    canonical: string,
    og_image: string,
    og_type: string,
    robots: string,
    jsonld: string,
    /// Index of the route that serves this URL.
    route: string,
    /// The page's text, from `zeus.engine_text_outline`.
    outline: string,
    /// The theme's page colour as packed rgb, for the first paint. "" = unknown.
    paper: string,
    /// The same colour in each appearance, for a visitor who chose one.
    paper_light: string,
    paper_dark: string,
}

/// The URLs one web build's shells point at.
struct WebAssets {
    wasm: string,
    loader: string,
    /// Route chunks, empty for an unsplit build.
    chunks: []ChunkFile,
    /// Chunk names each route needs, by route index.
    routes: [][]string,
    /// Chunks to fetch while the browser is idle, in order.
    idle: []string,
    /// Chunks a screen without hover fetches after those.
    idle_touch: []string,
}

struct ChunkFile {
    name: string,
    url: string,
}

/// The most page text a route's HTML carries, in bytes.
const MAX_PREPAINT: int = 40000

/// The metadata dump: a native Loam program that prints one JSON record per
/// concrete route URL by calling each route's `meta()` — and `paths()` for a
/// dynamic route, to find out which URLs it even has.
fn meta_dump_source() -> string {
    let mut lines = []string {}
    push(lines, "// Generated by `zeli build`. Do not edit.")
    push(lines, "import \"std:fmt\"")
    push(lines, "import \"std:json\"")
    push(lines, "import \"std:router\"")
    push(lines, "import \"std:zeus\"")
    push(lines, "import \"../app_routes.loam\" as approutes")
    push(lines, "")
    push(lines, "fn emit(path: string, route: int, m: Meta) {")
    push(lines, "    json.enc_obj_begin()")
    push(lines, "    json.enc_key(\"path\")")
    push(lines, "    json.enc_str(path)")
    push(lines, "    json.enc_key(\"title\")")
    push(lines, "    json.enc_str(m.title)")
    push(lines, "    json.enc_key(\"description\")")
    push(lines, "    json.enc_str(m.description)")
    push(lines, "    json.enc_key(\"canonical\")")
    push(lines, "    json.enc_str(m.canonical)")
    push(lines, "    json.enc_key(\"og_image\")")
    push(lines, "    json.enc_str(m.og_image)")
    push(lines, "    json.enc_key(\"og_type\")")
    push(lines, "    json.enc_str(m.og_type)")
    push(lines, "    json.enc_key(\"robots\")")
    push(lines, "    json.enc_str(m.robots)")
    push(lines, "    json.enc_key(\"jsonld\")")
    push(lines, "    json.enc_str(m.jsonld)")
    // The page itself, for the markup crawlers and screen readers get.
    push(lines, "    router.engine_open_url(path)")
    push(lines, "    zeus.pump_frame()")
    push(lines, "    zeus.pump_frame()")
    push(lines, "    json.enc_key(\"outline\")")
    push(lines, "    json.enc_str(zeus.engine_text_outline())")
    push(lines, "    json.enc_key(\"route\")")
    push(lines, cat(cat("    json.enc_str(\"", cat("{", "{")), "route}}\")"))
    push(lines, "    json.enc_key(\"paper\")")
    push(lines, "    let paper = zeus.engine_role_rgb(ROLE.Paper)")
    // `{` `{` apart: this line is text for the dump, not a value here.
    push(lines, cat(cat("    json.enc_str(\"", cat("{", "{")), "paper}}\")"))
    push(lines, "    json.enc_key(\"paper_light\")")
    push(lines, "    let light = zeus.engine_role_rgb_in(ROLE.Paper, 0)")
    push(lines, cat(cat("    json.enc_str(\"", cat("{", "{")), "light}}\")"))
    push(lines, "    json.enc_key(\"paper_dark\")")
    push(lines, "    let dark = zeus.engine_role_rgb_in(ROLE.Paper, 1)")
    push(lines, cat(cat("    json.enc_str(\"", cat("{", "{")), "dark}}\")"))
    push(lines, "    json.enc_obj_end()")
    push(lines, "    fmt.println(json.enc_take())")
    push(lines, "}")
    push(lines, "")
    push(lines, "fn main() {")
    // Mount the app once, off screen, so its own layout installs its theme and
    // `paper` below is the colour the first frame really paints.
    push(lines, "    zeus.snapshot(390, 844, fn() -> Node {")
    push(lines, "        return approutes.app()")
    push(lines, "    })")
    push(lines, "    let rs = approutes.routes()")
    push(lines, "    let mut i = 0")
    push(lines, "    while i < rs.len {")
    push(lines, "        let pat = rs[i].pattern")
    push(lines, "        if router.is_dynamic(pat) == 1 {")
    push(lines, "            let ps = rs[i].paths()")
    push(lines, "            let mut j = 0")
    push(lines, "            while j < ps.len {")
    push(lines, "                if router.match_route(pat, ps[j]) == 1 {")
    push(
        lines,
        "                    let p = Params { keys: router.match_keys(), vals: router.match_vals() }",
    )
    push(lines, "                    emit(ps[j], i, rs[i].meta(p))")
    push(lines, "                }")
    push(lines, "                j = j + 1")
    push(lines, "            }")
    push(lines, "        } else {")
    push(lines, "            let p = Params { keys: []string {}, vals: []string {} }")
    push(lines, "            emit(pat, i, rs[i].meta(p))")
    push(lines, "        }")
    push(lines, "        i = i + 1")
    push(lines, "    }")
    push(lines, "}")
    return join_lines(lines)
}

/// A string member of a parsed record, or `""` when the field is absent or is
/// not a string. `JSON.parse` gives the TypeScript CLI `undefined` for a missing
/// key, which reads the same way at every use site here.
fn fld(doc: JsonDoc, key: string) -> string {
    let v = json.field(doc.nodes, doc.root, key, key)
    if v.ok == 0 {
        return ""
    }
    let s = json.as_str(doc.nodes, v.id, key)
    if s.ok == 0 {
        return ""
    }
    return s.s
}

/// Write the dump's source and return the command that compiles it, to run
/// alongside the web build it describes.
///
/// The dump runs once on this machine and is thrown away, so it gets the
/// development profile even in a release: optimizing it costs more than the
/// wasm that ships.
fn meta_compile_cmd(appdir: string) -> string {
    let zdir = join(appdir, ".zeus")
    let src = join(zdir, "meta_dump.loam")
    sys.mkdir(zdir)
    sys.write_file(src, meta_dump_source())
    let bin = join(zdir, "meta_dump")
    /* The dump only *calls* meta()/paths(); a DCE edge case can drop a needed
       std:zeus helper while keeping its call, so compile it with DCE off. */
    return loam_cmd(
        "LOAM_DEV=1 LOAM_NO_DCE=1 {{shard_env(appdir)}}",
        cat(cat(shell_quote(src), " -o "), shell_quote(bin)),
    )
}

/// Abort the command if the dump did not compile.
fn require_meta(job: JobResult) {
    if !job.ok {
        die_extra("zeli: metadata dump failed to compile", trim(job.log))
    }
}

/// What the compiled dump printed, when it ran beside something else.
let mut meta_output: string = ""

/// The program `short_hash` runs, once it has looked.
let mut hash_tool: string = ""

/// The shell command that runs the compiled dump.
fn meta_run_cmd(appdir: string) -> string {
    let bin = join(join(appdir, ".zeus"), "meta_dump")
    return "cd {{shell_quote(repo_root())}} && ZEUS_HEADLESS=1 {{shell_quote(bin)}} 2>&1"
}

/// Run the compiled dump and return the records it printed. Aborts the command
/// on a run failure, exactly where the TypeScript CLI's `die` would.
fn collect_meta(appdir: string) -> []MetaRec {
    let mut log = meta_output
    meta_output = ""
    if log == "" {
        log = sys.exec(meta_run_cmd(appdir))
        if sys.exec_status() != 0 {
            die_extra("zeli: metadata dump failed to run", trim(log))
        }
    }
    let mut recs = []MetaRec {}
    let lines = split_lines(log)
    for i in 0..lines.len {
        let t = trim(lines[i])
        if !starts_with(t, "{") {
            continue
        }
        let doc = json.parse(t)
        if doc.ok == 0 {
            say("zeli: skipping malformed metadata record: {{t}}")
            continue
        }
        push(recs, MetaRec {
            path: fld(doc, "path"),
            title: fld(doc, "title"),
            description: fld(doc, "description"),
            canonical: fld(doc, "canonical"),
            og_image: fld(doc, "og_image"),
            og_type: fld(doc, "og_type"),
            robots: fld(doc, "robots"),
            jsonld: fld(doc, "jsonld"),
            route: fld(doc, "route"),
            outline: fld(doc, "outline"),
            paper: fld(doc, "paper"),
            paper_light: fld(doc, "paper_light"),
            paper_dark: fld(doc, "paper_dark"),
        })
    }
    return recs
}

/// A span of page text, as `engine_text_outline` reports it.
struct OutlineSpan {
    px: int,
    x: int,
    y: int,
    w: int,
    href: string,
    text: string,
}

/// Spans in reading order, top to bottom and then left to right. Icons are text
/// nodes holding SVG, with no font, and have no words to show.
fn outline_spans(outline: string) -> []OutlineSpan {
    let mut out = []OutlineSpan {}
    let lines = split_lines(outline)
    for i in 0..lines.len {
        let f = str.split(lines[i], "\t")
        if f.len < 6 || int_of(f[0]) <= 0 || starts_with(f[5], "<svg") {
            continue
        }
        let s = OutlineSpan {
            px: int_of(f[0]),
            x: int_of(f[1]),
            y: int_of(f[2]),
            w: int_of(f[3]),
            href: f[4],
            text: f[5],
        }
        push(out, s)
        let mut j = out.len - 1
        while j > 0 && (out[j - 1].y > s.y || (out[j - 1].y == s.y && out[j - 1].x > s.x)) {
            out[j] = out[j - 1]
            j = j - 1
        }
        out[j] = s
    }
    return out
}

/// The tag for a line of `px` type. Sizes, not roles: a page's headings are
/// drawn big whatever its components call them.
fn prepaint_tag(px: int) -> string {
    if px >= 28 {
        return "h1"
    }
    if px >= 20 {
        return "h2"
    }
    if px >= 16 {
        return "h3"
    }
    return "p"
}

/// A page's text as plain semantic markup, for crawlers and for screen readers
/// before the wasm has arrived. Spans on one line are joined, and a line built from several touching
/// spans is highlighted code, which keeps going through its single-span lines
/// (a comment) at the same size. Stops at `MAX_PREPAINT` bytes, as its weight is
/// on every first load.
fn prepaint_html(outline: string) -> string {
    let spans = outline_spans(outline)
    let mut out = []string {}
    let mut total = 0
    let mut code_px = 0
    let mut in_pre = false
    let mut i = 0
    while i < spans.len && total < MAX_PREPAINT {
        let first = spans[i]
        let mut line = first.text
        let mut end = first.x + first.w
        let mut touching = 0
        let mut j = i + 1
        while j < spans.len && spans[j].y == first.y {
            let gap = spans[j].x - end
            if gap > 1 {
                line = cat(line, " ")
            } else {
                touching = touching + 1
            }
            line = cat(line, spans[j].text)
            end = spans[j].x + spans[j].w
            j = j + 1
        }
        i = j
        if trim(line) == "" {
            continue
        }
        let code = touching > 0 || first.px == code_px
        if code && !in_pre {
            push(out, "<pre>")
            in_pre = true
            code_px = first.px
        }
        if !code && in_pre {
            push(out, "</pre>")
            in_pre = false
            code_px = 0
        }
        let text = esc(line)
        total = total + text.len
        if code {
            push(out, text)
        } else {
            let tag = prepaint_tag(first.px)
            let inner = if first.href != "" {
                "<a href=\"{{esc(first.href)}}\">{{text}}</a>"
            } else {
                text
            }
            push(out, "<{{tag}}>{{inner}}</{{tag}}>")
        }
    }
    if in_pre {
        push(out, "</pre>")
    }
    if out.len == 0 {
        return ""
    }
    return join_lines(out)
}

/// The stylesheet for `prepaint_html`. Hidden, not styled: only the canvas is
/// ever on screen, as unstyled text flashing up on each load looked like a broken
/// page. Crawlers and screen readers still read it.
fn prepaint_css() -> string {
    return "#zeus-prepaint{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}"
}

/// The `<head>` a crawler and a link preview read, then the canvas the wasm
/// module paints into. `canonical` arrives already resolved against `--base`.
fn shell_html(r: MetaRec, canonical: string, assets: WebAssets) -> string {
    let paper = css_hex(r.paper)
    let title = esc(r.title)
    let desc = esc(r.description)
    let canon = esc(canonical)
    let mut lines = []string {}
    push(lines, "<!DOCTYPE html>")
    let light = css_hex(r.paper_light)
    let dark = css_hex(r.paper_dark)
    push(lines, "<html lang=\"en\" data-paper-light=\"{{light}}\" data-paper-dark=\"{{dark}}\">")
    push(lines, "<head>")
    push(lines, "<meta charset=\"utf-8\" />")
    push(lines, "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />")
    push(lines, "<meta name=\"theme-color\" content=\"{{paper}}\" />")
    push(lines, appearance_script())
    push(lines, "<title>{{title}}</title>")
    // Starts the download now, not after `loader.js` has arrived and run. The
    // loader's own `fetch` picks up this response; `crossorigin` is what makes
    // the two requests match.
    push(lines, preload_link(assets.wasm))
    let boot = boot_chunks(r, assets)
    for i in 0..boot.len {
        push(lines, preload_link(chunk_url(assets, boot[i])))
    }
    push(lines, "<meta name=\"description\" content=\"{{desc}}\" />")
    push(lines, "<link rel=\"canonical\" href=\"{{canon}}\" />")
    push(lines, "<meta name=\"robots\" content=\"{{esc(r.robots)}}\" />")
    push(lines, "<meta property=\"og:type\" content=\"{{esc(r.og_type)}}\" />")
    push(lines, "<meta property=\"og:title\" content=\"{{title}}\" />")
    push(lines, "<meta property=\"og:description\" content=\"{{desc}}\" />")
    push(lines, "<meta property=\"og:url\" content=\"{{canon}}\" />")
    if r.og_image != "" {
        /* The TypeScript CLI resolves this against an empty base, which is the
           identity — the image is used as written. */
        let img = esc(r.og_image)
        push(lines, "<meta property=\"og:image\" content=\"{{img}}\" />")
        push(lines, "<meta name=\"twitter:card\" content=\"summary_large_image\" />")
        push(lines, "<meta name=\"twitter:title\" content=\"{{title}}\" />")
        push(lines, "<meta name=\"twitter:description\" content=\"{{desc}}\" />")
        push(lines, "<meta name=\"twitter:image\" content=\"{{img}}\" />")
    } else {
        push(lines, "<meta name=\"twitter:card\" content=\"summary\" />")
    }
    if r.jsonld != "" {
        push(lines, "<script type=\"application/ld+json\">")
        push(lines, r.jsonld)
        push(lines, "</script>")
    }
    push(
        lines,
        "<style>html,body{margin:0;height:100%;background:var(--zeus-paper,{{paper}})}canvas#zeus{display:block;position:fixed;inset:0;width:100%;height:100%;touch-action:none}</style>",
    )
    let prepaint = prepaint_html(r.outline)
    if prepaint != "" {
        push(lines, "<style>{{prepaint_css()}}</style>")
    }
    push(lines, "</head>")
    push(lines, "<body>")
    if prepaint != "" {
        push(lines, "<main id=\"zeus-prepaint\">")
        push(lines, prepaint)
        push(lines, "</main>")
    }
    push(lines, "<canvas id=\"zeus\" data-wasm=\"{{assets.wasm}}\"></canvas>")
    if assets.chunks.len > 0 {
        let table = chunk_table_json(assets, boot)
        push(lines, "<script type=\"application/json\" id=\"zeus-chunks\">{{table}}</script>")
    }
    push(lines, "<script src=\"{{assets.loader}}\"></script>")
    push(lines, "</body>")
    push(lines, "</html>")
    return join_lines(lines)
}

/// Packed rgb as `#rrggbb`, from the decimal string the metadata dump prints.
/// Anything else falls back to the plain light page.
fn css_hex(rgb: string) -> string {
    if rgb == "" {
        return "#fafafa"
    }
    let n = int_of(rgb)
    let digits = "0123456789abcdef"
    let mut out = []int { 35 }
    let mut shift = 20
    while shift >= 0 {
        push(out, digits[(n >> shift) & 15])
        shift = shift - 4
    }
    return string_from_bytes(out)
}

/// A routed web app with binaryen installed. Without it `zeli serve` still works,
/// as one module, and only a release insists.
fn can_split(appdir: string) -> bool {
    return sys.exists(join(appdir, "routes")) == 1 &&
        has_tool("wasm-opt") &&
        has_tool("wasm-split")
}

/// Paint a visitor's saved appearance before anything draws. Inline and ahead of
/// the first paint: anywhere later, a light-mode visitor sees dark on every load.
fn appearance_script() -> string {
    return "<script>try{var a=localStorage.getItem(\"zeus-appearance\"),r=document.documentElement,c=a===\"0\"?r.dataset.paperLight:a===\"1\"?r.dataset.paperDark:\"\";if(c){r.style.setProperty(\"--zeus-paper\",c);document.querySelector(\"meta[name=theme-color]\").content=c}}catch(e){}</script>"
}

/// The asset names `zeli serve` keeps when it cannot split.
fn plain_assets(stem: string) -> WebAssets {
    return WebAssets {
        wasm: "/{{stem}}.wasm",
        loader: "/loader.js",
        chunks: []ChunkFile {},
        routes: [][]string {},
        idle: []string {},
        idle_touch: []string {},
    }
}

fn has_tool(name: string) -> bool {
    sys.exec("command -v {{shell_quote(name)}} >/dev/null 2>&1")
    return sys.exec_status() == 0
}

/// First 12 hex digits of a file's SHA-256.
fn short_hash(file: string) -> string {
    return short_hashes(dir_of(file), []string { base_name(file) })[0]
}

/// `short_hash` of each of `names` under `dir`, in one process however many there
/// are. Relative, so a build's chunks fit in what `sys.exec` accepts.
fn short_hashes(dir: string, names: []string) -> []string {
    if hash_tool == "" {
        hash_tool = if has_tool("sha256sum") { "sha256sum" } else { "shasum -a 256" }
    }
    let mut args = ""
    for i in 0..names.len {
        args = cat(cat(args, " "), shell_quote(names[i]))
    }
    let ls = split_lines(trim(sys.exec("cd {{shell_quote(dir)}} && {{hash_tool}}{{args}}")))
    if sys.exec_status() != 0 || ls.len != names.len {
        die("zeli: could not hash the files in {{dir}}")
    }
    let mut out = []string {}
    for i in 0..ls.len {
        push(out, slice(ls[i], 0, 12))
    }
    return out
}

/// Move one build output into `dir` under its content hash and return its
/// final name.
fn fingerprint_file(src: string, dir: string, stem: string, ext: string) -> string {
    return fingerprint_as(src, dir, stem, short_hash(src), ext)
}

/// `fingerprint_file` for a hash already known.
fn fingerprint_as(src: string, dir: string, stem: string, hash: string, ext: string) -> string {
    let name = "{{stem}}.{{hash}}.{{ext}}"
    let dst = join(dir, name)
    if sys.rename(src, dst) != 0 {
        die("zeli: could not write {{dst}}")
    }
    return name
}

/// What a static host needs to cache a release: the hashed assets for a year,
/// since a new build gets new names, and every page checked each visit.
fn web_headers() -> string {
    let mut lines = []string {}
    push(lines, "/_zeus/*")
    push(lines, "  Cache-Control: public, max-age=31536000, immutable")
    push(lines, "/*")
    push(lines, "  X-Content-Type-Options: nosniff")
    return join_lines(lines)
}

fn preload_link(url: string) -> string {
    return "<link rel=\"preload\" href=\"{{url}}\" as=\"fetch\" type=\"application/wasm\" crossorigin=\"anonymous\" />"
}

/// The chunks a page needs before its first frame.
fn boot_chunks(r: MetaRec, assets: WebAssets) -> []string {
    let route = int_of(r.route)
    if r.route == "" || route >= assets.routes.len {
        return []string {}
    }
    return assets.routes[route]
}

fn chunk_url(assets: WebAssets, name: string) -> string {
    for i in 0..assets.chunks.len {
        if assets.chunks[i].name == name {
            return assets.chunks[i].url
        }
    }
    return ""
}

fn json_names(names: []string) -> string {
    let mut out = "["
    for i in 0..names.len {
        let sep = if i > 0 { "," } else { "" }
        let n = names[i]
        out = "{{out}}{{sep}}\"{{n}}\""
    }
    return cat(out, "]")
}

/// What the loader needs in order to find a route's chunks, inline so that it
/// costs no request.
fn chunk_table_json(assets: WebAssets, boot: []string) -> string {
    let mut urls = ""
    for i in 0..assets.chunks.len {
        let sep = if i > 0 { "," } else { "" }
        let name = assets.chunks[i].name
        let url = assets.chunks[i].url
        urls = "{{urls}}{{sep}}\"{{name}}\":\"{{url}}\""
    }
    let mut routes = ""
    for i in 0..assets.routes.len {
        let sep = if i > 0 { "," } else { "" }
        let r = json_names(assets.routes[i])
        routes = "{{routes}}{{sep}}{{r}}"
    }
    let bootj = json_names(boot)
    let idlej = json_names(assets.idle)
    let touchj = json_names(assets.idle_touch)
    return cat(
        cat("{\"chunks\":{", urls),
        "},\"routes\":[{{routes}}],\"boot\":{{bootj}},\"idle\":{{idlej}},\"idleTouch\":{{touchj}}}",
    )
}

/// The generated route table's builders, in route order (`b_root_page`, ...).
fn route_builders(appdir: string) -> []string {
    let lines = split_lines(sys.read_file(join(appdir, "app_routes.loam")))
    let mut out = []string {}
    for i in 0..lines.len {
        let t = trim(lines[i])
        if !starts_with(t, "Route {") {
            continue
        }
        let parts = split_on(t, 44 /* , */ )
        for j in 0..parts.len {
            let kv = split_on(parts[j], 58 /* : */ )
            if kv.len == 2 && trim(kv[0]) == "build" {
                push(out, trim(kv[1]))
            }
        }
    }
    return out
}

/// The C the runtime and the web host are written in. The names it uses are the
/// entry points into Loam code.
fn runtime_sources() -> string {
    let rt = join(repo_root(), "packages/loam/runtime")
    let web = join(repo_root(), "packages/zeus/hosts/web")
    let files = []string {
        join(rt, "zeus_plat.c"),
        join(rt, "zeus_key.c"),
        join(rt, "zeus_rt.h"),
        join(web, "wasm.c"),
    }
    let mut out = ""
    for i in 0..files.len {
        out = cat(out, sys.read_file(files[i]))
    }
    return out
}

/// Split a `--wasm-split-input` build into a primary and route chunks, optimise
/// each, and fingerprint them all. Optimising after the split matters: run first,
/// `wasm-opt` merges identical functions, which ties routes to each other.
///
/// `dev` keeps the split and drops `-Oz`: the chunks and the Network tab match a
/// release, a little larger, for a tenth of the time.
fn split_web(appdir: string, web: string, stem: string, opt_flag: string) -> WebAssets {
    let raw = join(web, "{{stem}}.wasm")
    let csrc = cat(raw, ".c")
    let dir = join(web, "_zeus")
    let tmp = join(web, ".split")
    sys.mkdir(dir)
    sys.mkdir(tmp)

    ui_step(ui_bundle, 20, 25, "Planning route chunks")
    let mut g = chunks.parse_c(sys.read_file(csrc))
    let roots = chunks.roots_of(&mut g, runtime_sources())
    let builders = route_builders(appdir)
    let mut entries = []int {}
    for i in 0..builders.len {
        let f = chunks.find_suffix(&g, builders[i])
        if f < 0 {
            die("zeli: no function for route builder {{builders[i]}}")
        }
        push(entries, f)
    }
    let plan = chunks.plan(&g, roots, entries, chunks.MIN_CHUNK_C)

    let man = join(tmp, "manifest.txt")
    sys.write_file(man, chunks.manifest(&g, &plan))
    let features = "--enable-bulk-memory --enable-mutable-globals --enable-sign-ext --enable-nontrapping-float-to-int --enable-reference-types --enable-multivalue"
    let prim = join(tmp, "primary.wasm")
    let prefix = shell_quote(cat(tmp, "/"))
    ui_step(ui_bundle, 25, 40, "Splitting wasm")
    // The page dump depends on none of this, and `wasm-opt` wants every core.
    let split = run_jobs(tmp, []string {
        meta_run_cmd(appdir),
        "wasm-split --multi-split {{features}} --manifest {{shell_quote(man)}} --out-prefix {{prefix}} --export-prefix=% --placeholder-namespace-prefix=p. -g -o {{shell_quote(prim)}} {{shell_quote(raw)}} 2>&1",
    })
    if !split[0].ok {
        die_extra("zeli: metadata dump failed to run", trim(split[0].log))
    }
    if !split[1].ok {
        die_extra("zeli: wasm-split failed", trim(split[1].log))
    }
    meta_output = split[0].log

    let mut files = []ChunkFile {}
    let mut names = []string { "primary" }
    for i in 0..plan.chunks.len {
        push(names, plan.chunks[i].name)
    }
    let mut opts = []string {}
    for i in 0..names.len {
        let src = join(tmp, "{{names[i]}}.wasm")
        let opt = cat(src, ".opt")
        push(
            opts,
            "wasm-opt {{opt_flag}}--strip-debug --strip-producers {{features}} {{shell_quote(src)}} -o {{shell_quote(opt)}} 2>&1",
        )
    }
    ui_step(ui_bundle, 40, 92, "Optimizing wasm")
    ui_counting = "Optimizing wasm"
    let optimised = run_jobs(tmp, opts)
    ui_counting = ""
    let mut primary = ""
    let mut sizes = []int {}
    let mut outputs = []string {}
    for i in 0..names.len {
        if !optimised[i].ok {
            die_extra("zeli: wasm-opt failed on {{names[i]}}", trim(optimised[i].log))
        }
        push(outputs, "{{names[i]}}.wasm.opt")
    }
    let hashes = short_hashes(tmp, outputs)
    for i in 0..names.len {
        let opt = join(tmp, outputs[i])
        let file = fingerprint_as(opt, dir, if i == 0 { stem } else { names[i] }, hashes[i], "wasm")
        if i == 0 {
            primary = "/_zeus/{{file}}"
        } else {
            push(files, ChunkFile { name: names[i], url: "/_zeus/{{file}}" })
            push(sizes, sys.read_file(join(dir, file)).len)
        }
    }

    let mut routes = [][]string {}
    for r in 0..plan.route_chunks.len {
        let mut mine = []string {}
        let cs = plan.route_chunks[r]
        for j in 0..cs.len {
            push(mine, plan.chunks[cs[j]].name)
        }
        push(routes, mine)
    }
    let mut idle = []string {}
    let picked = chunks.idle_chunks(&plan, sizes)
    for i in 0..picked.len {
        push(idle, plan.chunks[picked[i]].name)
    }
    let mut idle_touch = []string {}
    let extra = chunks.touch_chunks(&plan, sizes, picked)
    for i in 0..extra.len {
        push(idle_touch, plan.chunks[extra[i]].name)
    }
    sys.exec("rm -rf {{shell_quote(tmp)}} {{shell_quote(raw)}} {{shell_quote(csrc)}}")
    return finish_web(web, primary, files, routes, idle, idle_touch)
}

/// Fingerprint the loader and write the files a static host reads.
fn finish_web(
    web: string,
    wasm: string,
    files: []ChunkFile,
    routes: [][]string,
    idle: []string,
    idle_touch: []string
) -> WebAssets {
    let loader = fingerprint_file(join(web, "loader.js"), join(web, "_zeus"), "loader", "js")
    sys.write_file(join(web, "_headers"), web_headers())
    // GitHub Pages hides `_` directories unless this file exists.
    sys.write_file(join(web, ".nojekyll"), "")
    return WebAssets {
        wasm: wasm,
        loader: "/_zeus/{{loader}}",
        chunks: files,
        routes: routes,
        idle: idle,
        idle_touch: idle_touch,
    }
}

/// `wasm-opt`'s level for `zeli build`. Most of what `-Oz` removes is gone at `-O1`
/// for a third of the time; `--release` asks for the rest.
fn release_opt(full: bool) -> string {
    return if full { "-Oz " } else { "-O1 " }
}

/// One size in KB, for the build report.
fn kb_of(file: string) -> string {
    if sys.exists(file) == 0 {
        return "-"
    }
    let n = sys.read_file(file).len
    return "{{(n + 512) / 1024}} KB"
}

/// What a visitor actually downloads, per file.
fn report_web_sizes(web: string) {
    let dir = join(web, "_zeus")
    let names = sys.list_dir(dir)
    chat("zeli: web assets")
    for i in 0..names.len {
        chat("  {{names[i]}}  {{kb_of(join(dir, names[i]))}}")
    }
}

/// The panel's name for a set of targets.
fn platform_list(targets: []string) -> string {
    let mut out = ""
    for i in 0..targets.len {
        out = cat(out, cat(if i > 0 { ", " } else { "" }, platform_name(targets[i])))
    }
    return out
}

/// One HTML file per route, plus `sitemap.xml` and `robots.txt`.
///
/// The route table is the source of the URLs: a static route contributes its
/// pattern, and a dynamic one contributes each entry of its `paths()`. A route
/// with no `meta()` still gets a shell, from the empty record. The metadata dump
/// must already be compiled (`meta_compile_cmd`).
fn emit_web_shell(appdir: string, assets: WebAssets, base: string) {
    ui_step(ui_bundle, 92, 100, "Writing HTML shells")
    let web = join(join(appdir, "build"), "web")
    sys.mkdir(web)
    let recs = collect_meta(appdir)
    let mut urls = []string {}
    for i in 0..recs.len {
        let r = recs[i]
        let mut clean = r.canonical
        if clean == "" {
            clean = r.path
        }
        let canon = canonical_url(base, clean)
        let rel = strip_slash(strip_lead_slash(r.path))
        let mut dir = web
        if rel != "" {
            dir = join(web, rel)
            sys.mkdir(dir)
        }
        sys.write_file(join(dir, "index.html"), shell_html(r, canon, assets))
        push(urls, canon)
    }
    let mut sm = []string {}
    push(sm, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>")
    push(sm, "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">")
    for i in 0..urls.len {
        push(sm, "  <url><loc>{{esc(urls[i])}}</loc></url>")
    }
    push(sm, "</urlset>")
    sys.write_file(join(web, "sitemap.xml"), join_lines(sm))
    let mut robots = []string {}
    push(robots, "User-agent: *")
    push(robots, "Allow: /")
    if base != "" {
        push(robots, "Sitemap: {{strip_slash(base)}}/sitemap.xml")
    }
    sys.write_file(join(web, "robots.txt"), join_lines(robots))
    let n = recs.len
    chat(
        "zeli: wrote {{n}} HTML shell(s) + sitemap.xml + robots.txt -> {{rel_to(repo_root(), web)}}",
    )
}

fn usage() {
    say(
        "usage: zeli new <name> [dir] | zeli routes <appdir> | zeli build <appdir> [--targets a,b | --target a] [--base https://host] [--release] | zeli serve <appdir> [--target {{target_list()}}] [--port N] [--build-only] | zeli fmt [dir] | zeli pkg sync <appdir>",
    )
}

fn main() {
    let argv = sys.args()
    if argv.len < 2 {
        usage()
        sys.exit(2)
    }
    let cmd = argv[1]
    if cmd == "new" {
        if argv.len < 3 {
            usage()
            sys.exit(2)
        }
        let name = argv[2]
        let mut dir = name
        if argv.len > 3 {
            dir = argv[3]
        }
        sys.exit(scaffold(abs_path(dir), name))
    }
    if cmd == "serve" {
        let mut port = 5173
        let mut build_only = false
        let mut target = "web"
        let mut rest = []string {}
        let mut i = 2
        while i < argv.len {
            let a = argv[i]
            if a == "--port" {
                if i + 1 >= argv.len {
                    die("zeli: --port needs a number")
                }
                i += 1
                port = int_of(argv[i])
                if port < 0 {
                    die("zeli: --port wants a number, got '{{argv[i]}}'")
                }
            } else {
                if a == "--target" {
                    if i + 1 >= argv.len {
                        die("zeli: --target needs a name (want {{target_list()}})")
                    }
                    i += 1
                    target = argv[i]
                    if !known_target(target) {
                        die("zeli: unknown target '{{target}}' (want {{target_list()}})")
                    }
                } else {
                    if a == "--build-only" {
                        build_only = true
                    } else {
                        push(rest, a)
                    }
                }
            }
            i += 1
        }
        let mut dir = "."
        if rest.len > 0 {
            dir = rest[0]
        }
        sys.exit(serve(abs_path(dir), target, port, build_only))
    }
    if cmd == "fmt" {
        let mut dir = "."
        if argv.len > 2 {
            dir = argv[2]
        }
        sys.exit(fmt(dir))
    }
    if cmd == "routes" {
        if argv.len < 3 {
            usage()
            sys.exit(2)
        }
        sys.exit(routes(argv[2]))
    }
    if cmd == "build" {
        let mut targets = all_targets()
        let mut given = false
        let mut base = ""
        let mut full = false
        let mut rest = []string {}
        let mut i = 2
        while i < argv.len {
            let a = argv[i]
            if a == "--release" {
                full = true
            } else if a == "--targets" || a == "--target" {
                if i + 1 < argv.len {
                    i += 1
                    targets = parse_targets(argv[i], true)
                } else {
                    targets = parse_targets("", false)
                }
                given = true
            } else {
                if a == "--base" {
                    if i + 1 < argv.len {
                        i += 1
                        base = argv[i]
                    }
                } else {
                    push(rest, a)
                }
            }
            i += 1
        }
        if rest.len < 1 {
            die(
                "usage: zeli build <appdir> [--targets a,b | --target a] [--base https://host] [--release]",
            )
        }
        let appdir = abs_path(rest[0])
        if !given {
            targets = app_targets(appdir)
        }
        sys.exit(build(appdir, targets, base, full))
    }
    if cmd == "pkg" {
        if argv.len < 3 || argv[2] != "sync" {
            usage()
            sys.exit(2)
        }
        let mut dir = "."
        if argv.len > 3 {
            dir = argv[3]
        }
        sys.exit(pkg_sync(abs_path(dir)))
    }
    fmt.println("zeli: unknown command", cmd)
    usage()
    sys.exit(2)
}
