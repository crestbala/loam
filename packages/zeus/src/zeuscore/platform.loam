    return js_chunks_ready(index)
}

#[os("posix", "windows")]
fn chunks_ready_os(index: int) -> int {
    return 1
}

#[os("wasm")]
fn chunks_load_os(index: int) {
    js_chunks_load(index)
}

#[os("posix", "windows")]
fn chunks_load_os(index: int) {
    return
}

#[os("wasm")]
fn chunks_preload_os(index: int) {
    js_chunks_preload(index)
}

#[os("posix", "windows")]
fn chunks_preload_os(index: int) {
    return
}

#[os("wasm")]
fn appearance_load_os() -> int {
    return js_appearance_load()
}

#[os("posix", "windows")]
fn appearance_load_os() -> int {
    return -1
}

#[os("wasm")]
fn appearance_save_os(dark: int) {
    js_appearance_save(dark)
}

#[os("posix", "windows")]
fn appearance_save_os(dark: int) {
    return
}

#[os("wasm")]
fn track_start_os(endpoint: string, local: int) {
    js_track_start(endpoint, local)
}

#[os("posix", "windows")]
fn track_start_os(endpoint: string, local: int) {
    return
}

#[os("wasm")]
fn track_send_os(kind: int, name: string, data: string) {
    js_track_send(kind, name, data)
}

#[os("posix", "windows")]
fn track_send_os(kind: int, name: string, data: string) {
