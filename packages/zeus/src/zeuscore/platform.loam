#[os("wasm")]
fn track_opt_out_os(off: int) {
    js_track_opt_out(off)
}

#[os("posix", "windows")]
fn track_opt_out_os(off: int) {
    return
}

#[os("wasm")]
fn track_opted_out_os() -> int {
    return js_track_opted_out()
}

#[os("posix", "windows")]
fn track_opted_out_os() -> int {
    return 0
}

/** *A browser has no environment to ask. */
#[os("wasm")]
fn layout_verify_os() -> int {
    return 0
}

/** *-1 until `layout_verify_os` first reads the environment. */
let mut layout_verify_state: int = -1

#[os("posix", "windows")]
fn layout_verify_os() -> int {
    if layout_verify_state < 0 {
        layout_verify_state = if sys.env("ZEUS_LAYOUT_VERIFY") == "1" { 1 } else { 0 }
    }
    return layout_verify_state
}

#[os("wasm")]
fn open_external_os(url: string) {
    js_open_external(url)
}

#[os("posix", "windows")]
fn open_external_os(url: string) {
    return
}

/** *The longest start path the browser's is read up to. */
const BOOT_PATH_CAP: int = 2048

#[os("wasm")]
fn boot_path_os() -> string {
    let mut path = buf.with_len(BOOT_PATH_CAP)
    let got = js_boot_path(&mut path, path.len)
    if got <= 0 {
        return ""
    }
    return buf.prefix_to_string(&path, got)
}

#[os("posix", "windows")]
fn boot_path_os() -> string {
    return ""
}

