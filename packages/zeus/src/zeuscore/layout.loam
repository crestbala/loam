// layout — measure + flex/grid/absolute (GPUI taffy.rs).
//
// Kind 11 (`scroll`): children are not shrunk on the block axis, so extra
// height becomes `scroll_y`. Horizontal overflow is off unless `overflow` is
// auto (3 / `scroll_xy`): then children keep intrinsic width and `scroll_x`
// can move. Page containers use vertical-only so they never grow an H bar.

import "arena.loam"
import "nodes.loam"
import "geometry.loam"
import "platform.loam"
import "metrics.loam"

fn flex_grow_shrink(id: int, extra: int, row: int) -> int {
    let nk = nodes.tree[id].kids.len
    if extra == 0 {
        return 0
    }
    if extra > 0 {
        let mut growsum = 0
        for i in 0..nk {
            let c = nodes.tree[id].kids[i]
            if arena.skip_flow(c) == 0 {
                if nodes.axis_frozen(c, row) == 0 {
                    if nodes.lay[c].grow > 0 {
                        growsum = growsum + nodes.lay[c].grow
                    }
                }
            }
        }
        if growsum <= 0 {
            return extra
        }
        let mut left = extra
        let mut last = -1
        for i in 0..nk {
            let c = nodes.tree[id].kids[i]
            if arena.skip_flow(c) == 0 {
                if nodes.axis_frozen(c, row) == 0 {
                    if nodes.lay[c].grow > 0 {
                        let add = extra * nodes.lay[c].grow / growsum
                        arena.size_buffer[i] = arena.size_buffer[i] + add
                        left = left - add
                        last = i
                    }
                }
            }
        }
        if last >= 0 {
            arena.size_buffer[last] = arena.size_buffer[last] + left
            return 0
        }
        return extra
    }
    let mut shrinksum = 0
    for i in 0..nk {
        let c = nodes.tree[id].kids[i]
        if arena.skip_flow(c) == 0 {
            if nodes.axis_frozen(c, row) == 0 {
                if nodes.lay[c].shrink > 0 {
                    if arena.size_buffer[i] > 0 {
                        shrinksum = shrinksum + nodes.lay[c].shrink
                    }
                }
            }
        }
    }
    if shrinksum <= 0 {
        return extra
    }
    let need = -extra
    let mut left = need
    for i in 0..nk {
        let c = nodes.tree[id].kids[i]
        if arena.skip_flow(c) == 0 {
            if nodes.axis_frozen(c, row) == 0 {
                if nodes.lay[c].shrink > 0 {
                    if arena.size_buffer[i] > 0 {
                        let cut = need * nodes.lay[c].shrink / shrinksum
                        if cut > arena.size_buffer[i] {
                            left = left - arena.size_buffer[i]
                            arena.size_buffer[i] = 0
                        } else {
                            arena.size_buffer[i] = arena.size_buffer[i] - cut
                            left = left - cut
                        }
                    }
                }
            }
        }
    }
    return -left
}

fn apply_input_wrap(id: int) {
    if int(nodes.tree[id].kind) != 10 {
        return
    }
    if int(nodes.lay[id].wrap) == 0 {
        return
    }
    let inner = arena.inner_w(id)
    if inner <= 0 {
        return
    }
    let mut ww = 0
    let mut hh = 0
    metrics.measure_wrap(arena.input_shown(id), i32(nodes.look[id].font), inner, &mut ww, &mut hh)
    let need = hh + nodes.box_pad_y(id)
    if need > nodes.box[id].h {
        nodes.box[id].h = arena.clamp_h(id, need)
    }
}

fn apply_label_wrap(id: int) {
    if int(nodes.tree[id].kind) != 3 {
        return
    }
    if int(nodes.look[id].ellipsis) != 0 {
        // A truncating label stays on one line; paint ellipsizes it.
        return
    }
    if nodes.has_bound_num(id) != 0 {
        return
    }
    let inner = arena.inner_w(id)
    if inner <= 0 {
        return
    }
    if inner >= nodes.box[id].text_width {
        return
    }
    /* A squeezed label in a flex row must not grow to two lines under siblings. */
    if int(nodes.lay[id].wrap) == 0 {
        let p = nodes.tree[id].parent
        if p > 0 {
            if int(nodes.lay[p].dir) == 0 {
                if int(nodes.tree[p].kind) == 1 {
                    return
                }
            }
        }
    }
    let mut ww = 0
    let mut hh = 0
    metrics.measure_wrap(nodes.look[id].text, i32(nodes.look[id].font), inner, &mut ww, &mut hh)
    nodes.lay[id].wrap = 1
    let need = hh + nodes.box_pad_y(id)
    if need > nodes.box[id].h {
        nodes.box[id].h = arena.clamp_h(id, need)
    }
}

fn grow_to_children(id: int) {
    let nk = nodes.tree[id].kids.len
    let mut max_b = 0
    for i in 0..nk {
        let c = nodes.tree[id].kids[i]
        if arena.skip_flow(c) == 0 {
            let b = nodes.box[c].y + nodes.box[c].h + nodes.pin[c].m_b - nodes.box[id].y
            if b > max_b {
                max_b = b
            }
        }
    }
    let mut need = max_b + i32(nodes.lay[id].pad_b) + i32(nodes.lay[id].border_w)
    if nodes.lay[id].explicit_height >= 0 {
        if need < nodes.lay[id].explicit_height {
            need = nodes.lay[id].explicit_height
        }
    }
    if need > nodes.box[id].h {
        nodes.box[id].h = need
    }
}

fn stretch_cross(p: int, c: int, row: int) -> int {
    if row != 0 {
        if nodes.has_h(c) != 0 {
            return 0
        }
    } else {
        if nodes.has_w(c) != 0 {
            return 0
        }
    }
    let al = nodes.child_align(p, c)
    if al == 6 {
        return 1
    }
    return 0
}

fn measure_text(id: int) {
    let mut text_width = 0
    let mut text_height = 0
    if nodes.has_bound_num(id) != 0 {
        metrics.measure_int(
            arena.bound_num(id),
            i32(nodes.look[id].font),
            &mut text_width,
            &mut text_height,
        )
    } else if int(nodes.tree[id].kind) == 10 {
        metrics.measure(
            arena.input_shown(id),
            i32(nodes.look[id].font),
            &mut text_width,
            &mut text_height,
        )
    } else {
        metrics.measure(
            nodes.look[id].text,
            i32(nodes.look[id].font),
            &mut text_width,
            &mut text_height,
        )
    }
    nodes.box[id].text_width = text_width
    nodes.box[id].text_height = text_height
}

fn measure_node(id: int) {
    if id <= 0 {
        return
    }
    // Skip a subtree whose measure is already current: a write invalidates only
    // the path it touched (`nodes.invalidate_path`), so an unchanged sibling — or
    // a whole clean subtree — is not re-measured.
    if nodes.box[id].measure_stamp == arena.measure_gen {
        return
    }
    nodes.box[id].measure_stamp = arena.measure_gen
    measure_visits = measure_visits + 1
    if arena.want_show(id) == 0 {
        nodes.box[id].inner_width = 0
        nodes.box[id].inner_height = 0
        return
    }
    let k = int(nodes.tree[id].kind)
    let nk = nodes.tree[id].kids.len
    if k == 3 {
        measure_text(id)
        let mut inner_width = nodes.box[id].text_width + nodes.box_pad_x(id)
        let mut inner_height = nodes.box[id].text_height + nodes.box_pad_y(id)
        if nodes.lay[id].explicit_width >= 0 {
            inner_width = nodes.lay[id].explicit_width
        }
        if nodes.lay[id].explicit_height >= 0 {
            inner_height = nodes.lay[id].explicit_height
        }
        nodes.box[id].inner_width = arena.clamp_w(id, inner_width)
        nodes.box[id].inner_height = arena.clamp_h(id, inner_height)
        return
    }
    if k == 4 {
        measure_text(id)
        let mut inner_width = nodes.box[id].text_width + i32(nodes.lay[id].pad_l) +
            i32(nodes.lay[id].pad_r)
        let mut inner_height = nodes.box[id].text_height + i32(nodes.lay[id].pad_t) +
            i32(nodes.lay[id].pad_b)
        if nodes.lay[id].explicit_width >= 0 {
            inner_width = nodes.lay[id].explicit_width
        }
        if nodes.lay[id].explicit_height >= 0 {
            inner_height = nodes.lay[id].explicit_height
        }
        nodes.box[id].inner_width = arena.clamp_w(id, inner_width)
        nodes.box[id].inner_height = arena.clamp_h(id, inner_height)
        return
    }
    if k == 10 {
        measure_text(id)
        let mut inner_width = nodes.box[id].text_width + nodes.box_pad_x(id)
        let mut inner_height = nodes.box[id].text_height + nodes.box_pad_y(id)
        if nodes.lay[id].explicit_width >= 0 {
            inner_width = nodes.lay[id].explicit_width
        }
        if nodes.lay[id].explicit_height >= 0 {
            inner_height = nodes.lay[id].explicit_height
        }
        nodes.box[id].inner_width = arena.clamp_w(id, inner_width)
        nodes.box[id].inner_height = arena.clamp_h(id, inner_height)
        return
    }
    if k == 5 {
        let mut inner_width = 0
        let mut inner_height = 0
        if nodes.lay[id].explicit_width >= 0 {
            inner_width = nodes.lay[id].explicit_width
        }
        if nodes.lay[id].explicit_height >= 0 {
            inner_height = nodes.lay[id].explicit_height
        }
        nodes.box[id].inner_width = arena.clamp_w(id, inner_width)
        nodes.box[id].inner_height = arena.clamp_h(id, inner_height)
        return
    }
    if k == 6 {
        let mut inner_width = 0
        let mut inner_height = 0
        if nodes.lay[id].explicit_width >= 0 {
            inner_width = nodes.lay[id].explicit_width
        }
        if nodes.lay[id].explicit_height >= 0 {
            inner_height = nodes.lay[id].explicit_height
        }
        nodes.box[id].inner_width = arena.clamp_w(id, inner_width)
        nodes.box[id].inner_height = arena.clamp_h(id, inner_height)
        return
    }
    if k == 7 {
        let mut inner_width = 0
        let mut inner_height = 0
        if nodes.lay[id].explicit_width >= 0 {
            inner_width = nodes.lay[id].explicit_width
        }
        if nodes.lay[id].explicit_height >= 0 {
            inner_height = nodes.lay[id].explicit_height
        }
        nodes.box[id].inner_width = arena.clamp_w(id, inner_width)
        nodes.box[id].inner_height = arena.clamp_h(id, inner_height)
        return
    }
    if k == 8 {
        let mut inner_width = 0
        let mut inner_height = 0
        if nodes.lay[id].explicit_width >= 0 {
            inner_width = nodes.lay[id].explicit_width
        }
        if nodes.lay[id].explicit_height >= 0 {
            inner_height = nodes.lay[id].explicit_height
        }
        nodes.box[id].inner_width = arena.clamp_w(id, inner_width)
        nodes.box[id].inner_height = arena.clamp_h(id, inner_height)
        return
    }
    if k == 12 {
        let mut inner_width = 0
        let mut inner_height = 0
        if nodes.lay[id].explicit_width >= 0 {
            inner_width = nodes.lay[id].explicit_width
        }
        if nodes.lay[id].explicit_height >= 0 {
            inner_height = nodes.lay[id].explicit_height
        }
        nodes.box[id].inner_width = arena.clamp_w(id, inner_width)
        nodes.box[id].inner_height = arena.clamp_h(id, inner_height)
        return
    }
    if k == 14 {
        /* Intrinsic size comes from the host (0 until it decodes the source).
           Recording it as the aspect ratio lets an `Image` with only a width
           keep its height, and a widthless image shrink to the container /
           device width (see `sized_w`) instead of collapsing to zero. */
        let mut sw = 0
        let mut sh = 0
        platform.plat_image_size(nodes.look[id].text, &mut sw, &mut sh)
        nodes.lay[id].aspect_w = 0
        nodes.lay[id].aspect_h = 0
        if sw > 0 {
            if sh > 0 {
                nodes.lay[id].aspect_w = sw
                nodes.lay[id].aspect_h = sh
            }
        }
        let mut inner_width = sw
        let mut inner_height = 0
        if nodes.lay[id].explicit_width >= 0 {
            inner_width = nodes.lay[id].explicit_width
        }
        if nodes.lay[id].explicit_height >= 0 {
            inner_height = nodes.lay[id].explicit_height
        }
        /* No explicit height: the box height follows the aspect ratio at the
           width layout gives it, which is not known yet. Report 0 here and
           let the parent `grow_to_children` upward — claiming `sh` would
           reserve the source height and leave a gap under a shrunk image. */
        nodes.box[id].inner_width = arena.clamp_w(id, inner_width)
        nodes.box[id].inner_height = arena.clamp_h(id, inner_height)
        return
    }
    if k == 13 {
        let mut inner_width = 0
        let mut inner_height = 0
        if nodes.lay[id].explicit_width >= 0 {
            inner_width = nodes.lay[id].explicit_width
        }
        if nodes.lay[id].explicit_height >= 0 {
            inner_height = nodes.lay[id].explicit_height
        }
        nodes.box[id].inner_width = arena.clamp_w(id, inner_width)
        nodes.box[id].inner_height = arena.clamp_h(id, inner_height)
        return
    }
    for i in 0..nk {
        measure_node(nodes.tree[id].kids[i])
    }
    if k == 2 {
        let mut nflow = 0
        let mut cw = 0
        let mut rh = 0
        for i in 0..nk {
            let c = nodes.tree[id].kids[i]
            if arena.skip_flow(c) == 0 {
                nflow = nflow + 1
                cw = geometry.max2(cw, nodes.box[c].inner_width)
                rh = geometry.max2(rh, nodes.box[c].inner_height)
            }
        }
        let gx = nodes.gap_x(id)
        let gy = nodes.gap_y(id)
        /* Intrinsic width: the flow children in one row. An auto grid measures
           at that natural (widest) column count, because the width that would
           narrow it is not known yet — the parent assigns it after measuring.
           `layout_grid` makes the real choice, and grows the height when that
           choice lands on more rows than this guess. */
        let natural = nflow * cw + gx * geometry.max2(nflow - 1, 0)
        let cols = grid_cols_at(id, natural, nflow, cw)
        let mut rows = 0
        if nflow > 0 {
            rows = (nflow + cols - 1) / cols
        }
        let mut inner_width = cols * cw + gx * geometry.max2(cols - 1, 0) + nodes.box_pad_x(id)
        let mut inner_height = rows * rh + gy * geometry.max2(rows - 1, 0) + nodes.box_pad_y(id)
        if nodes.lay[id].explicit_width >= 0 {
            inner_width = nodes.lay[id].explicit_width
        }
        if nodes.lay[id].explicit_height >= 0 {
            inner_height = nodes.lay[id].explicit_height
        }
        nodes.box[id].inner_width = arena.clamp_w(id, inner_width)
        nodes.box[id].inner_height = arena.clamp_h(id, inner_height)
        return
    }
    let mut acc = 0
    let mut cross = 0
    let mut first = 1
    for i in 0..nk {
        let c = nodes.tree[id].kids[i]
        if arena.skip_flow(c) == 0 {
            if first == 0 {
                if int(nodes.lay[id].dir) == 0 {
                    acc = acc + nodes.gap_x(id)
                } else {
                    acc = acc + nodes.gap_y(id)
                }
            }
            first = 0
            if int(nodes.lay[id].dir) == 0 {
                acc = acc + nodes.box[c].inner_width + nodes.pin[c].m_l + nodes.pin[c].m_r
                cross = geometry.max2(
                    cross,
                    nodes.box[c].inner_height + nodes.pin[c].m_t + nodes.pin[c].m_b,
                )
            } else {
                acc = acc + nodes.box[c].inner_height + nodes.pin[c].m_t + nodes.pin[c].m_b
                cross = geometry.max2(
                    cross,
                    nodes.box[c].inner_width + nodes.pin[c].m_l + nodes.pin[c].m_r,
                )
            }
        }
    }
    let mut inner_width = 0
    let mut inner_height = 0
    if int(nodes.lay[id].dir) == 0 {
        inner_width = acc + nodes.box_pad_x(id)
        inner_height = cross + nodes.box_pad_y(id)
    } else {
        inner_width = cross + nodes.box_pad_x(id)
        inner_height = acc + nodes.box_pad_y(id)
    }
    if nodes.lay[id].explicit_width >= 0 {
        inner_width = nodes.lay[id].explicit_width
    }
    if nodes.lay[id].explicit_height >= 0 {
        inner_height = nodes.lay[id].explicit_height
    }
    nodes.box[id].inner_width = arena.clamp_w(id, inner_width)
    nodes.box[id].inner_height = arena.clamp_h(id, inner_height)
}

fn layout_flex_row(id: int) {
    let nk = nodes.tree[id].kids.len
    if nk <= 0 {
        return
    }
    let mut nflow = 0
    for i in 0..nk {
        if arena.skip_flow(nodes.tree[id].kids[i]) == 0 {
            nflow = nflow + 1
        }
    }
    if nflow <= 0 {
        return
    }
    arena.size_fit(nk)
    let inner_width = arena.inner_w(id)
    let inner_height = arena.inner_h(id)
    let gx = nodes.gap_x(id)
    let mut fixed = gx * geometry.max2(nflow - 1, 0)
    for i in 0..nk {
        let c = nodes.tree[id].kids[i]
        arena.size_buffer[i] = 0
        if arena.skip_flow(c) == 0 {
            arena.size_buffer[i] = row_child_w(id, c, inner_width)
            fixed = fixed + arena.size_buffer[i] + nodes.pin[c].m_l + nodes.pin[c].m_r
        }
    }
    let mut extra = inner_width - fixed
    if extra < 0 {
        // Rows shrink before they wrap: flexible children (grow = 1) narrow
        // to keep the row on one line. What they cannot absorb still wraps.
        extra = row_flex_absorb(id, nk, extra)
        if extra < 0 {
            layout_flex_row_wrap(id)
            return
        }
    }
    extra = flex_grow_shrink(id, extra, 1)
    for i in 0..nk {
        nodes.box[nodes.tree[id].kids[i]].aw = arena.size_buffer[i]
    }
    let mut ox = 0
    let mut between = 0
    if extra > 0 {
        if nflow > 0 {
            let mode = int(nodes.lay[id].justify)
            if mode == 1 {
                ox = extra / 2
            } else if mode == 2 {
                ox = extra
            } else if mode == 3 {
                if nflow > 1 {
                    between = extra / (nflow - 1)
                }
            } else if mode == 4 {
                between = extra / nflow
                ox = between / 2
            } else if mode == 5 {
                between = extra / (nflow + 1)
                ox = between
            }
        }
    }
    let x0 = arena.content_x(id)
    let y0 = arena.content_y(id)
    let mut cx = x0 + ox
    for j in 0..nk {
        let mut i = j
        if int(nodes.lay[id].reverse) != 0 {
            i = nk - 1 - j
        }
        let c = nodes.tree[id].kids[i]
        if arena.skip_flow(c) == 0 {
            let al = nodes.child_align(id, c)
            let aw = nodes.box[c].aw
            let mut ch = arena.sized_h(c, inner_height, aw)
            if stretch_cross(id, c, 1) != 0 {
                ch = geometry.max2(inner_height - nodes.pin[c].m_t - nodes.pin[c].m_b, 0)
            }
            let cy = geometry.cross_origin(
                al,
                y0,
                inner_height,
                ch + nodes.pin[c].m_t + nodes.pin[c].m_b,
            ) + nodes.pin[c].m_t
            layout_node(c, cx + nodes.pin[c].m_l, cy, aw, ch)
            cx = cx + nodes.box[c].w + nodes.pin[c].m_l + nodes.pin[c].m_r + gx + between
        }
    }
    grow_to_children(id)
}

fn is_flex_row(id: int) -> int {
    if int(nodes.lay[id].dir) != 0 {
        return 0
    }
    if int(nodes.tree[id].kind) == 1 {
        return 1
    }
    if int(nodes.tree[id].kind) == 9 {
        return 1
    }
    return 0
}

/** *Width a flow child wants on the row's main axis, measured the same way in */
/** *every pass (layout pre-pass, wrap measurement). */
fn row_child_w(id: int, c: int, inner_width: int) -> int {
    let avail = inner_width - nodes.pin[c].m_l - nodes.pin[c].m_r
    return geometry.fit_avail(arena.sized_w(c, inner_width, 1), avail)
}

/** *A child's width in a WRAPPING row. A percent below 100 shares the row's */
/** *gaps: `n` children at `100 / n` percent fill exactly one line, where a */
/** *plain share of the width plus the gaps between them would overflow it and */
/** *wrap every cell onto its own line (the reason CSS grids reach for */
/** *`calc(50% - gap / 2)`). An explicit `pct(100)` is a full line; the */
/** *default 100 every node starts with still sizes to the content, as in any */
/** *row. Everything else sizes as in any row. */
fn wrap_child_w(id: int, c: int, inner_width: int) -> int {
    let pc = int(nodes.lay[c].w_pct)
    let full = pc == 100 && int(nodes.lay[c].w_pct_set) != 0
    if nodes.lay[c].explicit_width < 0 && pc > 0 && (pc < 100 || full) {
        let gx = nodes.gap_x(id)
        let avail = inner_width - nodes.pin[c].m_l - nodes.pin[c].m_r
        let w = (inner_width + gx) * pc / 100 - gx
        return geometry.fit_avail(arena.clamp_w(c, geometry.max2(w, 0)), avail)
    }
    return row_child_w(id, c, inner_width)
}

/** *A row child may give up main-axis width to keep the row on one line: */
/** *flexible children (no explicit width) that are allowed to shrink. These */
/** *are exactly the children `grow = 1` marks as elastic (with `shrink = 1` */
/** *where the widget default of 0 would refuse to narrow). */
fn row_can_absorb(c: int) -> int {
    if nodes.axis_frozen(c, 1) != 0 {
        return 0
    }
    // A truncating label narrows to whatever the row has left instead of
    // overflowing or pushing its siblings onto a second line; paint then
    // draws the ellipsis.
    if int(nodes.look[c].ellipsis) != 0 {
        return 1
    }
    if nodes.lay[c].grow <= 0 {
        return 0
    }
    if nodes.lay[c].shrink <= 0 {
        return 0
    }
    return 1
}

/** *Absorb a main-axis deficit (`extra < 0`) by narrowing flexible children, */
/** *never below `min_w`. Returns the leftover deficit (still negative) when */
/** *the children cannot take it all — the caller wraps those instead. */
fn row_flex_absorb(id: int, nk: int, extra: int) -> int {
    let need = -extra
    let mut cap = 0
    for i in 0..nk {
        let c = nodes.tree[id].kids[i]
        if arena.skip_flow(c) == 0 {
            if row_can_absorb(c) != 0 {
                let mut floor = 0
                if nodes.lay[c].min_w >= 0 {
                    floor = nodes.lay[c].min_w
                }
                let room = arena.size_buffer[i] - floor
                if room > 0 {
                    cap = cap + room
                }
            }
        }
    }
    if cap <= 0 {
        return extra
    }
    if cap < need {
        return extra
    }
    let mut left = need
    let mut last = -1
    for i in 0..nk {
        let c = nodes.tree[id].kids[i]
        if arena.skip_flow(c) == 0 {
            if row_can_absorb(c) != 0 {
                let mut floor = 0
                if nodes.lay[c].min_w >= 0 {
                    floor = nodes.lay[c].min_w
                }
                let room = arena.size_buffer[i] - floor
                if room > 0 {
                    let cut = need * room / cap
                    arena.size_buffer[i] = arena.size_buffer[i] - cut
                    left = left - cut
                    last = i
                }
            }
        }
    }
    if last >= 0 {
        arena.size_buffer[last] = arena.size_buffer[last] - left
    }
    return 0
}

/** *Height a row needs when children wrap at `outer_w` (includes padding). */
fn wrap_row_h(id: int, outer_w: int) -> int {
    let nk = nodes.tree[id].kids.len
    let inner_width = geometry.max2(outer_w - nodes.box_pad_x(id), 0)
    let gx = nodes.gap_x(id)
    let gy = nodes.gap_y(id)
    // If the flexible children can absorb the overflow, the row stays on one
    // line — mirror layout_flex_row's shrink decision so column parents give
    // the row exactly the height it will occupy.
    let mut accw = 0
    let mut nflow = 0
    let mut cap = 0
    let mut line_h = 0
    for i in 0..nk {
        let c = nodes.tree[id].kids[i]
        if arena.skip_flow(c) == 0 {
            let cw = wrap_child_w(id, c, inner_width)
            let span = cw + nodes.pin[c].m_l + nodes.pin[c].m_r
            if nflow > 0 {
                accw = accw + gx
            }
            accw = accw + span
            nflow = nflow + 1
            let ch = arena.sized_h(c, line_h, cw)
            let mh = ch + nodes.pin[c].m_t + nodes.pin[c].m_b
            if mh > line_h {
                line_h = mh
            }
            if row_can_absorb(c) != 0 {
                let mut floor = 0
                if nodes.lay[c].min_w >= 0 {
                    floor = nodes.lay[c].min_w
                }
                let room = cw - floor
                if room > 0 {
                    cap = cap + room
                }
            }
        }
    }
    if accw > inner_width {
        if cap >= accw - inner_width {
            let mut total = line_h + nodes.box_pad_y(id)
            if nodes.lay[id].explicit_height >= 0 {
                if total < nodes.lay[id].explicit_height {
                    total = nodes.lay[id].explicit_height
                }
            }
            return arena.clamp_h(id, total)
        }
    }
    let mut x = 0
    let mut total = 0
    let mut first = 1
    let mut nline = 0
    for i in 0..nk {
        let c = nodes.tree[id].kids[i]
        if arena.skip_flow(c) == 0 {
            let cw = wrap_child_w(id, c, inner_width)
            let ch = arena.sized_h(c, line_h, cw)
            let span = cw + nodes.pin[c].m_l + nodes.pin[c].m_r
            if first == 0 {
                if x + span > inner_width {
                    total = total + line_h
                    nline = nline + 1
                    x = 0
                    line_h = 0
                }
            }
            first = 0
            let mh = ch + nodes.pin[c].m_t + nodes.pin[c].m_b
            if mh > line_h {
                line_h = mh
            }
            x = x + span + gx
        }
    }
    if first == 0 {
        total = total + line_h
        nline = nline + 1
    }
    if nline > 1 {
        total = total + gy * (nline - 1)
    }
    total = total + nodes.box_pad_y(id)
    if nodes.lay[id].explicit_height >= 0 {
        if total < nodes.lay[id].explicit_height {
            total = nodes.lay[id].explicit_height
        }
    }
    return arena.clamp_h(id, total)
}

fn wrap_mark_line(id: int, lo: int, hi: int, line_h: int) {
    for j in lo..hi {
        let c = nodes.tree[id].kids[j]
        if arena.skip_flow(c) == 0 {
            nodes.box[c].ah = line_h
        }
    }
}

fn layout_flex_row_wrap(id: int) {
    let nk = nodes.tree[id].kids.len
    let inner_width = arena.inner_w(id)
    let inner_height = arena.inner_h(id)
    let gx = nodes.gap_x(id)
    let gy = nodes.gap_y(id)
    let x0 = arena.content_x(id)
    let y0 = arena.content_y(id)
    arena.size_fit(nk)
    let mut x = 0
    let mut line_h = 0
    let mut line_start = 0
    let mut first = 1
    for i in 0..nk {
        let c = nodes.tree[id].kids[i]
        if arena.skip_flow(c) == 0 {
            let mut cw = wrap_child_w(id, c, inner_width)
            let mut ch = arena.sized_h(c, inner_height, cw)
            let span = cw + nodes.pin[c].m_l + nodes.pin[c].m_r
            if first == 0 {
                if x + span > inner_width {
                    wrap_mark_line(id, line_start, i, line_h)
                    x = 0
                    line_h = 0
                    line_start = i
                }
            }
            first = 0
            nodes.box[c].aw = cw
            let mh = ch + nodes.pin[c].m_t + nodes.pin[c].m_b
            if mh > line_h {
                line_h = mh
            }
            x = x + span + gx
        }
    }
    wrap_mark_line(id, line_start, nk, line_h)
    x = 0
    let mut y = 0
    line_start = 0
    first = 1
    // A child can end up taller than its measured line height once its own
    // text wraps at the final width (a card with a wrapped paragraph). The
    // next line starts below the tallest child actually laid out, so wrapped
    // lines never overlap.
    let mut line_real = 0
    for i in 0..nk {
        let c = nodes.tree[id].kids[i]
        if arena.skip_flow(c) == 0 {
            let cw = nodes.box[c].aw
            let span = cw + nodes.pin[c].m_l + nodes.pin[c].m_r
            if first == 0 {
                if x + span > inner_width {
                    let planned = nodes.box[nodes.tree[id].kids[line_start]].ah
                    y = y + geometry.max2(planned, line_real) + gy
                    x = 0
                    line_start = i
                    line_real = 0
                }
            }
            first = 0
            let lh = nodes.box[c].ah
            let mut ch = arena.sized_h(c, inner_height, cw)
            let al = nodes.child_align(id, c)
            if stretch_cross(id, c, 1) != 0 {
                ch = geometry.max2(lh - nodes.pin[c].m_t - nodes.pin[c].m_b, 0)
            }
            let cy = geometry.cross_origin(
                al,
                y0 + y,
                lh,
                ch + nodes.pin[c].m_t + nodes.pin[c].m_b,
            ) + nodes.pin[c].m_t
            layout_node(c, x0 + x + nodes.pin[c].m_l, cy, cw, ch)
            let real = nodes.box[c].y + nodes.box[c].h + nodes.pin[c].m_b - (y0 + y)
            if real > line_real {
                line_real = real
            }
            x = x + span + gx
        }
    }
    grow_to_children(id)
}

fn layout_flex_col(id: int) {
    let nk = nodes.tree[id].kids.len
    if nk <= 0 {
        return
    }
    let mut nflow = 0
    for i in 0..nk {
        if arena.skip_flow(nodes.tree[id].kids[i]) == 0 {
            nflow = nflow + 1
        }
    }
    if nflow <= 0 {
        return
    }
    arena.size_fit(nk)
    let inner_width = arena.inner_w(id)
    let inner_height = arena.inner_h(id)
    let gy = nodes.gap_y(id)
    let mut fixed = gy * geometry.max2(nflow - 1, 0)
    for i in 0..nk {
        let c = nodes.tree[id].kids[i]
        arena.size_buffer[i] = 0
        if arena.skip_flow(c) == 0 {
            let avail = inner_width - nodes.pin[c].m_l - nodes.pin[c].m_r
            let mut cw = arena.sized_w(c, inner_width, 0)
            if nodes.scrolls_x(id) != 0 {
                if nodes.box[c].inner_width > cw {
                    cw = arena.clamp_w(c, nodes.box[c].inner_width)
                }
            } else {
                if stretch_cross(id, c, 0) != 0 {
                    cw = arena.clamp_w(c, avail)
                }
                cw = geometry.fit_avail(cw, avail)
            }
            let mut ch = arena.sized_h(c, inner_height, cw)
            if is_flex_row(c) != 0 {
                let wh = wrap_row_h(c, cw)
                if wh > ch {
                    ch = wh
                }
            }
            arena.size_buffer[i] = ch
            fixed = fixed + arena.size_buffer[i] + nodes.pin[c].m_t + nodes.pin[c].m_b
        }
    }
    let mut extra = inner_height - fixed
    if int(nodes.tree[id].kind) == 11 {
        if extra < 0 {
            extra = 0
        }
    }
    extra = flex_grow_shrink(id, extra, 0)
    for i in 0..nk {
        nodes.box[nodes.tree[id].kids[i]].ah = arena.size_buffer[i]
    }
    let mut oy = 0
    let mut between = 0
    if extra > 0 {
        if nflow > 0 {
            let mode = int(nodes.lay[id].justify)
            if mode == 1 {
                oy = extra / 2
            } else if mode == 2 {
                oy = extra
            } else if mode == 3 {
                if nflow > 1 {
                    between = extra / (nflow - 1)
                }
            } else if mode == 4 {
                between = extra / nflow
                oy = between / 2
            } else if mode == 5 {
                between = extra / (nflow + 1)
                oy = between
            }
        }
    }
    let x0 = arena.content_x(id)
    let y0 = arena.content_y(id)
    let mut cy = y0 + oy
    for j in 0..nk {
        let mut i = j
        if int(nodes.lay[id].reverse) != 0 {
            i = nk - 1 - j
        }
        let c = nodes.tree[id].kids[i]
        if arena.skip_flow(c) == 0 {
            let al = nodes.child_align(id, c)
            let avail = inner_width - nodes.pin[c].m_l - nodes.pin[c].m_r
            let mut cw = arena.sized_w(c, inner_width, 0)
            if nodes.scrolls_x(id) != 0 {
                if nodes.box[c].inner_width > cw {
                    cw = arena.clamp_w(c, nodes.box[c].inner_width)
                }
            } else {
                if stretch_cross(id, c, 0) != 0 {
                    cw = arena.clamp_w(c, avail)
                }
                cw = geometry.fit_avail(cw, avail)
            }
            let cx = geometry.cross_origin(
                al,
                x0,
                inner_width,
                cw + nodes.pin[c].m_l + nodes.pin[c].m_r,
            ) + nodes.pin[c].m_l
            layout_node(c, cx, cy + nodes.pin[c].m_t, cw, nodes.box[c].ah)
            cy = cy + nodes.box[c].h + nodes.pin[c].m_t + nodes.pin[c].m_b + gy + between
        }
    }
    if nflow > 0 {
        let content = cy - gy - between - nodes.box[id].y + i32(nodes.lay[id].pad_b) +
            i32(nodes.lay[id].border_w)
        if int(nodes.tree[id].kind) == 11 {
            nodes.box[id].ext_h = geometry.max2(content, nodes.box[id].h)
            if nodes.scrolls_x(id) != 0 {
                let mut content_w = nodes.box[id].w
                for i in 0..nk {
                    let c = nodes.tree[id].kids[i]
                    if arena.skip_flow(c) == 0 {
                        let right = nodes.box[c].x + nodes.box[c].w + nodes.pin[c].m_r -
                            nodes.box[id].x + i32(nodes.lay[id].pad_r) + i32(nodes.lay[id].border_w)
                        if right > content_w {
                            content_w = right
                        }
                    }
                }
                nodes.box[id].ext_w = geometry.max2(content_w, nodes.box[id].w)
            } else {
                nodes.box[id].ext_w = nodes.box[id].w
                nodes.scrl[id].scroll_x = 0
            }
            arena.clamp_scroll(id)
        } else if content > nodes.box[id].h {
            nodes.box[id].h = content
        }
    }
}

/** *Column count a grid resolves to, shared by `measure_node` and */
/** *`layout_grid` so the two cannot disagree. */
/** */
/** *`grid_auto == 0` is the fixed case: `grid_cols` is the count, floored at 1 */
/** *(`grid_cols == 0`, i.e. `GridConfig {}`, means a single column). */
/** */
/** *`grid_auto != 0` is auto mode, where a column is a *cell* of a minimum */
/** *width and the count is however many such cells fit the width `inner_width` has, */
/** *capped by `grid_cols` when the caller gave one and by `flow` children so */
/** *the last row is never empty tracks. */
/** */
/** *The cell width is `grid_min` when the caller set one. With no floor it is */
/** *`nat` — the widest child's natural width — because a column has to be at */
/** *least wide enough for what goes in it; that is the same rule `measure_node` */
/** *uses to guess the grid's own width, so the two agree by construction. If */
/** *neither is available (`nat <= 0`: the children report no width of their */
/** *own) the count falls back to `grid_cols`, which is the fixed behaviour. */
/** */
/** *The gap is part of the cell (`cell + gx`), matching the packing in */
/** *`layout_grid`, where `cols` cells plus `cols - 1` gaps span `inner_width`. */
/** */
/** *`flow` is how many children will actually be placed. `0` means the caller */
/** *has none to offer (measure saw no flow children) — the cap is skipped */
/** *rather than collapsing the count to nothing. */
fn grid_cols_at(id: int, inner_width: int, flow: int, nat: int) -> int {
    let mut cols = i32(nodes.pin[id].grid_cols)
    if nodes.pin[id].grid_auto != 0 {
        let mut cell = i32(nodes.pin[id].grid_min)
        if cell <= 0 {
            cell = nat
        }
        if cell > 0 {
            cell = cell + nodes.gap_x(id)
            cols = (inner_width + nodes.gap_x(id)) / cell
        }
        if cols < 1 {
            cols = 1
        }
        if nodes.pin[id].grid_cols > 0 {
            if cols > i32(nodes.pin[id].grid_cols) {
                cols = i32(nodes.pin[id].grid_cols)
            }
        }
        if flow > 0 {
            if cols > flow {
                cols = flow
            }
        }
    } else if cols < 1 {
        cols = 1
    }
    return cols
}

fn layout_grid(id: int) {
    let nk = nodes.tree[id].kids.len
    let inner_width = arena.inner_w(id)
    let inner_height = arena.inner_h(id)
    let gx = nodes.gap_x(id)
    let gy = nodes.gap_y(id)
    /* Count flow children before choosing columns: a hidden child must not
       claim a track, or every visible cell would be that much narrower. The
       widest of them is the natural cell width when no floor was given. */
    let mut flow = 0
    let mut nat = 0
    for i in 0..nk {
        let c = nodes.tree[id].kids[i]
        if arena.skip_flow(c) == 0 {
            flow = flow + 1
            nat = geometry.max2(nat, nodes.box[c].inner_width)
        }
    }
    let cols = grid_cols_at(id, inner_width, flow, nat)
    let mut cw = inner_width
    if cols > 0 {
        cw = (inner_width - gx * (cols - 1)) / cols
    }
    if cw < 0 {
        cw = 0
    }
    let x0 = arena.content_x(id)
    let y0 = arena.content_y(id)
    let mut col = 0
    let mut y = y0
    let mut rh = 0
    let mut placed = 0
    for i in 0..nk {
        let c = nodes.tree[id].kids[i]
        if arena.skip_flow(c) == 0 {
            let mut sp = i32(nodes.pin[c].span)
            if sp < 1 {
                sp = 1
            }
            if sp > cols {
                sp = cols
            }
            if col + sp > cols {
                y = y + rh + gy
                rh = 0
                col = 0
            }
            let cx = x0 + col * (cw + gx)
            let cww = cw * sp + gx * (sp - 1)
            let ch = arena.sized_h(c, inner_height, cww)
            layout_node(c, cx, y, cww, ch)
            rh = geometry.max2(rh, nodes.box[c].h)
            col = col + sp
            placed = 1
        }
    }
    if placed != 0 {
        let content = y + rh - nodes.box[id].y + i32(nodes.lay[id].pad_b) +
            i32(nodes.lay[id].border_w)
        if content > nodes.box[id].h {
            nodes.box[id].h = content
        }
    }
}

fn layout_abs(p: int) {
    let nk = nodes.tree[p].kids.len
    let inner_width = arena.inner_w(p)
    let inner_height = arena.inner_h(p)
    let ox = arena.content_x(p)
    let oy = arena.content_y(p)
    for i in 0..nk {
        let c = nodes.tree[p].kids[i]
        if c > 0 {
            if arena.want_show(c) != 0 {
                if int(nodes.pin[c].pos) == 1 {
                    if int(nodes.tree[c].kind) != 9 {
                        /* `row = 1` asks `sized_w` for the CONTENT width. The
                           `row = 0` form means "fill the parent", which is how
                           a column stretches a flow child — and it is what made
                           every absolutely positioned box with no explicit
                           width render as a full-width div: the tooltip bubble
                           was as wide as the window, and so was a popover with
                           an unset `width`. An absolute node shrink-wraps unless
                           it says otherwise; an explicit `width` or an explicit
                           percentage still wins inside `sized_w`. */
                        let mut w = arena.sized_w(c, inner_width, 1)
                        let mut h = arena.sized_h(c, inner_height, w)
                        let mut x = ox
                        let mut y = oy
                        /* `-1` is "unset", not "zero" — the guard used to be
                           `>= 0`, which also swallowed every real NEGATIVE
                           offset. That is why `left = -3, top = -3` (the ring
                           around the accent dot) sat still: the ring drew at the
                           parent's origin and hung 3px down-right of the dot. */
                        if nodes.pin[c].pin_l != -1 {
                            x = ox + nodes.pin[c].pin_l
                        }
                        if nodes.pin[c].pin_t != -1 {
                            y = oy + nodes.pin[c].pin_t
                        }
                        if nodes.pin[c].pin_l != -1 {
                            if nodes.pin[c].pin_r != -1 {
                                w = arena.clamp_w(
                                    c,
                                    inner_width - nodes.pin[c].pin_l - nodes.pin[c].pin_r,
                                )
                            }
                        }
                        if nodes.pin[c].pin_t != -1 {
                            if nodes.pin[c].pin_b != -1 {
                                h = arena.clamp_h(
                                    c,
                                    inner_height - nodes.pin[c].pin_t - nodes.pin[c].pin_b,
                                )
                            }
                        }
                        if nodes.pin[c].pin_r != -1 {
                            if nodes.pin[c].pin_l == -1 {
                                x = ox + inner_width - w - nodes.pin[c].pin_r
                            }
                        }
                        if nodes.pin[c].pin_b != -1 {
                            if nodes.pin[c].pin_t == -1 {
                                y = oy + inner_height - h - nodes.pin[c].pin_b
                            }
                        }
                        layout_node(c, x, y, w, h)
                    }
                }
            }
        }
    }
}

fn layout_overlays(id: int) {
    if id <= 0 {
        return
    }
    if arena.want_show(id) == 0 {
        return
    }
    let nk = nodes.tree[id].kids.len
    for i in 0..nk {
        let c = nodes.tree[id].kids[i]
        if arena.want_show(c) != 0 {
            if int(nodes.tree[c].kind) == 9 {
                let ox = arena.safe_l
                let oy = arena.safe_t
                let mut ow = arena.win_w - arena.safe_l - arena.safe_r
                let mut oh = arena.win_h - arena.safe_t - arena.safe_b
                if ow < 0 {
                    ow = 0
                }
                if oh < 0 {
                    oh = 0
                }
                layout_node(c, ox, oy, ow, oh)
                nodes.box[c].x = ox
                nodes.box[c].y = oy
                nodes.box[c].w = ow
                nodes.box[c].h = oh
            }
            layout_overlays(c)
        }
    }
}

/** *`layout_node` calls over the session, counting every re-entry (a probe */
/** *holds a whole-tree layout under two visits per node). */
let mut layout_visits: int = 0
/** *Nodes `measure_node` actually measured (cache hits not counted). */
let mut measure_visits: int = 0

// --- layout memo ------------------------------------------------------------
//
// `layout_node(id, x, y, w, h)` depends only on that box, the node's own props,
// its subtree's props and measures, and the frame-wide inputs (window, safe
// insets, the measure generation). Every write that can change a prop or a
// measure under a node invalidates the node's path (`nodes.invalidate_path`
// sets `dirty` bit 2), and every frame-wide change bumps `lay_epoch`. So a
// node called with the same box in the same epoch, with bit 2 clear, would
// lay out exactly as before, and its whole subtree is skipped. A targeted
// write then costs its path plus whatever actually moved, not the tree.
//
// `ZEUS_LAYOUT_VERIFY=1` re-runs every layout with the memo off and traps on
// any box that differs, which is how the rule is checked across the suite.

let mut lay_epoch: int = 1
let mut ep_gen: int = -1
let mut ep_w: int = -1
let mut ep_h: int = -1
let mut ep_t: int = -1
let mut ep_r: int = -1
let mut ep_b: int = -1
let mut ep_l: int = -1
/** *1 while the memo is bypassed (the verify pass). */
let mut memo_off: int = 0
/** *-1 until read from the environment, then 0 / 1. */
/** *Subtrees the memo skipped, and subtrees it translated (diagnostics). */
let mut layout_skips: int = 0
let mut layout_shifts: int = 0

/** *1 when `id`'s subtree holds no floater (overlay, anchored or floating box, */
/** *z-indexed node), so translating it is exact. */
fn shift_ok(id: int) -> int {
    if nodes.is_floater(id) != 0 {
        return 0
    }
    let nk = nodes.tree[id].kids.len
    for i in 0..nk {
        let c = nodes.tree[id].kids[i]
        if c > 0 && c < nodes.tree.len {
            if shift_ok(c) == 0 {
                return 0
            }
        }
    }
    return 1
}

/** *Move `id`'s laid-out subtree by (`dx`, `dy`), and the boxes its nodes were */
/** *last called with, so the memo keeps matching. */
fn shift_subtree(id: int, dx: int, dy: int) {
    nodes.box[id].x = nodes.box[id].x + dx
    nodes.box[id].y = nodes.box[id].y + dy
    nodes.box[id].la_x = nodes.box[id].la_x + dx
    nodes.box[id].la_y = nodes.box[id].la_y + dy
    let nk = nodes.tree[id].kids.len
    for i in 0..nk {
        let c = nodes.tree[id].kids[i]
        if c > 0 && c < nodes.tree.len {
            shift_subtree(c, dx, dy)
        }
    }
}

/** *Bump the epoch when a frame-wide layout input moved since the last layout. */
fn epoch_check() {
    if ep_gen != arena.measure_gen ||
        ep_w != arena.win_w ||
        ep_h != arena.win_h ||
        ep_t != arena.safe_t ||
        ep_r != arena.safe_r ||
        ep_b != arena.safe_b ||
        ep_l != arena.safe_l {
        lay_epoch = lay_epoch + 1
        ep_gen = arena.measure_gen
        ep_w = arena.win_w
        ep_h = arena.win_h
        ep_t = arena.safe_t
        ep_r = arena.safe_r
        ep_b = arena.safe_b
        ep_l = arena.safe_l
    }
}

fn layout_node(id: int, x: int, y: int, w: int, h: int) {
    if id <= 0 {
        return
    }
    let st = int(nodes.tree[id].dirty)
    if memo_off == 0 && (st & 4) == 0 && nodes.box[id].la_ep == lay_epoch {
        if nodes.box[id].la_w == w && nodes.box[id].la_h == h {
            if nodes.box[id].la_x == x && nodes.box[id].la_y == y {
                layout_skips = layout_skips + 1
                return
            }
            // Same size, nothing inside changed, only moved: the subtree
            // lays out the same, translated (a row below a growing sibling).
            // Not when it holds a floater: those are placed in window space
            // against their target, so they are laid out again instead.
            if shift_ok(id) != 0 {
                shift_subtree(id, x - nodes.box[id].la_x, y - nodes.box[id].la_y)
                layout_shifts = layout_shifts + 1
                return
            }
        }
    }
    if (st & 4) != 0 {
        nodes.tree[id].dirty = u8(st & 251)
    }
    nodes.box[id].la_x = x
    nodes.box[id].la_y = y
    nodes.box[id].la_w = w
    nodes.box[id].la_h = h
    nodes.box[id].la_ep = lay_epoch
    layout_visits = layout_visits + 1
    nodes.box[id].x = x
    nodes.box[id].y = y
    nodes.box[id].w = arena.clamp_w(id, w)
    nodes.box[id].h = arena.clamp_h(id, h)
    apply_label_wrap(id)
    apply_input_wrap(id)
    let k = int(nodes.tree[id].kind)
    if k == 1 {
        if int(nodes.lay[id].dir) == 0 {
            layout_flex_row(id)
        } else {
            layout_flex_col(id)
        }
    } else if k == 9 {
        if int(nodes.lay[id].dir) == 0 {
            layout_flex_row(id)
        } else {
            layout_flex_col(id)
        }
    } else if k == 11 {
        layout_flex_col(id)
    } else if k == 2 {
        layout_grid(id)
    }
    layout_abs(id)
}

fn layout(width: int, height: int) {
    arena.ensure()
    if width > 0 {
        arena.win_w = width
    }
    if height > 0 {
        arena.win_h = height
    }
    // The whole safe-area box in one read (platform.loam `plat_inset_get`):
    // four calls could observe a host that updated them mid-pass.
    let mut insets = []int { 0, 0, 0, 0 }
    platform.plat_inset_get(insets)
    arena.safe_t = insets[0]
    arena.safe_r = insets[1]
    arena.safe_b = insets[2]
    arena.safe_l = insets[3]
    if arena.root_id <= 0 {
        return
    }
    // Layout can move a floater into or out of view (a show predicate, a
    // pin), so the hit pass's no-floater stamps start over.
    arena.floater_gen = arena.floater_gen + 1
    measure_node(arena.root_id)
    epoch_check()
    layout_node(arena.root_id, 0, 0, arena.win_w, arena.win_h)
    layout_overlays(arena.root_id)
    if platform.plat_layout_verify() != 0 {
        verify_memo()
    }
    // Floaters are re-placed every layout, and a scroll re-runs layout while any
    // are on screen (`arena.mark_scroll`), so a popup stays next to its trigger.
    arena.live_anchors = 0
    place_anchored(arena.root_id)
}

// --- targeted layout frames -------------------------------------------------
//
// A frame's layout dirt names nodes: a prop write landed on one, or a host's
// kid list moved under one. Such a frame re-solves the whole tree, which is
// cheap: clean subtrees keep their measure stamp, and text measures come from
// the cache in `metrics`. Paint, though, stays targeted. Every box is
// snapshotted before the solve, and afterwards only the nodes whose box, scroll
// extent or scroll offset moved are paint-marked, so the retained ops elsewhere
// are reused and damage covers only what moved. A content change marked its
// own node when it was written.

/** *Lay the tree out again with the memo off and trap if any box differs from */
/** *what the memoized pass produced. */
fn verify_memo() {
    let n = nodes.tree.len
    let mut vb = []int {}
    for id in 0..n {
        push(vb, nodes.box[id].x)
        push(vb, nodes.box[id].y)
        push(vb, nodes.box[id].w)
        push(vb, nodes.box[id].h)
        push(vb, nodes.box[id].ext_w)
        push(vb, nodes.box[id].ext_h)
    }
    let visits = layout_visits
    memo_off = 1
    lay_epoch = lay_epoch + 1
    layout_node(arena.root_id, 0, 0, arena.win_w, arena.win_h)
    layout_overlays(arena.root_id)
    memo_off = 0
    layout_visits = visits
    for id in 1..n {
        let o = id * 6
        if int(nodes.tree[id].kind) != 0 {
            if nodes.box[id].x != vb[o] ||
                nodes.box[id].y != vb[o + 1] ||
                nodes.box[id].w != vb[o + 2] ||
                nodes.box[id].h != vb[o + 3] ||
                nodes.box[id].ext_w != vb[o + 4] ||
                nodes.box[id].ext_h != vb[o + 5] {
                panic(
                    "ZEUS_LAYOUT_VERIFY: node {{id}} kind {{int(nodes.tree[id].kind)}} memo box {{vb[o]}},{{vb[o + 1]}} {{vb[o + 2]}}x{{vb[o + 3]}} ext {{vb[o + 4]}}x{{vb[o + 5]}} but full box {{nodes.box[id].x}},{{nodes.box[id].y}} {{nodes.box[id].w}}x{{nodes.box[id].h}} ext {{nodes.box[id].ext_w}}x{{nodes.box[id].ext_h}}",
                )
            }
        }
    }
}

/** *Targeted layout frames run (every one solves from the root), and a legacy */
/** *counter that is always 0 now that no subtree re-solve climbs (diagnostics). */
let mut relayout_climbs: int = 0
let mut root_relayouts: int = 0

/* Every node's box before a targeted solve, indexed by id, so the nodes it
   moved can be paint-marked afterwards. Kept across frames (it only grows),
   so a frame copies into it rather than allocating. */
let mut sb_x: []int = []int {}
let mut sb_y: []int = []int {}
let mut sb_w: []int = []int {}
let mut sb_h: []int = []int {}
let mut sb_ew: []int = []int {}
let mut sb_eh: []int = []int {}
let mut sb_sx: []int = []int {}
let mut sb_sy: []int = []int {}

fn box_snapshot() {
    let n = nodes.tree.len
    while sb_x.len < n {
        push(sb_x, 0)
        push(sb_y, 0)
        push(sb_w, 0)
        push(sb_h, 0)
        push(sb_ew, 0)
        push(sb_eh, 0)
        push(sb_sx, 0)
        push(sb_sy, 0)
    }
    for id in 1..n {
        sb_x[id] = nodes.box[id].x
        sb_y[id] = nodes.box[id].y
        sb_w[id] = nodes.box[id].w
        sb_h[id] = nodes.box[id].h
        sb_ew[id] = nodes.box[id].ext_w
        sb_eh[id] = nodes.box[id].ext_h
        sb_sx[id] = nodes.scrl[id].scroll_x
        sb_sy[id] = nodes.scrl[id].scroll_y
    }
}

/** *Paint-mark every live node whose box, scroll extent or scroll offset moved */
/** *since `box_snapshot`. Layout allocates no nodes, so the ids line up. */
fn box_mark_moved() {
    let n = nodes.tree.len
    for id in 1..n {
        if int(nodes.tree[id].kind) != 0 {
            if nodes.box[id].x != sb_x[id] ||
                nodes.box[id].y != sb_y[id] ||
                nodes.box[id].w != sb_w[id] ||
                nodes.box[id].h != sb_h[id] ||
                nodes.box[id].ext_w != sb_ew[id] ||
                nodes.box[id].ext_h != sb_eh[id] ||
                nodes.scrl[id].scroll_x != sb_sx[id] ||
                nodes.scrl[id].scroll_y != sb_sy[id] {
                arena.mark_paint_id(id)
            }
        }
    }
}

/** *Lay out a frame whose layout dirt names nodes (`dirty` is */
/** *`arena.take_dirty_layout_nodes()`), paint-marking only what moved. Returns */
/** *0 when there is nothing to target, leaving the caller to solve and repaint */
/** *the whole surface. */
fn relayout(dirty: []int) -> int {
    if dirty.len == 0 {
        return 0
    }
    let root = arena.root_id
    if root <= 0 {
        return 0
    }
    box_snapshot()
    layout(arena.win_w, arena.win_h)
    root_relayouts = root_relayouts + 1
    box_mark_moved()
    return 1
}

/** *Screen origin of `id` in window points: its content-space x/y less every */
/** *scroller offset above it (the inverse of `ptr_in`'s screen-to-content walk). */
struct Pt {
    x: int,
    y: int,
}

fn screen_origin(id: int) -> Pt {
    let sc = screen_scroll(id)
    return Pt { x: nodes.box[id].x - sc.x, y: nodes.box[id].y - sc.y }
}

/** *Sum of the scroll offsets of `id`'s kind-11 ancestors. `screen_origin` */
/** *removes these to reach window coordinates; a floater positioned in window */
/** *coordinates adds them back to store content coordinates (see `place_node`). */
fn screen_scroll(id: int) -> Pt {
    let mut sx = 0
    let mut sy = 0
    // A window floater (overlay, popup, floating box) is placed in window
    // space: nothing above it scrolls it, and nothing above it scrolls what
    // it holds — a submenu anchored inside a popup on a scrolled page.
    if nodes.is_window_floater(id) != 0 {
        return Pt { x: 0, y: 0 }
    }
    let mut p = nodes.tree[id].parent
    let mut guard = 0
    while p > 0 {
        if int(nodes.tree[p].kind) == 11 {
            sx = sx + nodes.scrl[p].scroll_x
            sy = sy + nodes.scrl[p].scroll_y
        }
        if nodes.is_window_floater(p) != 0 {
            break
        }
        p = nodes.tree[p].parent
        guard = guard + 1
        if guard > 64 {
            break
        }
    }
    return Pt { x: sx, y: sy }
}

/** *Position one anchored floater against its anchor's screen rect, flipping to */
/** *the opposite side when the preferred one would leave the safe-area rect. */
/** *Runs after the normal layout and re-lays-out the moved subtree. */
/** *Fraction (0, 50, 100 percent) of a box's width / height at attach point */
/** *`p` (`Attach`: Left/Center/Right × Top/Center/Bottom). */
fn attach_fx(p: int) -> int {
    return (p / 3) * 50
}

fn attach_fy(p: int) -> int {
    return (p % 3) * 50
}

/** *Place a floating box (`Style.floating`): join point `at` of the box to */
/** *point `on` of its target's window rect, add the offset, flip on overflow if */
/** *asked. Window coordinates, like an anchored popup. */
fn place_float(id: int) {
    if arena.want_show(id) == 0 {
        return
    }
    let to = int(nodes.pin[id].fl_to)
    let mut tx = arena.safe_l
    let mut ty = arena.safe_t
    let mut tw = arena.win_w - arena.safe_l - arena.safe_r
    let mut th = arena.win_h - arena.safe_t - arena.safe_b
    let mut w = nodes.box[id].w
    let mut h = nodes.box[id].h
    if to == 2 {
        // Sized against the window, not the parent it was declared in.
        w = arena.sized_w(id, tw, 1)
        h = arena.sized_h(id, th, w)
    } else {
        let mut t = nodes.tree[id].parent
        if to == 3 {
            t = nodes.pin[id].anchor
        }
        if t <= 0 || t >= nodes.tree.len {
            return
        }
        let o = screen_origin(t)
        tx = o.x
        ty = o.y
        tw = nodes.box[t].w
        th = nodes.box[t].h
    }
    w = w + int(nodes.pin[id].fl_ew)
    h = h + int(nodes.pin[id].fl_eh)
    let mut pts = int(nodes.pin[id].fl_pts)
    if pts > 0 {
        pts = pts - 1
    }
    let at = pts / 9
    let on = pts % 9
    let ox = int(nodes.pin[id].fl_x)
    let oy = int(nodes.pin[id].fl_y)
    let mut x = tx + tw * attach_fx(on) / 100 - w * attach_fx(at) / 100 + ox
    let mut y = ty + th * attach_fy(on) / 100 - h * attach_fy(at) / 100 + oy
    if int(nodes.pin[id].flip) != 0 {
        let top = arena.safe_t
        let bottom = arena.win_h - arena.safe_b
        let left = arena.safe_l
        let right = arena.win_w - arena.safe_r
        // Mirror the vertical (then horizontal) attach when the box leaves
        // the window and the mirror fits: below <-> above, end <-> start.
        if y + h > bottom || y < top {
            let my = ty + th * (100 - attach_fy(on)) / 100 - h * (100 - attach_fy(at)) / 100 - oy
            if my >= top && my + h <= bottom {
                y = my
            }
        }
        if x + w > right || x < left {
            let mx = tx + tw * (100 - attach_fx(on)) / 100 - w * (100 - attach_fx(at)) / 100 - ox
            if mx >= left && mx + w <= right {
                x = mx
            }
        }
    }
    nodes.box[id].x = x
    nodes.box[id].y = y
    layout_node(id, x, y, w, h)
    arena.live_anchors = arena.live_anchors + 1
}

fn place_node(id: int) {
    if int(nodes.pin[id].fl_to) != 0 {
        place_float(id)
        return
    }
    let a = nodes.pin[id].anchor
    if a <= 0 {
        return
    }
    if a >= nodes.tree.len {
        return
    }
    if arena.want_show(id) == 0 {
        return
    }
    let o = screen_origin(a)
    let ax = o.x
    let ay = o.y
    let aw = nodes.box[a].w
    let ah = nodes.box[a].h
    let w = nodes.box[id].w
    let h = nodes.box[id].h
    let gap = int(nodes.pin[id].anchor_gap)
    let top = arena.safe_t
    let bottom = arena.win_h - arena.safe_b
    let left = arena.safe_l
    let right = arena.win_w - arena.safe_r
    let code = int(nodes.pin[id].place)
    // 0 below, 1 above, 2 end (right), 3 start (left) — menus, popovers, selects,
    // and the tooltip's own side placements. 4..9 are the tooltip placements
    // proper: above (4,5,6) or below (7,8,9) the trigger, aligned to its START,
    // CENTRE or END along the cross axis. That alignment is what the six
    // top-left / top-centre / top-right / bottom-* names are, and it rides in
    // the same byte as the side so no per-node field had to be added.
    let mut side = code
    let mut cross = -1 /* -1 = the side's own default (start for above/below) */
    if code >= 4 {
        if code <= 6 {
            side = 1
            cross = code - 4
        } else {
            side = 0
            cross = code - 7
        }
    }
    let mut x = ax
    let mut y = ay + ah + gap
    if side == 1 {
        y = ay - h - gap
    } else if side == 2 {
        x = ax + aw + gap
        y = ay
    } else if side == 3 {
        x = ax - w - gap
        y = ay
    }
    if cross == 1 {
        x = ax + aw / 2 - w / 2
    } else if cross == 2 {
        x = ax + aw - w
    }
    if int(nodes.pin[id].flip) != 0 {
        if y + h > bottom {
            let alt = ay - h - gap
            if alt >= top {
                y = alt
            }
        }
        if y < top {
            let alt = ay + ah + gap
            if alt + h <= bottom {
                y = alt
            }
        }
        if x + w > right {
            let altx = ax + aw - w
            if altx >= left {
                x = altx
            }
        }
        if x < left {
            x = left
        }
    }
    // Keep the panel inside the *safe* rect on each axis where the trigger is
    // still visible. (0, 0) is the desktop origin; on a notched host the
    // usable origin is (left, top). A trigger scrolled out of the safe area
    // takes the floater with it rather than pinning it to an edge.
    if (ay + ah > top) && (ay < bottom) {
        if y < top {
            y = top
        }
    }
    if (ax + aw > left) && (ax < right) {
        if x < left {
            x = left
        }
    }
    // `x` / `y` are *window* coordinates, which is what the flip test above
    // needs and what the paint pass expects: an anchored floater is painted with
    // the scrollers' offsets reset, so it does not drift by the scroll amount.
    nodes.box[id].x = x
    nodes.box[id].y = y
    layout_node(id, x, y, w, h)
    arena.live_anchors = arena.live_anchors + 1
}

/** *A scroll moved under live floaters: re-place every anchored floater against */
/** *its trigger's new screen rect, leaving the rest of the tree as laid out. */
fn replace_anchored() {
    if arena.root_id <= 0 {
        return
    }
    arena.live_anchors = 0
    place_anchored(arena.root_id)
}

fn place_anchored(id: int) {
    if id <= 0 {
        return
    }
    let nk = nodes.tree[id].kids.len
    for i in 0..nk {
        let c = nodes.tree[id].kids[i]
        if c > 0 {
            if nodes.is_placed(c) != 0 {
                place_node(c)
            }
            place_anchored(c)
        }
    }
}
