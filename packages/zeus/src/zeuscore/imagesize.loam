/** *Low 32 bits of `value`, as a signed `int` (a PNG width can exceed 2^31-1). */
fn signed_low32(value: i64) -> int {
    let sign_bit = i64(2147483647) + i64(1)
    if value >= sign_bit {
        return int(value - sign_bit - sign_bit)
    }
    return int(value)
}

fn big_endian_u32(bytes: &[4096]u8, index: int) -> int {
    let value = i64(int(bytes[index])) * 16777216 + i64(int(bytes[index + 1])) * 65536 +
        i64(int(bytes[index + 2])) * 256 + i64(int(bytes[index + 3]))
    return signed_low32(value)
}

fn big_endian_u16(bytes: &[4096]u8, index: int) -> int {
    return (int(bytes[index]) << 8) + int(bytes[index + 1])
}

fn little_endian_u16(bytes: &[4096]u8, index: int) -> int {
    return int(bytes[index]) + (int(bytes[index + 1]) << 8)
}

fn four_bytes(bytes: &[4096]u8, index: int, b0: int, b1: int, b2: int, b3: int) -> bool {
    return int(bytes[index]) == b0 &&
        int(bytes[index + 1]) == b1 &&
        int(bytes[index + 2]) == b2 &&
        int(bytes[index + 3]) == b3
}

/** *1 when `text` begins with `prefix`. Stops at a NUL, as a C string does. */
fn c_prefix(text: string, prefix: string) -> bool {
    if prefix.len > text.len {
        return false
    }
    let mut index = 0
    while index < prefix.len {
        let byte = text[index]
        if byte == 0 || byte != prefix[index] {
            return false
        }
        index = index + 1
    }
    return true
}

/** *SOF is C0..CF except C4 (Huffman), C8 and CC. Height at +5, width at +7. */
fn jpeg_size(bytes: &[4096]u8, count: int, width: &mut int, height: &mut int) {
    let mut index = 2
    while index + 9 <= count {
        if int(bytes[index]) != 0xFF {
            index = index + 1
        } else {
            let marker = int(bytes[index + 1])
            if marker == 0xFF || marker == 0x00 {
                index = index + 1
            } else if marker == 0xD8 || marker == 0x01 || (marker >= 0xD0 && marker <= 0xD7) {
                index = index + 2
            } else if marker == 0xD9 || marker == 0xDA {
                return
            } else if marker >= 0xC0 && marker <= 0xCF && marker != 0xC4 && marker != 0xC8 && marker != 0xCC {
                *height = big_endian_u16(bytes, index + 5)
                *width = big_endian_u16(bytes, index + 7)
                return
            } else {
                index = index + 2 + big_endian_u16(bytes, index + 2)
            }
        }
    }
}

fn png_signature(bytes: &[4096]u8) -> bool {
    return int(bytes[0]) == 0x89 &&
        int(bytes[1]) == 0x50 &&
        int(bytes[2]) == 0x4E &&
        int(bytes[3]) == 0x47 &&
        int(bytes[4]) == 0x0D &&
        int(bytes[5]) == 0x0A &&
        int(bytes[6]) == 0x1A &&
        int(bytes[7]) == 0x0A
}

fn gif_signature(bytes: &[4096]u8) -> bool {
    if int(bytes[0]) != 0x47 ||
        int(bytes[1]) != 0x49 ||
        int(bytes[2]) != 0x46 ||
        int(bytes[3]) != 0x38 ||
        int(bytes[5]) != 0x61 {
        return false
    }
    let version = int(bytes[4])
    return version == 0x37 || version == 0x39
}

/** *VP8L: 14-bit width and height packed after the 0x2F signature byte. */
fn webp_lossless(bytes: &[4096]u8, width: &mut int, height: &mut int) {
    let low = int(bytes[21])
    let mid = int(bytes[22])
    let high = int(bytes[23])
    let top = int(bytes[24])
    *width = (low + ((mid & 0x3F) << 8)) + 1
    *height = ((mid >> 6) + (high << 2) + ((top & 0x0F) << 10)) + 1
}

/** *Writes a size only when `count` bytes are a format this knows. */
fn read_header(bytes: &[4096]u8, count: int, width: &mut int, height: &mut int) {
    if count >= 24 && png_signature(bytes) {
        *width = big_endian_u32(bytes, 16)
        *height = big_endian_u32(bytes, 20)
        return
    }
    if count >= 10 && gif_signature(bytes) {
        *width = little_endian_u16(bytes, 6)
        *height = little_endian_u16(bytes, 8)
        return
    }
    if count >= 4 && int(bytes[0]) == 0xFF && int(bytes[1]) == 0xD8 {
        jpeg_size(bytes, count, width, height)
        return
    }
    if count >= 30 &&
        four_bytes(bytes, 0, 0x52, 0x49, 0x46, 0x46) &&
        four_bytes(bytes, 8, 0x57, 0x45, 0x42, 0x50) {
        if four_bytes(bytes, 12, 0x56, 0x50, 0x38, 0x58) {
            *width = int(bytes[24]) + (int(bytes[25]) << 8) + (int(bytes[26]) << 16) + 1
            *height = int(bytes[27]) + (int(bytes[28]) << 8) + (int(bytes[29]) << 16) + 1
            return
        }
        if four_bytes(bytes, 12, 0x56, 0x50, 0x38, 0x20) {
            if int(bytes[23]) != 0x9D || int(bytes[24]) != 0x01 || int(bytes[25]) != 0x2A {
                return
            }
            *width = little_endian_u16(bytes, 26) & 0x3FFF
            *height = little_endian_u16(bytes, 28) & 0x3FFF
            return
        }
        if four_bytes(bytes, 12, 0x56, 0x50, 0x38, 0x4C) && count >= 25 && int(bytes[20]) == 0x2F {
            webp_lossless(bytes, width, height)
        }
    }
}

/** *"base64," as bytes. A one-byte state machine, so a miss is one compare. */
let base64_marker: [7]int = [7]int { 98, 97, 115, 101, 54, 52, 44 }

/** *Base64 body of a `data:` URI, then the header. */
fn data_uri_size(uri: string, width: &mut int, height: &mut int) {
    let limit = uri.len
    let mut index = 0
    let mut matched = 0
    while index < limit && matched < 7 {
        let byte = uri[index]
        if byte == 0 {
            return
        }
        index = wrapping_add(index, 1)
        if byte == base64_marker[matched] {
            matched = matched + 1
        } else if byte == 98 {
            matched = 1
        } else {
            matched = 0
        }
    }
    if matched != 7 || index >= limit || uri[index] == 0 {
        return
    }
    let mut count = 0
    let mut accumulator = 0
    let mut bits = 0
    while index < limit && count < HEADER_LIMIT {
        let byte = uri[index]
        if byte == 0 {
            break
        }
        let value = base64_value_of[byte]
        index = wrapping_add(index, 1)
        if value < 0 {
            continue
        }
        accumulator = wrapping_add(wrapping_shl(accumulator, 6), value)
        bits = wrapping_add(bits, 6)
        if bits >= 8 {
            bits = wrapping_sub(bits, 8)
            header_bytes[count] = u8(wrapping_and(wrapping_shr(accumulator, bits), 255))
            count = wrapping_add(count, 1)
        }
    }
    if count > 0 {
        read_header(&header_bytes, count, width, height)
    }
}

/** *First 4096 bytes of a local file, then the header. */
fn file_size(path: string, width: &mut int, height: &mut int) {
    let file_bytes = read_head(path, HEADER_LIMIT)
    let mut count = file_bytes.len
    if count > HEADER_LIMIT {
        count = HEADER_LIMIT
    }
    if count <= 0 {
        return
    }
    let mut copied = 0
    while copied < count {
        header_bytes[copied] = file_bytes[copied]
        copied = copied + 1
    }
    read_header(&header_bytes, count, width, height)
}

/** *`data:` is decoded here. `http(s)://` stays unknown. Anything else is a file. */
fn read_source(src: string, width: &mut int, height: &mut int) {
    if src.len <= 0 || src[0] == 0 {
        return
    }
    if c_prefix(src, "data:") {
        data_uri_size(src, width, height)
        return
    }
    if c_prefix(src, "http://") || c_prefix(src, "https://") {
        return
    }
    let path = if c_prefix(src, "file://") { str.slice(src, 7, src.len) } else { src }
    file_size(path, width, height)
}

/** *The media player slot a `"media:<n>"` source names, or -1. */
fn media_slot(src: string) -> int {
    if !c_prefix(src, "media:") {
        return -1
    }
    let mut index = 6
    while index < src.len && (src[index] == 32 || src[index] == 9) {
        index = index + 1
    }
    let mut sign = 1
    if index < src.len && src[index] == 45 {
        sign = -1
        index = index + 1
    } else if index < src.len && src[index] == 43 {
        index = index + 1
    }
    let mut val = 0
    while index < src.len && src[index] >= 48 && src[index] <= 57 {
        val = val * 10 + (src[index] - 48)
        index = index + 1
    }
    return val * sign
}

/** *Host hook first. The header fallback runs only when either side is still unknown. */
fn measure(src: string, width: &mut int, height: &mut int) {
    let slot = media_slot(src)
    if slot >= 0 {
        *width = mediastate.get(slot, 4)
        *height = mediastate.get(slot, 5)
        return
    }
    if host_bound < 0 {
        host_bound = image_host_bound()
    }
    let mut host_width = 0
    let mut host_height = 0
    if host_bound != 0 {
        platform.plat_image_size(src, &mut host_width, &mut host_height)
    }
    if host_width <= 0 || host_height <= 0 {
        // `data:` is the hot path: one call, not the file/http dispatch.
        if src.len >= 5 &&
            src[0] == 100 &&
            src[1] == 97 &&
            src[2] == 116 &&
            src[3] == 97 &&
            src[4] == 58 {
            data_uri_size(src, &mut host_width, &mut host_height)
        } else {
            read_source(src, &mut host_width, &mut host_height)
        }
    }
    *width = host_width
    *height = host_height
}
