// imagesize — intrinsic width and height of an image source (R4.4).
//
// The host reports a decoded size when it has one. Until then (headless
// layout, a host without the hook, a source it has not decoded) the container
// header of the common web formats is enough: layout only needs the aspect
// ratio. 0 means unknown, and a source this does not recognise leaves the
// caller's width and height as the host set them.
//
// `read_head` is the one filesystem call. Everything else is bytes.
//
// The base64 body is decoded into `header_bytes`, grown once to 4096.

import "std:str"
import "std:sys"
import "mediastate.loam"
import "platform.loam"

/** *First `cap` bytes of `path`, or empty on wasm and on any failure. */
fn read_head(path: string, cap: int) -> []u8 {
    return sys.read_prefix(path, cap)
}

/** *1 when the host has an image-size hook. Hosts bind it before `main`. */
#[os("wasm")]
fn image_host_bound() -> int {
    return 1
}

#[os("posix", "windows")]
fn image_host_bound() -> int {
    return native_image_host_bound()
}

fn native_image_host_bound() -> int {}

/** *-1 until the first `measure`. The hook is not rebound after that. */
let mut host_bound: int = -1

const HEADER_LIMIT: int = 4096

