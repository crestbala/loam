// zeusraster — Zeus's software rasterizer, opt-in.
//
// The core (`zeus`) records a draw list and hands it to the host's 2D API.
// This module is a second consumer of the same list: it rasterizes it in Loam
// into one framebuffer it owns (geometry, glyph atlas, image decode, SVG), and
// hands the pixels to a host through `plat_blit`. A host that can only blit —
// or a headless test that wants pixels — imports this; nothing in the core
// does, so an app that does not import it does not compile it.
//
//     zeus.engine_layout(w, h)
//     zeus.engine_paint()
//     zeusraster.raster_ensure(w, h, 2)
//     zeusraster.scene_rasterize(2, 255, 255, 255)
//     zeusraster.raster_blit()

import "zeuscore/arena.loam"
import "zeusraster/atlas.loam"
import "zeusraster/image.loam"
import "zeusraster/pass.loam"
import "zeusraster/raster.loam"
import "std:fmt"
import "std:sys"

