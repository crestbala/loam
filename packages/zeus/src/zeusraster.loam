fn raster_push_str(b: &mut []int, s: string) {
    let mut i = 0
    while i < s.len {
        b.push(s[i])
        i = i + 1
    }
}

/** *The zero-copy blit contract, Loam side: the framebuffer's generation. A host */
/** *wraps the buffer once with a no-copy data provider (CGImage on native, a */
/** *typed-array view on web) and rebuilds that wrapper ONLY when this number */
/** *changes — which is reallocation, on a size or backing-scale change, not per */
/** *frame. Between changes the same bytes are handed over untouched, so there is */
/** *no per-frame full-buffer copy. */
fn raster_blit_generation() -> int {
    return raster.raster_generation()
}

/** *Blit the framebuffer we rasterized into to the host: the one place our */
/** *pixels leave the engine, and the only host call that is not a draw op. */
/** *Returns 1 when a host presented, 0 when none is listening (headless, or a */
/** *host without a blit path). Pair it with `scene_rasterize` to drive a frame */
/** *with our own rasterizer instead of the host's 2D API. */
fn raster_blit() -> int {
    return pass.raster_blit()
}

/** *Write the framebuffer as a binary PPM (P6). This is the headless capture */
/** *path: no graphics API, just the bytes we own, which is what lets a pixel */
/** *golden exist without a display. Returns 0 on success. */
fn raster_dump_ppm(path: string) -> int {
    let w = raster.raster_width()
    let h = raster.raster_height()
    let mut b: []int = []int {}
    raster_push_str(&mut b, "P6\n{{w}} {{h}}\n255\n")
    let mut y = 0
    while y < h {
        let mut x = 0
        while x < w {
            b.push(raster.raster_get(x, y, 2))
            b.push(raster.raster_get(x, y, 1))
            b.push(raster.raster_get(x, y, 0))
            x = x + 1
        }
        y = y + 1
    }
    return sys.write_file(path, string_from_bytes(b))
}

/** *Set the damage clip from this frame's damage list: the bounding box of the */
/** *damage rects. A bounding box is a superset of the union, so it can only */
/** *damage MORE than needed, never less — the safe direction. A full-damage */
/** *frame (or no damage) clears the clip. */
fn raster_clip_from_damage() {
    raster.raster_clip_reset()
    if arena.damage_full != 0 {
        return
    }
    let n = arena.damage.len
    if n == 0 {
        return
    }
    let mut x0 = arena.damage[0].x
    let mut y0 = arena.damage[0].y
    let mut x1 = arena.damage[0].x + arena.damage[0].w
    let mut y1 = arena.damage[0].y + arena.damage[0].h
    let mut i = 1
    while i < n {
        let d = arena.damage[i]
        if d.x < x0 {
            x0 = d.x
        }
        if d.y < y0 {
            y0 = d.y
        }
        if d.x + d.w > x1 {
            x1 = d.x + d.w
        }
        if d.y + d.h > y1 {
            y1 = d.y + d.h
        }
        i = i + 1
    }
    if x1 > x0 {
        if y1 > y0 {
            raster.raster_clip_box(x0, y0, x1, y1)
        }
    }
}

/** *Phase 4 diagnostics: build the frame's raster tile list from the damage list */
/** *(Phase 1) and return how many tiles it touches. Additive. */
fn damage_tiles_build() -> int {
    return pass.damage_tiles_build()
}

fn damage_tiles_count() -> int {
    return pass.damage_tiles_count()
}

fn damage_tiles_x(i: int) -> int {
    return pass.damage_tiles_x(i)
}

fn damage_tiles_y(i: int) -> int {
    return pass.damage_tiles_y(i)
}


/** *The rasterizer's side of the `ZEUS_MEM` report: glyph atlas and image cache. */
/** *The core's `mem_report` covers the arena; call this after it when the */
/** *software path is in use. */
fn mem_report() {
    fmt.println(
        "ZEUS_MEM bytes glyphs=",
        atlas.atlas_mem_bytes(),
        " atlas_entries=",
        atlas.atlas_entry_count(),
        " glyph_rasters=",
        atlas.atlas_raster_count(),
    )
    fmt.println(
        "ZEUS_MEM bytes images=",
        image.img_mem_bytes(),
        " image_entries=",
        image.img_cache_count(),
        " image_decodes=",
        image.src_decode_count(),
    )
}
