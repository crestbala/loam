//! organisms — the section-level pieces: Card and Comp, Accordion, Popover,
//! Menu, Drawer, Tooltip, HoverCard, Toast, Dialog, Combobox, Navbar, Table and
//! VirtualTable, the charts, the calendar / DatePicker, Page, and Carousel.
//!
//! Built on `molecules`, `atoms`, and `zeusbase`.

import "zeus:structs"
import "zeus:enums"
import "zeus:zeusbase"
import "std:result"
import "zeus-components:colors"
import "zeus-components:spacing"
import "zeus:zeus_constants"
import "std:async"
import "std:fmt"
import "zeus-components:atoms"
import "zeus-components:molecules"

/// One column of a `VirtualTable`. `width` 0 means the column takes an equal
/// share of the row (pair cells with `set_flex_basis_zero(...).grow(1)`); a positive value
/// is a pixel width. `title` is the header cell.
struct TableCol {
    title: string,
    width: int,
    /// Cell alignment for this column: `Align.Start` (default), `Center`,
    /// or `End` — numbers go `End`. `TableCols` aligns the header and
    /// `TableRowCols` the body cells.
    align: int = 0,
    /// true = the header is a sort trigger (see `TableCols`' `sort`).
    sortable: bool = false,
}

/// Extras for `TableCols`: `sort` is the sort state. `0` = none; `i + 1` =
/// column `i` ascending; `-(i + 1)` = descending. Clicking a sortable header
/// cycles none → asc → desc → none on its column and clears the others; the
/// app orders its rows from the signal. An arrow marks the sorted column.
struct TableColsProps {
    sort: Option<Signal<int>> = none,
}

/// Extras for `TableRow` / `TableRowCols`. `zebra` shades every second body
/// row (counted among the row's siblings, so a header does not count);
/// `hover` washes the row under the pointer; `on_click` makes the row a
/// pointer target (hover implied).
struct TableRowProps {
    zebra: bool = false,
    hover: bool = false,
    on_click: Option<fn()> = none,
}

/// Windowed table. `rows` is `zeus.signal([]T {})` where `T` is a row struct;
/// `cols` is `[]TableCol` (title + width) for the header. The body is a
/// `VirtualList` of `build(i, row)` — only visible rows are mounted. The
/// themed header (`TableCols`) shares its gutter with body rows; build every
/// cell with `set_flex_basis_zero(...).grow(1)` (or a fixed `.set_width(px)` matching the column)
/// so body columns line up under the header.
/// Extras for `VirtualTable`: `sort` wires the header (see `TableColsProps`).
/// The window owns its row builder, so the app sets the row order:
/// `rows.set(sort_cells(rows.get(), cells, sort.get()))`.
struct VirtualTableProps {
    sort: Option<Signal<int>> = none,
}

fn VirtualTable<T>(
    rows: Signal<[]T>,
    cols: []TableCol,
    row_h: int,
    build: fn(int, T) -> Node,
    p: VirtualTableProps
) -> Node {
    return Box(style = Style(direction = Direction.Column, grow = 1), role = "table") {
        TableCols(cols, sort = p.sort)
        VirtualList(rows, row_h, build)
    }
}

/// Build your own widget: extends `Component` via `Box`. Trailing block is
/// the slot. `bind` / `visible` / `press` are the same lifecycle as every
/// other widget — pass them here, do not call `ui_push` / `bind` / `show`.
fn Comp(p: BoxProps) -> Node {
    // A clickable custom widget presses like a button.
    let press = p.press || result.is_some(p.on_click)
    return Component(
        raw_box(),
        style = p.style,
        ref = p.ref,
        keys = p.keys,
        role = p.role,
        label = p.label,
        on_click = p.on_click,
        hoverOff = p.hoverOff,
        bind = p.bind,
        visible = p.visible,
        press = press,
        focusable = p.focusable,
        roving = p.roving,
        rovingGrab = p.rovingGrab,
        checked = p.checked,
        hoverFade = p.hoverFade,
        pressScale = p.pressScale,
        lift = p.lift,
        enter = p.enter,
        label = p.label,
        loading = p.loading,
        on_hover = p.on_hover,
    )
}

struct ComboboxProps {
    placeholder: string = "Search",
    /// `Size` token: the field is `control_h(size)` tall.
    size: int = Size.Md,
    /// Draws the danger edge (a `Field` with an `error` sets it).
    invalid: bool = false,
    /// Dims the field and makes it inert.
    disabled: bool = false,
    /// Accessible name. Empty uses the placeholder.
    label: string = "",
    /// Style, merged over the recipe's own: `style = Style(radius = 4)`.
    style: Option<fn() -> Style> = none,
}

/// A text field with a filtered option list below it. Clicking the field (or
/// its chevron), typing, or Down opens the list; an empty query shows every
/// option. Up / Down move the highlight, Enter picks the highlighted option into
/// the field, Escape or an outside click closes. `text` is the one piece of state
/// and belongs to the caller. Options should be unique: the list is keyed by
/// label (`zeus.Each`).
fn Combobox(text: Signal<string>, options: []string, p: ComboboxProps) -> Node {
    // state
    let active = signal(-1)
    let matches = signal([]string {})
    let opts = options
    // The list keeps the field's width (the caller's, or 240).
    let w = len_or(style_of(p.style).width, 240)
    let field = ref()
    let input = ref()
    fn open() -> bool {
        return active.get() >= 0
    }

    // controller
    effect(|| {
        matches.set(combo_filter(opts, text.get()))
    })
    // Open on click whether the pointer lands on the field frame, the chevron,
    // or the text area itself. The inner input consumes its click (it is
    // focusable, so the engine stops walking up the tree there), so both get
    // the handler; it is idempotent.
    fn open_list() {
        focus(input)
        if active.get() < 0 {
            active.set(0)
        }
    }
    // A focused text field consumes Enter before any keymap chord sees it, so
    // the list keys are read in `on_key_down` via `current_key()`.
    fn list_key() {
        let picked = combo_key(active, matches)
        if picked >= 0 {
            let ms = matches.get()
            if picked < ms.len {
                text.set(ms[picked])
            }
            active.set(-1)
        }
    }

    // view. The scrim comes first so the field and list draw over it.
    return Box(style = Style(direction = Direction.Column, alignSelf = Align.Start)) {
        Overlay(
            on_click = fn() { active.set(-1) },
            style = Style(display = shown(open()), zIndex = Z_SCRIM),
        )
        Box(
            ref = field,
            style = field_chrome(p.size, invalid = p.invalid, width = w, zIndex = Z_FIELD),
            restyle = p.style,
            on_click = open_list,
            focusable = false,
            enabled = !p.disabled,
        ) {
            Input(
                ref = input,
                bind = text,
                placeholder = p.placeholder,
                style = Style(grow = 1, font = control_font(p.size), padding = 0, color = ink()),
                label = field_name(p.label, p.placeholder),
                on_click = open_list,
                on_key_down = list_key,
            )
            InputClear(text, input)
            Icon(IC_CHEV_DOWN, control_icon(p.size), dim())
        }
        Box(
            style = floating_panel(0, width = w),
            anchor = Anchor(to = field, place = Place.PlaceBelow, gap = Space.Exxxs),
            visible = open(),
            enter = Enter.Fade + Enter.Pop,
        ) {
            Each(matches.get(), fn(i, s) {
                return ComboRow(text, active, input, i, s)
            })
        }
    }
}

/// One option row of a `Combobox`. Picking writes the label into the field.
fn ComboRow(
    text: Signal<string>,
    active: Signal<int>,
    input: Ref,
    index: int,
    label: string
) -> Node {
    // controller
    fn pick() {
        text.set(label)
        active.set(-1)
    }

    // view
    return Box(
        // Hover moves `active` (below), so one fill marks the pointer's row
        // and the keyboard's.
        style = Style(
            direction = Direction.Row,
            gap = Space.Exxxs,
            align = Align.Center,
            paddingY = 6,
            paddingX = Space.Exs,
            radius = RAD_SM,
            background = row_fill(active.get() == index),
            cursor = "pointer",
        ),
        role = "option",
        label = label,
        checked = active.get() == index,
        hoverOff = false,
        on_click = pick,
        on_hover = fn(on: bool) {
            if on {
                active.set(index)
            }
        },
        focusable = false,
    ) {
        Text(label, style = Style(font = FONT_BODY, color = ink()))
    }
}

/// A single-open accordion. `open` is the *only* state: the open item's index,
/// or `-1` for all closed. Items take the shared signal and their own `index`;
/// no item owns state. Opening one closes the rest by construction — there is
/// one index, so two items can never both match it.
fn Accordion(open: Signal<int>, p: AccordionProps) -> Node {
    // state. One ref per header, so up / down can hand focus to a sibling.
    let mut heads = []Ref {}
    for _ in 0..p.items.len {
        push(heads, ref())
    }

    // view. Clip the rounded corners, so a body cannot spill past the card edge.
    return Box(
        style = Style(
            direction = Direction.Column,
            radius = RAD_LG,
            borderWidth = HAIRLINE,
            borderColor = rule(),
            background = plate(),
            overflow = Overflow.Hidden,
        ),
        restyle = p.style,
        bind = p.bind,
    ) {
        Each(p.items, (index, item) => {
            AccordionItem(
                open = open,
                index = index,
                title = item.title,
                body = item.body,
                heads = heads,
            )
        })
    }
}

struct AccordionProps {
    bind: Option<Signal<int>> = none,
    items: []AccordionRow,
    /// Style, merged over the recipe's own: `style = Style(radius = 4)`.
    style: Option<fn() -> Style> = none,
}

struct AccordionItemProps {
    /// The accordion's single open-index signal (`-1` = all closed).
    open: Signal<int> = Signal { id: 0 },
    /// This item's index within its accordion.
    index: int = 0,
    /// Header label.
    title: Signal<string> = "",
    /// Body copy, shown while this item is open.
    body: Signal<string> = "",
    /// Optional leading icon markup.
    icon: string = "",
    /// Every header in the accordion, by index (`Accordion` fills it). Up /
    /// down / Home / End move focus along it; empty, the keys are off.
    heads: []Ref = []Ref {},
}

/// One row of an `Accordion`. Reads the shared `open` signal and compares it to
/// `index`, so it holds no state of its own: the chevron rotates on a paint-only
/// track and the body fades in, both driven by the container's one signal.
fn AccordionItem(p: AccordionItemProps) -> Node {
    // state
    let open = p.open
    let idx = p.index

    // controller
    fn is_open() -> bool {
        return open.get() == idx
    }
    fn toggle() {
        open.set(if is_open() { -1 } else { idx })
    }
    // Focus moves between headers; the open item does not follow it.
    fn focus_head(i: int) {
        if i >= 0 && i < p.heads.len {
            focus(p.heads[i])
        }
    }
    let keys = []KeyBind {
        key_bind("down", "accordion.next", fn() { focus_head(idx + 1) }),
        key_bind("up", "accordion.prev", fn() { focus_head(idx - 1) }),
        key_bind("home", "accordion.first", fn() { focus_head(0) }),
        key_bind("end", "accordion.last", fn() { focus_head(p.heads.len - 1) }),
    }
    let head = if idx < p.heads.len { p.heads[idx] } else { ref() }

    // view. A rule between items; the body is its own block under the head,
    // so the copy never sits on the title or on the next rule.
    return Box(style = Style(direction = Direction.Column)) {
        if idx > 0 {
            Separator()
        }
        DisclosureHead(p.title, is_open, toggle, icon = p.icon, keys = keys, ref = head)
        DisclosureBody(is_open) {
            Text(p.body, style = Style(wrap = true, font = FONT_BODY, color = mute()))
        }
    }
}

struct PopoverProps {
    /// Open while true.
    open: Signal<bool> = Signal { id: 0 },
    /// Preferred side (`Place.*`); flips when it would overflow.
    place: int = 0,
    gap: int = 6,
    closeKey: string = "escape",
    /// The element the panel floats beside; built here, so the panel can
    /// anchor to it.
    trigger: fn() = noop,
    /// The trailing block: the panel body.
    children: fn() = noop,
    /// Style, merged over the recipe's own: `style = Style(radius = 4)`.
    style: Option<fn() -> Style> = none,
}

/// A floating panel anchored to `trigger`. `open` is a bool signal; outside
/// click and Escape close it. Edge-aware: `place` is preferred, flipped when
/// it would leave the safe-area rect. Trailing block is the panel body.
fn Popover(p: PopoverProps) -> Node {
    // state
    let open = p.open
    let host = ref()

    // controller
    fn close() {
        open.set(false)
    }

    // keys
    let keys = []KeyBind { key_bind(p.closeKey, "popover.close", close) }

    // view. The host holds only the trigger in flow, so the panel anchors to
    // it; the transparent scrim (outside click closes) and the panel float.
    // Focus moves into the open panel, so Escape reaches it.
    return Box(ref = host) {
        p.trigger()
        Overlay(visible = open.get(), on_click = close, style = Style(zIndex = Z_SCRIM))
        Box(
            style = floating_panel(0, gap = Space.Xs, padding = Space.Sm),
            restyle = p.style,
            anchor = Anchor(to = host, place = p.place, gap = p.gap),
            autofocus = open.get(),
            visible = open.get(),
            enter = Enter.Fade + Enter.Pop,
            keys = keys,
        ) {
            p.children()
        }
    }
}

struct MenuProps {
    /// Open at this item index; `-1` is closed. The menu's only state. Pass
    /// one to observe or drive the menu from outside; omitted, the menu owns it.
    active: Option<Signal<int>> = none,
    items: []MenuRow,
    /// Runs with the picked row's index. Rows are plain data; this is the one
    /// callback for the whole menu.
    on_select: Option<fn(int)> = none,
    label: string = "",
    /// Preferred side (`Place.*`); flips when it would overflow.
    place: int = 0,
    gap: int = 4,
    /// Chord that dismisses the open menu.
    closeKey: string = "escape",
    /// The element that opens the menu; clicking it toggles.
    trigger: fn() = noop,
    /// The trailing block: more rows after `items` (`MenuItem`, ...).
    children: fn() = noop,
    /// Style, merged over the recipe's own: `style = Style(radius = 4)`.
    style: Option<fn() -> Style> = none,
}

/// A dropdown menu anchored to `trigger`. Clicking the trigger toggles it;
/// outside click and Escape close it; `place` is preferred and flips near the
/// viewport edge. The trailing block is the item list (`MenuItem` /
/// `MenuLabel` / `MenuSeparator`).
fn Menu(p: MenuProps) -> Node {
    // state. `active` is the menu's only state; omitted, the menu owns it.
    let active = if result.is_some(p.active) { p.active.val } else { signal(-1) }
    let host = ref()
    fn open() -> bool {
        return active.get() >= 0
    }

    // controller. A press on the trigger toggles; opening lands on the first item.
    fn toggle() {
        active.set(if open() { -1 } else { 0 })
    }
    fn close() {
        active.set(-1)
    }

    // keys. Escape closes while focus is inside the menu.
    let keys = []KeyBind { key_bind(p.closeKey, "menu.dismiss", close) }

    // view. The host wraps the trigger so the panel can anchor to it.
    // `click_built` puts the toggle on the trigger itself: that node is
    // what the pointer hits.
    return Box(ref = host) {
        click_built(p.trigger, toggle)
        Overlay(
            on_click = close,
            style = Style(display = shown(open()), zIndex = Z_SCRIM),
        )
        Box(
            style = floating_panel(MENU_MIN_W, cursor = "pointer"),
            restyle = p.style,
            anchor = Anchor(to = host, place = p.place, gap = p.gap),
            visible = open(),
            role = "menu",
            enter = Enter.Fade + Enter.Pop,
            keys = keys,
        ) {
            if p.label.len > 0 {
                MenuLabel(p.label)
            }
            Each(p.items, fn(index, item) {
                if item.isSeparated {
                    // One root per row: the separator rides with its item,
                    // spaced as if both were rows of the panel.
                    return Column(PANEL_GAP) {
                        MenuSeparator()
                        MenuItem(
                            active = active,
                            index = index,
                            count = p.items.len,
                            label = item.label,
                            danger = item.danger,
                            on_click = fn() => emit_with(p.on_select, index),
                        )
                    }
                }
                return MenuItem(
                    active = active,
                    index = index,
                    count = p.items.len,
                    label = item.label,
                    danger = item.danger,
                    on_click = fn() => emit_with(p.on_select, index),
                )
            })
            p.children()
        }
    }
}

struct MenuItemProps {
    /// The menu's one signal; the item compares it to `index`.
    active: Option<Signal<int>> = none,
    /// This item's position within its menu.
    index: int = 0,
    /// How many items the menu has, so Up / Down clamp at the ends. Pass the
    /// same number to every item.
    count: int = 0,
    label: Signal<string> = "",
    /// Optional leading icon markup.
    icon: string = "",
    on_click: Option<fn()> = none,
    disabled: bool = false,
    /// Destructive command: painted in the danger ink.
    danger: bool = false,
}

/// One command row. Highlights while `active == index`; the pointer moves
/// `active` on hover, so pointer and keyboard share one highlight. Owns no
/// state — the menu's `active` is the only signal.
fn MenuItem(p: MenuItemProps) -> Node {
    // state
    let active = result.some_or(p.active, no_signal())
    let idx = p.index
    let n = p.count
    let off = p.disabled
    let row_ink = if p.danger { danger_ink() } else { ink() }

    // controller. A pick closes the menu the way everything else does.
    fn run() {
        if !off {
            emit(p.on_click)
            active.set(-1)
        }
    }
    fn next() {
        if active.get() >= 0 {
            if active.get() + 1 < n {
                active.set(active.get() + 1)
            }
        }
    }
    fn prev() {
        if active.get() > 0 {
            active.set(active.get() - 1)
        }
    }

    // keys. Every handler is gated on `active`, so keys pressed after a close
    // are inert even if this (now hidden) row is still the focused one.
    let keys = []KeyBind {
        key_bind("down", "menu.next", next),
        key_bind("up", "menu.prev", prev),
        key_bind("enter", "menu.activate", fn() {
            if active.get() == idx {
                run()
            }
        }),
    }

    // view. Hover moves the highlight, so the pointer and the keyboard agree;
    // only the active row is a tab stop, and it takes focus as it activates.
    // `hoverStyle` gives the same raised fill before `on_hover` runs.
    return Box(
        hoverStyle = Style(background = raised()),
        style = Style(
            direction = Direction.Row,
            gap = Space.Xs,
            align = Align.Center,
            paddingY = 7,
            paddingX = 10,
            radius = RAD_SM,
            background = row_fill(active.get() == idx),
            cursor = "pointer",
        ),
        role = "menuitem",
        label = p.label.get(),
        enabled = !off,
        press = true,
        on_click = run,
        on_hover = fn(on: bool) {
            if on {
                active.set(idx)
            }
        },
        keys = keys,
        roving = active.get() == idx,
        rovingGrab = true,
    ) {
        if p.icon.len > 0 {
            Icon(p.icon, 16, dim())
        }
        Text(p.label, style = Style(grow = 1, font = FONT_BODY, color = row_ink, ellipsis = true))
    }
}

/// A non-interactive group heading inside a `Menu`.
fn MenuLabel(text: Signal<string>) -> Node {
    return Box(style = Style(paddingY = 6, paddingX = 10)) {
        Text(text, style = Style(font = FONT_CAPTION, color = dim()))
    }
}

/// A hairline between menu groups.
fn MenuSeparator() -> Node {
    return Box(style = Style(paddingY = 3)) {
        Separator()
    }
}

struct DrawerProps {
    /// Edge to slide from (`Side.*`). The top / bottom edges are the sheet shape.
    side: int = 1,
    /// Panel extent: width for the start / end edges, height for top / bottom.
    size: int = 320,
    /// Radius of the edge that faces the content (the inner edge). `-1` uses
    /// the sheet default (`RAD_XL`), `0` is square. The outer edge stays square
    /// so the panel meets the window edge cleanly.
    radius: int = -1,
    /// Chord that closes the drawer.
    closeKey: string = "escape",
    /// The trailing block: the body, placed by the component.
    children: fn() = noop,
    /// Style, merged over the recipe's own: `style = Style(radius = 4)`.
    style: Option<fn() -> Style> = none,
}

/// An edge panel over a scrim. `open` is a bool signal; the scrim closes it on
/// outside click and Escape closes it while focus is inside. `side` picks the
/// edge and `size` the extent. Like the Dialog, the panel swallows clicks so a
/// press inside does not close it. Trailing block is the panel content.
fn Drawer(open: Signal<bool>, p: DrawerProps) -> Node {
    // state
    let side = p.side
    let size = p.size
    let across = side == Side.SideStart || side == Side.SideEnd
    let r = px_or_default(p.radius, RAD_XL)
    // How far past its edge the panel rests: all of it while closed.
    fn off() -> int {
        return if open.get() { 0 } else { size }
    }

    // keys
    let keys = []KeyBind { key_bind(p.closeKey, "drawer.close", fn() { open.set(false) }) }

    // view. The overlay pins the panel to the chosen edge (a row for the side
    // edges); the panel swallows clicks so a press inside does not close it.
    // Closed, it rests `size` past its edge. It is a solid sheet, so it does
    // not fade: it glides on with weight, is pulled off speeding up, and takes
    // focus as it opens. Only the inner edge rounds, so the sheet meets the
    // window edge square.
    return Overlay(style = drawer_dock(side), visible = open.get(), on_click = fn() {
        open.set(false)
    }) {
        Box(
            style = Style(
                width = len_px(if across { size } else { -1 }),
                height = len_px(if across { -1 } else { size }),
                direction = Direction.Column,
                gap = Space.Sm,
                padding = Space.Md,
                elevation = FLOAT_LIFT,
                radiusTopLeft = drawer_corner(side, Side.SideBottom, Side.SideEnd, r),
                radiusTopRight = drawer_corner(side, Side.SideBottom, Side.SideStart, r),
                radiusBottomRight = drawer_corner(side, Side.SideTop, Side.SideStart, r),
                radiusBottomLeft = drawer_corner(side, Side.SideTop, Side.SideEnd, r),
                borderWidth = HAIRLINE,
                borderColor = rule(),
                background = plate(),
                shiftX = if side == Side.SideStart {
                    -off()
                } else if side == Side.SideEnd {
                    off()
                } else {
                    0
                },
                shiftY = if side == Side.SideTop {
                    -off()
                } else if side == Side.SideBottom {
                    off()
                } else {
                    0
                },
                transition = if open.get() { Motion.Glide } else { Motion.Fall },
            ),
            restyle = p.style,
            role = "dialog",
            on_click = fn() { return },
            autofocus = open.get(),
            keys = keys,
        ) {
            p.children()
        }
    }
}

/// The scrim a drawer sits on, laid out so the panel docks at its edge and
/// stretches along it.
fn drawer_dock(side: int) -> Style {
    let across = side == Side.SideStart || side == Side.SideEnd
    let at_start = side == Side.SideStart || side == Side.SideTop
    return Style(
        direction = if across { Direction.Row } else { Direction.Column },
        justify = if at_start { Align.Start } else { Align.End },
        align = Align.Stretch,
        opacity = SCRIM_DIM,
        background = scrim(),
    )
}

/// One corner of the sheet: only the corners on the inner edge round, so a
/// corner rounds when the drawer docks at side `a` or `b`.
fn drawer_corner(side: int, a: int, b: int, r: int) -> int {
    if side == a || side == b { r } else { 0 }
}

struct TooltipProps {
    text: Signal<string> = "",
    /// Where the bubble sits (`Place.*`). The six tooltip placements are
    /// `PlaceAboveStart` / `PlaceAboveCenter` / `PlaceAboveEnd` and the three
    /// `PlaceBelow*` — i.e. top-left, top-centre, top-right, bottom-left,
    /// bottom-centre, bottom-right. `PlaceAbove` / `PlaceBelow` still work and
    /// are start-aligned. Defaults to top-centre, which is what a tooltip is.
    place: int = 5,
    gap: int = 6,
    /// Draw the little caret that points at the trigger. Dropped for the side
    /// placements, which have no edge facing the trigger.
    arrow: bool = true,
    /// Delay before showing, in ms (hover intent).
    delay: int = 250,
    /// The element the tooltip describes.
    trigger: fn() = noop,
}

/// 1 when the bubble is above its trigger (so the caret points down).
fn tooltip_above(place: int) -> bool {
    if place == Place.PlaceBelow ||
        place == Place.PlaceBelowStart ||
        place == Place.PlaceBelowCenter ||
        place == Place.PlaceBelowEnd {
        return false
    }
    return true
}

/// A caret only makes sense on an edge that faces the trigger.
fn tooltip_arrow_ok(place: int) -> bool {
    if place == Place.PlaceEnd || place == Place.PlaceStart {
        return false
    }
    return true
}

/// Slide the caret along the trigger's edge to follow the bubble's alignment.
fn tooltip_justify(place: int) -> int {
    if place == Place.PlaceAboveStart || place == Place.PlaceBelowStart {
        return Align.Start
    }
    if place == Place.PlaceAboveEnd || place == Place.PlaceBelowEnd {
        return Align.End
    }
    return Align.Center
}

/// A small non-interactive label shown while the pointer rests on `trigger`.
fn Tooltip(p: TooltipProps) -> Node {
    // state
    let hovered = signal(false)
    let shown = hover_intent(hovered, p.delay)
    let host = ref()
    let above = tooltip_above(p.place)
    let edge = 0 - (TOOLTIP_PAD_Y + TOOLTIP_ARROW / 2)

    // view. The host holds only the trigger in flow: it reports the hover and
    // the panel anchors to it. A tooltip never takes the pointer from its
    // trigger. The caret is a square rotated 45°, straddling the edge that
    // faces the trigger: half on the panel's fill, half outside. Absolute
    // children sit against the panel's content box, so the offset adds the
    // padding back to land the caret's centre on the edge.
    return Box(ref = host, on_hover = fn(on: bool) { hovered.set(on) }) {
        p.trigger()
        Box(
            style = Style(
                direction = Direction.Column,
                position = pos_absolute(),
                zIndex = Z_HOVER,
                paddingY = TOOLTIP_PAD_Y,
                paddingX = TOOLTIP_PAD_X,
                radius = RAD_SM,
                background = ink(),
            ),
            anchor = Anchor(to = host, place = p.place, gap = p.gap),
            passThrough = true,
            visible = shown.get(),
            role = "tooltip",
            label = p.text.get(),
            enter = Enter.Fade + Enter.Pop,
        ) {
            Text(p.text, style = Style(font = FONT_CAPTION, color = on_ink()))
            if p.arrow && tooltip_arrow_ok(p.place) {
                Box(style = Style(
                    height = px(TOOLTIP_ARROW),
                    direction = Direction.Row,
                    justify = tooltip_justify(p.place),
                    position = pos_absolute(),
                    top = opt_when(!above, edge),
                    right = 0,
                    bottom = opt_when(above, edge),
                    left = 0,
                )) {
                    TooltipCaret()
                }
            }
        }
    }
}

/// The tooltip's caret: an ink square turned 45°.
fn TooltipCaret() -> Node {
    return Box(style = Style(
        width = px(TOOLTIP_ARROW),
        height = px(TOOLTIP_ARROW),
        background = ink(),
        rotate = 45,
    ))
}

/// Hover intent: a flag that turns true once `hovered` has held for `delay`
/// ms, and false the moment it ends — so a passing pointer opens nothing.
fn hover_intent(hovered: Signal<bool>, delay: int) -> Signal<bool> {
    let shown = signal(false)
    effect(|| {
        if hovered.get() {
            async.after(delay, fn() {
                if hovered.peek() {
                    shown.set(true)
                }
            })
        } else {
            shown.set(false)
        }
    })
    return shown
}

struct HoverCardProps {
    place: int = 1,
    gap: int = 8,
    /// Delay before showing, in ms. Longer than a tooltip: a hover card is
    /// larger and should not appear under a passing pointer.
    delay: int = 300,
    /// The element that shows the card on hover.
    trigger: fn() = noop,
    /// The trailing block: the card body.
    children: fn() = noop,
    /// Style, merged over the recipe's own: `style = Style(radius = 4)`.
    style: Option<fn() -> Style> = none,
}

/// A hover-triggered panel, larger and interactive where a `Tooltip` is not.
/// Trailing block is the card body.
fn HoverCard(p: HoverCardProps) -> Node {
    // state. Hover intent, longer than a tooltip's.
    let hovered = signal(false)
    let shown = hover_intent(hovered, p.delay)
    let host = ref()

    // view. The shared floating surface, as `Popover` uses. `HOVER_CARD_W` is
    // a default the caller's `style` width replaces: content-sized, a long
    // body would stretch the card instead of wrapping.
    return Box(ref = host, on_hover = fn(on: bool) { hovered.set(on) }) {
        p.trigger()
        Box(
            style = floating_panel(
                0,
                width = HOVER_CARD_W,
                gap = Space.Xs,
                padding = Space.Sm,
                zIndex = Z_HOVER,
            ),
            restyle = p.style,
            anchor = Anchor(to = host, place = p.place, gap = p.gap),
            visible = shown.get(),
            enter = Enter.Fade + Enter.Pop,
        ) {
            p.children()
        }
    }
}

struct ToastProps {
    /// Auto-dismiss after this many ms.
    ms: int = 3200,
    /// 0 = bottom, 1 = top.
    place: int = 0,
    /// The trailing block: the body, placed by the component.
    children: fn() = noop,
    /// Style, merged over the recipe's own: `style = Style(radius = 4)`.
    style: Option<fn() -> Style> = none,
}

/// A transient message pinned to the bottom (or top) of the window. `open` is a
/// bool signal; it dismisses itself after `ms`, or on click. It comes in from
/// its edge and falls back to it. Trailing block is the message.
fn Toast(open: Signal<bool>, p: ToastProps) -> Node {
    // controller. Dismisses itself after `ms`.
    effect(|| {
        if open.get() {
            async.after(p.ms, fn() { open.set(false) })
        }
    })

    // view
    return Overlay(
        visible = open.get(),
        on_click = fn() { open.set(false) },
        style = toast_dock(p.place),
    ) {
        Box(
            style = Style(
                direction = Direction.Row,
                gap = Space.Xs,
                elevation = FLOAT_LIFT,
                align = Align.Center,
                paddingY = Space.Xs,
                paddingX = Space.Sm,
                radius = RAD_MD,
                background = ink(),
                cursor = "pointer",
            ),
            restyle = p.style,
            on_click = fn() { open.set(false) },
            enter = Enter.Fade + (if p.place == 1 { Enter.Drop } else { Enter.Rise }),
        ) {
            p.children()
        }
    }
}

/// Where the toast sits: 24dp in from the bottom (0) or the top (1).
fn toast_dock(place: int) -> Style {
    if place == 1 {
        return Style(justify = Align.Start, paddingTop = Space.Lg)
    }
    return Style(justify = Align.End, paddingBottom = Space.Lg)
}

/// Named extras for `Dialog` / `AlertDialog`. `title` shares the header
/// row with the close control (Dialog) or stands alone (AlertDialog).
struct DialogProps {
    title: string = "",
    /// The trailing block: the body, placed by the component.
    children: fn() = noop,
}

/// Dialog + AlertDialog chrome. Header is a row: title, then `Grow()`, then
/// a fixed 28px close slot (Dialog only). No `position` / `top` / `left`.
fn DialogShell(open: Signal<bool>, close_x: bool, title: string, children: fn()) -> Node {
    // keys
    let keys = []KeyBind { key_bind("escape", "dialog.close", fn() { open.set(false) }) }

    // view. Responsive: 92% of the window, capped at the desktop 440dp, so a
    // phone keeps a gutter instead of clipping the card. The panel swallows
    // clicks so a press inside does not reach the scrim. Tab stays inside
    // the card while it is open.
    return Overlay(
        style = Style(opacity = SCRIM_DIM, background = scrim()),
        visible = open.get(),
        on_click = fn() => open.set(false),
    ) {
        Box(
            style = Style(
                direction = Direction.Column,
                gap = Space.Sm,
                elevation = FLOAT_LIFT,
                maxWidth = DIALOG_W,
                padding = Space.Lg,
                radius = RAD_LG,
                borderWidth = HAIRLINE,
                borderColor = rule(),
                background = plate(),
                width = pct(92),
            ),
            role = "dialog",
            on_click = fn() { return },
            enter = Enter.Fade + Enter.Pop + Enter.Rise,
            focusable = true,
            trap = open.get(),
            keys = keys,
        ) {
            Box(style = Style(direction = Direction.Row, gap = Space.Exs, align = Align.Center)) {
                Title(title)
                Grow()
                if close_x {
                    Box(
                        style = Style(
                            width = px(28),
                            height = px(28),
                            direction = Direction.Row,
                            shrink = 0,
                            align = Align.Center,
                            justify = Align.Center,
                            radius = RAD_MD,
                            cursor = "pointer",
                        ),
                        on_click = fn() => open.set(false),
                        role = "button",
                        label = "Close",
                        focusable = true,
                    ) {
                        Icon(IC_X, 16, mute())
                    }
                }
            }
            children()
        }
    }
}

/// Modal dialog: dim scrim, centered card. Pass `title = "..."` so the
/// heading and close control share one row. Trailing block is the body.
fn Dialog(open: Signal<bool>, p: DialogProps) -> Node {
    return DialogShell(open, true, p.title, p.children)
}

/// AlertDialog: modal confirm with no X. Pass `title = "..."` for the heading.
fn AlertDialog(open: Signal<bool>, p: DialogProps) -> Node {
    return DialogShell(open, false, p.title, p.children)
}

/// Top bar. `dark = true` (default) includes the appearance switch; pass
/// `dark = false` to omit it and put Dark in the trailing chrome yourself.
fn Navbar(brand: string, dark: bool = true) -> Node {
    return Column(0) {
        Box(
            style = Style(
                height = px(BAR),
                direction = Direction.Row,
                gap = Space.Md,
                align = Align.Center,
            ),
            role = "navigation",
        ) {
            Pip(ink(), 10)
            Text(brand, style = Style(font = FONT_TITLE, color = ink()))
            Grow()
            if dark {
                Text("Dark", style = Style(font = FONT_CONTROL, color = mute()))
                ThemeSwitch()
            }
        }
        Separator()
    }
}

/// Docs-style nav item: muted text, a raised fill when active, 36px tall.
fn NavTab(label: string, page: Signal<int>, index: int) -> Node {
    fn active() -> bool {
        return page.get() == index
    }
    return Box(
        style = Style(
            height = px(36),
            direction = Direction.Row,
            gap = Space.Exxs,
            align = Align.Center,
            paddingX = Space.Xs,
            radius = RAD_CONTROL,
            cursor = "pointer",
            background = if active() { raised() } else { paper() },
        ),
        on_click = fn() => page.set(index),
        role = "button",
        label = label,
    ) {
        Text(
            label,
            style = Style(font = FONT_BODY, ellipsis = true, color = if active() {
                ink()
            } else {
                mute()
            }),
        )
    }
}

/// Header row: muted label cells above a hairline. Cells use zero basis +
/// grow so columns split the row evenly and line up with `TableRow`.
fn TableHead(cols: []string) -> Node {
    return Column(Space.Exs) {
        // Same gutter as `TableRow`, so header and cells share column edges.
        Box(style = Style(
            direction = Direction.Row,
            gap = Space.Sm,
            align = Align.Center,
            paddingX = Space.Exs,
        )) {
            Each(cols, fn(i, t) {
                return TableCell(t, 0, Align.Start, mute())
            })
        }
        Separator()
    }
}

/// Is the node about to be built an odd-numbered body row? Counts the
/// current slot parent's `TableRow` kids so far (role `row`), so a header
/// or separator sibling does not shift the stripe.
fn table_row_odd() -> bool {
    return slot_count_role("row") % 2 == 1
}

/// Shell every body row shares: stripe, hover, click, role `row`.
fn TableRowShell(p: TableRowProps) -> Node {
    let fill = if p.zebra && table_row_odd() { raised() } else { "" }
    let cursor = if result.is_some(p.on_click) { "pointer" } else { "" }
    return Box(
        style = Style(
            direction = Direction.Row,
            gap = Space.Sm,
            align = Align.Center,
            padding = Space.Exs,
            radius = RAD_SM,
            background = opt_color(fill),
            cursor = opt_color(cursor),
        ),
        on_click = p.on_click,
        role = "row",
        hoverFade = p.hover || result.is_some(p.on_click),
    )
}

/// A `TableCol.width` as a `Box` width prop: 0 (share the row) is -1 (unset).
fn table_col_width(w: int) -> int {
    if w <= 0 {
        return -1
    }
    return w
}

/// One cell: `width` 0 shares the row, `align` is `Align.*`.
fn TableCell(text: string, width: int, align: int, tint: string) -> Node {
    return Box(style = Style(
        width = if width <= 0 { pct(0) } else { px(table_col_width(width)) },
        grow = if width <= 0 { 1 } else { 0 },
        direction = Direction.Row,
        justify = align,
    )) {
        Text(text, style = Style(font = FONT_BODY, color = tint, ellipsis = true))
    }
}

/// Body row: cells under a hairline, foreground text. Pair with `TableHead`.
/// `zebra` / `hover` / `on_click` are `TableRowProps`.
fn TableRow(cols: []string, p: TableRowProps) -> Node {
    let shell = TableRowShell(p) {
        Each(cols, fn(i, t) {
            return TableCell(t, 0, Align.Start, ink())
        })
    }
    Separator()
    return shell
}

/// Body row laid out by a `[]TableCol` spec: fixed widths and per-column
/// alignment match the `TableCols` header. `cols` beyond `spec` share the
/// row, start-aligned.
fn TableRowCols(cols: []string, spec: []TableCol, p: TableRowProps) -> Node {
    let shell = TableRowShell(p) {
        Each(cols, fn(i, t) {
            let w = if i < spec.len { spec[i].width } else { 0 }
            let al = if i < spec.len { spec[i].align } else { Align.Start }
            return TableCell(t, w, al, ink())
        })
    }
    Separator()
    return shell
}

/// true when `a` and `b` show the same cells in the same order.
fn rows_in_order<T>(a: []T, b: []T, cells: fn(T) -> []string) -> bool {
    if a.len != b.len {
        return false
    }
    for i in 0..a.len {
        if !fmt.eq(cells_key(cells(a[i])), cells_key(cells(b[i]))) {
            return false
        }
    }
    return true
}

/// Index of the row whose cells key is `k` in `rows` (-1 when it is gone).
/// Resolved at click time: a sort moves the row node, so the index it was
/// built with is not where it sits now.
fn table_index_of<T>(rows: Signal<[]T>, cells: fn(T) -> []string, k: string) -> int {
    let xs = rows.get()
    for i in 0..xs.len {
        if fmt.eq(cells_key(cells(xs[i])), k) {
            return i
        }
    }
    return -1
}

/// Extras for `Table`.
struct TableProps {
    /// Sort state (see `TableColsProps`). A change rewrites `rows` into that
    /// column's ascending or descending order.
    sort: Option<Signal<int>> = none,
    zebra: bool = false,
    hover: bool = false,
    /// Row click: index into `rows` as they stand, so `rows.get()[i]` is the item.
    on_pick: Option<fn(int)> = none,
}

/// Data table: a `TableCols` header over rows from a `Signal<[]T>`, each
/// row's text from `cells(t)` (one string per column). Pass `sort` and a
/// header click writes `rows` into that column's order (`sort_cells`):
/// ascending, then descending. Rows are keyed by value, so the reorder moves
/// the existing nodes. A later push is placed by the same column. Clearing
/// the sort (the third click) leaves the rows where the last column put them.
/// `zebra` / `hover` / `on_pick` go to every row. A long list wants
/// `VirtualTable` (windowed) instead.
fn Table<T>(spec: []TableCol, rows: Signal<[]T>, cells: fn(T) -> []string, p: TableProps) -> Node {
    let sort_set = result.is_some(p.sort)
    let sort = result.some_or(p.sort, no_signal())

    effect(|| {
        if sort_set {
            let cur = rows.get()
            let next = sort_cells(cur, cells, sort.get())
            if !rows_in_order(cur, next, cells) {
                rows.set(next)
            }
        }
    })

    // One top-level child per item, so `Each` can reorder rows.
    return Box(style = Style(direction = Direction.Column, gap = 0), role = "table") {
        TableCols(spec, sort = p.sort)
        Each(rows.get(), fn(i: int, t: T) {
            return Column(0) {
                if result.is_some(p.on_pick) {
                    TableRowCols(cells(t), spec, zebra = p.zebra, hover = p.hover, on_click = fn() {
                        emit_with(p.on_pick, table_index_of(rows, cells, cells_key(cells(t))))
                    })
                } else {
                    TableRowCols(cells(t), spec, zebra = p.zebra, hover = p.hover)
                }
            }
        })
    }
}

/// Header from `[]TableCol` (`title` + `width`; 0 = equal share of the row).
/// A `sortable` column is a button that cycles `sort`; the sorted column
/// shows a direction arrow (see `TableColsProps`).
fn TableCols(cols: []TableCol, p: TableColsProps) -> Node {
    return Column(Space.Exs) {
        // Same gutter as the body rows (`padding_x = Space.Exs`), so header
        // and cells share the same column boundaries.
        Box(style = Style(
            direction = Direction.Row,
            gap = Space.Sm,
            align = Align.Center,
            paddingX = Space.Exs,
        )) {
            Each(cols, fn(i, c) {
                return TableColHead(
                    c,
                    i,
                    c.sortable && result.is_some(p.sort),
                    result.some_or(p.sort, no_signal()),
                )
            })
        }
        Separator()
    }
}

/// One header cell. A sortable column is a button that cycles `sort` and shows
/// the arrow for the direction it is sorted in.
fn TableColHead(c: TableCol, i: int, sortable: bool, sort: Signal<int>) -> Node {
    return Box(
        style = Style(
            width = if c.width <= 0 { pct(0) } else { px(table_col_width(c.width)) },
            grow = if c.width <= 0 { 1 } else { 0 },
            direction = Direction.Row,
            gap = 2,
            align = Align.Center,
            justify = c.align,
            cursor = opt_color(if sortable { "pointer" } else { "" }),
        ),
        on_click = handler_if(sortable, fn() { sort.set(sort_cycle(sort.get(), i)) }),
        role = if sortable { "button" } else { "" },
        label = if sortable { "Sort by {{c.title}}" } else { "" },
        hoverFade = sortable,
    ) {
        Text(c.title, style = Style(font = FONT_BODY, color = mute()))
        if sortable {
            Icon(IC_SORT_ASC, 12, ink(), style = Style(display = shown(sort.get() == i + 1)))
            Icon(IC_SORT_DESC, 12, ink(), style = Style(display = shown(sort.get() == -(i + 1))))
        }
    }
}

/// Grouped bar chart. One shared y domain.
/// The plot follows the container: pass the intended width, and the marks
/// move in place whenever its card measures a different width (nothing is
/// rebuilt).
fn BarChart(labels: []string, names: []string, vals: []int, w: int, h: int) -> Node {
    return BarChartOf(signal(ChartData { labels: labels, names: names, vals: vals }), w, h)
}

/// `BarChart` over live data: a write to `data` moves the bars, ticks and
/// labels through effects. Only a change in the number of categories or
/// series rebuilds the chart.
fn BarChartOf(data: Signal<ChartData>, w: int, h: int) -> Node {
    let host = Column(Space.Exs)
    let node_id = host.id
    // Built once: the marks follow the host's width through `gw`.
    let gw = chart_w(w, host)
    return slot(node_handle(node_id), || {
        MatchBy(data, chart_shape, fn(d: Signal<ChartData>) -> Node {
            return chart_arm_bars(d, gw, h)
        })
    })
}

/// Straight-segment line chart with dots. `p` is `LineChartProps`: a fitted
/// y axis, implied decimals, a label stride, no dots. A `CHART_GAP` value
/// is not drawn and breaks its line.
fn LineChart(
    labels: []string,
    names: []string,
    vals: []int,
    w: int,
    h: int,
    p: LineChartProps
) -> Node {
    return LineChartOf(
        signal(ChartData { labels: labels, names: names, vals: vals }),
        w,
        h,
        fit = p.fit,
        decimals = p.decimals,
        labelEvery = p.labelEvery,
        dots = p.dots,
    )
}

/// `LineChart` over live data (see `BarChartOf`).
fn LineChartOf(data: Signal<ChartData>, w: int, h: int, p: LineChartProps) -> Node {
    let host = Column(Space.Exs)
    let node_id = host.id
    let gw = chart_w(w, host)
    return slot(node_handle(node_id), || {
        MatchBy(data, chart_shape, fn(d: Signal<ChartData>) -> Node {
            return chart_arm_lines(d, gw, h, p)
        })
    })
}

/// Area chart: tinted fill under the line (fill follows appearance).
fn AreaChart(labels: []string, names: []string, vals: []int, w: int, h: int) -> Node {
    return AreaChartOf(signal(ChartData { labels: labels, names: names, vals: vals }), w, h)
}

/// `AreaChart` over live data (see `BarChartOf`).
fn AreaChartOf(data: Signal<ChartData>, w: int, h: int) -> Node {
    let host = Column(Space.Exs)
    let node_id = host.id
    let gw = chart_w(w, host)
    return slot(node_handle(node_id), || {
        MatchBy(data, chart_shape, fn(d: Signal<ChartData>) -> Node {
            return chart_arm_areas(d, gw, h)
        })
    })
}

/// One chart arm: the plot for the shape `d` holds, or nothing when the data
/// is empty or ragged. Dispatchers, so no builder returns early.
fn chart_arm_bars(d: Signal<ChartData>, gw: Signal<int>, h: int) -> Node {
    if chart_drawable(d.peek()) {
        return chart_col_bars(d, gw, h)
    }
    return Column(Space.Exs)
}

fn chart_arm_lines(d: Signal<ChartData>, gw: Signal<int>, h: int, p: LineChartProps) -> Node {
    if chart_drawable(d.peek()) {
        return chart_col_lines(d, gw, h, p)
    }
    return Column(Space.Exs)
}

fn chart_arm_areas(d: Signal<ChartData>, gw: Signal<int>, h: int) -> Node {
    if chart_drawable(d.peek()) {
        return chart_col_areas(d, gw, h)
    }
    return Column(Space.Exs)
}

fn chart_col_bars(d: Signal<ChartData>, gw: Signal<int>, h: int) -> Node {
    let x = d.peek()
    return Column(Space.Exs) {
        chart_bars(d, x.labels.len, x.names.len, gw, h)
    }
}

fn chart_col_lines(d: Signal<ChartData>, gw: Signal<int>, h: int, p: LineChartProps) -> Node {
    let x = d.peek()
    return Column(Space.Exs) {
        chart_lines(d, x.labels.len, x.names.len, gw, h, p)
    }
}

fn chart_col_areas(d: Signal<ChartData>, gw: Signal<int>, h: int) -> Node {
    let x = d.peek()
    return Column(Space.Exs) {
        chart_areas(d, x.labels.len, x.names.len, gw, h)
    }
}

/// Ghost icon step button for the month/year rails.
fn CalStep(markup: string, label: string, press: fn()) -> Node {
    return Box(
        style = Style(
            width = px(28),
            height = px(28),
            direction = Direction.Row,
            align = Align.Center,
            justify = Align.Center,
            radius = RAD_CONTROL,
            cursor = "pointer",
        ),
        on_click = press,
        role = "button",
        label = label,
        hoverOff = true,
    ) {
        Icon(markup, 16, mute())
    }
}

fn CalWeekday(s: string) -> Node {
    return Box(style = Style(
        width = px(CAL_CELL),
        height = px(24),
        direction = Direction.Row,
        align = Align.Center,
        justify = Align.Center,
    )) {
        Text(s, style = Style(font = FONT_CAPTION, color = dim()))
    }
}

fn CalWeekRow() -> Node {
    return Grid(config = GridConfig(columns = 7, gap = Space.Exxxs)) {
        CalWeekday("Mo")
        CalWeekday("Tu")
        CalWeekday("We")
        CalWeekday("Th")
        CalWeekday("Fr")
        CalWeekday("Sa")
        CalWeekday("Su")
    }
}

fn CalCell(y: Signal<int>, m: Signal<int>, d: Signal<int>, open: Signal<bool>, idx: int) -> Node {
    // controller. Fill, label and text colour all track y / m / d.
    fn day() -> int {
        return cal_day_at(y.get(), m.get(), idx)
    }
    fn picked() -> bool {
        return day() > 0 && d.get() == day()
    }
    fn pick() {
        if day() > 0 {
            d.set(day())
            open.set(false)
        }
    }

    // view. The picked day is the grid's one tab stop while the sheet is
    // open, and takes focus as the pick moves (opening lands on it).
    return Box(
        style = Style(
            width = px(CAL_CELL),
            height = px(CAL_CELL),
            direction = Direction.Row,
            align = Align.Center,
            justify = Align.Center,
            paddingX = 2,
            radius = RAD_LG,
            cursor = "pointer",
            background = if picked() { accent() } else { plate() },
        ),
        on_click = pick,
        role = "button",
        label = if day() == 0 { "" } else { "{{day()}}" },
        roving = picked() && open.get(),
        rovingGrab = true,
    ) {
        Text(
            if day() > 0 { "{{day()}}" } else { "" },
            style = Style(font = FONT_BODY, color = if picked() { on_ink() } else { ink() }),
        )
    }
}

/// One 7×6 grid for whichever month `m` names: 42 fixed cells whose content
/// tracks `y`/`m`/`d` through prop thunks. Built once, no per-month subtrees.
fn CalGrid(y: Signal<int>, m: Signal<int>, d: Signal<int>, open: Signal<bool>) -> Node {
    return Grid(config = GridConfig(columns = 7, gap = 3)) {
        for i in 0..42 {
            CalCell(y, m, d, open, i)
        }
    }
}

/// Options for `DatePicker`.
struct DatePickerProps {
    /// `Size` token: the trigger is `control_h(size)` tall.
    size: int = Size.Md,
    /// Draws the danger edge (a `Field` with an `error` sets it).
    invalid: bool = false,
    /// Dims the trigger and makes it inert.
    disabled: bool = false,
    /// The caption above the trigger, and its accessible name. Empty hides it.
    label: string = "Date",
    /// Style, merged over the trigger's own (`SELECT_W` wide by default).
    style: Option<fn() -> Style> = none,
}

/// Calendar picker: label, input-like trigger with a calendar icon, and a
/// floating sheet (kind-9 so the page scroller cannot clip it). Month and
/// year rails step with chevron icons; picking a day closes the sheet.
/// Keys, while the sheet is open: arrows move a day / a week (crossing
/// months), PageUp / PageDown a month, Home / End to the week's ends, Enter
/// picks, Escape closes.
fn DatePicker(y: Signal<int>, m: Signal<int>, d: Signal<int>, p: DatePickerProps) -> Node {
    // state
    let open = signal(false)
    let size = p.size
    let trigger = ref()

    // controller. Every move lands on a real date: a month step clamps the
    // day to the new month's length (Jan 31 → Feb 28). Steps only run while
    // the sheet is open, in case focus outlives the close.
    fn set_date(year: int, month: int, day: int) {
        batch(|| {
            y.set(year)
            m.set(month)
            d.set(day)
        })
    }
    fn step_month(delta: int) {
        if !open.get() {
            return
        }
        let mut yy = y.get()
        let mut mm = m.get() + delta
        while mm < 1 {
            mm = mm + 12
            yy = yy - 1
        }
        while mm > 12 {
            mm = mm - 12
            yy = yy + 1
        }
        let len = cal_len(yy, mm)
        set_date(yy, mm, if d.get() > len { len } else { d.get() })
    }
    fn step_day(delta: int) {
        if !open.get() {
            return
        }
        let mut yy = y.get()
        let mut mm = m.get()
        let mut dd = d.get() + delta
        while dd < 1 {
            mm = mm - 1
            if mm < 1 {
                mm = 12
                yy = yy - 1
            }
            dd = dd + cal_len(yy, mm)
        }
        while dd > cal_len(yy, mm) {
            dd = dd - cal_len(yy, mm)
            mm = mm + 1
            if mm > 12 {
                mm = 1
                yy = yy + 1
            }
        }
        set_date(yy, mm, dd)
    }
    // Monday-first, matching the grid: 0 = Mo … 6 = Su.
    fn weekday() -> int {
        return (cal_first_monday(y.get(), m.get()) + d.get() - 1) % 7
    }
    fn week_start() {
        if !open.get() {
            return
        }
        let to = d.get() - weekday()
        d.set(if to < 1 { 1 } else { to })
    }
    fn week_end() {
        if !open.get() {
            return
        }
        let to = d.get() + 6 - weekday()
        let len = cal_len(y.get(), m.get())
        d.set(if to > len { len } else { to })
    }
    fn prev_month() {
        step_month(-1)
    }
    fn next_month() {
        step_month(1)
    }

    // keys. On the sheet, so they answer wherever focus sits inside it.
    let keys = []KeyBind {
        key_bind("left", "date.prev_day", fn() { step_day(-1) }),
        key_bind("right", "date.next_day", fn() { step_day(1) }),
        key_bind("up", "date.prev_week", fn() { step_day(-7) }),
        key_bind("down", "date.next_week", fn() { step_day(7) }),
        key_bind("pageup", "date.prev_month", prev_month),
        key_bind("pagedown", "date.next_month", next_month),
        key_bind("home", "date.week_start", week_start),
        key_bind("end", "date.week_end", week_end),
    }

    // view. An invisible full-window scrim closes the sheet on a click that
    // misses it; floaters hit-test in z order, so the scrim takes the Z_SCRIM
    // tier and the sheet Z_POPUP, which also swallows its own clicks.
    return Column(Space.Exs) {
        Overlay(
            style = Style(zIndex = Z_SCRIM),
            visible = open.get(),
            on_click = fn() => open.set(false),
        )
        if p.label.len > 0 {
            Label(p.label)
        }
        Box(
            ref = trigger,
            style = field_chrome(size, invalid = p.invalid, width = SELECT_W, cursor = "pointer"),
            restyle = p.style,
            on_click = fn() => open.set(!open.get()),
            enabled = !p.disabled,
            role = "button",
            label = "Pick a date",
        ) {
            Icon(IC_CALENDAR, control_icon(size), mute())
            Text("{{y.get()}}", style = Style(font = control_font(size), color = ink()))
            Text("-", style = Style(font = control_font(size), color = mute()))
            Text("{{m.get()}}", style = Style(font = control_font(size), color = ink()))
            Text("-", style = Style(font = control_font(size), color = mute()))
            Text("{{d.get()}}", style = Style(font = control_font(size), color = ink()))
        }
        Box(
            style = floating_panel(0, width = DATE_SHEET_W, gap = Space.Exs, padding = Space.Xs),
            anchor = Anchor(to = trigger, place = Place.PlaceBelow, gap = Space.Exxxs),
            role = "dialog",
            on_click = fn() { return },
            keys = keys,
            visible = open.get(),
            enter = Enter.Fade + Enter.Pop,
        ) {
            Row(4) {
                CalStep(IC_CHEV_LEFT, "Previous month", prev_month)
                // One text node whose label tracks `m`, centred between the
                // month steps so long and short names do not jump the arrows.
                Box(style = Style(
                    direction = Direction.Row,
                    grow = 1,
                    align = Align.Center,
                    justify = Align.Center,
                )) {
                    Text(cal_month_name(m.get()), style = Style(font = FONT_BODY, color = ink()))
                }
                CalStep(IC_CHEV_RIGHT, "Next month", next_month)
                Grow()
                CalStep(IC_CHEV_LEFT, "Previous year", fn() => y.set(y.get() - 1))
                // Bound text paints the live year, as the gauge widgets do.
                Text("", style = Style(font = FONT_BODY, color = ink()), bind = y)
                CalStep(IC_CHEV_RIGHT, "Next year", fn() => y.set(y.get() + 1))
            }
            CalWeekRow()
            CalGrid(y, m, d, open)
        }
    }
}

/// Page: white background column with breathing room. Sets the native
/// roles once; every following Component reads them at paint.
fn Page() -> Node {
    ensure_role_colors()
    return Box(style = Style(
        direction = Direction.Column,
        gap = SECTION,
        grow = 1,
        padding = PAGE_PAD,
        background = paper(),
    ))
}

// ═══════════════════════════════════════════════════════════════════
// Tier A organisms: menu hosts, dialog presets, sheet
// ═══════════════════════════════════════════════════════════════════

/// Options for `SplitButton`.
struct SplitButtonProps {
    look: int = Look.Solid,
    size: int = Size.Md,
    /// The main action.
    on_click: Option<fn()> = none,
    /// The caret's menu.
    items: []MenuRow = no_menu_rows(),
    on_select: Option<fn(int)> = none,
    /// Accessible name of the caret.
    menuLabel: string = "More options",
}

/// A primary action with a caret that opens a `Menu` of related ones
/// ("Save" ▾ Save as… / Save a copy).
fn SplitButton(label: string, p: SplitButtonProps) -> Node {
    // The seam sits on the wrapper, not the caret. The menu anchors to its
    // host, and a margin on the caret would make that host 1px wider than
    // the face the menu should line up with.
    let bordered = button_border_width(p.look) > 0
    let seam = if bordered { -HAIRLINE } else { 1 }
    return Row(0) {
        Box(style = Style(direction = Direction.Row), role = "group") {
            GroupSegment(label, 0, 2, p.look, p.size, fn() => emit(p.on_click), true, "")
            Box(style = Style(marginLeft = seam)) {
                Menu(
                    items = p.items,
                    on_select = p.on_select,
                    place = Place.PlaceBelow,
                    trigger = fn() { SplitCaret(p.look, p.size, p.menuLabel) },
                )
            }
        }
    }
}

/// The caret half of a `SplitButton`: square, end corners round.
fn SplitCaret(look: int, size: int, label: string) -> Node {
    return Box(
        style = Style(
            width = px(control_h(size)),
            height = px(control_h(size)),
            align = Align.Center,
            justify = Align.Center,
            radiusTopRight = slot_radius(true),
            radiusBottomRight = slot_radius(true),
            borderWidth = button_border_width(look),
            borderColor = opt_color(button_border_color(look)),
            background = opt_color(button_background(look)),
            cursor = "pointer",
        ),
        role = "button",
        label = label,
        press = true,
        hoverFade = true,
    ) {
        Icon(IC_CHEV_DOWN, control_icon(size), button_color(look))
    }
}

/// Options for `DropdownMenu`.
struct DropdownMenuProps {
    look: int = Look.Outline,
    size: int = Size.Md,
    items: []MenuRow = no_menu_rows(),
    on_select: Option<fn(int)> = none,
    place: int = 0,
}

/// A button with a trailing chevron that opens a `Menu` of `items`.
fn DropdownMenu(label: string, p: DropdownMenuProps) -> Node {
    return Menu(items = p.items, on_select = p.on_select, place = p.place, trigger = fn() {
        GroupSegment(label, 0, 1, p.look, p.size, noop, true, IC_CHEV_DOWN)
    })
}

/// Options for `ContextMenu`.
struct ContextMenuProps {
    items: []MenuRow = no_menu_rows(),
    on_select: Option<fn(int)> = none,
    disabled: bool = false,
    /// The region that answers a right-click (or ctrl-click).
    children: fn() = noop,
}

/// Wrap a region so a secondary click opens a `Menu` of `items` at the
/// pointer. Escape, an outside click, or a pick closes it.
fn ContextMenu(p: ContextMenuProps) -> Node {
    // state
    let active = signal(-1)
    let region = ref()
    let at_x = signal(0)
    let at_y = signal(0)

    // view. A 1px point, absolutely placed where the click landed, is the
    // menu host. The panel anchors below that point (gap 0), so it opens on
    // the pointer. The point is out of flow and does not change the region.
    return Box(ref = region, style = Style(direction = Direction.Column), on_context_menu = fn() {
        if p.disabled {
            return
        }
        let m = current_mouse()
        let r = screen_rect(region)
        at_x.set(m.x - r.x)
        at_y.set(m.y - r.y)
        active.set(0)
    }) {
        p.children()
        Box(style = Style(
            position = pos_absolute(),
            left = at_x.get(),
            top = at_y.get(),
            width = px(1),
            height = px(1),
        )) {
            Menu(active = active, items = p.items, on_select = p.on_select, gap = 0, trigger = fn(
            ) {
                Box(style = Style(width = px(1), height = px(1)), role = "presentation")
            })
        }
    }
}

/// Options for `ConfirmDialog`.
struct ConfirmDialogProps {
    title: string = "Are you sure?",
    body: string = "",
    confirm: string = "Confirm",
    cancel: string = "Cancel",
    /// A destructive confirm: the button turns `Look.Danger`.
    danger: bool = false,
    on_confirm: Option<fn()> = none,
    on_cancel: Option<fn()> = none,
}

/// A yes / no question over a scrim. Either button closes it.
fn ConfirmDialog(open: Signal<bool>, p: ConfirmDialogProps) -> Node {
    return AlertDialog(open, title = p.title) {
        if p.body.len > 0 {
            Text(p.body, style = Style(wrap = true, font = FONT_BODY, color = mute()))
        }
        Box(style = Style(direction = Direction.Row, gap = Space.Exs, justify = Align.End)) {
            Button(p.cancel, look = Look.Outline, on_click = fn() {
                open.set(false)
                emit(p.on_cancel)
            })
            Button(
                p.confirm,
                look = if p.danger { Look.Danger } else { Look.Solid },
                on_click = fn() {
                    open.set(false)
                    emit(p.on_confirm)
                },
            )
        }
    }
}

/// Options for `PromptDialog`.
struct PromptDialogProps {
    title: string = "",
    body: string = "",
    placeholder: string = "",
    confirm: string = "OK",
    cancel: string = "Cancel",
    /// Runs with the text on OK (or Enter in the field).
    on_submit: Option<fn(string)> = none,
}

/// A dialog that asks for one line of text, bound to `value`.
fn PromptDialog(open: Signal<bool>, value: Signal<string>, p: PromptDialogProps) -> Node {
    fn ok() {
        open.set(false)
        emit_with(p.on_submit, value.get())
    }
    return Dialog(open, title = p.title) {
        if p.body.len > 0 {
            Text(p.body, style = Style(wrap = true, font = FONT_BODY, color = mute()))
        }
        TextInput(value, p.placeholder, keys = []KeyBind { key_bind("enter", "prompt.ok", ok) })
        Box(style = Style(direction = Direction.Row, gap = Space.Exs, justify = Align.End)) {
            Button(p.cancel, look = Look.Outline, on_click = fn() { open.set(false) })
            Button(p.confirm, look = Look.Solid, on_click = ok)
        }
    }
}

/// Options for `Sheet`.
struct SheetProps {
    /// Panel height.
    size: int = 360,
    title: string = "",
    children: fn() = noop,
}

/// A bottom sheet: a `Drawer` from the bottom edge with a grip bar and an
/// optional title. Outside click and Escape close it.
fn Sheet(open: Signal<bool>, p: SheetProps) -> Node {
    return Drawer(open, side = Side.SideBottom, size = p.size) {
        Box(style = Style(direction = Direction.Row, justify = Align.Center)) {
            Box(
                style = Style(width = px(36), height = px(4), radius = 2, background = hard()),
                role = "presentation",
            )
        }
        if p.title.len > 0 {
            Title(p.title)
        }
        p.children()
    }
}

// --- tier B organisms: tree, shell, palette, notifications ---------------

/// True when `xs` holds `v`.
fn int_has(xs: []int, v: int) -> bool {
    for i in 0..xs.len {
        if xs[i] == v {
            return true
        }
    }
    return false
}

/// `xs` with `v` added, or removed if it was already there.
fn int_toggle(xs: []int, v: int) -> []int {
    let mut out = []int {}
    let mut found = false
    for i in 0..xs.len {
        if xs[i] == v {
            found = true
        } else {
            push(out, xs[i])
        }
    }
    if !found {
        push(out, v)
    }
    return out
}

/// One row of a `Tree`. `parent` is the parent's index, or -1 for a root.
/// `folder` draws a chevron before any child exists, so a caller can append
/// children from `on_open`.
struct TreeItem {
    label: string = "",
    parent: int = -1,
    folder: bool = false,
}

/// Options for `Tree`.
struct TreeProps {
    /// Runs with the row index when a folder opens.
    on_open: Option<fn(int)> = none,
    label: string = "",
    style: Option<fn() -> Style> = none,
}

/// A row is shown when every ancestor folder is open. Roots always are.
fn tree_shown(rows: []TreeItem, opened: []int, index: int) -> bool {
    let mut p = rows[index].parent
    let mut guard = 0
    while p >= 0 && guard < 32 {
        if p >= rows.len || !int_has(opened, p) {
            return false
        }
        p = rows[p].parent
        guard = guard + 1
    }
    return true
}

fn tree_visible(rows: []TreeItem, opened: []int) -> []int {
    let mut out = []int {}
    for i in 0..rows.len {
        if tree_shown(rows, opened, i) {
            push(out, i)
        }
    }
    return out
}

fn tree_depth(rows: []TreeItem, index: int) -> int {
    let mut d = 0
    let mut p = rows[index].parent
    let mut guard = 0
    while p >= 0 && p < rows.len && guard < 32 {
        d = d + 1
        p = rows[p].parent
        guard = guard + 1
    }
    return d
}

/// A chevron is warranted when the row is marked `folder` or already has a child.
fn tree_folder(rows: []TreeItem, index: int) -> bool {
    if index < 0 || index >= rows.len {
        return false
    }
    if rows[index].folder {
        return true
    }
    for i in 0..rows.len {
        if rows[i].parent == index {
            return true
        }
    }
    return false
}

/// Move the selection to the visible row `delta` steps away.
fn tree_move(visible: Signal<[]int>, selected: Signal<int>, delta: int) {
    let vs = visible.get()
    let mut at = 0
    for i in 0..vs.len {
        if vs[i] == selected.get() {
            at = i
        }
    }
    let n = at + delta
    if n >= 0 && n < vs.len {
        selected.set(vs[n])
    }
}

/// One visible tree row: chevron, label, indent of 16px per level.
fn tree_noop(index: int) {
    return
}

fn TreeRow(
    rows: []TreeItem,
    visible: Signal<[]int>,
    selected: Signal<int>,
    open: Signal<[]int>,
    on_open: Option<fn(int)>,
    index: int
) -> Node {
    let name = rows[index].label
    let folder = tree_folder(rows, index)
    let depth = tree_depth(rows, index)
    let opened = result.some_or(on_open, tree_noop)
    fn toggle() {
        let was = int_has(peek(open), index)
        open.set(int_toggle(peek(open), index))
        if !was {
            opened(index)
        }
    }
    let row_keys = []KeyBind {
        key_bind("down", "tree.next", fn() {
            if peek(selected) == index {
                tree_move(visible, selected, 1)
            }
        }),
        key_bind("up", "tree.prev", fn() {
            if peek(selected) == index {
                tree_move(visible, selected, -1)
            }
        }),
        key_bind("right", "tree.open", fn() {
            if peek(selected) == index && folder && !int_has(peek(open), index) {
                toggle()
            }
        }),
        key_bind("left", "tree.close", fn() {
            if peek(selected) == index && folder && int_has(peek(open), index) {
                toggle()
            }
        }),
    }
    return Box(
        style = Style(
            direction = Direction.Row,
            gap = Space.Exxxs,
            align = Align.Center,
            minHeight = control_h(Size.Md),
            paddingLeft = 8 + depth * 16,
            radius = RAD_SM,
            background = if selected.get() == index { raised() } else { "" },
        ),
        role = "treeitem",
        label = name,
        focusable = true,
        roving = fn() -> bool { return selected.get() == index },
        keys = row_keys,
        on_click = fn() { selected.set(index) },
    ) {
        if folder {
            Box(
                style = Style(
                    width = px(20),
                    height = px(20),
                    shrink = 0,
                    align = Align.Center,
                    justify = Align.Center,
                    radius = RAD_SM,
                    cursor = "pointer",
                ),
                on_click = toggle,
                role = "button",
                label = fn() -> string {
                    if int_has(open.get(), index) {
                        return "Collapse {{name}}"
                    }
                    return "Expand {{name}}"
                },
            ) {
                Icon(
                    IC_CHEV_DOWN,
                    IconSize.Sm,
                    mute(),
                    style = Style(display = shown(int_has(open.get(), index))),
                )
                Icon(
                    IC_CHEV_RIGHT,
                    IconSize.Sm,
                    mute(),
                    style = Style(display = shown(!int_has(open.get(), index))),
                )
            }
        }
        Text(name, style = Style(font = FONT_BODY, color = ink(), ellipsis = true))
    }
}

/// Expand and collapse, 16px of indent per level, arrows move among the rows
/// that are open. `open` holds the indices of expanded folders.
fn Tree(
    items: Signal<[]TreeItem>,
    selected: Signal<int>,
    open: Signal<[]int>,
    p: TreeProps
) -> Node {
    let visible = signal([]int {})
    effect(|| {
        visible.set(tree_visible(items.get(), open.get()))
    })
    return Box(
        style = Style(direction = Direction.Column),
        restyle = p.style,
        role = "tree",
        label = p.label,
    ) {
        Each(visible.get(), fn(row, index) {
            return TreeRow(items.get(), visible, selected, open, p.on_open, index)
        })
    }
}

/// Options for `Sidebar`.
struct SidebarProps {
    style: Option<fn() -> Style> = none,
    children: fn() = noop,
}

/// A side rail: `SIDEBAR_W` (240) open, `SIDEBAR_RAIL` (56) collapsed.
/// The chevron button is labelled Collapse / Expand.
fn Sidebar(collapsed: Signal<bool>, p: SidebarProps) -> Node {
    return Box(
        style = Style(
            width = px(if collapsed.get() { SIDEBAR_RAIL } else { SIDEBAR_W }),
            shrink = 0,
            direction = Direction.Column,
            gap = Space.Exxxs,
            padding = Space.Exs,
            background = raised(),
        ),
        restyle = p.style,
        role = "navigation",
        label = "Sidebar",
    ) {
        // Centred on the rail, so the chevron lines up with the nav icons.
        Box(
            style = Style(
                width = px(control_h(Size.Md)),
                height = px(control_h(Size.Md)),
                align = Align.Center,
                justify = Align.Center,
                alignSelf = if collapsed.get() { Align.Center } else { Align.Start },
                radius = RAD_CONTROL,
                cursor = "pointer",
            ),
            on_click = fn() { collapsed.set(!collapsed.get()) },
            role = "button",
            label = fn() -> string {
                if collapsed.get() {
                    return "Expand"
                }
                return "Collapse"
            },
        ) {
            Icon(
                IC_CHEV_LEFT,
                IconSize.Md,
                mute(),
                style = Style(display = shown(!collapsed.get())),
            )
            Icon(
                IC_CHEV_RIGHT,
                IconSize.Md,
                mute(),
                style = Style(display = shown(collapsed.get())),
            )
        }
        p.children()
    }
}

/// Options for `NavGroup`.
struct NavGroupProps {
    /// When this is true the heading hides (a collapsed rail).
    collapsed: Option<Signal<bool>> = none,
    children: fn() = noop,
}

/// A heading over a stack of `NavItem`s. Hidden while `collapsed` is set.
fn NavGroup(title: string, p: NavGroupProps) -> Node {
    let has = result.is_some(p.collapsed)
    let col = result.some_or(p.collapsed, no_flag_signal())
    return Column(4) {
        Text(
            title,
            style = Style(
                font = FONT_OVERLINE,
                color = dim(),
                paddingLeft = Space.Exs,
                paddingTop = Space.Exs,
                display = shown(!has || !col.get()),
            ),
        )
        p.children()
    }
}

/// One destination in a `Sidebar`. The label hides while `collapsed` is set;
/// the icon stays, centred on the rail.
fn NavItem(
    label: string,
    icon: string,
    page: Signal<int>,
    index: int,
    collapsed: Signal<bool>
) -> Node {
    return Box(
        style = Style(
            minHeight = control_h(Size.Md),
            direction = Direction.Row,
            gap = Space.Exs,
            align = Align.Center,
            justify = if collapsed.get() { Align.Center } else { Align.Start },
            paddingX = if collapsed.get() { 0 } else { 8 },
            radius = RAD_CONTROL,
            cursor = "pointer",
            background = if page.get() == index { plate() } else { "" },
        ),
        on_click = fn() { page.set(index) },
        role = "button",
        label = label,
    ) {
        if icon.len > 0 {
            Icon(icon, IconSize.Md, if page.get() == index { ink() } else { mute() })
        }
        Text(
            label,
            style = Style(
                ellipsis = true,
                font = FONT_BODY,
                color = if page.get() == index { ink() } else { mute() },
                display = shown(!collapsed.get()),
            ),
        )
    }
}

/// Options for `AppShell`.
struct AppShellProps {
    /// The side rail.
    sidebar: fn() = noop,
    /// A bar across the top of the main column.
    header: fn() = noop,
    style: Option<fn() -> Style> = none,
    children: fn() = noop,
}

/// Sidebar, then a column of header and the page body. The header is inset
/// by the same 16px as the body, so its label does not sit on the rail.
fn AppShell(p: AppShellProps) -> Node {
    return Box(
        style = Style(
            direction = Direction.Row,
            align = Align.Stretch,
            width = pct(100),
            minHeight = 200,
        ),
        restyle = p.style,
    ) {
        p.sidebar()
        Box(style = Style(direction = Direction.Column, grow = 1, minWidth = 0)) {
            Box(style = Style(paddingTop = Space.Sm, paddingX = Space.Sm)) {
                p.header()
            }
            Box(style = Style(grow = 1, padding = Space.Sm)) {
                p.children()
            }
        }
    }
}

/// Options for `MasterDetail`.
struct MasterDetailProps {
    master: fn() = noop,
    /// Width of the master column.
    masterWidth: int = 280,
    style: Option<fn() -> Style> = none,
    children: fn() = noop,
}

/// A fixed master column, a hairline, and the detail.
fn MasterDetail(p: MasterDetailProps) -> Node {
    let w = if p.masterWidth > 0 { p.masterWidth } else { 280 }
    return Box(
        style = Style(
            direction = Direction.Row,
            align = Align.Stretch,
            width = pct(100),
            minHeight = 120,
        ),
        restyle = p.style,
    ) {
        Box(style = Style(
            width = px(w),
            shrink = 0,
            direction = Direction.Column,
            background = raised(),
            padding = Space.Xs,
        )) {
            p.master()
        }
        Box(style = Style(
            width = px(HAIRLINE),
            shrink = 0,
            alignSelf = Align.Stretch,
            background = rule(),
        ))
        Box(style = Style(grow = 1, minWidth = 0, direction = Direction.Column, padding = Space.Xs)) {
            p.children()
        }
    }
}

/// Options for `SplitPane`.
struct SplitPaneProps {
    /// The leading pane.
    first: fn() = noop,
    /// Leading pane's starting size, in px.
    initial: int = 240,
    /// Narrowest either pane may go (`SPLIT_MIN`).
    min: int = SPLIT_MIN,
    /// Stack the panes and drag vertically.
    vertical: bool = false,
    /// Cross size: the height of a horizontal split, the width of a vertical one.
    size: int = 160,
    style: Option<fn() -> Style> = none,
    /// The trailing pane.
    children: fn() = noop,
}

/// Two panes and a 6px drag handle. Neither pane goes below `min`.
fn SplitPane(p: SplitPaneProps) -> Node {
    let split = signal(if p.initial > 0 { p.initial } else { 240 })
    let host = ref()
    let vertical = p.vertical
    let mn = if p.min > 0 { p.min } else { SPLIT_MIN }
    return Box(
        ref = host,
        style = Style(
            direction = if vertical { Direction.Column } else { Direction.Row },
            align = Align.Stretch,
            width = pct(100),
            height = px(if vertical { 320 } else { p.size }),
        ),
        restyle = p.style,
        role = "group",
        label = "Split",
    ) {
        Box(
            style = Style(
                width = if vertical { pct(100) } else { px(split.get()) },
                height = if vertical { px(split.get()) } else { pct(100) },
                overflow = Overflow.Hidden,
                direction = Direction.Column,
            ),
            role = "region",
            label = "First pane",
        ) {
            p.first()
        }
        Box(
            style = Style(
                width = if vertical { pct(100) } else { px(SPLIT_HIT) },
                height = if vertical { px(SPLIT_HIT) } else { pct(100) },
                shrink = 0,
                align = Align.Center,
                justify = Align.Center,
                cursor = if vertical { "ns-resize" } else { "ew-resize" },
            ),
            on_drag = fn() {
                let r = screen_rect(host)
                let v = if vertical { current_mouse().y - r.y } else { current_mouse().x - r.x }
                let span = if vertical { r.h } else { r.w }
                let cap = if span - mn > mn { span - mn } else { mn }
                split.set(clamp_int(v, mn, cap))
            },
            role = "separator",
            label = "Resize",
        ) {
            Box(style = Style(
                width = if vertical { pct(100) } else { px(HAIRLINE) },
                height = if vertical { px(HAIRLINE) } else { pct(100) },
                shrink = 0,
                background = rule(),
            ))
        }
        Box(style = Style(
            grow = 1,
            minWidth = 0,
            minHeight = 0,
            overflow = Overflow.Hidden,
            direction = Direction.Column,
        )) {
            p.children()
        }
    }
}

/// One notice in a `NotificationCenter`.
struct Notice {
    title: string = "",
    body: string = "",
    tint: int = Tint.Info,
}

/// `xs` plus `n`.
fn notice_plus(xs: []Notice, n: Notice) -> []Notice {
    let mut out = []Notice {}
    for i in 0..xs.len {
        push(out, xs[i])
    }
    push(out, n)
    return out
}

/// `xs` without index `drop`.
fn notice_without(xs: []Notice, drop: int) -> []Notice {
    let mut out = []Notice {}
    for i in 0..xs.len {
        if i != drop {
            push(out, xs[i])
        }
    }
    return out
}

/// A single notice card, `TOAST_W` wide. `on_dismiss` shows the X.
fn Notification(title: Signal<string>, body: Signal<string>, tint: int, on_dismiss: fn()) -> Node {
    return Box(
        style = Style(
            direction = Direction.Row,
            gap = Space.Xs,
            align = Align.Start,
            width = px(TOAST_W),
            padding = Space.Xs,
            radius = RAD_LG,
            borderWidth = HAIRLINE,
            borderColor = tint_line(tint),
            background = tint_bg(tint),
            elevation = FLOAT_LIFT,
        ),
        role = "status",
        label = title,
    ) {
        Icon(tint_icon(tint), IconSize.Md, tint_ink(tint))
        Box(style = Style(direction = Direction.Column, gap = 2, grow = 1)) {
            Text(title, style = Style(font = FONT_BODY, color = tint_ink(tint)))
            Text(body, style = Style(wrap = true, font = FONT_CONTROL, color = ink()))
        }
        Box(
            style = Style(
                width = px(28),
                height = px(28),
                shrink = 0,
                align = Align.Center,
                justify = Align.Center,
                radius = RAD_CONTROL,
                cursor = "pointer",
            ),
            on_click = on_dismiss,
            role = "button",
            label = fn() -> string { return "Dismiss {{title.get()}}" },
        ) {
            Icon(IC_X, IconSize.Md, tint_ink(tint))
        }
    }
}

/// A read-only row in the notification history.
fn NoticeHistory(title: string, body: string) -> Node {
    return Box(
        style = Style(
            direction = Direction.Column,
            gap = 2,
            width = px(TOAST_W),
            padding = Space.Xs,
            radius = RAD_MD,
            background = raised(),
        ),
        role = "listitem",
        label = title,
    ) {
        Text(title, style = Style(font = FONT_BODY, color = ink()))
        Text(body, style = Style(wrap = true, font = FONT_CONTROL, color = mute()))
    }
}

/// The live stack (`TOAST_W`) and a History toggle. Dismissing a notice moves
/// it into `history`.
fn NotificationCenter(live: Signal<[]Notice>, history: Signal<[]Notice>) -> Node {
    let show = signal(false)
    fn dismiss(i: int) {
        let xs = peek(live)
        if i < 0 || i >= xs.len {
            return
        }
        history.set(notice_plus(peek(history), xs[i]))
        live.set(notice_without(xs, i))
    }
    return Box(style = Style(direction = Direction.Column, gap = Space.Exs, width = px(TOAST_W))) {
        Box(style = Style(direction = Direction.Row, align = Align.Center)) {
            Text("Notifications", style = Style(font = FONT_BODY, color = ink()))
            Grow()
            Button("History", look = Look.Ghost, size = Size.Sm, on_click = fn() {
                show.set(!show.get())
            })
        }
        Each(live.get(), fn(i, n) {
            return Notification(n.title, n.body, n.tint, fn() { dismiss(i) })
        })
        Show(when = show.get()) {
            Each(history.get(), fn(i, n) {
                return NoticeHistory(n.title, n.body)
            })
        }
    }
}

/// One command in a `CommandPalette`. `section` groups a run of rows.
struct CommandItem {
    label: string = "",
    section: string = "",
}

/// Options for `CommandPalette`.
struct CommandPaletteProps {
    placeholder: string = "Search commands",
    on_select: Option<fn(int)> = none,
}

/// Indices of `items` whose label contains `q`.
fn command_matches(items: []CommandItem, q: string) -> []int {
    let mut out = []int {}
    for i in 0..items.len {
        if ci_has(items[i].label, q) {
            push(out, i)
        }
    }
    return out
}

/// One filtered command, with a section label when the group changes.
fn CommandRow(
    items: []CommandItem,
    matches: Signal<[]int>,
    active: Signal<int>,
    row: int,
    index: int,
    pick: fn(int)
) -> Node {
    let sec = items[index].section
    let mut lead = false
    if sec.len > 0 {
        if row == 0 {
            lead = true
        } else {
            let prev = matches.get()[row - 1]
            lead = !fmt.eq(items[prev].section, sec)
        }
    }
    return Box(style = Style(direction = Direction.Column, gap = 2)) {
        if lead {
            Text(
                sec,
                style = Style(
                    font = FONT_CAPTION,
                    color = dim(),
                    paddingLeft = Space.Exs,
                    paddingTop = 6,
                ),
            )
        }
        Box(
            style = Style(
                direction = Direction.Row,
                align = Align.Center,
                paddingY = Space.Exs,
                paddingX = 10,
                radius = RAD_SM,
                cursor = "pointer",
                background = if active.get() == row { raised() } else { "" },
            ),
            on_click = fn() { pick(index) },
            role = "option",
            label = items[index].label,
        ) {
            Text(items[index].label, style = Style(font = FONT_BODY, color = ink()))
        }
    }
}

/// A modal command list, 600 wide and 400 tall. Type to filter (the same
/// match `Combobox` uses); Up / Down move, Enter runs the highlighted command,
/// Escape closes.
fn CommandPalette(open: Signal<bool>, items: []CommandItem, p: CommandPaletteProps) -> Node {
    let query = signal("")
    let matches = signal([]int {})
    let active = signal(0)
    let input = ref()
    let cmds = items
    let choose = result.some_or(p.on_select, fn(index: int) { return })
    effect(|| {
        let ms = command_matches(cmds, query.get())
        matches.set(ms)
        if peek(active) >= ms.len {
            active.set(if ms.len > 0 { 0 } else { -1 })
        } else if peek(active) < 0 && ms.len > 0 {
            active.set(0)
        }
    })
    fn pick(index: int) {
        choose(index)
        open.set(false)
    }
    fn key() {
        let k = current_key().key
        let ms = peek(matches)
        let n = ms.len
        if k == Key.Escape {
            open.set(false)
        } else if k == Key.Down {
            let a = peek(active)
            if a + 1 < n {
                active.set(a + 1)
            }
        } else if k == Key.Up {
            let a = peek(active)
            if a > 0 {
                active.set(a - 1)
            }
        } else if k == Key.Enter {
            let a = peek(active)
            if a >= 0 && a < n {
                pick(ms[a])
            }
        }
    }
    return Overlay(
        style = Style(opacity = SCRIM_DIM, background = scrim()),
        visible = open.get(),
        on_click = fn() { open.set(false) },
    ) {
        Box(
            style = Style(
                direction = Direction.Column,
                gap = Space.Exs,
                elevation = FLOAT_LIFT,
                height = px(400),
                maxWidth = 600,
                padding = Space.Xs,
                radius = RAD_LG,
                borderWidth = HAIRLINE,
                borderColor = rule(),
                background = plate(),
                width = pct(92),
            ),
            role = "dialog",
            label = "Commands",
            on_click = fn() { return },
            enter = Enter.Fade + Enter.Pop + Enter.Rise,
            trap = open.get(),
        ) {
            Box(style = field_chrome(Size.Md)) {
                Icon(IC_SEARCH, control_icon(Size.Md), dim())
                Input(
                    ref = input,
                    bind = query,
                    placeholder = p.placeholder,
                    label = p.placeholder,
                    style = Style(
                        grow = 1,
                        font = control_font(Size.Md),
                        padding = 0,
                        color = ink(),
                    ),
                    on_key_down = key,
                )
            }
            Scroll(style = Style(width = pct(100), height = px(320))) {
                Each(matches.get(), fn(row, index) {
                    return CommandRow(cmds, matches, active, row, index, pick)
                })
            }
        }
    }
}

/// Options for `Carousel`.
struct CarouselProps {
    /// Tallest the frame grows, in px. The width follows the parent and the
    /// height follows the current image's aspect ratio up to this; 0 lifts
    /// the cap, so every image fills the width.
    height: int = 240,
    /// How each image sits in the frame. `Fit.Contain` shows the whole image;
    /// it only letterboxes one taller than `height` allows. `Fit.Cover` fills
    /// the frame and crops.
    fit: int = Fit.Contain,
    /// Accessible name for the whole control.
    label: string = "Carousel",
    /// Style, layered over the column: `style = Style(maxWidth = 640)`.
    style: Option<fn() -> Style> = none,
    /// Keyboard actions, after Left / Right / Home / End.
    keys: []KeyBind = no_keys(),
}

/// A paged row of images. `sources` is the live list of paths, data URIs, or
/// URLs — the same strings `Image` takes, so `Carousel(photos.get())` follows
/// the signal. The current image fills the frame width and the frame height
/// follows its aspect ratio, capped at `height` (pass `fit = Fit.Cover` to
/// fill and crop instead). The frame clips to its width; a page change glides `shiftX`
/// on `Motion.Glide`. Each slide is pinned at its own frame offset rather
/// than laid out in flow: a row of frame-wide slides overflows its width, and
/// an overflowing row wraps, which would stack the slides under the first. Arrows, dots, and Left / Right / Home / End move the
/// page and wrap at the ends. An empty list shows a placeholder.
///
/// ```
/// let photos = zeus.signal([]string {})
/// zui.Carousel(photos.get(), height = 240)
/// ```
fn Carousel(sources: Signal<[]string>, p: CarouselProps) -> Node {
    let index = signal(0)
    let frame_w = signal(0)
    let tall = if p.height > 0 { p.height } else { 240 }
    // The current image's laid-out size, for its aspect ratio; 0 until the
    // host decodes it.
    let img_w = signal(0)
    let img_h = signal(0)

    fn count() -> int {
        return sources.get().len
    }
    fn at() -> int {
        let n = count()
        if n <= 0 {
            return 0
        }
        let mut i = index.get()
        if i < 0 {
            i = 0
        }
        if i >= n {
            i = n - 1
        }
        return i
    }
    fn go(delta: int) {
        let n = count()
        if n <= 1 {
            return
        }
        let mut m = (index.peek() + delta) % n
        if m < 0 {
            m = m + n
        }
        index.set(m)
    }
    fn jump(i: int) {
        let n = count()
        if i < 0 {
            return
        }
        if i >= n {
            return
        }
        index.set(i)
    }
    fn slide() -> int {
        return at() * frame_w.get()
    }
    fn place() -> string {
        let n = count()
        if n <= 0 {
            return ""
        }
        return "{{at() + 1}} / {{n}}"
    }
    // The current image's height at the frame width, capped at `height`;
    // `tall` until the image decodes.
    fn frame_h() -> int {
        let w = img_w.get()
        let h = img_h.get()
        let fw = frame_w.get()
        if w <= 0 || h <= 0 || fw <= 0 {
            return tall
        }
        let fit_h = fw * h / w
        if fit_h <= 0 {
            return tall
        }
        return if p.height > 0 && fit_h > p.height { p.height } else { fit_h }
    }
    fn current() -> string {
        let list = sources.get()
        if list.len == 0 {
            return ""
        }
        return list[at()]
    }
    // A shorter list must not leave the page past the last slide.
    effect(fn() {
        let n = sources.get().len
        let i = index.peek()
        if n <= 0 {
            if i != 0 {
                index.set(0)
            }
        } else if i >= n {
            index.set(n - 1)
        } else if i < 0 {
            index.set(0)
        }
    })

    let keys = []KeyBind {
        key_bind("left", "carousel.prev", fn() { go(-1) }),
        key_bind("right", "carousel.next", fn() { go(1) }),
        key_bind("home", "carousel.first", fn() { jump(0) }),
        key_bind("end", "carousel.last", fn() { jump(count() - 1) }),
    }

    return Box(
        style = Style(direction = Direction.Column, gap = Space.Exs, width = pct(100)),
        restyle = p.style,
        role = "group",
        label = p.label,
        keys = keys_concat(keys, p.keys),
    ) {
        Box(
            style = Style(
                width = pct(100),
                height = px(frame_h()),
                overflow = Overflow.Hidden,
                radius = RAD_LG,
                background = raised(),
            ),
            label = "Frame",
            on_resize = fn(r: Rect) {
                if r.w > 0 && frame_w.peek() != r.w {
                    frame_w.set(r.w)
                }
            },
        ) {
            Show(when = count() == 0) {
                Box(style = Style(
                    width = pct(100),
                    height = px(tall),
                    direction = Direction.Row,
                    align = Align.Center,
                    justify = Align.Center,
                )) {
                    Text("No images yet", style = Style(font = FONT_CAPTION, color = mute()))
                }
            }
            Show(when = count() > 0) {
                // An unpainted copy of the current image at its natural size,
                // which layout keeps at the source aspect ratio (and never
                // scales up). The frame takes that ratio at its own width.
                // Opacity is per node, so it goes on the image, not the box.
                Box(style = Style(position = pos_absolute(), top = 0, left = 0), on_resize = fn(
                    r: Rect
                ) {
                    if r.w > 0 && r.h > 0 && (img_w.peek() != r.w || img_h.peek() != r.h) {
                        img_w.set(r.w)
                        img_h.set(r.h)
                    }
                }) {
                    Image(fn() => current(), style = Style(opacity = 0))
                }
                Box(
                    label = "Slides",
                    style = Style(
                        width = pct(100),
                        height = px(frame_h()),
                        shiftX = -slide(),
                        transition = Motion.Glide,
                    ),
                ) {
                    // By position, not keyed by source: the same file may be
                    // added twice.
                    Each(sources, fn(i: int, src: string) -> Node {
                        return Image(
                            src,
                            style = Style(
                                position = pos_absolute(),
                                top = 0,
                                left = i * frame_w.get(),
                                width = px(frame_w.get()),
                                height = px(frame_h()),
                            ),
                            fit = p.fit,
                            label = "Slide {{i + 1}}",
                        )
                    })
                }
            }
            Box(
                style = Style(
                    position = pos_absolute(),
                    top = 0,
                    bottom = 0,
                    left = 8,
                    direction = Direction.Column,
                    justify = Align.Center,
                ),
                visible = count() > 1,
            ) {
                IconButton(
                    IC_CHEV_LEFT,
                    Look.Ghost,
                    Size.Sm,
                    "Previous image",
                    on_click = fn() { go(-1) },
                    style = Style(background = plate(), radius = RAD_FULL),
                )
            }
            Box(
                style = Style(
                    position = pos_absolute(),
                    top = 0,
                    bottom = 0,
                    right = 8,
                    direction = Direction.Column,
                    justify = Align.Center,
                ),
                visible = count() > 1,
            ) {
                IconButton(
                    IC_CHEV_RIGHT,
                    Look.Ghost,
                    Size.Sm,
                    "Next image",
                    on_click = fn() { go(1) },
                    style = Style(background = plate(), radius = RAD_FULL),
                )
            }
        }
        Show(when = count() > 0) {
            Box(style = Style(
                direction = Direction.Row,
                gap = Space.Exxs,
                align = Align.Center,
                justify = Align.Center,
            )) {
                Each(sources, fn(i: int, src: string) -> Node {
                    return Box(
                        style = Style(
                            width = px(24),
                            height = px(24),
                            align = Align.Center,
                            justify = Align.Center,
                            cursor = "pointer",
                        ),
                        on_click = fn() { jump(i) },
                        role = "button",
                        label = "Image {{i + 1}}",
                    ) {
                        Box(style = Style(
                            width = px(8),
                            height = px(8),
                            radius = RAD_FULL,
                            background = if index.get() == i { accent() } else { mute() },
                        ))
                    }
                })
                Text(place, style = Style(font = FONT_CAPTION, color = mute()))
            }
        }
    }
}
