//! organisms — the section-level pieces: Card and Comp, Accordion, Popover,
//! Menu, Drawer, Tooltip, HoverCard, Toast, Dialog, Combobox, Navbar, Table and
//! VirtualTable, the charts, the calendar / DatePicker, and Page.
//!
//! Built on `molecules`, `atoms`, and `zeusbase`.

import "zeus:structs"
import "zeus:enums"
import "zeus:zeusbase"
import "std:result"
import "zeus-components:colors"
import "zeus-components:spacing"
import "zeus:zeus_constants"
import "std:async"
import "std:fmt"
import "zeus-components:atoms"
import "zeus-components:molecules"
import "zeus:zeuscore/geometry"
import "zeus:zeuscore/platform"
import "zeus:zeuscore/arena"

/// One column of a `VirtualTable`. `width` 0 means the column takes an equal
/// share of the row (pair cells with `set_flex_basis_zero(...).grow(1)`); a positive value
/// is a pixel width. `title` is the header cell.
struct TableCol {
    title: string,
    width: int,
    /// Cell alignment for this column: `Align.Start` (default), `Center`,
    /// or `End` — numbers go `End`. `TableCols` aligns the header and
    /// `TableRowCols` the body cells.
    align: int = 0,
    /// true = the header is a sort trigger (see `TableCols`' `sort`).
    sortable: bool = false,
}

/// Extras for `TableCols`: `sort` is the sort state. `0` = none; `i + 1` =
/// column `i` ascending; `-(i + 1)` = descending. Clicking a sortable header
/// cycles none → asc → desc → none on its column and clears the others; the
/// app orders its rows from the signal. An arrow marks the sorted column.
struct TableColsProps {
    sort: Option<Signal<int>> = none,
}

/// Extras for `TableRow` / `TableRowCols`. `zebra` shades every second body
/// row (counted among the row's siblings, so a header does not count);
/// `hover` washes the row under the pointer; `on_click` makes the row a
/// pointer target (hover implied).
struct TableRowProps {
    zebra: bool = false,
    hover: bool = false,
    on_click: Option<fn()> = none,
}

/// Vertical scroller that window-renders `items`. `row_h` is the fixed row
/// height in points (spacers use it so `scroll_max` matches the full list).
/// `build(i, item)` is the row. 10k rows stay a few dozen nodes.
fn VirtualList<T>(items: Signal<[]T>, row_h: int, build: fn(int, T) -> Node) -> Node {
    let n = raw_scroll()
    let node_id = n.id
    arena.bind_host(items.id, node_id)
    virtual_refresh(node_id, items, build, row_h)
    return Component(n,
                     style = Style(grow = 1),
                     role = "list",
                     rowHeight = row_h,
                     rebuild = || { virtual_refresh(node_id, items, build, row_h) })
}

/// Keyed windowed list: `VirtualList` with a stable `key(item)`. Scrolling
/// **moves** the rows whose key stays in the window instead of rebuilding every
/// visible row, so a scroll allocates only the rows entering it — the fix for
/// the `docs/mem-baseline.md` §5.1 per-scroll growth. `key` must be stable and
/// unique among the items. Row state that must follow the item should read a
/// signal inside the row, not `i`. Falls back to the unkeyed path if a key is
/// empty or duplicated.
fn VirtualListKeyed<T>(items: Signal<[]T>, row_h: int, key: fn(T) -> string,
                       build: fn(int, T) -> Node) -> Node {
    let n = raw_scroll()
    let node_id = n.id
    arena.bind_host(items.id, node_id)
    virtual_refresh_keyed(node_id, items, key, build, row_h)
    return Component(n,
                     style = Style(grow = 1),
                     role = "list",
                     rowHeight = row_h,
                     rebuild = || { virtual_refresh_keyed(node_id, items, key, build, row_h) })
}

/// Windowed list with per-row heights. `heights[i]` is row `i` in points
/// (0 / missing uses `fallback`). Spacers use the prefix sum so `scroll_max`
/// matches the real list.
fn VirtualListVar<T>(items: Signal<[]T>, heights: Signal<[]int>, fallback: int,
                     build: fn(int, T) -> Node) -> Node {
    let n = raw_scroll()
    let node_id = n.id
    arena.bind_host(items.id, node_id)
    arena.bind_host(heights.id, node_id)
    virt_refresh_var(node_id, items, build, fallback, heights)
    return Component(n,
                     style = Style(grow = 1),
                     role = "list",
                     rowHeight = fallback,
                     rebuild = || { virt_refresh_var(node_id, items, build, fallback, heights) })
}

/// Windowed table. `rows` is `zeus.signal([]T {})` where `T` is a row struct;
/// `cols` is `[]TableCol` (title + width) for the header. The body is a
/// `VirtualList` of `build(i, row)` — only visible rows are mounted. The
/// themed header (`TableCols`) shares its gutter with body rows; build every
/// cell with `set_flex_basis_zero(...).grow(1)` (or a fixed `.set_width(px)` matching the column)
/// so body columns line up under the header.
/// Extras for `VirtualTable`: `sort` wires the header's sortable columns
/// (see `TableColsProps`). Rows are the app's `Signal<[]T>`, so the app
/// reorders them — `sort_by` with a key per column — in an effect on `sort`.
struct VirtualTableProps {
    sort: Option<Signal<int>> = none,
}

fn VirtualTable<T>(rows: Signal<[]T>, cols: []TableCol, row_h: int, build: fn(int, T) -> Node,
                   p: VirtualTableProps) -> Node {
    return Box(style = Style(direction = Direction.Column, grow = 1), role = "table") {
        TableCols(cols, sort = p.sort)
        VirtualList(rows, row_h, build)
    }
}

/// Card chrome. `Card()` keeps the recipe; pass any style prop to restyle
/// it without copying the widget (`Card(radius = 6, padding = 12)`).
/// `visible` and `bind` go through `Component`.

/// Card body slot. The trailing block lands here — after the media and
/// header, before the footer — so `Card(title = "…") { … }` reads top-down.

/// Build your own widget: extends `Component` via `Box`. Trailing block is
/// the slot. `bind` / `visible` / `press` are the same lifecycle as every
/// other widget — pass them here, do not call `ui_push` / `bind` / `show`.

fn Comp(p: BoxProps) -> Node {
    // A clickable custom widget presses like a button.
    let press = p.press || result.is_some(p.on_click)
    return Component(raw_box(), style = p.style, ref = p.ref, keys = p.keys,
                     role = p.role, label = p.label,
                     on_click = p.on_click, hoverOff = p.hoverOff, bind = p.bind,
                     visible = p.visible, press = press, focusable = p.focusable,
                     roving = p.roving, rovingGrab = p.rovingGrab, hoverFade = p.hoverFade, pressScale = p.pressScale,
                     lift = p.lift, enter = p.enter, label = p.label, loading = p.loading,
                     on_hover = p.on_hover)
}

struct ComboboxProps {
    placeholder: string = "Search",
    /// Style, merged over the recipe's own: `style = Style(radius = corners(4))`.
    style: Option<fn() -> Style> = none,
}

/// A text field with a filtered option list below it. Clicking the field (or
/// its chevron), typing, or Down opens the list; an empty query shows every
/// option. Up / Down move the highlight, Enter picks the highlighted option into
/// the field, Escape or an outside click closes. `text` is the one piece of state
/// and belongs to the caller. Options should be unique: the list is keyed by
/// label (`zeus.For`).
fn Combobox(text: Signal<string>, options: []string, p: ComboboxProps) -> Node {
    // state
    let active = signal(-1)
    let matches = signal([]string {})
    let opts = options
    // The list keeps the field's width (the caller's, or 240).
    let w = len_or(style_of(p.style).width, 240)
    let field = ref()
    let input = ref()
    let list = ref()
    let scrim = ref()

    // controller
    effect(|| {
        matches.set(combo_filter(opts, text.get()))
    })
    // Open on click whether the pointer lands on the field frame, the chevron,
    // or the text area itself. The inner input consumes its click (it is
    // focusable, so the engine stops walking up the tree there), so both get
    // the handler; it is idempotent.
    fn open_list() {
        focus(input)
        if active.get() < 0 {
            active.set(0)
        }
    }
    // A focused text field consumes Enter before any keymap chord sees it, so
    // the list keys are read in `on_key_down` via `current_key()`.
    fn list_key() {
        let picked = combo_key(active, matches)
        if picked >= 0 {
            let ms = matches.get()
            if picked < ms.len {
                text.set(ms[picked])
                set_input(ref_node(input), ms[picked])
            }
            skip_exit(list)
            skip_exit(scrim)
            active.set(-1)
        }
    }
    on_mount(|| {
        anchor(list, field, Place.PlaceBelow, 4)
    })

    // tree. The scrim comes first so the field and list draw over it.
    return Box(style = merge(Style(direction = Direction.Column), Style(alignSelf = Align.Start))) {
        Overlay(on_click = fn() { active.set(-1) }, ref = scrim,
                style = Style(display = shown(active.get() >= 0), zIndex = Z_SCRIM))
        Box(
            ref = field,
            style = merge(Style(width = px(w),
                                direction = Direction.Row,
                                gap = 4,
                                align = Align.Center,
                                zIndex = Z_FIELD,
                                padding = edges2(8, 12),
                                radius = corners(RAD_MD),
                                border = line(HAIRLINE, rule()),
                                background = plate(),
                                cursor = "text"), style_of(p.style)),
            on_click = open_list,
            focusable = false
        ) {
            Input(ref = input,
                  bind = text,
                  placeholder = p.placeholder,
                  style = Style(grow = 1, font = FONT_BODY, padding = edges(0), color = ink()),
                  label = p.placeholder,
                  on_click = open_list,
                  on_key_down = list_key)
            InputClear(text, input)
            Icon(IC_CHEV_DOWN, 16, dim())
        }
        Box(
            ref = list,
            style = merge(Style(width = px(w),
                                direction = Direction.Column,
                                gap = 2,
                                elevation = 2,
                                position = pos_absolute(),
                                zIndex = Z_POPUP,
                                padding = edges(4),
                                radius = corners(RAD_MD),
                                border = line(HAIRLINE, rule()),
                                background = plate()), Style(display = shown(active.get() >= 0))),
            enter = Enter.Fade
        ) {
            For(matches, fn(s) => s, fn(i, s) {
                return ComboRow(text, active, input, i, s, scrim)
            })
        }
    }
}

/// One option row of a `Combobox`. Picking writes the label into the field.
fn ComboRow(text: Signal<string>, active: Signal<int>, input: Ref, index: int, label: string,
            scrim: Ref) -> Node {
    // state
    let row = ref()

    // controller
    fn pick() {
        text.set(label)
        set_input(ref_node(input), label)
        skip_exit(row)
        skip_exit(scrim)
        active.set(-1)
    }

    // tree
    return Box(
        ref = row,
        style = merge(Style(direction = Direction.Row,
                            gap = 4,
                            align = Align.Center,
                            padding = edges2(6, 8),
                            radius = corners(RAD_SM),
                            cursor = "pointer"), style_of(highlight(active.get() == index))),
        role = "option",
        label = label,
        hoverOff = false,
        on_click = pick,
        focusable = false
    ) {
        Text(label, style = Style(font = FONT_BODY, color = ink()))
    }
}

/// A single-open accordion. `open` is the *only* state: the open item's index,
/// or `-1` for all closed. Items take the shared signal and their own `index`;
/// no item owns state. Opening one closes the rest by construction — there is
/// one index, so two items can never both match it.
fn Accordion(open: Signal<int>, p: AccordionProps) -> Node {
    // state. One ref per header, so up / down can hand focus to a sibling.
    let mut heads = []Ref {}
    for _ in 0..p.items.len {
        push(heads, ref())
    }

    // tree. Clip the rounded corners, so a body cannot spill past the card edge.
    return Box(style = merge(merge(Style(direction = Direction.Column,
                                         radius = corners(RAD_LG),
                                         border = line(HAIRLINE, rule()),
                                         background = plate()), Style(overflow = Overflow.Hidden)), style_of(p.style)),
               bind = p.bind) {
        Loop(p.items, (index, item) => {
            AccordionItem(open = open, index = index, title = item.title, body = item.body,
                          heads = heads)
        })
    }
}

struct AccordionProps {
    bind: Option<Signal<int>> = none,
    items: []AccordionRow,
    /// Style, merged over the recipe's own: `style = Style(radius = corners(4))`.
    style: Option<fn() -> Style> = none,
}

struct AccordionItemProps {
    /// The accordion's single open-index signal (`-1` = all closed).
    open: Signal<int> = Signal { id: 0 },
    /// This item's index within its accordion.
    index: int = 0,
    /// Header label.
    title: fn() -> string = empty_text,
    /// Body copy, shown while this item is open.
    body: fn() -> string = empty_text,
    /// Optional leading icon markup.
    icon: string = "",
    /// Every header in the accordion, by index (`Accordion` fills it). Up /
    /// down / Home / End move focus along it; empty, the keys are off.
    heads: []Ref = []Ref {},
}

/// One row of an `Accordion`. Reads the shared `open` signal and compares it to
/// `index`, so it holds no state of its own: the chevron rotates on a paint-only
/// track and the body fades in, both driven by the container's one signal.
fn AccordionItem(p: AccordionItemProps) -> Node {
    // state
    let open = p.open
    let idx = p.index
    let chev = ref()

    // controller
    fn toggle() {
        if open.get() == idx {
            open.set(-1)
        } else {
            open.set(idx)
        }
    }
    // Focus moves between headers; the open item does not follow it.
    fn focus_head(i: int) {
        if i >= 0 && i < p.heads.len {
            focus(p.heads[i])
        }
    }
    let keys = []KeyBind {
        chord("down", "accordion.next", fn() { focus_head(idx + 1) }),
        chord("up", "accordion.prev", fn() { focus_head(idx - 1) }),
        chord("home", "accordion.first", fn() { focus_head(0) }),
        chord("end", "accordion.last", fn() { focus_head(p.heads.len - 1) }),
    }
    let head = if idx < p.heads.len { p.heads[idx] } else { ref() }
    on_mount(|| {
        effect(|| {
            if open.get() == idx {
                animate_rotate(ref_node(chev), 180, Motion.Fast)
            } else {
                animate_rotate(ref_node(chev), 0, Motion.Fast)
            }
        })
    })

    // tree. No gap above the body: the header already carries the top inset.
    return Box(style = Style(direction = Direction.Column)) {
        Box(style = Style(direction = Direction.Row,
                          gap = Space.Xs,
                          align = Align.Center,
                          padding = edges2(12, 16),
                          cursor = "pointer"),
            ref = head,
            on_click = toggle,
            keys = keys,
            role = "button",
            label = p.title(),
            hoverOff = false,
            press = true) {
            if p.icon.len > 0 {
                Icon(p.icon, 16, dim())
            }
            Text(p.title, style = Style(grow = 1, font = FONT_CONTROL, color = ink()))
            Icon(IC_CHEV_DOWN, 16, dim(), ref = chev)
        }
        Box(style = merge(Style(direction = Direction.Column,
                                padding = Edges(top = 0, right = 16, bottom = 12, left = 16)), Style(display = shown(open.get() == idx))),
            enter = Enter.Fade + Enter.Reveal) {
            Text(p.body, style = Style(wrap = true, font = FONT_BODY, color = mute()))
        }
    }
}

struct PopoverProps {
    /// Open while true.
    open: Signal<bool> = Signal { id: 0 },
    /// Preferred side (`Place.*`); flips when it would overflow.
    place: int = 0,
    gap: int = 6,
    closeKey: string = "escape",
    /// The element the panel floats beside; built here, so the panel can
    /// anchor to it.
    trigger: fn() = noop,
    /// The trailing block: the panel body.
    children: fn() = noop,
    /// Style, merged over the recipe's own: `style = Style(radius = corners(4))`.
    style: Option<fn() -> Style> = none,
}

/// A floating panel anchored to `trigger`. `open` is a bool signal; outside
/// click and Escape close it. Edge-aware: `place` is preferred, flipped when
/// it would leave the safe-area rect. Trailing block is the panel body.
fn Popover(p: PopoverProps) -> Node {
    // state
    let open = p.open
    let host = ref()
    let panel = ref()

    // controller. Focus moves into the panel when it opens, so Escape reaches it.
    fn close() {
        open.set(false)
    }
    on_mount(|| {
        anchor(panel, child_ref(host, 0), p.place, p.gap)
        effect(|| {
            if open.get() {
                focus(panel)
            }
        })
    })

    // keys
    let keys = []KeyBind { chord(p.closeKey, "popover.close", close) }

    // tree. The host holds only the trigger in flow; the transparent scrim
    // (outside click closes) and the anchored panel float.
    return Box(ref = host) {
        p.trigger()
        Overlay(visible = open.get(), on_click = close, style = Style(zIndex = Z_SCRIM))
        Box(ref = panel,
            style = merge(Style(direction = Direction.Column,
                                gap = Space.Xs,
                                elevation = 3,
                                position = pos_absolute(),
                                zIndex = Z_POPUP,
                                padding = edges(Space.Sm),
                                radius = corners(RAD_LG),
                                border = line(HAIRLINE, rule()),
                                background = plate()), style_of(p.style)),
            visible = open.get(),
            enter = Enter.Fade,
            keys = keys) {
            p.children()
        }
    }
}

struct MenuProps {
    /// Open at this item index; `-1` is closed. The menu's only state. Pass
    /// one to observe or drive the menu from outside; omitted, the menu owns it.
    active: Option<Signal<int>> = none,
    items: []MenuRow,
    /// Runs with the picked row's index. Rows are plain data; this is the one
    /// callback for the whole menu.
    on_select: Option<fn(int)> = none,
    label: string = "",
    /// Preferred side (`Place.*`); flips when it would overflow.
    place: int = 0,
    gap: int = 4,
    /// Chord that dismisses the open menu.
    closeKey: string = "escape",
    /// The element that opens the menu; clicking it toggles.
    trigger: fn() = noop,
    /// The trailing block: more rows after `items` (`MenuItem`, ...).
    children: fn() = noop,
    /// Style, merged over the recipe's own: `style = Style(radius = corners(4))`.
    style: Option<fn() -> Style> = none,
}

/// A dropdown menu anchored to `trigger`. Clicking the trigger toggles it;
/// outside click and Escape close it; `place` is preferred and flips near the
/// viewport edge. The trailing block is the item list (`MenuItem` /
/// `MenuLabel` / `MenuSeparator`).
fn Menu(p: MenuProps) -> Node {
    // state. `active` is the menu's only state; omitted, the menu owns it.
    let active = if result.is_some(p.active) { p.active.val } else { signal(-1) }
    let host = ref()
    let panel = ref()
    let scrim = ref()

    // controller. The trigger owns the toggle; opening lands on the first item.
    fn toggle() {
        if active.get() >= 0 {
            active.set(-1)
        } else {
            active.set(0)
        }
    }
    fn close() {
        active.set(-1)
    }
    on_mount(|| {
        let trigger = child_ref(host, 0)
        set_on_click(trigger, toggle)
        anchor(panel, trigger, p.place, p.gap)
    })

    // keys. Escape closes while focus is inside the menu.
    let keys = []KeyBind { chord(p.closeKey, "menu.dismiss", close) }

    // tree
    return Box(ref = host) {
        p.trigger()
        Overlay(ref = scrim, on_click = close,
                style = Style(display = shown(active.get() >= 0), zIndex = Z_SCRIM))
        Box(ref = panel,
            style = merge(merge(Style(direction = Direction.Column,
                                      gap = 2,
                                      elevation = 3,
                                      position = pos_absolute(),
                                      zIndex = Z_POPUP,
                                      padding = edges(4),
                                      radius = corners(RAD_LG),
                                      border = line(HAIRLINE, rule()),
                                      background = plate(),
                                      cursor = "pointer"), Style(display = shown(active.get() >= 0))), style_of(p.style)),
            role = "menu",
            enter = Enter.Fade,
            keys = keys) {
            if p.label.len > 0 {
                MenuLabel(p.label)
            }
            Loop(p.items, fn(index, item) {
                if item.isSeparated {
                    MenuSeparator()
                }
                return MenuItem(active = active, index = index, count = p.items.len,
                                label = item.label, danger = item.danger,
                                scrim = scrim,
                                on_click = fn() => emit_with(p.on_select, index))
            })
            p.children()
        }
    }
}

struct MenuItemProps {
    /// The menu's one signal; the item compares it to `index`.
    active: Option<Signal<int>> = none,
    /// This item's position within its menu.
    index: int = 0,
    /// How many items the menu has, so Up / Down clamp at the ends. Pass the
    /// same number to every item.
    count: int = 0,
    label: fn() -> string = empty_text,
    /// Optional leading icon markup.
    icon: string = "",
    on_click: Option<fn()> = none,
    disabled: bool = false,
    /// Destructive command: painted in the danger ink.
    danger: bool = false,
    /// The menu scrim. Snapped on pick so its exit track does not keep frames
    /// live after the panel is already gone.
    scrim: Ref = Ref {},
}

/// One command row. Highlights while `active == index`; the pointer moves
/// `active` on hover, so pointer and keyboard share one highlight. Owns no
/// state — the menu's `active` is the only signal.
fn MenuItem(p: MenuItemProps) -> Node {
    // state
    let active = result.some_or(p.active, no_signal())
    let idx = p.index
    let n = p.count
    let off = p.disabled
    let row_ink = if p.danger { danger_ink() } else { ink() }
    let row = ref()

    // controller. A pick runs `on_click`, then jumps the exit fade so the
    // panel is gone this frame (a Fast fade left item labels over the heading).
    fn run() {
        if !off {
            emit(p.on_click)
            skip_exit(row)
            skip_exit(p.scrim)
            active.set(-1)
        }
    }
    fn next() {
        if active.get() >= 0 {
            if active.get() + 1 < n {
                active.set(active.get() + 1)
            }
        }
    }
    fn prev() {
        if active.get() > 0 {
            active.set(active.get() - 1)
        }
    }

    // keys. Every handler is gated on `active`, so keys pressed after a close
    // are inert even if this (now hidden) row is still the focused one.
    let keys = []KeyBind {
        chord("down", "menu.next", next),
        chord("up", "menu.prev", prev),
        chord("enter", "menu.activate", fn() {
            if active.get() == idx {
                run()
            }
        }),
    }

    // tree. Hover moves the highlight, so the pointer and the keyboard agree;
    // only the active row is a tab stop, and it takes focus as it activates.
    return Box(ref = row,
               style = merge(Style(direction = Direction.Row,
                                   gap = Space.Xs,
                                   align = Align.Center,
                                   padding = edges2(7, 10),
                                   radius = corners(RAD_SM),
                                   cursor = "pointer"), style_of(highlight(active.get() == idx))),
               role = "menuitem",
               label = p.label(),
               enabled = !off,
               press = true,
               on_click = run,
               on_hover = fn(on: bool) {
        if on {
            active.set(idx)
        }
    },
               keys = keys,
               roving = active.get() == idx,
               rovingGrab = true) {
        if p.icon.len > 0 {
            Icon(p.icon, 16, dim())
        }
        Text(p.label, style = Style(grow = 1, font = FONT_BODY, color = row_ink, ellipsis = true))
    }
}

/// A non-interactive group heading inside a `Menu`.
fn MenuLabel(text: fn() -> string) -> Node {
    return Box(style = Style(padding = edges2(6, 10))) {
        Text(text, style = Style(font = FONT_CAPTION, color = dim()))
    }
}

/// A hairline between menu groups.
fn MenuSeparator() -> Node {
    return Box(style = Style(padding = Edges(top = 3, bottom = 3))) {
        Separator()
    }
}

struct DrawerProps {
    /// Edge to slide from (`Side.*`). The top / bottom edges are the sheet shape.
    side: int = 1,
    /// Panel extent: width for the start / end edges, height for top / bottom.
    size: int = 320,
    /// Radius of the edge that faces the content (the inner edge). `-1` uses
    /// the sheet default (`RAD_XL`), `0` is square. The outer edge stays square
    /// so the panel meets the window edge cleanly.
    radius: int = -1,
    /// Chord that closes the drawer.
    closeKey: string = "escape",
    /// The trailing block: the body, placed by the component.
    children: fn() = noop,
    /// Style, merged over the recipe's own: `style = Style(radius = corners(4))`.
    style: Option<fn() -> Style> = none,
}

/// An edge panel over a scrim. `open` is a bool signal; the scrim closes it on
/// outside click and Escape closes it while focus is inside. `side` picks the
/// edge and `size` the extent. Like the Dialog, the panel swallows clicks so a
/// press inside does not close it. Trailing block is the panel content.
fn Drawer(open: Signal<bool>, p: DrawerProps) -> Node {
    // state
    let panel = ref()
    let side = p.side
    let size = p.size
    let across = side == Side.SideStart || side == Side.SideEnd
    let corner = px_or_default(p.radius, RAD_XL)

    // controller. Rest off the edge, then slide on. Paint-only: a transform
    // never runs the layout pass, and at boot the track jumps to its value.
    on_mount(|| {
        drawer_slide(ref_node(panel), side, size, 0)
        effect(|| {
            if open.get() {
                drawer_slide(ref_node(panel), side, 0, Motion.Base)
            } else {
                drawer_slide(ref_node(panel), side, size, Motion.Fast)
            }
        })
        effect(|| {
            if open.get() {
                focus(panel)
            }
        })
    })

    // keys
    let keys = []KeyBind { chord(p.closeKey, "drawer.close", fn() { open.set(false) }) }

    // tree. The overlay pins the panel to the chosen edge (a row for the side
    // edges); the panel swallows clicks so a press inside does not close it.
    // Only the inner edge rounds, so the sheet meets the window edge square.
    return Overlay(style = merge(Style(opacity = 80, background = scrim()), drawer_dock(side)),
                   visible = open.get(),
                   on_click = fn() { open.set(false) }) {
        Box(ref = panel,
            style = merge(merge(Style(width = len_px(if across { size } else { -1 }),
                                      height = len_px(if across { -1 } else { size }),
                                      direction = Direction.Column,
                                      gap = Space.Sm,
                                      elevation = 4,
                                      padding = edges(Space.Md),
                                      border = line(HAIRLINE, rule()),
                                      background = plate()), style_of(drawer_corners(side, corner))), style_of(p.style)),
            role = "dialog",
            on_click = fn() { return },
            enter = Enter.Fade,
            keys = keys) {
            p.children()
        }
    }
}

/// The overlay's layout for a drawer edge: the panel sits at that edge and
/// stretches along it.
fn drawer_dock(side: int) -> Style {
    if side == Side.SideStart {
        return Style(direction = Direction.Row, justify = Align.Start, align = Align.Stretch)
    }
    if side == Side.SideEnd {
        return Style(direction = Direction.Row, justify = Align.End, align = Align.Stretch)
    }
    if side == Side.SideTop {
        return Style(justify = Align.Start, align = Align.Stretch)
    }
    return Style(justify = Align.End, align = Align.Stretch)
}

/// The sheet shape: only the corners on the inner edge round.
fn drawer_corners(side: int, r: int) -> Style {
    if r <= 0 {
        return Style {}
    }
    if side == Side.SideBottom {
        return Style(radius = corners4(r, r, 0, 0))
    }
    if side == Side.SideTop {
        return Style(radius = corners4(0, 0, r, r))
    }
    if side == Side.SideStart {
        return Style(radius = corners4(0, r, r, 0))
    }
    return Style(radius = corners4(r, 0, 0, r))
}

/// Slide `panel` to `to` points along its edge's axis (positive is out).
fn drawer_slide(panel: Node, side: int, to: int, ms: int) {
    if side == Side.SideStart {
        animate_x(panel, -to, ms)
    } else if side == Side.SideEnd {
        animate_x(panel, to, ms)
    } else if side == Side.SideTop {
        animate_y(panel, -to, ms)
    } else {
        animate_y(panel, to, ms)
    }
}

struct TooltipProps {
    text: fn() -> string = empty_text,
    /// Where the bubble sits (`Place.*`). The six tooltip placements are
    /// `PlaceAboveStart` / `PlaceAboveCenter` / `PlaceAboveEnd` and the three
    /// `PlaceBelow*` — i.e. top-left, top-centre, top-right, bottom-left,
    /// bottom-centre, bottom-right. `PlaceAbove` / `PlaceBelow` still work and
    /// are start-aligned. Defaults to top-centre, which is what a tooltip is.
    place: int = 5,
    gap: int = 6,
    /// Draw the little caret that points at the trigger. Dropped for the side
    /// placements, which have no edge facing the trigger.
    arrow: bool = true,
    /// Delay before showing, in ms (hover intent).
    delay: int = 400,
    /// The element the tooltip describes.
    trigger: fn() = noop,
}

/// 1 when the bubble is above its trigger (so the caret points down).
fn tooltip_above(place: int) -> bool {
    if place == Place.PlaceBelow || place == Place.PlaceBelowStart ||
    place == Place.PlaceBelowCenter || place == Place.PlaceBelowEnd {
        return false
    }
    return true
}

/// A caret only makes sense on an edge that faces the trigger.
fn tooltip_arrow_ok(place: int) -> bool {
    if place == Place.PlaceEnd || place == Place.PlaceStart {
        return false
    }
    return true
}

/// Slide the caret along the trigger's edge to follow the bubble's alignment.
fn tooltip_justify(place: int) -> int {
    if place == Place.PlaceAboveStart || place == Place.PlaceBelowStart {
        return Align.Start
    }
    if place == Place.PlaceAboveEnd || place == Place.PlaceBelowEnd {
        return Align.End
    }
    return Align.Center
}

/// A small non-interactive label shown while the pointer rests on `trigger`.
fn Tooltip(p: TooltipProps) -> Node {
    // state
    let hovered = signal(0)
    let shown_sig = signal(0)
    let delay = p.delay
    let host = ref()
    let panel = ref()
    let above = tooltip_above(p.place)
    let edge = 0 - (TOOLTIP_PAD_Y + TOOLTIP_ARROW / 2)

    // controller. Hover intent: show after `delay`, hide at once.
    effect(|| {
        if hovered.get() != 0 {
            async.after(delay, fn() {
                if hovered.get() != 0 {
                    shown_sig.set(1)
                }
            })
        } else {
            shown_sig.set(0)
        }
    })
    on_mount(|| {
        let trigger = child_ref(host, 0)
        watch_hover(trigger, hovered)
        anchor(panel, trigger, p.place, p.gap)
    })

    // tree. The caret is a square rotated 45°, straddling the edge that faces
    // the trigger: half lies on the panel's own fill and half sticks out.
    // Absolute children are placed against the panel's content box, so the
    // offset adds the padding back to land the caret's centre on the edge.
    return Box(ref = host) {
        p.trigger()
        Box(ref = panel,
            style = Style(direction = Direction.Column,
                          elevation = 2,
                          position = pos_absolute(),
                          zIndex = 70,
                          padding = edges2(TOOLTIP_PAD_Y, TOOLTIP_PAD_X),
                          radius = corners(RAD_SM),
                          background = ink()),
            visible = shown_sig.get() != 0,
            role = "tooltip",
            label = p.text(),
            enter = Enter.Fade) {
            Text(p.text, style = Style(font = FONT_CAPTION, color = on_ink()))
            if p.arrow && tooltip_arrow_ok(p.place) {
                Box(style = Style(height = px(TOOLTIP_ARROW),
                                  direction = Direction.Row,
                                  justify = tooltip_justify(p.place),
                                  position = pos_absolute(),
                                  inset = inset_from(if above { -1 } else { edge }, 0, if above { edge } else { -1 }, 0))) {
                    TooltipCaret()
                }
            }
        }
    }
}

/// The tooltip's caret: an ink square turned 45°.
fn TooltipCaret() -> Node {
    let caret = ref()
    on_mount(|| {
        animate_rotate(ref_node(caret), 45, 0)
    })
    return Box(ref = caret, style = Style(width = px(TOOLTIP_ARROW), height = px(TOOLTIP_ARROW), background = ink()))
}

struct HoverCardProps {
    place: int = 1,
    gap: int = 8,
    /// Delay before showing, in ms. Longer than a tooltip: a hover card is
    /// larger and should not appear under a passing pointer.
    delay: int = 300,
    /// The element that shows the card on hover.
    trigger: fn() = noop,
    /// The trailing block: the card body.
    children: fn() = noop,
    /// Style, merged over the recipe's own: `style = Style(radius = corners(4))`.
    style: Option<fn() -> Style> = none,
}

/// A hover-triggered panel, larger and interactive where a `Tooltip` is not.
/// Trailing block is the card body.
fn HoverCard(p: HoverCardProps) -> Node {
    // state
    let hovered = signal(0)
    let shown_sig = signal(0)
    let delay = p.delay
    let host = ref()
    let panel = ref()

    // controller. Hover intent, longer than a tooltip's.
    effect(|| {
        if hovered.get() != 0 {
            async.after(delay, fn() {
                if hovered.get() != 0 {
                    shown_sig.set(1)
                }
            })
        } else {
            shown_sig.set(0)
        }
    })
    on_mount(|| {
        let trigger = child_ref(host, 0)
        watch_hover(trigger, hovered)
        anchor(panel, trigger, p.place, p.gap)
    })

    // tree
    return Box(ref = host) {
        p.trigger()
        Box(ref = panel,
            style = merge(Style(width = px(280), direction = Direction.Column,
                                gap = Space.Xs,
                                elevation = 2,
                                position = pos_absolute(),
                                zIndex = 70,
                                padding = edges(Space.Sm),
                                radius = corners(RAD_LG),
                                border = line(HAIRLINE, rule()),
                                background = plate()), style_of(p.style)),
            visible = shown_sig.get() != 0,
            enter = Enter.Fade) {
            p.children()
        }
    }
}

struct ToastProps {
    /// Auto-dismiss after this many ms.
    ms: int = 3200,
    /// 0 = bottom, 1 = top.
    place: int = 0,
    /// The trailing block: the body, placed by the component.
    children: fn() = noop,
    /// Style, merged over the recipe's own: `style = Style(radius = corners(4))`.
    style: Option<fn() -> Style> = none,
}

/// A transient message pinned to the bottom (or top) of the window. `open` is a
/// bool signal; it dismisses itself after `ms`, or on click. It rises and fades
/// in on open, and sinks and fades out on close. Trailing block is the message.
fn Toast(open: Signal<bool>, p: ToastProps) -> Node {
    // state
    let card = ref()
    let ms = p.ms

    // controller. Rest 12dp low, then rise to 0 while opening (jumps at boot).
    on_mount(|| {
        animate_y(ref_node(card), 12, 0)
        effect(|| {
            if open.get() {
                animate_y(ref_node(card), 0, Motion.Base)
                async.after(ms, fn() { open.set(false) })
            } else {
                animate_y(ref_node(card), 12, Motion.Fast)
            }
        })
    })

    // tree
    return Overlay(visible = open.get(), on_click = fn() { open.set(false) },
                   style = toast_dock(p.place)) {
        Box(ref = card,
            style = merge(Style(direction = Direction.Row,
                                gap = Space.Xs,
                                elevation = 2,
                                align = Align.Center,
                                padding = edges2(12, 16),
                                radius = corners(RAD_MD),
                                background = ink(),
                                cursor = "pointer"), style_of(p.style)),
            on_click = fn() { open.set(false) },
            enter = Enter.Fade) {
            p.children()
        }
    }
}

/// Where the toast sits: 24dp in from the bottom (0) or the top (1).
fn toast_dock(place: int) -> Style {
    if place == 1 {
        return Style(justify = Align.Start, padding = Edges(top = 24))
    }
    return Style(justify = Align.End, padding = Edges(bottom = 24))
}

/// Named extras for `Dialog` / `AlertDialog`. `title` shares the header
/// row with the close control (Dialog) or stands alone (AlertDialog).
struct DialogProps {
    title: string = "",
    /// The trailing block: the body, placed by the component.
    children: fn() = noop,
}

/// Dialog + AlertDialog chrome. Header is a row: title, then `Grow()`, then
/// a fixed 28px close slot (Dialog only). No `position` / `top` / `left`.
fn DialogShell(open: Signal<bool>, close_x: bool, title: string, children: fn()) -> Node {
    // state
    let panel = ref()

    // controller. Scale-in: rest at 96%, grow to 100% while opening; shrink
    // back on close under the exit fade (paint-only, as the scrim's fade).
    // Focus is trapped in the panel while open.
    on_mount(|| {
        animate_scale(ref_node(panel), DIALOG_REST, 0)
        effect(|| {
            if open.get() {
                animate_scale(ref_node(panel), 100, Motion.Base)
            } else {
                animate_scale(ref_node(panel), DIALOG_REST, Motion.Fast)
            }
        })
        effect(|| {
            if open.get() {
                trap_focus(panel)
            } else {
                release_focus_trap(panel)
            }
        })
    })

    // keys
    let keys = []KeyBind { chord("escape", "dialog.close", fn() { open.set(false) }) }

    // tree. Responsive: 92% of the window, capped at the desktop 440dp, so a
    // phone keeps a gutter instead of clipping the card. The panel swallows
    // clicks so a press inside does not reach the scrim.
    return Overlay(style = Style(opacity = 80, background = scrim()),
                   visible = open.get(),
                   on_click = fn() => open.set(false)) {
        Box(ref = panel,
            style = merge(Style(direction = Direction.Column,
                                gap = 16,
                                elevation = 4,
                                maxWidth = DIALOG_W,
                                padding = edges(24),
                                radius = corners(RAD_LG),
                                border = line(HAIRLINE, rule()),
                                background = plate()), Style(width = pct(92))),
            role = "dialog",
            on_click = fn() { return },
            enter = Enter.Fade,
            focusable = true,
            keys = keys) {
            Box(style = Style(direction = Direction.Row, gap = Space.Exs, align = Align.Center)) {
                Title(title)
                Grow()
                if close_x {
                    Box(style = Style(width = px(28),
                                      height = px(28),
                                      direction = Direction.Row,
                                      shrink = 0,
                                      align = Align.Center,
                                      justify = Align.Center,
                                      radius = corners(RAD_MD),
                                      cursor = "pointer"),
                        on_click = fn() => open.set(false),
                        role = "button",
                        label = "Close",
                        focusable = true) {
                        Icon(IC_X, 16, mute())
                    }
                }
            }
            children()
        }
    }
}

/// Modal dialog: dim scrim, centered card. Pass `title = "..."` so the
/// heading and close control share one row. Trailing block is the body.
fn Dialog(open: Signal<bool>, p: DialogProps) -> Node {
    return DialogShell(open, true, p.title, p.children)
}

/// AlertDialog: modal confirm with no X. Pass `title = "..."` for the heading.
fn AlertDialog(open: Signal<bool>, p: DialogProps) -> Node {
    return DialogShell(open, false, p.title, p.children)
}

/// Top bar. `dark = true` (default) includes the appearance switch; pass
/// `dark = false` to omit it and put Dark in the trailing chrome yourself.
fn Navbar(brand: string, dark: bool = true) -> Node {
    return Column(0) {
        Box(style = Style(height = px(BAR),
                          direction = Direction.Row,
                          gap = Space.Md,
                          align = Align.Center),
            role = "navigation") {
            Pip(ink(), 10)
            Text(brand, style = Style(font = FONT_TITLE, color = ink()))
            Grow()
            if dark {
                Text("Dark", style = Style(font = FONT_CONTROL, color = mute()))
                ThemeSwitch()
            }
        }
        Separator()
    }
}

/// Docs-style nav item: muted text, muted pill when active, 36px tall.
fn NavTab(label: string, page: Signal<int>, index: int) -> Node {
    fn active() -> bool {
        return page.get() == index
    }
    return Box(
        style = merge(Style(height = px(36),
                            direction = Direction.Row,
                            gap = Space.Exxs,
                            align = Align.Center,
                            padding = Edges(right = 12, left = 12),
                            radius = corners(RAD_MD),
                            cursor = "pointer"), Style(background = if active() { raised() } else { paper() })),
        on_click = fn() => page.set(index),
        role = "button",
        label = label
    ) {
        Text(label,
             style = merge(Style(font = FONT_BODY, ellipsis = true), Style(color = if active() { ink() } else { mute() })))
    }
}

/// Header row: muted label cells above a hairline. Cells use zero basis +
/// grow so columns split the row evenly and line up with `TableRow`.
fn TableHead(cols: []string) -> Node {
    return Column(Space.Exs) {
        // Same gutter as `TableRow`, so header and cells share column edges.
        Box(style = Style(direction = Direction.Row,
                          gap = Space.Sm,
                          align = Align.Center,
                          padding = Edges(right = Space.Exs, left = Space.Exs))) {
            Loop(cols, fn(i, t) {
                return TableCell(t, 0, Align.Start, mute())
            })
        }
        Separator()
    }
}

/// Is the node about to be built an odd-numbered body row? Counts the
/// current slot parent's `TableRow` kids so far (role `row`), so a header
/// or separator sibling does not shift the stripe.
fn table_row_odd() -> bool {
    return slot_count_role("row") % 2 == 1
}

/// Shell every body row shares: stripe, hover, click, role `row`.
fn TableRowShell(p: TableRowProps) -> Node {
    let fill = if p.zebra && table_row_odd() { raised() } else { "" }
    let cursor = if result.is_some(p.on_click) { "pointer" } else { "" }
    return Box(style = Style(direction = Direction.Row,
                             gap = Space.Sm,
                             align = Align.Center,
                             padding = edges(Space.Exs),
                             radius = corners(RAD_SM),
                             background = opt_color(fill),
                             cursor = opt_color(cursor)),
               on_click = p.on_click,
               role = "row",
               hoverFade = p.hover || result.is_some(p.on_click))
}

/// A `TableCol.width` as a `Box` width prop: 0 (share the row) is -1 (unset).
fn table_col_width(w: int) -> int {
    if w <= 0 {
        return -1
    }
    return w
}

/// One cell: `width` 0 shares the row, `align` is `Align.*`.
fn TableCell(text: string, width: int, align: int, tint: string) -> Node {
    return Box(style = merge(Style(width = len_px(table_col_width(width)),
                                   direction = Direction.Row,
                                   justify = align), style_of(table_share(width)))) {
        Text(text, style = Style(font = FONT_BODY, color = tint, ellipsis = true))
    }
}

/// A column with no width shares the row: zero basis, grow 1.
fn table_share(width: int) -> Style {
    if width <= 0 {
        return Style(width = pct(0), grow = 1)
    }
    return Style {}
}

/// Body row: cells under a hairline, foreground text. Pair with `TableHead`.
/// `zebra` / `hover` / `on_click` are `TableRowProps`.
fn TableRow(cols: []string, p: TableRowProps) -> Node {
    let shell = TableRowShell(p) {
        Loop(cols, fn(i, t) {
            return TableCell(t, 0, Align.Start, ink())
        })
    }
    Separator()
    return shell
}

/// Body row laid out by a `[]TableCol` spec: fixed widths and per-column
/// alignment match the `TableCols` header. `cols` beyond `spec` share the
/// row, start-aligned.
fn TableRowCols(cols: []string, spec: []TableCol, p: TableRowProps) -> Node {
    let shell = TableRowShell(p) {
        Loop(cols, fn(i, t) {
            let w = if i < spec.len { spec[i].width } else { 0 }
            let al = if i < spec.len { spec[i].align } else { Align.Start }
            return TableCell(t, w, al, ink())
        })
    }
    Separator()
    return shell
}

/// Parse a cell as an integer (optional sign, digits, then anything —
/// "12", "-3", "30 kg" all count; "" and "abc" do not). Returns the value
/// and whether it parsed, so numeric columns sort by value.

/// Position of the row whose cells key is `k` in the caller's data
/// (-1 when it is gone).
fn table_index_of<T>(rows: Signal<[]T>, cells: fn(T) -> []string, k: string) -> int {
    let xs = rows.get()
    for i in 0..xs.len {
        if fmt.eq(cells_key(cells(xs[i])), k) {
            return i
        }
    }
    return -1
}

/// Extras for `Table`.
struct TableProps {
    /// Sort state (see `TableColsProps`); rows reorder when it changes.
    sort: Option<Signal<int>> = none,
    zebra: bool = false,
    hover: bool = false,
    /// Row click: receives the row's index in the caller's `rows` (not the
    /// sorted order), so `rows.get()[i]` is the item.
    on_pick: Option<fn(int)> = none,
}

/// Data table: a `TableCols` header over rows from a `Signal<[]T>`, each
/// row's text from `cells(t)` (one string per column). Rows are keyed by
/// their cells, so a sort moves the existing nodes instead of rebuilding
/// them. Pass `sort` and the shown order follows it (`sort_cells`) without
/// touching the caller's data; `zebra` / `hover` / `on_pick` go to every
/// row. A long list wants `VirtualTable` (windowed) instead.
fn Table<T>(spec: []TableCol, rows: Signal<[]T>, cells: fn(T) -> []string,
            p: TableProps) -> Node {
    // state
    let shown = signal(rows.get())
    let sort_set = result.is_some(p.sort)
    let sort = result.some_or(p.sort, no_signal())

    // controller
    effect(|| {
        let s = if sort_set { sort.get() } else { 0 }
        shown.set(sort_cells(rows.get(), cells, s))
    })

    // tree. One top-level child per item, so `For` can reorder rows.
    return Box(style = Style(direction = Direction.Column, gap = 0), role = "table") {
        TableCols(spec, sort = p.sort)
        For(shown, fn(t: T) -> string { return cells_key(cells(t)) }, fn(i: int, t: T) {
            return Column(0) {
                if result.is_some(p.on_pick) {
                    TableRowCols(cells(t), spec, zebra = p.zebra, hover = p.hover,
                                 on_click = fn() {
                        emit_with(p.on_pick, table_index_of(rows, cells, cells_key(cells(t))))
                    })
                } else {
                    TableRowCols(cells(t), spec, zebra = p.zebra, hover = p.hover)
                }
            }
        })
    }
}

/// Header from `[]TableCol` (`title` + `width`; 0 = equal share of the row).
/// A `sortable` column is a button that cycles `sort`; the sorted column
/// shows a direction arrow (see `TableColsProps`).
fn TableCols(cols: []TableCol, p: TableColsProps) -> Node {
    return Column(Space.Exs) {
        // Same gutter as the body rows (`padding_x = Space.Exs`), so header
        // and cells share the same column boundaries.
        Box(style = Style(direction = Direction.Row,
                          gap = Space.Sm,
                          align = Align.Center,
                          padding = Edges(right = Space.Exs, left = Space.Exs))) {
            Loop(cols, fn(i, c) {
                return TableColHead(c, i, c.sortable && result.is_some(p.sort), result.some_or(p.sort, no_signal()))
            })
        }
        Separator()
    }
}

/// One header cell. A sortable column is a button that cycles `sort` and shows
/// the arrow for the direction it is sorted in.
fn TableColHead(c: TableCol, i: int, sortable: bool, sort: Signal<int>) -> Node {
    return Box(style = merge(Style(width = len_px(table_col_width(c.width)),
                                   direction = Direction.Row,
                                   gap = 2,
                                   align = Align.Center,
                                   justify = c.align,
                                   cursor = opt_color(if sortable { "pointer" } else { "" })), style_of(table_share(c.width))),
               on_click = handler_if(sortable, fn() { sort.set(sort_cycle(sort.get(), i)) }),
               role = if sortable { "button" } else { "" },
               label = if sortable { "Sort by {{c.title}}" } else { "" },
               hoverFade = sortable) {
        Text(c.title, style = Style(font = FONT_BODY, color = mute()))
        if sortable {
            Icon(IC_SORT_ASC, 12, ink(), style = Style(display = shown(sort.get() == i + 1)))
            Icon(IC_SORT_DESC, 12, ink(), style = Style(display = shown(sort.get() == -(i + 1))))
        }
    }
}

/// Page number shown in `slot` (0-based) of a `PAGE_SLOTS`-wide row, or 0
/// for an ellipsis. Seven or fewer pages list every number; past that the
/// row keeps 1 and `pages` fixed and slides a window around `current_value`
/// (`1 … 4 5 6 … 20`), collapsing the ellipsis at either end.

/// Grouped bar chart. One shared y domain.
/// The plot re-fits the container: pass the intended width, and the chart
/// re-lays out whenever its card measures a different width.
fn BarChart(labels: []string, names: []string, vals: []int, w: int, h: int) -> Node {
    let n = labels.len
    let s = names.len
    if n == 0 {
        return Column(Space.Exs)
    }
    if s == 0 {
        return Column(Space.Exs)
    }
    let host = Column(Space.Exs)
    let node_id = host.id
    refit(host, fn() {
        chart_bars(labels, names, vals, n, s, w, h, host)
    })
    // Render immediately with the requested width; the next layout refits.
    return slot(node_handle(node_id), || {
        chart_bars(labels, names, vals, n, s, w, h, host)
    })
}

/// Straight-segment line chart with dots. `p` is `LineChartProps`: a fitted
/// y axis, implied decimals, a label stride, no dots. A `CHART_GAP` value
/// is not drawn and breaks its line.
fn LineChart(labels: []string, names: []string, vals: []int, w: int, h: int,
             p: LineChartProps) -> Node {
    let n = labels.len
    let s = names.len
    if n == 0 {
        return Column(Space.Exs)
    }
    if s == 0 {
        return Column(Space.Exs)
    }
    let host = Column(Space.Exs)
    let node_id = host.id
    refit(host, fn() {
        chart_lines(labels, names, vals, n, s, w, h, host, p)
    })
    return slot(node_handle(node_id), || {
        chart_lines(labels, names, vals, n, s, w, h, host, p)
    })
}

/// Area chart: tinted fill under the line (fill follows appearance).
fn AreaChart(labels: []string, names: []string, vals: []int, w: int, h: int) -> Node {
    let n = labels.len
    let s = names.len
    if n == 0 {
        return Column(Space.Exs)
    }
    if s == 0 {
        return Column(Space.Exs)
    }
    let host = Column(Space.Exs)
    let node_id = host.id
    refit(host, fn() {
        chart_areas(labels, names, vals, n, s, w, h, host)
    })
    return slot(node_handle(node_id), || {
        chart_areas(labels, names, vals, n, s, w, h, host)
    })
}

/// Ghost icon step button for the month/year rails.
fn CalStep(markup: string, label: string, press: fn()) -> Node {
    return Box(style = Style(width = px(28),
                             height = px(28),
                             direction = Direction.Row,
                             align = Align.Center,
                             justify = Align.Center,
                             radius = corners(RAD_MD),
                             cursor = "pointer"),
               on_click = press,
               role = "button",
               label = label,
               hoverOff = true) {
        Icon(markup, 16, mute())
    }
}

fn CalWeekday(s: string) -> Node {
    return Box(style = Style(width = px(CAL_CELL),
                             height = px(24),
                             direction = Direction.Row,
                             align = Align.Center,
                             justify = Align.Center)) {
        Text(s, style = Style(font = FONT_CAPTION, color = dim()))
    }
}

fn CalWeekRow() -> Node {
    return Grid(config = GridConfig(columns = 7, gap = 4)) {
        CalWeekday("Mo")
        CalWeekday("Tu")
        CalWeekday("We")
        CalWeekday("Th")
        CalWeekday("Fr")
        CalWeekday("Sa")
        CalWeekday("Su")
    }
}

fn CalCell(y: Signal<int>, m: Signal<int>, d: Signal<int>, open: Signal<bool>, idx: int) -> Node {
    // controller. Fill, label and text colour all track y / m / d.
    fn day() -> int {
        return cal_day_at(y.get(), m.get(), idx)
    }
    fn picked() -> bool {
        return day() > 0 && d.get() == day()
    }
    fn pick() {
        if day() > 0 {
            d.set(day())
            open.set(false)
        }
    }

    // tree. The picked day is the grid's one tab stop while the sheet is
    // open, and takes focus as the pick moves (opening lands on it).
    return Box(style = merge(Style(width = px(CAL_CELL),
                                   height = px(CAL_CELL),
                                   direction = Direction.Row,
                                   align = Align.Center,
                                   justify = Align.Center,
                                   padding = Edges(right = 2, left = 2),
                                   radius = corners(RAD_LG),
                                   cursor = "pointer"), Style(background = if picked() { accent() } else { plate() })),
               on_click = pick,
               role = "button",
               label = if day() == 0 { "" } else { "{{day()}}" },
               roving = picked() && open.get(),
               rovingGrab = true) {
        Text(if day() > 0 { "{{day()}}" } else { "" },
             style = merge(Style(font = FONT_BODY), Style(color = if picked() { on_ink() } else { ink() })))
    }
}

/// One 7×6 grid for whichever month `m` names: 42 fixed cells whose content
/// tracks `y`/`m`/`d` through prop thunks. Built once, no per-month subtrees.
fn CalGrid(y: Signal<int>, m: Signal<int>, d: Signal<int>, open: Signal<bool>) -> Node {
    return Grid(config = GridConfig(columns = 7, gap = 3)) {
        for i in 0..42 {
            CalCell(y, m, d, open, i)
        }
    }
}

/// Calendar picker: label, input-like trigger with a calendar icon, and a
/// floating sheet (kind-9 so the page scroller cannot clip it). Month and
/// year rails step with chevron icons; picking a day closes the sheet.
/// Keys, while the sheet is open: arrows move a day / a week (crossing
/// months), PageUp / PageDown a month, Home / End to the week's ends, Enter
/// picks, Escape closes.
fn DatePicker(y: Signal<int>, m: Signal<int>, d: Signal<int>) -> Node {
    // state
    let open = signal(false)

    // controller. Every move lands on a real date: a month step clamps the
    // day to the new month's length (Jan 31 → Feb 28). Steps only run while
    // the sheet is open, in case focus outlives the close.
    fn set_date(year: int, month: int, day: int) {
        batch(|| {
            y.set(year)
            m.set(month)
            d.set(day)
        })
    }
    fn step_month(delta: int) {
        if !open.get() {
            return
        }
        let mut yy = y.get()
        let mut mm = m.get() + delta
        while mm < 1 {
            mm = mm + 12
            yy = yy - 1
        }
        while mm > 12 {
            mm = mm - 12
            yy = yy + 1
        }
        let len = cal_len(yy, mm)
        set_date(yy, mm, if d.get() > len { len } else { d.get() })
    }
    fn step_day(delta: int) {
        if !open.get() {
            return
        }
        let mut yy = y.get()
        let mut mm = m.get()
        let mut dd = d.get() + delta
        while dd < 1 {
            mm = mm - 1
            if mm < 1 {
                mm = 12
                yy = yy - 1
            }
            dd = dd + cal_len(yy, mm)
        }
        while dd > cal_len(yy, mm) {
            dd = dd - cal_len(yy, mm)
            mm = mm + 1
            if mm > 12 {
                mm = 1
                yy = yy + 1
            }
        }
        set_date(yy, mm, dd)
    }
    // Monday-first, matching the grid: 0 = Mo … 6 = Su.
    fn weekday() -> int {
        return (cal_first_monday(y.get(), m.get()) + d.get() - 1) % 7
    }
    fn week_start() {
        if !open.get() {
            return
        }
        let to = d.get() - weekday()
        d.set(if to < 1 { 1 } else { to })
    }
    fn week_end() {
        if !open.get() {
            return
        }
        let to = d.get() + 6 - weekday()
        let len = cal_len(y.get(), m.get())
        d.set(if to > len { len } else { to })
    }
    fn prev_month() {
        step_month(-1)
    }
    fn next_month() {
        step_month(1)
    }

    // keys. On the sheet, so they answer wherever focus sits inside it.
    let keys = []KeyBind {
        chord("left", "date.prev_day", fn() { step_day(-1) }),
        chord("right", "date.next_day", fn() { step_day(1) }),
        chord("up", "date.prev_week", fn() { step_day(-7) }),
        chord("down", "date.next_week", fn() { step_day(7) }),
        chord("pageup", "date.prev_month", prev_month),
        chord("pagedown", "date.next_month", next_month),
        chord("home", "date.week_start", week_start),
        chord("end", "date.week_end", week_end),
    }

    // tree. An invisible full-window scrim closes the sheet on a click that
    // misses it; floaters hit-test in z order, so the scrim takes the Z_SCRIM
    // tier and the sheet Z_POPUP, which also swallows its own clicks.
    return Column(Space.Exs) {
        Overlay(style = Style(zIndex = Z_SCRIM),
                visible = open.get(),
                on_click = fn() => open.set(false))
        Label("Date")
        Box(
            style = Style(width = px(200),
                          direction = Direction.Row,
                          gap = 4,
                          align = Align.Center,
                          padding = edges2(8, 12),
                          radius = corners(RAD_MD),
                          border = line(HAIRLINE, rule()),
                          background = plate(),
                          cursor = "pointer"),
            on_click = fn() => open.set(!open.get()),
            role = "button",
            label = "Pick a date"
        ) {
            Icon(IC_CALENDAR, 16, mute())
            Text("{{y.get()}}", style = Style(font = FONT_BODY, color = ink()))
            Text("-", style = Style(font = FONT_BODY, color = mute()))
            Text("{{m.get()}}", style = Style(font = FONT_BODY, color = ink()))
            Text("-", style = Style(font = FONT_BODY, color = mute()))
            Text("{{d.get()}}", style = Style(font = FONT_BODY, color = ink()))
        }
        Box(
            style = Style(width = px(320),
                          direction = Direction.Column,
                          gap = Space.Exs,
                          position = pos_absolute(),
                          zIndex = Z_POPUP,
                          padding = edges(12),
                          inset = Edges(top = 68, left = 0),
                          radius = corners(RAD_LG),
                          border = line(HAIRLINE, rule()),
                          background = plate()),
            role = "dialog",
            on_click = fn() { return },
            keys = keys,
            visible = open.get()
        ) {
            Row(4) {
                CalStep(IC_CHEV_LEFT, "Previous month", prev_month)
                // One text node whose label tracks `m`, centred between the
                // month steps so long and short names do not jump the arrows.
                Box(style = Style(direction = Direction.Row,
                                  grow = 1,
                                  align = Align.Center,
                                  justify = Align.Center)) {
                    Text(cal_month_name(m.get()), style = Style(font = FONT_BODY, color = ink()))
                }
                CalStep(IC_CHEV_RIGHT, "Next month", next_month)
                Grow()
                CalStep(IC_CHEV_LEFT, "Previous year", fn() => y.set(y.get() - 1))
                // Bound text paints the live year, as the gauge widgets do.
                Text("", style = Style(font = FONT_BODY, color = ink()), bind = y)
                CalStep(IC_CHEV_RIGHT, "Next year", fn() => y.set(y.get() + 1))
            }
            CalWeekRow()
            CalGrid(y, m, d, open)
        }
    }
}

/// Page: white background column with breathing room. Sets the native
/// roles once; every following Component reads them at paint.
fn Page() -> Node {
    ensure_role_colors()
    return Box(style = Style(direction = Direction.Column,
                             gap = SECTION,
                             grow = 1,
                             padding = edges(PAGE_PAD),
                             background = paper()))
}
