//! atoms — the smallest Zeus pieces plus the declarative primitives every other
//! recipe builds on: labels and hairlines, badges / chips / avatars, meters and
//! stats, spinners and skeletons, the tree primitives (If / Loop / Each / For /
//! Index / Match / Boundary / Grid / Overlay / Scroll / Svg / Image), and the
//! shared helpers they need.
//!
//! Lowest component tier: imports nothing but `zeusbase` and the leaves below it.

import "zeus:structs"
import "zeus:enums"
import "zeus:zeusbase"
import "std:result"
import "zeus-components:colors"
import "zeus-components:spacing"
import "zeus:zeus_constants"
import "std:async"
import "std:fmt"
import "zeus:zeuscore/geometry"
import "zeus:zeuscore/platform"
import "zeus:zeuscore/arena"

struct GridProps {
    /// CSS-subset style; see `BoxProps.style`.
    style: Option<fn() -> Style> = none,
    config: GridConfig = GridConfig {},
    /// Keyboard actions on this element (`key_bind(...)`, `key_bind_click(...)`).
    keys: []KeyBind = no_keys(),
}

struct OverlayProps {
    style: Option<fn() -> Style> = none,
    ref: Option<Ref> = none,
    /// Shown while true: `visible = open.get()`.
    visible: Option<fn() -> bool> = none,
    on_click: Option<fn()> = none,
    /// Keyboard actions on this element (`key_bind(...)`, `key_bind_click(...)`).
    keys: []KeyBind = no_keys(),
}

/// Options for `Scroll`. `bind` is a two-way `scroll_y` signal: writing it
/// calls `scroll_to`, and wheel / pan / physics write the live offset back.
struct ScrollProps {
    /// CSS-subset style; see `BoxProps.style`.
    style: Option<fn() -> Style> = none,
    bind: Option<Signal<int>> = none,
    /// Keyboard actions on this element (`key_bind(...)`, `key_bind_click(...)`).
    keys: []KeyBind = no_keys(),
}

/// Geometry for `Svg` layers: explicit size plus absolute placement
/// (`position` / `left` / `top` / `right` / `bottom` / `z_index`, as
/// `BoxProps`). Without `width`/`height` an svg is measured like a label.
struct SvgProps {
    /// CSS-subset style; see `BoxProps.style`.
    style: Option<fn() -> Style> = none,
    /// Keyboard actions on this element (`key_bind(...)`, `key_bind_click(...)`).
    keys: []KeyBind = no_keys(),
}

/// Options for `Image`. Hosts decode PNG / JPEG / WebP / GIF from a path,
/// data URI, or URL and cache by `src`. With no `width`/`height` the box
/// takes the decoded source size: it keeps the source aspect ratio and fills
/// the container (device) width without growing past the source — web
/// `max-width: 100%`. Give `width` and the height follows the aspect ratio;
/// give `height` and the width is the container width. Set both to pin a box
/// that `fit` then maps the bitmap into. `fit` is `Fit` (stretch /
/// contain / cover / none).
struct ImageProps {
    /// CSS-subset style; see `BoxProps.style`.
    style: Option<fn() -> Style> = none,
    /// `Fit.Stretch` (default), `.Contain`, `.Cover`, or `.None`.
    fit: int = 0,
    /// Decode only once the node intersects the view (skip off-screen).
    lazy: bool = false,
    label: Option<fn() -> string> = none,
    /// Keyboard actions on this element (`key_bind(...)`, `key_bind_click(...)`).
    keys: []KeyBind = no_keys(),
}

/// Themed chrome branch of `Button`.

/// 2D grid. Fixed: `config = GridConfig(columns = 3, gap = 12, padding = 16)`.
/// Responsive: `autoColumns` is the narrowest a cell may be, in points like
/// `gap`. `GridConfig(columns = 3, autoColumns = 220, gap = 12)` fits as many
/// 220 point cells as the width allows — three at most, the `columns` cap —
/// and `autoColumns = 0` instead sizes a cell to the widest child.
fn Grid(p: GridProps) -> Node {
    return Component(
        set_auto_columns(raw_grid(p.config.columns, p.config.gap), p.config.autoColumns),
        style = merge(Style(padding = edges_from(p.config.padding, -1, -1, -1, -1, -1, -1)),
                      style_of(p.style)),
        keys = p.keys)
}

/// Full-window floater. Kind 9 is out of flow. Children are centred.
fn Overlay(p: OverlayProps) -> Node {
    return Component(raw_overlay(), style = p.style, visible = p.visible, on_click = p.on_click,
                     ref = p.ref, keys = p.keys)
}

struct ShowProps {
    /// Re-read when a signal it reads moves: `when = tab.get() == 2`.
    when: fn() -> bool,
    /// false: the body is built once and kept; `when` toggles layout only.
    /// true: the body is built on the first true and freed on each false.
    lazy: bool = false,
    /// The trailing block: the body.
    children: fn() = noop,
    /// Style, merged over the host column's own.
    style: Option<fn() -> Style> = none,
}

/// Reactive presence. A column that skips layout (and takes no gap slot)
/// while `when` is false. Unlike a build-time `if`, it follows `when`.
fn Show(p: ShowProps) -> Node {
    // A plain signal, written by an effect: layout and the `Match` host read
    // `on` raw, and a `computed` is only refreshed when something pulls it.
    let on = signal(0)
    effect(fn() {
        let v = if p.when() { 1 } else { 0 }
        if on.peek() != v {
            on.set(v)
        }
    })
    return Box(style = merge(Style(direction = Direction.Column), style_of(p.style)),
               visible = on.get() == 1) {
        if p.lazy {
            Match(on, fn(v: int) {
                if v == 1 {
                    p.children()
                }
            })
        } else {
            p.children()
        }
    }
}

/// Run `build(i, item)` for each element, once, at build time. `[]T` is Copy
/// when `T` is Copy, so this is safe inside a trailing block. This is the
/// *static* loop — the sequence is fixed at build time. For a list that follows
/// a signal, use `Each`.
fn Loop<T>(items: []T, build: fn(int, T) -> Node) {
    let n = items.len
    for i in 0..n {
        build(i, items[i])
    }
}

/// Append `v` to a live list signal and notify. Use with `For` / `VirtualList`.
/// A windowed list only rebuilds the visible window, not every row.
fn push_item<T>(sig: Signal<[]T>, v: T) {
    let mut xs = sig.get()
    push(xs, v)
    sig.set(xs)
}

/// Insert `v` at index `i` (clamped to `0..len`). Use with `For` / `VirtualList`.
fn insert_item<T>(sig: Signal<[]T>, i: int, v: T) {
    let xs = sig.get()
    let n = xs.len
    let mut at = i
    if at < 0 {
        at = 0
    }
    if at > n {
        at = n
    }
    let mut out = []T {}
    let mut j = 0
    while j < at {
        push(out, xs[j])
        j = j + 1
    }
    push(out, v)
    while j < n {
        push(out, xs[j])
        j = j + 1
    }
    sig.set(out)
}

/// Remove the item at index `i`. No-op if `i` is out of range.
fn remove_item<T>(sig: Signal<[]T>, i: int) {
    let xs = sig.get()
    let n = xs.len
    if i < 0 {
        return
    }
    if i >= n {
        return
    }
    let mut out = []T {}
    let mut j = 0
    while j < n {
        if j != i {
            push(out, xs[j])
        }
        j = j + 1
    }
    sig.set(out)
}

/// Remove the last item from a live list signal. No-op if empty.
fn pop_item<T>(sig: Signal<[]T>) {
    let mut xs = sig.get()
    if xs.len > 0 {
        pop(xs)
        sig.set(xs)
    }
}

fn virtual_refresh<T>(node_id: int, items: Signal<[]T>, build: fn(int, T) -> Node, row_h: int) {
    let xs = items.get()
    let m = xs.len
    let gen = platform.plat_sig_gen(items.id)
    let mut first = 0
    let mut last = m
    if row_h > 0 {
        let w = virtual_window(node_id, m, row_h)
        first = w.first
        last = w.last
    }
    if gen == arena.nodes[node_id].list_gen {
        if first == arena.nodes[node_id].list_lo {
            if last == arena.nodes[node_id].list_hi {
                if arena.nodes[node_id].kids.len > 0 {
                    return
                }
                if m == 0 {
                    arena.nodes[node_id].list_n = 0
                    return
                }
            }
        }
    }
    arena.nodes[node_id].list_gen = gen
    arena.nodes[node_id].list_lo = first
    arena.nodes[node_id].list_hi = last
    arena.nodes[node_id].list_n = m
    arena.nodes[node_id].row_h = row_h
    // Everything the builder allocated last time is owned by this host:
    // signals and interned handlers are freed (and their ids recycled) on
    // the next rebuild, so streaming data does not grow the arena. A
    // windowed list only (re)builds the visible rows — append / insert
    // outside the window is a spacer resize, not O(n) widgets.
    let previous = arena.rebuild_begin(node_id)
    ui_push(node_id)
    if row_h > 0 {
        if first > 0 {
            let top = raw_spacer()
            set_height(top, first * row_h)
            Component(top)
        }
    }
    let mut i = first
    while i < last {
        build(i, xs[i])
        i = i + 1
    }
    if row_h > 0 {
        if last < m {
            let bot = raw_spacer()
            set_height(bot, (m - last) * row_h)
            Component(bot)
        }
    }
    ui_pop()
    arena.rebuild_end(previous)
}

/// A spacer row under `node_id` keyed by `k`, reused across shifts: only its
/// height changes, so a scroll does not reallocate it. Returns the node id.
fn keyed_spacer(node_id: int, k: string, px: int) -> int {
    let id = arena.key_node(node_id, k)
    if id > 0 {
        set_height(node_handle(id), px)
        return id
    }
    let s = raw_spacer()
    set_height(s, px)
    arena.nodes[s.id].parent = node_id
    arena.key_set(node_id, k, s.id)
    return s.id
}

/// Free a spacer keyed `k` under `node_id` when the window reaches the end.
fn drop_keyed_spacer(node_id: int, k: string) {
    let id = arena.key_node(node_id, k)
    if id > 0 {
        arena.key_forget(node_id, k)
        arena.free_subtree(id)
    }
}

/// Keyed windowed refresh. Like `virtual_refresh`, but a one-row scroll shift
/// **moves** the rows whose key is still in the window and builds only the row
/// entering it, instead of rebuilding every visible row. That is what keeps a
/// scroll from allocating a fresh closure per visible row per frame (the
/// `docs/mem-baseline.md` §5.1 growth): the delta is O(rows entering/leaving),
/// not O(window). `key(item)` must be stable and unique.
fn virtual_refresh_keyed<T>(node_id: int, items: Signal<[]T>, key: fn(T) -> string,
                            build: fn(int, T) -> Node, row_h: int) {
    let xs = items.get()
    let m = xs.len
    let w = virtual_window(node_id, m, row_h)
    let first = w.first
    let last = w.last
    let gen = platform.plat_sig_gen(items.id)
    if gen == arena.nodes[node_id].list_gen {
        if first == arena.nodes[node_id].list_lo {
            if last == arena.nodes[node_id].list_hi {
                if arena.nodes[node_id].kids.len > 0 {
                    return
                }
                if m == 0 {
                    arena.nodes[node_id].list_n = 0
                    return
                }
            }
        }
    }
    // Fall back to the plain (rebuild-all) path if any row is unkeyed or two
    // visible rows share a key: the move is only sound with a clean key set.
    let mut keys = []string {}
    let mut i = first
    let mut ok = 1
    while i < last {
        let k = key(xs[i])
        if kfor_has(keys, k) == 1 {
            ok = 0
            break
        }
        push(keys, k)
        i = i + 1
    }
    if ok == 0 {
        virtual_refresh(node_id, items, build, row_h)
        return
    }
    // Existing keyed rows (from a previous keyed refresh) that are still visible
    // are kept in place; everything else is built or freed below.
    let old = arena.key_keys(node_id)
    let mut o = 0
    while o < old.len {
        if arena.key_node(node_id, old[o]) <= 0 {
            ok = 0
            break
        }
        o = o + 1
    }
    if ok == 0 {
        virtual_refresh(node_id, items, build, row_h)
        return
    }
    arena.nodes[node_id].list_gen = gen
    arena.nodes[node_id].list_lo = first
    arena.nodes[node_id].list_hi = last
    arena.nodes[node_id].list_n = m
    arena.nodes[node_id].row_h = row_h
    // Build the rows entering the window, under the host's build scope, so each
    // row owns only what it allocated.
    let previous = arena.scope_begin(node_id)
    ui_push(node_id)
    i = first
    while i < last {
        if arena.key_node(node_id, keys[i - first]) <= 0 {
            let before = arena.nodes[node_id].kids.len
            let s_mark = arena.rec_sid.len
            let f_mark = arena.rec_fid.len
            build(i, xs[i])
            let after = arena.nodes[node_id].kids.len
            if after == before + 1 {
                let row = arena.nodes[node_id].kids[before]
                arena.adopt_records(node_id, row, s_mark, f_mark)
                arena.key_set(node_id, keys[i - first], row)
            } else {
                arena.key_set(node_id, keys[i - first], 0)
            }
        }
        i = i + 1
    }
    ui_pop()
    arena.scope_end(previous)
    // Free the rows whose key left the window. The spacer keys are not rows;
    // they are kept and updated below.
    o = 0
    while o < old.len {
        if old[o] != "@top" {
            if old[o] != "@bot" {
                if kfor_has(keys, old[o]) == 0 {
                    let row = arena.key_node(node_id, old[o])
                    arena.key_forget(node_id, old[o])
                    if row > 0 {
                        arena.free_subtree(row)
                    }
                }
            }
        }
        o = o + 1
    }
    // Order the children: top spacer (rows before the window), the visible
    // keyed rows in list order, then the bottom spacer (rows after the window).
    // A spacer is itself keyed (`@top` / `@bot`) and reused across shifts so a
    // scroll only resizes it, never reallocates it.
    let mut order = []int {}
    if row_h > 0 {
        if first > 0 {
            let top = keyed_spacer(node_id, "@top", first * row_h)
            push(order, top)
        } else {
            drop_keyed_spacer(node_id, "@top")
        }
    }
    i = 0
    while i < keys.len {
        let row = arena.key_node(node_id, keys[i])
        if row > 0 {
            arena.nodes[row].parent = node_id
            push(order, row)
        }
        i = i + 1
    }
    if row_h > 0 {
        if last < m {
            let bot = keyed_spacer(node_id, "@bot", (m - last) * row_h)
            push(order, bot)
        } else {
            drop_keyed_spacer(node_id, "@bot")
        }
    }
    // Free any current child the new order does not keep (a replaced spacer or
    // a row already freed above leaves a stale id here).
    let cur = arena.nodes[node_id].kids
    let mut c = 0
    while c < cur.len {
        let child = cur[c]
        if child > 0 {
            if kfor_has_id(order, child) == 0 {
                arena.free_subtree(child)
            }
        }
        c = c + 1
    }
    arena.nodes[node_id].kids = order
    arena.mark_tree_at(node_id)
}

fn virtual_row_h(heights: []int, i: int, fallback: int) -> int {
    if i >= 0 {
        if i < heights.len {
            if heights[i] > 0 {
                return heights[i]
            }
        }
    }
    return fallback
}

fn virtual_prefix(heights: []int, n: int, fallback: int) -> int {
    let mut y = 0
    let mut i = 0
    while i < n {
        y = y + virtual_row_h(heights, i, fallback)
        i = i + 1
    }
    return y
}

fn virt_window_var(node_id: int, n: int, heights: []int, fallback: int) -> VirtWin {
    if heights.len == 0 {
        return virtual_window(node_id, n, fallback)
    }
    let signal_id = find_scroller(node_id)
    let mut view_h = 240
    let mut local = 0
    if signal_id > 0 {
        if arena.nodes[signal_id].h > 0 {
            view_h = arena.nodes[signal_id].h
        }
        if node_id == signal_id {
            local = arena.nodes[signal_id].scroll_y
        } else {
            local = arena.nodes[signal_id].scroll_y - (arena.nodes[node_id].y - arena.nodes[signal_id].y)
        }
    } else if arena.nodes[node_id].h > 0 {
        view_h = arena.nodes[node_id].h
    }
    if local < 0 {
        local = 0
    }
    let mut acc = 0
    let mut first = n
    let mut last = n
    let mut i = 0
    while i < n {
        let rh = virtual_row_h(heights, i, fallback)
        if acc + rh > local {
            first = i
            break
        }
        acc = acc + rh
        i = i + 1
    }
    first = first - VIRT_OVERSCAN
    if first < 0 {
        first = 0
    }
    acc = virtual_prefix(heights, first, fallback)
    last = first
    while last < n {
        if acc >= local + view_h {
            last = last + VIRT_OVERSCAN
            if last > n {
                last = n
            }
            return VirtWin { first: first, last: last }
        }
        acc = acc + virtual_row_h(heights, last, fallback)
        last = last + 1
    }
    return VirtWin { first: first, last: last }
}

fn virt_refresh_var<T>(node_id: int, items: Signal<[]T>, build: fn(int, T) -> Node, fallback: int,
                       heights: Signal<[]int>) {
    let xs = items.get()
    let hs = heights.get()
    let m = xs.len
    let gen = platform.plat_sig_gen(items.id) + platform.plat_sig_gen(heights.id)
    let w = virt_window_var(node_id, m, hs, fallback)
    let first = w.first
    let last = w.last
    if gen == arena.nodes[node_id].list_gen {
        if first == arena.nodes[node_id].list_lo {
            if last == arena.nodes[node_id].list_hi {
                if arena.nodes[node_id].kids.len > 0 {
                    return
                }
                if m == 0 {
                    arena.nodes[node_id].list_n = 0
                    return
                }
            }
        }
    }
    arena.nodes[node_id].list_gen = gen
    arena.nodes[node_id].list_lo = first
    arena.nodes[node_id].list_hi = last
    arena.nodes[node_id].list_n = m
    arena.nodes[node_id].row_h = fallback
    let previous = arena.rebuild_begin(node_id)
    ui_push(node_id)
    if first > 0 {
        let top = raw_spacer()
        set_height(top, virtual_prefix(hs, first, fallback))
        Component(top)
    }
    let mut i = first
    while i < last {
        build(i, xs[i])
        i = i + 1
    }
    if last < m {
        let bot = raw_spacer()
        set_height(bot, virtual_prefix(hs, m, fallback) - virtual_prefix(hs, last, fallback))
        Component(bot)
    }
    ui_pop()
    arena.rebuild_end(previous)
}

/// Positional list. `items` is `zeus.signal([]T {})` (`T` Copy). Rows are
/// rebuilt in place on every change; use `For` when a row must keep its state
/// across a reorder.
fn Index<T>(items: Signal<[]T>, build: fn(int, T) -> Node) -> Node {
    let n = raw_box()
    let node_id = n.id
    arena.bind_host(items.id, node_id)
    virtual_refresh(node_id, items, build, 0)
    return Component(n,
                     style = Style(direction = Direction.Column),
                     rebuild = || { virtual_refresh(node_id, items, build, 0) })
}

fn kfor_unique<T>(xs: []T, key: fn(T) -> string, m: int) -> int {
    let mut i = 0
    while i < m {
        let mut j = i + 1
        while j < m {
            if key(xs[i]) == key(xs[j]) {
                return 0
            }
            j = j + 1
        }
        i = i + 1
    }
    return 1
}

fn kfor_unique_keys(keys: []string, m: int) -> int {
    let mut i = 0
    while i < m {
        let mut j = i + 1
        while j < m {
            if keys[i] == keys[j] {
                return 0
            }
            j = j + 1
        }
        i = i + 1
    }
    return 1
}

fn kfor_has(keys: []string, k: string) -> int {
    let n = keys.len
    for i in 0..n {
        if keys[i] == k {
            return 1
        }
    }
    return 0
}

fn kfor_has_id(ids: []int, v: int) -> int {
    let n = ids.len
    for i in 0..n {
        if ids[i] == v {
            return 1
        }
    }
    return 0
}

/// Keyed reactive list: the general form of `For`, and the reactive `Each`.
/// `items` is `zeus.signal([]T {})` (`T` Copy); `key(item)` must return a
/// stable, unique string. Rows mount once per key and **move** on reorder, so
/// focus and per-row state survive, and an insert or remove builds or frees only
/// the affected row — O(changes) in rows, where a rebuild would be O(rows).
/// `build(i, item)` runs at mount; for content that follows the item, read a
/// signal inside the row instead of `i`.
fn Each<T>(items: Signal<[]T>, key: fn(T) -> string, build: fn(int, T) -> Node) -> Node {
    let n = raw_box()
    let node_id = n.id
    arena.bind_host(items.id, node_id)
    kfor_refresh(node_id, items, key, build)
    return Component(n,
                     style = Style(direction = Direction.Column),
                     rebuild = || { kfor_refresh(node_id, items, key, build) })
}

/// Keyed list. Same engine as `Each`; `For` reads as the list widget, `Each` as
/// the broadcast case. Reach for `Loop` when the sequence is fixed at build
/// time and no host node is wanted.
fn For<T>(items: Signal<[]T>, key: fn(T) -> string, build: fn(int, T) -> Node) -> Node {
    return Each(items, key, build)
}

fn kfor_refresh<T>(node_id: int, items: Signal<[]T>, key: fn(T) -> string, build: fn(int, T) -> Node) {
    let xs = items.get()
    let m = xs.len
    // Fast path 0: the list has not moved and still has a row per key. The key
    // functions are arbitrary (usually building a string), and the uniqueness and
    // lookup passes below are O(rows) and O(rows^2), so this guard is what makes an
    // untouched list cost O(1) per layout instead of re-deriving every key. The
    // count check catches a row freed out from under the host.
    if platform.plat_sig_gen(items.id) == arena.nodes[node_id].list_gen {
        if arena.key_count(node_id) == m {
            return
        }
    }
    // Fast path: the key set is unchanged, so move the existing rows into the
    // new order. Node ids, focus, scroll and row state all survive; nothing is
    // allocated. A changed key set (or duplicate keys) falls through.
    if arena.key_count(node_id) == m {
        if kfor_unique(xs, key, m) == 1 {
            let mut ok = 1
            let mut i = 0
            while i < m {
                if arena.key_node(node_id, key(xs[i])) <= 0 {
                    ok = 0
                    break
                }
                i = i + 1
            }
            if ok == 1 {
                let mut order = []int {}
                let mut j = 0
                while j < m {
                    push(order, arena.key_node(node_id, key(xs[j])))
                    j = j + 1
                }
                arena.nodes[node_id].kids = order
                arena.nodes[node_id].list_gen = platform.plat_sig_gen(items.id)
                // Rows moved without any child insert / drop, so nothing has
                // marked the tree yet; the frame keys its follow-up layout on
                // that mark.
                arena.mark_tree_at(node_id)
                return
            }
        }
    }
    // Incremental path: keep the rows whose key survives, build only the new
    // keys, free only the rows whose key is gone. This is O(changes) in rows,
    // where the full rebuild below is O(rows).
    if kfor_reconcile(node_id, xs, key, build) != 0 {
        arena.nodes[node_id].list_gen = platform.plat_sig_gen(items.id)
        return
    }
    // Slow path: rebuild the host; every row is re-created and recycled.
    kfor_rebuild(node_id, xs, key, build)
    arena.nodes[node_id].list_gen = platform.plat_sig_gen(items.id)
}

/// Reconcile the host's rows against `xs` in place: move the shared rows, build
/// the new keys, free the removed ones. Returns 0 when the shape is not
/// reconcilable — duplicate keys, a row builder that mounts zero or several
/// top-level children, or an existing unkeyed row — leaving the caller to fall
/// back to a full rebuild.
///
/// Nothing is torn down until every new row has built cleanly and every key
/// resolves to a row, so a fallback cannot leak a half-adopted row: the rows
/// built here stay owned by the host until `adopt_records` hands each its own
/// signals and handlers, and a fallback's `rebuild_begin` releases host-owned
/// records exactly as before.
fn kfor_reconcile<T>(node_id: int, xs: []T, key: fn(T) -> string, build: fn(int, T) -> Node) -> int {
    let m = xs.len
    let mut nk = []string {}
    let mut i = 0
    while i < m {
        push(nk, key(xs[i]))
        i = i + 1
    }
    if kfor_unique_keys(nk, m) == 0 {
        return 0
    }
    let old = arena.key_keys(node_id)
    let mut o = 0
    while o < old.len {
        if arena.key_node(node_id, old[o]) <= 0 {
            return 0
        }
        o = o + 1
    }
    // Build the rows whose key is new, under the host's build scope. Each row's
    // allocations are handed to it the moment it builds, so a later row cannot
    // claim them (an unbounded later sweep would).
    let previous = arena.scope_begin(node_id)
    ui_push(node_id)
    let mut ok = 1
    i = 0
    while i < m {
        if ok != 0 {
            if arena.key_node(node_id, nk[i]) <= 0 {
                let before = arena.nodes[node_id].kids.len
                let s_mark = arena.rec_sid.len
                let f_mark = arena.rec_fid.len
                build(i, xs[i])
                let after = arena.nodes[node_id].kids.len
                if after == before + 1 {
                    let row = arena.nodes[node_id].kids[before]
                    arena.adopt_records(node_id, row, s_mark, f_mark)
                    arena.key_set(node_id, nk[i], row)
                } else {
                    // A row that is not a single top-level child cannot be
                    // moved or keyed; rebuild rather than reorder a partial row.
                    arena.key_set(node_id, nk[i], 0)
                    ok = 0
                }
            }
        }
        i = i + 1
    }
    ui_pop()
    arena.scope_end(previous)
    if ok == 0 {
        return 0
    }
    // Free the rows whose key is gone. Only now that a fallback is impossible.
    o = 0
    while o < old.len {
        if kfor_has(nk, old[o]) == 0 {
            let row = arena.key_node(node_id, old[o])
            arena.key_forget(node_id, old[o])
            if row > 0 {
                arena.free_subtree(row)
            }
        }
        o = o + 1
    }
    // Order the kids by the new key sequence. Every key resolves now, so the
    // array holds only live rows.
    let mut order = []int {}
    i = 0
    while i < m {
        push(order, arena.key_node(node_id, nk[i]))
        i = i + 1
    }
    // A duplicate key overwrites its key entry, so the earlier row is a child
    // the table no longer names. Replacing `kids` would orphan it — free every
    // current child that the new order does not keep.
    let cur = arena.nodes[node_id].kids
    let mut c = 0
    while c < cur.len {
        let child = cur[c]
        if child > 0 {
            if kfor_has_id(order, child) == 0 {
                arena.free_subtree(child)
            }
        }
        c = c + 1
    }
    arena.nodes[node_id].kids = order
    // A remove-only reconcile frees rows without inserting any, and a freed
    // node does not mark the tree; the host does, so the frame re-lays out.
    arena.mark_tree_at(node_id)
    return 1
}

/// Full rebuild: free everything the host owned and re-create every row. The
/// fallback whenever a reconcile cannot be done in place.
fn kfor_rebuild<T>(node_id: int, xs: []T, key: fn(T) -> string, build: fn(int, T) -> Node) {
    let m = xs.len
    // A prior reconcile may have adopted records onto the rows; hand them back
    // so `rebuild_begin` frees them with the rest.
    arena.release_children_ownership(node_id)
    arena.key_clear(node_id)
    let previous = arena.rebuild_begin(node_id)
    ui_push(node_id)
    let mut i = 0
    while i < m {
        let before = arena.nodes[node_id].kids.len
        build(i, xs[i])
        let after = arena.nodes[node_id].kids.len
        // A row must be a single top-level child to be movable. If the builder
        // mounted zero or several, record nothing so the next update rebuilds
        // rather than reorders a partial row.
        if after == before + 1 {
            arena.key_set(node_id, key(xs[i]), arena.nodes[node_id].kids[before])
        } else {
            arena.key_set(node_id, key(xs[i]), 0)
        }
        i = i + 1
    }
    ui_pop()
    arena.rebuild_end(previous)
}

/// One arm mounted at a time. `on` is a live signal; `build(value)` rebuilds
/// the host whenever `on` changes, so only the current arm is in the tree.
/// Pair with an integer tag signal for a switch/match.
fn Match<T>(on: Signal<T>, build: fn(T) -> Node) -> Node {
    let n = raw_box()
    let node_id = n.id
    // A write to `on` swaps the mounted arm. The host's refresh hook is what
    // reads `on`, not an effect, so bind it: the write is attributed to this
    // node — a scoped layout, and the frame runs the hooks — instead of being
    // paint-only (or, read by a paint effect elsewhere, consumed by that).
    arena.bind_host(on.id, node_id)
    match_build(node_id, on, build)
    return Component(n,
                     style = Style(direction = Direction.Column),
                     rebuild = || { match_refresh(node_id, on, build) })
}

/// Tear the subtree down and rebuild it for the current value of `on`.
/// `list_gen` records the slot it was built from, so `match_refresh` can tell
/// a real change from a bare refresh sweep.
fn match_build<T>(node_id: int, on: Signal<T>, build: fn(T) -> Node) {
    arena.nodes[node_id].list_gen = platform.plat_sig_gen(on.id)
    let previous = arena.rebuild_begin(node_id)
    ui_push(node_id)
    build(on.get())
    ui_pop()
    arena.rebuild_end(previous)
}

/// `refresh_lists` invokes every node that has a `list_fn`, on every layout.
/// The refit and For/Index hosts all return early when nothing changed; Match
/// did not, so each layout ran `rebuild_begin` — which calls `release_sigs` —
/// and every `zeus.signal` the page declared was freed and re-created at its
/// initial value. Page state reset on any repaint, which reads as "signals
/// don't work" in a routed app. Rebuild only when `on` actually moved.
fn match_refresh<T>(node_id: int, on: Signal<T>, build: fn(T) -> Node) {
    if platform.plat_sig_gen(on.id) == arena.nodes[node_id].list_gen {
        return
    }
    match_build(node_id, on, build)
}

/// Error boundary. `build()` runs under a recoverable trap; if it traps, the
/// partial subtree is discarded, the arena is rolled back to its entry mark,
/// and `fallback(message)` is built in its place, so the rest of the app keeps
/// running. Recovers UI state only: C-seam side effects (I/O, network) are not
/// undone, and a trap raised outside `build` (e.g. in a later layout effect) is
/// not caught. On wasm there is no `setjmp`, so a trap still aborts.
fn Boundary(build: fn() -> Node, fallback: fn(string) -> Node) -> Node {
    let host = raw_box()
    let hid = host.id
    let m = arena.mark()
    let previous = arena.scope_begin(hid)
    ui_push(hid)
    let stack0 = ui_parents.len
    let msg = platform.plat_boundary(|| { build() })
    arena.scope_end(previous)
    if msg.len == 0 {
        ui_pop()
    } else {
        // A trap skipped the normal pop: unwind the build stack by hand.
        while ui_parents.len > stack0 {
            pop(ui_parents)
        }
        ui_pop()
        arena.rollback(hid, m)
        ui_push(hid)
        fallback(msg)
        ui_pop()
    }
    return Component(host, style = Style(direction = Direction.Column))
}

/// Jump `n` (a `Scroll` / `VirtualList`) to vertical offset `y`. Clears
/// residual velocity so physics does not coast past the target. Clamped.
fn scroll_to(n: Node, y: int) -> Node {
    arena.nodes[n.id].vel_y = 0
    arena.nodes[n.id].scroll_y = y
    arena.clamp_scroll(n.id)
    if arena.nodes[n.id].bind_sig > 0 {
        arena.store_sig(arena.nodes[n.id].bind_sig, arena.nodes[n.id].scroll_y)
    }
    return n
}

/// Jump `n` to horizontal offset `x`.
fn scroll_to_x(n: Node, x: int) -> Node {
    arena.nodes[n.id].vel_x = 0
    arena.nodes[n.id].scroll_x = x
    arena.clamp_scroll(n.id)
    return n
}

/// Jump a windowed list so item `i` is at the top of the viewport.
fn scroll_to_index(n: Node, i: int) -> Node {
    let mut rh = arena.nodes[n.id].row_h
    if rh < 1 {
        rh = 1
    }
    let mut at = i
    if at < 0 {
        at = 0
    }
    return scroll_to(n, at * rh)
}

/// Live `scroll_y` of `n`.
fn scroll_y(n: Node) -> int {
    return arena.nodes[n.id].scroll_y
}

/// Width a node measured by the last layout pass (0 until the first one).
fn measured_width(n: Node) -> int {
    return arena.nodes[n.id].w
}

/// Re-run `build` into `host` whenever the host's measured width changes
/// (window resize, card reflow). `host` must be widthless so it stretches
/// with its parent. Pixel-exact widgets — charts, plots — lay out their
/// children from the measured width, so they stay glued to the container.
/// Rebuilds happen on the layout after a size change.
fn refit_refresh(node_id: int, build: fn()) {
    let w = arena.nodes[node_id].w
    if w == arena.nodes[node_id].list_gen {
        return
    }
    // A zero-width host (hidden tab, or not laid out yet) defers its rebuild
    // until it is measured at a real width. Syncing `list_gen` here keeps it
    // from refitting on every resize frame while off-screen.
    if w == 0 {
        arena.nodes[node_id].list_gen = 0
        return
    }
    arena.nodes[node_id].list_gen = w
    let previous = arena.rebuild_begin(node_id)
    slot(node_handle(node_id), build)
    arena.rebuild_end(previous)
    // The rebuild released every handler the host owned — this hook among
    // them — so register it again, or the host would refit once and then
    // ignore every later resize.
    arena.nodes[node_id].list_fn = refit_hook(node_id, build)
}

/// The host's refresh hook, owned by the host itself: freed with the host, and
/// by each rebuild of it (which is why `refit_refresh` re-registers it).
fn refit_hook(node_id: int, build: fn()) -> int {
    let id = platform.plat_intern_fn(|| {
        refit_refresh(node_id, build)
    })
    arena.record_intern(id, node_id)
    return id
}

fn refit(host: Node, build: fn()) -> Node {
    arena.ensure()
    let node_id = host.id
    arena.nodes[node_id].list_fn = refit_hook(node_id, build)
    return host
}

/// Vertical scroller. Children keep intrinsic height; a bar appears on overflow.
/// `bind` is an optional two-way `scroll_y` signal (`scroll_to` writes it).
fn Scroll(p: ScrollProps) -> Node {
    return Component(raw_scroll(), style = p.style, bind = p.bind, keys = p.keys)
}

/// Inline SVG. `currentColor` follows the node's foreground. Geometry props:
/// `width`, `height` (an svg is otherwise measured like a label), plus the
/// usual `position` / pins / `z_index` for layered plots.
fn Svg(markup: string, p: SvgProps) -> Node {
    return Component(raw_svg(markup), style = p.style, keys = p.keys)
}

/// Raster image. `src` is a file path, `data:` URI, or `http(s):` URL — a
/// thunk, so a signal read inside it repaints this node. Hosts decode PNG /
/// JPEG / WebP / GIF and cache by that string; a missing or still-loading
/// src paints nothing. With no `width`/`height` the node auto-sizes to the
/// container (device) width at the source aspect ratio — see `ImageProps`.
/// `fit` is `Fit` (stretch / contain / cover / none). `lazy = true` skips
/// decode while off-screen.
fn Image(src: fn() -> string, p: ImageProps) -> Node {
    return Component(raw_image(""), text = src, style = p.style, fit = p.fit, lazy = p.lazy,
                     label = p.label, role = "img", keys = p.keys)
}

/// Open a host file picker (PNG / JPEG / WebP / GIF). Writes the chosen src
/// into `dest` and the image's intrinsic size into `dw` / `dh`. Native hosts
/// return from the dialog; wasm and mobile finish via `engine_picked_image`.
fn pick_image(dest: Signal<string>, dw: Signal<int>, dh: Signal<int>) {
    pick_dest = dest
    pick_w = dw
    pick_h = dh
    let mut w = 0
    let mut h = 0
    let src = platform.plat_pick_image(&mut w, &mut h)
    if src.len > 0 {
        set(dest, src)
        set(dw, w)
        set(dh, h)
        pick_dest = Signal { id: 0 }
        pick_w = Signal { id: 0 }
        pick_h = Signal { id: 0 }
    }
}

/// `markup` painted at `px` square and tinted by `tint`. Returns the node so
/// callers can bind visibility.
///
/// An svg node has no intrinsic size, so the box is set explicitly. The tint
/// goes through `prop_str` rather than `fg` so it re-applies on an
/// appearance change: `apply_str` hands an unknown setter to `apply_int`, and
/// 16 is the fg slot.
/// Optional extras for `Icon`.
struct IconProps {
    style: Option<fn() -> Style> = none,
    ref: Option<Ref> = none,
    role: string = "",
    label: Option<fn() -> string> = none,
}

/// `px` is the glyph box: pass an `IconSize` (`IconSize.Md` is 16) or, for
/// SVG art, any raw px.
fn Icon(markup: string, px: int, tint: string, p: IconProps) -> Node {
    return Component(raw_svg(markup),
                     style = merge(Style(width = px(px), height = px(px), color = tint), style_of(p.style)),
                     ref = p.ref,
                     role = p.role,
                     label = p.label)
}

fn Pip(fill: string, size: int) -> Node {
    return Box(style = Style(width = px(size),
                             height = px(size),
                             radius = corners(size / 2),
                             background = opt_color(fill)))
}

fn Row(spacing: int) -> Node {
    return Box(style = Style(direction = Direction.Row, gap = opt_dim(spacing), align = Align.Center))
}

/// Row that wraps onto the next line when it overflows (`flex-wrap: wrap`).
/// Use for responsive clusters of chips, buttons, and badges.
fn RowWrap(spacing: int) -> Node {
    return Box(style = Style(direction = Direction.Row,
                             wrap = true,
                             gap = opt_dim(spacing),
                             align = Align.Center))
}

fn Column(spacing: int) -> Node {
    return Box(style = Style(direction = Direction.Column, gap = opt_dim(spacing)))
}

fn Grow() -> Node {
    return Box(style = Style(grow = 1))
}

/// Horizontal hairline. Kept as `Divider` for older callers.
fn Separator() -> Node {
    return Box(style = Style(height = px(1), background = rule()))
}

/// Legacy name for `Separator`.
fn Divider() -> Node {
    return Separator()
}

fn Overline(text: fn() -> string) -> Node {
    return Text(text, style = Style(font = FONT_OVERLINE, color = dim()))
}

fn Display(text: fn() -> string) -> Node {
    return Text(text, style = Style(font = FONT_DISPLAY, color = ink()))
}

fn Heading(text: fn() -> string) -> Node {
    return Text(text, style = Style(font = FONT_HEADING, color = ink()))
}

fn Title(text: fn() -> string) -> Node {
    return Text(text, style = Style(font = FONT_TITLE, color = ink()))
}

fn Body(text: fn() -> string) -> Node {
    return Text(text, style = Style(font = FONT_BODY, color = mute()))
}

fn Note(text: fn() -> string) -> Node {
    return Text(text, style = Style(font = FONT_CAPTION, color = dim()))
}

/// Overline + heading + supporting copy as one block.
fn SectionHeader(overline: fn() -> string, title: fn() -> string,
                 body: fn() -> string) -> Node {
    return Column(Space.Exxxs) {
        Text(overline, style = Style(font = FONT_OVERLINE, color = dim()))
        Text(title, style = Style(font = FONT_HEADING, color = ink()))
        Text(body, style = Style(wrap = true, font = FONT_BODY, color = mute()))
    }
}

/// `SectionHeader` without the supporting copy.
fn SectionTitle(overline: fn() -> string, title: fn() -> string) -> Node {
    return Column(Space.Exxxs) {
        Text(overline, style = Style(font = FONT_OVERLINE, color = dim()))
        Text(title, style = Style(font = FONT_HEADING, color = ink()))
    }
}

/// Status pill: tinted dot and label on a muted border pill. Pass any style
/// prop to restyle it (`Chip("pill", Tint.Ok, radius = 6)`).
struct ChipProps {
    /// Style, merged over the recipe's own: `style = Style(radius = corners(4))`.
    style: Option<fn() -> Style> = none,
    /// false hides the leading tint dot.
    dot: bool = true,
    /// Removable chip: a trailing X runs this (role `button`, label
    /// `Remove <label>`). Hiding the chip is the caller's job — usually
    /// `show` on a signal the handler clears.
    on_remove: Option<fn()> = none,
    /// Keyboard actions on this element (`key_bind(...)`, `key_bind_click(...)`).
    keys: []KeyBind = no_keys(),
}

/// Chip: rounded tag with a tint dot and caption text. `dot = false` drops
/// the pip; `on_remove` adds a trailing X.
fn Chip(label: fn() -> string, kind: int, p: ChipProps) -> Node {
    // state. The X carries its own hit box, so the trailing gutter shrinks.
    let removable = result.is_some(p.on_remove)

    // view. The label takes the caller's `color` / `font` when given.
    return Box(style = merge(Style(height = px(chip_h()), direction = Direction.Row, gap = Space.Exxs,
                                   align = Align.Center,
                                   padding = edges4(5, if removable { 4 } else { 10 }, 5, 10),
                                   radius = corners(RAD_FULL), border = line(HAIRLINE, rule()),
                                   background = raised()),
                             style_of(p.style)),
               keys = p.keys) {
        if p.dot {
            Pip(tint_of(kind), DOT - 2)
        }
        Text(label, style = merge(Style(font = FONT_CAPTION, color = tint_of(kind), ellipsis = true),
                                  text_part(style_of(p.style))))
        if removable {
            Box(style = Style(width = px(18), height = px(18), shrink = 0,
                              align = Align.Center, justify = Align.Center,
                              radius = corners(RAD_FULL), cursor = "pointer"),
                on_click = p.on_remove,
                role = "button",
                label = "Remove {{label()}}",
                hoverFade = true) {
                Icon(IC_X, 12, mute())
            }
        }
    }
}

/// Chip height: a step under the smallest control, so a chip never out-sizes
/// the field or button beside it.
fn chip_h() -> int {
    return control_h(Size.Sm) - 6
}

/// Badge height per `Size`: 18 / 20 / 22.
fn badge_h(size: int) -> int {
    if size == Size.Sm { 18 } else if size == Size.Lg { 22 } else { 20 }
}

/// Fill for a badge `Tint`. Split from the button pickers because badges
/// use filled status colors where buttons use accent chrome.
fn badge_background(kind: int) -> string {
    match kind {
        Tint.Mute => { return raised() }
        Tint.Ok => { return ok_solid() }
        Tint.Danger => { return danger_solid() }
        Tint.Warn => { return warn_fill() }
        // Outline: the border carries it, so no fill.
        Tint.Dim => { return "" }
        _ => { return accent() }
    }
}

/// Label color for a badge `Tint`; see `badge_background`.
fn badge_color(kind: int) -> string {
    match kind {
        Tint.Mute | Tint.Dim => { return ink() }
        Tint.Ok => { return on_ok() }
        Tint.Warn => { return warn() }
        _ => { return on_ink() }
    }
}

/// Border width for a badge `Tint` — only the outline tint carries one.
fn badge_border_width(kind: int) -> int {
    match kind {
        Tint.Dim => { return HAIRLINE }
        _ => { return 0 }
    }
}

/// Border color for a badge `Tint`; see `badge_border_width`.
fn badge_border_color(kind: int) -> string {
    match kind {
        Tint.Dim => { return hard() }
        _ => { return "" }
    }
}

/// Badge: small bordered pill, 10px side padding, caption type.
/// Kinds: Ink default, Mute secondary, Dim outline, Danger destructive;
/// Ok is a filled success badge. `dot = true` adds a leading status pip
/// in the label colour; `BadgeCount` is the numeric variant.
struct BadgeProps {
    /// `Size` token: the pill is `badge_h(size)` tall.
    size: int = Size.Md,
    /// Style, merged over the recipe's own: `style = Style(radius = corners(4))`.
    style: Option<fn() -> Style> = none,
    /// Leading status pip in the label colour.
    dot: bool = false,
    /// Keyboard actions on this element (`key_bind(...)`, `key_bind_click(...)`).
    keys: []KeyBind = no_keys(),
}

fn Badge(label: fn() -> string, kind: int, p: BadgeProps) -> Node {
    return Box(style = merge(Style(height = px(badge_h(p.size)), direction = Direction.Row,
                                   gap = Space.Exxs, align = Align.Center, justify = Align.Center,
                                   padding = Edges(left = 10, right = 10), radius = corners(RAD_CONTROL),
                                   border = Border(width = badge_border_width(kind),
                                                   color = opt_color(badge_border_color(kind))),
                                   background = opt_color(badge_background(kind))),
                             style_of(p.style)),
               keys = p.keys) {
        if p.dot {
            Pip(badge_color(kind), DOT - 2)
        }
        Text(label, style = merge(Style(font = FONT_CAPTION, color = badge_color(kind)),
                                  text_part(style_of(p.style))))
    }
}

/// Count badge: a round pill bound to a number, hidden while it is 0 and
/// capped at `max` ("99+"). Sits over an icon or after a nav label.
fn BadgeCount(count: Signal<int>, kind: int, max: int = 99) -> Node {
    return Box(style = Style(display = shown(count.get() != 0),
                             height = px(badge_h(Size.Sm)),
                             direction = Direction.Row,
                             align = Align.Center,
                             justify = Align.Center,
                             minWidth = badge_h(Size.Sm),
                             padding = Edges(right = 5, left = 5),
                             radius = corners(RAD_FULL),
                             background = opt_color(badge_background(kind))),
               role = "status") {
        Text(fn() -> string {
            let v = count.get()
            if v > max {
                return "{{max}}+"
            }
            return "{{v}}"
        },
             style = Style(font = 11, color = badge_color(kind)))
    }
}

/// Key cap: 1px border on muted, mono-ish small text, 20px tall.
fn Kbd(key: fn() -> string) {
    Box(style = Style(height = px(20),
                      direction = Direction.Row,
                      align = Align.Center,
                      justify = Align.Center,
                      padding = Edges(right = 6, left = 6),
                      radius = corners(4),
                      border = line(HAIRLINE, rule()),
                      background = raised())) {
        Text(key, style = Style(font = 10, color = mute()))
    }
}

/// Options for `Progress`.
struct ProgressProps {
    /// `Size` token: a 4 / 8 / 12px track.
    size: int = Size.Md,
    /// Sweep a segment instead of showing `value` (a negative value does too).
    indeterminate: bool = false,
    /// Caption above the track, with the percentage at its right end.
    label: string = "",
    /// Style, merged over the track's own.
    style: Option<fn() -> Style> = none,
}

/// Track height per `Size`.
fn progress_h(size: int) -> int {
    if size == Size.Sm { 4 } else if size == Size.Lg { 12 } else { 8 }
}

/// Progress: rounded track filled with the accent; fills its parent's width.
/// Value 0..100; a
/// plain `set` eases the fill over `Motion.Base` on the paint overlay (no
/// effect re-runs per frame). A negative value (or `indeterminate`) sweeps a
/// segment along the track on the frame clock instead.
fn Progress(value: Signal<int>, p: ProgressProps) -> Node {
    if p.label.len == 0 {
        return ProgressTrack(value, p)
    }
    return ProgressLabeled(value, p)
}

/// `Progress` with its caption row. Split out because a component that builds
/// a tree must return it once, at the end: the compiler wraps that return in
/// a view frame, and an early return would leave the frame open.
fn ProgressLabeled(value: Signal<int>, p: ProgressProps) -> Node {
    let sweep = p.indeterminate
    return Box(style = Style(direction = Direction.Column, gap = 6)) {
        Box(style = Style(direction = Direction.Row, align = Align.Center)) {
            Text(p.label, style = Style(grow = 1, font = FONT_CONTROL, color = ink()))
            Text(if sweep || value.get() < 0 { "" } else { "{{value.get()}}%" },
                 style = Style(font = FONT_CONTROL, color = mute()))
        }
        ProgressTrack(value, p)
    }
}

/// The native track `Progress` draws.
fn ProgressTrack(value: Signal<int>, p: ProgressProps) -> Node {
    let h = progress_h(p.size)
    // Fills a column; `grow` takes the free width in a row, where a bare
    // 100% would be the (empty) content width.
    let n = Component(raw_progress(),
                      bind = value,
                      style = merge(Style(width = pct(100), grow = 1, height = px(h), radius = corners(h / 2)),
                                    style_of(p.style)),
                      label = p.label,
                      role = "progressbar")
    let node_id = n.id
    let signal_id = value.id
    let sweep = p.indeterminate
    // `tween` holds the last state this bar was asked to show (-1 at build),
    // so the next write can ease from it.
    effect(|| {
        let v = value.get()
        let last = arena.nodes[node_id].tween
        if v < 0 || sweep {
            arena.note_spin(node_id, 1400)
        } else {
            arena.clear_spin(node_id)
            // A write from `zeus.animate` brings its own track and duration;
            // only a plain `set` gets the default ease.
            if last >= 0 && arena.anim_bind_on() == 0 {
                arena.anim_paint_from(signal_id, last, Motion.Base)
            }
        }
        arena.nodes[node_id].tween = v
    })
    return n
}

/// Legacy name for `Progress`.
fn Meter(value: Signal<int>) -> Node {
    return Progress(value)
}

/// Deprecated: `Alert` takes a `Tint` (`tint = Tint.Warn`), the one status
/// enum. `tone = Tone.*` still works and maps through `tone_tint`.
enum Tone {
    Info = 0,
    Danger = 1,
    Warn = 2,
    Ok = 3,
}

/// The `Tint` an old `Tone` code stands for.
fn tone_tint(tone: int) -> int {
    match tone {
        Tone.Danger => { return Tint.Danger }
        Tone.Warn => { return Tint.Warn }
        Tone.Ok => { return Tint.Ok }
        _ => { return Tint.Info }
    }
}

/// Raised panel (no border). Prefer `Card` for the bordered look.
fn Surface() -> Node {
    return Box(
        style = Style(direction = Direction.Column,
                      gap = Space.Xs,
                      padding = edges(Space.Md),
                      radius = corners(RAD_LG),
                      background = raised())
    )
}

/// Form label: body-size, medium weight.
fn Label(text: fn() -> string) -> Node {
    return Text(text, style = Style(font = FONT_BODY, color = ink()))
}

fn avatar_dot(size: int) -> int {
    let d = size / 4
    if d < 8 {
        return 8
    }
    if d > 14 {
        return 14
    }
    return d
}

struct AvatarProps {
    src: string = ""
    /// `Tint` for the corner presence pip. `-1` = none.
    status: int = -1
    style: Option<fn() -> Style> = none
}

/// Avatar: full-round with initials on muted. `size` is the diameter: an
/// `AvatarSize` (`AvatarSize.Lg` is the common 40), or any raw px. Pass `src` for a photo; initials remain the fallback
/// while the host loads. `status` is a `Tint` for the corner presence pip
/// (`-1` = none). `User` composes it; `AvatarGroup` stacks several.
fn Avatar(initials: string, size: int, p: AvatarProps) -> Node {
    return Box(style = merge(Style(width = px(size),
                                   height = px(size),
                                   direction = Direction.Row,
                                   align = Align.Center,
                                   justify = Align.Center,
                                   radius = corners(size / 2),
                                   background = raised()), style_of(p.style))) {
        Text(initials, style = Style(font = (size + 8) / 4, color = ink()))
        if p.src.len > 0 {
            Image(p.src,
                  style = Style(width = px(size),
                                height = px(size),
                                position = pos_absolute(),
                                inset = Edges(top = 0, left = 0),
                                radius = corners(size / 2)))
        }
        if p.status >= 0 {
            Box(style = Style(width = px(avatar_dot(size)),
                              height = px(avatar_dot(size)),
                              position = pos_absolute(),
                              inset = Edges(right = 0, bottom = 0),
                              radius = corners(avatar_dot(size) / 2),
                              border = line(2, plate()),
                              background = tint_of(p.status)),
                role = "status")
        }
    }
}

/// Overlapping row of avatars. Later faces sit on top; each one after the
/// first pulls left by a third of `size`.
fn AvatarGroup(labels: []string, size: int = AvatarSize.Md) -> Node {
    return Row(0) {
        Loop(labels, fn(i, label) {
            return Avatar(label, size, style = avatar_overlap(i, size))
        })
    }
}

/// Each avatar after the first tucks a third of its width under the one
/// before it, and sits above it.
fn avatar_overlap(i: int, size: int) -> Style {
    if i == 0 {
        return Style(zIndex = 1)
    }
    return Style(margin = Edges(left = -(size / 3)), zIndex = i + 1)
}

/// Trend direction for `Stat`'s delta row.
enum Trend {
    Flat = 0,
    Up = 1,
    Down = 2,
}

struct StatProps {
    /// Change caption under the value ("+12%"). Empty = no delta row.
    delta: fn() -> string = empty_text,
    /// `Trend` for the arrow and tint: Up is ok, Down is danger, Flat is
    /// muted with no arrow.
    trend: int = 0,
    /// Series for a trailing sparkline. A signal, so a dashboard can push
    /// points and the line redraws without a rebuild.
    spark: Option<Signal<[]int>> = none,
}

fn trend_tint(trend: int) -> string {
    match trend {
        Trend.Up => { return ok() }
        Trend.Down => { return danger() }
        _ => { return mute() }
    }
}

/// Sparkline path: `vals` fit to a `w`×`h` box, stroked in `currentColor`
/// so `Icon`-style tinting applies. Flat series draw a midline.
fn spark_markup(vals: []int, w: int, h: int) -> string {
    let n = vals.len
    if n < 2 {
        return ""
    }
    let mut lo = vals[0]
    let mut hi = vals[0]
    for i in 1..n {
        if vals[i] < lo {
            lo = vals[i]
        }
        if vals[i] > hi {
            hi = vals[i]
        }
    }
    let mut span = hi - lo
    if span <= 0 {
        span = 1
    }
    let pad = 2
    let mut d = ""
    for i in 0..n {
        let x = pad + (w - pad * 2) * i / (n - 1)
        let y = pad + (h - pad * 2) * (hi - vals[i]) / span
        if i == 0 {
            d = "M{{x}} {{y}}"
        } else {
            d = "{{d}} L{{x}} {{y}}"
        }
    }
    return "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 {{w}} {{h}}'><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='{{d}}'/></svg>"
}

/// Inline trend line, `w`×`h` dp, stroked in `tint`. The markup is a text
/// thunk over `vals`, so pushing a point repaints only this node.
fn Sparkline(vals: Signal<[]int>, w: int, h: int, tint: string) -> Node {
    return Component(raw_svg(""),
                     style = Style(width = px(w), height = px(h), color = tint),
                     text = fn() -> string { return spark_markup(vals.get(), w, h) },
                     role = "img",
                     label = "sparkline")
}

/// Stat card: small muted label over a big tinted value. `delta` + `trend`
/// add an arrow-and-caption row; `spark` a sparkline beside the value.
fn Stat(label: fn() -> string, value: fn() -> string, kind: int, p: StatProps) -> Node {
    return Card(style = Style(grow = 1)) {
        Text(label, style = Style(font = FONT_CONTROL, color = mute()))
        Row(Space.Xs) {
            Text(value, style = Style(font = 26, color = tint_of(kind)))
            if result.is_some(p.spark) {
                Grow()
                Sparkline(p.spark.val, 64, 24, trend_tint(p.trend))
            }
        }
        if p.delta().len > 0 {
            Box(style = Style(direction = Direction.Row, gap = 2, align = Align.Center),
               role = "status") {
                if p.trend == Trend.Up {
                    Icon(IC_TREND_UP, 14, trend_tint(p.trend))
                }
                if p.trend == Trend.Down {
                    Icon(IC_TREND_DOWN, 14, trend_tint(p.trend))
                }
                Text(p.delta, style = Style(font = FONT_CAPTION, color = trend_tint(p.trend)))
            }
        }
    }
}

fn StatCount(label: string, sig: Signal<int>, kind: int) -> Node {
    let c = Card() {
        Text(label, style = Style(font = FONT_CONTROL, color = mute()))
        Text("{{sig.get()}}", style = Style(font = 26, color = tint_of(kind)))
    }
    return grow(c, 1)
}

/// Step an exclusive-pick signal by `delta` if this row is the one that
/// currently holds it. Clamps at both ends (same as Menu / Select).
fn roving_step(value: Signal<int>, index: int, count: int, delta: int) {
    if value.get() != index {
        return
    }
    let n = value.get() + delta
    if n < 0 {
        return
    }
    if n >= count {
        return
    }
    value.set(n)
}

/// Jump an exclusive pick to `target` (Home → 0, End → `count - 1`) if this
/// row is the one that currently holds it — the same guard as `roving_step`,
/// so only the focused row of a group answers the key.
fn roving_jump(value: Signal<int>, index: int, target: int) {
    if value.get() != index {
        return
    }
    if target < 0 {
        return
    }
    value.set(target)
}

/// The four bindings every roving group shares: the arrow pair along its
/// axis, plus Home / End. `prefix` names the actions (`"tab"` → `tab.next`).
/// `vertical` adds up / down beside left / right, for groups that stack.
fn roving_keys(prefix: string, value: Signal<int>, index: int, count: int,
               vertical: bool = false) -> []KeyBind {
    let mut keys = []KeyBind {
        key_bind("right", "{{prefix}}.next", fn() { roving_step(value, index, count, 1) }),
        key_bind("left", "{{prefix}}.prev", fn() { roving_step(value, index, count, -1) }),
        key_bind("home", "{{prefix}}.first", fn() { roving_jump(value, index, 0) }),
        key_bind("end", "{{prefix}}.last", fn() { roving_jump(value, index, count - 1) }),
    }
    if vertical {
        push(keys, key_bind("down", "{{prefix}}.next", fn() { roving_step(value, index, count, 1) }))
        push(keys, key_bind("up", "{{prefix}}.prev", fn() { roving_step(value, index, count, -1) }))
    }
    return keys
}

/// Case-insensitive ASCII substring test, used to filter combobox options.
fn ci_has(hay: string, needle: string) -> bool {
    let hn = hay.len
    let nn = needle.len
    if nn == 0 {
        return true
    }
    if nn > hn {
        return false
    }
    let mut i = 0
    while i + nn <= hn {
        let mut j = 0
        let mut ok = 1
        while j < nn {
            if lower_byte(hay[i + j]) != lower_byte(needle[j]) {
                ok = 0
            }
            j = j + 1
        }
        if ok != 0 {
            return true
        }
        i = i + 1
    }
    return false
}

fn lower_byte(c: int) -> int {
    if c >= 65 {
        if c <= 90 {
            return c + 32
        }
    }
    return c
}

fn combo_filter(options: []string, q: string) -> []string {
    let mut out = []string {}
    let n = options.len
    for i in 0..n {
        if ci_has(options[i], q) {
            push(out, options[i])
        }
    }
    return out
}

/// Read the pending key and move the combobox highlight. Returns the index to
/// pick, or -1.
fn combo_key(active: Signal<int>, matches: Signal<[]string>) -> int {
    let k = current_key().key
    let n = matches.get().len
    if k == Key.Down {
        if active.get() < 0 {
            active.set(0)
        } else if active.get() + 1 < n {
            active.set(active.get() + 1)
        }
        return -1
    }
    if k == Key.Up {
        if active.get() > 0 {
            active.set(active.get() - 1)
        }
        return -1
    }
    if k == Key.Enter {
        if active.get() >= 0 {
            return active.get()
        }
        return -1
    }
    if k == Key.Escape {
        active.set(-1)
        return -1
    }
    if k == Key.Backspace {
        if n > 0 {
            if active.get() < 0 {
                active.set(0)
            }
        }
        return -1
    }
    if k >= 32 {
        if k < 127 {
            // Typing filters the list; open it on the first character.
            active.set(0)
        }
    }
    return -1
}

/// Placeholder surface: rounded, faint accent fill with a left-to-right
/// shimmer band on the frame clock (static under reduced motion). Width /
/// height explicit; wrap in a card to demo.
fn Skeleton(w: int, h: int, radius: int) -> Node {
    let n = Box(style = Style(width = px(w),
                              height = px(h),
                              radius = corners(radius),
                              background = bone()),
                role = "progressbar",
                label = "Loading")
    return pulse(n)
}

struct SpinnerProps {
    /// Ring diameter in dp.
    size: int = 16,
    /// Ring color; defaults to `dim()`.
    color: string = "",
    /// Milliseconds per full turn.
    period: int = 900,
    /// Accessible label (role `progressbar`).
    label: string = "Loading",
    style: Option<fn() -> Style> = none,
}

/// Indeterminate loader. The rotation is a paint-only loop track: it never
/// re-runs a component or effect and skips layout, and it keeps a frame live
/// while it is visible. Under reduced motion it settles static.
fn Spinner(p: SpinnerProps) -> Node {
    let n = Icon(IC_LOADER, px_or_default(p.size, 16), str_or_default(p.color, dim()),
                 role = "progressbar", label = p.label, style = p.style)
    return spin(n, px_or_default(p.period, 900))
}

struct EmptyProps {
    /// Icon markup, e.g. `IC_INFO`. Empty for none.
    icon: string = "",
    title: fn() -> string = empty_text,
    body: fn() -> string = empty_text,
    /// The trailing block: an action, under the copy.
    children: fn() = noop,
    /// Style, merged over the recipe's own: `style = Style(radius = corners(4))`.
    style: Option<fn() -> Style> = none,
}

/// Centred empty state: optional icon, title, supporting copy, then an action
/// supplied as the trailing block.
fn Empty(p: EmptyProps) -> Node {
    return Box(style = merge(Style(direction = Direction.Column, gap = Space.Xs,
                                   align = Align.Center, justify = Align.Center,
                                   padding = edges(Space.Xl)),
                             style_of(p.style))) {
        if p.icon.len > 0 {
            Icon(p.icon, 28, dim())
        }
        Text(p.title, style = Style(width = pct(-1), font = FONT_TITLE, color = ink()))
        Text(p.body, style = Style(width = pct(-1), font = FONT_BODY, color = mute()))
        p.children()
    }
}

struct AccordionRow {
    title: string,
    body: string,
}

/// Preferred side for an anchored floater. `flip` (default on) switches to the
/// opposite side when the preferred one overflows.
enum Place {
    // Below the trigger (menus, select).
    PlaceBelow = 0,
    // Above the trigger (tooltips, hover cards).
    PlaceAbove = 1,
    // To the trigger's end (inline end on a row).
    PlaceEnd = 2,
    // To the trigger's start.
    PlaceStart = 3,
    // Tooltip placements: above / below the trigger, aligned to its start,
    // centre or end along the cross axis. `PlaceAboveCenter` is what a plain
    // tooltip wants — `PlaceAbove` / `PlaceBelow` keep the old start-aligned
    // behaviour the menus and popovers use.
    PlaceAboveStart = 4,
    PlaceAboveCenter = 5,
    PlaceAboveEnd = 6,
    PlaceBelowStart = 7,
    PlaceBelowCenter = 8,
    PlaceBelowEnd = 9,
}

struct MenuRow {
    label: string = "",
    /// Paint a separator above this row.
    isSeparated: bool = false,
    /// Destructive command: painted in the danger ink.
    danger: bool = false,
}

/// The empty list a `[]MenuRow` prop defaults to.
fn no_menu_rows() -> []MenuRow {
    return []MenuRow {}
}

/// Which window edge a `Drawer` slides from.
enum Side {
    // Slide in from the start (left) edge.
    SideStart = 0,
    // Slide in from the end (right) edge.
    SideEnd = 1,
    // Slide down from the top edge.
    SideTop = 2,
    // Slide up from the bottom edge (a sheet).
    SideBottom = 3,
}

/// Column a `TableColsProps.sort` value points at (-1 = unsorted).
fn sort_col(sort: int) -> int {
    if sort > 0 {
        return sort - 1
    }
    if sort < 0 {
        return -sort - 1
    }
    return -1
}

/// true when a `sort` value is descending.
fn sort_desc(sort: int) -> bool {
    return sort < 0
}

/// A copy of `s` with ASCII letters lowercased ("Hello" → "hello").
fn lowercase(s: string) -> string {
    let mut b = []int {}
    for i in 0..s.len {
        push(b, lower_byte(s[i]))
    }
    return string_from_bytes(b)
}

/// A copy of `s` with ASCII letters uppercased ("hello" → "HELLO").
fn uppercase(s: string) -> string {
    let mut b = []int {}
    for i in 0..s.len {
        push(b, upper_byte(s[i]))
    }
    return string_from_bytes(b)
}

fn upper_byte(c: int) -> int {
    if c >= 97 && c <= 122 {
        return c - 32
    }
    return c
}

/// Case-insensitive string order: negative, 0, positive. "apple" < "Banana";
/// "Hello" and "hello" compare equal.
fn str_cmp(a: string, b: string) -> int {
    let n = if a.len < b.len { a.len } else { b.len }
    for i in 0..n {
        let ca = lower_byte(a[i])
        let cb = lower_byte(b[i])
        if ca != cb {
            return ca - cb
        }
    }
    return a.len - b.len
}

// --- natural sort keys -----------------------------------------------------
// A cell is ordered by what it says, not by its bytes: it splits into text
// and number chunks, text compares case-insensitively, and a number compares
// by value — sign, decimals and thousands separators included — so "9" <
// "10", "$300" < "$1,200", "-5" < "3", "2.5" < "2.75", "Item 9" < "Item 10",
// ISO dates by date, and "1.9.0" < "1.10.2" (a dotted run of more than two
// numbers is a version, not a decimal). Numbers sort before text.
//
// Each cell becomes a key once — a flat []int that compares lexicographically
// — so a sort costs one key build per row, not two parses per comparison.
// Encoding, per chunk:
//   number  KEY_NUM, sign (0 negative, 1 positive), then for a positive
//           number: integer digit count, the digits, the fraction digits
//           (trailing zeros dropped), and -1 to end the fraction. A negative
//           number stores everything inverted (-count, 9 - digit) and ends
//           with 10, so a larger magnitude sorts first.
//   text    KEY_TEXT, the lowercased bytes, -1 to end the chunk.
// A key that runs out first sorts first ("ab" < "abc").

const KEY_NUM: int = 1
const KEY_TEXT: int = 2

fn is_digit(c: int) -> bool {
    return c >= 48 && c <= 57
}

fn is_alnum(c: int) -> bool {
    return is_digit(c) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
}

/// Index just past a digit run starting at `i`, skipping thousands commas
/// ("1,200": a comma with exactly three digits after it and no digit after
/// those).
fn num_run_end(s: string, i: int) -> int {
    let mut k = i
    while k < s.len {
        if is_digit(s[k]) {
            k = k + 1
        } else if thousands_comma(s, k) {
            k = k + 4
        } else {
            break
        }
    }
    return k
}

/// true when `s[k]` is a comma between digit groups: a digit before it,
/// exactly three digits after it, then no fourth.
fn thousands_comma(s: string, k: int) -> bool {
    if s[k] != 44 || k == 0 || k + 3 >= s.len {
        return false
    }
    if !is_digit(s[k - 1]) {
        return false
    }
    if !is_digit(s[k + 1]) || !is_digit(s[k + 2]) || !is_digit(s[k + 3]) {
        return false
    }
    return k + 4 >= s.len || !is_digit(s[k + 4])
}

/// The natural sort key of one cell (see the encoding above).
fn sort_key(s: string) -> []int {
    let mut key = []int {}
    let mut i = 0
    while i < s.len {
        let c = s[i]
        // A sign belongs to the number after it when nothing alphanumeric
        // precedes it ("-5", "$-5", " -5"), never in "2026-10" or "A-1".
        let mut neg = false
        let mut at = i
        if c == 45 && i + 1 < s.len && is_digit(s[i + 1]) && (i == 0 || !is_alnum(s[i - 1])) {
            neg = true
            at = i + 1
        }
        if is_digit(s[at]) {
            let int_end = num_run_end(s, at)
            let mut end = int_end
            let mut frac_b = int_end
            let mut frac_e = int_end
            // One dot followed by digits is a decimal point — unless another
            // dot-and-digits follows, which makes the run a version number.
            if int_end + 1 < s.len && s[int_end] == 46 && is_digit(s[int_end + 1]) {
                let mut f = int_end + 1
                while f < s.len && is_digit(s[f]) {
                    f = f + 1
                }
                let version = f + 1 < s.len && s[f] == 46 && is_digit(s[f + 1])
                let follows_version = at > 1 && s[at - 1] == 46 && is_digit(s[at - 2])
                if !version && !follows_version {
                    frac_b = int_end + 1
                    frac_e = f
                    end = f
                }
            }
            // Integer digits without separators or leading zeros.
            let mut digits = []int {}
            for k in at..int_end {
                if is_digit(s[k]) {
                    if digits.len > 0 || s[k] != 48 {
                        push(digits, s[k] - 48)
                    }
                }
            }
            let mut fe = frac_e
            while fe > frac_b && s[fe - 1] == 48 {
                fe = fe - 1
            }
            if digits.len == 0 && fe == frac_b {
                neg = false
            }
            push(key, KEY_NUM)
            if neg {
                push(key, 0)
                push(key, -digits.len)
                for k in 0..digits.len {
                    push(key, 9 - digits[k])
                }
                for k in frac_b..fe {
                    push(key, 9 - (s[k] - 48))
                }
                push(key, 10)
            } else {
                push(key, 1)
                push(key, digits.len)
                for k in 0..digits.len {
                    push(key, digits[k])
                }
                for k in frac_b..fe {
                    push(key, s[k] - 48)
                }
                push(key, -1)
            }
            i = end
        } else {
            push(key, KEY_TEXT)
            while i < s.len {
                let t = s[i]
                if is_digit(t) {
                    break
                }
                if t == 45 && i + 1 < s.len && is_digit(s[i + 1]) && (i == 0 || !is_alnum(s[i - 1])) {
                    break
                }
                push(key, lower_byte(t))
                i = i + 1
            }
            push(key, -1)
        }
    }
    return key
}

fn key_cmp(a: []int, b: []int) -> int {
    let n = if a.len < b.len { a.len } else { b.len }
    for i in 0..n {
        if a[i] != b[i] {
            return a[i] - b[i]
        }
    }
    return a.len - b.len
}

/// Byte-wise order: only the final tie-break, so cells that read the same
/// ("apple" / "Apple") still land in one fixed order whatever order they
/// arrived in.
fn byte_cmp(a: string, b: string) -> int {
    let n = if a.len < b.len { a.len } else { b.len }
    for i in 0..n {
        if a[i] != b[i] {
            return a[i] - b[i]
        }
    }
    return a.len - b.len
}

/// Order two cells naturally (see `sort_key`): by value where they hold
/// numbers, case-insensitively where they hold text, bytes only to break a
/// tie.
fn cell_cmp(a: string, b: string) -> int {
    let c = key_cmp(sort_key(a), sort_key(b))
    if c != 0 {
        return c
    }
    return byte_cmp(a, b)
}

/// Sort of any items by a string key in natural order (see `sort_key`), for
/// a `VirtualTable`'s `Signal<[]T>`:
/// `rows.set(zeus.sort_by(base, fn(j) => j.name, zeus.sort_desc(sort.get())))`.
/// The result depends only on the keys, never on the order the items came
/// in; empty keys go last in both directions. `sort_cells` does the same from
/// a `cells` mapper and a `sort` value.
fn sort_by<T>(items: []T, key: fn(T) -> string, desc: bool) -> []T {
    let n = items.len
    let mut raw = []string {}
    let mut keys = [][]int {}
    let mut idx = []int {}
    for i in 0..n {
        let k = key(items[i])
        push(raw, k)
        push(keys, sort_key(k))
        push(idx, i)
    }
    // Bottom-up merge sort over indices: O(n log n), stable.
    let mut tmp = []int {}
    for i in 0..n {
        push(tmp, 0)
    }
    let mut width = 1
    while width < n {
        let mut lo = 0
        while lo < n {
            let mid = if lo + width < n { lo + width } else { n }
            let hi = if lo + 2 * width < n { lo + 2 * width } else { n }
            let mut a = lo
            let mut b = mid
            let mut o = lo
            while a < mid || b < hi {
                // Stable: the left run wins unless the right item is strictly
                // before it.
                let mut take_a = b >= hi
                if a < mid && b < hi {
                    take_a = !sort_before(raw, keys, idx[b], idx[a], desc)
                }
                if take_a {
                    tmp[o] = idx[a]
                    a = a + 1
                } else {
                    tmp[o] = idx[b]
                    b = b + 1
                }
                o = o + 1
            }
            lo = hi
        }
        for i in 0..n {
            idx[i] = tmp[i]
        }
        width = width * 2
    }
    let mut out = []T {}
    for i in 0..n {
        push(out, items[idx[i]])
    }
    return out
}

/// true when row `x` sorts strictly before row `y`: empty keys last in both
/// directions, then the natural key, then raw bytes — every step reversed
/// for `desc` except the empty-last rule.
fn sort_before(raw: []string, keys: [][]int, x: int, y: int, desc: bool) -> bool {
    let ex = raw[x].len == 0
    let ey = raw[y].len == 0
    if ex != ey {
        return ey
    }
    let mut c = key_cmp(keys[x], keys[y])
    if c == 0 {
        c = byte_cmp(raw[x], raw[y])
    }
    if desc {
        return c > 0
    }
    return c < 0
}

/// Items ordered by a `sort` value (`TableColsProps`) over their `cells`:
/// 0 returns them as given; otherwise sorted on that column in natural order
/// (`sort_by`). `Table` derives its shown order with this; a `VirtualTable`
/// app calls it in an effect on its sort signal.
fn sort_cells<T>(items: []T, cells: fn(T) -> []string, sort: int) -> []T {
    let col = sort_col(sort)
    if col < 0 {
        let mut out = []T {}
        for i in 0..items.len {
            push(out, items[i])
        }
        return out
    }
    return sort_by(items, fn(t: T) -> string {
        let c = cells(t)
        if col < c.len {
            return c[col]
        }
        return ""
    }, sort_desc(sort))
}

/// Cells joined by tabs: `Table`'s row key.
fn cells_key(cells: []string) -> string {
    let mut k = ""
    for i in 0..cells.len {
        if i > 0 {
            k = "{{k}}\t{{cells[i]}}"
        } else {
            k = cells[i]
        }
    }
    return k
}

/// Next sort state after clicking column `i`: none → asc → desc → none.
fn sort_cycle(current_value: int, i: int) -> int {
    if current_value == i + 1 {
        return -(i + 1)
    }
    if current_value == -(i + 1) {
        return 0
    }
    return i + 1
}

/// Light-mode stroke for series `i`.
fn chart_stroke_light(i: int) -> string {
    match i % 5 {
        0 => { return LIGHT.chart1 }
        1 => { return LIGHT.chart2 }
        2 => { return LIGHT.chart3 }
        3 => { return LIGHT.chart4 }
        _ => { return LIGHT.chart5 }
    }
}

/// Dark-mode stroke for series `i`.
fn chart_stroke_dark(i: int) -> string {
    match i % 5 {
        0 => { return DARK.chart1 }
        1 => { return DARK.chart2 }
        2 => { return DARK.chart3 }
        3 => { return DARK.chart4 }
        _ => { return DARK.chart5 }
    }
}

/// Light-mode area wash for series `i`.
fn chart_fl(i: int) -> string {
    match i % 5 {
        0 => { return LIGHT.fill1 }
        1 => { return LIGHT.fill2 }
        2 => { return LIGHT.fill3 }
        3 => { return LIGHT.fill4 }
        _ => { return LIGHT.fill5 }
    }
}

/// Dark-mode area wash for series `i`.
fn chart_fd(i: int) -> string {
    match i % 5 {
        0 => { return DARK.fill1 }
        1 => { return DARK.fill2 }
        2 => { return DARK.fill3 }
        3 => { return DARK.fill4 }
        _ => { return DARK.fill5 }
    }
}

/// Series stroke for series `i`. Series 0 is the first brand color — the
/// old `k == 1` ladder sent series 0 to the `else` arm, so the first series
/// was painted in the *last* color. Returns a role token, so a theme switch
/// repaints the series without rebuilding the chart.
fn chart_color(i: int) -> string {
    match i % 5 {
        0 => { return role_token(ROLE.Chart1) }
        1 => { return role_token(ROLE.Chart2) }
        2 => { return role_token(ROLE.Chart3) }
        3 => { return role_token(ROLE.Chart4) }
        _ => { return role_token(ROLE.Chart5) }
    }
}

/// Area wash per series in the current appearance (`primary/20`-style
/// blends of the series strokes).
/// Area wash under series `i`, matched to `chart_color` and indexed the
/// same way.
fn chart_fill(i: int) -> string {
    match i % 5 {
        0 => { return role_token(ROLE.Fill1) }
        1 => { return role_token(ROLE.Fill2) }
        2 => { return role_token(ROLE.Fill3) }
        3 => { return role_token(ROLE.Fill4) }
        _ => { return role_token(ROLE.Fill5) }
    }
}

/// Tooltip border: `border/50` in light, near-`border` in dark.
fn chart_edge() -> string { return role_token(ROLE.ChartEdge) }

fn bytes_s(b: []int, s: string) -> []int {
    let mut out = b
    for i in 0..s.len {
        out.push(s[i])
    }
    return out
}

fn bytes_i(b: []int, v: int) -> []int {
    let mut out = b
    let mut w = v
    if w < 0 {
        out.push(45)
        w = -w
    }
    if w == 0 {
        out.push(48)
        return out
    }
    let mut digits = []int {}
    let mut t = w
    while t > 0 {
        digits.push(48 + t % 10)
        t = t / 10
    }
    let m = digits.len
    for i in 0..m {
        out.push(digits[m - 1 - i])
    }
    return out
}

/// Value at category `i`, series `j` in the row-major flat array.
fn chart_val(vals: []int, s: int, i: int, j: int) -> int {
    return vals[i * s + j]
}

/// Shared y domain over series `0..s`: one axis scales every series.
fn chart_domain(vals: []int, s: int, n: int) -> int {
    let mut hi = 1
    for i in 0..n {
        for j in 0..s {
            let v = chart_val(vals, s, i, j)
            if v > hi {
                hi = v
            }
        }
    }
    return hi
}

fn chart_col_x(gutter: int, col_w: int, i: int) -> int {
    return gutter + i * col_w
}

/// Plot x of category `i` when the series spans the full plot width: the
/// first point sits on the left grid edge and the last on the right edge,
/// so a line/area chart has no half-column dead space at its ends.
/// `col_w * n` is the plot width; the n marks divide it into n-1 spans.
fn chart_pt_x(gutter: int, col_w: int, n: int, i: int) -> int {
    if n <= 1 {
        return gutter + col_w * n / 2
    }
    return gutter + i * (col_w * n) / (n - 1)
}

/// Mark x for category `i`: span mode (pt = 1, line/area charts) uses
/// `chart_pt_x`; column mode (pt = 0, bar charts) keeps the band centers.
fn chart_mx(pt: int, gutter: int, col_w: int, n: int, i: int) -> int {
    if pt != 0 {
        return chart_pt_x(gutter, col_w, n, i)
    }
    return chart_col_x(gutter, col_w, i) + col_w / 2
}

fn chart_y(maxv: int, plot_h: int, top: int, v: int) -> int {
    // i64: a value in the millions times the plot height passes i32.
    return top + plot_h - int(i64(v) * i64(plot_h) / i64(maxv))
}

/// A `LineChart` value that is not drawn: no dot, the line breaks around
/// it, the y domain ignores it, and the tooltip shows a dash. For a series
/// that has no value yet at that label (an indicator still warming up).
const CHART_GAP: int = -2147483647

/// Extras for `LineChart`. The defaults draw what the chart always drew.
struct LineChartProps {
    /// true = the y axis spans the values instead of starting at 0.
    fit: bool = false,
    /// Implied decimals when a value prints: 12037 with 2 reads `120.37`.
    decimals: int = 0,
    /// Draw every k-th x label. 0 picks about eight across the plot.
    labelEvery: int = 1,
    /// false = the line alone, no dot per point.
    dots: bool = true,
}

/// `v` with `dec` implied decimals. `CHART_GAP` prints as a dash.
fn chart_fmt(v: int, dec: int) -> string {
    if v == CHART_GAP {
        return "-"
    }
    if dec <= 0 {
        return "{{v}}"
    }
    let mut sign = ""
    let mut n = i64(v)
    if n < i64(0) {
        sign = "-"
        n = -n
    }
    let mut unit = i64(1)
    for k in 0..dec {
        unit = unit * i64(10)
    }
    let whole = n / unit
    let mut frac = "{{n % unit}}"
    while frac.len < dec {
        frac = "0{{frac}}"
    }
    return "{{sign}}{{whole}}.{{frac}}"
}

/// Smallest and largest drawn value over series `0..s`; gaps are skipped.
/// `hi` stays at least `lo + 1`, so a flat series still has a span.
fn chart_span(vals: []int, s: int, n: int, fit: bool) -> []int {
    let mut lo = 0
    let mut hi = 1
    let mut seen = false
    for i in 0..n {
        for j in 0..s {
            let v = chart_val(vals, s, i, j)
            if v != CHART_GAP {
                if !seen {
                    hi = v
                    if fit {
                        lo = v
                    }
                    seen = true
                }
                if v > hi {
                    hi = v
                }
                if fit && v < lo {
                    lo = v
                }
            }
        }
    }
    if fit && seen {
        // A tenth of the span below the lowest value, so the line does not
        // ride the baseline.
        let pad = (hi - lo) / 10
        lo = lo - pad
        if lo < 0 {
            lo = 0
        }
    }
    if hi <= lo {
        hi = lo + 1
    }
    let mut out = []int {}
    out.push(lo)
    out.push(hi)
    return out
}

fn chart_fy(lo: int, hi: int, plot_h: int, top: int, v: int) -> int {
    return top + plot_h - int(i64(v - lo) * i64(plot_h) / i64(hi - lo))
}

/// Polyline for series `j` over `lo..hi`. A gap lifts the pen.
fn chart_fline_d(vals: []int, s: int, j: int, lo: int, hi: int, gutter: int, col_w: int,
                 plot_h: int, top: int, n: int) -> string {
    let mut b = []int {}
    let mut pen = false
    for i in 0..n {
        let v = chart_val(vals, s, i, j)
        if v == CHART_GAP {
            pen = false
        } else {
            if pen {
                b = bytes_s(b, "L")
            } else {
                b = bytes_s(b, "M")
            }
            b = bytes_i(b, chart_pt_x(gutter, col_w, n, i))
            b = bytes_s(b, " ")
            b = bytes_i(b, chart_fy(lo, hi, plot_h, top, v))
            pen = true
        }
    }
    return string_from_bytes(b)
}

/// Gridlines, y ticks from `hi` down to `lo`, and the baseline.
fn chart_faxes(w: int, h: int, lo: int, hi: int, dec: int) {
    let plot_h = h - CHART_TOP - CHART_XLAB
    let base_y = CHART_TOP + plot_h
    for k in 0..4 {
        let line = Box(style = Style(width = px(w - CHART_GUTTER),
                                     height = px(1),
                                     opacity = 45,
                                     position = pos_absolute(),
                                     inset = Edges(top = CHART_TOP + k * plot_h / 4, left = CHART_GUTTER),
                                     background = rule()))
    }
    for k in 0..5 {
        let tv = hi - int(i64(k) * i64(hi - lo) / i64(4))
        let lab = Box(style = Style(width = px(CHART_GUTTER - 6),
                                    height = px(12),
                                    direction = Direction.Row,
                                    justify = Align.End,
                                    position = pos_absolute(),
                                    inset = Edges(top = CHART_TOP + k * plot_h / 4 - 6, left = 0))) {
            Text(chart_tick(tv, dec, hi - lo), style = Style(font = FONT_CAPTION, color = mute()))
        }
    }
    let axis = Box(style = Style(width = px(w - CHART_GUTTER),
                                 height = px(1),
                                 position = pos_absolute(),
                                 inset = Edges(top = base_y, left = CHART_GUTTER),
                                 background = hard()))
}

/// A y tick. Once a quarter of the span is a whole unit or more, the
/// decimals are dropped (rounded), so the label fits the gutter.
fn chart_tick(v: int, dec: int, span: int) -> string {
    if dec <= 0 {
        return "{{v}}"
    }
    let mut unit = 1
    for k in 0..dec {
        unit = unit * 10
    }
    if span / 4 < unit {
        return chart_fmt(v, dec)
    }
    let whole = (v + unit / 2) / unit
    return "{{whole}}"
}

/// Room below the plot for rotated x labels past about six characters.
fn chart_xlab_extra(labels: []string) -> int {
    let mut m = 0
    for i in 0..labels.len {
        if labels[i].len > m {
            m = labels[i].len
        }
    }
    if m <= 6 {
        return 0
    }
    return (m - 6) * 5
}

/// Label stride for `LineChartProps.labelEvery`: 0 is about eight labels.
fn chart_every(every: int, n: int) -> int {
    if every > 0 {
        return every
    }
    let k = n / 8
    if k < 1 {
        return 1
    }
    return k
}

/// Compose svg markup; `d` is in plot coordinates and the viewBox matches
/// the node size, so coordinates map 1:1.
fn chart_svg(d: string, w: int, h: int, fill: string, stroke: string, sw: int) -> string {
    let mut b = []int {}
    b = bytes_s(b, "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 ")
    b = bytes_i(b, w)
    b = bytes_s(b, " ")
    b = bytes_i(b, h)
    b = bytes_s(b, "'><path fill='")
    b = bytes_s(b, fill)
    b = bytes_s(b, "' stroke='")
    b = bytes_s(b, stroke)
    b = bytes_s(b, "' stroke-width='")
    b = bytes_i(b, sw)
    b = bytes_s(b, "' d='")
    b = bytes_s(b, d)
    b = bytes_s(b, "'/></svg>")
    return string_from_bytes(b)
}

/// Full-size svg node for the plot, layered at 0,0.
fn ChartLayer(markup: string, w: int, h: int) -> Node {
    return Svg(markup,
               style = Style(width = px(w),
                             height = px(h),
                             position = pos_absolute(),
                             inset = Edges(top = 0, left = 0)))
}

/// Polyline for series `j` (straight segments — recharts default linear).
fn chart_line_d(vals: []int, s: int, j: int, maxv: int, gutter: int, col_w: int,
                plot_h: int, top: int, n: int) -> string {
    let mut b = []int {}
    b = bytes_s(b, "M")
    for i in 0..n {
        let x = chart_pt_x(gutter, col_w, n, i)
        let y = chart_y(maxv, plot_h, top, chart_val(vals, s, i, j))
        b = bytes_i(b, x)
        b = bytes_s(b, " ")
        b = bytes_i(b, y)
        if i + 1 < n {
            b = bytes_s(b, "L")
        }
    }
    return string_from_bytes(b)
}

/// Closed polygon under series `j`: the line plus the baseline (area fill).
fn chart_area_d(vals: []int, s: int, j: int, maxv: int, gutter: int, col_w: int,
                plot_h: int, top: int, n: int) -> string {
    let base = top + plot_h
    let first_x = chart_pt_x(gutter, col_w, n, 0)
    let last_x = chart_pt_x(gutter, col_w, n, n - 1)
    let mut b = []int {}
    b = bytes_s(b, "M")
    for i in 0..n {
        let x = chart_pt_x(gutter, col_w, n, i)
        let y = chart_y(maxv, plot_h, top, chart_val(vals, s, i, j))
        b = bytes_i(b, x)
        b = bytes_s(b, " ")
        b = bytes_i(b, y)
        b = bytes_s(b, "L")
    }
    b = bytes_i(b, last_x)
    b = bytes_s(b, " ")
    b = bytes_i(b, base)
    b = bytes_s(b, "L")
    b = bytes_i(b, first_x)
    b = bytes_s(b, " ")
    b = bytes_i(b, base)
    b = bytes_s(b, "Z")
    return string_from_bytes(b)
}

/// Gridlines + y tick labels + baseline. Call with the plot pushed.
fn chart_axes(w: int, h: int, maxv: int) {
    let plot_h = h - CHART_TOP - CHART_XLAB
    let base_y = CHART_TOP + plot_h
    // Gridlines above the baseline (top = max value).
    for k in 0..4 {
        let line = Box(style = Style(width = px(w - CHART_GUTTER),
                                     height = px(1),
                                     opacity = 45,
                                     position = pos_absolute(),
                                     inset = Edges(top = CHART_TOP + k * plot_h / 4, left = CHART_GUTTER),
                                     background = rule()))
    }
    // Y tick labels, max .. 0 (bottom 0 sits above the baseline).
    for k in 0..5 {
        let tv = maxv - k * maxv / 4
        let lab = Box(style = Style(width = px(CHART_GUTTER - 6),
                                    height = px(12),
                                    direction = Direction.Row,
                                    justify = Align.End,
                                    position = pos_absolute(),
                                    inset = Edges(top = CHART_TOP + k * plot_h / 4 - 6, left = 0))) {
            Text("{{tv}}", style = Style(font = FONT_CAPTION, color = mute()))
        }
    }
    // Baseline axis.
    let axis = Box(style = Style(width = px(w - CHART_GUTTER),
                                 height = px(1),
                                 position = pos_absolute(),
                                 inset = Edges(top = base_y, left = CHART_GUTTER),
                                 background = hard()))
}

/// Tooltip width (dp) and the air between it and the mark it describes.
const CHART_TIP_W: int = 128
const CHART_TIP_GAP: int = 10

/// Where the tooltip goes for a mark at (`mx`, `my`) whose body reaches
/// `reach` dp either side of `mx`: beside the mark, top-aligned just above
/// it, on the right unless that overflows the plot, then on the left — so the
/// panel never covers the mark it describes. A plot too narrow for either side
/// centres the panel over the mark instead, above it (below when there is no
/// room above). Returns [left, top].
fn chart_tip_place(mx: int, my: int, reach: int, tip_h: int, w: int, h: int) -> []int {
    let side = reach + CHART_TIP_GAP
    let mut top = my - tip_h / 3
    if top < 0 {
        top = 0
    }
    if top + tip_h > h {
        top = h - tip_h
    }
    let right = mx + side
    if right + CHART_TIP_W <= w {
        return []int { right, top }
    }
    let left = mx - side - CHART_TIP_W
    if left >= 0 {
        return []int { left, top }
    }
    // Neither side fits: centre on the mark, clear of it vertically.
    let mut x = mx - CHART_TIP_W / 2
    if x + CHART_TIP_W > w {
        x = w - CHART_TIP_W
    }
    if x < 0 {
        x = 0
    }
    let mut y = my - CHART_TIP_GAP - tip_h
    if y < 0 {
        y = my + CHART_TIP_GAP
    }
    return []int { x, y }
}

/// One floating tooltip panel shared by every category: its content and
/// position track the hovered column (`act` = category + 1, 0 = none)
/// through an effect, instead of one pre-built panel per category. Style
/// props are plain data, so a prop that must follow a signal gets `styled`.
/// `ys` is each column's topmost mark (the anchor) and `reach` the mark's
/// half-width, so the panel sits beside the mark rather than on it.
fn chart_tooltip(labels: []string, names: []string, vals: []int, s: int, n: int,
                 w: int, h: int, col_w: int, act: Signal<int>, pt: int, dec: int,
                 ys: []int, reach: int) {
    let panel = Box(
        style = Style(width = px(CHART_TIP_W),
                      direction = Direction.Column,
                      gap = 4,
                      position = pos_absolute(),
                      zIndex = 8,
                      padding = edges2(6, 10),
                      inset = Edges(top = 0),
                      radius = corners(RAD_LG),
                      border = line(HAIRLINE, chart_edge()),
                      background = plate()),
        on_click = fn() { return },
        role = "dialog",
        visible = act.get() != 0
    )
    enter_fade(panel)
    // Follow the hovered mark; -1 (no pin) while `act` is 0, when the panel
    // is hidden anyway. The height is the panel's last measured one (its row
    // count never changes), estimated before the first layout.
    styled(panel, || {
        let a = act.get() - 1
        let mut x = -1
        let mut y = 0
        if a >= 0 {
            if a < n {
                let mut tip_h = arena.nodes[panel.id].h
                if tip_h <= 0 {
                    tip_h = 30 + s * 20
                }
                let at = chart_tip_place(chart_mx(pt, CHART_GUTTER, col_w, n, a), ys[a],
                                         reach, tip_h, w, h)
                x = at[0]
                y = at[1]
            }
        }
        arena.nodes[panel.id].pin_l = x
        arena.nodes[panel.id].pin_t = y
    })
    slot(panel, || {
        Text(fn() -> string {
            let a = act.get() - 1
            if a >= 0 {
                if a < n {
                    return labels[a]
                }
            }
            return ""
        },
             style = Style(font = FONT_CAPTION, color = ink()))
        for j in 0..s {
            let jj = j
            Row(Space.Exs) {
                Box(style = Style(width = px(8),
                                  height = px(8),
                                  radius = corners(2),
                                  background = chart_color(jj)))
                Text(names[jj], style = Style(font = FONT_CAPTION, color = mute()))
                Grow()
                Text(fn() -> string {
                    let a = act.get() - 1
                    if a >= 0 {
                        if a < n {
                            return chart_fmt(vals[a * s + jj], dec)
                        }
                    }
                    return ""
                },
                     style = Style(font = FONT_CAPTION, color = ink()))
            }
        }
    })
}

/// Transparent hover zone for a category. Hovering it flips its own
/// signal; a watch effect folds that into the shared `act`. Span mode
/// gives each mark a contiguous catch strip from the midpoint of the
/// previous mark to the midpoint of the next (the ends reach the plot
/// edges), so the pointer always lands on the nearest mark; column mode
/// keeps the full-band coverage of the bar columns.
fn chart_zone(i: int, hov: Signal<int>, act: Signal<int>, h: int, col_w: int, pt: int,
              n: int) {
    let mut zl = 0
    let mut zw = col_w
    if pt != 0 {
        // Span mode: Voronoi strip around mark `i`.
        if n <= 1 {
            zl = CHART_GUTTER
            zw = col_w * n
        } else {
            if i == 0 {
                zl = CHART_GUTTER
            } else {
                zl = (chart_pt_x(CHART_GUTTER, col_w, n, i - 1) + chart_pt_x(CHART_GUTTER, col_w, n, i)) / 2
            }
            if i == n - 1 {
                zw = CHART_GUTTER + col_w * n - zl
            } else {
                let zr = (chart_pt_x(CHART_GUTTER, col_w, n, i) + chart_pt_x(CHART_GUTTER, col_w, n, i + 1)) / 2
                zw = zr - zl
            }
        }
    } else {
        zl = chart_col_x(CHART_GUTTER, col_w, i)
    }
    let zone = Box(style = Style(width = px(zw),
                                 height = px(h),
                                 position = pos_absolute(),
                                 inset = Edges(top = 0, left = zl)))
    hover(zone, hov)
    styled(zone, || {
        if hov.get() > 0 {
            act.set(i + 1)
        } else {
            if act.get() == i + 1 {
                act.set(0)
            }
        }
    })
}

/// X category label under the plot, rotated 45° clockwise around its top-left.
/// Rotated labels are parallel diagonal strips, so they never collide with
/// each other however narrow the plot gets; CHART_XLAB reserves their room.
fn chart_xlab(label: string, i: int, col_w: int, plot_h: int, pt: int, n: int) {
    // 8px of air below the baseline axis: the rotated strip starts below the
    // line, not on it (the pivot corner is the strip's top edge). Span mode
    // labels sit just left of their mark so the strip stays inside the plot.
    let x = if pt != 0 { chart_pt_x(CHART_GUTTER, col_w, n, i) - 4 } else { chart_col_x(CHART_GUTTER, col_w, i) + 3 }
    let lab = Text(label,
                   style = Style(position = pos_absolute(),
                                 font = FONT_CAPTION,
                                 inset = Edges(top = CHART_TOP + plot_h + 8, left = x),
                                 color = mute()))
    text_rot(lab, 45)
}

/// Bottom-centered legend, 16px between entries.
fn chart_legend(names: []string) {
    Box(style = Style(direction = Direction.Row, wrap = true, gap = 16, justify = Align.Center)) {
        Loop(names, fn(j, name) {
            return Row(Space.Exxs) {
                Box(style = Style(width = px(8),
                                  height = px(8),
                                  radius = corners(2),
                                  background = chart_color(j)))
                Text(name, style = Style(font = FONT_CAPTION, color = mute()))
            }
        })
    }
}

/// Hover cursor: a single hairline through the hovered mark (no wash band).
/// `act` = category + 1; the line shows and slides with it. Build it before
/// the marks, so the line runs behind the dots and bars rather than over them.
fn chart_cursor(act: Signal<int>, n: int, col_w: int, plot_h: int, pt: int) {
    let line = Box(style = Style(width = px(1),
                                 height = px(plot_h),
                                 opacity = 55,
                                 position = pos_absolute(),
                                 inset = Edges(top = CHART_TOP),
                                 radius = corners(0),
                                 background = hard()),
                   label = "cursor",
                   role = "presentation")
    styled(line, || {
        let a = act.get() - 1
        let mut x = -1
        if a >= 0 {
            if a < n {
                x = chart_mx(pt, CHART_GUTTER, col_w, n, a)
            }
        }
        arena.nodes[line.id].pin_l = x
    })
    show(line, act)
}

/// Hover zones + the single following tooltip; call with the plot pushed,
/// after the marks (the cursor goes in first, before them: `chart_cursor`).
/// `act` is created by the chart builder so the marks can dim for the hovered
/// column. `pt` = 1 for plot-spanning line/area charts (zone strips snap to
/// the nearest mark), 0 for column-mode bar charts. `ys` / `reach`: see
/// `chart_tooltip`.
fn chart_tooltips(labels: []string, names: []string, vals: []int, s: int, n: int,
                  h: int, w: int, col_w: int, act: Signal<int>, pt: int, ys: []int,
                  reach: int, dec: int = 0) {
    for i in 0..n {
        let hov = signal(0)
        chart_zone(i, hov, act, h, col_w, pt, n)
    }
    chart_tooltip(labels, names, vals, s, n, w, h, col_w, act, pt, dec, ys, reach)
}

/// Dim/restore a mark for the hovered column: full at rest or on its own
/// column, faded while another column is hovered.
fn chart_dim(act: Signal<int>, i: int) -> int {
    let a = act.get()
    if a == 0 {
        return 100
    }
    if a == i + 1 {
        return 100
    }
    return 40
}

/// Resolve the plot width: a measured host width wins (the host stretches
/// with its parent, so the chart re-fits on window resize); before the first
/// layout the caller's estimate is used. A measured width is used however
/// small — falling back to the estimate there is what made a squeezed chart
/// spill out of its card — floored only so the plot keeps a few pixels.
fn chart_w(w: int, host: Node) -> int {
    let mw = measured_width(host)
    if mw > 0 {
        return geometry.max2(mw, CHART_GUTTER + 8)
    }
    return w
}

/// Side inset of a bar group inside its column: 5 dp, less in a column too
/// narrow to spare it.
fn chart_bar_inset(col_w: int) -> int {
    let i = col_w / 4
    if i > 5 {
        return 5
    }
    return i
}

fn chart_bars(labels: []string, names: []string, vals: []int, n: int, s: int,
              w: int, h: int, host: Node) {
    let gw = chart_w(w, host)
    let plot_h = h - CHART_TOP - CHART_XLAB
    let col_w = geometry.max2((gw - CHART_GUTTER) / n, 1)
    let domain = chart_domain(vals, s, n)
    let base_y = CHART_TOP + plot_h
    let inset = chart_bar_inset(col_w)
    let bar_w = geometry.max2((col_w - 2 * inset) / s, 1)
    // Shared hovered mark: zones, cursor, tooltip, and the marks read it.
    let act = signal(0)
    // Each column's anchor for the tooltip: the top of its tallest bar.
    let mut ys = []int {}
    for i in 0..n {
        let mut top = base_y
        for j in 0..s {
            let v = chart_val(vals, s, i, j)
            if v > 0 {
                let t = base_y - geometry.max2(v * plot_h / domain, 1)
                if t < top {
                    top = t
                }
            }
        }
        push(ys, top)
    }
    let plot = Box(style = Style(width = px(gw), height = px(h)))
    slot(plot, || {
        chart_axes(gw, h, domain)
        chart_cursor(act, n, col_w, plot_h, 0)
        for i in 0..n {
            let x0 = chart_col_x(CHART_GUTTER, col_w, i) + inset
            let ii = i
            for j in 0..s {
                let v = chart_val(vals, s, i, j)
                let bh = geometry.max2(v * plot_h / domain, 1)
                if v > 0 {
                    let bar = Box(style = Style(width = px(bar_w),
                                                height = px(bh),
                                                position = pos_absolute(),
                                                inset = Edges(top = base_y - bh, left = x0 + j * bar_w),
                                                radius = corners(3),
                                                background = chart_color(j)))
                    styled(bar, || { opacity(bar, chart_dim(act, ii)) })
                }
            }
            chart_xlab(labels[i], i, col_w, plot_h, 0, n)
        }
        chart_tooltips(labels, names, vals, s, n, h, gw, col_w, act, 0, ys, bar_w * s / 2)
    })
    chart_legend(names)
}

fn chart_lines(labels: []string, names: []string, vals: []int, n: int, s: int,
               w: int, h: int, host: Node, p: LineChartProps) {
    let gw = chart_w(w, host)
    let plot_h = h - CHART_TOP - CHART_XLAB
    let col_w = geometry.max2((gw - CHART_GUTTER) / n, 1)
    let span = chart_span(vals, s, n, p.fit)
    let lo = span[0]
    let hi = span[1]
    let every = chart_every(p.labelEvery, n)
    // Shared hovered mark: zones, cursor, tooltip, and the marks read it.
    let act = signal(0)
    // A 45° label longer than a few characters reaches below CHART_XLAB;
    // the extra height keeps the legend clear of it. Short labels add none.
    // Each column's anchor for the tooltip: its highest drawn point.
    let mut ys = []int {}
    for i in 0..n {
        let mut top = CHART_TOP + plot_h
        for j in 0..s {
            let v = chart_val(vals, s, i, j)
            if v != CHART_GAP {
                let y = chart_fy(lo, hi, plot_h, CHART_TOP, v)
                if y < top {
                    top = y
                }
            }
        }
        push(ys, top)
    }
    let plot = Box(style = Style(width = px(gw), height = px(h + chart_xlab_extra(labels))))
    slot(plot, || {
        chart_faxes(gw, h, lo, hi, p.decimals)
        chart_cursor(act, n, col_w, plot_h, 1)
        for j in 0..s {
            let d = chart_fline_d(vals, s, j, lo, hi, CHART_GUTTER, col_w, plot_h,
                                  CHART_TOP, n)
            let line_l = ChartLayer(chart_svg(d, gw, h, "none", chart_stroke_light(j), 2), gw, h)
            let line_d = ChartLayer(chart_svg(d, gw, h, "none", chart_stroke_dark(j), 2), gw, h)
            show_eq(line_l, appearance(), 0)
            show_eq(line_d, appearance(), 1)
            if p.dots {
                for i in 0..n {
                    let v = chart_val(vals, s, i, j)
                    if v != CHART_GAP {
                        let x = chart_pt_x(CHART_GUTTER, col_w, n, i)
                        let y = chart_fy(lo, hi, plot_h, CHART_TOP, v)
                        let dot = Box(style = Style(width = px(6),
                                                    height = px(6),
                                                    position = pos_absolute(),
                                                    inset = Edges(top = y - 3, left = x - 3),
                                                    radius = corners(3),
                                                    background = chart_color(j)))
                    }
                }
            }
        }
        for i in 0..n {
            if i % every == 0 {
                chart_xlab(labels[i], i, col_w, plot_h, 1, n)
            }
        }
        chart_tooltips(labels, names, vals, s, n, h, gw, col_w, act, 1, ys, 3, p.decimals)
    })
    chart_legend(names)
}

fn chart_areas(labels: []string, names: []string, vals: []int, n: int, s: int,
               w: int, h: int, host: Node) {
    let gw = chart_w(w, host)
    let plot_h = h - CHART_TOP - CHART_XLAB
    let col_w = geometry.max2((gw - CHART_GUTTER) / n, 1)
    let domain = chart_domain(vals, s, n)
    // Shared hovered mark: zones, cursor, tooltip, and the marks read it.
    let act = signal(0)
    // Each column's anchor for the tooltip: its highest point.
    let mut ys = []int {}
    for i in 0..n {
        let mut top = CHART_TOP + plot_h
        for j in 0..s {
            let y = chart_y(domain, plot_h, CHART_TOP, chart_val(vals, s, i, j))
            if y < top {
                top = y
            }
        }
        push(ys, top)
    }
    let plot = Box(style = Style(width = px(gw), height = px(h)))
    slot(plot, || {
        chart_axes(gw, h, domain)
        chart_cursor(act, n, col_w, plot_h, 1)
        for j in 0..s {
            let d = chart_area_d(vals, s, j, domain, CHART_GUTTER, col_w, plot_h,
                                 CHART_TOP, n)
            let fd = chart_svg(d, gw, h, chart_fd(j), "none", 0)
            let fl = chart_svg(d, gw, h, chart_fl(j), "none", 0)
            let area_l = ChartLayer(fl, gw, h)
            let area_d = ChartLayer(fd, gw, h)
            show_eq(area_l, appearance(), 0)
            show_eq(area_d, appearance(), 1)
            let dl = chart_line_d(vals, s, j, domain, CHART_GUTTER, col_w, plot_h,
                                  CHART_TOP, n)
            let line_l = ChartLayer(chart_svg(dl, gw, h, "none", chart_stroke_light(j), 2), gw, h)
            let line_d = ChartLayer(chart_svg(dl, gw, h, "none", chart_stroke_dark(j), 2), gw, h)
            show_eq(line_l, appearance(), 0)
            show_eq(line_d, appearance(), 1)
            for i in 0..n {
                let x = chart_pt_x(CHART_GUTTER, col_w, n, i)
                let y = chart_y(domain, plot_h, CHART_TOP, chart_val(vals, s, i, j))
                let dot = Box(style = Style(width = px(6),
                                            height = px(6),
                                            position = pos_absolute(),
                                            inset = Edges(top = y - 3, left = x - 3),
                                            radius = corners(3),
                                            background = chart_color(j)))
                let ii = i
                styled(dot, || { opacity(dot, chart_dim(act, ii)) })
            }
        }
        for i in 0..n {
            chart_xlab(labels[i], i, col_w, plot_h, 1, n)
        }
        chart_tooltips(labels, names, vals, s, n, h, gw, col_w, act, 1, ys, 3)
    })
    chart_legend(names)
}

fn cal_leap(year: int) -> int {
    if year % 4 != 0 {
        return 0
    }
    if year % 100 != 0 {
        return 1
    }
    if year % 400 == 0 {
        return 1
    }
    return 0
}

fn cal_len(year: int, month: int) -> int {
    if month == 2 {
        if cal_leap(year) != 0 {
            return 29
        }
        return 28
    }
    if month == 4 {
        return 30
    }
    if month == 6 {
        return 30
    }
    if month == 9 {
        return 30
    }
    if month == 11 {
        return 30
    }
    return 31
}

fn cal_month_t(month: int) -> int {
    if month == 1 { return 0 }
    if month == 2 { return 3 }
    if month == 3 { return 2 }
    if month == 4 { return 5 }
    if month == 5 { return 0 }
    if month == 6 { return 3 }
    if month == 7 { return 5 }
    if month == 8 { return 1 }
    if month == 9 { return 4 }
    if month == 10 { return 6 }
    if month == 11 { return 2 }
    return 4
}

fn cal_first_monday(year: int, month: int) -> int {
    let mut y = year
    if month < 3 {
        y = y - 1
    }
    let s = y + y / 4 - y / 100 + y / 400 + cal_month_t(month) + 1
    let sun = s % 7
    return (sun + 6) % 7
}

fn cal_month_name(m: int) -> string {
    match m {
        1 => { return "January" }
        2 => { return "February" }
        3 => { return "March" }
        4 => { return "April" }
        5 => { return "May" }
        6 => { return "June" }
        7 => { return "July" }
        8 => { return "August" }
        9 => { return "September" }
        10 => { return "October" }
        11 => { return "November" }
        _ => { return "December" }
    }
}

/// Day number for grid cell `idx` (0-based) in the month `m` of `year`,
/// or 0 for a leading/trailing blank. Cells stay fixed; the value is
/// recomputed from the live y/m signals, so flipping month or year only
/// re-runs the cell prop thunks — no rebuild, no 12 pre-built grids.
fn cal_day_at(year: int, m: int, idx: int) -> int {
    let day = idx - cal_first_monday(year, m) + 1
    if day < 1 {
        return 0
    }
    if day > cal_len(year, m) {
        return 0
    }
    return day
}

/// Card chrome. `Card()` keeps the recipe; pass any style prop to restyle
/// it without copying the widget (`Card(radius = 6, padding = 12)`).
/// `visible` and `bind` go through `Component`.
struct CardProps {

    visible: Option<fn() -> bool> = none,
    bind: Option<Signal<int>> = none,
    /// Interactive card: a pointer target with a hover lift and `on_click`
    /// (role `button`). `on_click` alone implies it.
    interactive: bool = false,
    on_click: Option<fn()> = none,
    /// Resting shadow (`Elevation.*`); `Elevation.Flat` for a flat card.
    elevation: int = Elevation.Raised,
    /// Elevation the card lifts to on hover (default `Elevation.Floating`
    /// when interactive, 0 = no lift). Paint-only: the shadow blends on the
    /// hover track.
    lift: int = -1,
    /// Header row above the body: `title` (heading type) and `subtitle`
    /// (muted caption). Either empty = no header.
    title: string = "",
    subtitle: string = "",
    /// Media strip above everything: an image `src` at `mediaHeight` dp,
    /// bleeding to the card edge under the top corners.
    media: string = "",
    mediaHeight: int = 160,
    /// Footer row under the body, separated by a hairline; built by this
    /// thunk (actions, a caption). Omit for none.
    footer: Option<fn()> = none,
    /// Keyboard actions on this element (`key_bind(...)`, `key_bind_click(...)`).
    keys: []KeyBind = no_keys(),
    /// CSS-subset style; a present key wins over the recipe's.
    style: Option<fn() -> Style> = none,
    /// The trailing block: the body, placed by the component.
    children: fn() = noop,
}

/// Card body slot. The trailing block lands here — after the media and
/// header, before the footer — so `Card(title = "…") { … }` reads top-down.
fn Card(p: CardProps) -> Node {
    // state. The media strip bleeds through the side padding, so it reads the
    // padding the caller's style gives the card.
    let interactive = p.interactive || result.is_some(p.on_click)
    let has_header = p.title.len > 0 || p.subtitle.len > 0
    let user = style_of(p.style)
    let bleed = edge_or(user.padding, 3, 20)
    let r = corner_or(user.radius, RAD_XL)
    let lift = if interactive && p.lift >= 0 { p.lift } else if interactive { Elevation.Floating } else if p.lift > 0 { p.lift } else { -1 }

    // view
    return Box(
        style = merge(Style(direction = Direction.Column, gap = Space.Xs, elevation = p.elevation,
                            padding = edges4(if p.media.len > 0 { 0 } else { 16 }, 20, 16, 20),
                            radius = corners(RAD_XL), border = line(HAIRLINE, rule()),
                            background = plate(),
                            cursor = opt_color(if interactive { "pointer" } else { "" })),
                      style_of(p.style)),
        visible = p.visible,
        bind = p.bind,
        on_click = p.on_click,
        role = if interactive { "button" } else { "" },
        lift = lift,
        pressScale = interactive,
        press = interactive,
        keys = p.keys
    ) {
        if p.media.len > 0 {
            Box(style = Style(height = px(p.mediaHeight), radius = corners(r),
                              margin = Edges(left = -bleed, right = -bleed),
                              overflow = Overflow.Hidden),
                role = "img") {
                Image(p.media, style = Style(height = px(p.mediaHeight), grow = 1),
                      fit = Fit.Cover)
            }
        }
        if has_header {
            CardHeader(p.title, p.subtitle)
        }
        if result.is_some(p.footer) {
            // The body sits in its own column so the footer follows it.
            Box(style = Style(direction = Direction.Column, gap = Space.Xs)) {
                p.children()
            }
            CardFooter() {
                emit(p.footer)
            }
        } else {
            p.children()
        }
    }
}

/// Options for `CardHeader`.
struct CardHeaderProps {
    /// Trailing slot, right-aligned on the title row (a menu, a badge).
    action: Option<fn()> = none,
}

/// A card's header: `title` in title type, `description` muted under it, and
/// an optional trailing `action`. `Card(title = …)` builds one; compose it
/// yourself for a header with an action.
fn CardHeader(title: string, description: string, p: CardHeaderProps) -> Node {
    return Box(style = Style(direction = Direction.Row, gap = Space.Exs, align = Align.Start)) {
        Box(style = Style(direction = Direction.Column, gap = 2, grow = 1), role = "heading") {
            if title.len > 0 {
                Text(title, style = Style(font = FONT_TITLE, color = ink()))
            }
            if description.len > 0 {
                Text(description, style = Style(font = FONT_CAPTION, color = mute()))
            }
        }
        emit(p.action)
    }
}

/// A card's footer row: a hairline, then the trailing block laid out in a row
/// (actions, a caption).
struct CardFooterProps {
    children: fn() = noop,
}

fn CardFooter(p: CardFooterProps) -> Node {
    return Box(style = Style(direction = Direction.Column, gap = Space.Xs), role = "contentinfo") {
        Separator()
        Box(style = Style(direction = Direction.Row, gap = Space.Exs, align = Align.Center)) {
            p.children()
        }
    }
}

fn cell_num(s: string) -> CellNum {
    let mut i = 0
    let mut neg = false
    if s.len > 0 {
        if s[0] == 45 {
            neg = true
            i = 1
        } else if s[0] == 43 {
            i = 1
        }
    }
    let mut v = 0
    let mut digits = 0
    while i < s.len {
        let c = s[i]
        if c < 48 || c > 57 {
            break
        }
        v = v * 10 + (c - 48)
        digits = digits + 1
        i = i + 1
    }
    if digits == 0 {
        return CellNum(ok = false, v = 0)
    }
    if neg {
        v = -v
    }
    return CellNum(ok = true, v = v)
}

/// Parse a cell as an integer (optional sign, digits, then anything —
/// "12", "-3", "30 kg" all count; "" and "abc" do not). Returns the value
/// and whether it parsed, so numeric columns sort by value.
struct CellNum {
    ok: bool,
    v: int,
}

// ═══════════════════════════════════════════════════════════════════
// Tier A atoms: tags, inline type, key combos, ring, skeleton presets
// ═══════════════════════════════════════════════════════════════════

/// Soft wash behind a `Tint` (tags, callouts, banners).
fn tint_bg(kind: int) -> string {
    match kind {
        Tint.Ok => { return ok_bg() }
        Tint.Warn => { return warn_bg() }
        Tint.Danger => { return danger_bg() }
        Tint.Info => { return info_bg() }
        _ => { return raised() }
    }
}

/// Edge for a `Tint`; see `tint_bg`.
fn tint_line(kind: int) -> string {
    match kind {
        Tint.Ok => { return ok_line() }
        Tint.Warn => { return warn_line() }
        Tint.Danger => { return danger_line() }
        Tint.Info => { return info_line() }
        _ => { return rule() }
    }
}

/// Text ink for a `Tint` that clears AA on its `tint_bg`.
fn tint_ink(kind: int) -> string {
    match kind {
        Tint.Ok => { return ok_ink() }
        Tint.Warn => { return warn_ink() }
        Tint.Danger => { return danger_ink() }
        Tint.Info => { return info_ink() }
        Tint.Mute | Tint.Dim => { return mute() }
        _ => { return ink() }
    }
}

/// Options for `Tag`.
struct TagProps {
    /// `Tint` for the wash, edge, and ink.
    tint: int = Tint.Mute,
    /// `Size` token: the tag is `badge_h(size)` tall.
    size: int = Size.Md,
    /// Removable tag: a trailing X runs this (role `button`, label
    /// `Remove <label>`). Hiding the tag is the caller's job.
    on_remove: Option<fn()> = none,
    style: Option<fn() -> Style> = none,
}

/// Tag: a soft-tinted label with a small radius — a category or filter value,
/// told apart from the pill `Badge` (a status) and the dotted `Chip`.
fn Tag(label: fn() -> string, p: TagProps) -> Node {
    let removable = result.is_some(p.on_remove)
    return Box(style = merge(Style(height = px(badge_h(p.size)), direction = Direction.Row,
                                   gap = 4, align = Align.Center,
                                   padding = Edges(left = 8, right = if removable { 2 } else { 8 }),
                                   radius = corners(RAD_SM - 2),
                                   border = line(HAIRLINE, tint_line(p.tint)),
                                   background = tint_bg(p.tint)),
                             style_of(p.style))) {
        Text(label, style = merge(Style(font = FONT_CAPTION, color = tint_ink(p.tint), ellipsis = true),
                                  text_part(style_of(p.style))))
        if removable {
            Box(style = Style(width = px(16), height = px(16), shrink = 0,
                              align = Align.Center, justify = Align.Center,
                              radius = corners(RAD_SM - 4), cursor = "pointer"),
                on_click = p.on_remove,
                role = "button",
                label = "Remove {{label()}}",
                hoverFade = true) {
                Icon(IC_X, IconSize.Xs, tint_ink(p.tint))
            }
        }
    }
}

/// Status dot + label, no chrome: "● Online" in a table cell or a header.
fn DotBadge(label: fn() -> string, kind: int) -> Node {
    return Box(style = Style(direction = Direction.Row, gap = 6, align = Align.Center),
               role = "status",
               label = label()) {
        Pip(tint_of(kind), DOT)
        Text(label, style = Style(font = FONT_CONTROL, color = ink()))
    }
}

/// Options for `Link`.
struct LinkProps {
    /// A trailing arrow-out-of-box, for a link that leaves the app.
    external: bool = false,
    /// Type size; the surrounding text's, usually.
    font: int = FONT_BODY,
    style: Option<fn() -> Style> = none,
}

/// Inline link: accent ink, underlined while hovered, role `link`. Navigation
/// is the caller's `on_click` (a router `go`, `open_url`, ...).
fn Link(label: fn() -> string, on_click: fn(), p: LinkProps) -> Node {
    let hot = signal(0)
    let me = ref()
    on_mount(|| { watch_hover(me, hot) })
    return Row(0) {
        Box(ref = me,
            style = merge(Style(direction = Direction.Row, gap = 2, align = Align.Center,
                                cursor = "pointer"),
                          style_of(p.style)),
            on_click = on_click,
            role = "link",
            label = label()) {
            Box(style = Style(direction = Direction.Column)) {
                Text(label, style = Style(font = p.font, color = accent()))
                // The underline is a 1px rule under the text, shown on hover.
                Box(style = Style(height = px(HAIRLINE), background = accent(),
                                  opacity = if hot.get() != 0 { 100 } else { 0 }))
            }
            if p.external {
                Icon(IC_EXTERNAL, p.font - 2, accent())
            }
        }
    }
}

/// Inline code: mono-ish caption type on a raised wash.
fn Code(text: fn() -> string) -> Node {
    return Row(0) {
        Box(style = Style(direction = Direction.Row,
                          padding = Edges(left = 4, right = 4, top = 1, bottom = 1),
                          radius = corners(4), background = raised())) {
            Text(text, style = Style(font = FONT_CONTROL, color = ink()))
        }
    }
}

/// Quoted passage: a 3px rule down the start edge, muted body type.
/// Trailing block is the quote (one or more `Text`s); `cite` adds a caption.
struct BlockquoteProps {
    cite: string = "",
    children: fn() = noop,
}

fn Blockquote(p: BlockquoteProps) -> Node {
    return Box(style = Style(direction = Direction.Row, gap = 12)) {
        Box(style = Style(width = px(3), shrink = 0, radius = corners(2), background = hard()))
        Box(style = Style(direction = Direction.Column, gap = 6, grow = 1)) {
            p.children()
            if p.cite.len > 0 {
                Text("— {{p.cite}}", style = Style(font = FONT_CAPTION, color = mute()))
            }
        }
    }
}

/// Options for `KbdCombo`.
struct KbdComboProps {
    /// Force a convention: 1 = Apple (⌘⇧P), 0 = everyone else
    /// (Ctrl+Shift+P), -1 (default) = the host's (`apple_keys()`).
    apple: int = -1,
}

/// A shortcut in the platform's own spelling: `KbdCombo("cmd+shift+p")` is
/// ⌘⇧P on a Mac and Ctrl+Shift+P elsewhere. `spec` uses the keymap syntax
/// (`cmd` / `ctrl` / `alt` / `shift`, `+` or `-` between, then the key).
fn KbdCombo(spec: string, p: KbdComboProps) -> Node {
    let apple = if p.apple >= 0 { p.apple == 1 } else { apple_keys() }
    let parts = combo_parts(spec)
    return Box(style = Style(direction = Direction.Row, gap = 4, align = Align.Center),
               role = "group",
               label = combo_text(parts, apple, "+")) {
        if apple {
            Kbd(combo_text(parts, true, ""))
        } else {
            Loop(parts, fn(i, part) {
                return Box(style = Style(direction = Direction.Row, gap = 4, align = Align.Center)) {
                    if i > 0 {
                        Text("+", style = Style(font = 10, color = mute()))
                    }
                    Kbd(key_name(part, false))
                }
            })
        }
    }
}

/// `spec` split on `+` / `-` (a lone `-` or `+` key stays a key).
fn combo_parts(spec: string) -> []string {
    let mut out = []string {}
    let mut b = []int {}
    for i in 0..spec.len {
        let c = spec[i]
        if (c == 43 || c == 45) && b.len > 0 {
            push(out, string_from_bytes(b))
            b = []int {}
        } else {
            push(b, c)
        }
    }
    if b.len > 0 {
        push(out, string_from_bytes(b))
    }
    return out
}

fn combo_text(parts: []string, apple: bool, sep: string) -> string {
    let mut s = ""
    for i in 0..parts.len {
        if i > 0 {
            s = "{{s}}{{sep}}"
        }
        s = "{{s}}{{key_name(parts[i], apple)}}"
    }
    return s
}

/// One key of a combo, spelled for the platform.
fn key_name(part: string, apple: bool) -> string {
    let k = lowercase(part)
    if fmt.eq(k, "cmd") || fmt.eq(k, "super") || fmt.eq(k, "mod") {
        return if apple { "⌘" } else { "Ctrl" }
    }
    if fmt.eq(k, "ctrl") || fmt.eq(k, "control") {
        return if apple { "⌃" } else { "Ctrl" }
    }
    if fmt.eq(k, "alt") || fmt.eq(k, "opt") {
        return if apple { "⌥" } else { "Alt" }
    }
    if fmt.eq(k, "shift") {
        return if apple { "⇧" } else { "Shift" }
    }
    if fmt.eq(k, "enter") || fmt.eq(k, "return") {
        return if apple { "↩" } else { "Enter" }
    }
    if fmt.eq(k, "escape") || fmt.eq(k, "esc") {
        return "Esc"
    }
    if fmt.eq(k, "backspace") {
        return if apple { "⌫" } else { "Backspace" }
    }
    if fmt.eq(k, "tab") {
        return "Tab"
    }
    if fmt.eq(k, "space") {
        return "Space"
    }
    if fmt.eq(k, "up") {
        return "↑"
    }
    if fmt.eq(k, "down") {
        return "↓"
    }
    if fmt.eq(k, "left") {
        return "←"
    }
    if fmt.eq(k, "right") {
        return "→"
    }
    if k.len == 1 {
        return uppercase(k)
    }
    return part
}

/// Options for `ProgressRing`.
struct ProgressRingProps {
    /// Diameter in px (`RING`, 48).
    size: int = RING,
    /// The percentage in the middle of the ring.
    label: bool = true,
    /// Arc ink (a role accessor); the accent by default.
    color: string = "",
}

/// Circular progress over 0..100: a hairline track with the accent arc
/// sweeping clockwise from the top, and the percentage in the middle.
fn ProgressRing(value: Signal<int>, p: ProgressRingProps) -> Node {
    let d = p.size
    return Box(style = Style(width = px(d), height = px(d), shrink = 0,
                             align = Align.Center, justify = Align.Center),
               role = "progressbar",
               label = "{{value.get()}}%") {
        Svg(RING_TRACK, style = Style(width = px(d), height = px(d), position = pos_absolute(),
                                      inset = Edges(top = 0, left = 0), color = rule()))
        RingArc(value, d, str_or_default(p.color, accent()))
        if p.label {
            // Content width, so the ring's centring applies; a full-width
            // label would paint from the ring's left edge.
            Text("{{value.get()}}%", style = Style(width = pct(-1),
                                                   font = if d >= 48 { FONT_CONTROL } else { 10 },
                                                   color = ink()))
        }
    }
}

/// The ring's arc: an svg whose markup follows `value` (the node keeps its
/// markup in its text, so a reactive text redraws it).
fn RingArc(value: Signal<int>, d: int, tint: string) -> Node {
    return Component(raw_svg(ring_markup(peek(value))),
                     text = ring_markup(value.get()),
                     style = Style(width = px(d), height = px(d), position = pos_absolute(),
                                   inset = Edges(top = 0, left = 0), color = tint))
}

const RING_TRACK: string =
"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><circle cx='12' cy='12' r='10' fill='none' stroke='currentColor' stroke-width='2.5'/></svg>"

/// sin(10° × i) × 1000 for i = 0..36. cos(a) is sin(a + 90°).
const SIN10: []int = []int {
    0, 174, 342, 500, 643, 766, 866, 940, 985, 1000, 985, 940, 866, 766, 643, 500, 342, 174,
    0, -174, -342, -500, -643, -766, -866, -940, -985, -1000, -985, -940, -866, -766, -643,
    -500, -342, -174, 0,
}

/// sin of `deg` (0..360) × 1000, linear between the 10° table steps.
fn sin1000(deg: int) -> int {
    let a = ((deg % 360) + 360) % 360
    let i = a / 10
    let f = a % 10
    return SIN10[i] + (SIN10[i + 1] - SIN10[i]) * f / 10
}

/// Thousandths as a decimal: 12345 → "12.345".
fn milli(v: int) -> string {
    let neg = v < 0
    let a = if neg { -v } else { v }
    let frac = a % 1000
    let pad = if frac < 10 { "00" } else if frac < 100 { "0" } else { "" }
    let sign = if neg { "-" } else { "" }
    return "{{sign}}{{a / 1000}}.{{pad}}{{frac}}"
}

/// A clockwise arc of `pct` percent on the r = 10 circle, starting at the top,
/// as a polyline (the host SVG readers skip arc commands).
fn ring_markup(pct: int) -> string {
    let v = clamp_pct(pct)
    let end = v * 360 / 100
    let mut d = "M12 2"
    let mut a = 10
    while a < end {
        d = "{{d}}L{{milli(12000 + 10 * sin1000(a))}} {{milli(12000 - 10 * sin1000(a + 90))}}"
        a = a + 10
    }
    if end > 0 {
        d = "{{d}}L{{milli(12000 + 10 * sin1000(end))}} {{milli(12000 - 10 * sin1000(end + 90))}}"
    }
    let stroke = if v > 0 { "2.5" } else { "0" }
    return "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='{{stroke}}' d='{{d}}'/></svg>"
}

fn clamp_pct(v: int) -> int {
    if v < 0 {
        return 0
    }
    if v > 100 {
        return 100
    }
    return v
}

/// Lines of placeholder text: `lines` bars at body height, the last one
/// shorter, like a paragraph's ragged end. Fills its parent's width.
fn SkeletonText(lines: int = 3) -> Node {
    return Box(style = Style(direction = Direction.Column, gap = 8),
               role = "progressbar",
               label = "Loading") {
        for i in 0..lines {
            pulse(Box(style = Style(width = pct(if i == lines - 1 && lines > 1 { 60 } else { 100 }),
                                    height = px(12), radius = corners(4), background = bone())))
        }
    }
}

/// A round placeholder the size of an `Avatar`.
fn SkeletonAvatar(size: int = AvatarSize.Lg) -> Node {
    return Skeleton(size, size, size / 2)
}

/// A card-shaped placeholder: avatar and two lines over a short paragraph.
fn SkeletonCard() -> Node {
    return Box(style = Style(direction = Direction.Column, gap = 16, padding = edges(20),
                             radius = corners(RAD_XL), border = line(HAIRLINE, rule()),
                             background = plate()),
               role = "progressbar",
               label = "Loading") {
        Box(style = Style(direction = Direction.Row, gap = 12, align = Align.Center)) {
            SkeletonAvatar(AvatarSize.Lg)
            Box(style = Style(direction = Direction.Column, gap = 8, grow = 1)) {
                pulse(Box(style = Style(width = pct(50), height = px(12), radius = corners(4),
                                        background = bone())))
                pulse(Box(style = Style(width = pct(30), height = px(10), radius = corners(4),
                                        background = bone())))
            }
        }
        SkeletonText(3)
    }
}

// --- tier B atoms: layout frames, scroll fades, gauges -------------------

/// Bytes of `s` in `[from, to)`.
fn str_slice(s: string, from: int, to: int) -> string {
    let mut b = []int {}
    let mut i = from
    while i < to && i < s.len {
        push(b, s[i])
        i = i + 1
    }
    return string_from_bytes(b)
}

/// One band of an edge fade, strongest where `opacity` is highest.
fn fade_strip(opacity: int) -> Node {
    return Box(style = Style(height = px(8), background = plate(), opacity = opacity))
}

/// Edge fade over a scroller. `top` hugs the top edge; otherwise the bottom.
/// `on` is read from layout (`shown`), so it follows the scroll offset.
fn ScrollShadow(top: bool, on: fn() -> bool) -> Node {
    return Box(style = Style(position = pos_absolute(),
                             inset = if top { Edges(top = 0, left = 0, right = 0) } else { Edges(bottom = 0, left = 0, right = 0) },
                             height = px(24), direction = Direction.Column, zIndex = 2,
                             display = shown(on())),
               role = "presentation",
               label = if top { "More above" } else { "More below" }) {
        fade_strip(if top { 100 } else { 25 })
        fade_strip(60)
        fade_strip(if top { 25 } else { 100 })
    }
}

/// Options for `ScrollArea`.
struct ScrollAreaProps {
    /// Viewport height.
    height: int = 240,
    style: Option<fn() -> Style> = none,
    children: fn() = noop,
}

/// Vertical scroller with edge fades. The thumb is the engine's 6px bar;
/// a fade shows on each edge that still has content past it.
fn ScrollArea(p: ScrollAreaProps) -> Node {
    let y = signal(0)
    let vh = signal(0)
    let ch = signal(0)
    let host = ref()
    let body = ref()
    let h = if p.height > 0 { p.height } else { 240 }
    on_mount(|| {
        on_resize(host, || { vh.set(rect(host).h) })
        on_resize(body, || { ch.set(rect(body).h) })
    })
    return Box(ref = host,
               style = merge(Style(position = Position.Relative, width = pct(100), height = px(h)),
                             style_of(p.style))) {
        Scroll(bind = y, style = Style(width = pct(100), height = px(h))) {
            Box(ref = body, style = Style(direction = Direction.Column, gap = 8)) {
                p.children()
            }
        }
        ScrollShadow(true, fn() -> bool { return y.get() > 2 })
        ScrollShadow(false, fn() -> bool { return y.get() + vh.get() + 2 < ch.get() })
    }
}

/// Options for `Container`.
struct ContainerProps {
    /// Max width. 0 is `CONTAINER_MD` (960). `CONTAINER_SM` / `CONTAINER_LG`
    /// are 640 / 1200.
    width: int = 0,
    style: Option<fn() -> Style> = none,
    children: fn() = noop,
}

/// Centres a column and caps its width. A page measure, not a card.
fn Container(p: ContainerProps) -> Node {
    let w = if p.width > 0 { p.width } else { CONTAINER_MD }
    return Box(style = merge(Style(width = pct(100), maxWidth = w, alignSelf = Align.Center,
                                   direction = Direction.Column),
                             style_of(p.style))) {
        p.children()
    }
}

/// Options for `AspectRatio`.
struct AspectRatioProps {
    style: Option<fn() -> Style> = none,
    children: fn() = noop,
}

/// A frame whose height follows its width at `w`:`h` (pass 16 and 9, or 1 and 1).
fn AspectRatio(w: int, h: int, p: AspectRatioProps) -> Node {
    let host = ref()
    let ht = signal(0)
    let rw = if w > 0 { w } else { 1 }
    let rh = if h > 0 { h } else { 1 }
    on_mount(|| {
        on_resize(host, || {
            let bw = rect(host).w
            if bw > 0 {
                ht.set(bw * rh / rw)
            }
        })
    })
    return Box(ref = host,
               style = merge(Style(width = pct(100), height = px(ht.get()), overflow = Overflow.Hidden),
                             style_of(p.style)),
               role = "presentation") {
        p.children()
    }
}

/// Options for `SimpleGrid`.
struct SimpleGridProps {
    gap: int = 12,
    style: Option<fn() -> Style> = none,
    children: fn() = noop,
}

/// A wrapping row. Each child is a `GridCell` with the same column count,
/// so the cells share the row and wrap onto the next.
fn SimpleGrid(p: SimpleGridProps) -> Node {
    return Box(style = merge(Style(direction = Direction.Row, wrap = true, gap = p.gap,
                                   align = Align.Stretch),
                             style_of(p.style))) {
        p.children()
    }
}

/// Options for `GridCell`.
struct GridCellProps {
    style: Option<fn() -> Style> = none,
    children: fn() = noop,
}

/// One cell of a `SimpleGrid`: `100 / columns` percent of the row.
fn GridCell(columns: int, p: GridCellProps) -> Node {
    let cols = if columns > 0 { columns } else { 1 }
    return Box(style = merge(Style(width = pct(100 / cols), direction = Direction.Column),
                             style_of(p.style))) {
        p.children()
    }
}

/// Options for `Gauge`.
struct GaugeProps {
    /// Ring diameter (`RING` is 48).
    size: int = RING,
    /// Caption under the ring. Empty hides it.
    caption: fn() -> string = empty_text,
    style: Option<fn() -> Style> = none,
}

/// A `ProgressRing` with a caption: one reading (a score, a capacity).
fn Gauge(value: Signal<int>, p: GaugeProps) -> Node {
    return Box(style = merge(Style(direction = Direction.Column, gap = 6, align = Align.Center),
                             style_of(p.style))) {
        ProgressRing(value, size = p.size, label = true)
        Text(p.caption, style = Style(width = pct(-1), font = FONT_CAPTION, color = mute(),
                                      display = shown(p.caption().len > 0)))
    }
}

/// Options for `UsageBar`.
struct UsageBarProps {
    label: fn() -> string = empty_text,
    /// At or above this percent the fill turns danger.
    threshold: int = 90,
    style: Option<fn() -> Style> = none,
}

/// Labelled meter on the 6px `METER_TRACK`. Accent until `threshold`, then danger.
fn UsageBar(value: Signal<int>, p: UsageBarProps) -> Node {
    return Box(style = merge(Style(direction = Direction.Column, gap = 6, width = pct(100)),
                             style_of(p.style)),
               role = "progressbar",
               label = fn() -> string { return "{{p.label()}} {{clamp_pct(value.get())}}%" }) {
        Box(style = Style(direction = Direction.Row, align = Align.Center)) {
            Text(p.label, style = Style(font = FONT_CONTROL, color = mute()))
            Grow()
            Text(fn() -> string { return "{{clamp_pct(value.get())}}%" },
                 style = Style(font = FONT_CONTROL,
                               color = if clamp_pct(value.get()) >= p.threshold { danger() } else { ink() }))
        }
        Box(style = Style(width = pct(100), height = px(METER_TRACK), radius = corners(RAD_FULL),
                          background = raised())) {
            Box(style = Style(width = pct(clamp_pct(value.get())), height = pct(100),
                              radius = corners(RAD_FULL),
                              background = if clamp_pct(value.get()) >= p.threshold { danger() } else { accent() }))
        }
    }
}
