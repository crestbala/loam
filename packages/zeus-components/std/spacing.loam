//! spacing — the design system's fixed metrics: the type scale and leading, the
//! corner radii, the focus ring, control sizes, stacking order, and the tooltip /
//! dialog / pagination / chart / calendar dimensions. These are the values a
//! theme leaves alone.
//!
//! The live palette and the role accessors live in `colors`. The inline SVG icon
//! set stays in `zeus_constants`, together with `VIRT_OVERSCAN` — the one
//! constant `zeusbase` itself reads, so it cannot move above it.

import "zeus:enums"
import "zeus-components:colors"

// --- type -----------------------------------------------------------------
/// Line heights, as a percentage of the font size. Canvas hosts draw one
/// weight, so hierarchy leans on size, colour, and leading — which makes the
/// leading load-bearing rather than decorative.
const LEAD_TIGHT: int = 115
const LEAD_SNUG: int = 130
const LEAD_NORMAL: int = 150
const LEAD_RELAXED: int = 170

/// Type scale. Canvas hosts draw one weight, so hierarchy leans on size and
/// color. 15 is the body workhorse: a size up from the usual 14, which suits
/// the roomier pill controls.
const FONT_DISPLAY: int = 32
const FONT_HEADING: int = 22
const FONT_TITLE: int = 17
const FONT_BODY: int = 14
const FONT_CONTROL: int = 12
const FONT_CAPTION: int = 11
const FONT_OVERLINE: int = 10

const PAGE_PAD: int = 32
const SECTION: int = 24

// --- focus ring -----------------------------------------------------------
/// Focus ring stroke width in dp.
const FOCUS_WIDTH: int = 2
/// Gap between the control's edge and the ring, in dp. The offset is what
/// keeps the ring legible on a solid-filled control, where a ring drawn flush
/// would disappear into the fill.
const FOCUS_OFFSET: int = 2

// --- radius ---------------------------------------------------------------
/// Corner radii, small to extra large: surfaces (cards, menus, dialogs) and
/// the rows inside them. Soft and generous; a nested radius is the outer one
/// minus the padding between them.
const RAD_SM: int = 8
const RAD_MD: int = 12
const RAD_LG: int = 16
const RAD_XL: int = 20
const RAD_FULL: int = 999
/// Interactive controls (buttons, fields, triggers, tabs, toggles, badges)
/// are pills: the shape that says "press me", told apart from surfaces at a
/// glance.
const RAD_CONTROL: int = RAD_FULL
/// A checkbox stays a rounded square, so it never reads as a radio.
const RAD_CHECK: int = 5
/// No rounding. Named so a caller can say `RAD_NONE` instead of a bare 0 and
/// mean it — `radius = 0` and "radius unset" were indistinguishable before.
const RAD_NONE: int = 0

// --- control scale --------------------------------------------------------
/// One table every control reads, keyed by a `Size` token: Button, TextInput,
/// Select, Combobox, Segmented, Toggle, pill Tabs, Pagination, the DatePicker
/// trigger, and NumberInput all share it, so any two of them line up in a row.
/// Height and side padding follow `density()`; type and icons do not.
fn control_h(size: int) -> int {
    let base = if size == Size.Sm { 32 } else if size == Size.Lg { 44 } else { 36 }
    return base + density_delta()
}

fn control_pad_x(size: int) -> int {
    let base = if size == Size.Sm { 12 } else if size == Size.Lg { 24 } else { 16 }
    return base + density_delta() / 2
}

fn control_font(size: int) -> int {
    if size == Size.Sm { 13 } else if size == Size.Lg { 15 } else { FONT_BODY }
}

fn control_icon(size: int) -> int {
    if size == Size.Sm { IconSize.Sm } else if size == Size.Lg { 18 } else { IconSize.Md }
}

fn control_gap(size: int) -> int {
    if size == Size.Sm { 6 } else { 8 }
}

/// Height shift for the current `density()`: −4 / 0 / +4.
fn density_delta() -> int {
    return (density().get() - Density.Standard) * 4
}

/// Switch track per `Size`: Sm 28×16, Md 36×20, Lg 44×24.
fn switch_w(size: int) -> int {
    if size == Size.Sm { 28 } else if size == Size.Lg { 44 } else { 36 }
}

fn switch_h(size: int) -> int {
    if size == Size.Sm { 16 } else if size == Size.Lg { 24 } else { 20 }
}

/// Table row height per `density()`.
fn table_row() -> int {
    return 40 + density_delta() * 2
}

// --- named one-off metrics --------------------------------------------------
/// Checkbox box and radio inner dot.
const CHECK: int = 16
const RADIO_DOT: int = 8
const SLIDER_TRACK: int = 4
const SLIDER_THUMB: int = 16
const METER_TRACK: int = 6
/// Progress ring diameter.
const RING: int = 48
const MENU_MIN_W: int = 200
const TOOLTIP_MAX_W: int = 256
const TOAST_W: int = 360
/// Side sheet / drawer width.
const SHEET_W: int = 380
/// Measure for short prose blocks (empty states, descriptions).
const PROSE_W: int = 320
/// Page column caps (`Container`).
const CONTAINER_SM: int = 640
const CONTAINER_MD: int = 960
const CONTAINER_LG: int = 1200
/// `Sidebar` width open and collapsed to icons.
const SIDEBAR_W: int = 240
const SIDEBAR_RAIL: int = 56
/// `SplitPane` handle thickness and the narrowest a pane may go.
const SPLIT_HIT: int = 6
const SPLIT_MIN: int = 160

// --- control metrics ------------------------------------------------------
const BAR: int = 52
const DOT: int = 8
const HAIRLINE: int = 1
/// Default width of a `Select` field.
const SELECT_W: int = 200
/// Stacking: scrim under the trigger/field, popup above both — so a Select
/// menu is not covered by a Combobox later in the same card.
const Z_SCRIM: int = 40
const Z_FIELD: int = 50
/// Hover floaters (tooltip, hover card): above the page, under an open popup.
const Z_HOVER: int = 70
const Z_POPUP: int = 80
/// Default `HoverCard` panel width; a caller's `style` width replaces it.
const HOVER_CARD_W: int = 280
/// Width of a `DatePicker` sheet; the 7-column day grid divides it.
const DATE_SHEET_W: int = 320

// --- tooltip --------------------------------------------------------------
/// Padding and caret size of a tooltip bubble. The caret's offset is derived
/// from the padding, so these two move together.
const TOOLTIP_PAD_X: int = 10
const TOOLTIP_PAD_Y: int = 6
const TOOLTIP_ARROW: int = 8

// --- dialog ---------------------------------------------------------------
/// Desktop dialog width; narrower windows get 92% of their width.
const DIALOG_W: int = 440
/// Scale the dialog card rests at while closed (percent).
const DIALOG_REST: int = 96

// --- pagination -----------------------------------------------------------
/// Slots in a collapsed pagination row: first, last, and a five-wide window.
const PAGE_SLOTS: int = 7

// --- charts ---------------------------------------------------------------
/// Chart width/height used by the demos (put charts in a Card column).
const CHART_W: int = 640
const CHART_H: int = 200
/// Left gutter for the y tick labels.
const CHART_GUTTER: int = 34
/// Air above the plot, room for the floating tooltip.
const CHART_TOP: int = 8
/// Bottom strip for the x labels (45° labels need diagonal room plus the
/// air gap between the baseline and the label corners).
const CHART_XLAB: int = 38

// --- calendar -------------------------------------------------------------
const CAL_CELL: int = 36
