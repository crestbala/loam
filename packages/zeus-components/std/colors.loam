//! colors — the colour API of the design system: the accessors a caller writes
//! (`ink`, `paper`, `plate`, `rule`, `mute`, `dim`, `ok`, `warn`, `danger`, the
//! `*_fill` pair, the accent, and `tint_of`). Each returns a role token — a
//! sentinel the paint pass resolves against `appearance()` every frame, so a
//! theme switch repaints a retained tree with no effects and no rebuild.
//!
//! The palette data (`LIGHT` / `DARK` / `NEUTRAL_*` / the semantic tiers) and the
//! engine that registers it — `ensure_role_colors`, `role_rgb_now`, `role_token`,
//! `role_color` — stay in `zeusbase`. The host entry calls the initializer before
//! the first paint, and a lower module may not import upward.

import "zeus:structs"
import "zeus:enums"
import "zeus:zeusbase"
import "zeus:flow"

// --- surfaces -------------------------------------------------------------
// `ink`, `accent`, and `danger` live in `zeusbase`, under the primitives.

/// Page background.
fn paper() -> string { return role_token(ROLE.Paper) }

/// Card / popover / dialog surface.
fn plate() -> string { return role_token(ROLE.Plate) }

/// Raised fill: hover washes, chips, the tab tray.
fn raised() -> string { return role_token(ROLE.Raised) }

/// Soft fill for code blocks and inset panels.
fn wash() -> string { return role_token(ROLE.Wash) }

/// Skeleton fill.
fn bone() -> string { return role_token(ROLE.Bone) }

/// Modal scrim behind dialogs and popovers.
fn scrim() -> string { return role_token(ROLE.Scrim) }

// --- text and lines -------------------------------------------------------

/// Secondary text and labels.
fn mute() -> string { return role_token(ROLE.Mute) }

/// Faint text: captions, overlines, placeholders.
fn dim() -> string { return role_token(ROLE.Dim) }

/// Hairline: borders, dividers, input strokes, tracks.
fn rule() -> string { return role_token(ROLE.Rule) }

/// Stronger line: grips, rules that must read on a raised fill.
fn hard() -> string { return role_token(ROLE.Hard) }

// --- accent ---------------------------------------------------------------

/// Soft accent surface: soft buttons, pressed toggles.
fn accent_soft() -> string { return role_token(ROLE.AccentSoft) }

/// Text on `ink` / `accent` fills.
fn on_ink() -> string { return role_token(ROLE.OnInk) }

/// Text on the accent's solid fill, picked by contrast.
fn on_accent() -> string { return role_token(ROLE.OnAccent) }

// --- status ---------------------------------------------------------------

/// Success text and marks.
fn ok() -> string { return role_token(ROLE.Ok) }

/// Solid success fill (ok badges); white text holds on it.
fn ok_solid() -> string { return role_token(ROLE.OkSolid) }

/// Warning text and marks.
fn warn() -> string { return role_token(ROLE.Warn) }

/// Warning border.
fn warn_edge() -> string { return role_token(ROLE.WarnEdge) }

/// Destructive fill (destructive buttons, filled danger badges).
fn danger_solid() -> string { return role_token(ROLE.DangerSolid) }

/// Destructive border.
fn danger_edge() -> string { return role_token(ROLE.DangerEdge) }

/// Text on danger fills.
fn on_danger() -> string { return role_token(ROLE.OnFill) }

/// Text on ok fills.
fn on_ok() -> string { return role_token(ROLE.OnFill) }

/// The text colour of a `Tint`.
fn tint_of(kind: int) -> string {
    match kind {
        Tint.Ok => { return ok() }
        Tint.Mute => { return mute() }
        Tint.Dim => { return dim() }
        Tint.Danger => { return danger() }
        Tint.Warn => { return warn() }
        _ => { return ink() }
    }
}

/// Choose between a light and a dark value for the current appearance.
/// Reads the appearance signal, so a caller inside a reactive prop follows
/// a theme switch automatically.
fn pick_by_appearance(lit: string, dim: string) -> string {
    if appearance().get() == 1 {
        return dim
    }
    return lit
}

// ═══════════════════════════════════════════════════════════════════
// Design tokens: scales, elevation, motion, focus, contrast
// ═══════════════════════════════════════════════════════════════════
//
// The flat role list above (`paper`, `plate`, `rule`, …) stays — it is what
// every existing call site uses, and it now *resolves onto* the scales below
// rather than carrying its own hex values. One ramp, two spellings.
//
// A `Scale` is 12 hex strings, indexed 1..12 in the Radix sense described on
// the ROLE enum. Holding them as data rather than as 12 named constants is
// what makes the accent swappable at runtime: `set_accent` re-registers the
// twelve A-slots and the next paint picks them up, with no rebuild and no
// effect runs — the same trick that already makes light/dark free.

struct Scale {
    s1: string, s2: string, s3: string, s4: string, s5: string, s6: string,
    s7: string, s8: string, s9: string, s10: string, s11: string, s12: string,
}

fn scale_at(sc: Scale, step: int) -> string {
    if step <= 1 { return sc.s1 }
    if step == 2 { return sc.s2 }
    if step == 3 { return sc.s3 }
    if step == 4 { return sc.s4 }
    if step == 5 { return sc.s5 }
    if step == 6 { return sc.s6 }
    if step == 7 { return sc.s7 }
    if step == 8 { return sc.s8 }
    if step == 9 { return sc.s9 }
    if step == 10 { return sc.s10 }
    if step == 11 { return sc.s11 }
    return sc.s12
}

/// Neutral ramp, light. Warm stone, not a pure grey. Step 1 is the white
/// card; the page sits on step 2 (`#f7f6f3`). The hairline (`rule` = 6) is
/// `#e4e2dc`. Text is step 12 (`#1f1d1a`).
const NEUTRAL_L: Scale = Scale(
    s1 = "#ffffff", s2 = "#f7f6f3", s3 = "#f1efe9", s4 = "#ece9e2",
    s5 = "#e7e4dc", s6 = "#e4e2dc", s7 = "#cfcabf", s8 = "#a8a294",
    s9 = "#7d786e", s10 = "#5c574f", s11 = "#3d3933", s12 = "#1f1d1a"
)

/// Neutral ramp, dark. Warm stone, not the light ramp reversed: steps 1–5
/// stay tight so a card still separates from the page, and 11–12 stay apart
/// as text. The page is step 1 (`#121110`), cards are step 3 (`#1b1a18`),
/// text is step 12 (`#ecebe7`).
const NEUTRAL_D: Scale = Scale(
    s1 = "#121110", s2 = "#171614", s3 = "#1b1a18", s4 = "#242220",
    s5 = "#2e2b27", s6 = "#3c3833", s7 = "#564f48", s8 = "#736c63",
    s9 = "#948c82", s10 = "#b7aea3", s11 = "#d4cdc4", s12 = "#ecebe7"
)

// --- accent ramps ---------------------------------------------------------
// Step 9 is the solid a primary button paints; 1–8 are tints over the page,
// 10 is the pressed solid, 11–12 are inks. Step 11 clears AA on steps 1–3.
// Ink, Graphite, and Stone stay grey. Ocean, Forest, and Terracotta are the
// natural hues. The solids differ in both appearances, and so do the soft
// steps (s3), so a nested accent scope still swaps.

/// Ink — the default. Near-black in light, near-white in dark, so a primary
/// button is a solid rectangle of the page's own ink. Step 11 clears AA on
/// steps 1–3; `best_on` picks the opposite ink for step 9.
const ACCENT_INK_L: Scale = Scale(
    s1 = "#fafafa", s2 = "#f5f5f5", s3 = "#f0f0f0", s4 = "#e6e6e6",
    s5 = "#d4d4d4", s6 = "#a3a3a3", s7 = "#737373", s8 = "#404040",
    s9 = "#171717", s10 = "#0a0a0a", s11 = "#2e2e2e", s12 = "#0a0a0a"
)
const ACCENT_INK_D: Scale = Scale(
    s1 = "#0c0c0c", s2 = "#121212", s3 = "#1a1a1a", s4 = "#222222",
    s5 = "#2c2c2c", s6 = "#3a3a3a", s7 = "#525252", s8 = "#737373",
    s9 = "#f5f5f5", s10 = "#ffffff", s11 = "#e8e8e8", s12 = "#fafafa"
)

/// Graphite — a mid charcoal. Lighter than ink in light (`#404040`), softer
/// than ink in dark (`#d4d4d4`). Step 11 still clears AA on steps 1–3.
const ACCENT_GRAPHITE_L: Scale = Scale(
    s1 = "#fafafa", s2 = "#f5f5f5", s3 = "#ececec", s4 = "#e2e2e2",
    s5 = "#d0d0d0", s6 = "#b4b4b4", s7 = "#8f8f8f", s8 = "#5c5c5c",
    s9 = "#404040", s10 = "#303030", s11 = "#262626", s12 = "#141414"
)
const ACCENT_GRAPHITE_D: Scale = Scale(
    s1 = "#0e0e0e", s2 = "#141414", s3 = "#222222", s4 = "#2a2a2a",
    s5 = "#343434", s6 = "#424242", s7 = "#555555", s8 = "#737373",
    s9 = "#d4d4d4", s10 = "#e2e2e2", s11 = "#ececec", s12 = "#f7f7f7"
)

/// Stone — the lightest solid in light (`#525252`) and the darkest solid in
/// dark (`#b0b0b0`). `best_on` still clears the component contrast bar.
const ACCENT_STONE_L: Scale = Scale(
    s1 = "#fafafa", s2 = "#f4f4f4", s3 = "#e4e4e4", s4 = "#d6d6d6",
    s5 = "#c4c4c4", s6 = "#a8a8a8", s7 = "#8a8a8a", s8 = "#6a6a6a",
    s9 = "#525252", s10 = "#404040", s11 = "#333333", s12 = "#1a1a1a"
)
const ACCENT_STONE_D: Scale = Scale(
    s1 = "#101010", s2 = "#181818", s3 = "#2c2c2c", s4 = "#363636",
    s5 = "#424242", s6 = "#525252", s7 = "#666666", s8 = "#808080",
    s9 = "#b0b0b0", s10 = "#c4c4c4", s11 = "#e0e0e0", s12 = "#f5f5f5"
)

/// Ocean — a lake blue. Step 9 is the solid; step 11 clears AA on steps 1–3.
const ACCENT_OCEAN_L: Scale = Scale(
    s1 = "#f5f9fc", s2 = "#ecf3f9", s3 = "#e0ecf5", s4 = "#cfe2f0",
    s5 = "#b2d0e6", s6 = "#91bbdc", s7 = "#6aa4cf", s8 = "#3f89c1",
    s9 = "#0f6cb2", s10 = "#0c568d", s11 = "#0c456e", s12 = "#072c48"
)
const ACCENT_OCEAN_D: Scale = Scale(
    s1 = "#1a2126", s2 = "#1e2a33", s3 = "#243744", s4 = "#2c4759",
    s5 = "#355a73", s6 = "#3e6d8d", s7 = "#4983ac", s8 = "#78bdec",
    s9 = "#5eb0e8", s10 = "#82c2ee", s11 = "#c5e4fa", s12 = "#d9edfc"
)

/// Forest — a leaf green. Step 9 is the solid; step 11 clears AA on steps 1–3.
const ACCENT_FOREST_L: Scale = Scale(
    s1 = "#f6faf7", s2 = "#edf4ef", s3 = "#e1eee5", s4 = "#d1e4d6",
    s5 = "#b6d4be", s6 = "#96c2a2", s7 = "#72ad81", s8 = "#49955d",
    s9 = "#1b7a34", s10 = "#16612a", s11 = "#14562a", s12 = "#0c3318"
)
const ACCENT_FOREST_D: Scale = Scale(
    s1 = "#1a221a", s2 = "#1e2d20", s3 = "#243b28", s4 = "#2c4c32",
    s5 = "#34613e", s6 = "#3e754a", s7 = "#488e58", s8 = "#78ca8c",
    s9 = "#5dbe74", s10 = "#82d095", s11 = "#c8f0d2", s12 = "#dbf5e2"
)

/// Terracotta — a fired-earth red. Step 9 is the solid; step 11 clears AA
/// on steps 1–3.
const ACCENT_TERRA_L: Scale = Scale(
    s1 = "#fcf7f6", s2 = "#f9f0ed", s3 = "#f6e7e2", s4 = "#f1d9d2",
    s5 = "#e8c3b7", s6 = "#dea998", s7 = "#d38a74", s8 = "#c6694c",
    s9 = "#b8431f", s10 = "#983618", s11 = "#8a3016", s12 = "#5c1e0c"
)
const ACCENT_TERRA_D: Scale = Scale(
    s1 = "#281d18", s2 = "#36241d", s3 = "#472e24", s4 = "#5d3a2c",
    s5 = "#784936", s6 = "#935740", s7 = "#b2684b", s8 = "#f49c7a",
    s9 = "#f08a62", s10 = "#f5a384", s11 = "#ffd2c2", s12 = "#ffe2d7"
)

/// Accent choices, in picker order. `set_accent` takes one of these.
enum ACCENT {
    Ink = 0,
    Graphite = 1,
    Stone = 2,
    Ocean = 3,
    Forest = 4,
    Terracotta = 5,
}

fn accent_scale_light(which: int) -> Scale {
    if which == ACCENT.Graphite { return ACCENT_GRAPHITE_L }
    if which == ACCENT.Stone { return ACCENT_STONE_L }
    if which == ACCENT.Ocean { return ACCENT_OCEAN_L }
    if which == ACCENT.Forest { return ACCENT_FOREST_L }
    if which == ACCENT.Terracotta { return ACCENT_TERRA_L }
    return ACCENT_INK_L
}

fn accent_scale_dark(which: int) -> Scale {
    if which == ACCENT.Graphite { return ACCENT_GRAPHITE_D }
    if which == ACCENT.Stone { return ACCENT_STONE_D }
    if which == ACCENT.Ocean { return ACCENT_OCEAN_D }
    if which == ACCENT.Forest { return ACCENT_FOREST_D }
    if which == ACCENT.Terracotta { return ACCENT_TERRA_D }
    return ACCENT_INK_D
}

/// Display name, for the gallery's accent picker.
fn accent_name(which: int) -> string {
    if which == ACCENT.Graphite { return "Graphite" }
    if which == ACCENT.Stone { return "Stone" }
    if which == ACCENT.Ocean { return "Ocean" }
    if which == ACCENT.Forest { return "Forest" }
    if which == ACCENT.Terracotta { return "Terracotta" }
    return "Ink"
}

fn accent_count() -> int {
    return 6
}

// --- semantic tiers -------------------------------------------------------
// Five slots each: wash, border, solid, solid hover, ink. The hues are
// leaf, sunflower, poppy, and lake. Each ink clears 4.5:1 on the page and
// on its own wash. Ok, danger, and info solids take white text. The
// sunflower solid takes near-black, in both appearances.

struct Tier {
    bg: string,
    line: string,
    fill: string,
    fill_hover: string,
    ink: string,
}

const OK_L: Tier = Tier(bg = "#e7f5e4", line = "#a8d4a4", fill = "#1c7a34",
                        fill_hover = "#17692c", ink = "#14632a")
const OK_D: Tier = Tier(bg = "#132218", line = "#2d5a38", fill = "#1c7a34",
                        fill_hover = "#17692c", ink = "#8fd9a0")
const WARN_L: Tier = Tier(bg = "#fbf4df", line = "#ead7a0", fill = "#e6b422",
                          fill_hover = "#d4a41a", ink = "#7a4808")
const WARN_D: Tier = Tier(bg = "#2a2212", line = "#6a5420", fill = "#e6b422",
                          fill_hover = "#d4a41a", ink = "#f0d48a")
const DANGER_L: Tier = Tier(bg = "#fbecee", line = "#f0c4c6", fill = "#d1252e",
                            fill_hover = "#b81f28", ink = "#9b1c24")
const DANGER_D: Tier = Tier(bg = "#2a1416", line = "#6a3034", fill = "#d1252e",
                            fill_hover = "#b81f28", ink = "#f3b4b4")
const INFO_L: Tier = Tier(bg = "#e7f2f8", line = "#c5dced", fill = "#1a6fa5",
                          fill_hover = "#155e8e", ink = "#0f5680")
const INFO_D: Tier = Tier(bg = "#121c24", line = "#2a4558", fill = "#1a6fa5",
                          fill_hover = "#155e8e", ink = "#b7d7ee")

// --- contrast -------------------------------------------------------------
// WCAG relative luminance, so a picker can choose an ink that actually
// passes rather than assuming white.
//
// The sRGB transfer curve needs `x^2.4`, which the tree has no `pow` for.
// It also never needs it in general: a channel is always one of 256 values,
// so the curve is a table. Exact, allocation-free, and no iteration that can
// fail to converge — an earlier Newton-iteration version of this silently
// returned garbage for mid-tones, which is exactly the kind of bug a
// contrast checker must not have.

/// sRGB 8-bit channel → linear light, ×100000.
const SRGB_LIN: []int = []int {
    0, 30, 61, 91, 121, 152, 182, 212,
    243, 273, 304, 335, 368, 402, 439, 478,
    518, 561, 605, 651, 700, 750, 802, 857,
    913, 972, 1033, 1096, 1161, 1229, 1298, 1370,
    1444, 1521, 1600, 1681, 1764, 1850, 1938, 2029,
    2122, 2217, 2315, 2416, 2519, 2624, 2732, 2843,
    2956, 3071, 3190, 3310, 3434, 3560, 3689, 3820,
    3955, 4092, 4231, 4374, 4519, 4667, 4817, 4971,
    5127, 5286, 5448, 5613, 5781, 5951, 6125, 6301,
    6480, 6663, 6848, 7036, 7227, 7421, 7619, 7819,
    8022, 8228, 8438, 8650, 8866, 9084, 9306, 9531,
    9759, 9990, 10224, 10462, 10702, 10946, 11193, 11444,
    11697, 11954, 12214, 12477, 12744, 13014, 13287, 13563,
    13843, 14126, 14413, 14703, 14996, 15293, 15593, 15896,
    16203, 16513, 16827, 17144, 17465, 17789, 18116, 18447,
    18782, 19120, 19462, 19807, 20156, 20508, 20864, 21223,
    21586, 21953, 22323, 22697, 23074, 23455, 23840, 24228,
    24620, 25016, 25415, 25818, 26225, 26636, 27050, 27468,
    27889, 28315, 28744, 29177, 29614, 30054, 30499, 30947,
    31399, 31855, 32314, 32778, 33245, 33716, 34191, 34670,
    35153, 35640, 36131, 36625, 37124, 37626, 38133, 38643,
    39157, 39676, 40198, 40724, 41254, 41789, 42327, 42869,
    43415, 43966, 44520, 45079, 45641, 46208, 46778, 47353,
    47932, 48515, 49102, 49693, 50289, 50888, 51492, 52100,
    52712, 53328, 53948, 54572, 55201, 55834, 56471, 57112,
    57758, 58408, 59062, 59720, 60383, 61050, 61721, 62396,
    63076, 63760, 64448, 65141, 65837, 66539, 67244, 67954,
    68669, 69387, 70110, 70838, 71569, 72306, 73046, 73791,
    74540, 75294, 76052, 76815, 77582, 78354, 79130, 79910,
    80695, 81485, 82279, 83077, 83880, 84687, 85499, 86316,
    87137, 87962, 88792, 89627, 90466, 91310, 92158, 93011,
    93869, 94731, 95597, 96469, 97345, 98225, 99110, 100000,
}

/// WCAG relative luminance of a packed rgb, ×100000.
fn luminance(rgb: int) -> int {
    let r = SRGB_LIN[(rgb / 65536) % 256]
    let g = SRGB_LIN[(rgb / 256) % 256]
    let b = SRGB_LIN[rgb % 256]
    return (2126 * r + 7152 * g + 722 * b) / 10000
}

/// Contrast ratio between two packed rgb colors, ×100 (so 4.5:1 is 450).
fn contrast_ratio(a: int, b: int) -> int {
    let la = luminance(a)
    let lb = luminance(b)
    let mut hi = la
    let mut lo = lb
    if lb > la {
        hi = lb
        lo = la
    }
    // WCAG adds 0.05 to each term; luminance is ×100000, so that is 5000.
    return (hi + 5000) * 100 / (lo + 5000)
}

/// 1 when `fg` on `bg` clears WCAG AA for body text (4.5:1).
fn meets_aa(fg: int, bg: int) -> int {
    if contrast_ratio(fg, bg) >= 450 {
        return 1
    }
    return 0
}

/// 1 when `fg` on `bg` clears AA for large text / UI components (3:1).
fn meets_aa_large(fg: int, bg: int) -> int {
    if contrast_ratio(fg, bg) >= 300 {
        return 1
    }
    return 0
}

/// The ink — near-black or near-white — that reads best on `bg`. A light fill
/// gets near-black text; a dark fill gets white.
fn best_on(bg: int) -> int {
    let dark = parse_hex_color("#18181b")
    let light = parse_hex_color("#ffffff")
    if contrast_ratio(dark, bg) >= contrast_ratio(light, bg) {
        return dark
    }
    return light
}

// --- the live accent ------------------------------------------------------
/// Ink. `set_accent` replaces it; the other ramps stay available.
let mut accent_which: int = 0

/// The accent in effect. Changing it re-registers the twelve A-slots, so the
/// next paint picks up the new ramp with no rebuild and no effect runs — the
/// same paint-time resolution that makes the light/dark switch free.
fn accent_choice() -> int {
    return accent_which
}

fn set_accent(which: int) {
    ensure_role_colors()
    let mut w = which
    if w < 0 {
        w = 0
    }
    if w >= accent_count() {
        w = accent_count() - 1
    }
    accent_which = w
    register_accent()
}

fn register_scale(base: int, light: Scale, dark: Scale) {
    for i in 0..12 {
        theme(base + i, parse_hex_color(scale_at(light, i + 1)),
              parse_hex_color(scale_at(dark, i + 1)))
    }
}

fn register_tier(base: int, light: Tier, dark: Tier) {
    theme(base + 0, parse_hex_color(light.bg), parse_hex_color(dark.bg))
    theme(base + 1, parse_hex_color(light.line), parse_hex_color(dark.line))
    theme(base + 2, parse_hex_color(light.fill), parse_hex_color(dark.fill))
    theme(base + 3, parse_hex_color(light.fill_hover), parse_hex_color(dark.fill_hover))
    theme(base + 4, parse_hex_color(light.ink), parse_hex_color(dark.ink))
}

/// The role palette `Scope(accent = which)` paints with: the same roles
/// `register_accent` sets app-wide, built once per accent.
let mut accent_pals: []int = []int {}

fn accent_palette(which: int) -> int {
    if which < 0 || which >= accent_count() {
        return 0
    }
    while accent_pals.len < accent_count() {
        push(accent_pals, 0)
    }
    if accent_pals[which] > 0 {
        return accent_pals[which]
    }
    let al = accent_scale_light(which)
    let ad = accent_scale_dark(which)
    let p = palette_new()
    for i in 0..12 {
        palette_role(p, ROLE.A1 + i, parse_hex_color(scale_at(al, i + 1)),
                     parse_hex_color(scale_at(ad, i + 1)))
    }
    let on_l = best_on(parse_hex_color(al.s9))
    let on_d = best_on(parse_hex_color(ad.s9))
    palette_role(p, ROLE.OnAccent, on_l, on_d)
    palette_role(p, ROLE.Accent, parse_hex_color(al.s9), parse_hex_color(ad.s9))
    palette_role(p, ROLE.AccentSoft, parse_hex_color(al.s3), parse_hex_color(ad.s3))
    palette_role(p, ROLE.OnInk, on_l, on_d)
    accent_pals[which] = p
    return p
}

fn register_accent() {
    let al = accent_scale_light(accent_which)
    let ad = accent_scale_dark(accent_which)
    register_scale(ROLE.A1, al, ad)
    // Text on the accent's solid step, chosen by contrast rather than
    // assumed. A light solid gets near-black ink; a dark solid gets white.
    theme(ROLE.OnAccent, best_on(parse_hex_color(al.s9)),
          best_on(parse_hex_color(ad.s9)))
    // The flat `accent` role tracks the ramp's solid step, so every existing
    // `accent()` call site follows the picker with no change.
    theme(ROLE.Accent, parse_hex_color(al.s9), parse_hex_color(ad.s9))
    theme(ROLE.AccentSoft, parse_hex_color(al.s3), parse_hex_color(ad.s3))
    theme(ROLE.OnInk, best_on(parse_hex_color(al.s9)), best_on(parse_hex_color(ad.s9)))
}

// --- scale accessors ------------------------------------------------------
/// `step` held to the 1..12 ramp.
fn ramp_step(step: int) -> int {
    if step < 1 {
        return 1
    }
    if step > 12 {
        return 12
    }
    return step
}

/// Neutral ramp step 1..12 as a role token (see the ROLE enum for what each
/// step means).
fn n(step: int) -> string {
    return role_token(ROLE.N1 + ramp_step(step) - 1)
}

/// Accent ramp step 1..12 as a role token. Follows `set_accent`.
fn ac(step: int) -> string {
    return role_token(ROLE.A1 + ramp_step(step) - 1)
}

/// Wash / border / ink for a `Tint`, so a widget takes one token and gets a
/// consistent tier instead of picking three colours by hand.
fn tint_bg(kind: int) -> string {
    if kind == Tint.Ok { return ok_bg() }
    if kind == Tint.Warn { return warn_bg() }
    if kind == Tint.Danger { return danger_bg() }
    if kind == Tint.Info { return info_bg() }
    return n(3)
}

fn tint_line(kind: int) -> string {
    if kind == Tint.Ok { return ok_line() }
    if kind == Tint.Warn { return warn_line() }
    if kind == Tint.Danger { return danger_line() }
    if kind == Tint.Info { return info_line() }
    return n(6)
}

fn tint_ink(kind: int) -> string {
    if kind == Tint.Ok { return ok_ink() }
    if kind == Tint.Warn { return warn_ink() }
    if kind == Tint.Danger { return danger_ink() }
    if kind == Tint.Info { return info_ink() }
    if kind == Tint.Mute { return n(11) }
    if kind == Tint.Dim { return n(10) }
    return n(12)
}

/// Register every theme role once, before the first paint: the palette roles,
/// the neutral / status / accent ramps, and the flat roles bound onto them.
fn ensure_role_colors() {
    if roles_ready != 0 {
        return
    }
    roles_ready = 1
    set_accent_palette_hook(accent_palette)
    // Palette-derived roles the neutral ramp below does not cover: the accent,
    // the chart / fill series, the scrim, and the ink that sits on a solid fill.
    // Everything the ramp does cover — surfaces, text, rules, and the status
    // tiers — is set exactly once, further down, so each role has one source of
    // truth rather than a first-pass value that a second pass overwrites.
    theme(ROLE.OnInk, parse_hex_color(LIGHT.on_solid), parse_hex_color(DARK.on_solid))
    theme(ROLE.Accent, parse_hex_color(LIGHT.accent), parse_hex_color(DARK.accent))
    theme(ROLE.AccentSoft, parse_hex_color(LIGHT.accent_soft), parse_hex_color(DARK.accent_soft))
    theme(ROLE.OnFill, parse_hex_color(LIGHT.on_fill), parse_hex_color(DARK.on_fill))
    theme(ROLE.Scrim, parse_hex_color(LIGHT.scrim), parse_hex_color(DARK.scrim))
    theme(ROLE.ChartEdge, parse_hex_color(LIGHT.chart_edge), parse_hex_color(DARK.chart_edge))
    theme(ROLE.Chart1, parse_hex_color(LIGHT.chart1), parse_hex_color(DARK.chart1))
    theme(ROLE.Chart2, parse_hex_color(LIGHT.chart2), parse_hex_color(DARK.chart2))
    theme(ROLE.Chart3, parse_hex_color(LIGHT.chart3), parse_hex_color(DARK.chart3))
    theme(ROLE.Chart4, parse_hex_color(LIGHT.chart4), parse_hex_color(DARK.chart4))
    theme(ROLE.Chart5, parse_hex_color(LIGHT.chart5), parse_hex_color(DARK.chart5))
    theme(ROLE.Fill1, parse_hex_color(LIGHT.fill1), parse_hex_color(DARK.fill1))
    theme(ROLE.Fill2, parse_hex_color(LIGHT.fill2), parse_hex_color(DARK.fill2))
    theme(ROLE.Fill3, parse_hex_color(LIGHT.fill3), parse_hex_color(DARK.fill3))
    theme(ROLE.Fill4, parse_hex_color(LIGHT.fill4), parse_hex_color(DARK.fill4))
    theme(ROLE.Fill5, parse_hex_color(LIGHT.fill5), parse_hex_color(DARK.fill5))

    // --- scales, then the flat roles rebound onto them ---
    register_scale(ROLE.N1, NEUTRAL_L, NEUTRAL_D)
    register_tier(ROLE.OkS3, OK_L, OK_D)
    register_tier(ROLE.WarnS3, WARN_L, WARN_D)
    register_tier(ROLE.DangerS3, DANGER_L, DANGER_D)
    register_tier(ROLE.InfoS3, INFO_L, INFO_D)
    theme(ROLE.OnOk, best_on(parse_hex_color(OK_L.fill)), best_on(parse_hex_color(OK_D.fill)))
    theme(ROLE.OnWarn, best_on(parse_hex_color(WARN_L.fill)), best_on(parse_hex_color(WARN_D.fill)))
    theme(ROLE.OnDanger, best_on(parse_hex_color(DANGER_L.fill)), best_on(parse_hex_color(DANGER_D.fill)))
    theme(ROLE.OnInfo, best_on(parse_hex_color(INFO_L.fill)), best_on(parse_hex_color(INFO_D.fill)))
    // Shadows are true black in both appearances. A tinted shadow reads as a
    // second colour. Themed surfaces stay flat; a caller can still set elevation.
    theme(ROLE.Shadow, parse_hex_color("#000000"), parse_hex_color("#000000"))
    register_accent()

    // The flat role names every existing call site uses now resolve onto the
    // neutral ramp, so there is one source of truth for the chrome. The
    // mapping is where the audit's contrast finding is fixed: `dim` was
    // `#a9b2bc`, which is 2.15:1 on white and failed AA everywhere it was
    // used for captions and placeholders. It is now step 10 (7.2:1 on white)
    // and `mute` is step 11 (11.5:1); both clear AA on steps 1-3.
    // Light: a warm page (2) under white cards (1). Dark: the page is the
    // deepest step and cards rise two steps above it.
    theme(ROLE.Paper, parse_hex_color(NEUTRAL_L.s2), parse_hex_color(NEUTRAL_D.s1))
    theme(ROLE.Plate, parse_hex_color(NEUTRAL_L.s1), parse_hex_color(NEUTRAL_D.s3))
    theme(ROLE.Raised, parse_hex_color(NEUTRAL_L.s3), parse_hex_color(NEUTRAL_D.s4))
    theme(ROLE.Wash, parse_hex_color(NEUTRAL_L.s2), parse_hex_color(NEUTRAL_D.s2))
    theme(ROLE.Rule, parse_hex_color(NEUTRAL_L.s6), parse_hex_color(NEUTRAL_D.s6))
    theme(ROLE.Hard, parse_hex_color(NEUTRAL_L.s8), parse_hex_color(NEUTRAL_D.s8))
    theme(ROLE.Ink, parse_hex_color(NEUTRAL_L.s12), parse_hex_color(NEUTRAL_D.s12))
    theme(ROLE.Mute, parse_hex_color(NEUTRAL_L.s11), parse_hex_color(NEUTRAL_D.s11))
    theme(ROLE.Dim, parse_hex_color(NEUTRAL_L.s10), parse_hex_color(NEUTRAL_D.s10))
    theme(ROLE.Bone, parse_hex_color(NEUTRAL_L.s4), parse_hex_color(NEUTRAL_D.s4))
    theme(ROLE.FocusRing, parse_hex_color(NEUTRAL_L.s12), parse_hex_color(NEUTRAL_D.s12))
    // Status roles follow their tier, so `danger()` and `danger_ink()` can
    // never drift apart.
    theme(ROLE.Ok, parse_hex_color(OK_L.ink), parse_hex_color(OK_D.ink))
    theme(ROLE.OkFill, parse_hex_color(OK_L.bg), parse_hex_color(OK_D.bg))
    theme(ROLE.OkSolid, parse_hex_color(OK_L.fill), parse_hex_color(OK_D.fill))
    theme(ROLE.Warn, parse_hex_color(WARN_L.ink), parse_hex_color(WARN_D.ink))
    theme(ROLE.WarnFill, parse_hex_color(WARN_L.bg), parse_hex_color(WARN_D.bg))
    theme(ROLE.WarnEdge, parse_hex_color(WARN_L.line), parse_hex_color(WARN_D.line))
    theme(ROLE.Danger, parse_hex_color(DANGER_L.ink), parse_hex_color(DANGER_D.ink))
    theme(ROLE.DangerSolid, parse_hex_color(DANGER_L.fill), parse_hex_color(DANGER_D.fill))
    theme(ROLE.DangerEdge, parse_hex_color(DANGER_L.line), parse_hex_color(DANGER_D.line))
}

/// Every (ink, surface) pair the design system can produce, checked against
/// WCAG AA and reported as `pass`/`FAIL` lines. This is the §2 contrast
/// requirement made executable rather than asserted in prose — the in-language
/// test runs it for both appearances and fails on any `FAIL`.
fn tokens_contrast_report() -> string {
    ensure_role_colors()
    let mut out = ""
    let dark = appearance().get()
    let mut surfaces = []int {}
    let mut snames = []string {}
    push(surfaces, role_rgb_now(ROLE.N1))
    push(snames, "n1")
    push(surfaces, role_rgb_now(ROLE.N2))
    push(snames, "n2")
    push(surfaces, role_rgb_now(ROLE.N3))
    push(snames, "n3")

    let mut inks = []int {}
    let mut inames = []string {}
    push(inks, role_rgb_now(ROLE.N11))
    push(inames, "n11")
    push(inks, role_rgb_now(ROLE.N12))
    push(inames, "n12")
    push(inks, role_rgb_now(ROLE.OkS11))
    push(inames, "ok_ink")
    push(inks, role_rgb_now(ROLE.WarnS11))
    push(inames, "warn_ink")
    push(inks, role_rgb_now(ROLE.DangerS11))
    push(inames, "danger_ink")
    push(inks, role_rgb_now(ROLE.InfoS11))
    push(inames, "info_ink")
    push(inks, role_rgb_now(ROLE.A11))
    push(inames, "a11")

    for si in 0..surfaces.len {
        for ii in 0..inks.len {
            let r = contrast_ratio(inks[ii], surfaces[si])
            let mut verdict = "pass"
            if r < 450 {
                verdict = "FAIL"
            }
            out = "{{out}}{{inames[ii]}} on {{snames[si]}}: {{r}} {{verdict}}\n"
        }
    }
    // Text drawn on a solid fill: the accent's own ink, and white on each
    // semantic solid.
    let pairs_fg = []int {
        role_rgb_now(ROLE.OnAccent), role_rgb_now(ROLE.OnOk),
        role_rgb_now(ROLE.OnWarn), role_rgb_now(ROLE.OnDanger),
        role_rgb_now(ROLE.OnInfo),
    }
    let pairs_bg = []int {
        role_rgb_now(ROLE.A9), role_rgb_now(ROLE.OkS9),
        role_rgb_now(ROLE.WarnS9), role_rgb_now(ROLE.DangerS9),
        role_rgb_now(ROLE.InfoS9),
    }
    let pair_names = []string {
        "on_accent/a9", "on_ok/ok_s9", "on_warn/warn_s9",
        "on_danger/danger_s9", "on_info/info_s9",
    }
    for i in 0..pairs_fg.len {
        let r = contrast_ratio(pairs_fg[i], pairs_bg[i])
        // Text on a solid control fill is UI text on a component: AA's 3:1
        // component threshold is the one that applies, not body text's 4.5:1.
        let mut verdict = "pass"
        if r < 300 {
            verdict = "FAIL"
        }
        out = "{{out}}{{pair_names[i]}}: {{r}} {{verdict}}\n"
    }
    return out
}

/// Resolve a role to a packed rgb for the appearance in effect. The paint
/// pass does this per draw; the contrast report needs it up front.
fn role_rgb_now(slot: int) -> int {
    // The roles are registered lazily, and a caller outside the paint path
    // (a test, a contrast check, an accent picker) may be the first to ask.
    ensure_role_colors()
    return paint_rgb(role_color(slot))
}

/// Identity at scale 1.0. `x * 100 / 100 == x` for every non-negative int.
struct Palette {
    bg: string,
    card: string,
    raised: string,
    text: string,
    muted: string,
    faint: string,
    line: string,
    line_strong: string,
    wash: string,
    on_solid: string,
    accent: string,
    accent_soft: string,
    danger: string,
    danger_solid: string,
    success: string,
    success_fill: string,
    /// Warning tint: text, pips, icons (ochre).
    warn: string,
    /// Warning wash (alert fills, soft warning badges).
    warn_fill: string,
    /// Warning border: soft in light, full in dark.
    warn_edge: string,
    /// Destructive border: destructive/50 in light, full in dark.
    danger_edge: string,
    /// Solid success fill for badges and other ok-on-surface marks.
    ok_solid: string,
    /// Text on colored status fills (ok/danger solids) — white in both
    /// appearances.
    on_fill: string,
    /// Modal scrim (behind dialogs and popovers).
    scrim: string,
    /// Tooltip border.
    chart_edge: string,
    /// Series strokes (the default chart palette).
    chart1: string,
    chart2: string,
    chart3: string,
    chart4: string,
    chart5: string,
    /// Per-series area wash, one entry per appearance.
    fill1: string,
    fill2: string,
    fill3: string,
    fill4: string,
    fill5: string,
}

