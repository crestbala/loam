/// Teal — a cooler, lower-chroma accent that stays legible on dense data.
const ACCENT_TEAL_L: Scale = Scale(
    s1 = "#fafefd", s2 = "#f1fcfa", s3 = "#e0f8f4", s4 = "#cdf2ec",
    s5 = "#b7e9e1", s6 = "#9cddd3", s7 = "#77cdc1", s8 = "#40b6a7",
