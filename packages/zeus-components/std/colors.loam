const ACCENT_BLUE_L: Scale = Scale(
    s1 = "#fbfcfe", s2 = "#f5f8ff", s3 = "#e9f0fe", s4 = "#dbe7fd",
    s5 = "#cbdcfc", s6 = "#b6cdfa", s7 = "#9bbaf7", s8 = "#74a0f2",
    s9 = "#2563eb", s10 = "#1d56d6", s11 = "#1a4ab8", s12 = "#12275c"
)
const ACCENT_BLUE_D: Scale = Scale(
    s1 = "#070b14", s2 = "#0a0f1c", s3 = "#0e1830", s4 = "#111e3e",
    s5 = "#14244c", s6 = "#182d5e", s7 = "#1f3a78", s8 = "#2b4fa3",
    s9 = "#2b6be6", s10 = "#4a87f4", s11 = "#93bbfc", s12 = "#dbe7fd"
)

/// Indigo — a violet-leaning alternative to the default blue.
const ACCENT_INDIGO_L: Scale = Scale(
    s1 = "#fcfcfe", s2 = "#f6f8ff", s3 = "#eceffe", s4 = "#e0e6fd",
    s5 = "#d2dbfc", s6 = "#c0cdfa", s7 = "#a7b9f6", s8 = "#849eef",
