//! molecules — the single-purpose controls: Button, IconButton, the text fields,
//! Checkbox / Radio / Switch / Toggle, Slider, Select / Segmented / Choice, Tabs,
//! Alert, Breadcrumbs, Pagination, User.
//!
//! Built on `atoms` and `zeusbase`.

import "zeus:structs"
import "zeus:enums"
import "zeus:zeusbase"
import "std:result"
import "zeus-components:colors"
import "zeus-components:spacing"
import "zeus:zeus_constants"
import "std:async"
import "std:fmt"
import "zeus-components:atoms"

/// Options for `Button`. Default `look = Look.Solid` (gallery "Primary")
/// paints themed chrome. `look = -1` is a plain clickable label styled by
/// `background` / `color` / `font` / `padding` / `radius` / `width` /
/// `height` / `enabled` (dims when false). `on_click` fires it.
struct ButtonProps {
    /// Label of the Button. A signal; `"n = {{count.get()}}"` is lifted into
    /// one and keeps updating.
    label: Signal<string> = "",
    /// `Look` token for themed chrome; `-1` = raw (props below decide the look).
    look: int = Look.Solid,
    /// `Size` token for themed chrome.
    size: int = Size.Md,
    /// Style, merged over the recipe's own: `style = Style(radius = 4)`.
    style: Option<fn() -> Style> = none,
    /// `enabled = form_valid.get()` dims and disables reactively.
    enabled: bool = true,
    /// `true` silences the gray hover wash.
    /// Set `hoverOff = false` to let the button wash on hover.
    hoverOff: bool = false,
    /// Leading icon markup (`IC_PLUS`, ...). Sized to the `Size` token and
    /// tinted like the label. Themed chrome only.
    icon: string = "",
    /// While true the button is inert (no click, hover, or press), dims, and
    /// a spinner takes the icon slot. Themed chrome only.
    loading: Option<Signal<bool>> = none,
    on_click: Option<fn()> = none,
    /// Keyboard actions on this element (`key_bind(...)`, `key_bind_click(...)`).
    keys: []KeyBind = no_keys(),
}

struct InputProps {
    placeholder: string = "",
    bind: Option<Signal<string>> = none,
    label: Option<Signal<string>> = none,
    /// Multiline: Enter inserts a newline, wrap + caret up/down.
    multiline: bool = false,
    style: Option<fn() -> Style> = none,
    /// The caller's style over `style`; see `BoxProps.restyle`.
    restyle: Option<fn() -> Style> = none,
    /// Mask what the field draws while true.
    secure: Option<Signal<bool>> = none,
    ref: Option<Ref> = none,
    on_click: Option<fn()> = none,
    on_key_down: Option<fn()> = none,
    on_key_up: Option<fn()> = none,
    on_key_press: Option<fn()> = none,
    /// Keyboard actions on this element (`key_bind(...)`, `key_bind_click(...)`).
    keys: []KeyBind = no_keys(),
}

/// Action button. Default `look = Look.Solid`. `look = -1` is a plain label.
fn Button(p: ButtonProps) -> Node {
    if p.look >= 0 {
        return BtnLook(p)
    }
    // A plain clickable label: the caller's style is the whole look.
    return Component(
        raw_button(""),
        text = p.label,
        style = p.style,
        enabled = p.enabled,
        on_click = p.on_click,
        hoverOff = p.hoverOff,
        role = "button",
        label = p.label.get(),
        press = result.is_some(p.on_click),
        hoverFade = !p.hoverOff,
        keys = p.keys,
    )
}

/// Disabled fill for themed chrome: a muted plate instead of the accent at
/// 40% alpha, so a disabled Solid button reads as a control that is off
/// rather than a washed-out one. Outline keeps its ring on `rule()`.
fn button_disabled_background(look: int) -> string {
    switch look {
        case Look.Ghost, Look.Link:
            return ""
        default:
            return raised()
    }
}

/// Text field. `multiline = true` wraps and lets Enter insert a newline.
/// `bind = sig` writes the committed buffer into a `Signal<string>` on every
/// edit; the store notifies only on a real change.
fn Input(p: InputProps) -> Node {
    return Component(
        raw_input(p.placeholder),
        style = p.style,
        restyle = p.restyle,
        secure = p.secure,
        label = p.label,
        multiline = p.multiline,
        role = "textbox",
        edit = p.bind,
        on_key_down = p.on_key_down,
        on_key_up = p.on_key_up,
        on_key_press = p.on_key_press,
        ref = p.ref,
        keys = p.keys,
        on_click = p.on_click,
    )
}

/// Fill for a `Look` token. Returns a theme accessor result, so calling it
/// inside a prop expression keeps the button following the palette.
fn button_background(look: int) -> string {
    switch look {
        case Look.Solid:
            return accent()
        case Look.Soft:
            return raised()
        case Look.Subtle:
            return wash()
        case Look.Outline:
            return plate()
        case Look.Danger:
            return danger_solid()
        case Look.Success:
            return ok_solid()
        default:
            return ""
    }
}

/// Label color for a `Look` token; see `button_background`.
fn button_color(look: int) -> string {
    switch look {
        case Look.Solid:
            return on_ink()
        case Look.Danger:
            return on_danger()
        case Look.Success:
            return on_ok()
        default:
            return ink()
    }
}

/// Border width for a `Look` token — only the outline look carries one.
fn button_border_width(look: int) -> int {
    switch look {
        case Look.Outline:
            return HAIRLINE
        default:
            return 0
    }
}

/// Border color for a `Look` token; see `button_border_width`.
fn button_border_color(look: int) -> string {
    switch look {
        case Look.Outline:
            return rule()
        default:
            return ""
    }
}

/// Icon-only button: a square `control_h(size)` box in the `look` chrome, with
/// a `control_icon(size)` glyph. `on_click` is optional —
/// omit it for a look-only demo
/// (`IconButton(IC_X, Look.Ghost, Size.Md, "Close")`).
struct IconButtonProps {
    on_click: Option<fn()> = none,
    /// Style, merged over the recipe's own: `style = Style(radius = 4)`.
    style: Option<fn() -> Style> = none,
    /// Keyboard actions on this element (`key_bind(...)`, `key_bind_click(...)`).
    keys: []KeyBind = no_keys(),
}

fn IconButton(markup: string, look: int, size: int, label: string, p: IconButtonProps) -> Node {
    return // `hoverFade`: the square stays a hover target without a handler.
    Box(
        style = Style(
            width = px(control_h(size)),
            height = px(control_h(size)),
            direction = Direction.Row,
            align = Align.Center,
            justify = Align.Center,
            radius = RAD_CONTROL,
            borderWidth = button_border_width(look),
            borderColor = opt_color(button_border_color(look)),
            background = opt_color(button_background(look)),
            cursor = "pointer",
        ),
        restyle = p.style,
        on_click = p.on_click,
        role = "button",
        label = label,
        hoverOff = false,
        press = true,
        hoverFade = true,
        keys = p.keys,
    ) {
        Icon(markup, control_icon(size), text_color(style_of(p.style), button_color(look)))
    }
}

/// Options for `Switch`.
struct SwitchProps {
    /// `Size` token: picks the `switch_w` × `switch_h` track.
    size: int = Size.Md,
    /// Dims the track and ignores clicks.
    disabled: bool = false,
    /// Accessible name, for a switch with no visible label beside it.
    label: string = "",
    /// Style, merged over the recipe's own.
    style: Option<fn() -> Style> = none,
}

/// Toggle `on`. Native toggle: off track = input, on track = primary,
/// thumb rides on `background`.
fn Switch(on: Signal<bool>, p: SwitchProps) -> Node {
    // The native thumb tweens off an int signal; `on` is the state.
    return SwitchTrack(
        flag_int(on),
        fn() => on.set(!on.get()),
        p.size,
        p.label,
        !p.disabled,
        p.style,
    )
}

/// The light / dark switch: the native toggle bound to `appearance()` (an
/// engine-level 0/1 signal every role token resolves against at paint). The
/// choice is kept across visits.
fn ThemeSwitch() -> Node {
    let dark = appearance()
    return SwitchTrack(dark, fn() => set_appearance(1 - dark.get()), Size.Md, "Dark mode", true, none)
}

/// The native toggle both switches draw: `bind` is the 0/1 the thumb tweens
/// off, `flip` writes the caller's state.
fn SwitchTrack(
    bind: Signal<int>,
    flip: fn(),
    size: int,
    label: string,
    enabled: bool,
    style: Option<fn() -> Style>
) -> Node {
    return Component(
        raw_toggle(),
        bind = bind,
        style = Style(
            width = px(switch_w(size)),
            height = px(switch_h(size)),
            radius = RAD_FULL,
            cursor = "pointer",
        ),
        restyle = style,
        enabled = enabled,
        on_click = flip,
        role = "switch",
        label = label,
        hoverOff = true,
    )
}

/// Options for `Slider`.
struct SliderProps {
    /// Range and step of `value`. The defaults (0..100 by 1) bind the native
    /// track directly; anything else maps it onto the range.
    min: int = 0,
    max: int = 100,
    step: int = 1,
    disabled: bool = false,
    /// Accessible name.
    label: string = "",
    /// Style, merged over the recipe's own (`width = px(220)` pins it).
    style: Option<fn() -> Style> = none,
    /// Extra keyboard actions, installed ahead of the slider's own, so a binding
    /// on the same action replaces it: `slider.inc` / `slider.dec` take over
    /// the native left / right, `slider.up` / `slider.down` the arrows below.
    keys: []KeyBind = no_keys(),
}

/// Slider over `min..max` (0..100 by default); fills its parent's width. Track is `primary/20`-ish, filled range primary, thumb
/// surface. Keys follow the ARIA slider: the arrows step 1 (the native node
/// binds left / right; up / down are added here), Page Up / Page Down step
/// 10, and Home / End jump to the ends.
fn Slider(value: Signal<int>, p: SliderProps) -> Node {
    // state. The native track runs 0..100; `pos` is that track when the
    // caller's range differs, kept in step with `value` both ways.
    let lo = p.min
    let hi = if p.max > p.min { p.max } else { p.min + 1 }
    let step = if p.step > 0 { p.step } else { 1 }
    let direct = lo == 0 && hi == 100 && step == 1
    let pos = if direct { value } else { signal(slider_pos(value.get(), lo, hi)) }
    if !direct {
        effect(|| { pos.set(slider_pos(value.get(), lo, hi)) })
        // A track move that lands on the same snapped value still moves one
        // step its way, so the native arrows (±1%) never stick on a coarse step.
        effect(|| {
            let at = pos.get()
            let v = peek(value)
            if at != slider_pos(v, lo, hi) {
                let mut next = slider_snap(lo + (at * (hi - lo) + 50) / 100, lo, hi, step)
                if next == v {
                    next = slider_snap(
                        if at > slider_pos(v, lo, hi) { v + step } else { v - step },
                        lo,
                        hi,
                        step,
                    )
                }
                value.set(next)
            }
        })
    }

    // controller
    fn nudge(d: int) {
        value.set(slider_snap(value.get() + d, lo, hi, step))
    }
    let page = slider_snap(lo + (hi - lo) / 10, lo, hi, step) - lo

    // keys
    let keys = []KeyBind {
        key_bind("up", "slider.up", fn() { nudge(step) }),
        key_bind("down", "slider.down", fn() { nudge(-step) }),
        key_bind("pageup", "slider.page_up", fn() { nudge(if page > step { page } else { step }) }),
        key_bind("pagedown", "slider.page_down", fn() {
            nudge(-(if page > step { page } else { step }))
        }),
        key_bind("home", "slider.min", fn() { value.set(lo) }),
        key_bind("end", "slider.max", fn() { value.set(slider_snap(hi, lo, hi, step)) }),
    }

    // view
    return Component(
        raw_slider(),
        bind = pos,
        // Fills a column; `grow` takes the free width in a row,
        // where a bare 100% would be the (empty) content width.
        style = Style(width = pct(100), grow = 1, height = px(20), radius = 1, cursor = "pointer"),
        restyle = p.style,
        role = "slider",
        label = p.label,
        enabled = !p.disabled,
        keys = keys_concat(p.keys, keys),
        hoverOff = true,
    )
}

/// Native track position (0..100) of `v` in `lo..hi`.
fn slider_pos(v: int, lo: int, hi: int) -> int {
    return clamp_int((v - lo) * 100 / (hi - lo), 0, 100)
}

fn clamp_int(v: int, lo: int, hi: int) -> int {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

/// `v` clamped to `lo..hi` and rounded to the nearest `step` from `lo`.
fn slider_snap(v: int, lo: int, hi: int, step: int) -> int {
    let c = clamp_int(v, lo, hi)
    let k = (c - lo + step / 2) / step
    let out = lo + k * step
    if out > hi {
        return out - step
    }
    return out
}

/// Alert: rounded bordered panel, leading icon, title + description.
/// `tint` picks the tier (`Tint.Info` default, `.Ok`, `.Warn`, `.Danger`).
/// `dismiss` is a show signal (X sets it false). Trailing block is the action slot,
/// under the body.
struct AlertProps {
    /// Style, merged over the recipe's own: `style = Style(radius = 4)`.
    style: Option<fn() -> Style> = none,
    /// Status tier: `Tint.Info` (default), `Tint.Ok`, `Tint.Warn`, `Tint.Danger`.
    tint: int = Tint.Info,
    /// Deprecated spelling of `tint` (a `Tone` code); wins when set.
    tone: int = -1,
    /// Show signal. When passed, the alert hides while it is false, and an X
    /// in the title row sets it false.
    dismiss: Option<Signal<bool>> = none,
    /// Keyboard actions on this element (`key_bind(...)`, `key_bind_click(...)`).
    keys: []KeyBind = no_keys(),
    /// The trailing block: actions, under the body.
    children: fn() = noop,
}

fn Alert(title: Signal<string>, body: Signal<string>, p: AlertProps) -> Node {
    return AlertView(title, body, if p.tone >= 0 { tone_tint(p.tone) } else { p.tint }, p)
}

fn alert_edge(kind: int) -> string {
    switch kind {
        case Tint.Danger:
            return danger_edge()
        case Tint.Warn:
            return warn_edge()
        case Tint.Ok:
            return ok()
        default:
            return info_line()
    }
}

fn alert_title_tint(kind: int) -> string {
    switch kind {
        case Tint.Danger:
            return danger()
        case Tint.Warn:
            return warn()
        case Tint.Ok:
            return ok()
        default:
            return info_ink()
    }
}

fn alert_body_tint(kind: int) -> string {
    switch kind {
        case Tint.Danger:
            return danger()
        case Tint.Ok:
            return ok()
        default:
            return mute()
    }
}

fn alert_icon(kind: int) {
    switch kind {
        case Tint.Danger:
            Icon(IC_ALERT_CIRCLE, 16, danger())
        case Tint.Warn:
            Icon(IC_ALERT_CIRCLE, 16, warn())
        case Tint.Ok:
            Icon(IC_CHECK, 16, ok())
        default:
            Icon(IC_INFO, 16, info_ink())
    }
}

fn AlertView(title: Signal<string>, body: Signal<string>, kind: int, p: AlertProps) -> Node {
    let dismissable = result.is_some(p.dismiss)
    let open = result.some_or(p.dismiss, no_flag_signal())
    return Box(
        style = Style(
            direction = Direction.Row,
            gap = Space.Xs,
            align = Align.Start,
            paddingY = Space.Xs,
            paddingX = Space.Sm,
            radius = RAD_LG,
            borderWidth = HAIRLINE,
            borderColor = alert_edge(kind),
            background = plate(),
        ),
        restyle = p.style,
        role = "alert",
        visible = !dismissable || open.get(),
        keys = p.keys,
    ) {
        alert_icon(kind)
        Column(4) {
            if result.is_some(p.dismiss) {
                Box(style = Style(direction = Direction.Row, gap = Space.Exs, align = Align.Center)) {
                    Text(
                        title,
                        style = Style(grow = 1, font = FONT_BODY, color = alert_title_tint(kind)),
                    )
                    Box(
                        style = Style(
                            width = px(28),
                            height = px(28),
                            align = Align.Center,
                            justify = Align.Center,
                            radius = RAD_MD,
                            cursor = "pointer",
                        ),
                        on_click = fn() { open.set(false) },
                        role = "button",
                        label = "Dismiss",
                        focusable = true,
                    ) {
                        Icon(IC_X, 16, mute())
                    }
                }
            } else {
                Text(title, style = Style(font = FONT_BODY, color = alert_title_tint(kind)))
            }
            Text(
                body,
                style = Style(wrap = true, font = FONT_CONTROL, color = alert_body_tint(kind)),
            )
            p.children()
        }
    }
}

/// Text input frame (themed; raw editing widget is `Input`): 36px tall,
/// rounded, 1px border, transparent fill.
/// Single-line compose field. `width >= 0` pins the field (typing then
/// scrolls inside it instead of resizing the layout); -1 keeps the natural
/// content width. Pin with `width = 200`; restyle with any style prop.
struct TextInputProps {
    /// `Size` token: the frame is `control_h(size)` tall.
    size: int = Size.Md,
    /// Draws the danger edge (a `Field` with an `error` sets it).
    invalid: bool = false,
    /// Dims the field and makes it inert.
    disabled: bool = false,
    /// Accessible name. Empty uses the placeholder.
    label: string = "",
    /// Style, merged over the recipe's own: `style = Style(radius = 4)`.
    style: Option<fn() -> Style> = none,
    /// Keyboard actions on this element (`key_bind(...)`, `key_bind_click(...)`).
    keys: []KeyBind = no_keys(),
}

/// A field's accessible name: `label` when set, else the placeholder.
fn field_name(label: string, placeholder: string) -> string {
    if label.len > 0 {
        return label
    }
    return placeholder
}

/// X control that appears while `value` is non-empty and clears the bound
/// field. Shared by `TextInput` / `TextArea` / `Combobox`.
fn InputClear(value: Signal<string>, field: Ref) -> Node {
    // controller
    fn clear() {
        value.set("")
        focus(field)
    }

    // view. Pointer-only: keyboard users clear with Cmd/Ctrl+A then
    // Backspace, so the X is not a tab stop between the field and the next
    // control.
    return Box(
        style = Style(
            width = px(20),
            height = px(20),
            shrink = 0,
            align = Align.Center,
            justify = Align.Center,
            radius = RAD_SM,
            cursor = "pointer",
        ),
        on_click = clear,
        role = "button",
        label = "Clear",
        focusable = false,
        visible = value.get().len > 0,
    ) {
        Icon(IC_X, 12, mute())
    }
}

/// What the fields sharing `field_chrome` vary.
struct FieldChromeProps {
    /// The danger edge.
    invalid: bool = false,
    /// Fixed width in dp; -1 lets the row size it.
    width: int = -1,
    cursor: string = "text",
    /// Side padding in dp; -1 takes the size's own (`control_pad_x`).
    padX: int = -1,
    /// End-side padding in dp; -1 matches `padX`.
    padEnd: int = -1,
    gap: int = 4,
    /// `Z_FIELD` keeps a field under its own open list; -1 is flow order.
    zIndex: int = -1,
}

/// The frame every single-line field shares (`TextInput`, `Select`,
/// `Combobox`, …): a `control_h(size)` rectangle with eased corners and a
/// hairline on the plate, so a field and a `Button` of one size line up.
fn field_chrome(size: int, p: FieldChromeProps) -> Style {
    let pad = px_or_default(p.padX, control_pad_x(size))
    return Style(
        width = len_px(p.width),
        height = px(control_h(size)),
        direction = Direction.Row,
        gap = p.gap,
        align = Align.Center,
        paddingLeft = pad,
        paddingRight = px_or_default(p.padEnd, pad),
        zIndex = opt_dim(p.zIndex),
        radius = RAD_CONTROL,
        borderWidth = HAIRLINE,
        borderColor = invalid_edge(p.invalid),
        background = plate(),
        cursor = p.cursor,
    )
}

/// A field's hairline color: the danger edge while `invalid`.
fn invalid_edge(invalid: bool) -> string {
    return if invalid { danger_edge() } else { rule() }
}

fn TextInput(value: Signal<string>, placeholder: string, p: TextInputProps) -> Node {
    // state
    let field = ref()

    // view. A click anywhere on the frame focuses the field; the frame itself
    // is not a tab stop.
    return Box(
        style = field_chrome(p.size, invalid = p.invalid),
        restyle = p.style,
        on_click = fn() { focus(field) },
        focusable = false,
        enabled = !p.disabled,
        keys = p.keys,
    ) {
        Input(
            ref = field,
            bind = value,
            placeholder = placeholder,
            style = Style(grow = 1, font = control_font(p.size), padding = 0, color = ink()),
            restyle = text_of(p.style),
            label = field_name(p.label, placeholder),
        )
        InputClear(value, field)
    }
}

/// Options for `TextArea`.
struct TextAreaProps {
    /// Runs on key-up (autosave).
    on_edit: fn() = noop,
    /// Draws the danger edge (a `Field` with an `error` sets it).
    invalid: bool = false,
    /// Dims the field and makes it inert.
    disabled: bool = false,
    /// Accessible name. Empty uses the placeholder.
    label: string = "",
    /// Style, merged over the recipe's own: a `width` pins the field, which
    /// otherwise fills its column.
    style: Option<fn() -> Style> = none,
}

/// Multiline compose field: min-height ~4 lines, same chrome as `TextInput`.
fn TextArea(value: Signal<string>, placeholder: string, p: TextAreaProps) -> Node {
    // state
    let field = ref()

    // view
    return Box(
        style = Style(
            direction = Direction.Row,
            gap = Space.Exxxs,
            align = Align.Start,
            minHeight = 96,
            paddingY = Space.Exs,
            paddingX = Space.Xs,
            radius = RAD_MD,
            borderWidth = HAIRLINE,
            borderColor = invalid_edge(p.invalid),
            background = plate(),
            cursor = "text",
        ),
        restyle = p.style,
        on_click = fn() { focus(field) },
        focusable = false,
        enabled = !p.disabled,
    ) {
        Input(
            ref = field,
            bind = value,
            placeholder = placeholder,
            style = Style(grow = 1, font = FONT_BODY, padding = 0, color = ink()),
            multiline = true,
            label = field_name(p.label, placeholder),
            on_key_up = p.on_edit,
        )
        InputClear(value, field)
    }
}

/// Options for `FormField`.
struct FormFieldProps {
    /// Muted help line under the control. Hidden while `error` shows.
    description: string = "",
    /// Error line under the control, in the danger ink. A thunk, so
    /// `error = if bad.get() { "Required" } else { "" }` follows state; empty
    /// hides it.
    error: Signal<string> = "",
    /// Adds a danger `*` after the label (and to its accessible name).
    required: bool = false,
    /// Style, merged over the column's own.
    style: Option<fn() -> Style> = none,
    /// The control: any input, select, group, or row of them.
    children: fn() = noop,
}

/// Label, control, and a help or error line, for *any* control:
/// `FormField("Plan", required = true) { Select(plan, plans) }`. The control
/// is the caller's, so passing it `invalid` is too (`Field` does that for a
/// `TextInput`).
fn FormField(label: string, p: FormFieldProps) -> Node {
    let has_help = p.description.len > 0
    return Box(style = Style(direction = Direction.Column, gap = Space.Exs), restyle = p.style) {
        Box(style = Style(direction = Direction.Row, gap = 2, align = Align.Center)) {
            Label(label)
            if p.required {
                Text("*", style = Style(font = FONT_BODY, color = danger()), label = "required")
            }
        }
        p.children()
        if has_help {
            Text(
                p.description,
                style = Style(
                    wrap = true,
                    font = FONT_CONTROL,
                    color = mute(),
                    display = shown(p.error.get().len == 0),
                ),
            )
        }
        Text(
            p.error,
            style = Style(
                wrap = true,
                font = FONT_CONTROL,
                color = danger(),
                display = shown(p.error.get().len > 0),
            ),
            role = "alert",
        )
    }
}

/// Label + text input: a `FormField` around a `TextInput`. Pin with
/// `width = 200` so the row around it does not reflow while typing; restyle
/// with any style prop — they all forward to the `TextInput` underneath. An
/// `error` draws the input's danger edge.
struct FieldProps {
    /// `Size` token for the input.
    size: int = Size.Md,
    description: string = "",
    error: Signal<string> = "",
    required: bool = false,
    /// Style, merged over the recipe's own: `style = Style(radius = 4)`.
    style: Option<fn() -> Style> = none,
    /// Keyboard actions on this element (`key_bind(...)`, `key_bind_click(...)`).
    keys: []KeyBind = no_keys(),
}

fn Field(label: string, value: Signal<string>, placeholder: string, p: FieldProps) -> Node {
    return FormField(label, description = p.description, error = p.error, required = p.required) {
        TextInput(
            value,
            placeholder,
            size = p.size,
            invalid = p.error.get().len > 0,
            style = p.style,
            keys = p.keys,
        )
    }
}

/// Options for `Checkbox`.
struct CheckboxProps {
    /// `Size` token for the label type.
    size: int = Size.Md,
    disabled: bool = false,
    /// Mixed state (a select-all over a partial pick): a dash replaces the
    /// check while it is true. Clicking a mixed box checks it; clearing the
    /// mix is the caller's job (usually it is derived from the children).
    indeterminate: Option<Signal<bool>> = none,
    /// Style, merged over the row's own.
    style: Option<fn() -> Style> = none,
}

/// Checkbox: `CHECK` (16px) rounded box, 1px accent border, accent fill when checked
/// with a white 16px SVG check. The mark fades in when ticked and fades out
/// when cleared (paint-only, so a toggle never re-lays out); the first
/// frame settles without motion, and reduced motion snaps.
fn Checkbox(label: string, on: Signal<bool>, p: CheckboxProps) -> Node {
    // state
    let has_mix = result.is_some(p.indeterminate)
    let mix = result.some_or(p.indeterminate, no_flag_signal())
    fn mixed() -> bool {
        return has_mix && mix.get()
    }

    // controller
    fn toggle() {
        if mixed() {
            on.set(true)
        } else {
            on.set(!on.get())
        }
    }

    // view
    return Box(
        style = Style(
            direction = Direction.Row,
            gap = Space.Exs,
            align = Align.Center,
            cursor = "pointer",
        ),
        restyle = p.style,
        on_click = toggle,
        role = "checkbox",
        label = label,
        enabled = !p.disabled,
        checked = on.get() && !mixed(),
    ) {
        Box(style = Style(
            width = px(CHECK),
            height = px(CHECK),
            align = Align.Center,
            justify = Align.Center,
            radius = RAD_CHECK,
            borderWidth = HAIRLINE,
            borderColor = accent(),
            background = if on.get() || mixed() { accent() } else { plate() },
        )) {
            // The mark fades with the state; it is inset 2dp inside the
            // hairline, so the box keeps its square.
            Icon(
                IC_CHECK,
                CHECK - 4,
                on_ink(),
                style = Style(
                    display = shown(!mixed()),
                    opacity = if on.get() { 100 } else { 0 },
                    transition = Motion.Fast,
                ),
            )
            if has_mix {
                Icon(IC_MINUS, CHECK - 4, on_ink(), style = Style(display = shown(mixed())))
            }
        }
        Text(label, style = Style(font = control_font(p.size), color = ink()))
    }
}

struct UserProps {
    src: string = ""
    status: int = -1
}

/// Avatar + name + role column, the "user card" pattern.
fn User(initials: string, name: string, role: string, p: UserProps) -> Node {
    return Row(Space.Xs) {
        Avatar(initials, AvatarSize.Lg, src = p.src, status = p.status)
        Column(2) {
            Text(name, style = Style(font = FONT_BODY, color = ink()))
            Text(role, style = Style(font = FONT_CAPTION, color = mute()))
        }
    }
}

/// Breadcrumb: items separated by chevron icons; last item is foreground.
fn Breadcrumbs(items: []string) -> Node {
    return Row(6) {
        Each(items, fn(i, s) {
            // One root per crumb: the chevron rides with the item after it, in
            // a row with the same gap as the trail.
            return Row(6) {
                if i > 0 {
                    Icon(IC_CHEV_RIGHT, 14, mute())
                }
                Text(
                    s,
                    style = Style(font = FONT_BODY, color = if i == items.len - 1 {
                        ink()
                    } else {
                        mute()
                    }),
                )
            }
        })
    }
}

/// One trigger in a tray. Selected: the plate fill and ink text (underlined,
/// a 2px ink rule along its foot instead); the rest stay muted. Arrows move
/// the selection; only the selected trigger is a tab stop. `radio` gives it
/// radio semantics (`Segmented`) instead of a tab's.
fn TrayItem(
    label: string,
    selected: Signal<int>,
    index: int,
    count: int,
    size: int,
    radio: bool,
    underline: bool
) -> Node {
    fn on() -> bool {
        return selected.get() == index
    }
    return Box(
        style = Style(
            height = px(if underline { control_h(size) } else { tray_item_h(size) }),
            direction = Direction.Row,
            gap = Space.Exxs,
            align = Align.Center,
            paddingX = Space.Xs,
            radius = RAD_CONTROL,
            background = if on() && !underline { plate() } else { "" },
            borderColor = ink(),
            borderBottom = if on() && underline { 2 } else { 0 },
            cursor = "pointer",
        ),
        on_click = fn() => selected.set(index),
        role = if radio { "radio" } else { "tab" },
        label = label,
        checked = on(),
        keys = roving_keys(if radio { "choice" } else { "tab" }, selected, index, count),
        roving = on(),
    ) {
        Text(
            label,
            style = Style(font = control_font(size), ellipsis = true, color = if on() {
                ink()
            } else {
                mute()
            }),
        )
    }
}

/// One tab trigger (see `TrayItem`).
fn Tab(
    label: string,
    selected: Signal<int>,
    index: int,
    count: int = 0,
    size: int = Size.Md,
    underline: bool = false
) -> Node {
    return TrayItem(label, selected, index, count, size, false, underline)
}

/// One radio trigger of a `Segmented` tray (see `TrayItem`).
fn Choice(
    label: string,
    value: Signal<int>,
    index: int,
    count: int = 0,
    size: int = Size.Md
) -> Node {
    return TrayItem(label, value, index, count, size, true, false)
}

/// Trigger height inside a tray: the tray is `control_h(size)` with a 4px inset.
fn tray_item_h(size: int) -> int {
    return control_h(size) - 8
}

/// Tabs: a `control_h(size)` raised tray with a 4px inset; the selected
/// trigger sits on the plate. `look = Look.Link` is the underline variant:
/// bare triggers over a hairline, the selected one ruled in ink.
struct TabsProps {
    /// `Size` token: the tray is `control_h(size)` tall.
    size: int = Size.Md,
    /// `Look.Soft` (the raised tray) or `Look.Link` (underline).
    look: int = Look.Soft,
}

fn Tabs(selected: Signal<int>, labels: []string, p: TabsProps) -> Node {
    return IndicatorTray(selected, labels, false, p.size, p.look == Look.Link)
}

/// The tray `Tabs` and `Segmented` share: a row of `TrayItem`s, on a raised
/// plate or (underline) over a hairline. `radio` builds `Choice` triggers.
/// The selection is a fill on the selected trigger — nothing is measured.
fn IndicatorTray(
    selected: Signal<int>,
    labels: []string,
    radio: bool,
    size: int = Size.Md,
    underline: bool = false
) -> Node {
    let n = labels.len
    // A row wrapper, so the tray hugs its triggers instead of stretching.
    return Row(0) {
        Box(style = Style(
            direction = Direction.Row,
            gap = 2,
            align = Align.Center,
            padding = if underline { 0 } else { 4 },
            radius = RAD_CONTROL,
            background = if underline { "" } else { raised() },
            borderColor = rule(),
            borderBottom = if underline { 1 } else { 0 },
        )) {
            Each(labels, fn(i, lab) {
                return TrayItem(lab, selected, i, n, size, radio, underline)
            })
        }
    }
}

/// Exclusive pick from `labels` as a Tabs-style tray: the same fill and keys
/// as `Tabs`, with radio semantics for assistive tech.
struct SegmentedProps {
    /// `Size` token: the tray is `control_h(size)` tall.
    size: int = Size.Md,
}

fn Segmented(value: Signal<int>, labels: []string, p: SegmentedProps) -> Node {
    return IndicatorTray(value, labels, true, p.size)
}

/// One row of a `Select` menu: a check icon on the picked row, and the raised
/// fill while it is the keyboard's row.
fn SelectRow(value: Signal<int>, active: Signal<int>, index: int, label: string) -> Node {
    // controller
    fn pick() {
        value.set(index)
        active.set(-1)
    }

    // view
    return Box(
        hoverStyle = Style(background = raised()),
        style = Style(
            direction = Direction.Row,
            gap = Space.Exxxs,
            align = Align.Center,
            paddingY = 6,
            paddingX = Space.Exs,
            radius = RAD_SM,
            background = row_fill(active.get() == index),
            cursor = "pointer",
        ),
        on_click = pick,
        role = "listitem",
        label = label,
        hoverOff = false,
    ) {
        Text(label, style = Style(font = FONT_BODY, color = ink(), ellipsis = true))
        Grow()
        Icon(IC_CHECK, 16, ink(), style = Style(display = shown(value.get() == index)))
    }
}

/// Space between a floating panel's rows (menus, selects, comboboxes).
const PANEL_GAP: int = 2

/// What the panels sharing `floating_panel` vary.
struct PanelProps {
    /// Fixed width in dp; -1 sizes the panel to its content.
    width: int = -1,
    gap: int = PANEL_GAP,
    padding: int = 4,
    zIndex: int = Z_POPUP,
    cursor: string = "",
}

/// The surface every floating list or panel shares (`Menu`, `Popover`,
/// `Select`, `Combobox`, …): an absolute plate on the popup layer, a hairline,
/// `RAD_LG` corners, and the one soft `FLOAT_LIFT` shadow that separates it
/// from what it covers. At least `min_w` wide. Shown by the element's
/// `visible`, placed by its `anchor`.
fn floating_panel(min_w: int, p: PanelProps) -> Style {
    return Style(
        direction = Direction.Column,
        gap = p.gap,
        width = len_px(p.width),
        minWidth = min_w,
        padding = p.padding,
        position = pos_absolute(),
        zIndex = p.zIndex,
        elevation = FLOAT_LIFT,
        radius = RAD_LG,
        borderWidth = HAIRLINE,
        borderColor = rule(),
        background = plate(),
        cursor = opt_color(p.cursor),
    )
}

/// A list row's fill: raised while it is the keyboard's (or pointer's) row.
fn row_fill(on: bool) -> string {
    return if on { raised() } else { "" }
}

/// Dropdown. The trigger shows the current label; the menu is an anchored
/// floater (card surface, p-1 viewport, hairline border) that stays beside the
/// trigger and follows it on scroll. Arrows move the highlight, Enter picks,
/// Escape or an outside click closes. `active` (-1 = closed) is the menu's only
/// extra state; the picked value stays in the caller's `value` signal.
struct SelectProps {
    /// `Size` token: the trigger is `control_h(size)` tall.
    size: int = Size.Md,
    /// Draws the danger edge (a `Field` with an `error` sets it).
    invalid: bool = false,
    /// Dims the trigger and makes it inert.
    disabled: bool = false,
    /// Accessible name of the trigger.
    label: string = "",
    /// Style, merged over the trigger's own. A px `width` also sizes the menu;
    /// unset, both are `SELECT_W`.
    style: Option<fn() -> Style> = none,
}

/// Which `Select` is open: its token, 0 for none. Opening one closes the
/// rest. Each trigger sits above the scrim (so a second click on it closes
/// its own menu), which also means a click on another trigger never reached
/// the open menu's scrim, and several menus stayed open over each other.
let mut select_open_sid: int = 0
let mut select_seq: int = 0

fn select_open() -> Signal<int> {
    if select_open_sid == 0 {
        let s = global_signal(0)
        select_open_sid = s.id
    }
    return signal_handle(select_open_sid)
}

fn Select(value: Signal<int>, labels: []string, p: SelectProps) -> Node {
    let size = p.size
    select_seq = select_seq + 1
    let token = select_seq
    let open = select_open()
    // state. `active` (-1 = closed) is the menu's only state; the picked value
    // stays in the caller's `value` signal.
    let active = signal(-1)
    let trigger = ref()
    let n = labels.len
    let w = len_or(style_of(p.style).width, SELECT_W)

    // controller
    fn close() {
        active.set(-1)
    }
    fn toggle() {
        if active.get() >= 0 {
            active.set(-1)
        } else {
            active.set(0)
            open.set(token)
        }
    }
    fn next() {
        if active.get() >= 0 {
            if active.get() + 1 < n {
                active.set(active.get() + 1)
            }
        }
    }
    fn prev() {
        if active.get() > 0 {
            active.set(active.get() - 1)
        }
    }
    fn pick() {
        if active.get() >= 0 {
            value.set(active.get())
            active.set(-1)
        }
    }
    // Another Select opened: close this one.
    effect(|| {
        if open.get() != token && active.peek() >= 0 {
            active.set(-1)
        }
    })

    // keys
    let keys = []KeyBind {
        key_bind("escape", "select.close", close),
        key_bind("down", "select.next", next),
        key_bind("up", "select.prev", prev),
        key_bind("enter", "select.pick", pick),
    }

    // view. The scrim comes first so the trigger and menu draw over it; an
    // outside click lands on it and closes. The open menu holds focus, so the
    // arrows and Enter reach it.
    return Box(style = Style(direction = Direction.Column, alignSelf = Align.Start)) {
        Overlay(
            on_click = close,
            style = Style(display = shown(active.get() >= 0), zIndex = Z_SCRIM),
        )
        Box(
            ref = trigger,
            style = field_chrome(
                size,
                invalid = p.invalid,
                width = w,
                zIndex = Z_FIELD,
                cursor = "pointer",
            ),
            restyle = p.style,
            on_click = toggle,
            role = "combobox",
            label = p.label,
            enabled = !p.disabled,
            hoverOff = false,
            press = true,
        ) {
            Each(labels, fn(i, lab) {
                return Text(
                    lab,
                    style = Style(
                        font = control_font(size),
                        color = ink(),
                        ellipsis = true,
                        display = shown(value.get() == i),
                    ),
                )
            })
            Grow()
            Icon(IC_CHEV_DOWN, control_icon(size), dim())
        }
        Box(
            style = floating_panel(MENU_MIN_W, width = w),
            anchor = Anchor(to = trigger, place = Place.PlaceBelow, gap = 6),
            autofocus = active.get() >= 0,
            visible = active.get() >= 0,
            keys = keys,
            enter = Enter.Fade,
        ) {
            Each(labels, fn(i, lab) {
                return SelectRow(value, active, i, lab)
            })
        }
    }
}

/// Radio group: vertical stack of `Radio` rows, 8px apart. The picked row gets a
/// filled primary dot. Arrows move the pick; only the selected row is a tab stop.
/// Options for `Radio`.
struct RadioProps {
    /// Size of the group, for the roving Home / End keys (0 = unknown).
    count: int = 0,
    /// `Size` token for the label type.
    size: int = Size.Md,
    disabled: bool = false,
    /// Style, merged over the row's own.
    style: Option<fn() -> Style> = none,
}

fn Radio(label: string, value: Signal<int>, index: int, p: RadioProps) -> Node {
    // controller
    fn active() -> bool {
        return value.get() == index
    }

    // keys
    let keys = roving_keys("radio", value, index, p.count, true)

    // view
    return Box(
        style = Style(
            direction = Direction.Row,
            gap = Space.Exs,
            align = Align.Center,
            cursor = "pointer",
        ),
        restyle = p.style,
        on_click = fn() => value.set(index),
        role = "radio",
        label = label,
        enabled = !p.disabled,
        checked = active(),
        keys = keys,
        roving = active(),
    ) {
        // The dot fades in when picked and out when the pick moves on.
        Box(style = Style(
            width = px(CHECK),
            height = px(CHECK),
            align = Align.Center,
            justify = Align.Center,
            radius = RAD_FULL,
            borderWidth = HAIRLINE,
            borderColor = accent(),
            background = plate(),
        )) {
            Box(style = Style(
                width = px(RADIO_DOT),
                height = px(RADIO_DOT),
                radius = RAD_FULL,
                background = accent(),
                opacity = if active() { 100 } else { 0 },
                transition = Motion.Fast,
            ))
        }
        Text(label, style = Style(font = control_font(p.size), color = ink()))
    }
}

/// `RadioGroup(value, labels)`: one circle per option.
fn RadioGroup(value: Signal<int>, labels: []string) -> Node {
    let n = labels.len
    return Column(Space.Exs) {
        Each(labels, fn(i, lab) {
            return Radio(lab, value, i, count = n)
        })
    }
}

/// Toggle: default variant, no border — a pressed state fills muted
/// (accent fill), `control_h(size)` tall and rounded.
struct ToggleProps {
    /// `Size` token: the toggle is `control_h(size)` tall.
    size: int = Size.Md,
}

fn Toggle(label: string, on: Signal<bool>, p: ToggleProps) -> Node {
    let size = p.size
    return Box(
        style = Style(
            height = px(control_h(size)),
            direction = Direction.Row,
            gap = Space.Exxs,
            align = Align.Center,
            justify = Align.Center,
            paddingX = Space.Xs,
            radius = RAD_CONTROL,
            cursor = "pointer",
            background = if on.get() { raised() } else { plate() },
        ),
        on_click = fn() => on.set(!on.get()),
        role = "button",
        label = label,
        checked = on.get(),
        hoverOff = false,
        hoverFade = true,
        press = true,
    ) {
        Text(
            label,
            style = Style(font = control_font(size), color = if on.get() { ink() } else { mute() }),
        )
    }
}

/// Toggle group: a 4px-gap row of single-choice toggles with outline
/// chrome; the pressed state fills muted. One tab stop for the group (the
/// picked item); arrows move the pick, Home / End jump to the ends.
fn ToggleGroup(value: Signal<int>, labels: []string, p: ToggleProps) -> Node {
    let size = p.size
    let n = labels.len
    return Row(4) {
        Each(labels, fn(i, lab) {
            return ToggleItem(lab, value, i, n, size)
        })
    }
}

/// One item of a `ToggleGroup`.
fn ToggleItem(
    label: string,
    value: Signal<int>,
    index: int,
    count: int,
    size: int = Size.Md
) -> Node {
    // controller
    fn active() -> bool {
        return value.get() == index
    }

    // keys
    let keys = roving_keys("toggle", value, index, count)

    // view
    return Box(
        style = Style(
            height = px(control_h(size)),
            direction = Direction.Row,
            align = Align.Center,
            justify = Align.Center,
            paddingX = Space.Xs,
            radius = RAD_CONTROL,
            borderWidth = HAIRLINE,
            borderColor = rule(),
            cursor = "pointer",
            background = if active() { raised() } else { plate() },
        ),
        on_click = fn() => value.set(index),
        role = "radio",
        label = label,
        checked = active(),
        keys = keys,
        roving = active(),
        hoverOff = false,
        hoverFade = true,
        press = true,
    ) {
        Text(
            label,
            style = Style(font = control_font(size), color = if active() { ink() } else { mute() }),
        )
    }
}

struct CollapsibleProps {
    /// Open while true.
    open: Signal<bool> = Signal { id: 0 },
    title: Signal<string> = "",
    /// Optional leading icon markup.
    icon: string = "",
    /// The trailing block: the body, placed by the component.
    children: fn() = noop,
    /// Style, merged over the recipe's own: `style = Style(radius = 4)`.
    style: Option<fn() -> Style> = none,
}

/// One disclosure: a header row that toggles, and a body that fades in while
/// `open`. `open` is the *only* state; the chevron rotation and
/// the body fade are paint-only tracks. Trailing block is the body.
///
/// Self-contained like `Toast`: the header and a hideable body go into a
/// wrapper, and the wrapper's body is what is returned, so the trailing block
/// lands inside the part that hides.
fn Collapsible(p: CollapsibleProps) -> Node {
    let open = p.open
    // A bare disclosure by default; a surface comes from the caller's style.
    return Box(style = Style(direction = Direction.Column, radius = RAD_LG), restyle = p.style) {
        DisclosureHead(
            p.title,
            fn() -> bool { return open.get() },
            fn() { open.set(!open.get()) },
            icon = p.icon,
        )
        DisclosureBody(fn() -> bool { return open.get() }) {
            p.children()
        }
    }
}

/// What a `DisclosureHead` varies.
struct DisclosureHeadProps {
    icon: string = "",
    keys: []KeyBind = no_keys(),
    ref: Option<Ref> = none,
}

/// The header row of a disclosure (`Collapsible`, `AccordionItem`): a 48px
/// line with an optional icon, the title, and a chevron that turns over
/// while `open`.
fn DisclosureHead(
    title: Signal<string>,
    open: Signal<bool>,
    toggle: fn(),
    p: DisclosureHeadProps
) -> Node {
    return Box(
        style = Style(
            direction = Direction.Row,
            gap = Space.Sm,
            align = Align.Center,
            minHeight = 48,
            paddingY = 14,
            paddingX = Space.Sm,
            cursor = "pointer",
        ),
        ref = p.ref,
        on_click = toggle,
        keys = p.keys,
        role = "button",
        label = title.get(),
        hoverOff = false,
        press = true,
    ) {
        if p.icon.len > 0 {
            Icon(p.icon, 16, mute())
        }
        Text(title, style = Style(grow = 1, font = FONT_BODY, color = ink()))
        Icon(
            IC_CHEV_DOWN,
            16,
            mute(),
            style = Style(rotate = if open.get() { 180 } else { 0 }, transition = Motion.Fast),
        )
    }
}

/// The part of a disclosure that hides: inset so the copy clears the title,
/// fading and revealing in while `open`. Trailing block is the body.
struct DisclosureBodyProps {
    children: fn() = noop,
}

fn DisclosureBody(open: Signal<bool>, p: DisclosureBodyProps) -> Node {
    return Box(
        style = Style(
            direction = Direction.Column,
            paddingTop = 2,
            paddingRight = Space.Sm,
            paddingBottom = 18,
            paddingLeft = Space.Sm,
        ),
        visible = open.get(),
        enter = Enter.Fade + Enter.Reveal,
    ) {
        p.children()
    }
}

/// One page number for `Pagination`: ghost number; the current page is an
/// outline button. The current page is an effect, not a prop, so the row
/// repaints when `page` moves.
fn PageButton(page: Signal<int>, n: int, size: int = Size.Md) -> Node {
    // controller
    fn current() -> bool {
        return page.get() == n
    }

    // view. The outline only exists on the current page.
    return Box(
        style = page_style(size, current(), true),
        on_click = fn() => page.set(n),
        role = "button",
        label = "{{n}}",
    ) {
        Text(
            "{{n}}",
            style = Style(font = control_font(size), color = if current() { ink() } else { mute() }),
        )
    }
}

/// A `control_h(size)` page square. The current page is an outline on the
/// plate; the rest are ghost numbers. `live` = it can be pressed.
fn page_style(size: int, current: bool, live: bool) -> Style {
    return Style(
        width = px(control_h(size)),
        height = px(control_h(size)),
        direction = Direction.Row,
        align = Align.Center,
        justify = Align.Center,
        radius = RAD_CONTROL,
        borderWidth = if current { HAIRLINE } else { 0 },
        borderColor = rule(),
        background = if current { plate() } else { "" },
        cursor = if live { "pointer" } else { "" },
    )
}

/// One slot of a collapsed `Pagination` row: the number it shows follows
/// `current_value`, so the row never rebuilds; an ellipsis slot is inert.
fn PageSlot(current_value: Signal<int>, pages: int, slot: int, size: int = Size.Md) -> Node {
    // controller. The number this slot shows follows `current_value`, so the
    // row never rebuilds; an ellipsis slot (0) is inert.
    fn shown_page() -> int {
        return page_at(current_value.get(), pages, slot)
    }
    fn go() {
        let n = shown_page()
        if n > 0 {
            current_value.set(n)
        }
    }

    // view
    return Box(
        style = page_style(size, shown_page() == current_value.get(), shown_page() > 0),
        on_click = go,
        role = "button",
        label = if shown_page() == 0 { "More pages" } else { "{{shown_page()}}" },
    ) {
        Text(
            if shown_page() == 0 { "…" } else { "{{shown_page()}}" },
            style = Style(font = control_font(size), color = if shown_page() == current_value.get(
            ) { ink() } else { mute() }),
        )
    }
}

/// `Pagination(current_value, pages)`: `pages` is the 1-based page count. Past seven
/// pages the row collapses to `1 … c-1 c c+1 … N` (see `page_at`).
struct PaginationProps {
    /// `Size` token: each page button is a `control_h(size)` square.
    size: int = Size.Md,
}

fn Pagination(current_value: Signal<int>, pages: int, p: PaginationProps) -> Node {
    let size = p.size
    // controller
    fn previous() {
        if current_value.get() > 1 {
            current_value.set(current_value.get() - 1)
        }
    }
    fn next() {
        if current_value.get() < pages {
            current_value.set(current_value.get() + 1)
        }
    }

    // keys. On the row, so they answer wherever focus sits inside it.
    let keys = []KeyBind {
        key_bind("left", "page.prev", previous),
        key_bind("right", "page.next", next),
        key_bind("home", "page.first", fn() { current_value.set(1) }),
        key_bind("end", "page.last", fn() { current_value.set(pages) }),
    }

    // view
    return Box(
        style = Style(direction = Direction.Row, gap = Space.Exxxs, align = Align.Center),
        role = "navigation",
        label = "Pagination",
        keys = keys,
    ) {
        Box(
            style = Style(
                width = px(control_h(size)),
                height = px(control_h(size)),
                direction = Direction.Row,
                align = Align.Center,
                justify = Align.Center,
                radius = RAD_CONTROL,
                cursor = "pointer",
            ),
            on_click = previous,
            role = "button",
            label = "Previous page",
        ) {
            Icon(IC_CHEV_LEFT, 16, mute())
        }
        if pages <= PAGE_SLOTS {
            let mut i = 1
            while i <= pages {
                PageButton(current_value, i, size)
                i = i + 1
            }
        } else {
            for slot in 0..PAGE_SLOTS {
                PageSlot(current_value, pages, slot, size)
            }
        }
        Box(
            style = Style(
                width = px(control_h(size)),
                height = px(control_h(size)),
                direction = Direction.Row,
                align = Align.Center,
                justify = Align.Center,
                radius = RAD_CONTROL,
                cursor = "pointer",
            ),
            on_click = next,
            role = "button",
            label = "Next page",
        ) {
            Icon(IC_CHEV_RIGHT, 16, mute())
        }
    }
}

/// Themed chrome branch of `Button`.
fn BtnLook(p: ButtonProps) -> Node {
    // state
    let look = p.look
    let size = p.size
    let on = p.enabled
    let fill = if on { button_background(look) } else { button_disabled_background(look) }
    let ink_c = if on { button_color(look) } else { mute() }
    let edge = if on { button_border_color(look) } else { rule() }
    let busy = result.is_some(p.loading)
    let ls = result.some_or(p.loading, no_flag_signal())

    // view. Disabled: the muted fill is the styling, the shared overlay turns
    // hover / press / activation off, and a lighter 70% replaces the 40% dim
    // `enabled` would apply. While loading, a spinner takes the icon slot and
    // the button is inert at 70%. Chrome hover is explicit (`hoverFade`): a
    // themed button stays a hover target even with no click handler. The
    // caller's `color` / `font` reach the label and icon.
    // `width = pct(-1)` is content width. A button in a column otherwise
    // fills the column; a caller's `width` still wins (`restyle`).
    return Box(
        style = Style(
            width = pct(-1),
            height = px(control_h(size)),
            direction = Direction.Row,
            gap = control_gap(size),
            align = Align.Center,
            justify = Align.Center,
            paddingX = control_pad_x(size),
            radius = RAD_CONTROL,
            borderWidth = button_border_width(look),
            borderColor = opt_color(edge),
            background = opt_color(fill),
            color = ink_c,
            opacity = if !on || (busy && ls.get()) { 70 } else { 100 },
            cursor = "pointer",
        ),
        restyle = p.style,
        on_click = p.on_click,
        role = "button",
        label = p.label.get(),
        hoverOff = p.hoverOff,
        press = true,
        hoverFade = !p.hoverOff,
        keys = p.keys,
        enabled = on,
        loading = busy && ls.get(),
    ) {
        if busy {
            Spinner(
                size = control_icon(size),
                color = text_color(style_of(p.style), ink_c),
                style = Style(display = shown(ls.get())),
            )
        }
        if p.icon.len > 0 {
            Icon(
                p.icon,
                control_icon(size),
                text_color(style_of(p.style), ink_c),
                style = Style(display = shown(!busy || !ls.get())),
            )
        }
        Text(
            p.label,
            style = Style(font = control_font(size), color = ink_c),
            restyle = text_of(p.style),
        )
    }
}

/// Page number shown in `slot` (0-based) of a `PAGE_SLOTS`-wide row, or 0
/// for an ellipsis. Seven or fewer pages list every number; past that the
/// row keeps 1 and `pages` fixed and slides a window around `current_value`
/// (`1 … 4 5 6 … 20`), collapsing the ellipsis at either end.
fn page_at(current_value: int, pages: int, slot: int) -> int {
    if pages <= PAGE_SLOTS {
        return slot + 1
    }
    if slot == 0 {
        return 1
    }
    if slot == PAGE_SLOTS - 1 {
        return pages
    }
    if current_value <= 4 {
        // 1 2 3 4 5 … N
        if slot == PAGE_SLOTS - 2 {
            return 0
        }
        return slot + 1
    }
    if current_value >= pages - 3 {
        // 1 … N-4 N-3 N-2 N-1 N
        if slot == 1 {
            return 0
        }
        return pages - (PAGE_SLOTS - 1 - slot)
    }
    // 1 … c-1 c c+1 … N
    if slot == 1 {
        return 0
    }
    if slot == PAGE_SLOTS - 2 {
        return 0
    }
    return current_value + slot - 3
}

// ═══════════════════════════════════════════════════════════════════
// Tier A molecules
// ═══════════════════════════════════════════════════════════════════

/// Corner radius of a slot end in a run of attached controls (Ely's `Slot`):
/// the outer ends round, the joins stay square.
fn slot_radius(outer: bool) -> int {
    if outer { RAD_CONTROL } else { 0 }
}

/// One attached button: `look` chrome at `control_h(size)`, corners by slot.
/// Bordered looks overlap their neighbour's hairline; filled ones leave a 1px
/// seam. `trail` is an optional trailing icon (a dropdown's chevron).
fn GroupSegment(
    label: string,
    index: int,
    count: int,
    look: int,
    size: int,
    on_click: fn(),
    enabled: bool,
    trail: string
) -> Node {
    let bordered = button_border_width(look) > 0
    let seam = if index == 0 { 0 } else if bordered { -HAIRLINE } else { 1 }
    return Box(
        style = Style(
            height = px(control_h(size)),
            direction = Direction.Row,
            gap = control_gap(size),
            align = Align.Center,
            justify = Align.Center,
            paddingX = control_pad_x(size),
            marginLeft = seam,
            radiusTopLeft = slot_radius(index == 0),
            radiusBottomLeft = slot_radius(index == 0),
            radiusTopRight = slot_radius(index == count - 1),
            radiusBottomRight = slot_radius(index == count - 1),
            borderWidth = button_border_width(look),
            borderColor = opt_color(button_border_color(look)),
            background = opt_color(button_background(look)),
            cursor = "pointer",
        ),
        on_click = on_click,
        role = "button",
        label = label,
        enabled = enabled,
        press = true,
        hoverFade = true,
    ) {
        Text(label, style = Style(font = control_font(size), color = button_color(look)))
        if trail.len > 0 {
            Icon(trail, control_icon(size), button_color(look))
        }
    }
}

/// Options for `ButtonGroup`.
struct ButtonGroupProps {
    look: int = Look.Outline,
    size: int = Size.Md,
    /// Runs with the pressed button's index.
    on_click: Option<fn(int)> = none,
    disabled: bool = false,
    /// Accessible name of the group.
    label: string = "",
}

/// Attached buttons sharing one outline: `ButtonGroup(["Day", "Week"],
/// on_click = fn(i) => …)`. For a single *choice* use `Segmented` /
/// `ToggleGroup`; this is a row of actions.
fn ButtonGroup(labels: []string, p: ButtonGroupProps) -> Node {
    let n = labels.len
    return Row(0) {
        Box(style = Style(direction = Direction.Row), role = "group", label = p.label) {
            Each(labels, fn(i, lab) {
                return GroupSegment(
                    lab,
                    i,
                    n,
                    p.look,
                    p.size,
                    fn() => emit_with(p.on_click, i),
                    !p.disabled,
                    "",
                )
            })
        }
    }
}

/// Options for `CopyButton`.
struct CopyButtonProps {
    look: int = Look.Ghost,
    size: int = Size.Md,
    /// Accessible name before and after the copy.
    label: string = "Copy",
    copiedLabel: string = "Copied",
    /// How long the check stays, in ms.
    holdMs: int = 1500,
    style: Option<fn() -> Style> = none,
}

/// Square icon button that puts `text()` on the clipboard; the icon swaps to
/// a check for `holdMs` and the accessible name to `copiedLabel`.
fn CopyButton(text: Signal<string>, p: CopyButtonProps) -> Node {
    let copied = signal(false)
    let look = p.look
    let size = p.size
    fn copy() {
        copy_text(text.get())
        copied.set(true)
        let timer = async.after(p.holdMs, fn() { copied.set(false) })
    }
    return Box(
        style = Style(
            width = px(control_h(size)),
            height = px(control_h(size)),
            direction = Direction.Row,
            align = Align.Center,
            justify = Align.Center,
            radius = RAD_CONTROL,
            borderWidth = button_border_width(look),
            borderColor = opt_color(button_border_color(look)),
            background = opt_color(button_background(look)),
            cursor = "pointer",
        ),
        restyle = p.style,
        on_click = copy,
        role = "button",
        label = if copied.get() { p.copiedLabel } else { p.label },
        press = true,
        hoverFade = true,
    ) {
        Icon(
            IC_COPY,
            control_icon(size),
            button_color(look),
            style = Style(display = shown(!copied.get())),
        )
        Icon(IC_CHECK, control_icon(size), ok(), style = Style(display = shown(copied.get())))
    }
}

/// `s` as an int, or `fallback` when it is not one (optional `-`, digits only).
fn parse_int_or(s: string, fallback: int) -> int {
    if s.len == 0 {
        return fallback
    }
    let neg = s[0] == 45
    let start = if neg { 1 } else { 0 }
    if start >= s.len {
        return fallback
    }
    let mut v = 0
    for i in start..s.len {
        let d = s[i] - 48
        if d < 0 || d > 9 {
            return fallback
        }
        v = v * 10 + d
    }
    return if neg { -v } else { v }
}

/// Options for `NumberInput` and `Stepper`.
struct NumberInputProps {
    min: int = -1000000000,
    max: int = 1000000000,
    step: int = 1,
    size: int = Size.Md,
    disabled: bool = false,
    invalid: bool = false,
    /// Accessible name.
    label: string = "",
    style: Option<fn() -> Style> = none,
}

/// A small square ± button inside a field.
fn StepButton(markup: string, label: string, size: int, on_click: fn(), enabled: bool) -> Node {
    return Box(
        style = Style(
            width = px(control_h(size) - 8),
            height = px(control_h(size) - 8),
            shrink = 0,
            align = Align.Center,
            justify = Align.Center,
            radius = RAD_CONTROL,
            cursor = "pointer",
        ),
        on_click = on_click,
        role = "button",
        label = label,
        enabled = enabled,
        focusable = false,
        press = true,
        hoverFade = true,
    ) {
        Icon(markup, control_icon(size), ink())
    }
}

/// Number field: − and + either side of an editable value. Up / Down step by
/// `step`; Enter commits the typed text, clamped to `min..max`. A typed value
/// already in range commits as you type; one out of range waits for Enter.
fn NumberInput(value: Signal<int>, p: NumberInputProps) -> Node {
    // state
    let field = ref()
    let text = signal("{{peek(value)}}")
    let lo = p.min
    let hi = if p.max >= p.min { p.max } else { p.min }
    let step = if p.step > 0 { p.step } else { 1 }

    // controller
    fn put_text(v: int) {
        let s = "{{v}}"
        if !fmt.eq(peek(text), s) {
            text.set(s)
        }
    }
    fn commit(v: int) {
        let c = clamp_int(v, lo, hi)
        value.set(c)
        put_text(c)
    }
    fn bump(d: int) {
        commit(peek(value) + d)
    }
    fn key() {
        let k = current_key().key
        if k == Key.Up {
            bump(step)
        } else if k == Key.Down {
            bump(-step)
        } else if k == Key.Enter {
            commit(parse_int_or(peek(text), peek(value)))
        }
    }
    // Typing an in-range number commits it at once.
    effect(|| {
        let n = parse_int_or(text.get(), lo - 1)
        if n >= lo && n <= hi && n != peek(value) {
            value.set(n)
        }
    })
    // A value set from outside shows in the field.
    effect(|| {
        let v = value.get()
        if parse_int_or(peek(text), v + 1) != v {
            put_text(v)
        }
    })

    // view
    return Box(
        style = field_chrome(p.size, invalid = p.invalid, padX = 4, gap = 2),
        restyle = p.style,
        on_click = fn() { focus(field) },
        focusable = false,
        role = "group",
        label = p.label,
    ) {
        StepButton(
            IC_MINUS,
            "Decrease",
            p.size,
            fn() { bump(-step) },
            !p.disabled && value.get() > lo,
        )
        Input(
            ref = field,
            bind = text,
            style = Style(grow = 1, font = control_font(p.size), padding = 0, color = ink()),
            label = p.label,
            on_key_down = key,
        )
        StepButton(
            IC_PLUS,
            "Increase",
            p.size,
            fn() { bump(step) },
            !p.disabled && value.get() < hi,
        )
    }
}

/// Compact counter: − value + with no text field (quantities, guests). Up /
/// Down and the buttons step by `step` within `min..max`.
fn Stepper(value: Signal<int>, p: NumberInputProps) -> Node {
    let lo = p.min
    let hi = if p.max >= p.min { p.max } else { p.min }
    let step = if p.step > 0 { p.step } else { 1 }
    fn bump(d: int) {
        value.set(clamp_int(value.get() + d, lo, hi))
    }
    let keys = []KeyBind {
        key_bind("up", "stepper.up", fn() { bump(step) }),
        key_bind("down", "stepper.down", fn() { bump(-step) }),
        key_bind("right", "stepper.right", fn() { bump(step) }),
        key_bind("left", "stepper.left", fn() { bump(-step) }),
    }
    // The row wrapper lets the control hug its content in a column.
    return Row(0) {
        Box(
            style = Style(
                height = px(control_h(p.size)),
                direction = Direction.Row,
                gap = Space.Exxxs,
                align = Align.Center,
                paddingX = Space.Exxxs,
                radius = RAD_CONTROL,
                borderWidth = HAIRLINE,
                borderColor = rule(),
                background = plate(),
            ),
            restyle = p.style,
            role = "spinbutton",
            label = if p.label.len > 0 { "{{p.label}} {{value.get()}}" } else { "{{value.get()}}" },
            keys = keys,
            enabled = !p.disabled,
        ) {
            StepButton(IC_MINUS, "Decrease", p.size, fn() { bump(-step) }, value.get() > lo)
            Text(
                "{{value.get()}}",
                style = Style(minWidth = 24, font = control_font(p.size), color = ink()),
            )
            StepButton(IC_PLUS, "Increase", p.size, fn() { bump(step) }, value.get() < hi)
        }
    }
}

/// Options for `SearchInput`.
struct SearchInputProps {
    placeholder: string = "Search",
    size: int = Size.Md,
    /// A global chord that focuses the field ("/", "cmd+k"); shown as a key
    /// hint while the field is empty. Empty = none.
    shortcut: string = "",
    /// Enter runs this with the query.
    on_submit: Option<fn(string)> = none,
    invalid: bool = false,
    disabled: bool = false,
    /// Accessible name. Empty uses the placeholder.
    label: string = "",
    style: Option<fn() -> Style> = none,
}

/// Search field: a leading magnifier, the clear X, and an optional focus
/// shortcut with its key hint. Escape clears; Enter submits.
fn SearchInput(value: Signal<string>, p: SearchInputProps) -> Node {
    let field = ref()
    fn key() {
        let k = current_key().key
        if k == Key.Escape {
            value.set("")
        } else if k == Key.Enter {
            emit_with(p.on_submit, value.get())
        }
    }
    let keys = if p.shortcut.len > 0 {
        []KeyBind { key_bind_global(p.shortcut, "search.focus", fn() { focus(field) }) }
    } else {
        no_keys()
    }
    return Box(
        style = field_chrome(p.size, invalid = p.invalid),
        restyle = p.style,
        on_click = fn() { focus(field) },
        focusable = false,
        enabled = !p.disabled,
        role = "search",
        keys = keys,
    ) {
        Icon(IC_SEARCH, control_icon(p.size), dim())
        Input(
            ref = field,
            bind = value,
            placeholder = p.placeholder,
            style = Style(grow = 1, font = control_font(p.size), padding = 0, color = ink()),
            label = field_name(p.label, p.placeholder),
            on_key_down = key,
        )
        InputClear(value, field)
        if p.shortcut.len > 0 {
            Box(style = Style(display = shown(value.get().len == 0))) {
                KbdCombo(p.shortcut)
            }
        }
    }
}

/// Options for `PasswordInput`.
struct PasswordInputProps {
    placeholder: string = "Password",
    size: int = Size.Md,
    invalid: bool = false,
    disabled: bool = false,
    /// Accessible name. Empty uses the placeholder.
    label: string = "",
    style: Option<fn() -> Style> = none,
}

/// Masked text field with a reveal toggle. The bound `value` is the real
/// text; only the drawing is masked.
fn PasswordInput(value: Signal<string>, p: PasswordInputProps) -> Node {
    // state
    let field = ref()
    let reveal = signal(false)

    // view. The field is masked until the eye reveals it.
    return Box(
        style = field_chrome(p.size, invalid = p.invalid, padEnd = 6),
        restyle = p.style,
        on_click = fn() { focus(field) },
        focusable = false,
        enabled = !p.disabled,
    ) {
        Input(
            ref = field,
            bind = value,
            placeholder = p.placeholder,
            style = Style(grow = 1, font = control_font(p.size), padding = 0, color = ink()),
            secure = !reveal.get(),
            label = field_name(p.label, p.placeholder),
        )
        Box(
            style = Style(
                width = px(control_h(p.size) - 8),
                height = px(control_h(p.size) - 8),
                shrink = 0,
                align = Align.Center,
                justify = Align.Center,
                radius = RAD_CONTROL,
                cursor = "pointer",
            ),
            on_click = fn() { reveal.set(!reveal.get()) },
            role = "button",
            label = if reveal.get() { "Hide password" } else { "Show password" },
            checked = reveal.get(),
            hoverFade = true,
        ) {
            Icon(IC_EYE, control_icon(p.size), dim(), style = Style(display = shown(!reveal.get())))
            Icon(
                IC_EYE_OFF,
                control_icon(p.size),
                dim(),
                style = Style(display = shown(reveal.get())),
            )
        }
    }
}

/// Options for `InputGroup`.
struct InputGroupProps {
    /// Text before / after the value inside the frame ("https://", "kg").
    prefix: string = "",
    suffix: string = "",
    /// Leading icon markup.
    icon: string = "",
    size: int = Size.Md,
    invalid: bool = false,
    disabled: bool = false,
    /// Accessible name. Empty uses the placeholder.
    label: string = "",
    style: Option<fn() -> Style> = none,
    keys: []KeyBind = no_keys(),
}

/// A text field with addons inside its chrome: a leading icon, a muted
/// prefix and suffix, each set off from the value by a hairline.
fn InputGroup(value: Signal<string>, placeholder: string, p: InputGroupProps) -> Node {
    let field = ref()
    return Box(
        style = field_chrome(p.size, invalid = p.invalid),
        restyle = p.style,
        on_click = fn() { focus(field) },
        focusable = false,
        enabled = !p.disabled,
        keys = p.keys,
    ) {
        if p.icon.len > 0 {
            Icon(p.icon, control_icon(p.size), dim())
        }
        if p.prefix.len > 0 {
            Text(p.prefix, style = Style(font = control_font(p.size), color = mute()))
            Box(style = Style(
                width = px(HAIRLINE),
                height = px(control_h(p.size) / 2),
                marginX = Space.Exxxs,
                background = rule(),
            ))
        }
        Input(
            ref = field,
            bind = value,
            placeholder = placeholder,
            style = Style(grow = 1, font = control_font(p.size), padding = 0, color = ink()),
            label = field_name(p.label, placeholder),
        )
        if p.suffix.len > 0 {
            Box(style = Style(
                width = px(HAIRLINE),
                height = px(control_h(p.size) / 2),
                marginX = Space.Exxxs,
                background = rule(),
            ))
            Text(p.suffix, style = Style(font = control_font(p.size), color = mute()))
        }
    }
}

/// Options for `CheckboxGroup`.
struct CheckboxGroupProps {
    /// Label of a select-all box above the options; empty = none. It is
    /// mixed while some but not all are checked.
    allLabel: string = "",
    size: int = Size.Md,
    disabled: bool = false,
}

/// A column of checkboxes, one per label, each bound to the caller's signal
/// at the same index. `allLabel` adds a select-all row that checks or clears
/// them all.
fn CheckboxGroup(labels: []string, checked: []Signal<bool>, p: CheckboxGroupProps) -> Node {
    let n = if labels.len < checked.len { labels.len } else { checked.len }
    let all = signal(false)
    let mixed = signal(false)
    let items = checked
    if p.allLabel.len > 0 {
        // Children → select-all: all on, some on (mixed), or none.
        effect(|| {
            let mut c = 0
            for i in 0..n {
                if items[i].get() {
                    c = c + 1
                }
            }
            all.set(n > 0 && c == n)
            mixed.set(c > 0 && c < n)
        })
        // Select-all → children, only when the user moved it away from what
        // the children already say.
        effect(|| {
            let a = all.get()
            let mut c = 0
            for i in 0..n {
                if peek(items[i]) {
                    c = c + 1
                }
            }
            if a && c < n {
                for i in 0..n {
                    items[i].set(true)
                }
            } else if !a && c == n && n > 0 {
                for i in 0..n {
                    items[i].set(false)
                }
            }
        })
    }
    return Box(style = Style(direction = Direction.Column, gap = Space.Exs), role = "group") {
        if p.allLabel.len > 0 {
            Checkbox(p.allLabel, all, indeterminate = mixed, size = p.size, disabled = p.disabled)
        }
        Box(style = Style(
            direction = Direction.Column,
            gap = Space.Exs,
            paddingLeft = if p.allLabel.len > 0 { 24 } else { 0 },
        )) {
            for i in 0..n {
                Checkbox(labels[i], items[i], size = p.size, disabled = p.disabled)
            }
        }
    }
}

/// Options for `RangeSlider`.
struct RangeSliderProps {
    min: int = 0,
    max: int = 100,
    step: int = 1,
    disabled: bool = false,
    label: string = "",
    style: Option<fn() -> Style> = none,
}

/// Two thumbs on one track, bound to `lo` and `hi` (`lo <= hi`). A press or
/// drag moves the nearer thumb; a thumb never passes the other. Each thumb is
/// a focusable slider: arrows step, Page keys step by a tenth, Home / End jump.
fn RangeSlider(lo: Signal<int>, hi: Signal<int>, p: RangeSliderProps) -> Node {
    // state
    let track = ref()
    let tw = signal(0)
    let mn = p.min
    let mx = if p.max > p.min { p.max } else { p.min + 1 }
    let step = if p.step > 0 { p.step } else { 1 }
    let page = if (mx - mn) / 10 > step { (mx - mn) / 10 } else { step }
    let t = SLIDER_THUMB

    // controller
    fn pos(v: int) -> int {
        return (clamp_int(v, mn, mx) - mn) * (tw.get() - t) / (mx - mn)
    }
    fn at(x: int) -> int {
        let r = rect(track)
        let travel = if r.w - t > 1 { r.w - t } else { 1 }
        return slider_snap(mn + (x - r.x - t / 2) * (mx - mn) / travel, mn, mx, step)
    }
    fn set_lo(v: int) {
        lo.set(clamp_int(slider_snap(v, mn, mx, step), mn, peek(hi)))
    }
    fn set_hi(v: int) {
        hi.set(clamp_int(slider_snap(v, mn, mx, step), peek(lo), mx))
    }
    // A press or drag on the track moves the nearer thumb; on a tie, the one
    // on the side the point is.
    fn drag() {
        if p.disabled {
            return
        }
        let v = at(current_mouse().x)
        let a = peek(lo)
        let b = peek(hi)
        let dl = if v > a { v - a } else { a - v }
        let dh = if v > b { v - b } else { b - v }
        if dl < dh || (dl == dh && v < a) {
            set_lo(v)
        } else {
            set_hi(v)
        }
    }

    // view
    return Box(
        ref = track,
        style = Style(width = pct(100), grow = 1, height = px(20), cursor = "pointer"),
        restyle = p.style,
        on_resize = fn(r: Rect) { tw.set(r.w) },
        on_drag = drag,
        role = "group",
        label = p.label,
        enabled = !p.disabled,
    ) {
        Box(
            style = Style(
                position = pos_absolute(),
                top = (20 - SLIDER_TRACK) / 2,
                left = t / 2,
                width = px(if tw.get() > t { tw.get() - t } else { 0 }),
                height = px(SLIDER_TRACK),
                radius = 1,
                background = raised(),
            ),
            role = "presentation",
        )
        Box(
            style = Style(
                position = pos_absolute(),
                top = (20 - SLIDER_TRACK) / 2,
                left = t / 2 + pos(lo.get()),
                width = px(pos(hi.get()) - pos(lo.get())),
                height = px(SLIDER_TRACK),
                radius = 1,
                background = accent(),
            ),
            role = "presentation",
        )
        RangeThumb(
            lo,
            "Minimum",
            fn() -> int { return pos(lo.get()) },
            fn(v: int) { set_lo(v) },
            step,
            page,
            mn,
            mx,
        )
        RangeThumb(
            hi,
            "Maximum",
            fn() -> int { return pos(hi.get()) },
            fn(v: int) { set_hi(v) },
            step,
            page,
            mn,
            mx,
        )
    }
}

/// One thumb of a `RangeSlider`: a focusable slider at `left()`. A thunk, read
/// inside the style, so the thumb follows its value and the track's measured
/// width (0 at build time).
fn RangeThumb(
    value: Signal<int>,
    label: string,
    left: Signal<int>,
    put: fn(int),
    step: int,
    page: int,
    mn: int,
    mx: int
) -> Node {
    let keys = []KeyBind {
        key_bind("right", "range.up", fn() { put(peek(value) + step) }),
        key_bind("up", "range.up2", fn() { put(peek(value) + step) }),
        key_bind("left", "range.down", fn() { put(peek(value) - step) }),
        key_bind("down", "range.down2", fn() { put(peek(value) - step) }),
        key_bind("pageup", "range.page_up", fn() { put(peek(value) + page) }),
        key_bind("pagedown", "range.page_down", fn() { put(peek(value) - page) }),
        key_bind("home", "range.min", fn() { put(mn) }),
        key_bind("end", "range.max", fn() { put(mx) }),
    }
    return Box(
        style = Style(
            position = pos_absolute(),
            top = (20 - SLIDER_THUMB) / 2,
            left = left.get(),
            width = px(SLIDER_THUMB),
            height = px(SLIDER_THUMB),
            radius = RAD_FULL,
            borderWidth = 2,
            borderColor = accent(),
            background = plate(),
        ),
        role = "slider",
        label = "{{label}} {{value.get()}}",
        focusable = true,
        keys = keys,
    )
}

/// Markup of the status icon for a `Tint`.
fn tint_icon(kind: int) -> string {
    switch kind {
        case Tint.Ok:
            return IC_CHECK
        case Tint.Warn, Tint.Danger:
            return IC_ALERT_CIRCLE
        default:
            return IC_INFO
    }
}

/// Options for `Banner`.
struct BannerProps {
    tint: int = Tint.Info,
    /// Show signal: an X sets it false, and the bar hides while it is false.
    dismiss: Option<Signal<bool>> = none,
    /// Trailing actions (buttons, a link).
    children: fn() = noop,
    style: Option<fn() -> Style> = none,
}

/// Full-width message bar for the top of a page or a panel: icon, message,
/// trailing actions, optional dismiss. Square, so it meets the edges.
fn Banner(message: Signal<string>, p: BannerProps) -> Node {
    let has_x = result.is_some(p.dismiss)
    let open = result.some_or(p.dismiss, no_flag_signal())
    return Box(
        style = Style(
            direction = Direction.Row,
            gap = Space.Xs,
            align = Align.Center,
            paddingY = 10,
            paddingX = Space.Sm,
            background = tint_bg(p.tint),
            borderWidth = HAIRLINE,
            borderColor = tint_line(p.tint),
        ),
        restyle = p.style,
        role = "status",
        visible = !has_x || open.get(),
    ) {
        Icon(tint_icon(p.tint), IconSize.Md, tint_ink(p.tint))
        Text(
            message,
            style = Style(grow = 1, wrap = true, font = FONT_CONTROL, color = tint_ink(p.tint)),
        )
        p.children()
        if has_x {
            Box(
                style = Style(
                    width = px(28),
                    height = px(28),
                    shrink = 0,
                    align = Align.Center,
                    justify = Align.Center,
                    radius = RAD_CONTROL,
                    cursor = "pointer",
                ),
                on_click = fn() { open.set(false) },
                role = "button",
                label = "Dismiss",
                hoverFade = true,
            ) {
                Icon(IC_X, IconSize.Md, tint_ink(p.tint))
            }
        }
    }
}

/// Options for `Callout`.
struct CalloutProps {
    tint: int = Tint.Info,
    /// Icon markup; empty uses the tint's own.
    icon: string = "",
    /// More content under the body.
    children: fn() = noop,
    style: Option<fn() -> Style> = none,
}

/// Boxed note inside content (docs, settings): tinted wash and edge, icon,
/// title, body.
fn Callout(title: Signal<string>, body: Signal<string>, p: CalloutProps) -> Node {
    return Box(
        style = Style(
            direction = Direction.Row,
            gap = Space.Xs,
            align = Align.Start,
            paddingY = Space.Xs,
            paddingX = Space.Sm,
            radius = RAD_MD,
            borderWidth = HAIRLINE,
            borderColor = tint_line(p.tint),
            background = tint_bg(p.tint),
        ),
        restyle = p.style,
        role = "note",
    ) {
        Icon(str_or_default(p.icon, tint_icon(p.tint)), IconSize.Md, tint_ink(p.tint))
        Box(style = Style(direction = Direction.Column, gap = Space.Exxxs, grow = 1)) {
            Text(title, style = Style(font = FONT_BODY, color = tint_ink(p.tint)))
            Text(body, style = Style(wrap = true, font = FONT_CONTROL, color = ink()))
            p.children()
        }
    }
}

/// One-line form message under a control: a small icon and caption text in
/// the tint's ink. Empty text hides it.
fn InlineMessage(text: Signal<string>, kind: int) -> Node {
    return Box(
        style = Style(
            direction = Direction.Row,
            gap = 6,
            align = Align.Center,
            display = shown(text.get().len > 0),
        ),
        role = if kind == Tint.Danger { "alert" } else { "status" },
    ) {
        Icon(tint_icon(kind), IconSize.Sm, tint_ink(kind))
        Text(text, style = Style(font = FONT_CONTROL, color = tint_ink(kind)))
    }
}

/// One row of a `DescriptionList`.
struct DescItem {
    term: string = "",
    detail: string = "",
}

/// Options for `DescriptionList`.
struct DescriptionListProps {
    /// Width of the term column.
    termWidth: int = 160,
    /// Hairlines between rows.
    divided: bool = true,
}

/// Term / detail pairs (an order summary, a profile). The term column is
/// `termWidth` wide; on a narrow width the detail wraps under its term.
fn DescriptionList(items: []DescItem, p: DescriptionListProps) -> Node {
    let n = items.len
    return Box(style = Style(direction = Direction.Column), role = "list") {
        Each(items, fn(i, it) {
            return Box(
                style = Style(direction = Direction.Column),
                role = "listitem",
                label = "{{it.term}}: {{it.detail}}",
            ) {
                Box(style = Style(
                    direction = Direction.Row,
                    wrap = true,
                    gap = Space.Exxxs,
                    align = Align.Start,
                    paddingY = 10,
                    paddingX = 0,
                )) {
                    Text(
                        it.term,
                        style = Style(
                            width = px(p.termWidth),
                            shrink = 0,
                            font = FONT_CONTROL,
                            color = mute(),
                        ),
                    )
                    Text(
                        it.detail,
                        style = Style(
                            grow = 1,
                            minWidth = 160,
                            wrap = true,
                            font = FONT_BODY,
                            color = ink(),
                        ),
                    )
                }
                if p.divided && i < n - 1 {
                    Separator()
                }
            }
        })
    }
}

/// The empty list a `[]string` prop defaults to.
fn no_strings() -> []string {
    return []string {}
}

/// Options for `Steps`.
struct StepsProps {
    /// Stack the steps (marker rail on the left) instead of a row.
    vertical: bool = false,
    /// A caption under each label, by index (missing = none).
    descriptions: []string = no_strings(),
    /// Done steps become buttons that run this with their index.
    on_select: Option<fn(int)> = none,
}

/// Progress through a sequence: steps before `current` are done (a check),
/// `current` is ringed, later ones are upcoming. Connectors fill as steps
/// complete.
fn Steps(current: Signal<int>, labels: []string, p: StepsProps) -> Node {
    let n = labels.len
    let descs = p.descriptions
    return Box(
        style = Style(
            direction = if p.vertical { Direction.Column } else { Direction.Row },
            gap = Space.Exs,
            align = if p.vertical { Align.Stretch } else { Align.Center },
        ),
        role = "list",
        label = "Step {{current.get() + 1}} of {{n}}",
    ) {
        Each(labels, fn(i, lab) {
            return StepItem(
                current,
                i,
                n,
                lab,
                if i < descs.len { descs[i] } else { "" },
                p.vertical,
                p.on_select,
            )
        })
    }
}

/// The state a step's accessible name ends with.
fn step_state(done: bool, here: bool) -> string {
    if done {
        return ", done"
    }
    if here {
        return ", current"
    }
    return ""
}

/// One step: marker, label (and caption), then the connector to the next.
fn StepItem(
    current: Signal<int>,
    index: int,
    count: int,
    label: string,
    desc: string,
    vertical: bool,
    pick: Option<fn(int)>
) -> Node {
    fn done() -> bool {
        return index < current.get()
    }
    fn here() -> bool {
        return index == current.get()
    }
    let clickable = result.is_some(pick)
    let last = index == count - 1
    return Box(
        style = Style(direction = Direction.Row, gap = Space.Exs, align = if vertical {
            Align.Stretch
        } else {
            Align.Center
        }),
        role = "listitem",
        label = "{{label}}{{step_state(done(), here())}}",
    ) {
        Box(style = Style(direction = Direction.Column, gap = Space.Exxxs, align = Align.Center)) {
            Box(
                style = Style(
                    width = px(24),
                    height = px(24),
                    shrink = 0,
                    direction = Direction.Row,
                    align = Align.Center,
                    justify = Align.Center,
                    radius = RAD_CONTROL,
                    borderWidth = if done() { 0 } else { 2 },
                    borderColor = if here() { accent() } else { rule() },
                    background = if done() { accent() } else { plate() },
                    cursor = if clickable && done() { "pointer" } else { "" },
                ),
                on_click = fn() {
                    if index < peek(current) {
                        emit_with(pick, index)
                    }
                },
                role = if clickable { "button" } else { "" },
                label = label,
            ) {
                Icon(IC_CHECK, IconSize.Sm, on_ink(), style = Style(display = shown(done())))
                Text(
                    "{{index + 1}}",
                    style = Style(display = shown(!done()), font = FONT_CAPTION, color = if here() {
                        ink()
                    } else {
                        mute()
                    }),
                )
            }
            if vertical && !last {
                Box(style = Style(
                    width = px(2),
                    grow = 1,
                    minHeight = 16,
                    radius = 1,
                    background = if done() { accent() } else { rule() },
                ))
            }
        }
        Box(style = Style(
            direction = Direction.Column,
            gap = 2,
            paddingBottom = if vertical && !last { 16 } else { 0 },
        )) {
            Text(
                label,
                style = Style(font = FONT_CONTROL, color = if here() || done() {
                    ink()
                } else {
                    mute()
                }),
            )
            if desc.len > 0 {
                Text(desc, style = Style(font = FONT_CAPTION, color = mute()))
            }
        }
        if !vertical && !last {
            Box(style = Style(
                width = px(48),
                height = px(2),
                shrink = 0,
                radius = 1,
                background = if done() { accent() } else { rule() },
            ))
        }
    }
}

// --- tier B molecules: fields, lists, feedback, navigation ---------------

/// `true` only when `xs` holds `s`.
fn str_has(xs: []string, s: string) -> bool {
    for i in 0..xs.len {
        if fmt.eq(xs[i], s) {
            return true
        }
    }
    return false
}

/// `xs` without every copy of `s`.
fn str_without(xs: []string, s: string) -> []string {
    let mut out = []string {}
    for i in 0..xs.len {
        if !fmt.eq(xs[i], s) {
            push(out, xs[i])
        }
    }
    return out
}

/// `xs` plus `s`, unless `s` is empty or already there.
fn str_add(xs: []string, s: string) -> []string {
    if s.len == 0 || str_has(xs, s) {
        return xs
    }
    let mut out = []string {}
    for i in 0..xs.len {
        push(out, xs[i])
    }
    // The field's bind can alias the edit buffer. Copy before the clear
    // that follows a commit, or the stored chip loses its first byte.
    push(out, str_slice(s, 0, s.len))
    return out
}

/// `xs` without its last item. Empty stays empty.
fn str_drop_last(xs: []string) -> []string {
    let mut out = []string {}
    let n = xs.len
    if n == 0 {
        return out
    }
    for i in 0..n - 1 {
        push(out, xs[i])
    }
    return out
}

/// Options still available in a `MultiSelect`: match `q`, skip what's picked.
fn multi_filter(options: []string, selected: []string, q: string) -> []string {
    let mut out = []string {}
    for i in 0..options.len {
        if ci_has(options[i], q) && !str_has(selected, options[i]) {
            push(out, options[i])
        }
    }
    return out
}

/// Digits of `s`, at most `n`.
fn pin_clean(s: string, n: int) -> string {
    let mut b = []int {}
    for i in 0..s.len {
        if b.len >= n {
            break
        }
        let c = s[i]
        if c >= 48 && c <= 57 {
            push(b, c)
        }
    }
    return string_from_bytes(b)
}

/// The character `PinInput` shows in cell `i` (a bullet when masked).
fn pin_char(s: string, i: int, masked: bool) -> string {
    if i < 0 || i >= s.len {
        return ""
    }
    if masked {
        return "•"
    }
    return str_slice(s, i, i + 1)
}

/// A `picked` that is never on, for `ListItem`'s default.
fn never_on() -> bool {
    return false
}

/// 0 empty, 1 half, 2 full. `value` is whole stars, or half-stars when `half`.
fn star_kind(value: int, index: int, half: bool) -> int {
    if half {
        let full = (index + 1) * 2
        if value >= full {
            return 2
        }
        if value >= full - 1 {
            return 1
        }
        return 0
    }
    if value > index {
        return 2
    }
    return 0
}

/// Options for `MultiSelect`.
struct MultiSelectProps {
    placeholder: string = "Select",
    size: int = Size.Md,
    disabled: bool = false,
    invalid: bool = false,
    label: string = "",
    style: Option<fn() -> Style> = none,
}

/// Chips for the current pick, plus a field that filters `options`. Choosing
/// a row adds a chip; the chip's X removes it. Backspace in an empty field
/// removes the last chip.
fn MultiSelect(selected: Signal<[]string>, options: []string, p: MultiSelectProps) -> Node {
    let query = signal("")
    let open = signal(false)
    let matches = signal([]string {})
    let opts = options
    let field = ref()
    let input = ref()
    effect(|| {
        matches.set(multi_filter(opts, selected.get(), query.get()))
    })
    fn add(s: string) {
        selected.set(str_add(peek(selected), s))
        query.set("")
    }
    fn key() {
        let k = current_key().key
        if k == Key.Backspace && peek(query).len == 0 {
            selected.set(str_drop_last(peek(selected)))
        } else if k == Key.Enter {
            let ms = peek(matches)
            if ms.len > 0 {
                add(ms[0])
            }
        } else if k == Key.Escape {
            open.set(false)
        } else if k == Key.Down {
            open.set(true)
        }
    }
    let size = p.size
    return Box(
        style = Style(direction = Direction.Column, alignSelf = Align.Start),
        restyle = p.style,
        role = "group",
        label = p.label,
        enabled = !p.disabled,
    ) {
        Box(
            ref = field,
            style = Style(
                minHeight = control_h(size),
                direction = Direction.Row,
                wrap = true,
                gap = Space.Exxxs,
                align = Align.Center,
                paddingX = control_pad_x(size),
                radius = RAD_CONTROL,
                borderWidth = HAIRLINE,
                borderColor = invalid_edge(p.invalid),
                background = plate(),
                cursor = "text",
            ),
            on_click = fn() { open.set(true); focus(input) },
            focusable = false,
        ) {
            Each(selected.get(), fn(i, s) {
                return Tag(s, on_remove = fn() { selected.set(str_without(peek(selected), s)) })
            })
            Input(
                ref = input,
                bind = query,
                placeholder = p.placeholder,
                label = p.placeholder,
                style = Style(
                    grow = 1,
                    minWidth = 48,
                    font = control_font(size),
                    padding = 0,
                    color = ink(),
                ),
                on_key_down = key,
                on_click = fn() { open.set(true) },
            )
        }
        Box(
            style = floating_panel(MENU_MIN_W),
            anchor = Anchor(to = field, place = Place.PlaceBelow, gap = Space.Exxxs),
            visible = open.get(),
            enter = Enter.Fade,
        ) {
            Each(matches.get(), fn(i, s) {
                return Box(
                    style = Style(
                        direction = Direction.Row,
                        align = Align.Center,
                        paddingY = 6,
                        paddingX = Space.Exs,
                        radius = RAD_SM,
                        cursor = "pointer",
                    ),
                    hoverStyle = Style(background = raised()),
                    on_click = fn() { add(s) },
                    role = "option",
                    label = s,
                ) {
                    Text(s, style = Style(font = FONT_BODY, color = ink()))
                }
            })
        }
    }
}

/// Options for `TagInput`.
struct TagInputProps {
    placeholder: string = "Add a tag",
    size: int = Size.Md,
    disabled: bool = false,
    invalid: bool = false,
    label: string = "",
    style: Option<fn() -> Style> = none,
}

/// Free-form chips. Enter commits the field; Backspace in an empty field
/// removes the last chip.
fn TagInput(tags: Signal<[]string>, p: TagInputProps) -> Node {
    let draft = signal("")
    let input = ref()
    let size = p.size
    fn commit() {
        let t = peek(draft)
        if t.len == 0 {
            return
        }
        tags.set(str_add(peek(tags), t))
        draft.set("")
    }
    fn key() {
        let k = current_key().key
        if k == Key.Enter {
            commit()
        } else if k == Key.Backspace && peek(draft).len == 0 {
            tags.set(str_drop_last(peek(tags)))
        }
    }
    return Box(
        style = Style(
            minHeight = control_h(size),
            direction = Direction.Row,
            wrap = true,
            gap = Space.Exxxs,
            align = Align.Center,
            paddingX = control_pad_x(size),
            radius = RAD_CONTROL,
            borderWidth = HAIRLINE,
            borderColor = if p.invalid { danger_edge() } else { rule() },
            background = plate(),
        ),
        restyle = p.style,
        role = "group",
        label = p.label,
        enabled = !p.disabled,
        on_click = fn() { focus(input) },
    ) {
        Each(tags.get(), fn(i, s) {
            return Tag(s, on_remove = fn() { tags.set(str_without(peek(tags), s)) })
        })
        Input(
            ref = input,
            bind = draft,
            placeholder = p.placeholder,
            label = p.placeholder,
            style = Style(
                grow = 1,
                minWidth = 80,
                font = control_font(size),
                padding = 0,
                color = ink(),
            ),
            on_key_down = key,
        )
    }
}

/// Options for `PinInput`.
struct PinInputProps {
    /// How many cells.
    length: int = 6,
    /// Bullets instead of digits.
    masked: bool = false,
    size: int = Size.Md,
    disabled: bool = false,
    invalid: bool = false,
    /// Accessible name of the field.
    label: string = "Code",
    style: Option<fn() -> Style> = none,
}

/// One cell of a `PinInput`: the digit (or a bullet), ringed when it's next.
fn PinCell(value: Signal<string>, index: int, masked: bool, size: int, invalid: bool) -> Node {
    let h = control_h(size)
    return Box(style = Style(
        width = px(h),
        height = px(h),
        shrink = 0,
        align = Align.Center,
        justify = Align.Center,
        radius = RAD_MD,
        borderWidth = HAIRLINE,
        borderColor = if invalid {
            danger_edge()
        } else if value.get().len == index {
            accent()
        } else {
            rule()
        },
        background = plate(),
    )) {
        Text(
            fn() -> string { return pin_char(value.get(), index, masked) },
            style = Style(font = control_font(size), color = ink()),
        )
    }
}

/// N cells, one value. Typing, pasting, and Backspace edit the whole code;
/// extra characters and non-digits are dropped, and the next empty cell is ringed.
fn PinInput(value: Signal<string>, p: PinInputProps) -> Node {
    let n = if p.length > 0 && p.length <= 12 { p.length } else { 6 }
    let field = ref()
    let masked = p.masked
    let size = p.size
    effect(|| {
        let s = value.get()
        let c = pin_clean(s, n)
        if !fmt.eq(s, c) {
            value.set(c)
        }
    })
    return Box(
        style = Style(
            position = Position.Relative,
            direction = Direction.Row,
            gap = Space.Exs,
            align = Align.Center,
        ),
        restyle = p.style,
        enabled = !p.disabled,
        on_click = fn() { focus(field) },
    ) {
        for i in 0..n {
            PinCell(value, i, masked, size, p.invalid)
        }
        Input(
            ref = field,
            bind = value,
            label = p.label,
            style = Style(
                position = pos_absolute(),
                top = 0,
                right = 0,
                bottom = 0,
                left = 0,
                opacity = 0,
                color = plate(),
            ),
        )
    }
}

/// Options for `Rating`.
struct RatingProps {
    /// Star count.
    max: int = 5,
    /// `value` counts half-stars (7 is three and a half) instead of whole stars.
    half: bool = false,
    readOnly: bool = false,
    disabled: bool = false,
    label: string = "Rating",
    style: Option<fn() -> Style> = none,
}

/// One star. Kind 0/1/2 is empty, half, or full. A half is the filled glyph
/// clipped to its left half, over the outline, so the right half stays empty.
fn RatingStar(value: Signal<int>, index: int, half: bool, read_only: bool, put: fn(int)) -> Node {
    let star = ref()
    fn pick() {
        if read_only {
            return
        }
        let r = rect(star)
        let local = current_mouse().x - r.x
        let mut n = index + 1
        if half && local < r.w / 2 {
            n = index * 2 + 1
        } else if half {
            n = index * 2 + 2
        }
        put(n)
    }
    fn kind() -> int {
        return star_kind(value.get(), index, half)
    }
    return Box(
        ref = star,
        style = Style(
            width = px(20),
            height = px(20),
            shrink = 0,
            align = Align.Center,
            justify = Align.Center,
            cursor = if read_only { "" } else { "pointer" },
        ),
        on_click = pick,
        role = "radio",
        label = "Star {{index + 1}}",
        checked = kind() == 2,
        focusable = !read_only,
    ) {
        Icon(IC_STAR_OFF, 20, mute(), style = Style(display = shown(kind() < 2)))
        Icon(IC_STAR, 20, accent(), style = Style(display = shown(kind() == 2)))
        // Absolute, so the 20px glyph is not squeezed into this 10px window.
        // Overflow hidden paints only the left half.
        Box(style = Style(
            position = pos_absolute(),
            top = 0,
            left = 0,
            width = px(10),
            height = px(20),
            overflow = Overflow.Hidden,
            display = shown(kind() == 1),
        )) {
            Icon(IC_STAR, 20, accent(), style = Style(position = pos_absolute(), top = 0, left = 0))
        }
    }
}

/// A row of stars. `value` is the pick: whole stars, or half-stars when `half`.
/// Left / right nudge it while the row is focused. `readOnly` draws it with no keys.
fn Rating(value: Signal<int>, p: RatingProps) -> Node {
    let max = if p.max > 0 { p.max } else { 5 }
    let half = p.half
    let cap = if half { max * 2 } else { max }
    let read_only = p.readOnly || p.disabled
    fn put(v: int) {
        let mut n = v
        if v < 0 {
            n = 0
        } else if v > cap {
            n = cap
        }
        value.set(n)
    }
    let rate_keys = []KeyBind {
        key_bind("right", "rate.up", fn() { put(peek(value) + 1) }),
        key_bind("left", "rate.down", fn() { put(peek(value) - 1) }),
        key_bind("home", "rate.min", fn() { put(0) }),
        key_bind("end", "rate.max", fn() { put(cap) }),
    }
    return Box(
        style = Style(direction = Direction.Row, gap = 2, align = Align.Center),
        restyle = p.style,
        role = "slider",
        label = "{{p.label}} {{value.get()}}",
        focusable = !read_only,
        keys = if read_only { no_keys() } else { rate_keys },
    ) {
        for i in 0..max {
            RatingStar(value, i, half, read_only, put)
        }
    }
}

/// Options for `CheckboxCard` and `RadioCard`.
struct ChoiceCardProps {
    disabled: bool = false,
    style: Option<fn() -> Style> = none,
}

/// The square mark on a choice card.
fn choice_mark(on: Signal<bool>, radio: bool) -> Node {
    return Box(style = Style(
        width = px(CHECK),
        height = px(CHECK),
        shrink = 0,
        align = Align.Center,
        justify = Align.Center,
        radius = if radio { RAD_FULL } else { RAD_CHECK },
        borderWidth = HAIRLINE,
        borderColor = if on.get() { accent() } else { rule() },
        background = if on.get() && !radio { accent() } else { plate() },
    )) {
        Icon(IC_CHECK, 12, on_ink(), style = Style(display = shown(on.get() && !radio)))
        Box(style = Style(
            width = px(RADIO_DOT),
            height = px(RADIO_DOT),
            radius = RAD_FULL,
            background = accent(),
            display = shown(on.get() && radio),
        ))
    }
}

/// A selectable card: the whole surface toggles `on`. The mark is drawn, not a
/// nested `Checkbox`, so the click happens once.
fn CheckboxCard(title: string, body: string, on: Signal<bool>, p: ChoiceCardProps) -> Node {
    fn picked() -> bool {
        return on.get()
    }
    return Box(
        style = Style(
            direction = Direction.Column,
            gap = Space.Exxxs,
            padding = Space.Sm,
            radius = RAD_LG,
            cursor = "pointer",
            borderWidth = HAIRLINE,
            borderColor = if picked() { accent() } else { rule() },
            background = if picked() { wash() } else { plate() },
            opacity = if p.disabled { 60 } else { 100 },
        ),
        restyle = p.style,
        on_click = fn() {
            if !p.disabled {
                on.set(!on.get())
            }
        },
        role = "checkbox",
        label = title,
        checked = picked,
        enabled = !p.disabled,
    ) {
        Box(style = Style(direction = Direction.Row, gap = Space.Exs, align = Align.Center)) {
            choice_mark(picked, false)
            Text(title, style = Style(font = FONT_BODY, color = ink()))
        }
        if body.len > 0 {
            Text(body, style = Style(wrap = true, font = FONT_CONTROL, color = mute()))
        }
    }
}

/// A selectable card in a radio set. `index` is what `value` holds when this
/// card is the pick.
fn RadioCard(
    title: string,
    body: string,
    value: Signal<int>,
    index: int,
    p: ChoiceCardProps
) -> Node {
    fn picked() -> bool {
        return value.get() == index
    }
    return Box(
        style = Style(
            direction = Direction.Column,
            gap = Space.Exxxs,
            padding = Space.Sm,
            radius = RAD_LG,
            cursor = "pointer",
            borderWidth = HAIRLINE,
            borderColor = if picked() { accent() } else { rule() },
            background = if picked() { wash() } else { plate() },
        ),
        restyle = p.style,
        on_click = fn() {
            if !p.disabled {
                value.set(index)
            }
        },
        role = "radio",
        label = title,
        checked = picked,
        enabled = !p.disabled,
    ) {
        Box(style = Style(direction = Direction.Row, gap = Space.Exs, align = Align.Center)) {
            choice_mark(picked, true)
            Text(title, style = Style(font = FONT_BODY, color = ink()))
        }
        if body.len > 0 {
            Text(body, style = Style(wrap = true, font = FONT_CONTROL, color = mute()))
        }
    }
}

/// Options for `List`.
struct ListProps {
    label: string = "",
    style: Option<fn() -> Style> = none,
    children: fn() = noop,
}

/// A vertical list. Rows are `ListItem`.
fn List(p: ListProps) -> Node {
    return Box(
        style = Style(direction = Direction.Column),
        restyle = p.style,
        role = "list",
        label = p.label,
    ) {
        p.children()
    }
}

/// Options for `ListItem`.
struct ListItemProps {
    /// Leading icon markup. Empty skips it.
    icon: string = "",
    /// Muted text at the end of the row. Empty skips it.
    trailing: Signal<string> = "",
    /// Raised wash while this returns true.
    picked: Signal<bool> = false,
    disabled: bool = false,
    on_click: Option<fn()> = none,
    size: int = Size.Md,
    keys: []KeyBind = no_keys(),
    /// The row holds the group's roving tab stop while this is true.
    roving: Signal<bool> = false,
    style: Option<fn() -> Style> = none,
}

/// A list row: optional icon, title, optional trailing text. The base for
/// menus, settings, and `ListBox`.
fn ListItem(title: Signal<string>, p: ListItemProps) -> Node {
    return Box(
        style = Style(
            minHeight = control_h(p.size),
            direction = Direction.Row,
            gap = Space.Exs,
            align = Align.Center,
            paddingX = Space.Exs,
            radius = RAD_MD,
            background = if p.picked.get() { raised() } else { "" },
            cursor = if p.disabled { "" } else { "pointer" },
        ),
        restyle = p.style,
        on_click = p.on_click,
        role = "listitem",
        label = title,
        enabled = !p.disabled,
        focusable = true,
        roving = p.roving,
        keys = p.keys,
    ) {
        if p.icon.len > 0 {
            Icon(p.icon, control_icon(p.size), mute())
        }
        Text(
            title,
            style = Style(grow = 1, ellipsis = true, font = control_font(p.size), color = ink()),
        )
        Text(
            p.trailing,
            style = Style(
                font = FONT_CAPTION,
                color = mute(),
                display = shown(p.trailing.get().len > 0),
            ),
        )
    }
}

/// Options for `ListBox`.
struct ListBoxProps {
    label: string = "",
    size: int = Size.Md,
    disabled: bool = false,
    style: Option<fn() -> Style> = none,
}

/// An always-open single choice. Arrows move the pick; Home and End jump.
fn ListBox(value: Signal<int>, labels: []string, p: ListBoxProps) -> Node {
    let n = labels.len
    let size = p.size
    return Box(
        style = Style(direction = Direction.Column, gap = 2),
        restyle = p.style,
        role = "listbox",
        label = p.label,
        enabled = !p.disabled,
    ) {
        Each(labels, fn(i, lab) {
            return ListItem(
                lab,
                picked = fn() -> bool { return value.get() == i },
                roving = fn() -> bool { return value.get() == i },
                size = size,
                disabled = p.disabled,
                on_click = fn() { value.set(i) },
                keys = roving_keys("list", value, i, n, true),
            )
        })
    }
}

/// One event on a `Timeline`.
struct TimelineItem {
    title: string = "",
    body: string = "",
    time: string = "",
}

/// Dot, rail, and text. Done events (before the last) share the accent rail.
fn Timeline(items: []TimelineItem) -> Node {
    let n = items.len
    return Box(style = Style(direction = Direction.Column), role = "list") {
        Each(items, fn(i, it) {
            return Box(
                style = Style(direction = Direction.Row, gap = Space.Xs, align = Align.Stretch),
                role = "listitem",
                label = it.title,
            ) {
                Box(style = Style(
                    direction = Direction.Column,
                    align = Align.Center,
                    width = px(16),
                )) {
                    Box(style = Style(
                        width = px(DOT),
                        height = px(DOT),
                        shrink = 0,
                        radius = RAD_FULL,
                        background = if i == n - 1 { accent() } else { mute() },
                    ))
                    if i < n - 1 {
                        Box(style = Style(
                            width = px(2),
                            grow = 1,
                            minHeight = 24,
                            background = rule(),
                        ))
                    }
                }
                Box(style = Style(
                    direction = Direction.Column,
                    gap = 2,
                    paddingBottom = if i < n - 1 { 16 } else { 0 },
                )) {
                    Box(style = Style(
                        direction = Direction.Row,
                        gap = Space.Exs,
                        align = Align.Center,
                    )) {
                        Text(it.title, style = Style(font = FONT_BODY, color = ink()))
                        if it.time.len > 0 {
                            Text(it.time, style = Style(font = FONT_CAPTION, color = dim()))
                        }
                    }
                    if it.body.len > 0 {
                        Text(
                            it.body,
                            style = Style(wrap = true, font = FONT_CONTROL, color = mute()),
                        )
                    }
                }
            }
        })
    }
}

/// Arrow and caption for a delta. Empty text hides it. Up is ok, Down is danger.
fn TrendIndicator(delta: Signal<string>, trend: int) -> Node {
    return Box(
        style = Style(
            direction = Direction.Row,
            gap = 2,
            align = Align.Center,
            display = shown(delta.get().len > 0),
        ),
        role = "status",
    ) {
        if trend == Trend.Up {
            Icon(IC_TREND_UP, IconSize.Sm, trend_tint(trend))
        }
        if trend == Trend.Down {
            Icon(IC_TREND_DOWN, IconSize.Sm, trend_tint(trend))
        }
        Text(delta, style = Style(font = FONT_CAPTION, color = trend_tint(trend)))
    }
}

/// `Stat` with the sparkline fixed at 64×18. Same props: delta, trend, spark.
fn KpiCard(label: Signal<string>, value: Signal<string>, kind: int, p: StatProps) -> Node {
    return Card() {
        Text(label, style = Style(font = FONT_CONTROL, color = mute()))
        Row(Space.Xs) {
            Text(value, style = Style(font = 26, color = tint_of(kind)))
            if result.is_some(p.spark) {
                Sparkline(p.spark.val, 64, 18, trend_tint(p.trend))
            }
        }
        TrendIndicator(p.delta, p.trend)
    }
}

/// Options for `EmptyState` and `ErrorView`.
struct EmptyStateProps {
    icon: string = "",
    title: Signal<string> = "",
    body: Signal<string> = "",
    children: fn() = noop,
    style: Option<fn() -> Style> = none,
}

/// Icon, title, prose capped at `PROSE_W`, then the trailing action.
fn EmptyState(p: EmptyStateProps) -> Node {
    return Box(
        style = Style(
            direction = Direction.Column,
            gap = Space.Xs,
            align = Align.Center,
            justify = Align.Center,
            padding = Space.Xl,
        ),
        restyle = p.style,
    ) {
        if p.icon.len > 0 {
            Box(style = Style(
                width = px(RING),
                height = px(RING),
                shrink = 0,
                align = Align.Center,
                justify = Align.Center,
                radius = RAD_LG,
                background = raised(),
            )) {
                Icon(p.icon, IconSize.Xxl, dim())
            }
        }
        Text(p.title, style = Style(width = pct(-1), font = FONT_TITLE, color = ink()))
        Text(
            p.body,
            style = Style(wrap = true, maxWidth = PROSE_W, font = FONT_BODY, color = mute()),
        )
        p.children()
    }
}

/// Options for `ErrorView`.
struct ErrorViewProps {
    on_retry: Option<fn()> = none,
    style: Option<fn() -> Style> = none,
}

/// A failed load: alert icon, title, prose, and a Try again button when
/// `on_retry` is set.
fn ErrorView(title: Signal<string>, body: Signal<string>, p: ErrorViewProps) -> Node {
    let has_retry = result.is_some(p.on_retry)
    let retry = result.some_or(p.on_retry, noop)
    return EmptyState(icon = IC_ALERT_CIRCLE, title = title, body = body, style = p.style) {
        if has_retry {
            Button("Try again", look = Look.Solid, on_click = retry)
        }
    }
}

/// Options for `LoadMore`.
struct LoadMoreProps {
    /// While true the button is inert and shows a spinner.
    loading: Option<Signal<bool>> = none,
    /// While true the button is replaced by "End of the list".
    done: Option<Signal<bool>> = none,
    on_load: Option<fn()> = none,
    style: Option<fn() -> Style> = none,
}

/// A feed's next page. Hidden once `done` is set.
fn LoadMore(p: LoadMoreProps) -> Node {
    let has_done = result.is_some(p.done)
    let done = result.some_or(p.done, no_flag_signal())
    return Box(
        style = Style(direction = Direction.Column, align = Align.Center, gap = Space.Exs),
        restyle = p.style,
    ) {
        Text(
            "End of the list",
            style = Style(
                font = FONT_CONTROL,
                color = mute(),
                display = shown(has_done && done.get()),
            ),
        )
        Box(style = Style(align = Align.Center, display = shown(!(has_done && done.get())))) {
            Button("Load more", look = Look.Outline, loading = p.loading, on_click = p.on_load)
        }
    }
}

/// The empty list an `[]int` prop defaults to.
fn no_ints() -> []int {
    return []int {}
}

/// Options for `TableOfContents`.
struct TocProps {
    /// Document offset where each section starts. With `scroll`, the highlight
    /// follows the reading position.
    offsets: []int = no_ints(),
    scroll: Option<Signal<int>> = none,
    style: Option<fn() -> Style> = none,
}

/// One contents row.
fn TocRow(current: Signal<int>, index: int, label: string) -> Node {
    return Box(
        style = Style(
            paddingY = Space.Exxxs,
            paddingX = Space.Exs,
            radius = RAD_SM,
            cursor = "pointer",
            background = if current.get() == index { raised() } else { "" },
        ),
        on_click = fn() { current.set(index) },
        role = "link",
        label = label,
    ) {
        Text(
            label,
            style = Style(font = FONT_CONTROL, color = if current.get() == index {
                ink()
            } else {
                mute()
            }),
        )
    }
}

/// Section links. Pass `scroll` and `offsets` and the highlight tracks the
/// scroll offset (the last section whose offset the scroll has reached).
fn TableOfContents(current: Signal<int>, labels: []string, p: TocProps) -> Node {
    let offs = p.offsets
    let spy = result.is_some(p.scroll) && offs.len > 0
    let y = result.some_or(p.scroll, signal(0))
    if spy {
        effect(|| {
            let at = y.get()
            let mut cur = 0
            for i in 0..offs.len {
                if at >= offs[i] {
                    cur = i
                }
            }
            if peek(current) != cur {
                current.set(cur)
            }
        })
    }
    return Box(
        style = Style(direction = Direction.Column, gap = 2),
        restyle = p.style,
        role = "navigation",
        label = "Contents",
    ) {
        Each(labels, fn(i, lab) {
            return TocRow(current, i, lab)
        })
    }
}
