//! molecules — the single-purpose controls: Button, IconButton, the text fields,
//! Checkbox / Radio / Switch / Toggle, Slider, Select / Segmented / Choice, Tabs,
//! Alert, Breadcrumbs, Pagination, User.
//!
//! Built on `atoms` and `zeusbase`.

import "zeus:structs"
import "zeus:enums"
import "zeus:zeusbase"
import "std:result"
import "zeus-components:colors"
import "zeus-components:spacing"
import "zeus:zeus_constants"
import "std:async"
import "std:fmt"
import "zeus-components:atoms"
import "zeus:zeuscore/geometry"
import "zeus:zeuscore/platform"
import "zeus:zeuscore/arena"

/// Options for `Button`. Default `look = Look.Solid` (gallery "Primary")
/// paints themed chrome. `look = -1` is a plain clickable label styled by
/// `background` / `color` / `font` / `padding` / `radius` / `width` /
/// `height` / `enabled` (dims when false). `on_click` fires it.
struct ButtonProps {
    /// Label of the Button. A thunk, so `"n = {{count.get()}}"` keeps
    /// updating; the compiler lifts a plain expression into it.
    label: fn() -> string = empty_text,
    /// `Look` token for themed chrome; `-1` = raw (props below decide the look).
    look: int = Look.Solid,
    /// `Size` token for themed chrome.
    size: int = Size.Md,
    /// Style, merged over the recipe's own: `style = Style(radius = corners(4))`.
    style: Option<fn() -> Style> = none,
    /// `enabled = form_valid.get()` dims and disables reactively.
    enabled: bool = true,
    /// `true` silences the gray hover wash.
    /// Set `hoverOff = false` to let the button wash on hover.
    hoverOff: bool = false,
    /// Leading icon markup (`IC_PLUS`, ...). Sized to the `Size` token and
    /// tinted like the label. Themed chrome only.
    icon: string = "",
    /// While true the button is inert (no click, hover, or press), dims, and
    /// a spinner takes the icon slot. Themed chrome only.
    loading: Option<Signal<bool>> = none,
    on_click: Option<fn()> = none,
    /// Keyboard actions on this element (`chord(...)`, `chord_click(...)`).
    keys: []KeyBind = no_keys(),
}

struct InputProps {
    placeholder: string = "",
    bind: Option<Signal<string>> = none,
    label: Option<fn() -> string> = none,
    /// Multiline: Enter inserts a newline, wrap + caret up/down.
    multiline: bool = false,
    style: Option<fn() -> Style> = none,
    ref: Option<Ref> = none,
    on_click: Option<fn()> = none,
    on_key_down: Option<fn()> = none,
    on_key_up: Option<fn()> = none,
    on_key_press: Option<fn()> = none,
    /// Keyboard actions on this element (`chord(...)`, `chord_click(...)`).
    keys: []KeyBind = no_keys(),
}

/// Action button. Default `look = Look.Solid`. `look = -1` is a plain label.
fn Button(p: ButtonProps) -> Node {
    if p.look >= 0 {
        return BtnLook(p)
    }
    // A plain clickable label: the caller's style is the whole look.
    return Component(raw_button(""),
                     text = p.label,
                     style = p.style,
                     enabled = p.enabled,
                     on_click = p.on_click,
                     hoverOff = p.hoverOff,
                     role = "button",
                     label = p.label(),
                     press = result.is_some(p.on_click),
                     hoverFade = !p.hoverOff,
                     pressScale = true,
                     keys = p.keys)
}

/// Disabled fill for themed chrome: a muted plate instead of the accent at
/// 40% alpha, so a disabled Solid button reads as a control that is off
/// rather than a washed-out one. Outline keeps its ring on `rule()`.
fn button_disabled_background(look: int) -> string {
    match look {
        Look.Ghost | Look.Link => { return "" }
        _ => { return raised() }
    }
}

/// Icon size for a `Size` token; see `button_padding_x`.
fn button_icon(size: int) -> int {
    if size == Size.Sm { 14 } else { 16 }
}

/// Text field. `multiline = true` wraps and lets Enter insert a newline.
/// `bind = sig` writes the committed buffer into a `Signal<string>` on every
/// edit; the store notifies only on a real change.
fn Input(p: InputProps) -> Node {
    return Component(raw_input(p.placeholder), style = p.style, label = p.label,
                     multiline = p.multiline, role = "textbox", edit = p.bind,
                     on_key_down = p.on_key_down, on_key_up = p.on_key_up,
                     on_key_press = p.on_key_press, ref = p.ref, keys = p.keys,
                     on_click = p.on_click)
}

/// Side padding for a `Size` token. Button geometry is a set of small
/// pickers so a recipe reads one token and gets a consistent control.
fn button_padding_x(size: int) -> int {
    if size == Size.Sm { 12 } else if size == Size.Lg { 32 } else { 16 }
}

/// Control height for a `Size` token; see `button_padding_x`.
fn button_height(size: int) -> int {
    if size == Size.Sm { 32 } else if size == Size.Lg { 40 } else { 36 }
}

/// Label size for a `Size` token; see `button_padding_x`.
fn button_font(size: int) -> int {
    if size == Size.Sm { 12 } else { FONT_BODY }
}

/// Corner radius for a `Size` token; see `button_padding_x`.
fn button_radius(size: int) -> int {
    return RAD_MD
}

/// Fill for a `Look` token. Returns a theme accessor result, so calling it
/// inside a prop expression keeps the button following the palette.
fn button_background(look: int) -> string {
    match look {
        Look.Solid => { return accent() }
        Look.Soft => { return raised() }
        Look.Outline => { return plate() }
        Look.Danger => { return danger_solid() }
        _ => { return "" }
    }
}

/// Label color for a `Look` token; see `button_background`.
fn button_color(look: int) -> string {
    match look {
        Look.Solid => { return on_ink() }
        Look.Danger => { return on_danger() }
        _ => { return ink() }
    }
}

/// Border width for a `Look` token — only the outline look carries one.
fn button_border_width(look: int) -> int {
    match look {
        Look.Outline => { return HAIRLINE }
        _ => { return 0 }
    }
}

/// Border color for a `Look` token; see `button_border_width`.
fn button_border_color(look: int) -> string {
    match look {
        Look.Outline => { return rule() }
        _ => { return "" }
    }
}

/// Icon-only button: square, 16px glyph in the `look` chrome. `size` picks
/// a 32 / 36 / 40px box. `on_click` is optional —
/// omit it for a look-only demo
/// (`IconButton(IC_X, Look.Ghost, Size.Md, "Close")`).
struct IconButtonProps {
    on_click: Option<fn()> = none,
    /// Style, merged over the recipe's own: `style = Style(radius = corners(4))`.
    style: Option<fn() -> Style> = none,
    /// Keyboard actions on this element (`chord(...)`, `chord_click(...)`).
    keys: []KeyBind = no_keys(),
}

fn IconButton(markup: string, look: int, size: int, label: string,
              p: IconButtonProps) -> Node {
    return // `hoverFade`: the square stays a hover target without a handler.
    Box(
        style = merge(Style(width = px(button_height(size)), height = px(button_height(size)),
                            direction = Direction.Row, align = Align.Center,
                            justify = Align.Center, radius = corners(button_radius(size)),
                            border = Border(width = button_border_width(look),
                                            color = opt_color(button_border_color(look))),
                            background = opt_color(button_background(look)),
                            cursor = "pointer"),
                      style_of(p.style)),
        on_click = p.on_click,
        role = "button",
        label = label,
        hoverOff = false,
        press = true,
        hoverFade = true,
        keys = p.keys
    ) {
        Icon(markup, 16, text_color(style_of(p.style), button_color(look)))
    }
}

/// Toggle `on`. Native toggle: off track = input, on track = primary,
/// thumb rides on `background`. Pass `appearance()` for Dark mode.
fn Switch(on: Signal<bool>) -> Node {
    // The native thumb tweens off an int signal; `on` is the state.
    let shown_on = flag_int(on)
    return Component(raw_toggle(),
                     bind = shown_on,
                     style = Style(width = px(36), height = px(20), radius = corners(10), cursor = "pointer"),
                     on_click = fn() => on.set(!on.get()),
                     role = "switch",
                     hoverOff = true)
}

/// The light / dark switch: the native toggle bound to `appearance()` (an
/// engine-level 0/1 signal every role token resolves against at paint).
fn ThemeSwitch() -> Node {
    let dark = appearance()
    return Component(raw_toggle(),
                     bind = dark,
                     style = Style(width = px(36), height = px(20), radius = corners(10), cursor = "pointer"),
                     on_click = fn() => dark.set(1 - dark.get()),
                     role = "switch",
                     label = "Dark mode",
                     hoverOff = true)
}

/// Slider. Track is `primary/20`-ish, filled range primary, thumb surface.
fn Slider(value: Signal<int>) -> Node {
    return Component(raw_slider(),
                     bind = value,
                     style = Style(width = px(220), height = px(20), radius = corners(10), cursor = "pointer"),
                     role = "slider",
                     hoverOff = true)
}

/// Alert: rounded bordered panel, leading icon, title + description.
/// `tone` picks the tier (`Tone.Info` default, `.Ok`, `.Warn`, `.Danger`).
/// `dismiss` is a show signal (X sets it false). Trailing block is the action slot,
/// under the body.
struct AlertProps {
    /// Style, merged over the recipe's own: `style = Style(radius = corners(4))`.
    style: Option<fn() -> Style> = none,
    /// Tone: `Tone.Info` (default), `Tone.Ok`, `Tone.Warn`, `Tone.Danger`.
    tone: int = 0,
    /// Show signal. When passed, the alert hides while it is false, and an X
    /// in the title row sets it false.
    dismiss: Option<Signal<bool>> = none,
    /// Keyboard actions on this element (`chord(...)`, `chord_click(...)`).
    keys: []KeyBind = no_keys(),
    /// The trailing block: actions, under the body.
    children: fn() = noop,
}

fn Alert(title: fn() -> string, body: fn() -> string, p: AlertProps) -> Node {
    return AlertView(title, body, p.tone, p)
}

fn alert_edge(kind: int) -> string {
    match kind {
        Tone.Danger => { return danger_edge() }
        Tone.Warn => { return warn_edge() }
        Tone.Ok => { return ok() }
        _ => { return info_line() }
    }
}

fn alert_title_tint(kind: int) -> string {
    match kind {
        Tone.Danger => { return danger() }
        Tone.Warn => { return warn() }
        Tone.Ok => { return ok() }
        _ => { return info_ink() }
    }
}

fn alert_body_tint(kind: int) -> string {
    match kind {
        Tone.Danger => { return danger() }
        Tone.Ok => { return ok() }
        _ => { return mute() }
    }
}

fn alert_icon(kind: int) {
    match kind {
        Tone.Danger => { Icon(IC_ALERT_CIRCLE, 16, danger()) }
        Tone.Warn => { Icon(IC_ALERT_CIRCLE, 16, warn()) }
        Tone.Ok => { Icon(IC_CHECK, 16, ok()) }
        _ => { Icon(IC_INFO, 16, info_ink()) }
    }
}

fn AlertView(title: fn() -> string, body: fn() -> string, kind: int, p: AlertProps) -> Node {
    let dismissable = result.is_some(p.dismiss)
    let open = result.some_or(p.dismiss, no_flag_signal())
    return Box(style = merge(Style(direction = Direction.Row, gap = 12, align = Align.Start,
                                   padding = edges2(12, 16), radius = corners(RAD_LG),
                                   border = line(HAIRLINE, alert_edge(kind)), background = plate()),
                             style_of(p.style)),
               role = "alert",
               visible = !dismissable || open.get(),
               keys = p.keys) {
        alert_icon(kind)
        Column(4) {
            if result.is_some(p.dismiss) {
                Box(style = Style(direction = Direction.Row, gap = Space.Exs, align = Align.Center)) {
                    Text(title, style = Style(grow = 1, font = FONT_BODY, color = alert_title_tint(kind)))
                    Box(style = Style(width = px(28),
                                      height = px(28),
                                      align = Align.Center,
                                      justify = Align.Center,
                                      radius = corners(RAD_MD),
                                      cursor = "pointer"),
                        on_click = fn() { open.set(false) },
                        role = "button",
                        label = "Dismiss",
                        focusable = true) {
                        Icon(IC_X, 16, mute())
                    }
                }
            } else {
                Text(title, style = Style(font = FONT_BODY, color = alert_title_tint(kind)))
            }
            Text(body, style = Style(wrap = true, font = FONT_CONTROL, color = alert_body_tint(kind)))
            p.children()
        }
    }
}

/// Text input frame (themed; raw editing widget is `Input`): 36px tall,
/// rounded, 1px border, transparent fill.
/// Single-line compose field. `width >= 0` pins the field (typing then
/// scrolls inside it instead of resizing the layout); -1 keeps the natural
/// content width. Pin with `width = 200`; restyle with any style prop.
struct TextInputProps {
    /// Style, merged over the recipe's own: `style = Style(radius = corners(4))`.
    style: Option<fn() -> Style> = none,
    /// Keyboard actions on this element (`chord(...)`, `chord_click(...)`).
    keys: []KeyBind = no_keys(),
}

/// X control that appears while `value` is non-empty and clears the bound
/// field. Shared by `TextInput` / `TextArea` / `Combobox`.
fn InputClear(value: Signal<string>, field: Ref) -> Node {
    // controller
    fn clear() {
        value.set("")
        set_input(ref_node(field), "")
        focus(field)
    }

    // view. Pointer-only: keyboard users clear with Cmd/Ctrl+A then
    // Backspace, so the X is not a tab stop between the field and the next
    // control.
    return Box(style = Style(width = px(20),
                             height = px(20),
                             shrink = 0,
                             align = Align.Center,
                             justify = Align.Center,
                             radius = corners(RAD_SM),
                             cursor = "pointer"),
               on_click = clear,
               role = "button",
               label = "Clear",
               focusable = false,
               visible = value.get().len > 0) {
        Icon(IC_X, 12, mute())
    }
}

fn TextInput(value: Signal<string>, placeholder: string, p: TextInputProps) -> Node {
    // state
    let field = ref()

    // view. A click anywhere on the frame focuses the field; the frame itself
    // is not a tab stop.
    return Box(
        style = merge(Style(direction = Direction.Row, gap = 4, align = Align.Center,
                            padding = edges2(8, 12), radius = corners(RAD_MD),
                            border = line(HAIRLINE, rule()), background = plate(),
                            cursor = "text"),
                      style_of(p.style)),
        on_click = fn() { focus(field) },
        focusable = false,
        keys = p.keys
    ) {
        Input(ref = field,
              bind = value,
              placeholder = placeholder,
              style = merge(Style(grow = 1, font = FONT_BODY, padding = edges(0), color = ink()),
                            text_part(style_of(p.style))),
              label = placeholder)
        InputClear(value, field)
    }
}

/// Multiline compose field: min-height ~4 lines, same chrome as `TextInput`.
/// `width >= 0` pins the field width; -1 keeps the natural content width.
/// `on_edit` runs on key-up (autosave).
fn TextArea(value: Signal<string>, placeholder: string, on_edit: fn() = noop,
            width: int = -1) -> Node {
    // state
    let field = ref()

    // view
    return Box(
        style = Style(width = len_px(width),
                      direction = Direction.Row,
                      gap = 4,
                      align = Align.Start,
                      minHeight = 96,
                      padding = edges2(8, 12),
                      radius = corners(RAD_MD),
                      border = line(HAIRLINE, rule()),
                      background = plate(),
                      cursor = "text"),
        on_click = fn() { focus(field) },
        focusable = false
    ) {
        Input(ref = field,
              bind = value,
              placeholder = placeholder,
              style = Style(grow = 1, font = FONT_BODY, padding = edges(0), color = ink()),
              multiline = true,
              label = placeholder,
              on_key_up = on_edit)
        InputClear(value, field)
    }
}

/// Label + input. Pin with `width = 200` so the row
/// around it does not reflow while typing; restyle with any style prop —
/// they all forward to the `TextInput` underneath.
struct FieldProps {
    /// Style, merged over the recipe's own: `style = Style(radius = corners(4))`.
    style: Option<fn() -> Style> = none,
    /// Keyboard actions on this element (`chord(...)`, `chord_click(...)`).
    keys: []KeyBind = no_keys(),
}

fn Field(label: string, value: Signal<string>, placeholder: string,
         p: FieldProps) -> Node {
    return Column(Space.Exs) {
        Label(label)
        TextInput(value, placeholder, style = p.style, keys = p.keys)
    }
}

/// Checkbox: 16px rounded box, 1px accent border, accent fill when checked
/// with a white 16px SVG check.
fn Checkbox(label: string, on: Signal<bool>) -> Node {
    // controller
    fn toggle() {
        on.set(!on.get())
    }

    // view
    return Box(style = Style(direction = Direction.Row,
                             gap = Space.Exs,
                             align = Align.Center,
                             cursor = "pointer"),
               on_click = toggle,
               role = "checkbox",
               label = label) {
        Box(style = merge(Style(width = px(16),
                                height = px(16),
                                align = Align.Center,
                                justify = Align.Center,
                                radius = corners(RAD_SM),
                                border = line(HAIRLINE, accent())), Style(background = if on.get() { accent() } else { plate() }))) {
            Icon(IC_CHECK, 16, on_ink(), style = Style(display = shown(on.get())))
        }
        Text(label, style = Style(font = FONT_BODY, color = ink()))
    }
}

struct UserProps {
    src: string = ""
    status: int = -1
}

/// Avatar + name + role column, the "user card" pattern.
fn User(initials: string, name: string, role: string, p: UserProps) -> Node {
    return Row(Space.Xs) {
        Avatar(initials, 40, src = p.src, status = p.status)
        Column(2) {
            Text(name, style = Style(font = FONT_BODY, color = ink()))
            Text(role, style = Style(font = FONT_CAPTION, color = mute()))
        }
    }
}

/// Breadcrumb: items separated by chevron icons; last item is foreground.
fn Breadcrumbs(items: []string) -> Node {
    return Row(6) {
        Loop(items, fn(i, s) {
            if i > 0 {
                Icon(IC_CHEV_RIGHT, 14, mute())
            }
            if i == items.len - 1 {
                return Text(s, style = Style(font = FONT_BODY, color = ink()))
            } else {
                return Text(s, style = Style(font = FONT_BODY, color = mute()))
            }
        })
    }
}

/// One tab trigger. Active: card background, foreground text. Left / Right
/// move the selection; only the selected tab is a tab stop.
fn Tab(label: string, selected: Signal<int>, index: int, count: int = 0, plain: bool = false) -> Node {
    // controller
    fn active() -> bool {
        return selected.get() == index
    }

    // keys
    let keys = []KeyBind {
        chord("right", "tab.next", fn() { roving_step(selected, index, count, 1) }),
        chord("left", "tab.prev", fn() { roving_step(selected, index, count, -1) }),
    }

    // view. `plain` = the tray's sliding indicator carries the fill; the
    // trigger only swaps its label colour.
    return Box(
        style = merge(Style(direction = Direction.Row,
                            gap = Space.Exxs,
                            align = Align.Center,
                            padding = edges2(5, 12),
                            radius = corners(RAD_MD),
                            cursor = "pointer"), style_of(tab_fill(plain, active()))),
        on_click = fn() => selected.set(index),
        role = "tab",
        label = label,
        keys = keys,
        roving = active()
    ) {
        Text(label,
             style = merge(Style(font = FONT_BODY, ellipsis = true), Style(color = if active() { ink() } else { mute() })))
    }
}

/// A tab trigger's fill: none for `plain` (the tray's indicator paints it).
fn tab_fill(plain: bool, on: bool) -> Style {
    if plain {
        return Style {}
    }
    return Style(background = if on { plate() } else { raised() })
}

/// Tabs: 36px muted tray, rounded, 4px inset, with a card-coloured trigger.
/// The tray sits in a row wrapper so it hugs its triggers instead of
/// stretching to the column width (columns stretch children cross-axis).
/// Tabs: 36px muted tray, rounded, 4px inset, with a card-coloured
/// indicator that slides under the selected trigger. The indicator is an
/// absolute box whose `left` / `width` pins are signals: a selection change
/// `animate`s them (layout tweens the pins, batch 9.4), and the tray's refit
/// hook re-places it instantly after the first layout or a resize, when the
/// triggers' measured geometry moves.
fn Tabs(selected: Signal<int>, labels: []string) -> Node {
    // state
    let tray = ref()
    let ind_l = signal(0)
    let ind_w = signal(0)
    let ind_h = signal(0)
    let n = labels.len

    // controller. Move the indicator to the selected trigger, in the tray's
    // content box, tweened over `ms` (0 = jump). Skipped before the first
    // layout, when the triggers have no width yet. Trigger `i` is tray child
    // `i + 1`: the indicator comes first, so it paints under them.
    fn place(ms: int) {
        let sel = selected.get()
        if sel < 0 || sel >= n {
            return
        }
        let t = child_rect(tray, sel + 1)
        if t.w <= 0 {
            return
        }
        if ms > 0 {
            animate(ind_l, t.x, ms)
            animate(ind_w, t.w, ms)
        } else {
            ind_l.set(t.x)
            ind_w.set(t.w)
        }
        ind_h.set(t.h)
    }
    on_mount(|| {
        // Refit after any layout that changed the tray's width (the first one
        // included); a second layout then applies the pins.
        on_resize(tray, || { place(0) })
        effect(|| { place(Motion.Base) })
    })

    // view. The tray sits in a row wrapper so it hugs its triggers instead of
    // stretching to the column width.
    return Row(0) {
        Box(
            ref = tray,
            style = Style(direction = Direction.Row,
                          gap = 2,
                          align = Align.Center,
                          padding = edges(4),
                          radius = corners(RAD_LG),
                          background = raised())
        ) {
            Box(style = merge(Style(elevation = 1,
                                    position = pos_absolute(),
                                    inset = Edges(top = 0),
                                    radius = corners(RAD_MD),
                                    background = plate()), Style(inset = Edges(left = ind_l.get()),
                                                                 width = px(ind_w.get()), height = px(ind_h.get()))),
                role = "presentation")
            Loop(labels, fn(i, lab) {
                return Tab(lab, selected, i, n, true)
            })
        }
    }
}

/// One toggle-style choice row inside `Segmented` / `ToggleGroup`.
fn Choice(label: string, value: Signal<int>, index: int, count: int = 0) -> Node {
    // controller
    fn active() -> bool {
        return value.get() == index
    }

    // keys
    let keys = []KeyBind {
        chord("right", "choice.next", fn() { roving_step(value, index, count, 1) }),
        chord("left", "choice.prev", fn() { roving_step(value, index, count, -1) }),
    }

    // view
    return Box(
        style = merge(Style(direction = Direction.Row,
                            gap = Space.Exxs,
                            align = Align.Center,
                            padding = edges2(5, 12),
                            radius = corners(RAD_MD),
                            cursor = "pointer"), Style(background = if active() { plate() } else { raised() })),
        on_click = fn() => value.set(index),
        role = "radio",
        label = label,
        keys = keys,
        roving = active()
    ) {
        Text(label,
             style = merge(Style(font = FONT_BODY), Style(color = if active() { ink() } else { mute() })))
    }
}

/// Exclusive pick from `labels` as a Tabs-style tray. Same chrome as
/// `Tabs`; kept for older callers.
fn Segmented(value: Signal<int>, labels: []string) -> Node {
    let n = labels.len
    return Row(0) {
        Box(
            style = Style(direction = Direction.Row,
                          gap = 2,
                          align = Align.Center,
                          padding = edges(4),
                          radius = corners(RAD_LG),
                          background = raised())
        ) {
            Loop(labels, fn(i, lab) {
                return Choice(lab, value, i, n)
            })
        }
    }
}

/// One row of a `Select` menu: a check icon on the picked row and a raised fill
/// on the active row (the keyboard highlight).
fn SelectRow(value: Signal<int>, active: Signal<int>, index: int, label: string) -> Node {
    // controller
    fn pick() {
        value.set(index)
        active.set(-1)
    }

    // view
    return Box(
        style = merge(Style(direction = Direction.Row,
                            gap = 4,
                            align = Align.Center,
                            padding = edges2(6, 8),
                            radius = corners(RAD_SM),
                            cursor = "pointer"), style_of(highlight(active.get() == index))),
        on_click = pick,
        role = "listitem",
        label = label,
        hoverOff = false
    ) {
        Text(label, style = Style(font = FONT_BODY, color = ink(), ellipsis = true))
        Grow()
        Icon(IC_CHECK, 16, ink(), style = Style(display = shown(value.get() == index)))
    }
}

/// The keyboard highlight of a list row: a raised fill while on, none off.
fn highlight(on: bool) -> Style {
    if on {
        return Style(background = raised())
    }
    return Style(background = "")
}

/// Dropdown. The trigger shows the current label; the menu is an anchored
/// floater (card surface, p-1 viewport, hairline border) that stays beside the
/// trigger and follows it on scroll. Arrows move the highlight, Enter picks,
/// Escape or an outside click closes. `active` (-1 = closed) is the menu's only
/// extra state; the picked value stays in the caller's `value` signal.
fn Select(value: Signal<int>, labels: []string) -> Node {
    // state. `active` (-1 = closed) is the menu's only state; the picked value
    // stays in the caller's `value` signal.
    let active = signal(-1)
    let trigger = ref()
    let menu = ref()
    let n = labels.len

    // controller
    fn close() {
        active.set(-1)
    }
    fn toggle() {
        if active.get() >= 0 {
            active.set(-1)
        } else {
            active.set(0)
        }
    }
    fn next() {
        if active.get() >= 0 {
            if active.get() + 1 < n {
                active.set(active.get() + 1)
            }
        }
    }
    fn prev() {
        if active.get() > 0 {
            active.set(active.get() - 1)
        }
    }
    fn pick() {
        if active.get() >= 0 {
            value.set(active.get())
            active.set(-1)
        }
    }
    on_mount(|| {
        anchor(menu, trigger, Place.PlaceBelow, 6)
        // The menu holds focus while open, so the arrows and Enter reach it.
        effect(|| {
            if active.get() >= 0 {
                focus(menu)
            }
        })
    })

    // keys
    let keys = []KeyBind {
        chord("escape", "select.close", close),
        chord("down", "select.next", next),
        chord("up", "select.prev", prev),
        chord("enter", "select.pick", pick),
    }

    // view. The scrim comes first so the trigger and menu draw over it; an
    // outside click lands on it and closes.
    return Box(style = merge(Style(direction = Direction.Column), Style(alignSelf = Align.Start))) {
        Overlay(on_click = close,
                style = Style(display = shown(active.get() >= 0), zIndex = Z_SCRIM))
        Box(
            ref = trigger,
            style = Style(width = px(SELECT_W),
                          direction = Direction.Row,
                          gap = 4,
                          align = Align.Center,
                          zIndex = Z_FIELD,
                          padding = edges2(8, 12),
                          radius = corners(RAD_MD),
                          border = line(HAIRLINE, rule()),
                          background = plate(),
                          cursor = "pointer"),
            on_click = toggle,
            role = "combobox",
            hoverOff = false,
            press = true
        ) {
            Loop(labels, fn(i, lab) {
                return Text(lab,
                            style = merge(Style(font = FONT_BODY, color = ink(), ellipsis = true), Style(display = shown(value.get() == i))))
            })
            Grow()
            Icon(IC_CHEV_DOWN, 16, dim())
        }
        Box(
            ref = menu,
            style = merge(Style(width = px(SELECT_W),
                                direction = Direction.Column,
                                gap = 2,
                                elevation = 2,
                                position = pos_absolute(),
                                zIndex = Z_POPUP,
                                padding = edges(4),
                                radius = corners(RAD_MD),
                                border = line(HAIRLINE, rule()),
                                background = plate()), Style(display = shown(active.get() >= 0))),
            keys = keys,
            enter = Enter.Fade
        ) {
            Loop(labels, fn(i, lab) {
                return SelectRow(value, active, i, lab)
            })
        }
    }
}

/// Radio group: vertical stack of `Radio` rows, 8px apart. The picked row gets a
/// filled primary dot. Arrows move the pick; only the selected row is a tab stop.
fn Radio(label: string, value: Signal<int>, index: int, count: int = 0) -> Node {
    // controller
    fn active() -> bool {
        return value.get() == index
    }

    // keys
    let keys = []KeyBind {
        chord("down", "radio.next", fn() { roving_step(value, index, count, 1) }),
        chord("up", "radio.prev", fn() { roving_step(value, index, count, -1) }),
        chord("right", "radio.next", fn() { roving_step(value, index, count, 1) }),
        chord("left", "radio.prev", fn() { roving_step(value, index, count, -1) }),
    }

    // view
    return Box(style = Style(direction = Direction.Row,
                             gap = Space.Exs,
                             align = Align.Center,
                             cursor = "pointer"),
               on_click = fn() => value.set(index),
               role = "radio",
               label = label,
               keys = keys,
               roving = active()) {
        Box(style = Style(width = px(16),
                          height = px(16),
                          align = Align.Center,
                          justify = Align.Center,
                          radius = corners(8),
                          border = line(HAIRLINE, accent()),
                          background = plate())) {
            Box(style = merge(Style(width = px(14), height = px(14), radius = corners(7)), Style(background = if active() { accent() } else { plate() })))
        }
        Text(label, style = Style(font = FONT_BODY, color = ink()))
    }
}

/// `RadioGroup(value, labels)`: one circle per option.
fn RadioGroup(value: Signal<int>, labels: []string) -> Node {
    let n = labels.len
    return Column(Space.Exs) {
        Loop(labels, fn(i, lab) {
            return Radio(lab, value, i, n)
        })
    }
}

/// Toggle: default variant, no border — a pressed state fills muted
/// (accent fill), 36px tall and rounded.
fn Toggle(label: string, on: Signal<bool>) -> Node {
    return Box(
        style = merge(Style(height = px(36),
                            direction = Direction.Row,
                            gap = Space.Exxs,
                            align = Align.Center,
                            justify = Align.Center,
                            padding = Edges(right = 12, left = 12),
                            radius = corners(RAD_MD),
                            cursor = "pointer"), Style(background = if on.get() { raised() } else { plate() })),
        on_click = fn() => on.set(!on.get()),
        role = "button",
        label = label
    ) {
        Text(label,
             style = merge(Style(font = FONT_BODY), Style(color = if on.get() { ink() } else { mute() })))
    }
}

/// Toggle group: a 4px-gap row of single-choice toggles with outline
/// chrome; the pressed state fills muted.
fn ToggleGroup(value: Signal<int>, labels: []string) -> Node {
    return Row(4) {
        Loop(labels, fn(i, lab) {
            return Box(
                style = merge(Style(height = px(36),
                                    direction = Direction.Row,
                                    align = Align.Center,
                                    justify = Align.Center,
                                    padding = Edges(right = 12, left = 12),
                                    radius = corners(RAD_MD),
                                    border = line(HAIRLINE, rule()),
                                    cursor = "pointer"), Style(background = if value.get() == i { raised() } else { plate() })),
                on_click = fn() => value.set(i),
                role = "button",
                label = lab
            ) {
                Text(lab, style = Style(font = FONT_BODY, color = ink()))
            }
        })
    }
}

struct CollapsibleProps {
    /// Open while true.
    open: Signal<bool> = Signal { id: 0 },
    title: fn() -> string = empty_text,
    /// Optional leading icon markup.
    icon: string = "",
    /// The trailing block: the body, placed by the component.
    children: fn() = noop,
    /// Style, merged over the recipe's own: `style = Style(radius = corners(4))`.
    style: Option<fn() -> Style> = none,
}

/// One disclosure: a header row that toggles, and a body that fades in while
/// `open`. `open` is the *only* state; the chevron rotation and
/// the body fade are paint-only tracks. Trailing block is the body.
///
/// Self-contained like `Toast`: the header and a hideable body go into a
/// wrapper, and the wrapper's body is what is returned, so the trailing block
/// lands inside the part that hides.
fn Collapsible(p: CollapsibleProps) -> Node {
    // state
    let open = p.open
    let chev = ref()

    // controller
    fn toggle() {
        open.set(!open.get())
    }
    on_mount(|| {
        effect(|| {
            if open.get() {
                animate_rotate(ref_node(chev), 180, Motion.Fast)
            } else {
                animate_rotate(ref_node(chev), 0, Motion.Fast)
            }
        })
    })

    // view. No gap above the body: the header already carries the top inset.
    return // A bare disclosure by default; a surface comes from the caller's style.
    Box(style = merge(Style(direction = Direction.Column, radius = corners(RAD_LG)),
                      style_of(p.style))) {
        Box(style = Style(direction = Direction.Row,
                          gap = Space.Xs,
                          align = Align.Center,
                          padding = edges2(12, 16),
                          cursor = "pointer"),
            on_click = toggle,
            role = "button",
            label = p.title(),
            hoverOff = false,
            press = true) {
            if p.icon.len > 0 {
                Icon(p.icon, 16, dim())
            }
            Text(p.title, style = Style(grow = 1, font = FONT_CONTROL, color = ink()))
            Icon(IC_CHEV_DOWN, 16, dim(), ref = chev)
        }
        // The body is the part that hides.
        Box(style = Style(direction = Direction.Column,
                          padding = Edges(top = 0, right = 16, bottom = 12, left = 16)),
            visible = open.get(),
            enter = Enter.Fade + Enter.Reveal) {
            p.children()
        }
    }
}

/// One page number for `Pagination`: ghost number; the current page is an
/// outline button. The current page is an effect, not a prop, so the row
/// repaints when `page` moves.
fn PageButton(page: Signal<int>, n: int) -> Node {
    // controller
    fn current() -> bool {
        return page.get() == n
    }

    // view. The outline only exists on the current page.
    return Box(style = merge(Style(width = px(36),
                                   height = px(36),
                                   direction = Direction.Row,
                                   align = Align.Center,
                                   justify = Align.Center,
                                   radius = corners(RAD_MD),
                                   border = Border(color = rule()),
                                   cursor = "pointer"), style_of(page_chrome(current()))),
               on_click = fn() => page.set(n),
               role = "button",
               label = "{{n}}") {
        Text("{{n}}",
             style = merge(Style(font = FONT_BODY), Style(color = if current() { ink() } else { mute() })))
    }
}

/// The current page is an outline button on the plate; the rest are ghost
/// numbers on the paper.
fn page_chrome(on: bool) -> Style {
    if on {
        return Style(background = plate(), border = line(HAIRLINE, rule()))
    }
    return Style(background = paper(), border = line(0, rule()))
}

/// One slot of a collapsed `Pagination` row: the number it shows follows
/// `current_value`, so the row never rebuilds; an ellipsis slot is inert.
fn PageSlot(current_value: Signal<int>, pages: int, slot: int) -> Node {
    // controller. The number this slot shows follows `current_value`, so the
    // row never rebuilds; an ellipsis slot (0) is inert.
    fn shown_page() -> int {
        return page_at(current_value.get(), pages, slot)
    }
    fn go() {
        let n = shown_page()
        if n > 0 {
            current_value.set(n)
        }
    }

    // view
    return Box(style = merge(Style(width = px(36),
                                   height = px(36),
                                   direction = Direction.Row,
                                   align = Align.Center,
                                   justify = Align.Center,
                                   radius = corners(RAD_MD),
                                   border = Border(color = rule())), merge(page_chrome(shown_page() == current_value.get()),
                                                                           Style(cursor = if shown_page() == 0 { "" } else { "pointer" }))),
               on_click = go,
               role = "button",
               label = if shown_page() == 0 { "More pages" } else { "{{shown_page()}}" }) {
        Text(if shown_page() == 0 { "…" } else { "{{shown_page()}}" },
             style = merge(Style(font = FONT_BODY), Style(color = if shown_page() == current_value.get() { ink() } else { mute() })))
    }
}

/// `Pagination(current_value, pages)`: `pages` is the 1-based page count. Past seven
/// pages the row collapses to `1 … c-1 c c+1 … N` (see `page_at`).
fn Pagination(current_value: Signal<int>, pages: int) -> Node {
    // controller
    fn previous() {
        if current_value.get() > 1 {
            current_value.set(current_value.get() - 1)
        }
    }
    fn next() {
        if current_value.get() < pages {
            current_value.set(current_value.get() + 1)
        }
    }

    // view
    return Row(4) {
        Box(
            style = Style(width = px(36),
                          height = px(36),
                          direction = Direction.Row,
                          align = Align.Center,
                          justify = Align.Center,
                          radius = corners(RAD_MD),
                          cursor = "pointer"),
            on_click = previous,
            role = "button",
            label = "Previous page"
        ) {
            Icon(IC_CHEV_LEFT, 16, mute())
        }
        if pages <= PAGE_SLOTS {
            let mut i = 1
            while i <= pages {
                PageButton(current_value, i)
                i = i + 1
            }
        } else {
            for slot in 0..PAGE_SLOTS {
                PageSlot(current_value, pages, slot)
            }
        }
        Box(
            style = Style(width = px(36),
                          height = px(36),
                          direction = Direction.Row,
                          align = Align.Center,
                          justify = Align.Center,
                          radius = corners(RAD_MD),
                          cursor = "pointer"),
            on_click = next,
            role = "button",
            label = "Next page"
        ) {
            Icon(IC_CHEV_RIGHT, 16, mute())
        }
    }
}

/// Themed chrome branch of `Button`.
fn BtnLook(p: ButtonProps) -> Node {
    // state
    let look = p.look
    let size = p.size
    let on = p.enabled
    let fill = if on { button_background(look) } else { button_disabled_background(look) }
    let ink_c = if on { button_color(look) } else { mute() }
    let edge = if on { button_border_color(look) } else { rule() }
    let busy = result.is_some(p.loading)
    let ls = result.some_or(p.loading, no_flag_signal())

    // view. Disabled: the muted fill is the styling, the shared overlay turns
    // hover / press / activation off, and a lighter 70% replaces the 40% dim
    // `enabled` would apply. While loading, a spinner takes the icon slot and
    // the button is inert at 70%. Chrome hover is explicit (`hoverFade`): a
    // themed button stays a hover target even with no click handler. The
    // caller's `color` / `font` reach the label and icon.
    return Box(
        style = merge(merge(Style(height = px(button_height(size)), direction = Direction.Row,
                                  gap = Space.Exs, align = Align.Center, justify = Align.Center,
                                  padding = Edges(left = button_padding_x(size),
                                                  right = button_padding_x(size)),
                                  radius = corners(button_radius(size)),
                                  border = Border(width = button_border_width(look),
                                                  color = opt_color(edge)),
                                  background = opt_color(fill), color = ink_c,
                                  cursor = "pointer"),
                            style_of(p.style)),
                      button_dim(on, busy && ls.get())),
        on_click = p.on_click,
        role = "button",
        label = p.label(),
        hoverOff = p.hoverOff,
        press = true,
        hoverFade = !p.hoverOff,
        pressScale = true,
        keys = p.keys,
        enabled = on,
        loading = busy && ls.get()
    ) {
        if busy {
            Spinner(size = button_icon(size), color = text_color(style_of(p.style), ink_c),
                    style = Style(display = shown(ls.get())))
        }
        if p.icon.len > 0 {
            Icon(p.icon, button_icon(size), text_color(style_of(p.style), ink_c),
                 style = Style(display = shown(!busy || !ls.get())))
        }
        Text(p.label, style = merge(Style(font = button_font(size), color = ink_c),
                                    text_part(style_of(p.style))))
    }
}

/// Opacity of themed chrome: 70% while disabled or loading, full otherwise.
fn button_dim(enabled: bool, loading: bool) -> Style {
    if !enabled || loading {
        return Style(opacity = 70)
    }
    return Style(opacity = 100)
}

/// Page number shown in `slot` (0-based) of a `PAGE_SLOTS`-wide row, or 0
/// for an ellipsis. Seven or fewer pages list every number; past that the
/// row keeps 1 and `pages` fixed and slides a window around `current_value`
/// (`1 … 4 5 6 … 20`), collapsing the ellipsis at either end.
fn page_at(current_value: int, pages: int, slot: int) -> int {
    if pages <= PAGE_SLOTS {
        return slot + 1
    }
    if slot == 0 {
        return 1
    }
    if slot == PAGE_SLOTS - 1 {
        return pages
    }
    if current_value <= 4 {
        // 1 2 3 4 5 … N
        if slot == PAGE_SLOTS - 2 {
            return 0
        }
        return slot + 1
    }
    if current_value >= pages - 3 {
        // 1 … N-4 N-3 N-2 N-1 N
        if slot == 1 {
            return 0
        }
        return pages - (PAGE_SLOTS - 1 - slot)
    }
    // 1 … c-1 c c+1 … N
    if slot == 1 {
        return 0
    }
    if slot == PAGE_SLOTS - 2 {
        return 0
    }
    return current_value + slot - 3
}
