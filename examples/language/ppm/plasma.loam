//! `plasma.loam` — rexim's `plasma.cpp`, in Loam.
//!
//! https://gist.github.com/rexim/ef86bf70918034a5a57881456c0a0ccf
//!
//! The C++ original evaluates XorDev's twigl interference shader
//! (https://x.com/XorDev/status/1894123951401378051) per pixel on the CPU,
//! writes 240 frames as `output-%03d.ppm`, and leaves the encode to ffmpeg.
//! This is the same shader ported line for line: `mathf.loam` supplies
//! `sin`/`cos`/`exp`/`tanh`/`abs` as pure Loam polynomials, `frames.loam`
//! writes the P6 frames and runs ffmpeg, and nothing else is involved.
//!
//!     ./bin/yugac examples/language/ppm/plasma.loam --run
//!
//! Knobs (all optional): `LOAM_PPM_SCALE` (60, so the gist's 960x540),
//! `LOAM_PPM_FRAMES` (120), `LOAM_PPM_FPS` (60), `LOAM_PPM_OUT` (`out`),
//! `LOAM_PPM_CRF` (16), `LOAM_PPM_PRESET` (`slow`), `LOAM_PPM_KEEP=1`,
//! and `LOAM_PPM_FLIP=1` to flip the row the shader sees (see `main`).
//!
//! At the defaults this renders for roughly a minute and peaks around 250 MB
//! (one leaked string per frame; see "Memory" in README.md).

import "std:fmt"
import "std:sys"
import "frames.loam"
import "mathf.loam"

/// Frame file numbers are zero-padded to this width, matching the C original's
/// `output-%03d.ppm`.
const DIGITS: int = 3

fn main() {
    // 16:9 * scale, the same framing as the original's 16:9 * 60 = 960x540.
    // This is a CPU shader with no SIMD behind it and every pixel costs ~25
    // transcendental calls, so scale and frame count are the two levers on
    // wall time; both are in README.md with measurements.
    let scale = frames.even(frames.env_int("LOAM_PPM_SCALE", 60))
    let count = frames.env_int("LOAM_PPM_FRAMES", 120)
    let fps = frames.env_int("LOAM_PPM_FPS", 60)
    let w = 16 * scale
    let h = 9 * scale
    let dir = frames.out_dir()
    let flip = frames.env_flag("LOAM_PPM_FLIP")

    if frames.ensure_dir(dir) != 0 {
        fmt.println("cannot create", dir)
        sys.exit(1)
    }

    fmt.println("plasma:", w, "x", h, "-", count, "frame(s) ->", dir)

    let mut f = 0
    while f < count {
        // One turn over the sequence, exactly as `((float)i/240)*2*M_PI`.
        let t = f32(f) / f32(count) * mathf.TAU
        let mut b = frames.image(w, h)
        let mut y = 0
        while y < h {
            // PPM rows run top to bottom, and so does the C original's `FC.y`.
            // Comment 6 on the gist notes that this flips the image relative
            // to the shader it came from (blue ends up at the top), so the
            // row the shader is handed is switchable rather than hardcoded.
            let mut sy = y
            if flip {
                sy = h - 1 - y
            }
            let mut x = 0
            while x < w {
                let c = shade(x, sy, w, h, t)
                frames.rgbf(&mut b, c.x, c.y, c.z)
                x = x + 1
            }
            y = y + 1
        }
        if frames.save(dir, "plasma", f, DIGITS, b) != 0 {
            fmt.println("cannot write", frames.path(dir, "plasma", f, DIGITS))
            sys.exit(1)
        }
        f = f + 1
    }

    frames.finish(dir, "plasma", DIGITS, count, fps)
}

// --- GLSL vector types, as Copy structs -------------------------------------
//
// GLSL has swizzles and operator overloads; Loam has neither, so the shader
// below is written as named steps over the same values the C++ one-liner
// computes. Each helper is the operator it replaces.

struct Vec2 {
    x: float,
    y: float,
}

struct Vec4 {
    x: float,
    y: float,
    z: float,
    w: float,
}

fn v2(x: float, y: float) -> Vec2 {
    return Vec2 { x: x, y: y }
}

fn v4(x: float, y: float, z: float, w: float) -> Vec4 {
    return Vec4 { x: x, y: y, z: z, w: w }
}

fn add2(a: Vec2, b: Vec2) -> Vec2 {
    return v2(a.x + b.x, a.y + b.y)
}

fn sub2(a: Vec2, b: Vec2) -> Vec2 {
    return v2(a.x - b.x, a.y - b.y)
}

/// `v * s` — both components scaled.
fn scale2(a: Vec2, s: float) -> Vec2 {
    return v2(a.x * s, a.y * s)
}

/// `v / s`.
fn div2(a: Vec2, s: float) -> Vec2 {
    return v2(a.x / s, a.y / s)
}

/// `v + s` — the scalar to both components, GLSL's `v + s`.
fn add2s(a: Vec2, s: float) -> Vec2 {
    return v2(a.x + s, a.y + s)
}

fn dot2(a: Vec2, b: Vec2) -> float {
    return a.x * b.x + a.y * b.y
}

/// The `.yx` swizzle.
fn yx2(a: Vec2) -> Vec2 {
    return v2(a.y, a.x)
}

/// The `.xyyx` swizzle, which widens a `vec2` to a `vec4`.
fn xyyx2(a: Vec2) -> Vec4 {
    return v4(a.x, a.y, a.y, a.x)
}

fn cos2(a: Vec2) -> Vec2 {
    return v2(mathf.cos(a.x), mathf.cos(a.y))
}

fn sin4(a: Vec4) -> Vec4 {
    return v4(mathf.sin(a.x), mathf.sin(a.y), mathf.sin(a.z), mathf.sin(a.w))
}

fn exp4(a: Vec4) -> Vec4 {
    return v4(mathf.exp(a.x), mathf.exp(a.y), mathf.exp(a.z), mathf.exp(a.w))
}

fn tanh4(a: Vec4) -> Vec4 {
    return v4(mathf.tanh(a.x), mathf.tanh(a.y), mathf.tanh(a.z), mathf.tanh(a.w))
}

fn add4(a: Vec4, b: Vec4) -> Vec4 {
    return v4(a.x + b.x, a.y + b.y, a.z + b.z, a.w + b.w)
}

/// `v + s`.
fn add4s(a: Vec4, s: float) -> Vec4 {
    return v4(a.x + s, a.y + s, a.z + s, a.w + s)
}

/// `s - v` — the scalar minus each component, GLSL's `s - v`.
fn sub4s(s: float, a: Vec4) -> Vec4 {
    return v4(s - a.x, s - a.y, s - a.z, s - a.w)
}

/// `v * s`.
fn scale4(a: Vec4, s: float) -> Vec4 {
    return v4(a.x * s, a.y * s, a.z * s, a.w * s)
}

fn div4(a: Vec4, b: Vec4) -> Vec4 {
    return v4(a.x / b.x, a.y / b.y, a.z / b.z, a.w / b.w)
}

// --- the shader -------------------------------------------------------------

/// One pixel in `0.0..1.0` RGB. `x`/`y` are pixel coordinates, `w`/`h` the
/// frame size, `t` the position in the animation (one turn per sequence).
///
/// The body follows the C++ source step for step:
///
/// ```c
/// vec2 p=(FC*2.-r)/r.y,l,i,v=p*(l+=4.-4.*abs(.7-dot(p,p)));
/// for(;i.y++<8.;o+=(sin(v.xyyx())+1.)*abs(v.x-v.y))v+=cos(v.yx()*i.y+i+t)/i.y+.7;
/// o=tanh(5.*exp(l.x-4.-p.y*vec4(-1,1,2,0))/o);
/// ```
///
/// The one non-obvious part is that loop: `i.y++` sits in the *condition*, so
/// the body runs with `i.y` at 1..8, and the accumulator is the loop's
/// successor clause, which means each iteration advances `v` *before* folding
/// the new `v` into `o`.
fn shade(x: int, y: int, w: int, h: int, t: float) -> Vec4 {
    let fc = v2(f32(x), f32(y))
    let r = v2(f32(w), f32(h))

    // p = (FC * 2 - r) / r.y — pixel coordinates centred on the origin.
    let p = div2(sub2(scale2(fc, 2.0), r), r.y)

    // l = 4 - 4 * |0.7 - dot(p, p)|. The C stores it in both components of
    // `l` with `l += scalar`, but only `l.x` is ever read.
    let l = 4.0 - 4.0 * mathf.abs(0.7 - dot2(p, p))

    // v = p * l
    let mut v = scale2(p, l)

    // o accumulates eight terms, one per loop iteration.
    let mut o = v4(0.0, 0.0, 0.0, 0.0)

    let mut k = 1
    while k <= 8 {
        let kf = f32(k)

        // v += cos(v.yx * k + (0, k) + t) / k + 0.7
        let c = cos2(add2s(add2(scale2(yx2(v), kf), v2(0.0, kf)), t))
        v = add2(v, add2s(div2(c, kf), 0.7))

        // o += (sin(v.xyyx) + 1) * |v.x - v.y|
        o = add4(o, scale4(add4s(sin4(xyyx2(v)), 1.0), mathf.abs(v.x - v.y)))

        k = k + 1
    }

    // o = tanh(5 * exp(l - 4 - p.y * (-1, 1, 2, 0)) / o)
    //
    // `o` can have zero components, and `x / 0` is `inf` here, not a trap:
    // `mathf.tanh` saturates it to ±1. That is why `tanh` is written with a
    // single `exp` of a non-positive argument instead of a ratio of two.
    let e = exp4(sub4s(l - 4.0, scale4(v4(-1.0, 1.0, 2.0, 0.0), p.y)))
    return tanh4(div4(scale4(e, 5.0), o))
}
