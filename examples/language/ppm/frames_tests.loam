//! In-language tests for `frames` (`frames_tests.loam`).
//!
//! Only the pure parts are covered: the naming, the padding, the float -> byte
//! clamp and the environment reader. `save` / `encode` would need ffmpeg and a
//! writable directory, which is what the demos themselves already exercise.
//!
//!     ./bin/yugac test examples/language/ppm/frames_tests.loam

import "std:test"
import "frames.loam"

#[test]
fn padded_matches_printf_width() {
    test.assert_eq_str(frames.padded(0, 2), "00")
    test.assert_eq_str(frames.padded(7, 2), "07")
    test.assert_eq_str(frames.padded(7, 3), "007")
    test.assert_eq_str(frames.padded(59, 2), "59")
    test.assert_eq_str(frames.padded(239, 3), "239")
    // Wider than the requested width is not truncated.
    test.assert_eq_str(frames.padded(1000, 3), "1000")
    test.assert_eq_str(frames.padded(0, 0), "0")
}

#[test]
fn paths_match_the_c_originals() {
    test.assert_eq_str(frames.path("out", "checker", 7, 2), "out/checker-07.ppm")
    test.assert_eq_str(frames.path("out", "plasma", 7, 3), "out/plasma-007.ppm")
    test.assert_eq_str(frames.pattern("out", "plasma", 3), "out/plasma-%03d.ppm")
}

#[test]
fn byte_of_clamps_instead_of_trapping() {
    test.assert(frames.byte_of(0.0) == 0)
    test.assert(frames.byte_of(-1.0) == 0)
    test.assert(frames.byte_of(1.0) == 255)
    test.assert(frames.byte_of(4.0) == 255)
    test.assert(frames.byte_of(0.5) == 127)
    // NaN takes the 0 branch rather than reaching an `f32` -> `int` conversion,
    // which would trap.
    let zero = 0.0
    let nan = zero / zero
    test.assert(frames.byte_of(nan) == 0)
}

#[test]
fn even_keeps_h264_happy() {
    test.assert(frames.even(60) == 60)
    test.assert(frames.even(61) == 60)
    test.assert(frames.even(1) == 2)
    test.assert(frames.even(0) == 2)
}

#[test]
fn parse_int_accepts_decimals_only() {
    test.assert(frames.parse_int("", 42) == 42)
    test.assert(frames.parse_int("7", 42) == 7)
    test.assert(frames.parse_int("007", 42) == 7)
    test.assert(frames.parse_int("0", 42) == 0)
    test.assert(frames.parse_int("60", 42) == 60)
    // Anything that is not a plain decimal number falls back whole, rather
    // than reading the digits it did understand.
    test.assert(frames.parse_int("x", 42) == 42)
    test.assert(frames.parse_int("7x", 42) == 42)
    test.assert(frames.parse_int("-7", 42) == 42)
    test.assert(frames.parse_int("999999999", 42) == 42)
    test.assert(frames.parse_int(" 7", 42) == 42)
}

#[test]
fn env_int_reads_or_falls_back() {
    // `YUGA_PPM_TEST_UNSET` is not exported by anything, so this is the
    // unset path; the parsing path is covered above and by passing
    // `YUGA_PPM_SCALE` et al. to a demo.
    test.assert(frames.env_int("YUGA_PPM_TEST_UNSET", 42) == 42)
}
