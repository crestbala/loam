//! Shared counter UI. Hosts are three-line stubs that call `ui.start`.
//! `--target` picks the RPC address (`http.client()`) and the chip label.

import "std:async"
import "std:zeus"
import "std:http"
import "std:sys"
import "backend/api.yuga"
import "screen.yuga"

fn host_chip() -> string {
    let t = sys.target()
    if t == "wasm" {
        return "Canvas2D"
    }
    if t == "ios" {
        return "iOS"
    }
    if t == "android" {
        return "Android"
    }
    return "macOS"
}

async fn start() {
    let c = http.client()
    let hello_raw = await c.async_call(api.hello_rpc(), api.encode_HelloReq(HelloReq {}))
    let stats_raw = await c.async_call(api.stats_rpc(), api.encode_StatsReq(StatsReq {}))
    let hello = api.decode_HelloResp(hello_raw)
    let stats = api.decode_StatsResp(stats_raw)
    zeus.App("Zeus", fn() {
        screen.Screen("API", host_chip(), stats.users, stats.jobs, stats.uptime, stats.load, hello.count)
    })
}

fn main() {
    start()
}
