//! Shared counter UI. Wasm, iOS, macOS, and Android all pass RPC results in.
//!
//! Themed chrome comes from `std:zeus` (design system merged in). `users` /
//! `jobs` / `uptime` are static strings from `Counter.Stats`; `count0` /
//! `load0` seed signals.

import "std:zeus"
import "std:spacing"
import "std:design"

const TILE: int = 36
const BAR_H: int = 4
const FONT_DISPLAY: int = 26
const ROW_H: int = 36
const LIST_H: int = 220
const FEED_N: int = 10000

struct Job {
    name: string,
    role: string,
    status: string,
}

fn Stat(label: string, value: string, kind: int) {
    design.Card() {
        zeus.Box(width = TILE, height = 4, radius = 2, background = zeus.tint_of(kind))
        zeus.Text(label, color = zeus.dim(), font = spacing.FONT_CAPTION)
        zeus.Text(value, color = zeus.ink(), font = FONT_DISPLAY)
    }
}

fn StatCount(label: string, sig: Signal<int>, kind: int) {
    design.Card() {
        zeus.Box(width = TILE, height = 4, radius = 2, background = zeus.tint_of(kind))
        zeus.Text(label, color = zeus.dim(), font = spacing.FONT_CAPTION)
        zeus.Text("{{sig.get()}}", color = zeus.ink(), font = FONT_DISPLAY)
    }
}

fn clamp(v: int) -> int {
    if v < 0 {
        0
    } else if v > 100 {
        100
    } else {
        v
    }
}

fn Bar(sig: Signal<int>) {
    zeus.Box(height = BAR_H, radius = 2, background = zeus.rule(), grow = 1) {
        // Scale 2 → max 200px at 100, so the fill never overflows the row
        // (an overflowing flex child pushes the trailing buttons to a new
        // line instead of shrinking).
        zeus.Box(height = BAR_H, radius = 2, background = zeus.ink(),
                 width = clamp(sig.get()) * 2)
    }
}

fn Header(title: string, chip: string) {
    design.Row(SPACE.Md) {
        zeus.Box(width = 8, height = 24, radius = 4, background = zeus.ink())
        zeus.Text(title, color = zeus.ink(), font = spacing.FONT_TITLE)
        design.Chip(chip, zeus.TINT.Mute)
        design.Badge("live", zeus.TINT.Ok)
        design.Grow()
        zeus.Text("Dark", color = zeus.mute(), font = spacing.FONT_BODY)
        design.Switch(zeus.appearance())
    }
}

fn Stats(users: string, jobs: string, uptime: string, count: Signal<int>) {
    design.Grid(config = GridConfig(columns = 2, gap = SPACE.Md)) {
        Stat("Users", users, zeus.TINT.Ink)
        Stat("Jobs", jobs, zeus.TINT.Mute)
        Stat("Uptime", uptime, zeus.TINT.Ok)
        StatCount("Count", count, zeus.TINT.Danger)
    }
}

fn CountCard(count: Signal<int>, open: Signal<int>) {
    design.Card() {
        design.Title("Count")
        design.Note("Buttons write a signal. The starting value came from protobuf.")
        design.Row(SPACE.Sm) {
            design.Button("-1", look = zeus.LOOK.Ghost, size = zeus.SIZE.Md, on_click = fn() => count.set(count.get() - 1))
            // Fixed-width slot: digits may change, but the buttons beside the
            // value never slide left or right.
            zeus.Box(align_direction = DIRECTION.Row, justify = ALIGN.Center, width = 64) {
                zeus.Text("{{count.get()}}", color = zeus.ink(), font = 16)
            }
            design.Button("+1", look = zeus.LOOK.Solid, size = zeus.SIZE.Md, on_click = fn() => count.set(count.get() + 1))
        }
        Bar(count)
        design.Divider()
        design.Button("Open Dialog", look = zeus.LOOK.Solid, size = zeus.SIZE.Md, on_click = fn() => open.set(1))
    }
}

fn Load(load: Signal<int>) {
    design.Row(SPACE.Md) {
        zeus.Text("Load", color = zeus.dim(), font = spacing.FONT_BODY)
        Bar(load)
        // Fixed-width slot so the trailing buttons do not shift with the digits.
        zeus.Box(align_direction = DIRECTION.Row, justify = ALIGN.End, width = 44) {
            zeus.Text("{{load.get()}}%", color = zeus.mute(), font = spacing.FONT_BODY)
        }
        design.Button("+10", look = zeus.LOOK.Soft, size = zeus.SIZE.Md, on_click = fn() => load.set(clamp(load.get() + 10)))
        design.Button("-10", look = zeus.LOOK.Soft, size = zeus.SIZE.Md, on_click = fn() => load.set(clamp(load.get() - 10)))
    }
}

fn FeedRow(i: int, s: string) {
    zeus.Box(align_direction = DIRECTION.Row, align_items = ALIGN.Center,
             height = ROW_H, spacing = SPACE.Exs, padding_x = SPACE.Exs) {
        zeus.Text(s, color = zeus.ink(), font = spacing.FONT_BODY, grow = 1)
    }
}

fn JobRow(i: int, r: Job) {
    zeus.Box(align_direction = DIRECTION.Row, align_items = ALIGN.Center,
             height = ROW_H, spacing = SPACE.Sm, padding_x = SPACE.Exs) {
        zeus.set_flex_basis_zero(zeus.Text(r.name, color = zeus.ink(), font = spacing.FONT_BODY, grow = 1))
        zeus.set_flex_basis_zero(zeus.Text(r.role, color = zeus.mute(), font = spacing.FONT_BODY, grow = 1))
        zeus.set_flex_basis_zero(zeus.Text(r.status, color = zeus.dim(), font = spacing.FONT_BODY, grow = 1))
    }
}

fn FeedCard(feed: Signal<[]string>) {
    let list_id = zeus.signal(0)
    design.Card() {
        design.Title("Feed")
        design.Note("{{feed.get().len}} windowed rows. Only the visible window is mounted.")
        design.Row(SPACE.Sm) {
            design.Button("Append", look = zeus.LOOK.Soft, size = zeus.SIZE.Md, on_click = fn() {
                let n = feed.get().len
                design.push_item(feed, "msg {{n}}  appended")
            })
            design.Button("Insert", look = zeus.LOOK.Soft, size = zeus.SIZE.Md, on_click = fn() {
                design.insert_item(feed, 0, "msg inserted at top")
                design.scroll_to_index(Node { id: list_id.get() }, 0)
            })
            design.Button("Mid", look = zeus.LOOK.Ghost, size = zeus.SIZE.Md, on_click = fn() {
                design.scroll_to_index(Node { id: list_id.get() }, FEED_N / 2)
            })
            design.Button("Top", look = zeus.LOOK.Ghost, size = zeus.SIZE.Md, on_click = fn() {
                design.scroll_to_index(Node { id: list_id.get() }, 0)
            })
        }
        zeus.Box(height = LIST_H, border = 1, border_color = zeus.rule(), radius = 8) {
            let list = design.VirtualList(feed, ROW_H, FeedRow)
            list_id.set(list.id)
        }
    }
}

fn JobsCard(jobs: Signal<[]Job>, cols: []TableCol) {
    design.Card() {
        design.Title("Jobs")
        design.Note("VirtualTable of Job structs. Columns are TableCol { title, width }.")
        zeus.Box(height = LIST_H, border = 1, border_color = zeus.rule(), radius = 8) {
            design.VirtualTable(jobs, cols, ROW_H, JobRow)
        }
    }
}

fn Dialog(open: Signal<int>) {
    let dim = design.Overlay(
        background = "#000000",
        opacity = 55,
        on_click = fn() => open.set(0)
    ) {
        zeus.Box(
            width = 360,
            padding = SPACE.Xl,
            spacing = SPACE.Md,
            background = zeus.plate(),
            border = 1,
            border_color = zeus.rule(),
            radius = 16,
            on_click = fn() { return }
        ) {
            design.Title("Dialog")
            design.Body("How are you feeling today?")
            design.Row(SPACE.Sm) {
                design.Grow()
                design.Button("Close", look = zeus.LOOK.Ghost, size = zeus.SIZE.Md, on_click = fn() => open.set(0))
                design.Button("Save", look = zeus.LOOK.Solid, size = zeus.SIZE.Md, on_click = fn() => open.set(0))
            }
        }
    }
    zeus.show(dim, open)
}

/// Page built once from RPC results. `chip` is the host label
/// (Canvas2D / iOS / macOS / Android). Call from `zeus.App`.
fn Screen(title: string, chip: string, users: string, jobs: string, uptime: string, load0: int, count0: int) {
    let count = zeus.signal(count0)
    let load = zeus.signal(load0)
    let open = zeus.signal(0)

    let mut feed_xs = []string {}
    let mut i = 0
    while i < FEED_N {
        push(feed_xs, "msg {{i}}  ping from the feed")
        i = i + 1
    }
    let feed = zeus.signal(feed_xs)

    let mut job_xs = []Job {}
    i = 0
    while i < FEED_N {
        let mut st = "ok"
        if i % 7 == 0 {
            st = "away"
        }
        push(job_xs, Job { name: "job {{i}}", role: "operator", status: st })
        i = i + 1
    }
    let job_rows = zeus.signal(job_xs)
    let mut cols = []TableCol {}
    push(cols, TableCol { title: "Name", width: 0 })
    push(cols, TableCol { title: "Role", width: 0 })
    push(cols, TableCol { title: "Status", width: 0 })

    zeus.Box(align_direction = DIRECTION.Column, spacing = SPACE.Exs,
             padding = spacing.PAGE_PAD, background = zeus.paper(), grow = 1) {
        Header(title, chip),
        design.Alert("RPC", "Count is Counter.Hello. Cards are Counter.Stats."),
        Stats(users, jobs, uptime, count),
        CountCard(count, open),
        Load(load),
        FeedCard(feed),
        JobsCard(job_rows, cols),
        Dialog(open),
    }
}
