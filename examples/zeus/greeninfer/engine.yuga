//! engine.yuga — GreenInfer core (Yuga). All policy and algorithms live
//! here, where the language's checks apply (bounds traps, ownership,
//! overflow): capacity decisions, the count mirror, the per-row search
//! sweep, top-k selection, embeddings, timing.
//!
//! The C seam (`runtime/greeninfer_runtime.c`) is only the hardware/OS
//! primitives Yuga cannot express: POSIX zero-copy mmap (no read() copy into
//! Yuga buffers) and the Apple Silicon NEON dot kernel. Mapped bytes never
//! cross into Yuga as pointers — a `VectorIndex` is a plain data struct and
//! each row is scored in place by `gi_row_dot`, so search_knn below iterates
//! vectors exactly as the design intends, one NEON dot per row.
//!
//! File layout (owned by the C seam, mirrored here as constants):
//!   64 B header {magic, dim, cap, count} · cap rows of u32 id + 384 f32 ·
//!   one scratch row (index cap) where queries are staged for the sweep.

/// Embedding width. Must match GI_DIM in greeninfer_runtime.c.
const GI_DIM: int = 384

/// The largest top-k the engine keeps (search_knn clamps k to this).
const GI_MAX_K: int = 16
/// Rows scoring below this are the runtime's GI_DOT_ERR sentinel, not data.
/// Finite so it survives f32; real cosine scores sit near [-1, 1].
const GI_DOT_FLOOR: float = -2.0e38

/// One search result: the stored vector id and its raw dot score.
struct Record {
    id: int,
    score: float,
}

/// An open memory-mapped index. `count` / `cap` are Yuga mirrors of the file
/// header (re-read on open; count advances on every successful insert), so
/// all capacity decisions are made here under Yuga checks. The struct is
/// Copy and cheap to carry.
struct VectorIndex {
    map: int,
    dim: int,
    count: int,
    cap: int,
}

// ---------------------------------------------------------------------------
// C seam — bodyless declarations of `yuga_engine_gi_*`. yugac emits extern
// prototypes for bodyless fns in user modules and links the app runtime
// (codegen_c.c / driver.c). Nothing below returns or accepts a pointer.
// ---------------------------------------------------------------------------

/// Create the file with `cap` vector rows (plus a scratch row) and map it.
/// Returns the map handle or 0 on failure.
fn gi_map_create(path: string, cap: int) -> int {}

/// Reopen an existing map file. Returns handle or 0.
fn gi_map_open(path: string) -> int {}

/// msync + munmap + close. 0 ok, -1 unknown handle.
fn gi_map_close(map: int) -> int {}

/// Delete the file from disk. 0 ok, -1 error.
fn gi_map_unlink(path: string) -> int {}

/// Rows written so far (live header count; -1 unknown handle).
fn gi_map_count(map: int) -> int {}

/// Vector rows the file was sized for (-1 unknown handle).
fn gi_map_cap(map: int) -> int {}

/// Mapped file bytes (-1 unknown handle).
fn gi_map_bytes(map: int) -> int {}

/// Store `vec` (exactly dim doubles, converted to f32 once) into mapped
/// `row` under `rid`. Row == cap is the scratch row. 0 ok, < 0 error.
fn gi_row_write(map: int, row: int, rid: int, vec: []float) -> int {}

/// The u32 id stored in row `row` (-1 on error).
fn gi_row_id(map: int, row: int) -> int {}

/// NEON dot product of two mapped rows (in place, no copy). GI_DOT_ERR
/// (-3e38, see greeninfer_runtime.c) on a bad map/row, otherwise the raw f32
/// dot. The old -1e300 sentinel is not representable in f32.
fn gi_row_dot(map: int, row_a: int, row_b: int) -> float {}

/// Monotonic microseconds.
fn gi_now_us() -> int {}

// ---------------------------------------------------------------------------
// Public API — every function below is plain Yuga with safe data.
// ---------------------------------------------------------------------------

/// Open the index at `file_path` if present, otherwise create it with room
/// for `max_vectors` vectors. `count` / `cap` are read back from the file.
fn create_vector_index(file_path: string, max_vectors: int) -> VectorIndex {
    let mut map = gi_map_open(file_path)
    if map == 0 {
        map = gi_map_create(file_path, max_vectors)
    }
    if map == 0 {
        return VectorIndex { map: 0, dim: GI_DIM, count: 0, cap: 0 }
    }
    let mut cap = gi_map_cap(map)
    let mut count = gi_map_count(map)
    if cap < 0 {
        cap = 0
    }
    if count < 0 {
        count = 0
    }
    return VectorIndex { map: map, dim: GI_DIM, count: count, cap: cap }
}

/// Drop the index: flush, unmap, close.
fn close_vector_index(index: VectorIndex) {
    if index.map != 0 {
        gi_map_close(index.map)
    }
}

/// Delete the backing file (call after close). 0 ok, -1 error.
fn delete_index_file(file_path: string) -> int {
    return gi_map_unlink(file_path)
}

/// Append `vector_data` (GI_DIM doubles) under `vector_id`. The capacity
/// decision and the count mirror live here; the seam only stores bytes.
/// Vectors are L2-normalized on the way in, so row dots are cosines.
fn insert_vector(index: &mut VectorIndex, vector_id: int, vector_data: []float) -> bool {
    if index.map == 0 {
        return false
    }
    if index.count >= index.cap {
        return false
    }
    if vector_data.len != index.dim {
        return false
    }
    let unit = vec_normalize(vector_data)
    let rc = gi_row_write(index.map, index.count, vector_id, unit)
    if rc == 0 {
        index.count = index.count + 1
        return true
    }
    return false
}

/// Insert an already-stored vector row for `query` in the scratch row and
/// sweep every stored row with one NEON dot each; keep the best `k` in
/// descending order. All of the selection logic below is Yuga-checked.
fn search_knn(index: VectorIndex, query: []float, k: int) -> []Record {
    let mut out = []Record {}
    if index.map == 0 {
        return out
    }
    if query.len != index.dim {
        return out
    }
    let mut want = k
    if want < 1 {
        want = 1
    }
    if want > GI_MAX_K {
        want = GI_MAX_K
    }
    // Stage the query once in the scratch row (row == cap): the per-row dot
    // then reads two mapped f32 rows and converts nothing. The query is
    // normalized first, so every score below is a cosine in [-1, 1].
    let unit = vec_normalize(query)
    if gi_row_write(index.map, index.cap, 0, unit) != 0 {
        return out
    }
    let mut ids = []int {}
    let mut scores = []float {}
    for i in 0..want {
        push(ids, 0)
        push(scores, 0.0)
    }
    let mut n = 0
    let mut r = 0
    while r < index.count {
        let s = gi_row_dot(index.map, r, index.cap)
        if s > GI_DOT_FLOOR {
            n = keep_rank(ids, scores, n, want, r, s)
        }
        r = r + 1
    }
    for i in 0..n {
        let rid = gi_row_id(index.map, ids[i])
        push(out, Record { id: rid, score: scores[i] })
    }
    return out
}

// ---------------------------------------------------------------------------
// top-k machinery (pure Yuga, index-checked on every access)
// ---------------------------------------------------------------------------

/// Insert (rid, s) into the descending `scores`/`ids` arrays (length `cap`,
/// `n` valid entries) and return the new count. Shifts right-to-left so
/// overlapping moves stay safe.
fn keep_rank(ids: &mut []int, scores: &mut []float, n: int, cap: int, rid: int, s: float) -> int {
    if n <= 0 {
        ids[0] = rid
        scores[0] = s
        return 1
    }
    if n >= cap && s <= scores[cap - 1] {
        return n
    }
    // Insertion point p: first entry with a lower score.
    let mut p = n
    if n > cap {
        p = cap
    }
    let mut i = 0
    while i < p {
        if s > scores[i] {
            p = i
            break
        }
        i = i + 1
    }
    let mut new_n = n
    if new_n < cap {
        new_n = new_n + 1
    }
    if p < new_n - 1 {
        let mut j = new_n - 1
        while j > p {
            ids[j] = ids[j - 1]
            scores[j] = scores[j - 1]
            j = j - 1
        }
    }
    ids[p] = rid
    scores[p] = s
    return new_n
}

// ---------------------------------------------------------------------------
// Vector math (pure Yuga; floats are unchecked, so no traps here)
// ---------------------------------------------------------------------------

/// Newton–Raphson square root. Yuga has no float sqrt primitive, so this is
/// Yuga arithmetic: each pass doubles the correct digits. Norms here are
/// small (< 1e12), so 20 passes is ~6 ulp from perfect.
fn sqrt_newton(a: float) -> float {
    if a <= 0.0 {
        return 0.0
    }
    let mut x = a
    let mut i = 0
    while i < 20 {
        x = 0.5 * (x + a / x)
        i = i + 1
    }
    return x
}

/// L2 norm of a vector.
fn vec_norm(v: []float) -> float {
    let mut s = 0.0
    for i in 0..v.len {
        s = s + v[i] * v[i]
    }
    return sqrt_newton(s)
}

/// A unit-length copy of `v` (zeros stay zeros).
fn vec_normalize(v: []float) -> []float {
    let mut out = []float {}
    let n = vec_norm(v)
    if n > 0.0 {
        for i in 0..v.len {
            push(out, v[i] / n)
        }
    } else {
        for i in 0..v.len {
            push(out, 0.0)
        }
    }
    return out
}

// ---------------------------------------------------------------------------
// Embedder — retrieval quality lives here (all pure Yuga).
//
// Tokens are identifiers split at underscore/camelCase boundaries and digit
// runs, case-folded; common English stopwords and single letters are
// dropped; every remaining token folds two FNV hashes into one of the
// GI_DIM dimensions (dimension from h1, sign from h2). When a corpus scan
// has filled the document-frequency table (embed_df_* below), each token's
// contribution is weighted by N/(df+1) — rare, specific tokens beat words
// that appear in every chunk, which is the main reason plain word-overlap
// ranking feels wrong. The same embed_text() embeds chunks and queries, so
// both live in one weighted space.
// ---------------------------------------------------------------------------

/// Corpus document-frequency state: dim -> number of chunks containing it.
/// Inactive (all zeros) until a watcher scan calls embed_df_* — embeddings
/// then fall back to unweighted hashing (engine-only use).
let mut gi_df: []int = []int {}
let mut gi_df_n: int = 0

fn embed_df_active() -> int {
    if gi_df_n > 0 && gi_df.len == GI_DIM {
        return 1
    }
    return 0
}

/// Start a scan: zero the per-dimension chunk counters.
fn embed_df_reset() {
    gi_df = []int {}
    for i in 0..GI_DIM {
        push(gi_df, 0)
    }
    gi_df_n = 0
}

/// One more chunk contains `dim` (call once per chunk per present dim).
fn embed_df_note(dim: int) {
    if dim >= 0 && dim < gi_df.len {
        gi_df[dim] = gi_df[dim] + 1
    }
}

/// Activate weighting with `ndocs` indexed chunks.
fn embed_df_done(ndocs: int) {
    gi_df_n = ndocs
}

/// IDF-style weight for a token landing on `dim`: N/(df+1), clamped to
/// [0.5, 12] so single rare tokens cannot drown a chunk.
fn embed_weight(dim: int) -> float {
    if embed_df_active() == 0 {
        return 1.0
    }
    if dim < 0 || dim >= gi_df.len {
        return 1.0
    }
    let mut w = (gi_df_n as float) / ((gi_df[dim] + 1) as float)
    if w > 12.0 {
        w = 12.0
    }
    if w < 0.5 {
        w = 0.5
    }
    return w
}

fn fold_case(b: int) -> int {
    if b >= 65 && b <= 90 {
        return b + 32
    }
    return b
}

fn is_alpha(b: int) -> bool {
    return b >= 97 && b <= 122
}

fn is_digit(b: int) -> bool {
    return b >= 48 && b <= 57
}

fn is_word_char_raw(raw: int) -> bool {
    return (raw >= 48 && raw <= 57) || (raw >= 65 && raw <= 90) ||
           (raw >= 97 && raw <= 122) || raw == 95
}

/// Stopwords (and any single-letter token) are dropped: they appear in
/// nearly every chunk and only add noise to the weighted space.
fn is_stop_word(w: string) -> bool {
    if w.len < 2 {
        return true
    }
    return w == "the" || w == "and" || w == "for" || w == "with" ||
           w == "that" || w == "this" || w == "are" || w == "was" ||
           w == "were" || w == "you" || w == "your" || w == "what" ||
           w == "how" || w == "why" || w == "when" || w == "which" ||
           w == "who" || w == "does" || w == "will" || w == "can" ||
           w == "not" || w == "but" || w == "have" || w == "has" ||
           w == "from" || w == "they" || w == "them" || w == "its" ||
           w == "all" || w == "our" || w == "on" || w == "in" ||
           w == "of" || w == "to" || w == "at" || w == "is" ||
           w == "it" || w == "as" || w == "or" || w == "by" ||
           w == "be" || w == "do" || w == "we" || w == "he" ||
           w == "she" || w == "an" || w == "if" || w == "up"
}

/// Hash one lowercase segment (letters or digits, never mixed) into `out`.
/// Contribution is +/-1 times the current corpus weight of its dimension.
fn hash_segment(seg: []int, out: &mut []float) {
    let n = seg.len
    if n == 0 {
        return
    }
    let mut folded = []int {}
    let mut letters = 0
    let mut digits = 0
    let mut k = 0
    while k < n {
        let b = fold_case(seg[k])
        push(folded, b)
        if is_alpha(b) {
            letters = letters + 1
        } else if is_digit(b) {
            digits = digits + 1
        }
        k = k + 1
    }
    if letters == 0 && digits == 0 {
        return
    }
    if letters > 0 && digits > 0 {
        return
    }
    if letters == n {
        if n < 2 {
            return
        }
        let s = string_from_bytes(folded)
        if is_stop_word(s) {
            return
        }
    } else if digits == n {
        if n > 12 {
            return
        }
    } else {
        return
    }
    let mut h1: u64 = 2166136261
    let mut h2: u64 = 2246822519
    k = 0
    while k < n {
        let b = u64(folded[k])
        // 32-bit FNV-1a, masked after each multiply so the checked
        // arithmetic stays in range (h <= 2^32-1 keeps h*p < 2^63).
        h1 = (h1 * 16777619) & 4294967295
        h1 = h1 ^ b
        h2 = (h2 * 16777619) & 4294967295
        h2 = h2 ^ b
        k = k + 1
    }
    let d = i32((h1 & 2147483647) % u64(GI_DIM))
    let mut sgn = -1.0
    if (h2 & 1) != 0 {
        sgn = 1.0
    }
    let w = embed_weight(d)
    out[d] = out[d] + sgn * w
}

/// Split one raw word run into segments at '_' and at case/digit-class
/// boundaries, then hash each segment. Keeps raw case for boundary logic;
/// hash_segment folds.
fn hash_word_run(word: []int, out: &mut []float) {
    let mut seg = []int {}
    let mut k = 0
    while k <= word.len {
        let mut ch = -1
        if k < word.len {
            ch = word[k]
        }
        let mut flush = 0
        if ch == 95 {
            flush = 1
        } else if k == word.len {
            flush = 1
        } else if is_alpha(fold_case(ch)) {
            if seg.len > 0 {
                let prev_c = fold_case(seg[seg.len - 1])
                if is_digit(prev_c) {
                    flush = 1
                } else if is_alpha(prev_c) {
                    let cur_upper = ch >= 65 && ch <= 90
                    let prev_lower = seg[seg.len - 1] >= 97 && seg[seg.len - 1] <= 122
                    if cur_upper && prev_lower {
                        flush = 1
                    }
                }
            }
        } else if seg.len > 0 && is_digit(fold_case(ch)) {
            let prev_c = fold_case(seg[seg.len - 1])
            if is_alpha(prev_c) {
                flush = 1
            }
        }
        if flush == 1 {
            hash_segment(seg, out)
            seg = []int {}
        }
        if ch != 95 && ch >= 0 {
            push(seg, ch)
        }
        k = k + 1
    }
}

/// Embed `text` as GI_DIM doubles: identifiers split at word boundaries,
/// stopwords dropped, tokens weighted by corpus frequency when a scan
/// provided one. Used for chunks and queries alike.
fn embed_text(text: string) -> []float {
    let mut out = []float {}
    for i in 0..GI_DIM {
        push(out, 0.0)
    }
    let mut word = []int {}
    let mut i = 0
    while i <= text.len {
        let mut raw = -1
        if i < text.len {
            raw = text[i]
        }
        if raw >= 0 && is_word_char_raw(raw) {
            push(word, raw)
        } else if word.len > 0 {
            hash_word_run(word, &mut out)
            word = []int {}
        }
        i = i + 1
    }
    return out
}

/// Deterministic pseudo-random vector for synthetic load (seed -> vector).
/// Mirrors the wasm LCG recipe: products stay below 2^63 so the checked
/// arithmetic never traps; 24 low bits -> one float in [-1, 1).
fn rand_vec(seed: int) -> []float {
    let mut out = []float {}
    let mut x = u64(seed) * 2654435761 + 40503
    x = x & 4294967295
    for i in 0..GI_DIM {
        x = x * 1103515245 + 12345
        x = x & 4294967295
        let v = (x >> 8) & 16777215
        let f = ((v as float) / 8388608.0) * 2.0 - 1.0
        push(out, f)
    }
    return out
}

// ---------------------------------------------------------------------------
// Clock
// ---------------------------------------------------------------------------

fn now_us() -> int {
    return gi_now_us()
}

// ---------------------------------------------------------------------------
// The local memory engine (phase 1 binding): one open index for the desktop
// app, module-owned so every UI action is a plain call (no borrowed state
// crossing closure boundaries). The pure functions above stay available for
// tests and later phases.
// ---------------------------------------------------------------------------

let mut gi: VectorIndex = VectorIndex { map: 0, dim: GI_DIM, count: 0, cap: 0 }

/// Open (or create) the engine on `file_path` with `cap` vector slots.
fn engine_open(file_path: string, cap: int) -> bool {
    gi = create_vector_index(file_path, cap)
    return gi.map != 0
}

/// Close the engine (flush + unmap).
fn engine_close() {
    close_vector_index(gi)
    gi = VectorIndex { map: 0, dim: GI_DIM, count: 0, cap: 0 }
}

/// Wipe and recreate the engine file. 0 ok, -1 error (also returned when
/// the old file did not exist).
fn engine_wipe(file_path: string, cap: int) -> int {
    engine_close()
    delete_index_file(file_path)
    if engine_open(file_path, cap) {
        return 0
    }
    return -1
}

/// Insert one vector into the engine (capacity check in Yuga).
fn engine_insert(vector_id: int, data: []float) -> bool {
    return insert_vector(&mut gi, vector_id, data)
}

/// Sweep the engine for the top-`k` rows close to `query`.
fn engine_search(query: []float, k: int) -> []Record {
    return search_knn(gi, query, k)
}

/// Stored rows in the engine right now.
fn engine_rows() -> int {
    return gi.count
}

/// Vector slots the file was sized for.
fn engine_cap() -> int {
    return gi.cap
}

/// Mapped file bytes.
fn engine_bytes() -> int {
    return gi_map_bytes(gi.map)
}

/// Is the engine open?
fn engine_open_map() -> int {
    return gi.map
}

/// Word-overlap embedding stub (GI_DIM doubles).
fn engine_embed(text: string) -> []float {
    return embed_text(text)
}

/// Deterministic synthetic vector for load tests.
fn engine_rand_vec(seed: int) -> []float {
    return rand_vec(seed)
}

/// Monotonic microseconds.
fn engine_now_us() -> int {
    return now_us()
}
