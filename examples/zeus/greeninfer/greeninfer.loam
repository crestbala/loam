//! greeninfer.loam — GreenInfer desktop (macOS Cocoa via std:zeus).
//!
//! Clean, three-step flow: 1) point at a folder, 2) ask your code, 3) get a
//! model answer. Everything else (stats, watch toggle, key/model) is tucked
//! into the card it belongs to — no walls of copy. Retrieval is local and
//! microsecond-fast; models are optional (Grok cloud or a local Ollama).

import "std:async"
import "std:zeus"
import "std:colors"
import "std:spacing"
import "std:zui"
import "agent.loam"
import "engine.loam"
import "watcher.loam"

const DEMO_FILE: string = "/tmp/greeninfer_demo.bin"
const DEMO_CAP: int = 20000
const KNN_K: int = 6
const HIT_H: int = 42
const LIST_H: int = 220
const DEFAULT_ROOT: string = "./examples/zeus/greeninfer"
const DEFAULT_QUERY: string = "how does the watcher reindex a changed file"

/// One retrieved chunk row.
struct Hit {
    label: string,
    snippet: string,
}

let mut ram_armed: int = 0
let mut poll_armed: int = 0
let mut booted: int = 0

fn pct_of(score: float) -> int {
    let mut p = (score * 100.0) as int
    if p < 0 {
        p = 0
    }
    if p > 100 {
        p = 100
    }
    return p
}

fn default_exts() -> []string {
    let mut e = []string {}
    push(e, ".loam")
    push(e, ".md")
    push(e, ".c")
    push(e, ".h")
    return e
}

/// Does `s` contain `p`? (byte scan, for error-ish captions)
fn has_text(s: string, p: string) -> bool {
    if p.len == 0 || p.len > s.len {
        return false
    }
    let mut i = 0
    while i + p.len <= s.len {
        let mut hit = 1
        let mut k = 0
        while k < p.len {
            if s[i + k] != p[k] {
                hit = 0
                break
            }
            k = k + 1
        }
        if hit == 1 {
            return true
        }
        i = i + 1
    }
    return false
}

fn is_err_msg(s: string) -> bool {
    return has_text(s, "error") || has_text(s, "fail") || has_text(s, "unparsed")
}

fn endpoint_labels() -> []string {
    let mut e = []string {}
    push(e, "Local model (ollama)")
    push(e, "Grok (cloud)")
    return e
}

// ---------------------------------------------------------------------------
// Small building blocks
// ---------------------------------------------------------------------------

/// Live RAM chip: zeus.memory_kb() is the host resident-set size in KB.
fn RamChip() -> Node {
    let ram = zeus.signal(zeus.memory_kb())
    if ram_armed == 0 {
        ram_armed = 1
        async.interval(1000, fn() { ram.set(zeus.memory_kb()) })
    }
    return zeus.Box(style = Style(height = px(26),
                           direction = Direction.Row,
                           gap = Space.Exxs,
                           align = Align.Center,
                           padding = edges2(4, 10),
                           radius = corners(spacing.RAD_FULL),
                           background = colors.raised())) {
        zeus.Box(style = Style(width = px(6), height = px(6), radius = corners(3), background = colors.ok()))
        zeus.Text(fn() -> string {
            let mb = ram.get() / 1024
            return "RAM {{mb}} MB"
        },
style = Style(font = spacing.FONT_CAPTION, color = colors.mute()))
    }
}

fn Header() -> Node {
    return zui.Row(Space.Md) {
        zeus.Box(style = Style(width = px(10), height = px(26), radius = corners(5), background = zeus.ink()))
        zeus.Text("GreenInfer", style = Style(font = spacing.FONT_TITLE, color = zeus.ink()))
        zui.Chip("code memory", zeus.Tint.Mute)
        zui.Grow()
        RamChip()
        zeus.Text("Dark", style = Style(font = spacing.FONT_BODY, color = colors.mute()))
        zui.ThemeSwitch()
    }
}

/// Card caption: quiet by default, red when it reports a problem.
fn Caption(sig: Signal<string>) -> Node {
    let t = zeus.Text(fn() -> string {
        return sig.get()
    },
style = Style(font = spacing.FONT_CAPTION))
    // Colour tracks the message, so it is an effect: style props are data.
    return zeus.styled(t, || {
        if is_err_msg(sig.get()) {
            zeus.set_color(t, zeus.parse_hex_color(zeus.danger()))
            return
        }
        zeus.set_color(t, zeus.parse_hex_color(colors.mute()))
    })

}

fn HitRow(i: int, h: Hit) -> Node {
    return zeus.Box(style = Style(height = px(HIT_H),
                           direction = Direction.Column,
                           gap = 2,
                           justify = Align.Center,
                           padding = Edges(right = Space.Exs, left = Space.Exs))) {
        zeus.Text(h.label, style = Style(font = spacing.FONT_CONTROL, color = zeus.ink()))
        zeus.Text(h.snippet, style = Style(font = spacing.FONT_CAPTION, color = colors.dim()))
    }
}

fn AnsRow(i: int, s: string) -> Node {
    return zeus.Box(style = Style(height = px(20),
                           direction = Direction.Row,
                           align = Align.Center,
                           padding = Edges(right = Space.Exs, left = Space.Exs))) {
        zeus.Text(s, style = Style(font = spacing.FONT_CAPTION, color = colors.mute()))
    }
}

/// Split `s` into newline-separated lines (for the model answer box).
fn split_lines(s: string) -> []string {
    let mut out = []string {}
    let mut b = []int {}
    let mut i = 0
    while i <= s.len {
        let mut is_end = 0
        if i == s.len {
            is_end = 1
        }
        if is_end == 0 && s[i] != 10 {
            push(b, s[i])
        } else if b.len > 0 {
            push(out, string_from_bytes(b))
            b = []int {}
        }
        i = i + 1
    }
    if out.len == 0 {
        push(out, "")
    }
    return out
}

// ---------------------------------------------------------------------------
// Step 1 — watch a folder
// ---------------------------------------------------------------------------

fn StepWatch(folder: Signal<string>, watch_on: Signal<bool>, cap: Signal<string>,
             chunk_stat: Signal<int>, kb_stat: Signal<int>) -> Node {
    return zui.Card() {
        zui.Row(Space.Sm) {
            zui.Title("1 · Watch a folder")
            zui.Grow()
            zui.Badge("one file holds it all", zeus.Tint.Mute)
        }
        zui.Body("Point at a source tree. Files are chunked at 500 tokens and embedded into a single mmap'd index.")
        zui.Row(Space.Sm) {
            zui.Field("Source folder", folder, "repo-relative or absolute path", style = Style(width = px(560)))
            zui.Button("Index folder", look = zeus.Look.Solid, size = zeus.Size.Md,
                        on_click = fn() {
                let root = folder.get()
                if root.len == 0 {
                    cap.set("folder path is empty")
                    return
                }
                let t0 = engine.engine_now_us()
                let n = watcher.watch_scan(root, DEMO_FILE, DEMO_CAP,
                                           default_exts())
                let ms = (engine.engine_now_us() - t0) / 1000
                if n < 0 {
                    cap.set(watcher.watch_err_msg())
                    return
                }
                let m = watcher.watch_last_msg()
                chunk_stat.set(engine.engine_rows())
                kb_stat.set(engine.engine_bytes() / 1024)
                cap.set("{{m}} in {{ms}} ms")
            })
        }
        zui.Row(Space.Sm) {
            zeus.Text("Re-index automatically when files change",
                      style = Style(font = spacing.FONT_BODY, color = colors.mute()))
            zui.Switch(watch_on)
            zui.Grow()
            Caption(cap)
        }
    }

}

// ---------------------------------------------------------------------------
// Step 2 — ask your code
// ---------------------------------------------------------------------------

fn StepAsk(query: Signal<string>, hits: Signal<[]Hit>, qus: Signal<int>,
           cap: Signal<string>) -> Node {
    return zui.Card() {
        zui.Title("2 · Ask your code")
        zui.Body("Plain words work: the search is a cosine sweep over every chunk — local, no model involved.")
        zui.Row(Space.Sm) {
            zui.Field("Question", query, "e.g. how does search sweep the rows?", style = Style(width = px(480)))
            zui.Button("Search chunks", look = zeus.Look.Solid, size = zeus.Size.Md,
                        on_click = fn() {
                let text = query.get()
                if text.len == 0 {
                    cap.set("type a question first")
                    return
                }
                let qv = engine.embed_text(text)
                let t0 = engine.engine_now_us()
                let res = engine.engine_search(qv, KNN_K)
                let us = engine.engine_now_us() - t0
                let nrows = engine.engine_rows()
                qus.set(us)
                let mut items = []Hit {}
                let mut i = 0
                while i < res.len {
                    let r = res[i]
                    let pct = pct_of(r.score)
                    let lab = watcher.watch_label(r.id)
                    let snip = watcher.watch_snippet(r.id)
                    push(items, Hit {
                        label: "{{pct}}%  {{lab}}",
                        snippet: snip,
                    })
                    i = i + 1
                }
                hits.set(items)
                cap.set("swept {{nrows}} chunks in {{us}} us")
            })
        }
        zeus.Box(style = Style(height = px(LIST_H), radius = corners(8), border = line(1, colors.rule()))) {
            zui.VirtualList(hits, HIT_H, HitRow)
        }
        zui.Row(Space.Sm) {
            Caption(cap)
            zui.Grow()
        }
    }

}

// ---------------------------------------------------------------------------
// Step 3 — model answer (optional)
// ---------------------------------------------------------------------------

fn StepModel(prompt: Signal<string>, endpoint: Signal<int>, key_sig: Signal<string>,
             model_sig: Signal<string>, ans: Signal<[]string>, mus: Signal<int>,
             cap: Signal<string>) -> Node {
    return zui.Card() {
        zui.Row(Space.Sm) {
            zui.Title("3 · Model answer")
            zui.Grow()
            zui.Badge("optional", zeus.Tint.Ok)
        }
        zui.Body("Ask a question in your own words: the closest chunks are retrieved locally and go into the model's context. Grok needs an xAI key; the local option talks to Ollama on 127.0.0.1 and never leaves your machine.")
        zui.Row(Space.Sm) {
            zui.Field("Question for the model", prompt, "e.g. how does the watcher detect a changed file?", style = Style(width = px(600)))
        }
        zui.Row(Space.Sm) {
            zui.Field("Model", model_sig, "grok-4.6 / llama3.2 / qwen2.5-coder", style = Style(width = px(300)))
            zui.Select(endpoint, endpoint_labels())
            zui.Grow()
        }
        zui.Row(Space.Sm) {
            zui.Field("API key", key_sig, "xai-... only for Grok (console.x.ai)", style = Style(width = px(420)))
            zui.Button("Ask model", look = zeus.Look.Solid, size = zeus.Size.Md,
                        on_click = fn() {
                let question = prompt.get()
                if question.len == 0 {
                    cap.set("type a question above first")
                    return
                }
                let mut p = agent.ollama_pipeline(model_sig.get())
                if endpoint.get() == 1 {
                    let key = key_sig.get()
                    if key.len == 0 {
                        cap.set("paste a Grok API key, or switch to the local endpoint")
                        return
                    }
                    p = agent.grok_pipeline(key)
                }
                p.model = model_sig.get()
                let a = agent.query_agent(p, question, KNN_K)
                let lines = split_lines(a.text)
                ans.set(lines)
                mus.set(a.us)
                let chunks = a.context_chunks
                if a.remote == 1 {
                    cap.set("answered with {{chunks}} local chunks in {{a.us}} us")
                } else {
                    let e = agent.agent_last_error()
                    cap.set("not answered ({{e}}) — offline context in the box")
                }
            })
        }
        zeus.Box(style = Style(height = px(200), radius = corners(8), border = line(1, colors.rule()))) {
            zui.VirtualList(ans, 20, AnsRow)
        }
        zui.Row(Space.Sm) {
            Caption(cap)
            zui.Grow()
        }
    }

}

// ---------------------------------------------------------------------------
// Stats strip
// ---------------------------------------------------------------------------

fn StatsRow(chunk_stat: Signal<int>, kb_stat: Signal<int>, qus: Signal<int>,
            mus: Signal<int>) -> Node {
    return zui.Grid(config = GridConfig(columns = 4, gap = Space.Md)) {
        zui.StatCount("chunks", chunk_stat, zeus.Tint.Ink)
        zui.StatCount("index KB", kb_stat, zeus.Tint.Mute)
        zui.StatCount("search us", qus, zeus.Tint.Ok)
        zui.StatCount("model us", mus, zeus.Tint.Danger)
    }
}

// ---------------------------------------------------------------------------
// Boot + watch poll
// ---------------------------------------------------------------------------

fn boot(folder: Signal<string>, query: Signal<string>, hits: Signal<[]Hit>,
        qus: Signal<int>, wcap: Signal<string>, scap: Signal<string>,
        chunk_stat: Signal<int>, kb_stat: Signal<int>) {
    if booted != 0 {
        return
    }
    booted = 1
    let t0 = engine.engine_now_us()
    let n = watcher.watch_scan(DEFAULT_ROOT, DEMO_FILE, DEMO_CAP, default_exts())
    let ms = (engine.engine_now_us() - t0) / 1000
    chunk_stat.set(engine.engine_rows())
    kb_stat.set(engine.engine_bytes() / 1024)
    if n < 0 {
        wcap.set(watcher.watch_err_msg())
        return
    }
    folder.set(DEFAULT_ROOT)
    let m = watcher.watch_last_msg()
    wcap.set("{{m}} in {{ms}} ms")
    query.set(DEFAULT_QUERY)
    let qv = engine.embed_text(DEFAULT_QUERY)
    let t1 = engine.engine_now_us()
    let res = engine.engine_search(qv, KNN_K)
    let us = engine.engine_now_us() - t1
    qus.set(us)
    let mut items = []Hit {}
    let mut i = 0
    while i < res.len {
        let r = res[i]
        let pct = pct_of(r.score)
        let lab = watcher.watch_label(r.id)
        let snip = watcher.watch_snippet(r.id)
        push(items, Hit { label: "{{pct}}%  {{lab}}", snippet: snip })
        i = i + 1
    }
    hits.set(items)
    scap.set("boot sweep {{us}} us — ask anything about the indexed code")
}

fn GreenInferPage() -> Node {
    return Column(spacing.SECTION) {
        let folder = zeus.signal(DEFAULT_ROOT)
        let query = zeus.signal(DEFAULT_QUERY)
        let prompt = zeus.signal("how does the watcher detect a changed file and re-index it?")
        let hits = zeus.signal([]Hit {})
        let ans0 = split_lines("The model's answer appears here when you ask.")
        let ans = zeus.signal(ans0)
        let qus = zeus.signal(0)
        let mus = zeus.signal(0)
        let chunk_stat = zeus.signal(0)
        let kb_stat = zeus.signal(0)
        let watch_on = zeus.signal(false)
        let endpoint = zeus.signal(1)
        let key_sig = zeus.signal("")
        let model_sig = zeus.signal("grok-4.6")
        let wcap = zeus.signal("")
        let scap = zeus.signal("")
        let mcap = zeus.signal("model calls are optional — retrieval is already local")

        boot(folder, query, hits, qus, wcap, scap, chunk_stat, kb_stat)

        if poll_armed == 0 {
            poll_armed = 1
            async.interval(1500, fn() {
                if !watch_on.get() {
                    return
                }
                let n = watcher.watch_tick()
                if n > 0 {
                    let msg = watcher.watch_last_msg()
                    chunk_stat.set(watcher.watch_chunks())
                    kb_stat.set(engine.engine_bytes() / 1024)
                    wcap.set(msg)
                }
            })
        }

        // Mirror engine state into stats (only when something moved).
        let mut kb = 0
        if engine.engine_open_map() != 0 {
            kb = engine.engine_bytes() / 1024
        }
        if kb_stat.get() != kb {
            kb_stat.set(kb)
        }
        let nch = engine.engine_rows()
        if chunk_stat.get() != nch {
            chunk_stat.set(nch)
        }

        zui.Page() {
            Header()
            zui.Row(Space.Md) {
                zeus.Box(style = Style(width = px(6), height = px(6), radius = corners(3), background = colors.ok()))
                zeus.Text("Your codebase as local memory — watch a folder, ask in plain words. Everything stays in one file on this machine.", style = Style(font = spacing.FONT_BODY, color = colors.mute()))
                zui.Grow()
            }
            StatsRow(chunk_stat, kb_stat, qus, mus)
            StepWatch(folder, watch_on, wcap, chunk_stat, kb_stat)
            StepAsk(query, hits, qus, scap)
            StepModel(prompt, endpoint, key_sig, model_sig, ans, mus, mcap)
            zui.Note("GreenInfer: Loam engine + mmap + ARM NEON sweep. Tip: edit a file under the watched folder and it appears in search ~1.5 s later.")
        }

    }
}

fn main() {
    zeus.App("GreenInfer", fn() -> Node {
        return GreenInferPage()
    }, 1060, 900)
}
