//! main.loam — GreenInfer CLI (component 5): index a folder into the mmap
//! memory, then run the retrieval + agent pipeline headlessly and print the
//! results with timings. This is the same engine the desktop app drives;
//! the only difference is the front end (fmt vs zeus).
//!
//! Build & run from the repo root:
//!   make
//!   LOAM_LINK_EXTRA="examples/zeus/greeninfer/runtime/greeninfer_runtime.c" \
//!     ./bin/yugac examples/zeus/greeninfer/main.loam -o greeninfer-macos
//!   ./greeninfer-macos
//!
//! Optional Grok: put your xAI API key in `greeninfer_key.txt` next to the
//! binary; without it the agent answers from the offline context summary.

import "std:fmt"
import "std:sys"
import "engine.loam"
import "watcher.loam"
import "agent.loam"

const CLI_FILE: string = "/tmp/greeninfer_memory.bin"
const CLI_CAP: int = 20000
const CLI_ROOT: string = "./examples/zeus/greeninfer"
const TOPK: int = 4
// Optional models: put an xAI key in greeninfer_key.txt to ask Grok cloud;
// otherwise put a model name in greeninfer_model.txt to ask a local Ollama
// (127.0.0.1:11434). Without either, answers are the offline context summary.
const KEY_FILE: string = "./greeninfer_key.txt"
const MODEL_FILE: string = "./greeninfer_model.txt"

fn exts() -> []string {
    let mut e = []string {}
    push(e, ".loam")
    push(e, ".md")
    push(e, ".c")
    push(e, ".h")
    return e
}

/// Trim trailing whitespace/newline bytes off the key file read.
fn trim_tail(s: string) -> string {
    let mut n = s.len
    while n > 0 {
        let c = s[n - 1]
        if c == 10 || c == 13 || c == 32 || c == 9 {
            n = n - 1
        } else {
            break
        }
    }
    let mut b = []int {}
    let mut i = 0
    while i < n {
        push(b, s[i])
        i = i + 1
    }
    return string_from_bytes(b)
}

fn main() {
    fmt.println("greeninfer-macos — local memory engine (CLI)")
    fmt.println("index root:", CLI_ROOT)

    let t0 = engine.engine_now_us()
    let n = watcher.watch_scan(CLI_ROOT, CLI_FILE, CLI_CAP, exts())
    let ms = (engine.engine_now_us() - t0) / 1000
    if n < 0 {
        fmt.println("scan failed:", watcher.watch_err_msg())
        sys.exit(1)
    }
    fmt.println(watcher.watch_last_msg(), "in", ms, "ms")
    fmt.println("file:", CLI_FILE)

    // A few demo questions over the indexed memory.
    let mut queries = []string {}
    push(queries, "how does the engine search the mapped rows")
    push(queries, "what does the watcher do when a file changes")
    push(queries, "keep the c seam minimal and the logic in yuga")
    push(queries, "which file chunks does a crash search find")

    // Optional models: a Grok key file goes to api.x.ai; a model name file
    // asks a local Ollama; without either the agent answers offline.
    let key = trim_tail(watcher.gi_read_file(KEY_FILE))
    let mut p = agent.grok_pipeline(key)
    if key.len > 0 {
        fmt.println("grok key loaded from", KEY_FILE, "- questions go to api.x.ai")
    } else {
        let local_model = trim_tail(watcher.gi_read_file(MODEL_FILE))
        if local_model.len > 0 {
            p = agent.ollama_pipeline(local_model)
            fmt.println("local model", local_model, "from", MODEL_FILE, "- ollama on 127.0.0.1:11434")
        } else {
            fmt.println("no key/model files - answers are the offline context summary")
        }
    }

    let mut qi = 0
    while qi < queries.len {
        let q = queries[qi]
        fmt.println("")
        fmt.println("prompt:", q)

        let t1 = engine.engine_now_us()
        let hits = engine.engine_search(engine.embed_text(q), TOPK)
        let us = engine.engine_now_us() - t1
        fmt.println("knn over", engine.engine_rows(), "chunks:", us, "us")

        let mut hi = 0
        while hi < hits.len {
            let r = hits[hi]
            let pct = (r.score * 100.0) as int
            fmt.println("  ", pct, "%", watcher.watch_label(r.id))
            fmt.println("      ", watcher.watch_snippet(r.id))
            hi = hi + 1
        }

        let ans = agent.query_agent(p, q, TOPK)
        fmt.println("agent (", ans.us, "us,", ans.context_chunks, "chunks, remote", ans.remote, "):")
        fmt.println(ans.text)
        qi = qi + 1
    }

    engine.engine_close()
    fmt.println("")
    fmt.println("done — memory closed; the mmap file stays at", CLI_FILE)
}
