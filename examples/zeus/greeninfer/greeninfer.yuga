//! greeninfer.yuga — GreenInfer desktop demo (macOS Cocoa via std:zeus).
//!
//! The window explains the engine, then proves it: watch a folder, chunk
//! source + markdown at 500 tokens, embed every chunk into 384 dims, and
//! search the mmap'd memory with the Apple Silicon NEON sweep. The RSS chip
//! in the header is the app's real physical RAM footprint (resident set
//! size, OS-reported), so the "lightweight" claim is measured live.

import "std:async"
import "std:zeus"
import "agent.yuga"
import "engine.yuga"
import "watcher.yuga"

const DEMO_FILE: string = "/tmp/greeninfer_demo.bin"
const DEMO_CAP: int = 20000
const KNN_K: int = 6
const ROW_H: int = 46
const LIST_H: int = 260
const DEFAULT_ROOT: string = "./examples/zeus/greeninfer"
const DEFAULT_QUERY: string = "watch the folder and reindex changed files"

/// One hit row: file/chunk label plus a content snippet.
struct Hit {
    label: string,
    snippet: string,
}

let mut ram_armed: int = 0
let mut poll_armed: int = 0
let mut booted: int = 0

fn pct_of(score: float) -> int {
    let mut p = (score * 100.0) as int
    if p < 0 {
        p = 0
    }
    if p > 100 {
        p = 100
    }
    return p
}

fn default_exts() -> []string {
    let mut e = []string {}
    push(e, ".yuga")
    push(e, ".md")
    push(e, ".c")
    push(e, ".h")
    return e
}

// ---------------------------------------------------------------------------
// Chrome
// ---------------------------------------------------------------------------

/// Live RSS chip: zeus.mem_kb() is the host resident-set size in KB.
fn RamChip() {
    let ram = zeus.signal(zeus.mem_kb())
    if ram_armed == 0 {
        ram_armed = 1
        async.interval(1000, fn() { ram.set(zeus.mem_kb()) })
    }
    zeus.Box(align_direction = DIRECTION.Row, align_items = ALIGN.Center,
             spacing = SPACE.Exxs, padding_x = 10, padding_y = 4, height = 26,
             radius = zeus.RAD_FULL, background = zeus.raised()) {
        zeus.Box(width = 6, height = 6, radius = 3, background = zeus.ok())
        zeus.Text(fn() -> string {
            let mb = ram.get() / 1024
            return "app RAM {{mb}} MB (RSS)"
        }, color = zeus.mute(), font = zeus.FONT_CAPTION)
    }
}

fn Header() {
    zeus.Row(SPACE.Md) {
        zeus.Box(width = 10, height = 26, radius = 5, background = zeus.ink())
        zeus.Text("GreenInfer", color = zeus.ink(), font = zeus.FONT_TITLE)
        zeus.Chip("local memory engine", zeus.TINT.Ink)
        zeus.Chip("mmap + NEON", zeus.TINT.Ok)
        zeus.Chip("zero deps", zeus.TINT.Mute)
        zeus.Grow()
        RamChip()
        zeus.Text("Dark", color = zeus.mute(), font = zeus.FONT_BODY)
        zeus.Switch(zeus.appearance())
    }
}

/// One bullet in the "why it matters" list.
fn Bullet(text: string) {
    zeus.Row(SPACE.Sm) {
        zeus.Box(width = 6, height = 6, radius = 3, background = zeus.ink())
        zeus.Text(text, color = zeus.mute(), font = zeus.FONT_BODY)
    }
}

/// The explainer card: what GreenInfer is, what it does, why it helps.
fn About() {
    zeus.Card() {
        zeus.Row(SPACE.Sm) {
            zeus.Title("What is GreenInfer?")
            zeus.Grow()
            zeus.Badge("phase 3: engine + watcher + agent", zeus.TINT.Mute)
        }
        zeus.Body("A local-first vector memory for your codebase. It chunks source files into ~500-token pieces, embeds each chunk into a 384-dimensional vector, and stores everything in one memory-mapped file. When you ask something, it sweeps every chunk with the ARM NEON SIMD kernel and returns the nearest ones in microseconds — no server, no cloud, no index rebuild.")
        zeus.Overline("What you can do with it")
        zeus.Column(SPACE.Exxs) {
            Bullet("Ask questions about your own code and get the exact file + chunk that answers, instantly and offline.")
            Bullet("Watch a folder: edits are re-indexed automatically ~1.5 s after you save (toggle below).")
            Bullet("Retrieve relevant chunks to feed a frontier model — local-first RAG with a minimal context payload.")
            Bullet("Stay tiny: one file holds the memory (mapped, not copied), search stays under a millisecond, and the app's real RAM footprint (the RSS chip above) sits near 15 MB.")
        }
    }
}

// ---------------------------------------------------------------------------
// Search + stats
// ---------------------------------------------------------------------------

fn HitRow(i: int, h: Hit) {
    zeus.Column(SPACE.Exxxs) {
        zeus.Text(h.label, color = zeus.ink(), font = zeus.FONT_CONTROL)
        zeus.Text(h.snippet, color = zeus.dim(), font = zeus.FONT_CAPTION)
    }
}

fn SearchCard(query: Signal<string>, rows: Signal<[]Hit>, qus: Signal<int>,
              st: Signal<string>) {
    zeus.Card() {
        zeus.Row(SPACE.Sm) {
            zeus.Title("Try it")
            zeus.Grow()
            zeus.Badge("top {{KNN_K}} chunks", zeus.TINT.Ok)
        }
        zeus.Body("Ask in plain words, like you would ask an agent. The sim % is cosine similarity between your prompt's embedding and each chunk.")
        zeus.Row(SPACE.Sm) {
            zeus.Field("Question", query, "e.g. how does the search sweep the rows?")
            zeus.Button("Ask the memory", look = zeus.LOOK.Solid, size = zeus.SIZE.Md,
                        on_click = fn() {
                            let text = query.get()
                            if text.len == 0 {
                                st.set("question is empty")
                                return
                            }
                            let qv = engine.embed_text(text)
                            let t0 = engine.engine_now_us()
                            let hits = engine.engine_search(qv, KNN_K)
                            let us = engine.engine_now_us() - t0
                            let nrows = engine.engine_rows()
                            qus.set(us)
                            let mut items = []Hit {}
                            let mut i = 0
                            while i < hits.len {
                                let r = hits[i]
                                let pct = pct_of(r.score)
                                let lab = watcher.watch_label(r.id)
                                let snip = watcher.watch_snippet(r.id)
                                push(items, Hit {
                                    label: "{{pct}}%  {{lab}}",
                                    snippet: snip,
                                })
                                i = i + 1
                            }
                            rows.set(items)
                            st.set("swept {{nrows}} chunks in {{us}} us")
                        })
        }
        zeus.Box(height = LIST_H, border = 1, border_color = zeus.rule(), radius = 8) {
            zeus.VirtualList(rows, ROW_H, HitRow)
        }
    }
}

fn StatsGrid(rows_sig: Signal<int>, cap_sig: Signal<int>, kb_sig: Signal<int>,
             qus: Signal<int>) {
    zeus.Grid(config = GridConfig(columns = 4, gap = SPACE.Md)) {
        zeus.StatCount("chunks in memory", rows_sig, zeus.TINT.Ink)
        zeus.StatCount("capacity", cap_sig, zeus.TINT.Mute)
        zeus.StatCount("memory file KB", kb_sig, zeus.TINT.Ok)
        zeus.StatCount("last answer us", qus, zeus.TINT.Danger)
    }
}

// ---------------------------------------------------------------------------
// Agent card (optional Grok integration)
// ---------------------------------------------------------------------------

fn AnsRow(i: int, s: string) {
    zeus.Box(align_direction = DIRECTION.Row, align_items = ALIGN.Center,
             height = 20, padding_x = SPACE.Exs) {
        zeus.Text(s, color = zeus.mute(), font = zeus.FONT_CAPTION)
    }
}

/// Split `s` into newline-separated lines (for the answer box).
fn split_lines(s: string) -> []string {
    let mut out = []string {}
    let mut b = []int {}
    let mut i = 0
    while i <= s.len {
        let mut is_end = 0
        if i == s.len {
            is_end = 1
        }
        if is_end == 0 && s[i] != 10 {
            push(b, s[i])
        } else if b.len > 0 {
            push(out, string_from_bytes(b))
            b = []int {}
        }
        i = i + 1
    }
    if out.len == 0 {
        push(out, "")
    }
    return out
}

/// Ask the chosen model with the retrieved local chunks in the system
/// prompt. Endpoint 0 = local Ollama, 1 = Grok cloud.
fn AgentCard(query: Signal<string>, endpoint: Signal<int>, key_sig: Signal<string>,
              model_sig: Signal<string>, ans_sig: Signal<[]string>,
              qus: Signal<int>, st: Signal<string>) {
    zeus.Card() {
        zeus.Row(SPACE.Sm) {
            zeus.Title("Ask an AI model (optional)")
            zeus.Grow()
            zeus.Badge("local-first RAG", zeus.TINT.Ok)
        }
        zeus.Body("GreenInfer retrieves the best chunks locally, then sends only your question plus those chunks to the model. Grok needs an xAI key; the local endpoint uses Ollama on 127.0.0.1:11434 (ollama serve, then e.g. ollama pull llama3.2).")
        zeus.Row(SPACE.Sm) {
            zeus.Field("Model", model_sig, "grok-4.6 / llama3.2 / qwen2.5-coder …")
            zeus.Select(endpoint, endpoint_labels())
            zeus.Grow()
        }
        zeus.Row(SPACE.Sm) {
            zeus.Field("API key (cloud only)", key_sig, "xai-...  (from console.x.ai; local needs none)")
            zeus.Button("Ask", look = zeus.LOOK.Solid, size = zeus.SIZE.Md,
                        on_click = fn() {
                            let question = query.get()
                            if question.len == 0 {
                                st.set("question is empty — use the Try it box above")
                                return
                            }
                            let mut p = agent.ollama_pipeline(model_sig.get())
                            let mut backend = "local"
                            if endpoint.get() == 1 {
                                let key = key_sig.get()
                                if key.len == 0 {
                                    st.set("grok needs an API key — or switch to the local endpoint")
                                    return
                                }
                                p = agent.grok_pipeline(key)
                                backend = "grok"
                            }
                            p.model = model_sig.get()
                            let ans = agent.query_agent(p, question, KNN_K)
                            let lines = split_lines(ans.text)
                            ans_sig.set(lines)
                            qus.set(ans.us)
                            let chunks = ans.context_chunks
                            let remote = ans.remote
                            if remote == 1 {
                                st.set("{{backend}} answered over {{chunks}} local chunks in {{ans.us}} us")
                            } else {
                                let e = agent.agent_last_error()
                                st.set("{{backend}} failed ({{e}}) — offline fallback with {{chunks}} chunks")
                            }
                        })
        }
        zeus.Box(height = 220, border = 1, border_color = zeus.rule(), radius = 8) {
            zeus.VirtualList(ans_sig, 20, AnsRow)
        }
        zeus.Note("The key lives only in this field for the session. Cloud calls are TLS + cert-verified; local calls never leave your machine.")
    }
}

fn endpoint_labels() -> []string {
    let mut e = []string {}
    push(e, "Local model (ollama)")
    push(e, "Grok (cloud)")
    return e
}

fn Actions(folder: Signal<string>, st: Signal<string>, watch_on: Signal<int>) {
    zeus.Card() {
        zeus.Title("Point it at a folder")
        zeus.Body("Index any source tree (default: this app's own sources, so you can search the engine's code with the engine). Watch re-indexes on change.")
        zeus.Row(SPACE.Sm) {
            zeus.Field("Source folder", folder, "absolute or repo-relative path")
            zeus.Button("Index", look = zeus.LOOK.Solid, size = zeus.SIZE.Md,
                        on_click = fn() {
                            let root = folder.get()
                            if root.len == 0 {
                                st.set("folder path is empty")
                                return
                            }
                            let t0 = engine.engine_now_us()
                            let n = watcher.watch_scan(root, DEMO_FILE, DEMO_CAP,
                                                       default_exts())
                            let ms = (engine.engine_now_us() - t0) / 1000
                            if n < 0 {
                                let e = watcher.watch_err_msg()
                                st.set(e)
                                return
                            }
                            if n == 0 {
                                let m = watcher.watch_last_msg()
                                st.set(m)
                                return
                            }
                            let m = watcher.watch_last_msg()
                            st.set("{{m}} in {{ms}} ms")
                        })
        }
        zeus.Row(SPACE.Sm) {
            zeus.Text("Auto re-index when files change", color = zeus.mute(),
                      font = zeus.FONT_BODY)
            zeus.Switch(watch_on)
            zeus.Grow()
            zeus.Button("Close index", look = zeus.LOOK.Ghost, size = zeus.SIZE.Md,
                        on_click = fn() {
                            engine.engine_close()
                            st.set("index closed; the memory file stays on disk")
                        })
        }
        zeus.Note("Try editing a watched .yuga file and searching again: the new chunk appears in ~1.5 s.")
    }
}

// ---------------------------------------------------------------------------
// Boot + status
// ---------------------------------------------------------------------------

/// One scan + demo search at boot so the window opens with results.
fn boot_search(folder: Signal<string>, query: Signal<string>,
               rows: Signal<[]Hit>, qus: Signal<int>, st: Signal<string>) {
    if booted != 0 {
        return
    }
    booted = 1
    let t0 = engine.engine_now_us()
    let n = watcher.watch_scan(DEFAULT_ROOT, DEMO_FILE, DEMO_CAP, default_exts())
    let ms = (engine.engine_now_us() - t0) / 1000
    if n < 0 {
        let e = watcher.watch_err_msg()
        st.set(e)
        return
    }
    folder.set(DEFAULT_ROOT)
    query.set(DEFAULT_QUERY)
    let qv = engine.embed_text(DEFAULT_QUERY)
    let t1 = engine.engine_now_us()
    let hits = engine.engine_search(qv, KNN_K)
    let us = engine.engine_now_us() - t1
    qus.set(us)
    let mut items = []Hit {}
    let mut i = 0
    while i < hits.len {
        let r = hits[i]
        let pct = pct_of(r.score)
        let lab = watcher.watch_label(r.id)
        let snip = watcher.watch_snippet(r.id)
        push(items, Hit { label: "{{pct}}%  {{lab}}", snippet: snip })
        i = i + 1
    }
    rows.set(items)
    let m = watcher.watch_last_msg()
    st.set("{{m}} in {{ms}} ms; demo answer {{us}} us")
}

fn StatusLine(st: Signal<string>) {
    zeus.Row(SPACE.Exs) {
        zeus.Box(width = 6, height = 6, radius = 3, background = zeus.ok())
        zeus.Text(fn() -> string {
            return st.get()
        }, color = zeus.mute(), font = zeus.FONT_CAPTION)
    }
}

fn GreenInferPage() {
    let folder = zeus.signal(DEFAULT_ROOT)
    let query = zeus.signal(DEFAULT_QUERY)
    let rows = zeus.signal([]Hit {})
    let qus = zeus.signal(0)
    let rows_sig = zeus.signal(0)
    let cap_sig = zeus.signal(0)
    let kb_sig = zeus.signal(0)
    let watch_on = zeus.signal(0)
    let endpoint = zeus.signal(1)
    let key_sig = zeus.signal("")
    let model_sig = zeus.signal("grok-4.6")
    let ans0 = split_lines("Grok's answer appears here once you add a key and ask.")
    let ans_sig = zeus.signal(ans0)
    let st = zeus.signal("starting…")

    boot_search(folder, query, rows, qus, st)

    // Watch poll: every 1.5 s, re-walk the tree and re-index on change.
    if poll_armed == 0 {
        poll_armed = 1
        async.interval(1500, fn() {
            if watch_on.get() == 0 {
                return
            }
            let n = watcher.watch_tick()
            if n > 0 {
                let msg = watcher.watch_last_msg()
                rows_sig.set(watcher.watch_chunks())
                cap_sig.set(engine.engine_cap())
                kb_sig.set(engine.engine_bytes() / 1024)
                st.set(msg)
            }
        })
    }

    // Mirror engine state into stats without re-triggering a rebuild when
    // nothing moved (the page rebuilds on signal change).
    let mut kb = 0
    if engine.engine_open_map() != 0 {
        kb = engine.engine_bytes() / 1024
    }
    if kb_sig.get() != kb {
        kb_sig.set(kb)
    }
    let nrows = engine.engine_rows()
    if rows_sig.get() != nrows {
        rows_sig.set(nrows)
    }
    let ncap = engine.engine_cap()
    if cap_sig.get() != ncap {
        cap_sig.set(ncap)
    }

    zeus.Page() {
        Header()
        zeus.Breadcrumbs("GreenInfer", "Demo", "Watch + ask")
        About()
        StatsGrid(rows_sig, cap_sig, kb_sig, qus)
        SearchCard(query, rows, qus, st)
        AgentCard(query, endpoint, key_sig, model_sig, ans_sig, qus, st)
        Actions(folder, st, watch_on)
        StatusLine(st)
    }
}

fn main() {
    zeus.App("GreenInfer", 1020, 860, fn() {
        GreenInferPage()
    })
}
