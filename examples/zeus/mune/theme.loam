//! A dark listening room and a light studio, with a violet accent.
//!
//! Every colour here is a role token (`@slot`), not a hex value. A widget
//! stores the role and the paint pass resolves it against `appearance()`,
//! so the theme switch repaints the whole window without a rebuild. A hex
//! string would be baked in at build time, which is why the switch used to
//! move only its own thumb.
//!
//! Mune's own slots start at `BASE`, above every Zeus role. `install` also
//! binds the Zeus roles the stock widgets read (paper, ink, rules, the
//! accent), so a text field or a slider sits in the same room as the cards.
//!
//! Each layer and each section has its own colour, used the same way on
//! the instrument cards, the recording rows, and the waveform. The light
//! values are deeper so they hold contrast on a pale card.

import "std:zeus"

const BASE: int = 120

const PAPER: string = "@120"
const PANEL: string = "@121"
const TILE: string = "@122"
const TILE_HI: string = "@123"
const LINE: string = "@124"
const INK: string = "@125"
const MUTE: string = "@126"
const FAINT: string = "@127"
const ACCENT: string = "@128"
const ACCENT_SOFT: string = "@129"
const ON_ACCENT: string = "@130"
const WAVE_IDLE: string = "@131"
const OK: string = "@132"
const WARN: string = "@133"

const C_REC: string = "@134"
const C_DRUMS: string = "@135"
const C_BASS: string = "@136"
const C_PAD: string = "@137"
const C_ARP: string = "@138"
const C_BELLS: string = "@139"

const ROLE_MOTIF: string = "@140"
const ROLE_AIR: string = "@141"

const SEC_QUIET: string = "@142"
const SEC_VERSE: string = "@143"
const SEC_BUILD: string = "@144"
const SEC_DROP: string = "@145"
const SEC_BREAK: string = "@146"

/// The energy arc: quiet phrases cool, full ones warm.
const PATH_LOW: string = "@147"
const PATH_MID: string = "@148"
const PATH_HIGH: string = "@149"

/// Rhythm, motif, air.
fn role_color(r: int) -> string {
    if r == 1 {
        return ROLE_MOTIF
    }
    if r == 2 {
        return ROLE_AIR
    }
    return C_REC
}

/// Intro, verse, build, drop, break, outro.
fn section_color(k: int) -> string {
    if k == 1 {
        return SEC_VERSE
    }
    if k == 2 {
        return SEC_BUILD
    }
    if k == 3 {
        return SEC_DROP
    }
    if k == 4 {
        return SEC_BREAK
    }
    return SEC_QUIET
}

/// An energy on the arc, 0..1000, as its colour.
fn path_color(h: int) -> string {
    if h < 340 {
        return PATH_LOW
    }
    if h < 680 {
        return PATH_MID
    }
    return PATH_HIGH
}

fn is_dark() -> bool {
    return zeus.appearance().get() != 0
}

fn toggle() {
    let a = zeus.appearance()
    a.set(if a.peek() != 0 { 0 } else { 1 })
}

fn paint_role(s: string, light: int, dark: int) {
    let mut n = 0
    for i in 1..s.len {
        n = n * 10 + (s[i] - 48)
    }
    zeus.theme(n, light, dark)
}

let mut installed: bool = false

/// Register both appearances once. Zeus has set its own roles by the time
/// a window exists; these override the ones Mune cares about.
fn install() {
    if installed {
        return
    }
    installed = true
    //    token          light     dark
    paint_role(PAPER,       0xF4F1EA, 0x0B0D12)
    paint_role(PANEL,       0xFFFFFF, 0x12151D)
    paint_role(TILE,        0xF7F4EE, 0x181C26)
    paint_role(TILE_HI,     0xEBE6DC, 0x1F2431)
    paint_role(LINE,        0xE0DACD, 0x262B38)
    paint_role(INK,         0x1B1924, 0xF2EFE8)
    paint_role(MUTE,        0x4B4757, 0xB9B4AA)
    paint_role(FAINT,       0x6F6A78, 0x8C877E)
    paint_role(ACCENT,      0x6D4AE0, 0xA78BFA)
    paint_role(ACCENT_SOFT, 0xECE6FF, 0x2A2342)
    paint_role(ON_ACCENT,   0xFFFFFF, 0x140F22)
    paint_role(WAVE_IDLE,   0xCFC8DE, 0x343A4A)
    paint_role(OK,          0x0F8A5F, 0x34D399)
    paint_role(WARN,        0xB45309, 0xFBBF24)

    paint_role(C_REC,       0xC2861A, 0xF5C26B)
    paint_role(C_DRUMS,     0xDC2626, 0xF87171)
    paint_role(C_BASS,      0x2563EB, 0x60A5FA)
    paint_role(C_PAD,       0x7C3AED, 0xA78BFA)
    paint_role(C_ARP,       0x059669, 0x34D399)
    paint_role(C_BELLS,     0xDB2777, 0xF472B6)

    paint_role(ROLE_MOTIF,  0x0284C7, 0x7DD3FC)
    paint_role(ROLE_AIR,    0x7C3AED, 0xC4B5FD)

    paint_role(SEC_QUIET,   0xB8B2C4, 0x3B4252)
    paint_role(SEC_VERSE,   0x4F63D9, 0x5B6EE1)
    paint_role(SEC_BUILD,   0xD97706, 0xF59E0B)
    paint_role(SEC_DROP,    0x7C3AED, 0xA78BFA)
    paint_role(SEC_BREAK,   0x0891B2, 0x22D3EE)

    paint_role(PATH_LOW,    0x2563EB, 0x60A5FA)
    paint_role(PATH_MID,    0x7C3AED, 0xA78BFA)
    paint_role(PATH_HIGH,   0xDB2777, 0xF472B6)

    // The stock widgets (text fields, sliders, switches, buttons).
    zeus.theme(ROLE.Accent, 0x6D4AE0, 0xA78BFA)
    zeus.theme(ROLE.AccentSoft, 0xECE6FF, 0x2A2342)
    zeus.theme(ROLE.OnAccent, 0xFFFFFF, 0x140F22)
    zeus.theme(ROLE.OnInk, 0xFFFFFF, 0x140F22)
    zeus.theme(ROLE.Paper, 0xF4F1EA, 0x0B0D12)
    zeus.theme(ROLE.Plate, 0xFFFFFF, 0x1F2431)
    zeus.theme(ROLE.Raised, 0xFFFFFF, 0x12151D)
    zeus.theme(ROLE.Wash, 0xF7F4EE, 0x181C26)
    zeus.theme(ROLE.Bone, 0xEBE6DC, 0x262B38)
    zeus.theme(ROLE.Ink, 0x1B1924, 0xF2EFE8)
    zeus.theme(ROLE.Mute, 0x4B4757, 0xB9B4AA)
    zeus.theme(ROLE.Dim, 0x6F6A78, 0x8C877E)
    zeus.theme(ROLE.Rule, 0xE0DACD, 0x2E3442)
    zeus.theme(ROLE.Hard, 0xB9B2A4, 0x4A5163)
    zeus.theme(ROLE.FocusRing, 0x6D4AE0, 0xA78BFA)
}
