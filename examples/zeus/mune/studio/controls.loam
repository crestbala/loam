//! The sound controls, one signal each, so a slider or a switch binds
//! straight to its value. `snapshot` reads them all into a `Sound` for the
//! arranger; `pick_style` loads a style's preset and keeps the listener's
//! own choices (length, tempo, pitch, voices).

import "zeus"
import "../core/sound.loam" as sound
import "../core/styles.loam" as styles

let style = zeus.signal(styles.LOFI)
let energy = zeus.signal(styles.FLOW)
let length_ix = zeus.signal(1)
let tempo_auto = zeus.signal(true)
let tempo = zeus.signal(100)
let pitch = zeus.signal(0)
let voices = zeus.signal(sound.VOICES_REMOVE)

let rec_on = zeus.signal(true)
let rec_lvl = zeus.signal(70)
let drums_on = zeus.signal(true)
let drums_lvl = zeus.signal(70)
let bass_on = zeus.signal(true)
let bass_lvl = zeus.signal(70)
let pad_on = zeus.signal(true)
let pad_lvl = zeus.signal(70)
let pad_tone = zeus.signal(0)
let arp_on = zeus.signal(true)
let arp_lvl = zeus.signal(60)
let arp_tone = zeus.signal(0)
let bells_on = zeus.signal(true)
let bells_lvl = zeus.signal(60)

let echo = zeus.signal(35)
let echo_time = zeus.signal(sound.ECHO_8D)
let reverb = zeus.signal(40)
let space = zeus.signal(sound.SPACE_HALL)
let mod_kind = zeus.signal(sound.MOD_NONE)
let mod_amt = zeus.signal(40)
let lofi = zeus.signal(0)
let warmth = zeus.signal(25)
let width = zeus.signal(30)
let pump = zeus.signal(false)

let mut seed: int = 0
let mut installed: bool = false

/// Load the starting style once.
fn install() {
    if installed {
        return
    }
    installed = true
    apply(sound.preset(styles.LOFI))
}

fn snapshot() -> Sound {
    let mut bpm = 0
    if !tempo_auto.peek() {
        bpm = tempo.peek()
    }
    return Sound {
        style: style.peek(), energy: energy.peek(), length_ix: length_ix.peek(), tempo: bpm,
        pitch: pitch.peek(), voices: voices.peek(),
        rec_on: rec_on.peek(), rec_lvl: rec_lvl.peek(),
        drums_on: drums_on.peek(), drums_lvl: drums_lvl.peek(),
        bass_on: bass_on.peek(), bass_lvl: bass_lvl.peek(),
        pad_on: pad_on.peek(), pad_lvl: pad_lvl.peek(), pad_tone: pad_tone.peek(),
        arp_on: arp_on.peek(), arp_lvl: arp_lvl.peek(), arp_tone: arp_tone.peek(),
        bells_on: bells_on.peek(), bells_lvl: bells_lvl.peek(),
        echo: echo.peek(), echo_time: echo_time.peek(), reverb: reverb.peek(), space: space.peek(),
        mod_kind: mod_kind.peek(), mod_amt: mod_amt.peek(), lofi: lofi.peek(),
        warmth: warmth.peek(),
        width: width.peek(), pump: pump.peek(),
        seed: seed,
    }
}

fn apply(v: Sound) {
    zeus.batch(fn() {
        style.set(v.style)
        energy.set(v.energy)
        length_ix.set(v.length_ix)
        pitch.set(v.pitch)
        voices.set(v.voices)
        rec_on.set(v.rec_on)
        rec_lvl.set(v.rec_lvl)
        drums_on.set(v.drums_on)
        drums_lvl.set(v.drums_lvl)
        bass_on.set(v.bass_on)
        bass_lvl.set(v.bass_lvl)
        pad_on.set(v.pad_on)
        pad_lvl.set(v.pad_lvl)
        pad_tone.set(v.pad_tone)
        arp_on.set(v.arp_on)
        arp_lvl.set(v.arp_lvl)
        arp_tone.set(v.arp_tone)
        bells_on.set(v.bells_on)
        bells_lvl.set(v.bells_lvl)
        echo.set(v.echo)
        echo_time.set(v.echo_time)
        reverb.set(v.reverb)
        space.set(v.space)
        mod_kind.set(v.mod_kind)
        mod_amt.set(v.mod_amt)
        lofi.set(v.lofi)
        warmth.set(v.warmth)
        width.set(v.width)
        pump.set(v.pump)
    })
}

/// Switch to style `s`: its instruments and effects, the listener's length,
/// tempo, pitch, and voice choice.
fn pick_style(s: int) {
    let cur = snapshot()
    apply(sound.with_style(cur, s))
}

/// The tempo slider follows the piece once it is known.
fn follow_tempo(bpm: int) {
    if tempo_auto.peek() && bpm > 0 {
        tempo.set(bpm)
    }
}
