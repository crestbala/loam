// The key of a recording, from a mono 5512 Hz copy the decode job wrote.
//
// The file is cut in frames of 2048 samples (0.37 s, 2.7 Hz apart). Each
// frame is Hann-windowed and a Goertzel filter measures every semitone
// from A2 to C6. The magnitudes, each frame scaled to its own peak, fold
// into twelve pitch classes (`chroma_frames`).
//
// - The key is the Krumhansl–Kessler profile (24 rotations, major and
//   minor) that correlates best with the whole file's chroma.
// - A phrase's harmony is its chroma bar by bar (`phrase_chroma`); a bar
//   is named as the triad it fits best (`best_chord`), and any bar can be
//   scored against a chord in a key (`fit`).

import "std:math"
import "num.loam" as num

const RATE: int = 5512
const FRAME: int = 2048

fn names() -> []string {
    return []string { "C", "C♯", "D", "E♭", "E", "F", "F♯", "G", "A♭", "A", "B♭", "B" }
}

struct Tonality {
    /** *Pitch class of the tonic, 0 is C. -1 when there is no tonal centre. */
    tonic: int,
    minor: bool,
    /** *0..100: how far the best key stands above the next. */
    sure: int,
}

fn no_key() -> Tonality {
    return Tonality { tonic: -1, minor: false, sure: 0 }
}

fn major_profile() -> []f64 {
    return []f64 { 6.35, 2.23, 3.48, 2.33, 4.38, 4.09, 2.52, 5.19, 2.39, 3.66, 2.29, 2.88 }
}

fn minor_profile() -> []f64 {
    return []f64 { 6.33, 2.68, 3.52, 5.38, 2.60, 3.53, 2.54, 4.75, 3.98, 2.69, 3.34, 3.17 }
}

fn name(k: Tonality) -> string {
    if k.tonic < 0 || k.tonic > 11 {
        return "—"
    }
    let t = names()[k.tonic]
    if k.minor {
        return "{{t}}m"
    }
    return t
}

fn sample_at(b: string, i: int) -> f64 {
    let u = b[i * 2] + b[i * 2 + 1] * 256
    if u >= 32768 {
        return f64(u - 65536)
    }
    return f64(u)
}

fn correlate(a: []f64, prof: []f64, rot: int) -> f64 {
    let mut ma: f64 = 0.0
    let mut mp: f64 = 0.0
    for i in 0..12 {
        ma = ma + a[i]
        mp = mp + prof[i]
    }
    ma = ma / 12.0
    mp = mp / 12.0
    let mut num_v: f64 = 0.0
    let mut da: f64 = 0.0
    let mut dp: f64 = 0.0
    for i in 0..12 {
        let x = a[(i + rot) % 12] - ma
        let y = prof[i] - mp
        num_v = num_v + x * y
        da = da + x * x
        dp = dp + y * y
    }
    if da <= 0.0 || dp <= 0.0 {
        return 0.0
    }
    return num_v / math.sqrt(da * dp)
}

fn key_of_chroma(c: []f64) -> Tonality {
    let mut total: f64 = 0.0
    for i in 0..c.len {
        total = total + c[i]
    }
    if total <= 0.0 {
        return no_key()
    }
    let maj = major_profile()
    let min = minor_profile()
    let mut best: f64 = -2.0
    let mut second: f64 = -2.0
    let mut tonic = -1
    let mut minor = false
    for t in 0..12 {
        for mode in 0..2 {
            let r = if mode == 0 { correlate(c, maj, t) } else { correlate(c, min, t) }
            if r > best {
                second = best
                best = r
                tonic = t
                minor = mode == 1
            } else if r > second {
                second = r
            }
        }
    }
    if best < 0.35 {
        return no_key()
    }
    let sure = num.clampi(num.roundi((best - second) * 400.0 + (best - 0.35) * 60.0), 1, 100)
    return Tonality { tonic: tonic, minor: minor, sure: sure }
}

/** *The key of a recording from its chroma frames (`chroma_frames`): every */
/** *frame votes, each already scaled to its own peak, so a loud chorus does */
/** *not outvote the rest. */
fn key_of_frames(frames: []f64) -> Tonality {
    let mut c = []f64 {}
    for i in 0..12 {
        push(c, f64(0))
    }
    for f in 0..(frames.len / 12) {
        for i in 0..12 {
            c[i] = c[i] + frames[f * 12 + i]
        }
    }
    return key_of_chroma(c)
}

/** *The tonic of the relative major, so A minor and C major compare equal. */
fn major_root(k: Tonality) -> int {
    if k.minor {
        return (k.tonic + 3) % 12
    }
    return k.tonic
}

/** *Semitones (-6..+5) that move `from` onto `to` by the shortest way. */
fn shift_between(from: Tonality, to: Tonality) -> int {
    if from.tonic < 0 || to.tonic < 0 {
        return 0
    }
    let mut d = (major_root(to) - major_root(from) + 12) % 12
    if d > 5 {
        d = d - 12
    }
    return d
}

// ---- Harmony of a phrase -----------------------------------------------------

/** *Blocks per phrase, one per bar of a four-bar loop. A shorter phrase */
/** *repeats its bars (block b is bar b % bars), the way it will loop, so */
/** *block b always lines up with bar b of the progression. */
const BLOCKS: int = 4

/** *The chord register: A2 to C6. Above it is mostly overtones and hats. */
const CHORD_LOW: int = 45
const CHORD_HIGH: int = 84

/** *The bass register: C2 to B2. Its strongest pitch class is the chord's */
/** *root more often than not; it is what tells C from Am. */
const BASS_LOW: int = 36
const BASS_HIGH: int = 47

/** *A frame quieter than this, relative to the loud frames of the same */
/** *recording (−40 dB), is silence. Relative, so a quiet outro still has */
/** *chords. */
const GATE_DB: f64 = 40.0

/** *Chroma of every FRAME of the copy, back to back: twelve values a frame, */
/** *each frame scaled to its own peak. A near-silent frame is all zero. */
fn chroma_frames(pcm: string) -> []f64 {
    return goertzel_frames(pcm, CHORD_LOW, CHORD_HIGH)
}

/** *The same frames over the bass register only. */
fn bass_frames(pcm: string) -> []f64 {
    return goertzel_frames(pcm, BASS_LOW, BASS_HIGH)
}

/** *Energy of each windowed frame. */
fn frame_energy(pcm: string, win: []f64) -> []f64 {
    let n = pcm.len / 2
    let frames = n / FRAME
    let mut out = []f64 {}
    for f in 0..frames {
        let base = f * FRAME
        let mut energy: f64 = 0.0
        for i in 0..FRAME {
            let v = sample_at(pcm, base + i) * win[i]
            energy = energy + v * v
        }
        push(out, energy)
    }
    return out
}

/** *The silence gate for these frames: 40 dB under the loud ones (the */
/** *90th percentile), never above the old fixed floor and never under a */
/** *whisper. */
fn gate_of(energy: []f64) -> f64 {
    let fixed: f64 = f64(FRAME) * 40000.0
    let whisper: f64 = f64(FRAME) * 400.0
    if energy.len == 0 {
        return fixed
    }
    let mut v = []f64 {}
    for i in 0..energy.len {
        push(v, energy[i])
    }
    // Insertion sort is too slow for minutes of frames; a few rounds of
    // selection find the 90th percentile well enough: take the max of
    // the bottom 90% by counting.
    let mut top: f64 = 0.0
    for i in 0..v.len {
        if v[i] > top {
            top = v[i]
        }
    }
    let mut lo: f64 = 0.0
    let mut hi: f64 = top
    for round in 0..40 {
        let mid: f64 = (lo + hi) / 2.0
        let mut below = 0
        for i in 0..v.len {
            if v[i] <= mid {
                below = below + 1
            }
        }
        if below * 10 >= v.len * 9 {
            hi = mid
        } else {
            lo = mid
        }
    }
    let rel: f64 = hi * math.pow(10.0, 0.0 - GATE_DB / 10.0)
    return num.clampf(rel, whisper, fixed)
}

/** *Goertzel magnitudes of every semitone `low..high` over each FRAME, */
/** *folded into twelve pitch classes and scaled to the frame's peak. */
fn goertzel_frames(pcm: string, low: int, high: int) -> []f64 {
    let mut out = []f64 {}
    let n = pcm.len / 2
    let frames = n / FRAME
    let mut win = []f64 {}
    for i in 0..FRAME {
        push(win, 0.5 - 0.5 * num.cos(num.TAU * f64(i) / f64(FRAME - 1)))
    }
    let energy = frame_energy(pcm, win)
    let gate = gate_of(energy)
    let mut coeff = []f64 {}
    for m in low..(high + 1) {
        push(coeff, 2.0 * num.cos(num.TAU * num.midi_hz(m) / f64(RATE)))
    }
    let mut x = []f64 {}
    for i in 0..FRAME {
        push(x, f64(0))
    }
    let mut mags = []f64 {}
    for k in 0..coeff.len {
        push(mags, f64(0))
    }
    for f in 0..frames {
        let base = f * FRAME
        let mut pc = []f64 {}
        for i in 0..12 {
            push(pc, f64(0))
        }
        if energy[f] > gate {
            for i in 0..FRAME {
                x[i] = sample_at(pcm, base + i) * win[i]
            }
            let mut peak: f64 = 0.0
            for k in 0..coeff.len {
                let c = coeff[k]
                let mut s1: f64 = 0.0
                let mut s2: f64 = 0.0
                for i in 0..FRAME {
                    let s0 = x[i] + c * s1 - s2
                    s2 = s1
                    s1 = s0
                }
                let p = s1 * s1 + s2 * s2 - c * s1 * s2
                let mag = math.sqrt(if p > 0.0 { p } else { 0.0 })
                mags[k] = mag
                if mag > peak {
                    peak = mag
                }
            }
            if peak > 0.0 {
                for k in 0..coeff.len {
                    let at = (low + k) % 12
                    pc[at] = pc[at] + mags[k] / peak
                }
            }
        }
        for i in 0..12 {
            push(out, pc[i])
        }
    }
    return out
}

/** *Frames `[from, to)` of block `b` of a phrase at `start`, `len` samples */
/** *(48 kHz) long and `bars` bars. A shorter phrase repeats its bars. */
fn block_frames(start: int, len: int, bars: int, b: int) -> []int {
    let nb = if bars > 0 { bars } else { BLOCKS }
    let bar = b % nb
    let a = i64(start) + i64(len) * i64(bar) / i64(nb)
    let e = i64(start) + i64(len) * i64(bar + 1) / i64(nb)
    let fa = i32(a * i64(RATE) / i64(48000)) / FRAME
    let mut fe = (i32(e * i64(RATE) / i64(48000)) + FRAME - 1) / FRAME
    if fe <= fa {
        fe = fa + 1
    }
    return []int { fa, fe }
}

/** *Four blocks of chroma per phrase, flattened: `out[p * 48 + b * 12 + pc]`, */
/** *each block scaled so its top pitch class is 1000. `bars` 0 is free time: */
/** *the phrase is cut in four equal blocks. */
fn phrase_chroma(frames: []f64, starts: []int, lens: []int, bars: []int) -> []int {
    let mut out = []int {}
    let n = frames.len / 12
    for p in 0..starts.len {
        for b in 0..BLOCKS {
            let span = block_frames(starts[p], lens[p], bars[p], b)
            let fa = span[0]
            let fe = span[1]
            let mut acc = []f64 {}
            for i in 0..12 {
                push(acc, f64(0))
            }
            let mut top: f64 = 0.0
            for f in fa..fe {
                if f >= 0 && f < n {
                    for i in 0..12 {
                        acc[i] = acc[i] + frames[f * 12 + i]
                    }
                }
            }
            for i in 0..12 {
                if acc[i] > top {
                    top = acc[i]
                }
            }
            for i in 0..12 {
                push(out, if top > 0.0 { num.roundi(acc[i] * 1000.0 / top) } else { 0 })
            }
        }
    }
    return out
}

/** *A chord as one int: the root's pitch class, plus 12 when minor. */
fn chord_code(root: int, minor: bool) -> int {
    let r = (root % 12 + 12) % 12
    return if minor { r + 12 } else { r }
}

fn chord_root(c: int) -> int {
    return c % 12
}

fn chord_minor(c: int) -> bool {
    return c >= 12
}

fn chord_name(c: int) -> string {
    if c < 0 {
        return "—"
    }
    let r = names()[chord_root(c)]
    if chord_minor(c) {
        return "{{r}}m"
    }
    return r
}

/** *Pitch classes of the triad: root, third, fifth. */
fn chord_tones(c: int) -> []int {
    let r = chord_root(c)
    let third = if chord_minor(c) { 3 } else { 4 }
    return []int { r, (r + third) % 12, (r + 7) % 12 }
}

/** *Is pitch class `pc` in the scale of `tonic` (natural minor or major)? */
fn in_scale(pc: int, tonic: int, minor: bool) -> bool {
    let d = ((pc - tonic) % 12 + 12) % 12
    let steps = if minor { []int { 0, 2, 3, 5, 7, 8, 10 } } else { []int { 0, 2, 4, 5, 7, 9, 11 } }
    for i in 0..steps.len {
        if steps[i] == d {
            return true
        }
    }
    return false
}

/** *The block at `at` with its floor taken out: what stands above the */
/** *broadband wash a drum or a noise leaves in every pitch class. */
fn lifted(ch: []int, at: int) -> []int {
    let mut lo = 1000
    for i in 0..12 {
        if ch[at + i] < lo {
            lo = ch[at + i]
        }
    }
    let mut out = []int {}
    for i in 0..12 {
        push(out, ch[at + i] - lo)
    }
    return out
}

/** *How tonal a block is, 0..1000: how far its three strongest pitch */
/** *classes stand above its six weakest. A chord stands out; a drum loop or */
/** *a hiss spreads evenly and reads near 0. */
fn tonal(ch: []int, at: int) -> int {
    if at + 12 > ch.len {
        return 0
    }
    let mut v = []int {}
    for i in 0..12 {
        push(v, ch[at + i])
    }
    num.sort_ints(v)
    let top = (v[11] + v[10] + v[9]) / 3
    let bottom = (v[0] + v[1] + v[2] + v[3] + v[4] + v[5]) / 6
    if top <= 0 {
        return 0
    }
    let contrast = (top - bottom) * 1000 / top
    // Hiss and pink noise read 300..370 over a bar, music 550..850, a
    // pure chord near 1000.
    return num.clampi((contrast - 400) * 1000 / 350, 0, 1000)
}

/** *How well the block at `at` sits on `chord` in the key, 0..1000: weight */
/** *on chord tones counts fully, other scale tones half, the rest nothing. */
/** *An atonal block fits everything. */
fn fit(ch: []int, at: int, chord: int, tonic: int, minor: bool) -> int {
    if at + 12 > ch.len || chord < 0 {
        return 1000
    }
    let x = lifted(ch, at)
    let tones = chord_tones(chord)
    let mut total = 0
    let mut good = 0
    for pc in 0..12 {
        total = total + x[pc]
        if pc == tones[0] || pc == tones[1] || pc == tones[2] {
            good = good + x[pc] * 2
        } else if in_scale(pc, tonic, minor) {
            good = good + x[pc]
        }
    }
    if total <= 0 {
        return 1000
    }
    return num.clampi(good * 500 / total, 0, 1000)
}

/** *The triad the block at `at` plays, or -1 when it is not tonal enough to */
/** *say. Root, third, and fifth weigh 1, 0.8, 0.7; a chord inside the key */
/** *wins a near tie. */
fn best_chord(ch: []int, at: int, tonic: int, minor: bool) -> int {
    if tonal(ch, at) < 250 {
        return -1
    }
    let x = lifted(ch, at)
    let mut best = -1
    let mut best_v = -1
    for c in 0..24 {
        let t = chord_tones(c)
        let mut v = x[t[0]] * 10 + x[t[1]] * 8 + x[t[2]] * 7
        if in_scale(t[0], tonic, minor) &&
            in_scale(t[1], tonic, minor) &&
            in_scale(t[2], tonic, minor) {
            v = v + v / 12
        }
        if v > best_v {
            best_v = v
            best = c
        }
    }
    return best
}

/** *The block at `at` moved up by `semis`, as a new block of 12. */
fn rotate(ch: []int, at: int, semis: int) -> []int {
    let mut out = []int {}
    for i in 0..12 {
        push(out, 0)
    }
    if at + 12 > ch.len {
        return out
    }
    for i in 0..12 {
        out[((i + semis) % 12 + 12) % 12] = ch[at + i]
    }
    return out
}

// ---- Chords as a sequence --------------------------------------------------

/** *The decoder's states: the 24 triads (`chord_code`), then no chord. */
const NO_CHORD: int = 24
const STATES: int = 25

/** *How strongly a frame's chroma speaks, in log-likelihood per frame. */
const SURE: f64 = 6.0
/** *What it costs the path to change chord: to a chord in the key, to one */
/** *outside it, and into or out of no chord. A frame (0.37 s) smeared by a */
/** *drum or a passing note does not pay for a change and back; a chord that */
/** *holds does. Chosen on Mune's own renders of every style, where the bar's */
/** *chord is known: these sit in the middle of a broad best plateau (84–86% */
/** *of bars named right, against 80% for each bar read alone). */
const MOVE_IN_KEY: f64 = 2.5
const MOVE_OUT_KEY: f64 = 3.4
const MOVE_NONE: f64 = 1.7
/** *A bar names the chord that holds this share of its frames, or none. */
const HOLD_PCT: int = 40

/** *How tonal frame `f` is, 0..1: its three strongest pitch classes against */
/** *its six weakest, on the scale `tonal` uses for a block. */
fn frame_tonal(c: []f64) -> f64 {
    let mut v = []f64 {}
    for i in 0..12 {
        push(v, c[i])
    }
    // Insertion sort: twelve values.
    for i in 1..12 {
        let x = v[i]
        let mut j = i
        while j > 0 && v[j - 1] > x {
            v[j] = v[j - 1]
            j = j - 1
        }
        v[j] = x
    }
    let top: f64 = (v[11] + v[10] + v[9]) / 3.0
    let bottom: f64 = (v[0] + v[1] + v[2] + v[3] + v[4] + v[5]) / 6.0
    if top <= 0.0 {
        return 0.0
    }
    let contrast: f64 = (top - bottom) / top
    return num.clampf((contrast - 0.4) / 0.35, 0.0, 1.0)
}

/** *How much the bass's strongest note decides the root, in the same units */
/** *as the cosine. */
const BASS_WEIGHT: f64 = 0.35

/** *Log-likelihood of each state for one frame of chroma. A triad scores the */
/** *cosine between the frame (its floor taken out) and the triad's weights */
/** *(root 1, third 0.8, fifth 0.7), damped when the frame is not tonal, plus */
/** *how strong its root is in the bass (`bass`, twelve values scaled to their */
/** *peak, or empty). No chord scores high on silence, hiss, and drums, and */
/** *low on a clear triad. */
fn emissions(c: []f64, bass: []f64) -> []f64 {
    let mut out = []f64 {}
    let mut lo: f64 = c[0]
    for i in 1..12 {
        if c[i] < lo {
            lo = c[i]
        }
    }
    let mut x = []f64 {}
    let mut norm: f64 = 0.0
    for i in 0..12 {
        let v: f64 = c[i] - lo
        push(x, v)
        norm = norm + v * v
    }
    let t = frame_tonal(c)
    let silent = norm <= 0.000001
    let tn: f64 = math.sqrt(1.0 + 0.64 + 0.49)
    let len: f64 = math.sqrt(norm)
    for k in 0..24 {
        if silent {
            push(out, f64(0))
            continue
        }
        let tones = chord_tones(k)
        let dot: f64 = x[tones[0]] + 0.8 * x[tones[1]] + 0.7 * x[tones[2]]
        let cos: f64 = dot / (len * tn)
        let mut root: f64 = 0.0
        if bass.len >= 12 {
            root = BASS_WEIGHT * (bass[tones[0]] - 0.5)
        }
        push(out, SURE * (cos * (0.6 + 0.4 * t) + root))
    }
    push(out, if silent { SURE } else { SURE * (0.2 + 0.5 * (1.0 - t)) })
    return out
}

fn in_key(k: int, tonic: int, minor: bool) -> bool {
    let t = chord_tones(k)
    return in_scale(t[0], tonic, minor) &&
        in_scale(t[1], tonic, minor) &&
        in_scale(t[2], tonic, minor)
}

/** *What it costs to go from state `a` to state `b`. */
fn move_cost(a: int, b: int, tonic: int, minor: bool) -> f64 {
    if a == b {
        return 0.0
    }
    if a == NO_CHORD || b == NO_CHORD {
        return MOVE_NONE
    }
    return if in_key(b, tonic, minor) { MOVE_IN_KEY } else { MOVE_OUT_KEY }
}

/** *The most likely chord of every frame (`chord_code`, or −1 for none): a */
/** *hidden Markov model over the 24 triads and no chord, decoded with */
/** *Viterbi. The whole recording is one path, so a phrase cut from it */
/** *inherits chords heard in context, not guessed from its bars alone. */
/** *`bass` is `bass_frames` of the same copy, or empty. */
fn chord_path(frames: []f64, bass: []f64, tonic: int, minor: bool) -> []int {
    let n = frames.len / 12
    let mut out = []int {}
    if n == 0 {
        return out
    }
    let mut cost = []f64 {}
    for b in 0..STATES {
        let mut row = []f64 {}
        for a in 0..STATES {
            push(row, f64(0))
        }
        for a in 0..STATES {
            row[a] = move_cost(a, b, tonic, minor)
        }
        for a in 0..STATES {
            push(cost, row[a])
        }
    }
    let mut back = []int {}
    let mut score = []f64 {}
    let mut c = []f64 {}
    let mut lowc = []f64 {}
    for i in 0..12 {
        push(c, frames[i])
        push(lowc, if bass.len >= 12 { bass[i] } else { f64(0) })
    }
    let has_bass = bass.len >= frames.len
    let e0 = emissions(c, if has_bass { lowc } else { []f64 {} })
    for k in 0..STATES {
        // Starting outside the key costs what moving there would.
        let start: f64 = if k == NO_CHORD || in_key(k, tonic, minor) {
            0.0
        } else {
            MOVE_OUT_KEY - MOVE_IN_KEY
        }
        push(score, e0[k] - start)
        push(back, k)
    }
    let mut next = []f64 {}
    for k in 0..STATES {
        push(next, f64(0))
    }
    for f in 1..n {
        for i in 0..12 {
            c[i] = frames[f * 12 + i]
            if has_bass {
                lowc[i] = bass[f * 12 + i]
            }
        }
        let e = emissions(c, if has_bass { lowc } else { []f64 {} })
        for b in 0..STATES {
            let mut best: f64 = score[0] - cost[b * STATES]
            let mut arg = 0
            for a in 1..STATES {
                let v: f64 = score[a] - cost[b * STATES + a]
                if v > best {
                    best = v
                    arg = a
                }
            }
            next[b] = best + e[b]
            push(back, arg)
        }
        for k in 0..STATES {
            score[k] = next[k]
        }
    }
    let mut state = 0
    for k in 1..STATES {
        if score[k] > score[state] {
            state = k
        }
    }
    let mut rev = []int {}
    for f in 0..n {
        push(rev, 0)
    }
    let mut f = n - 1
    while f >= 0 {
        rev[f] = state
        state = back[f * STATES + state]
        f = f - 1
    }
    for i in 0..n {
        push(out, if rev[i] == NO_CHORD { -1 } else { rev[i] })
    }
    return out
}

/** *Four chords per phrase, one per block (`out[p * 4 + b]`), from the */
/** *decoded path: the chord that holds at least `HOLD_PCT` of the block's */
/** *frames, else −1. */
fn phrase_chords(path: []int, starts: []int, lens: []int, bars: []int) -> []int {
    let mut out = []int {}
    for p in 0..starts.len {
        for b in 0..BLOCKS {
            let span = block_frames(starts[p], lens[p], bars[p], b)
            let mut votes = []int {}
            for k in 0..STATES {
                push(votes, 0)
            }
            let mut total = 0
            for f in span[0]..span[1] {
                if f >= 0 && f < path.len {
                    let k = if path[f] < 0 { NO_CHORD } else { path[f] }
                    votes[k] = votes[k] + 1
                    total = total + 1
                }
            }
            let mut best = NO_CHORD
            for k in 0..24 {
                if votes[k] > votes[best] {
                    best = k
                }
            }
            let named = best != NO_CHORD && total > 0 && votes[best] * 100 >= total * HOLD_PCT
            push(out, if named { best } else { -1 })
        }
    }
    return out
}
