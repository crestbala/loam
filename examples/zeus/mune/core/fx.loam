//! Effects, as filter-graph text. Each function returns one chain (no
//! labels) or a source; `graph.loam` wires them.
//!
//! - Echo is a ping-pong send: left repeats on odd beats of the delay,
//!   right on even ones, darker each time.
//! - Reverb is convolution with a generated room: decorrelated noise in
//!   each ear with an exponential decay (RT60 of the space), a short
//!   pre-delay, and the lows and highs taken out so it does not muddy.
//! - The centre mask is the voice cleaner for a recording with no voice
//!   map: per frequency bin, sound that is identical in both ears (where a
//!   lead voice sits) is removed between 120 Hz and 16 kHz.

import "std:math"
import "num.loam" as num
import "sound.loam" as sound
import "time.loam" as time

/// Echo time in ms for `which` (`sound.ECHO_*`) at `bpm_c`.
fn echo_ms(which: int, bpm_c: int) -> int {
    let beat = 6000000 / num.clampi(bpm_c, 3000, 30000)
    if which == sound.ECHO_8 {
        return beat / 2
    }
    if which == sound.ECHO_4 {
        return beat
    }
    if which == sound.ECHO_2 {
        return beat * 2
    }
    return beat * 3 / 4
}

/// Wet-only ping-pong from stereo `[in]` to stereo `[out]`.
fn echo_lines(input: string, output: string, amount: int, which: int, bpm_c: int) -> []string {
    let d = echo_ms(which, bpm_c)
    let fb = 0.3 + 0.4 * f64(amount) / 100.0
    let f2 = fb * fb
    let gain = -22.0 + 16.0 * f64(amount) / 100.0
    let mut out = []string {}
    push(out, "[{{input}}]pan=mono|c0=0.5*c0+0.5*c1,asplit=2[{{output}}_l][{{output}}_r]")
    push(out, "[{{output}}_l]aecho=in_gain=0:out_gain=1:delays={{d}}|{{d * 3}}:decays={{num.f3(fb)}}|{{num.f3(f2 * fb)}}[{{output}}_wl]")
    push(out, "[{{output}}_r]aecho=in_gain=0:out_gain=1:delays={{d * 2}}|{{d * 4}}:decays={{num.f3(f2)}}|{{num.f3(f2 * f2)}}[{{output}}_wr]")
    push(out, "[{{output}}_wl][{{output}}_wr]join=inputs=2:channel_layout=stereo,highpass=f=280,lowpass=f=5200,volume={{num.f3(gain)}}dB[{{output}}]")
    return out
}

fn rt60(space: int) -> f64 {
    if space == sound.SPACE_ROOM {
        return 1.1
    }
    if space == sound.SPACE_VAST {
        return 4.6
    }
    return 2.4
}

/// The impulse response: two ears of decaying noise, unit energy.
fn reverb_ir(space: int) -> string {
    let rt = rt60(space)
    let k = 6.908 / rt
    let scale = num.f6(math.sqrt(6.0 * k / f64(time.RATE)))
    let kk = num.f6(k)
    let d = num.f3(rt)
    return "aevalsrc=exprs='{{scale}}*(random(0)*2-1)*exp(-{{kk}}*t)*gte(t,0.018)|{{scale}}*(random(1)*2-1)*exp(-{{kk}}*t)*gte(t,0.023)':s=48000:d={{d}},highpass=f=240,lowpass=f=6500"
}

/// Convolution of stereo `[in]` with the room, to `[out]`.
fn reverb_lines(input: string, output: string, amount: int, space: int) -> []string {
    let gain = -16.0 + 15.0 * f64(amount) / 100.0
    let mut out = []string {}
    push(out, "{{reverb_ir(space)}}[{{output}}_ir]")
    push(out, "[{{input}}][{{output}}_ir]afir=irnorm=-1:irgain=1,volume={{num.f3(gain)}}dB[{{output}}]")
    return out
}

/// Chorus, phaser, or flanger for the pad and arp bus; empty for none.
fn modulation(kind: int, amount: int) -> string {
    let a = f64(num.clampi(amount, 0, 100)) / 100.0
    if kind == sound.MOD_CHORUS {
        let d1 = num.f3(0.25 + 0.25 * a)
        let d2 = num.f3(0.2 + 0.25 * a)
        return "chorus=0.7:0.85:38|52:{{d1}}|{{d2}}:0.25|0.38:1.6|2.3"
    }
    if kind == sound.MOD_PHASER {
        return "aphaser=in_gain=0.7:out_gain=0.85:delay=3:decay={{num.f3(0.3 + 0.45 * a)}}:speed=0.35:type=t"
    }
    if kind == sound.MOD_FLANGER {
        return "flanger=delay=1:depth={{num.f3(1.5 + 5.0 * a)}}:regen=10:width=60:speed=0.25"
    }
    return ""
}

/// Spectral centre removal. `afftfilt` delays by 3/4 of its window, so the
/// chain pads first and trims after: the length and the timing stay.
fn centre_mask() -> string {
    let e = "st(0,re*real(b,1-ch)+im*imag(b,1-ch));st(1,re*re+im*im+real(b,1-ch)*real(b,1-ch)+imag(b,1-ch)*imag(b,1-ch)+1e-20);st(2,clip((2*ld(0)/ld(1)-0.6)/0.4,0,1));st(3,between(b*sr/4096,120,16000));1-ld(3)*pow(ld(2),0.5)"
    return "apad=pad_len=3072,afftfilt=real='re*({{e}})':imag='im*({{e}})':win_size=4096,atrim=start_sample=3072,asetpts=PTS-STARTPTS"
}

/// The voice band, lowered, for a phrase that still had a voice in it.
fn voice_duck() -> string {
    return "equalizer=f=900:t=o:w=2:g=-9,equalizer=f=3000:t=o:w=1.2:g=-6"
}

/// Tape and bit-depth wear on the whole mix; empty at 0.
fn lofi(amount: int) -> string {
    if amount <= 0 {
        return ""
    }
    let a = f64(num.clampi(amount, 0, 100)) / 100.0
    let bits = num.f3(14.0 - 6.0 * a)
    let mix = num.f3(0.25 + 0.5 * a)
    let cut = num.roundi(14000.0 - 8500.0 * a)
    let wow = num.f3(0.02 + 0.05 * a)
    return "acrusher=level_in=1:level_out=1:bits={{bits}}:mode=log:aa=1:mix={{mix}},lowpass=f={{cut}},vibrato=f=0.55:d={{wow}}"
}

/// Crackle and hiss for the lo-fi layer, `sec` long, stereo.
fn vinyl(amount: int, sec: f64, crackle: string) -> string {
    let a = f64(num.clampi(amount, 0, 100)) / 100.0
    let gain = num.f3(-34.0 + 12.0 * a)
    let d = num.f3(sec)
    return "aevalsrc=exprs='{{crackle}}':s=48000:d={{d}}:c=mono,highpass=f=700,lowpass=f=7000,aformat=channel_layouts=stereo,volume={{gain}}dB"
}

/// Soft saturation; empty at 0.
fn warmth(amount: int) -> string {
    if amount <= 0 {
        return ""
    }
    let drive = 9.0 * f64(num.clampi(amount, 0, 100)) / 100.0
    return "volume={{num.f3(drive)}}dB,asoftclip=type=tanh,volume={{num.f3(-drive * 0.8)}}dB"
}

/// Stereo width: 0 leaves the image, 100 widens the side by 80%.
fn width(amount: int) -> string {
    if amount <= 0 {
        return ""
    }
    let m = 1.0 + 0.8 * f64(num.clampi(amount, 0, 100)) / 100.0
    return "extrastereo=m={{num.f3(m)}}:c=false"
}

/// The rumble cut and the last three seconds fading. The premaster is
/// float, so nothing clips here; the render job sets the level and limits
/// the peaks (`jobs.render_script`).
fn master(total_s: int) -> string {
    let fade = 144000
    let at = total_s - fade
    return "highpass=f=25,afade=t=out:ss={{at}}:ns={{fade}},atrim=end_sample={{total_s}},asetpts=PTS-STARTPTS"
}
