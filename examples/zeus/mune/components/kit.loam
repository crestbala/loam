/// A panel: a raised card with a heading, an optional caption, the body.
fn Panel(title: string, caption: Signal<string>, body: fn()) -> Node {
    return zeus.Box(style = Style(direction = Direction.Column, gap = 12, padding = 16, radius = 14,
                                  background = theme.PANEL, borderWidth = 1, borderColor = theme.LINE)) {
        zeus.Box(style = Style(direction = Direction.Column, gap = 3)) {
            zeus.Text(title, style = Style(font = 15, color = theme.INK))
            zeus.Text(caption.get(), style = Style(font = 12, color = theme.FAINT, wrap = true))
        }
        body()
    }
}

/// A small heading inside a panel: "INSTRUMENTS".
fn Heading(text: string) -> Node {
    return zeus.Text(text, style = Style(font = 11, color = theme.FAINT, paddingTop = 4))
}

/// Label at the left, the control in the middle, a readout at the right.
/// Every row in a panel shares the two edge columns, so controls line up.
fn Row(label: string, value: Signal<string>, control: fn()) -> Node {
    return zeus.Box(style = Style(direction = Direction.Row, align = Align.Center, gap = 12, minHeight = 34)) {
        zeus.Text(label, style = Style(font = 13, color = theme.MUTE, width = px(76)))
        zeus.Box(style = Style(direction = Direction.Row, align = Align.Center, grow = 1, shrink = 1, minWidth = 0)) {
            control()
        }
        zeus.Box(style = Style(direction = Direction.Row, justify = Align.End, width = px(52))) {
            zeus.Text(value.get(), style = Style(font = 12, color = theme.FAINT))
        }
    }
}

/// Width of a dropdown at the end of a control line (a tone, an echo time).
const TAIL_W: int = 104

/// A dropdown of `labels`, `width` px wide, bound to `value`. The menu opens
/// under it at the same width.
fn Choice(value: Signal<int>, labels: []string, label: string, width: int) -> Node {
    return zui.Select(value, labels, size = zeus.Size.Sm, label = label, style = Style(width = px(width)))
}

/// A slider in the room's colours: accent fill and knob on a quiet track.
///
/// The track always runs 0..100 and follows the pointer continuously; the
/// value is that position mapped onto `lo..hi`. `zui.Slider` with its own
/// range snaps the knob to whole steps and nudges a step on every move,
/// which on a short range (pitch is 25 steps) makes the knob lag behind
/// the pointer and jump.
///
/// Keys move the value, not the track: the native arrows step the track by
/// 1%, which is a quarter of a semitone on pitch and a crawl on a level.
/// Arrows step a twentieth of the range (at least one), Shift+arrows one,
/// Page Up / Page Down a tenth, Home / End the ends. They go in through
/// `zui.Slider`'s `keys`, named after its own actions so they replace them.
fn Slider(value: Signal<int>, lo: int, hi: int, label: string, off: bool) -> Node {
    let span = if hi > lo { hi - lo } else { 1 }
    let pos = zeus.signal(track_pos(value.peek(), lo, span))
    // Value → track only when the value moved for another reason (a style
    // preset, the tempo following the recordings, a key): a drag that stays
    // inside one step keeps the knob where the pointer is.
    zeus.effect(fn() {
        let v = value.get()
        if track_value(pos.peek(), lo, span) != v {
            pos.set(track_pos(v, lo, span))
        }
    })
    zeus.effect(fn() {
        let v = track_value(pos.get(), lo, span)
        if v != value.peek() {
            value.set(v)
        }
    })
    let step = key_step(span)
    let page = if span / 10 > step { span / 10 } else { step }
    let keys = []KeyBind {
        zeus.key_bind("right", "slider.inc", fn() { nudge(value, step, lo, hi) }),
        zeus.key_bind("left", "slider.dec", fn() { nudge(value, -step, lo, hi) }),
        zeus.key_bind("up", "slider.up", fn() { nudge(value, step, lo, hi) }),
        zeus.key_bind("down", "slider.down", fn() { nudge(value, -step, lo, hi) }),
        zeus.key_bind("shift+right", "slider.fine_inc", fn() { nudge(value, 1, lo, hi) }),
        zeus.key_bind("shift+left", "slider.fine_dec", fn() { nudge(value, -1, lo, hi) }),
        zeus.key_bind("shift+up", "slider.fine_up", fn() { nudge(value, 1, lo, hi) }),
        zeus.key_bind("shift+down", "slider.fine_down", fn() { nudge(value, -1, lo, hi) }),
        zeus.key_bind("pageup", "slider.page_up", fn() { nudge(value, page, lo, hi) }),
        zeus.key_bind("pagedown", "slider.page_down", fn() { nudge(value, -page, lo, hi) }),
        zeus.key_bind("home", "slider.min", fn() { value.set(lo) }),
        zeus.key_bind("end", "slider.max", fn() { value.set(hi) }),
    }
    return zui.Slider(pos, label = label, disabled = off, keys = keys,
                      style = Style(color = if off { theme.FAINT } else { theme.ACCENT }, background = theme.TILE_HI))
}

/// Arrow step for a range: one unit on a short one (pitch), a twentieth on
/// a long one (levels, tempo).
fn key_step(span: int) -> int {
    if span <= 30 {
        return 1
    }
    return span / 20
}

fn nudge(value: Signal<int>, d: int, lo: int, hi: int) {
    let v = value.peek() + d
    value.set(if v < lo { lo } else if v > hi { hi } else { v })
}

fn track_pos(v: int, lo: int, span: int) -> int {
    let p = ((v - lo) * 100 + span / 2) / span
    return if p < 0 { 0 } else if p > 100 { 100 } else { p }
}

fn track_value(p: int, lo: int, span: int) -> int {
    return lo + (p * span + 50) / 100
}

/// Light or dark. The whole window repaints: every colour is a role.
fn ThemeToggle() -> Node {
    return zeus.Box(style = Style(direction = Direction.Row, align = Align.Center, justify = Align.Center, gap = 6,
                                  height = px(28), width = px(76), radius = 14, background = theme.TILE,
                                  borderWidth = 1, borderColor = theme.LINE, cursor = "pointer"),
                    role = "button", label = "Appearance",
                    on_click = fn() { theme.toggle() }) {
        zeus.Box(visible = theme.is_dark(), style = Style(direction = Direction.Row)) {
            zui.Icon(IC_MOON, 14, theme.ACCENT)
        }
        zeus.Box(visible = !theme.is_dark(), style = Style(direction = Direction.Row)) {
            zui.Icon(IC_SUN, 14, theme.WARN)
        }
        zeus.Text(fn() -> string { return if theme.is_dark() { "Dark" } else { "Light" } },
                  style = Style(font = 12, color = theme.MUTE))
    }
}

/// A small round colour mark.
fn Pip(color: string, size: int) -> Node {
    return zeus.Box(style = Style(width = px(size), height = px(size), radius = size / 2, background = color))
}

/// Text and a value, both small: "Echo · 35".
fn percent(v: int) -> string {
    return "{{v}}"
}

fn signed(v: int, unit: string) -> string {
    if v > 0 {
        return "+{{v}}{{unit}}"
    }
    return "{{v}}{{unit}}"
}
