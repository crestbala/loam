// The bar along the bottom: Generate, the waveform of the take (its
// sections in colour, the playhead, press to seek), the energy arc the
// chain walked, play, and save.

import "zeus"
import "zui"
import "../core/arrange.loam" as arrange
import "../core/time.loam" as time
import "../studio/files.loam" as files
import "../studio/store.loam" as store
import "../theme.loam" as theme
import "kit.loam" as kit

let wave_ref = zeus.ref()

/** *The longest form has nine sections; the strip keeps a slot for each. */
const MAX_SECTIONS: int = 9

/** *Columns in the pitch path strip. */
const PATH_COLS: int = 60

fn PlayerBar() -> Node {
    return zeus.Box(style = Style(
        direction = Direction.Row,
        align = Align.Center,
        gap = 18,
        paddingY = 14,
        paddingX = 22,
        background = theme.PANEL,
        borderWidth = 1,
        borderColor = theme.LINE,
    )) {
        PlayButton()
        zeus.Box(style = Style(
            direction = Direction.Column,
            gap = 6,
            grow = 1,
            shrink = 1,
            minWidth = 0,
        )) {
            zeus.Box(style = Style(direction = Direction.Row, align = Align.Center, gap = 10)) {
                zeus.Text(
                    fn() -> string {
                        let l = store.take_line.get()
                        if l.len == 0 {
                            return "No piece yet"
                        }
                        return l
                    },
                    style = Style(font = 13, color = theme.INK, grow = 1, ellipsis = true),
                )
                zeus.Text(
                    fn() -> string {
                        if !store.has_take() {
                            return ""
                        }
                        return "{{time.clock(store.pos.get())}} / {{time.clock(store.take_ms.get())}}"
                    },
                    style = Style(font = 12, color = theme.FAINT),
                )
            }
            Waveform()
            EnergyArc()
            StatusLine()
        }
        Actions()
    }
}

fn PlayButton() -> Node {
    return zeus.Box(
        style = Style(
            width = px(52),
            height = px(52),
            radius = 26,
            align = Align.Center,
            justify = Align.Center,
            cursor = "pointer",
            background = if store.has_take() { theme.ACCENT } else { theme.TILE_HI },
        ),
        role = "button",
        label = if store.playing.get() { "Pause" } else { "Play" },
        on_click = fn() { store.toggle_play() },
    ) {
        zeus.Box(visible = store.playing.get(), style = Style(direction = Direction.Row)) {
            zui.Icon(kit.IC_PAUSE, 22, theme.ON_ACCENT)
        }
        zeus.Box(
            visible = !store.playing.get(),
            style = Style(direction = Direction.Row, paddingLeft = 3),
        ) {
            zui.Icon(kit.IC_PLAY, 22, if store.has_take() { theme.ON_ACCENT } else { theme.FAINT })
        }
    }
}

/** *Bars of the take's level over a strip of its sections. Press or drag to */
/** *move the playhead. */
fn Waveform() -> Node {
    zeus.on_mount(fn() {
        zeus.on_drag(wave_ref, fn() { seek_to(zeus.current_mouse().x) })
    })
    return zeus.Box(
        ref = wave_ref,
        style = Style(direction = Direction.Column, gap = 4, cursor = "pointer"),
        role = "slider",
        label = "Seek",
    ) {
        zeus.Box(style = Style(
            direction = Direction.Row,
            align = Align.Center,
            gap = 2,
            height = px(46),
        )) {
            for k in 0..store.WAVE_BARS {
                Bar(k)
            }
        }
        zeus.Box(style = Style(
            direction = Direction.Row,
            height = px(4),
            radius = 2,
            background = theme.TILE,
        )) {
            for k in 0..MAX_SECTIONS {
                SectionMark(k)
            }
        }
    }
}

fn Bar(k: int) -> Node {
    return zeus.Box(style = Style(
        grow = 1,
        height = px(bar_height(k)),
        radius = 1,
        background = bar_color(k),
    ))
}

fn bar_height(k: int) -> int {
    let ps = store.peaks.get()
    if k < 0 || k >= ps.len {
        return 3
    }
    return 3 + ps[k] * 40 / 100
}

fn bar_color(k: int) -> string {
    if store.peaks.get().len == 0 {
        return theme.TILE_HI
    }
    if k * 1000 / store.WAVE_BARS < store.position_permille() {
        return theme.ACCENT
    }
    return theme.WAVE_IDLE
}

/** *One section on the strip, as wide as its share of the piece. */
fn SectionMark(k: int) -> Node {
    return zeus.Box(
        visible = mark_share(k) > 0,
        style = Style(
            grow = mark_share(k),
            height = px(4),
            radius = 2,
            background = theme.section_color(mark_kind(k)),
            opacity = 80,
        ),
    )
}

fn mark_kind(k: int) -> int {
    let s = store.sections.get()
    let at = k * 3
    return if at < s.len { s[at] } else { 0 }
}

fn mark_share(k: int) -> int {
    let s = store.sections.get()
    let at = k * 3 + 2
    return if at < s.len { s[at] } else { 0 }
}

/** *How full the phrases are across the take: one column per slice, as */
/** *tall as the energy of the phrase heard there. Before the first take it */
/** *shows the arc the chain will aim for, faint. */
fn EnergyArc() -> Node {
    return zeus.Box(style = Style(direction = Direction.Row, align = Align.Center, gap = 10)) {
        zeus.Box(style = Style(
            direction = Direction.Row,
            align = Align.Center,
            gap = 5,
            width = px(78),
        )) {
            zui.Icon(kit.IC_CLIMB, 12, theme.FAINT)
            zeus.Text("Energy arc", style = Style(font = 11, color = theme.FAINT))
        }
        zeus.Box(style = Style(
            direction = Direction.Row,
            align = Align.End,
            gap = 2,
            height = px(18),
            grow = 1,
            minWidth = 0,
        )) {
            for k in 0..PATH_COLS {
                PathCol(k)
            }
        }
    }
}

fn PathCol(k: int) -> Node {
    return zeus.Box(style = Style(
        grow = 1,
        height = px(2 + path_value(k) * 16 / 1000),
        radius = 1,
        background = if store.path_heard.get().len > 0 && path_value(k) >= 0 {
            theme.path_color(path_value(k))
        } else {
            theme.TILE_HI
        },
    ))
}

/** *Energy 0..1000 at column `k`: what was heard, or a typical arc. */
fn path_value(k: int) -> int {
    let heard = store.path_heard.get()
    if heard.len > 0 {
        let h = heard[k * heard.len / PATH_COLS]
        return if h < 0 { 0 } else { h }
    }
    let plan = arrange.sketch(PATH_COLS)
    return plan[k]
}

fn seek_to(x: int) {
    let r = zeus.rect(wave_ref)
    if r.w <= 0 {
        return
    }
    let mut p = (x - r.x) * 1000 / r.w
    if p < 0 {
        p = 0
    }
    if p > 1000 {
        p = 1000
    }
    store.seek(p)
}

/** *Progress while working; otherwise the last error, a notice, or where the */
/** *piece was saved. */
fn StatusLine() -> Node {
    return zeus.Box(style = Style(
        direction = Direction.Row,
        align = Align.Center,
        gap = 10,
        height = px(20),
    )) {
        zeus.Box(
            visible = store.busy(),
            style = Style(direction = Direction.Row, align = Align.Center, gap = 10, grow = 1),
        ) {
            zeus.Box(style = Style(direction = Direction.Row, width = px(160))) {
                zui.Progress(store.progress, size = zeus.Size.Sm, style = Style(width = px(160)))
            }
            zeus.Text(
                store.status.get(),
                style = Style(font = 12, color = theme.MUTE, ellipsis = true, grow = 1),
            )
        }
        zeus.Box(
            visible = !store.busy(),
            style = Style(direction = Direction.Row, align = Align.Center, gap = 8, grow = 1),
        ) {
            zeus.Text(
                fn() -> string {
                    if store.error.get().len > 0 {
                        return store.error.get()
                    }
                    if store.notice.get().len > 0 {
                        return store.notice.get()
                    }
                    if store.saved.get().len > 0 {
                        return "Saved to {{files.short(store.saved.get())}}"
                    }
                    if store.has_take() {
                        return "This take is temporary until you save it."
                    }
                    return "Add recordings, pick a style, and Generate."
                },
                style = Style(font = 12, ellipsis = true, grow = 1, color = if store.error.get(
                ).len > 0 {
                    theme.WARN
                } else if store.saved.get().len > 0 {
                    theme.OK
                } else {
                    theme.FAINT
                }),
            )
        }
    }
}

/** *`zui.Button` reads `enabled` when it builds, so each action is two */
/** *buttons, an enabled and a disabled one, and only one is shown. */
fn Gate(on: Signal<bool>, live: fn(), dead: fn()) -> Node {
    return zeus.Box(style = Style(direction = Direction.Row, grow = 1)) {
        zeus.Box(visible = on.get(), style = Style(direction = Direction.Row, grow = 1)) {
            live()
        }
        zeus.Box(visible = !on.get(), style = Style(direction = Direction.Row, grow = 1)) {
            dead()
        }
    }
}

fn Actions() -> Node {
    return zeus.Box(style = Style(direction = Direction.Column, gap = 8, width = px(330))) {
        zeus.Box(style = Style(direction = Direction.Row, gap = 8)) {
            Gate(
                fn() -> bool { return store.can_generate() },
                fn() {
                    zui.Button(
                        label = "Generate",
                        icon = kit.IC_SPARK,
                        style = Style(width = pct(100)),
                        on_click = fn() { store.generate() },
                    )
                },
                fn() {
                    zui.Button(
                        label = if store.busy() { "Working…" } else { "Generate" },
                        icon = kit.IC_SPARK,
                        enabled = false,
                        style = Style(width = pct(100)),
                    )
                },
            )
            zeus.Box(style = Style(direction = Direction.Row, width = px(122))) {
                Gate(
                    fn() -> bool { return store.can_generate() && store.has_take() },
                    fn() {
                        zui.Button(
                            label = "New take",
                            icon = kit.IC_SHUFFLE,
                            look = zeus.Look.Soft,
                            style = Style(width = pct(100)),
                            on_click = fn() { store.new_take() },
                        )
                    },
                    fn() {
                        zui.Button(
                            label = "New take",
                            icon = kit.IC_SHUFFLE,
                            look = zeus.Look.Soft,
                            enabled = false,
                            style = Style(width = pct(100)),
                        )
                    },
                )
            }
        }
        zeus.Box(style = Style(direction = Direction.Row, gap = 8, align = Align.Center)) {
            zui.TextInput(
                store.title,
                "Name this piece",
                size = zeus.Size.Sm,
                label = "Name",
                style = Style(grow = 1),
            )
            kit.Choice(store.export_fmt, store.format_names(), "Export format", 92)
        }
        zeus.Box(style = Style(direction = Direction.Row, gap = 8, align = Align.Center)) {
            zeus.Box(style = Style(direction = Direction.Row, width = px(96))) {
                Gate(
                    fn() -> bool { return store.has_take() && !store.saving.get() },
                    fn() {
                        zui.Button(
                            label = "Save",
                            icon = kit.IC_SAVE,
                            look = zeus.Look.Outline,
                            size = zeus.Size.Sm,
                            style = Style(width = pct(100)),
                            on_click = fn() { store.save() },
                        )
                    },
                    fn() {
                        zui.Button(
                            label = if store.saving.get() { "Saving…" } else { "Save" },
                            icon = kit.IC_SAVE,
                            look = zeus.Look.Outline,
                            size = zeus.Size.Sm,
                            enabled = false,
                            style = Style(width = pct(100)),
                        )
                    },
                )
            }
            zeus.Text(
                "to ~/Documents/Mune",
                style = Style(font = 11, color = theme.FAINT, grow = 1),
            )
            zui.Button(
                label = "Show",
                icon = kit.IC_FOLDER,
                look = zeus.Look.Ghost,
                size = zeus.Size.Sm,
                on_click = fn() { store.reveal_saved() },
            )
        }
    }
}
