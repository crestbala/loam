import "std:zeus"
import "std:spacing"
import "std:zui"
import "std:router"
import "../../components/catalog.loam" as catalog

// `zui.Match` (what the router mounts pages into) is a Column with no
// spacing, so the page sets its own section rhythm.
fn page(p: Params) {
    zui.Column(spacing.SECTION) {
        catalog.Components()
    }
}

fn meta(p: Params) -> Meta {
    return Meta { title: "Components", description: "The standard widget catalogue." }
}
