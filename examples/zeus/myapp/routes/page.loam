import "std:zeus"
import "std:spacing"
import "std:zui"
import "std:router"
import "../components/foundations.loam" as foundations

// `zui.Match` (what the router mounts pages into) is a Column with no
// spacing, so the page sets its own section rhythm.
fn page(p: Params) {
    zui.Column(spacing.SECTION) {
        foundations.Foundations()
    }
}

fn meta(p: Params) -> Meta {
    return Meta { title: "myapp — Foundations", description: "Type scale, status accents, and surfaces." }
}
