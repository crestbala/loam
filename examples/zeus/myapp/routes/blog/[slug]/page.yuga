import "std:zeus"
import "std:router"
import "loader.yuga" as post_loader

fn page(p: Params) {
    let slug = router.param(p, "slug")
    zeus.Text(post_loader.get_post(slug))
}

// Static routes are enumerated at build time from `paths()`.
fn paths() -> []string {
    return []string { "/blog/hello-world", "/blog/second" }
}

fn meta(p: Params) -> Meta {
    return Meta { title: router.param(p, "slug") }
}
