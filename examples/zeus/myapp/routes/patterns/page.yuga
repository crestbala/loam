import "std:zeus"
import "std:router"
import "../../components/patterns.yuga" as patterns

// `zeus.Match` (what the router mounts pages into) is a Column with no
// spacing, so the page sets its own section rhythm.
fn page(p: Params) {
    zeus.Column(zeus.SECTION) {
        patterns.Patterns()
    }
}

fn meta(p: Params) -> Meta {
    return Meta { title: "Patterns", description: "Lists, grids, charts, skeletons, and overlays." }
}
