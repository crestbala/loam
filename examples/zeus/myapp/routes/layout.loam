//! Root shell: theme + top bar. Retained across navigation, so the nav state
//! and the light/dark switch survive — only the page slot rebuilds.

import "std:zeus"
import "std:zui"
import "../theme.loam" as theme
import "../components/nav.loam" as nav

fn Layout(build: fn()) -> Node {
    theme.install()
    return zui.Page() {
        nav.Navbar()
        build()
    }
}
