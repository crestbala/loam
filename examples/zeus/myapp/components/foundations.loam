//! Foundations page: the type scale, status accents, and the two ways to
//! build a surface — a recipe (`design.Card`) and a primitive (`design.Comp`).
//! Every color is a role token, so the whole page inverts with the appearance.

import "std:zeus"
import "std:design"

fn ProjectCard() {
    let ticks = zeus.signal(0)
    design.Card() {
        design.Row(SPACE.Sm) {
            design.Title("Project card")
            design.Grow()
            design.Badge("In progress", zeus.TINT.Ok)
        }
        design.Body("A card with a title, supporting copy, and a footer of actions. Rounded-xl, hairline border, paper surface.")
        design.Row(SPACE.Sm) {
            design.Button("Cancel", look = zeus.LOOK.Outline, size = zeus.SIZE.Md, on_click = fn() => ticks.set(ticks.get() + 1))
            design.Button("Save", look = zeus.LOOK.Solid, size = zeus.SIZE.Md, on_click = fn() => ticks.set(ticks.get() + 1))
            design.Grow()
            zeus.Text("{{ticks.get()}}", color = zeus.mute(), font = zeus.FONT_CAPTION)
        }
    }
}

fn Customize() {
    design.SectionHeader("Customize", "Style props + slots",
                       "Style props restyle a recipe without copying it. Comp is the primitive for your own widget. Trailing blocks are slots.")
    design.Card() {
        design.RowWrap(SPACE.Sm) {
            design.Button("Recipe", look = zeus.LOOK.Solid, size = zeus.SIZE.Md)
            design.Button("Styled", look = zeus.LOOK.Solid, size = zeus.SIZE.Md,
                        radius = 999, padding_x = 20,)
            design.IconButton(zeus.IC_CHECK, zeus.LOOK.Soft, zeus.SIZE.Md, "Save")
            design.Chip("pill", zeus.TINT.Ok, radius = 6)
        }
        design.Card(radius = 6, padding = 12) {
            design.Body("This card used radius = 6, padding = 12.")
        }
        design.Comp(background = zeus.raised(), radius = 10,
                  padding = 12, spacing = 8,
                  align_direction = DIRECTION.Row, align_items = ALIGN.Center) {
            design.Pip(zeus.accent(), 8)
            zeus.Text("Comp — a function widget, styled by props", font = zeus.FONT_BODY,
                      color = zeus.ink())
        }
        design.Badge("custom", zeus.TINT.Mute, radius = 2, padding_x = 8)
        design.Alert("Styled alert", "Same recipe, different radius.",
                   radius = 4, padding = 10)
    }
}

fn Foundations() {
    design.Breadcrumbs([]string {"myapp", "Examples", "Foundations"})
    design.Column(SPACE.Exs) {
        design.Display("Build interfaces with Zeus")
        design.Body("One entry, every host. Dark inverts every token that reads appearance.")
    }
    design.Row(SPACE.Sm) {
        design.Chip("Stable", zeus.TINT.Ok)
        design.Chip("Canvas2D", zeus.TINT.Ink)
        design.Badge("zeus", zeus.TINT.Mute)
        design.Kbd("⌘K")
    }
    design.Alert("Heads up", "Signals update on click. Hover and press are engine fades — no DOM.")
    design.AlertDestructive("Session expired", "Sign back in to keep syncing. Your drafts are saved locally.")
    ProjectCard()
    Customize()
}
