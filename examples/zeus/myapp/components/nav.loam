//! App chrome: the top bar. Unlike the gallery's tab strip, every entry here
//! is a real URL — the bar reads `router.path_signal()` to mark the active
//! route, so navigation repaints the marker without rebuilding the shell.

import "std:async"
import "std:zeus"
import "std:colors"
import "std:spacing"
import "std:zui"
import "std:router"

let mut ram_armed: int = 0

/// Live host memory: resident set on desktop, wasm heap on web. Reads once at
/// mount so the chip is never blank, then refreshes twice a second.
fn RamChip() -> Node {
    let ram = zeus.signal(zeus.memory_kb())
    if ram_armed == 0 {
        ram_armed = 1
        async.interval(500, fn() { ram.set(zeus.memory_kb()) })
    }
    return zeus.Box(style = Style(height = px(26),
                           direction = Direction.Row,
                           gap = Space.Exxs,
                           align = Align.Center,
                           padding = edges2(4, 10),
                           radius = corners(spacing.RAD_FULL),
                           background = colors.raised())) {
        zeus.Text(fn() -> string {
            let mb = ram.get() / 1024
            return "RAM {{mb}} MB"
        },
style = Style(font = spacing.FONT_CAPTION, color = colors.mute()))
    }
}

/// One nav entry, mirroring `zui.NavTab` but driven by the URL instead of a
/// tab index. `style` is a thunk, so the fill and the label colour re-run
/// whenever the path moves: the highlight follows navigation even though the
/// bar itself is retained and never rebuilds.
fn NavLink(label: string, href: string) -> Node {
    let path = router.path_signal()
    fn active() -> bool {
        return path.get() == href
    }
    return zeus.Box(
        style = Style(height = px(36),
                      direction = Direction.Row,
                      gap = Space.Exxs,
                      align = Align.Center,
                      padding = Edges(right = 12, left = 12),
                      radius = corners(spacing.RAD_MD),
                      cursor = "pointer",
                      background = if active() { colors.raised() } else { "" }),
        on_click = fn() => router.navigate(href),
        role = "button",
        label = label) {
        zeus.Text(label, style = Style(font = spacing.FONT_BODY,
                                       color = if active() { zeus.ink() } else { colors.mute() }))
    }
}

/// Top bar: brand, route links, live RAM, and the light/dark switch. The
/// switch drives `zeus.appearance()`, which every role token resolves against
/// at paint — one toggle restyles the whole tree with no rebuild.
fn Navbar() -> Node {
    return zui.Column(Space.None) {
        zeus.Box(style = Style(height = px(spacing.BAR),
                               direction = Direction.Row,
                               gap = Space.Md,
                               align = Align.Center)) {
            zeus.Box(style = Style(width = px(22), height = px(22), radius = corners(6), background = zeus.ink()))
            zeus.Text("myapp", style = Style(font = spacing.FONT_TITLE, color = zeus.ink()))
            NavLink("Foundations", "/")
            NavLink("Components", "/components")
            NavLink("Patterns", "/patterns")
            NavLink("Blog", "/blog")
            NavLink("About", "/about")
            NavLink("Pricing", "/pricing")
            zui.Grow()
            RamChip()
            zeus.Text("Dark", style = Style(font = spacing.FONT_CONTROL, color = colors.mute()))
            zui.ThemeSwitch()
        }
        zui.Separator()
    }
}
