//! Components page: the standard widget catalogue — actions, display, forms,
//! choice, controls, people, media, and data. One section per widget family.

import "std:zeus"
import "std:kv"

fn ButtonScale() {
    zeus.SectionHeader("Actions", "Buttons",
                       "The six variants across three sizes. Primary is the neutral ink fill; it inverts with appearance.")
    zeus.Card() {
        zeus.Overline("Primary · Secondary · Outline · Ghost · Destructive · Link")
        zeus.Note("small")
        zeus.RowWrap(SPACE.Sm) {
            zeus.Button("Solid", look = zeus.LOOK.Solid, size = zeus.SIZE.Sm)
            zeus.Button("Soft", look = zeus.LOOK.Soft, size = zeus.SIZE.Sm)
            zeus.Button("Outline", look = zeus.LOOK.Outline, size = zeus.SIZE.Sm)
            zeus.Button("Ghost", look = zeus.LOOK.Ghost, size = zeus.SIZE.Sm)
            zeus.Button("Danger", look = zeus.LOOK.Danger, size = zeus.SIZE.Sm)
            zeus.Button("Link", look = zeus.LOOK.Link, size = zeus.SIZE.Sm)
        }
        zeus.Note("medium")
        zeus.RowWrap(SPACE.Sm) {
            zeus.Button("Solid", look = zeus.LOOK.Solid, size = zeus.SIZE.Md)
            zeus.Button("Soft", look = zeus.LOOK.Soft, size = zeus.SIZE.Md)
            zeus.Button("Outline", look = zeus.LOOK.Outline, size = zeus.SIZE.Md)
            zeus.Button("Ghost", look = zeus.LOOK.Ghost, size = zeus.SIZE.Md)
            zeus.Button("Danger", look = zeus.LOOK.Danger, size = zeus.SIZE.Md)
            zeus.Button("Link", look = zeus.LOOK.Link, size = zeus.SIZE.Md)
        }
        zeus.Note("large")
        zeus.RowWrap(SPACE.Sm) {
            zeus.Button("Solid", look = zeus.LOOK.Solid, size = zeus.SIZE.Lg)
            zeus.Button("Soft", look = zeus.LOOK.Soft, size = zeus.SIZE.Lg)
            zeus.Button("Outline", look = zeus.LOOK.Outline, size = zeus.SIZE.Lg)
            zeus.Button("Ghost", look = zeus.LOOK.Ghost, size = zeus.SIZE.Lg)
            zeus.Button("Danger", look = zeus.LOOK.Danger, size = zeus.SIZE.Lg)
            zeus.Button("Link", look = zeus.LOOK.Link, size = zeus.SIZE.Lg)
        }
        zeus.Note("icon — square, 16px lucide glyphs in every look")
        zeus.RowWrap(SPACE.Sm) {
            zeus.IconButton(zeus.IC_PLUS, zeus.LOOK.Solid, zeus.SIZE.Sm, "Add")
            zeus.IconButton(zeus.IC_MINUS, zeus.LOOK.Soft, zeus.SIZE.Md, "Remove")
            zeus.IconButton(zeus.IC_X, zeus.LOOK.Outline, zeus.SIZE.Md, "Close")
            zeus.IconButton(zeus.IC_CHEV_LEFT, zeus.LOOK.Ghost, zeus.SIZE.Md, "Back")
            zeus.IconButton(zeus.IC_ALERT_CIRCLE, zeus.LOOK.Danger, zeus.SIZE.Lg, "Warn")
        }
    }
}

fn DisplayRow() {
    zeus.SectionTitle("Display", "Chips, badges, keys")
    zeus.Card() {
        zeus.Note("chips")
        zeus.Row(SPACE.Sm) {
            zeus.Chip("Iris", zeus.TINT.Ink)
            zeus.Chip("Live", zeus.TINT.Ok)
            zeus.Chip("Quiet", zeus.TINT.Mute)
            zeus.Chip("Faint", zeus.TINT.Dim)
            zeus.Chip("Alert", zeus.TINT.Danger)
        }
        zeus.Note("badges")
        zeus.Row(SPACE.Sm) {
            zeus.Badge("secondary", zeus.TINT.Mute)
            zeus.Badge("default", zeus.TINT.Ink)
            zeus.Badge("success", zeus.TINT.Ok)
            zeus.Badge("outline", zeus.TINT.Dim)
            zeus.Badge("destructive", zeus.TINT.Danger)
        }
        zeus.Note("kbd")
        zeus.Row(SPACE.Sm) {
            zeus.Kbd("Esc")
            zeus.Kbd("⌘S")
            zeus.Kbd("Ctrl K")
        }
    }
}

fn Field(name: Signal<string>, note: Signal<string>, st: Store) {
    zeus.SectionHeader("Forms", "Input",
                       "A label + input pair: 36px tall, rounded, hairline border.")
    zeus.Card() {
        zeus.Field("Name", name, "Your name")
        zeus.Text(if name.get().len < 3 { "Name must be at least 3 characters." } else { "" },
                  color = zeus.danger(), font = zeus.FONT_CONTROL)
        zeus.TextArea(note, "Draft — saved as you type", fn() => kv.set(st, "draft", note.get()))
        zeus.Note("{{note.get().len}} chars · std:kv under Application Support")
        zeus.Button("Submit", look = zeus.LOOK.Solid, size = zeus.SIZE.Md, on_click = fn() => name.set(name.get()))
    }
}

fn DateSection() {
    let year = zeus.signal(2026)
    let month = zeus.signal(10)
    let day = zeus.signal(17)
    zeus.SectionHeader("Forms", "Date picker",
                       "Input-like trigger with a calendar icon; the sheet floats above the page, so the scroller cannot clip it.")
    zeus.Card() {
        zeus.DatePicker(year, month, day)
    }
}

fn Choice() {
    let tab = zeus.signal(0)
    let size = zeus.signal(1)
    let mode = zeus.signal(1)
    let group = zeus.signal(0)
    zeus.SectionHeader("Choice", "Tabs, select, radio, toggle",
                       "A muted tray for tabs, a dropdown for sizes, radio dots for one pick, and an accent-pressed toggle group.")
    zeus.Card() {
        zeus.Note("tabs — active trigger is the card surface")
        zeus.Tabs(tab, []string { "One", "Two", "Three" })
        zeus.Note("select — the menu floats below the trigger")
        zeus.Select(size, []string { "Small", "Medium", "Large" })
        zeus.Note("radio group — filled dot on the picked row")
        zeus.RadioGroup(mode, []string { "Default", "Comfortable", "Compact" })
        zeus.Note("toggle group — muted fill when pressed")
        zeus.ToggleGroup(group, []string { "Bold", "Italic", "Underline" })
        zeus.Note("toggle — borderless until pressed")
        let blink = zeus.signal(1)
        zeus.Toggle("Blink cursor", blink)
    }
}

fn Controls() {
    let on = zeus.signal(1)
    let notes = zeus.signal(0)
    let vol = zeus.signal(42)
    zeus.SectionHeader("Controls", "Switch, check, slider, toggle",
                       "The switch eases onto its track; drag the slider thumb or use the arrow keys. Progress echoes the value.")
    zeus.Card() {
        zeus.Row(SPACE.Md) {
            zeus.Switch(on)
            zeus.Text(if on.get() == 1 { "On" } else { "Off" }, color = zeus.ink(), font = zeus.FONT_BODY)
            zeus.Grow()
            zeus.Checkbox("Notify me", notes)
        }
        zeus.Note("volume  {{vol.get()}}%")
        zeus.Slider(vol)
        zeus.Progress(vol)
    }
}

fn People() {
    zeus.SectionTitle("People", "Avatars and stats")
    zeus.Row(SPACE.Md) {
        zeus.Card() {
            zeus.User("AP", "Ada Park", "Operator")
            zeus.User("BL", "Bea Liu", "Editor")
            zeus.Row(SPACE.Xs) {
                zeus.Avatar("AP", 32)
                zeus.Avatar("BL", 40)
                zeus.Avatar("CD", 48)
            }
        }
        zeus.Stat("Uptime", "99.9%", zeus.TINT.Ok)
        zeus.Stat("Errors", "2", zeus.TINT.Danger)
    }
}

fn Upload() {
    let photo = zeus.signal("")
    let pw = zeus.signal(0)
    let ph = zeus.signal(0)
    zeus.SectionHeader("Media", "Upload",
                       "Choose a PNG, JPEG, WebP, or GIF. The preview keeps its aspect and auto-sizes to the device width.")
    zeus.Card() {
        zeus.Row(SPACE.Sm) {
            zeus.Button("Choose image", look = zeus.LOOK.Solid, size = zeus.SIZE.Md, on_click = fn() {
                zeus.pick_image(photo, pw, ph)
            })
            zeus.Button("Clear", look = zeus.LOOK.Ghost, size = zeus.SIZE.Md, on_click = fn() {
                photo.set("")
                pw.set(0)
                ph.set(0)
            })
        }
        // `show =` is a plain bool, read once at build (zeus.loam:2146), so
        // it cannot follow the pick. Signal shows win over it and do follow:
        // `pw` is 0 until `pick_image` reports a real width.
        let empty = zeus.Box(
            align_direction = DIRECTION.Row,
            align_items = ALIGN.Center,
            justify = ALIGN.Center,
            height = 200,
            radius = 8,
            background = zeus.raised()) {
            zeus.Text("No image yet", color = zeus.mute(), font = zeus.FONT_CAPTION)
        }
        zeus.show_eq(empty, pw, 0)
        // No `max_width` / `aspect` wiring: `Image` reads the decoded source
        // size, keeps the aspect ratio, and shrinks to the card (device) width.
        let shot = zeus.Image(photo.get(), radius = 8, fit = IMAGE_FIT.Contain)
        zeus.show_ne(shot, pw, 0)
    }
}

fn Data() {
    let page = zeus.signal(3)
    zeus.SectionTitle("Data", "Table and pagination")
    zeus.Card() {
        zeus.TableHead([]string {"Name", "Role", "Status"})
        zeus.TableRow([]string {"Ada", "Operator", "Active"})
        zeus.TableRow([]string {"Bea", "Editor", "Away"})
        zeus.TableRow([]string {"Cal", "Viewer", "Active"})
    }
    zeus.Note("Pagination — {{page.get()}} / 5 · ghost pages, outline current")
    zeus.Pagination(page, 5)
}

fn Components() {
    let st = kv.open("myapp-catalog")
    let name = zeus.signal("")
    let note = zeus.signal(kv.get(st, "draft"))
    DateSection()
    ButtonScale()
    DisplayRow()
    Field(name, note, st)
    Choice()
    Controls()
    People()
    Upload()
    Data()
}
