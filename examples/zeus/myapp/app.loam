//! myapp — application entry. One entry, every host.
//!
//! `zeus routes` generates app_routes.loam from routes/; this file
//! mounts it. `zeus build` emits all five targets from here.

import "std:zeus"
import "app_routes.loam" as approutes
import "server/api.loam" as api
import "tests/smoke.loam" as smoketest

fn main() {
    zeus.App("myapp", fn() {
        approutes.app()
    })
}
