//! Top bar. Each entry is a URL. The bar reads `router.path_signal()` so the
//! highlight follows navigation while the shell stays mounted.

import "std:colors"
import "std:router"
import "std:spacing"
import "std:zeus"
import "std:zui"

/// `deep` 1 also lights the link on any path under `href`.
fn NavLink(label: string, href: string, deep: int = 0) -> Node {
    let path = router.path_signal()
    fn active() -> bool {
        return lit(path.get(), href, deep)
    }
    return zeus.Box(
        style = Style(height = px(36),
                      direction = Direction.Row,
                      gap = Space.Exxs,
                      align = Align.Center,
                      padding = Edges(right = 12, left = 12),
                      radius = corners(spacing.RAD_MD),
                      cursor = "pointer",
                      background = if active() { colors.raised() } else { "" }),
        on_click = fn() => router.navigate(href),
        role = "button",
        label = label) {
        zeus.Text(label, style = Style(font = spacing.FONT_BODY,
                                       color = if active() { zeus.ink() } else { colors.mute() }))
    }
}

fn lit(path: string, href: string, deep: int) -> bool {
    if path == href {
        return true
    }
    if deep == 0 || path.len <= href.len {
        return false
    }
    let mut i = 0
    while i < href.len {
        if path[i] != href[i] {
            return false
        }
        i = i + 1
    }
    return path[href.len] == 47
}

fn Navbar() -> Node {
    return zui.Column(Space.None) {
        zeus.Box(style = Style(height = px(spacing.BAR),
                               direction = Direction.Row,
                               gap = Space.Md,
                               align = Align.Center)) {
            zeus.Box(style = Style(width = px(22), height = px(22), radius = corners(6), background = zeus.ink()))
            zeus.Text("dracula", style = Style(font = spacing.FONT_TITLE, color = zeus.ink()))
            NavLink("Holdings", "/")
            NavLink("Charts", "/scheme", 1)
            NavLink("Screener", "/screener")
            NavLink("Backtest", "/backtest")
            NavLink("Walk-forward", "/backtest/walkforward")
            NavLink("Stocks", "/stocks", 1)
            NavLink("Data", "/data")
            zui.Grow()
            zeus.Text("Dark", style = Style(font = spacing.FONT_CONTROL, color = colors.mute()))
            zui.ThemeSwitch()
        }
        zui.Separator()
    }
}
