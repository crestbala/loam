//! NSE bhavcopy parsing and the stock close cache, on a fixture under /tmp.
//! No network.

import "std:sys"
import "std:test"
import "../server/nse.loam"
import "../server/tape.loam"
import "../server/catalog.loam"

fn head() -> string {
    return "TradDt,BizDt,Sgmt,Src,FinInstrmTp,FinInstrmId,ISIN,TckrSymb,SctySrs,XpryDt,FininstrmActlXpryDt,StrkPric,OptnTp,FinInstrmNm,OpnPric,HghPric,LwPric,ClsPric,LastPric,PrvsClsgPric,UndrlygPric,SttlmPric,OpnIntrst,ChngInOpnIntrst,TtlTradgVol,TtlTrfVal,TtlNbOfTxsExctd,SsnId,NewBrdLotQty,Rmks,Rsvd1,Rsvd2,Rsvd3,Rsvd4"
}

fn row(day: string, sym: string, srs: string, name: string, close: string) -> string {
    return "{{day}},{{day}},CM,NSE,STK,1,INE000000000,{{sym}},{{srs}},,,,,{{name}},1.00,1.00,1.00,{{close}},1.00,1.00,,1.00,,,1,1.00,1,F1,1,,,,,"
}

fn file(day: string, rows: []string) -> string {
    let mut s = head()
    let mut i = 0
    while i < rows.len {
        let r = rows[i]
        s = "{{s}}\n{{r}}"
        i = i + 1
    }
    return "{{s}}\n"
}

fn fresh(tag: string) -> string {
    let root = "/tmp/dracula-tape-{{tag}}"
    sys.exec("rm -rf '{{root}}'")
    return root
}

#[test]
fn parse_keeps_eq_and_reads_paise() {
    let mut rows = []string {}
    push(rows, row("2026-09-25", "RELIANCE", "EQ", "RELIANCE INDUSTRIES LTD", "1226.00"))
    push(rows, row("2026-09-25", "SGBJUN28", "GB", "GOLD BOND", "15040.00"))
    push(rows, row("2026-09-25", "M&M", "EQ", "MAHINDRA & MAHINDRA LTD", "3100.55"))
    push(rows, row("2026-09-25", "BADCO", "EQ", "BAD CO", "0.00"))
    let b = nse.parse(file("2026-09-25", rows), 20260925)
    test.assert_eq_int(b.ok, 1)
    test.assert_eq_int(b.symbols.len, 2)
    test.assert_eq_str(b.symbols[1], "M&M")
    test.assert(b.closes[0] == i64(122600))
    test.assert(b.closes[1] == i64(310055))
    test.assert_eq_int(b.bad_lines.len, 1)
    test.assert_eq_str(b.bad_reasons[0], "bad close")
    test.assert_eq_int(b.bad_lines[0], 5)
}

#[test]
fn a_trailing_comma_on_the_header_is_not_a_field() {
    let mut rows = []string {}
    push(rows, row("2024-01-02", "RELIANCE", "EQ", "RELIANCE INDUSTRIES LTD", "2587.25"))
    let text = file("2024-01-02", rows)
    let b = nse.parse("{{head()}},\n{{rows[0]}}\n", 20240102)
    test.assert_eq_int(b.ok, 1)
    test.assert_eq_int(b.symbols.len, 1)
    test.assert(b.closes[0] == i64(258725))
    test.assert_eq_int(b.bad_lines.len, 0)
    test.assert_eq_int(nse.parse(text, 20240102).symbols.len, 1)
}

#[test]
fn a_comma_in_a_name_shifts_fields_and_is_rejected() {
    let mut rows = []string {}
    push(rows, row("2026-09-25", "ODD", "EQ", "ODD, LTD", "10.00"))
    let b = nse.parse(file("2026-09-25", rows), 20260925)
    test.assert_eq_int(b.symbols.len, 0)
    test.assert_eq_int(b.bad_lines.len, 1)
    test.assert_eq_str(b.bad_reasons[0], "field count")
}

#[test]
fn a_file_for_another_day_or_without_the_header_is_refused() {
    let mut rows = []string {}
    push(rows, row("2026-09-24", "RELIANCE", "EQ", "RELIANCE INDUSTRIES LTD", "1226.00"))
    test.assert_eq_int(nse.parse(file("2026-09-24", rows), 20260925).ok, 0)
    test.assert_eq_int(nse.parse("<!DOCTYPE html><html></html>", 20260925).ok, 0)
    test.assert_eq_int(nse.parse("", 20260925).ok, 0)
}

#[test]
fn symbols_become_safe_file_names() {
    test.assert_eq_str(tape.file_of("RELIANCE"), "RELIANCE")
    test.assert_eq_str(tape.file_of("M&M"), "M_26M")
    test.assert_eq_str(tape.file_of("BAJAJ-AUTO"), "BAJAJ_2DAUTO")
}

#[test]
fn the_cache_is_append_only_in_date_order() {
    let root = fresh("order")
    let mut d1 = []string {}
    push(d1, row("2026-09-24", "RELIANCE", "EQ", "RELIANCE INDUSTRIES LTD", "1219.20"))
    push(d1, row("2026-09-24", "M&M", "EQ", "MAHINDRA & MAHINDRA LTD", "3000.00"))
    let r1 = tape.apply(root, nse.parse(file("2026-09-24", d1), 20260924), "u1", "s1")
    test.assert_eq_int(r1.ok, 1)
    test.assert_eq_int(r1.accepted, 2)
    test.assert_eq_int(r1.fetch_id, 1)

    let mut d2 = []string {}
    push(d2, row("2026-09-25", "RELIANCE", "EQ", "RELIANCE INDUSTRIES LTD", "1226.00"))
    // A 50% jump on M&M: cached, and a warning (an unadjusted split looks
    // like this).
    push(d2, row("2026-09-25", "M&M", "EQ", "MAHINDRA & MAHINDRA LTD", "1500.00"))
    let r2 = tape.apply(root, nse.parse(file("2026-09-25", d2), 20260925), "u2", "s2")
    test.assert_eq_int(r2.accepted, 2)
    test.assert_eq_int(r2.warnings, 1)

    // The same day again: every row is a duplicate. An older day: out of
    // sequence. Neither touches a price file.
    let r3 = tape.apply(root, nse.parse(file("2026-09-25", d2), 20260925), "u3", "s3")
    test.assert_eq_int(r3.accepted, 0)
    test.assert_eq_int(r3.rejected, 2)
    let r4 = tape.apply(root, nse.parse(file("2026-09-24", d1), 20260924), "u4", "s4")
    test.assert_eq_int(r4.accepted, 0)
    test.assert_eq_int(r4.rejected, 2)
    let why = tape.rejects_for(root, r4.fetch_id, 20)
    test.assert_eq_int(why.len, 2)
    test.assert_eq_str(why[0], "2;RELIANCE;20260924;out of sequence")

    let c = tape.closes(root, "RELIANCE")
    test.assert_eq_int(c.dates.len, 2)
    test.assert_eq_int(c.dates[0], 20260924)
    test.assert_eq_int(c.dates[1], 20260925)
    test.assert(c.paise[1] == i64(122600))

    let ix = tape.read_index(root)
    test.assert_eq_int(ix.symbols.len, 2)
    test.assert_eq_int(ix.last_dates[1], 20260925)
    test.assert(ix.last_paise[1] == i64(150000))
    test.assert_eq_int(ix.bars[0], 2)
    let f = tape.last_fetch(root)
    test.assert_eq_str(f[2], "u4")
}

#[test]
fn a_price_file_ahead_of_the_index_is_not_written_twice() {
    let root = fresh("ahead")
    let mut d1 = []string {}
    push(d1, row("2026-09-24", "INFY", "EQ", "INFOSYS LIMITED", "1014.50"))
    tape.apply(root, nse.parse(file("2026-09-24", d1), 20260924), "u1", "s1")
    // A run that wrote the price file and stopped before the index.
    sys.write_file("{{root}}/px/INFY.csv", "20260924;101450;1\n20260925;100020;2\n")
    let mut d2 = []string {}
    push(d2, row("2026-09-25", "INFY", "EQ", "INFOSYS LIMITED", "1000.20"))
    let r = tape.apply(root, nse.parse(file("2026-09-25", d2), 20260925), "u2", "s2")
    test.assert_eq_int(r.accepted, 0)
    test.assert_eq_int(r.rejected, 1)
    test.assert_eq_int(tape.closes(root, "INFY").dates.len, 2)
}

#[test]
fn stock_search_matches_symbol_start_or_name() {
    let mut syms = []string {}
    let mut names = []string {}
    push(syms, "RELIANCE")
    push(names, "RELIANCE INDUSTRIES LTD")
    push(syms, "INFY")
    push(names, "INFOSYS LIMITED")
    push(syms, "M&M")
    push(names, "MAHINDRA & MAHINDRA LTD")
    let a = catalog.search_rows(syms, names, "infy")
    test.assert_eq_int(a.len, 1)
    test.assert_eq_int(a[0], 1)
    let b = catalog.search_rows(syms, names, "mahindra")
    test.assert_eq_int(b.len, 1)
    test.assert_eq_int(b[0], 2)
    test.assert_eq_int(catalog.search_rows(syms, names, "m&m")[0], 2)
}
