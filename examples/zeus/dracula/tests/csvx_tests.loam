//! The AMFI file shape: blanks, section titles, a short row, and a `;` that
//! a quoting parser would have protected and this one must not.

import "std:test"
import "../core/csvx.loam"

#[test]
fn blanks_headers_and_a_short_row() {
    let text = "\nOpen Ended Schemes (Equity Scheme - Large Cap Fund)\n\nScheme Code;Name;NAV;Date\n119551;Growth Fund;12.50;31-Mar-2026\nshort;row\n"
    let doc = csvx.parse(text, 4)
    test.assert_eq_int(doc.lines.len, 2)
    test.assert_eq_int(doc.bad_lines.len, 1)
    test.assert_eq_int(doc.bad_lines[0], 6)
    test.assert_eq_int(doc.lines[0], 4)
    test.assert_eq_int(doc.lines[1], 5)
    test.assert_eq_str(csvx.field(doc, 0, 0), "Scheme Code")
    test.assert_eq_str(csvx.field(doc, 0, 3), "Date")
    test.assert_eq_str(csvx.field(doc, 1, 0), "119551")
    test.assert_eq_str(csvx.field(doc, 1, 1), "Growth Fund")
    test.assert_eq_str(csvx.field(doc, 1, 2), "12.50")
    test.assert_eq_str(csvx.field(doc, 1, 3), "31-Mar-2026")
}

/// Quotes are ordinary characters. The `;` inside them splits the field.
#[test]
fn quotes_do_not_protect_a_semicolon() {
    let text = "120000;\"Quoted;Name\";9.00;01-Apr-2026\n"
    let doc = csvx.parse(text, 4)
    test.assert_eq_int(doc.bad_lines.len, 0)
    test.assert_eq_int(doc.lines.len, 1)
    test.assert_eq_int(doc.counts[0], 5)
    test.assert_eq_str(csvx.field(doc, 0, 0), "120000")
    test.assert_eq_str(csvx.field(doc, 0, 1), "\"Quoted")
    test.assert_eq_str(csvx.field(doc, 0, 2), "Name\"")
    test.assert_eq_str(csvx.field(doc, 0, 3), "9.00")
    test.assert_eq_str(csvx.field(doc, 0, 4), "01-Apr-2026")
}

#[test]
fn fields_are_trimmed_and_empty_ones_kept() {
    let text = "  42 ; Fund Name ; 1.0 ; 02-Apr-2026 \na;;b;\n"
    let doc = csvx.parse(text, 3)
    test.assert_eq_int(doc.lines.len, 2)
    test.assert_eq_int(doc.bad_lines.len, 0)
    test.assert_eq_str(csvx.field(doc, 0, 0), "42")
    test.assert_eq_str(csvx.field(doc, 0, 1), "Fund Name")
    test.assert_eq_str(csvx.field(doc, 0, 2), "1.0")
    test.assert_eq_str(csvx.field(doc, 0, 3), "02-Apr-2026")
    test.assert_eq_int(doc.counts[1], 4)
    test.assert_eq_str(csvx.field(doc, 1, 0), "a")
    test.assert_eq_str(csvx.field(doc, 1, 1), "")
    test.assert_eq_str(csvx.field(doc, 1, 2), "b")
    test.assert_eq_str(csvx.field(doc, 1, 3), "")
}

#[test]
fn crlf_does_not_stick_to_the_last_field() {
    let text = "a;b;c;d\r\n"
    let doc = csvx.parse(text, 4)
    test.assert_eq_int(doc.lines.len, 1)
    test.assert_eq_str(csvx.field(doc, 0, 3), "d")
    test.assert_eq_int(doc.lines[0], 1)
}

#[test]
fn a_section_title_is_not_a_bad_line() {
    let text = "Open Ended Schemes\nonly-two;fields\n"
    let doc = csvx.parse(text, 4)
    test.assert_eq_int(doc.lines.len, 0)
    test.assert_eq_int(doc.bad_lines.len, 1)
    test.assert_eq_int(doc.bad_lines[0], 2)
}

#[test]
fn out_of_range_field_is_empty() {
    let doc = csvx.parse("a;b;c;d\n", 4)
    test.assert_eq_str(csvx.field(doc, 3, 0), "")
    test.assert_eq_str(csvx.field(doc, 0, 9), "")
}
