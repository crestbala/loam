//! `sort` and `sort_by`: order, stability, and the parallel column.
//!
//! Ties are the case that matters. An unstable sort would swap two equal keys
//! and take their labels with them, so a ranking that was already decided
//! would come out differently on the next run.

import "std:test"
import "../core/sortx.loam"

fn labels_of(n: int) -> []i64 {
    let mut xs = []i64 {}
    let mut i = 0
    while i < n {
        push(xs, i64(i))
        i = i + 1
    }
    return xs
}

#[test]
fn empty_is_left_alone() {
    let mut keys = []i64 {}
    let mut labels = []i64 {}
    sortx.sort_by(keys, labels)
    test.assert(keys.len == 0)
    test.assert(labels.len == 0)
}

#[test]
fn single_is_left_alone() {
    let mut keys = []i64 {}
    push(keys, i64(7))
    let mut labels = []i64 {}
    push(labels, i64(9))
    sortx.sort_by(keys, labels)
    test.assert(keys[0] == i64(7))
    test.assert(labels[0] == i64(9))
}

#[test]
fn already_sorted_keeps_labels() {
    let mut keys = []i64 {}
    push(keys, i64(1))
    push(keys, i64(2))
    push(keys, i64(3))
    push(keys, i64(4))
    let mut labels = labels_of(4)
    sortx.sort_by(keys, labels)
    test.assert(keys[0] == i64(1))
    test.assert(keys[3] == i64(4))
    test.assert(labels[0] == i64(0))
    test.assert(labels[3] == i64(3))
}

#[test]
fn reverse_follows_the_labels() {
    let mut keys = []i64 {}
    push(keys, i64(4))
    push(keys, i64(3))
    push(keys, i64(2))
    push(keys, i64(1))
    let mut labels = []i64 {}
    push(labels, i64(10))
    push(labels, i64(20))
    push(labels, i64(30))
    push(labels, i64(40))
    sortx.sort_by(keys, labels)
    test.assert(keys[0] == i64(1))
    test.assert(keys[1] == i64(2))
    test.assert(keys[2] == i64(3))
    test.assert(keys[3] == i64(4))
    test.assert(labels[0] == i64(40))
    test.assert(labels[1] == i64(30))
    test.assert(labels[2] == i64(20))
    test.assert(labels[3] == i64(10))
}

#[test]
fn all_equal_keeps_input_order() {
    let mut keys = []i64 {}
    push(keys, i64(5))
    push(keys, i64(5))
    push(keys, i64(5))
    push(keys, i64(5))
    let mut labels = labels_of(4)
    sortx.sort_by(keys, labels)
    test.assert(labels[0] == i64(0))
    test.assert(labels[1] == i64(1))
    test.assert(labels[2] == i64(2))
    test.assert(labels[3] == i64(3))
}

/// Two pairs of ties that straddle a merge boundary. The stable result is
/// labels `1, 3, 0, 2` against keys `1, 1, 2, 2`.
#[test]
fn ties_keep_the_earlier_row() {
    let mut keys = []i64 {}
    push(keys, i64(2))
    push(keys, i64(1))
    push(keys, i64(2))
    push(keys, i64(1))
    let mut labels = labels_of(4)
    sortx.sort_by(keys, labels)
    test.assert(keys[0] == i64(1))
    test.assert(keys[1] == i64(1))
    test.assert(keys[2] == i64(2))
    test.assert(keys[3] == i64(2))
    test.assert(labels[0] == i64(1))
    test.assert(labels[1] == i64(3))
    test.assert(labels[2] == i64(0))
    test.assert(labels[3] == i64(2))
}

/// 17 is not a power of two, so the last run of every pass is short. That is
/// the case the width arithmetic gets wrong first.
#[test]
fn odd_length_reverse() {
    let mut keys = []i64 {}
    let mut labels = []i64 {}
    let mut i = 0
    while i < 17 {
        push(keys, i64(17 - i))
        push(labels, i64(i))
        i = i + 1
    }
    sortx.sort_by(keys, labels)
    i = 0
    while i < 17 {
        test.assert(keys[i] == i64(i + 1))
        test.assert(labels[i] == i64(16 - i))
        i = i + 1
    }
}

#[test]
fn negatives_and_a_wide_value() {
    let mut keys = []i64 {}
    push(keys, i64(-1))
    push(keys, i64(-5))
    push(keys, i64(0))
    push(keys, i64(1000000000000))
    push(keys, i64(-3))
    sortx.sort(keys)
    test.assert(keys[0] == i64(-5))
    test.assert(keys[1] == i64(-3))
    test.assert(keys[2] == i64(-1))
    test.assert(keys[3] == i64(0))
    test.assert(keys[4] == i64(1000000000000))
}
