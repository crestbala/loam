//! A tolerant `;`-delimited splitter for AMFI's text files.
//!
//! AMFI's daily NAV file is not quite CSV. Sections open with a title line
//! that has no delimiter (`Open Ended Schemes (Equity Scheme - Large Cap
//! Fund)`), blank lines separate them, and the column header is repeated
//! after every title. Fields are not quoted. A `;` always starts a new field,
//! even when a human would read it as sitting inside quotes — the file does
//! not use quotes, and pretending it does would hide a broken row.
//!
//! What this module does:
//!
//! - A blank line (nothing but space, tab, or carriage return) is skipped.
//! - A line with no `;` is a section header and is skipped. It is not an
//!   error: the file is full of them on purpose.
//! - A line with a `;` but fewer than `min_fields` columns is unparseable.
//!   Its **1-based** line number is recorded and the line is not returned as
//!   a row. The number counts blank lines and headers, so it matches the file
//!   a person opens.
//! - Every other delimited line is a row. Leading and trailing space on a
//!   field is removed; space inside a field is kept (scheme names have it).
//!   A carriage return left by a CRLF line ending is removed with the other
//!   trailing whitespace, so the last field is not `31-Mar-2026\r`.
//!
//! The column-header row (`Scheme Code;...`) has enough fields to look like
//! data. Telling it apart from a scheme is the AMFI parser's job, by content.
//! This module only knows the shape.
//!
//! Rows come back flat. A `[]` of structs that themselves hold a `[]` corrupts
//! when the compiler copies it, which is the trap `std:json` documents and
//! works around. So a row is an index: `lines[row]` is the source line,
//! `counts[row]` is how many fields it has, and those fields sit in `fields`
//! starting at `starts[row]`. `field` reads one of them.

/// One parse. `lines`, `counts`, and `starts` are parallel and the same length.
struct Csv {
    /// 1-based source line of each accepted row.
    lines: []int,
    /// How many fields that row contributed.
    counts: []int,
    /// Index into `fields` where the row starts.
    starts: []int,
    /// Every accepted field, row after row.
    fields: []string,
    /// 1-based line numbers of delimited rows that were too short.
    bad_lines: []int,
}

/// The bytes of `s` in `[from, to)`, as a fresh string.
fn slice(s: string, from: int, to: int) -> string {
    let mut b = []int {}
    let mut i = from
    while i < to {
        if i >= s.len {
            break
        }
        push(b, s[i])
        i = i + 1
    }
    return string_from_bytes(b)
}

/// `s` without leading or trailing space, tab, CR, or LF.
fn trim(s: string) -> string {
    let mut a = 0
    while a < s.len {
        let c = s[a]
        if c == 32 || c == 9 || c == 13 || c == 10 {
            a = a + 1
        } else {
            break
        }
    }
    let mut b = s.len
    while b > a {
        let c = s[b - 1]
        if c == 32 || c == 9 || c == 13 || c == 10 {
            b = b - 1
        } else {
            break
        }
    }
    return slice(s, a, b)
}

/// `s` split on `\n`. A trailing newline does not produce a final empty line.
fn split_lines(s: string) -> []string {
    let mut out = []string {}
    let mut start = 0
    let mut i = 0
    while i < s.len {
        if s[i] == 10 {
            push(out, slice(s, start, i))
            start = i + 1
        }
        i = i + 1
    }
    if start < s.len {
        push(out, slice(s, start, s.len))
    }
    return out
}

/// True when `s` contains a `;`.
fn has_semi(s: string) -> bool {
    let mut i = 0
    while i < s.len {
        if s[i] == 59 {
            return true
        }
        i = i + 1
    }
    return false
}

/// Split one line on `;`, trimming each field. Empty fields are kept: `a;;b`
/// is three fields, and the middle one is empty.
fn split_fields(line: string) -> []string {
    let mut out = []string {}
    let mut start = 0
    let mut i = 0
    while i < line.len {
        if line[i] == 59 {
            push(out, trim(slice(line, start, i)))
            start = i + 1
        }
        i = i + 1
    }
    push(out, trim(slice(line, start, line.len)))
    return out
}

/// Split `text`. `min_fields` below 1 is treated as 1, so a caller cannot
/// accidentally accept every delimited line by passing 0.
fn parse(text: string, min_fields: int) -> Csv {
    let mut need = min_fields
    if need < 1 {
        need = 1
    }
    let mut lines = []int {}
    let mut counts = []int {}
    let mut starts = []int {}
    let mut fields = []string {}
    let mut bad = []int {}
    let parts = split_lines(text)
    let mut li = 0
    while li < parts.len {
        let line_no = li + 1
        let raw = parts[li]
        if trim(raw).len == 0 {
            li = li + 1
            continue
        }
        if !has_semi(raw) {
            li = li + 1
            continue
        }
        let cols = split_fields(raw)
        if cols.len < need {
            push(bad, line_no)
            li = li + 1
            continue
        }
        push(lines, line_no)
        push(starts, fields.len)
        push(counts, cols.len)
        let mut c = 0
        while c < cols.len {
            push(fields, cols[c])
            c = c + 1
        }
        li = li + 1
    }
    return Csv {
        lines: lines,
        counts: counts,
        starts: starts,
        fields: fields,
        bad_lines: bad,
    }
}

/// Field `col` of accepted row `row`, or `""` when either index is out of range.
fn field(doc: Csv, row: int, col: int) -> string {
    if row < 0 || row >= doc.lines.len {
        return ""
    }
    if col < 0 || col >= doc.counts[row] {
        return ""
    }
    return doc.fields[doc.starts[row] + col]
}
