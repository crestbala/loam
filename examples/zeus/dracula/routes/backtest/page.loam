import "std:router"
import "std:spacing"
import "std:zeus"
import "std:zui"
import "../../components/book.loam" as book
import "../../components/lab.loam" as lab
import "../../components/present.loam" as present
import "../../components/ui.loam" as ui

fn spec() -> []TableCol {
    let mut h = []TableCol {}
    push(h, TableCol { title: "Signal", width: 0 })
    push(h, TableCol { title: "Fill", width: 0 })
    push(h, TableCol { title: "Side", width: 48 })
    push(h, TableCol { title: "Code", width: 64 })
    push(h, TableCol { title: "NAV", width: 0, align: Align.End })
    push(h, TableCol { title: "Gross", width: 0, align: Align.End })
    push(h, TableCol { title: "Stamp", width: 0, align: Align.End })
    push(h, TableCol { title: "STT", width: 0, align: Align.End })
    push(h, TableCol { title: "Load", width: 0, align: Align.End })
    return h
}

fn paint_result(v: BacktestView) {
    if !v.have {
        if v.note.len > 0 {
            zeus.Text(v.note, style = Style(wrap = true))
        } else {
            zeus.Text("Run a rule once a scheme has loaded.")
        }
        return
    }
    ui.StatGrid(v.ending)
    zeus.Text("Sharpe, drawdown, and the rest are for the selected rule.")
    zeus.Text(v.score, style = Style(wrap = true))
    zeus.Text(v.note, style = Style(wrap = true))
    let labels = v.labels
    let vals = v.vals
    let names = lab.equity_names()
    if labels.len > 0 && vals.len == labels.len * names.len {
        zui.Card(title = "Equity of the selected rule, rupees", subtitle = "Last equity in each bucket, and the equity on each fill date.") {
            zui.LineChart(labels, names, vals, 720, 260, fit = true, decimals = v.decimals,
                          labelEvery = 0, dots = false)
        }
    }
    let cells = v.trades
    if cells.len == 0 {
        zeus.Text("No fill.")
        return
    }
    zui.Title("Fills")
    zui.TableCols(spec())
    let rows = cells.len / present.ledger_cols()
    let mut r = 0
    while r < rows {
        zui.TableRowCols(present.row_at(cells, present.ledger_cols(), r), spec(), zebra = true)
        r = r + 1
    }
}

fn paint_pick() {
    if book.watch_count() == 0 {
        zui.Empty(icon = zeus.IC_INFO, title = "Add a fund on Holdings first",
                  body = "A backtest runs on a scheme from your list.") {
            zui.Button(label = "Go to Holdings", size = zeus.Size.Sm, on_click = fn() { router.navigate("/") })
        }
        return
    }
    zui.Row(8) {
        zui.Select(lab.pick_signal(), lab.pick_labels())
        zui.Button(label = "Run", on_click = fn() { lab.arm_backtest() })
    }
}

fn Page(p: Params) -> Node {
    return zui.Column(spacing.SECTION) {
        zui.Heading("Backtest")
        zui.Body(fn() -> string { return lab.cash_sentence() })
        zui.Body("12-month momentum holds up to the top 5 names on the watchlist, equal weight, and rebalances on the last print of the month. Buy and hold and the monthly SIP use those same schemes and the same opening cash. The fund's own NAV history is on its chart page.")
        if book.started() && lab.started() {
            zui.Match(book.load_gen(), fn(g) {
                if g >= 0 {
                    paint_pick()
                }
            })
            zui.Segmented(lab.rule_signal(), lab.rule_labels())
            zeus.effect(fn() { lab.try_backtest() })
            zui.Match(lab.backtest(), fn(v) {
                return zeus.Box(style = Style(direction = Direction.Column)) {
                    paint_result(v)
                }
            })
        } else {
            zeus.Text("Run a rule once a scheme has loaded.")
        }
    }

}

fn meta(p: Params) -> Meta {
    return Meta { title: "Backtest" }
}
