import "std:router"
import "std:spacing"
import "std:zeus"
import "std:zui"
import "../../components/stocks.loam" as stocks
import "../../components/ui.loam" as ui

fn spec() -> []TableCol {
    let mut h = []TableCol {}
    push(h, TableCol { title: "Company", width: 0 })
    push(h, TableCol { title: "Symbol", width: 120 })
    push(h, TableCol { title: "Last close", width: 110, align: ALIGN.End })
    push(h, TableCol { title: "As of", width: 110 })
    return h
}

fn paint_hits() {
    let st = stocks.search_status()
    if st == 0 {
        zui.Empty(icon = zeus.IC_INFO, title = "Search the cached stocks",
                  body = "Type an NSE symbol such as RELIANCE, or part of a company name.")
        return
    }
    if st == 1 {
        zeus.Text("Searching the cached symbols.")
        return
    }
    if st == 3 {
        ui.ServerDown(fn() { stocks.search_retry() })
        return
    }
    let n = stocks.hit_count()
    let q = stocks.search_query()
    if n == 0 {
        zui.Empty(icon = zeus.IC_INFO, title = "No cached stock matches \"{{q}}\"",
                  body = "Only symbols in a fetched NSE bhavcopy are here. Load closes on the Data page.")
        return
    }
    let total = stocks.hit_total_count()
    if total > n {
        zeus.Text("First {{n}} of {{total}} matches. Add a word to narrow it.")
    }
    zui.TableCols(spec())
    let mut i = 0
    while i < n {
        let sym = stocks.hit_symbol(i)
        zui.TableRowCols(stocks.hit_cells(i), spec(), hover = true,
                         on_click = fn() { router.navigate("/stocks/{{sym}}") })
        i = i + 1
    }
}

fn page(p: Params) {
    zui.Column(spacing.SECTION) {
        zui.Heading("Stocks")
        zui.Body("Daily closing prices from the NSE bhavcopy, cached apart from the fund NAVs. Closes are as published, not adjusted for splits or bonuses. No signal, no backtest, no order.")
        if stocks.started() {
            zui.TextInput(stocks.search_field(), "Symbol or company name", width = 360)
            zeus.effect(fn() { stocks.search_tick() })
            zui.Match(stocks.search_generation(), fn(g) {
                if g >= 0 {
                    paint_hits()
                }
            })
        } else {
            zeus.Text("Search the cached stocks")
        }
    }
}

fn meta(p: Params) -> Meta {
    return Meta { title: "Stocks" }
}
