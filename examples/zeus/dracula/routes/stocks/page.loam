import "std:router"
import "std:spacing"
import "std:zeus"
import "std:zui"
import "../../components/stocks.loam" as stocks
import "../../components/ui.loam" as ui

fn spec() -> []TableCol {
    let mut h = []TableCol {}
    push(h, TableCol { title: "Company", width: 0 })
    push(h, TableCol { title: "Symbol", width: 120 })
    push(h, TableCol { title: "Last close", width: 110, align: Align.End })
    push(h, TableCol { title: "As of", width: 110 })
    return h
}

/// The results for one search state. `MatchBy` keeps the arm while the state
/// (and whether any row matched) holds; inside it the rows are an `Each` over
/// the hits, so a refined query keeps the rows that still match and builds
/// only the new ones.
fn arm(v: Signal<StockSearch>) -> Node {
    let x = v.peek()
    if x.state == 0 {
        return zui.Empty(icon = zeus.IC_INFO, title = "Search the cached stocks",
                         body = "Type an NSE symbol such as RELIANCE, or part of a company name.")
    }
    if x.state == 1 {
        return zeus.Text("Searching the cached symbols.")
    }
    if x.state == 3 {
        return ui.ServerDown(fn() { stocks.search_retry() })
    }
    if x.hits.len == 0 {
        return zui.Empty(icon = zeus.IC_INFO, title = fn() -> string { return "No cached stock matches \"{{v.get().query}}\"" },
                         body = "Only symbols in a fetched NSE bhavcopy are here. Load closes on the Data page.")
    }
    return hits(v)
}

fn more_line(x: StockSearch) -> string {
    let n = x.hits.len
    let total = x.total
    return "First {{n}} of {{total}} matches. Add a word to narrow it."
}

fn hits(v: Signal<StockSearch>) -> Node {
    return zui.Column(0) {
        zeus.Text(fn() -> string { return more_line(v.get()) },
                  style = Style(display = zeus.shown(v.get().total > v.get().hits.len)))
        zui.TableCols(spec())
        zui.Each(v.get().hits, fn(i: int, h: StockHit) -> Node {
            let sym = h.sym
            return zui.TableRowCols(h.cells, spec(), hover = true,
                                    on_click = fn() { router.navigate("/stocks/{{sym}}") })
        })
    }
}

fn Page(p: Params) -> Node {
    return zui.Column(spacing.SECTION) {
        zui.Heading("Stocks")
        zui.Body("Daily closing prices from the NSE bhavcopy, cached apart from the fund NAVs. Closes are as published, not adjusted for splits or bonuses. No signal, no backtest, no order.")
        if stocks.started() {
            zui.TextInput(stocks.search_field(), "Symbol or company name", style = Style(width = px(360)))
            zeus.effect(fn() { stocks.search_tick() })
            zui.MatchBy(stocks.search(), fn(x: StockSearch) -> string { return "{{x.state}}:{{x.hits.len == 0}}" },
                        fn(v: Signal<StockSearch>) -> Node { return arm(v) })
        } else {
            zeus.Text("Search the cached stocks")
        }
    }

}

fn meta(p: Params) -> Meta {
    return Meta { title: "Stocks" }
}
