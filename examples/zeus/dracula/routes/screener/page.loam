import "std:router"
import "std:spacing"
import "std:zeus"
import "std:zui"
import "../../components/book.loam" as book
import "../../components/ui.loam" as ui

fn spec() -> []TableCol {
    let mut h = []TableCol {}
    push(h, TableCol { title: "Rank", width: 48, align: Align.End })
    push(h, TableCol { title: "Scheme", width: 0 })
    push(h, TableCol { title: "Code", width: 72 })
    push(h, TableCol { title: "12-month momentum", width: 150, align: Align.End })
    push(h, TableCol { title: "Status", width: 170 })
    return h
}

/// The ranks: one arm while the list is empty or not; the rows are an `Each`,
/// so a re-rank moves the rows instead of rebuilding them.
fn arm(v: Signal<RowList>) -> Node {
    if v.peek().rows.len == 0 {
        return zui.Empty(icon = zeus.IC_INFO, title = "No schemes to rank.",
                         body = "Add funds on Holdings. The screener ranks that list.")
    }
    return rank_rows(v)
}

fn rank_rows(v: Signal<RowList>) -> Node {
    return zui.Column(0) {
        zeus.Box(style = Style(display = zeus.shown(v.get().down))) {
            ui.ServerDown(fn() { book.retry() })
        }
        zui.TableCols(spec())
        zui.Each(v.get().rows, fn(i: int, r: CodeRow) -> Node {
            let code = r.code
            return zui.TableRowCols(r.cells, spec(), hover = true,
                                    on_click = fn() { router.navigate("/scheme/{{code}}") })
        })
    }
}

fn Page(p: Params) -> Node {
    return zui.Column(spacing.SECTION) {
        zui.Heading("Screener")
        zui.Body("Ranks the watchlist by 12-month momentum. A tie keeps the earlier scheme. Warm-up is not a rank. Click a row for its chart.")
        if book.started() {
            zui.MatchBy(book.ranks(), fn(x: RowList) -> string { return "{{x.rows.len == 0}}" },
                        fn(v: Signal<RowList>) -> Node { return arm(v) })
        } else {
            zeus.Text("No schemes to rank.")
        }
    }

}

fn meta(p: Params) -> Meta {
    return Meta { title: "Screener" }
}
