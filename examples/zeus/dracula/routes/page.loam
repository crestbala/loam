import "std:router"
import "std:spacing"
import "std:zeus"
import "std:zui"
import "../components/book.loam" as book
import "../components/ui.loam" as ui

fn hold_spec() -> []TableCol {
    let mut h = []TableCol {}
    push(h, TableCol { title: "Scheme", width: 0 })
    push(h, TableCol { title: "Code", width: 72 })
    push(h, TableCol { title: "Last NAV", width: 96, align: Align.End })
    push(h, TableCol { title: "As of", width: 96 })
    push(h, TableCol { title: "Signal", width: 160 })
    return h
}

fn hit_spec() -> []TableCol {
    let mut h = []TableCol {}
    push(h, TableCol { title: "Scheme", width: 0 })
    push(h, TableCol { title: "Code", width: 72 })
    push(h, TableCol { title: "Last NAV", width: 96, align: Align.End })
    push(h, TableCol { title: "As of", width: 150 })
    return h
}

/// The search results under the card. `MatchBy` keeps the arm while the
/// search state (and whether anything matched) holds; the rows are an `Each`
/// over the hits, so a refined query keeps the rows that still match, and
/// adding a fund swaps only that row's action.
fn hits_arm(v: Signal<FundSearch>) -> Node {
    let x = v.peek()
    if x.state == 0 {
        return zui.Column(0)
    }
    if x.state == 1 {
        return zeus.Text("Searching the cached catalog.")
    }
    if x.state == 3 {
        return ui.ServerDown(fn() { book.search_retry() })
    }
    if x.hits.len == 0 {
        return zeus.Text(fn() -> string { return "No cached scheme matches \"{{v.get().query}}\"." })
    }
    return hit_rows(v)
}

fn more_line(x: FundSearch) -> string {
    let n = x.hits.len
    let total = x.total
    return "First {{n}} of {{total}} matches. Add a word to narrow it."
}

fn hit_rows(v: Signal<FundSearch>) -> Node {
    return zui.Column(0) {
        zeus.Text(fn() -> string { return more_line(v.get()) },
                  style = Style(display = zeus.shown(v.get().total > v.get().hits.len)))
        ui.HeadWithAction(hit_spec())
        zui.Each(v.get().hits, fn(i: int, h: FundHit) -> Node {
            let code = h.code
            let on = h.watching
            return ui.LinkRowWithAction(h.cells, hit_spec(), "/scheme/{{code}}", fn() {
                hit_action(code, on)
            })
        })
    }
}

fn hit_action(code: string, on: bool) {
    if on {
        zeus.Text("On the list")
    } else {
        zui.Button(label = "Add", size = zeus.Size.Sm, on_click = fn() { book.add_watch(code) })
    }
}

/// The holdings table: one arm while the list is empty or not; the rows are an
/// `Each`, so a fetch that changes one row's NAV rebuilds that row only.
fn rows_arm(v: Signal<RowList>) -> Node {
    if v.peek().rows.len == 0 {
        return zui.Empty(icon = zeus.IC_INFO, title = "No holdings yet",
                         body = "Search above by fund name or scheme code, then Add.")
    }
    return hold_rows(v)
}

fn hold_rows(v: Signal<RowList>) -> Node {
    return zui.Column(0) {
        zeus.Box(style = Style(display = zeus.shown(v.get().down))) {
            ui.ServerDown(fn() { book.retry() })
        }
        ui.HeadWithAction(hold_spec())
        zui.Each(v.get().rows, fn(i: int, r: CodeRow) -> Node {
            let code = r.code
            return ui.LinkRowWithAction(r.cells, hold_spec(), "/scheme/{{code}}", fn() {
                zui.Button(label = "Remove", look = zeus.Look.Ghost, size = zeus.Size.Sm,
                           on_click = fn() { book.remove_code(code) })
            })
        })
    }
}

fn Page(p: Params) -> Node {
    return zui.Column(spacing.SECTION) {
        zui.Heading("Holdings")
        zui.Body("A signal names the rule and the NAV it saw. The fill is the next published NAV. Nothing on this page is an order. Click a row for its chart.")
        if book.started() {
            zui.Card(title = "Add a fund", subtitle = "Search the cached direct equity schemes by name or code.") {
                zui.Row(8) {
                    zui.TextInput(book.search_field(), "Fund name or scheme code", style = Style(width = px(360)))
                    zui.Button(label = "Add code", look = zeus.Look.Ghost, on_click = fn() { book.add_typed() })
                }
                zeus.effect(fn() { book.search_tick() })
                zui.MatchBy(book.search(), fn(x: FundSearch) -> string { return "{{x.state}}:{{x.hits.len == 0}}" },
                            fn(v: Signal<FundSearch>) -> Node { return hits_arm(v) })
            }
            zui.MatchBy(book.holdings(), fn(x: RowList) -> string { return "{{x.rows.len == 0}}" },
                        fn(v: Signal<RowList>) -> Node { return rows_arm(v) })
        } else {
            zeus.Text("No holdings yet")
        }
    }

}

fn meta(p: Params) -> Meta {
    return Meta { title: "Holdings" }
}
