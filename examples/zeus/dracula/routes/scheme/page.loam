import "std:router"
import "std:spacing"
import "std:zeus"
import "std:zui"
import "../../components/book.loam" as book
import "../../components/ui.loam" as ui

fn spec() -> []TableCol {
    let mut h = []TableCol {}
    push(h, TableCol { title: "Scheme", width: 0 })
    push(h, TableCol { title: "Code", width: 72 })
    push(h, TableCol { title: "Last NAV", width: 96, align: Align.End })
    push(h, TableCol { title: "As of", width: 150 })
    return h
}

fn paint_hits() {
    let st = book.search_status()
    if st == 0 {
        zui.Empty(icon = zeus.IC_INFO, title = "Search the cached funds",
                  body = "Type part of a fund name, such as quantum value, or a scheme code.")
        return
    }
    if st == 1 {
        zeus.Text("Searching the cached catalog.")
        return
    }
    if st == 3 {
        ui.ServerDown(fn() { book.search_retry() })
        return
    }
    let n = book.hit_count()
    let q = book.search_query()
    if n == 0 {
        zeus.Text("No cached scheme matches \"{{q}}\".")
        return
    }
    let total = book.hit_total_count()
    if total > n {
        zeus.Text("First {{n}} of {{total}} matches. Add a word to narrow it.")
    }
    zui.TableCols(spec())
    let mut i = 0
    while i < n {
        let code = book.hit_code(i)
        zui.TableRowCols(book.hit_cells(i), spec(), hover = true,
                         on_click = fn() { router.navigate("/scheme/{{code}}") })
        i = i + 1
    }
}

fn Page(p: Params) -> Node {
    return zui.Column(spacing.SECTION) {
        zui.Heading("Charts")
        zui.Body("Every cached direct equity fund has a NAV history chart. Search by name or code and click a row.")
        if book.started() {
            zui.TextInput(book.search_field(), "Fund name or scheme code", style = Style(width = px(360)))
            zeus.effect(fn() { book.search_tick() })
            zui.Match(book.search_generation(), fn(g) {
                if g >= 0 {
                    paint_hits()
                }
            })
        } else {
            zeus.Text("Search the cached funds")
        }
    }

}

fn meta(p: Params) -> Meta {
    return Meta { title: "Charts" }
}
