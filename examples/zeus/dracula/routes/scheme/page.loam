import "std:router"
import "std:spacing"
import "std:zeus"
import "std:zui"
import "../../components/book.loam" as book
import "../../components/ui.loam" as ui

fn spec() -> []TableCol {
    let mut h = []TableCol {}
    push(h, TableCol { title: "Scheme", width: 0 })
    push(h, TableCol { title: "Code", width: 72 })
    push(h, TableCol { title: "Last NAV", width: 96, align: Align.End })
    push(h, TableCol { title: "As of", width: 150 })
    return h
}

/// The results for one search state; the rows are an `Each` over the hits (see
/// the stock search).
fn arm(v: Signal<FundSearch>) -> Node {
    let x = v.peek()
    if x.state == 0 {
        return zui.Empty(icon = zeus.IC_INFO, title = "Search the cached funds",
                         body = "Type part of a fund name, such as quantum value, or a scheme code.")
    }
    if x.state == 1 {
        return zeus.Text("Searching the cached catalog.")
    }
    if x.state == 3 {
        return ui.ServerDown(fn() { book.search_retry() })
    }
    if x.hits.len == 0 {
        return zeus.Text(fn() -> string { return "No cached scheme matches \"{{v.get().query}}\"." })
    }
    return hits(v)
}

fn more_line(x: FundSearch) -> string {
    let n = x.hits.len
    let total = x.total
    return "First {{n}} of {{total}} matches. Add a word to narrow it."
}

fn hits(v: Signal<FundSearch>) -> Node {
    return zui.Column(0) {
        zeus.Text(fn() -> string { return more_line(v.get()) },
                  style = Style(display = zeus.shown(v.get().total > v.get().hits.len)))
        zui.TableCols(spec())
        zui.Each(v.get().hits, fn(i: int, h: FundHit) -> Node {
            let code = h.code
            return zui.TableRowCols(h.cells, spec(), hover = true,
                                    on_click = fn() { router.navigate("/scheme/{{code}}") })
        })
    }
}

fn Page(p: Params) -> Node {
    return zui.Column(spacing.SECTION) {
        zui.Heading("Charts")
        zui.Body("Every cached direct equity fund has a NAV history chart. Search by name or code and click a row.")
        if book.started() {
            zui.TextInput(book.search_field(), "Fund name or scheme code", style = Style(width = px(360)))
            zeus.effect(fn() { book.search_tick() })
            zui.MatchBy(book.search(), fn(x: FundSearch) -> string { return "{{x.state}}:{{x.hits.len == 0}}" },
                        fn(v: Signal<FundSearch>) -> Node { return arm(v) })
        } else {
            zeus.Text("Search the cached funds")
        }
    }

}

fn meta(p: Params) -> Meta {
    return Meta { title: "Charts" }
}
