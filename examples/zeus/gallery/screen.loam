fn Field(name: Signal<string>, note: Signal<string>, st: Store) {
    zeus.SectionHeader("Forms", "Input",
                       "A label + input pair: 36px tall, rounded, hairline border.")
    zeus.Card() {
        zeus.Field("Name", name, "Your name")
        zeus.Text(if name.get().len < 3 { "Name must be at least 3 characters." } else { "" },
                  color = zeus.danger(), font = zeus.FONT_CONTROL)
        zeus.TextArea(note, "Draft — saved as you type", fn() => kv.set(st, "draft", note.get()))
        zeus.Note("{{note.get().len}} chars · std:kv under Application Support")
        zeus.Button("Submit", look = zeus.LOOK.Solid, size = zeus.SIZE.Md, on_click = fn() => name.set(name.get()))
    }
}

fn DateSection() {
    let year = zeus.signal(2026)
    let month = zeus.signal(10)
    let day = zeus.signal(17)
    zeus.SectionHeader("Forms", "Date picker",
                       "Input-like trigger with a calendar icon; the sheet floats above the page, so the scroller cannot clip it.")
    zeus.Card() {
        zeus.DatePicker(year, month, day)
    }
}

fn Choice() {
    let tab = zeus.signal(0)
    let size = zeus.signal(1)
    let mode = zeus.signal(1)
    let group = zeus.signal(0)
    zeus.SectionHeader("Choice", "Tabs, select, radio, toggle",
                       "A muted tray for tabs, a dropdown for sizes, radio dots for one pick, and an accent-pressed toggle group.")
    zeus.Card() {
        zeus.Note("tabs — active trigger is the card surface")
        zeus.Tabs(tab, []string { "One", "Two", "Three" })
        zeus.Note("select — the menu floats below the trigger")
        zeus.Select(size, []string { "Small", "Medium", "Large" })
        zeus.Note("radio group — filled dot on the picked row")
        zeus.RadioGroup(mode, []string { "Default", "Comfortable", "Compact" })
        zeus.Note("toggle group — muted fill when pressed")
        zeus.ToggleGroup(group, []string { "Bold", "Italic", "Underline" })
        zeus.Note("toggle — borderless until pressed")
        let blink = zeus.signal(1)
        zeus.Toggle("Blink cursor", blink)
    }
}

fn Controls() {
    let on = zeus.signal(1)
    let notes = zeus.signal(0)
    let vol = zeus.signal(42)
    zeus.SectionHeader("Controls", "Switch, check, slider, toggle",
                       "The switch eases onto its track; drag the slider thumb or use the arrow keys. Progress echoes the value.")
    zeus.Card() {
        zeus.Row(SPACE.Md) {
            zeus.Switch(on)
            zeus.Text(if on.get() == 1 { "On" } else { "Off" }, color = zeus.ink(), font = zeus.FONT_BODY)
            zeus.Grow()
            zeus.Checkbox("Notify me", notes)
        }
        zeus.Note("volume  {{vol.get()}}%")
        zeus.Slider(vol)
        zeus.Progress(vol)
    }
}

fn People() {
    zeus.SectionTitle("People", "Avatars and stats")
    zeus.Row(SPACE.Md) {
        zeus.Card() {
            zeus.User("AP", "Ada Park", "Operator")
            zeus.User("BL", "Bea Liu", "Editor")
            zeus.Row(SPACE.Xs) {
                zeus.Avatar("AP", 32)
                zeus.Avatar("BL", 40)
                zeus.Avatar("CD", 48)
            }
        }
        zeus.Stat("Uptime", "99.9%", zeus.TINT.Ok)
        zeus.Stat("Errors", "2", zeus.TINT.Danger)
    }
}

fn Upload() {
    let photo = zeus.signal("")
    let pw = zeus.signal(0)
    let ph = zeus.signal(0)
    zeus.SectionHeader("Media", "Upload",
                       "Choose a PNG, JPEG, WebP, or GIF. The preview keeps its aspect and auto-sizes to the device width.")
    zeus.Card() {
        zeus.Row(SPACE.Sm) {
            zeus.Button("Choose image", look = zeus.LOOK.Solid, size = zeus.SIZE.Md, on_click = fn() {
                zeus.pick_image(photo, pw, ph)
            })
            zeus.Button("Clear", look = zeus.LOOK.Ghost, size = zeus.SIZE.Md, on_click = fn() {
                photo.set("")
                pw.set(0)
                ph.set(0)
            })
        }
        // `show =` is a plain bool read once at build, so it cannot follow the
        // pick; signal shows do. `pw` is 0 until `pick_image` reports a size.
        let empty = zeus.Box(
            align_direction = DIRECTION.Row,
            align_items = ALIGN.Center,
            justify = ALIGN.Center,
            height = 200,
            radius = 8,
            background = zeus.raised()) {
            zeus.Text("No image yet", color = zeus.mute(), font = zeus.FONT_CAPTION)
        }
        zeus.show_eq(empty, pw, 0)
        // No `width` / `max_width` / aspect wiring: `Image` takes the decoded
        // source size and shrinks to the card (device) width on its own.
        let shot = zeus.Image(photo.get(), radius = 8, fit = IMAGE_FIT.Contain)
        zeus.show_ne(shot, pw, 0)
    }
}

fn Data() {
    let page = zeus.signal(3)
    zeus.SectionTitle("Data", "Table and pagination")
    zeus.Card() {
        zeus.TableHead([]string {"Name", "Role", "Status"})
        zeus.TableRow([]string {"Ada", "Operator", "Active"})
        zeus.TableRow([]string {"Bea", "Editor", "Away"})
        zeus.TableRow([]string {"Cal", "Viewer", "Active"})
    }
    zeus.Note("Pagination — {{page.get()}} / 5 · ghost pages, outline current")
    zeus.Pagination(page, 5)
}

fn Components() {
    let st = kv.open("zeus-gallery")
    let name = zeus.signal("")
    let note = zeus.signal(kv.get(st, "draft"))
    DateSection()
    ButtonScale()
    DisplayRow()
    Field(name, note, st)
    Choice()
    Controls()
    People()
    Upload()
    Data()
    Disclosure()
    Menus()
}

fn NameRow(name: string) -> Node {
    zeus.Row(SPACE.Sm) {
        zeus.Pip(zeus.mute(), 6)
        zeus.Body(name)
    }
}

fn LiveList() {
    let n = zeus.signal(2)
    zeus.SectionHeader("Lists", "Growing rows",
                       "Add and remove rows. Extra rows are shown, not rebuilt with zeus.For.")
    zeus.Card() {
        zeus.show_ge(NameRow("Ada"), n, 1)
        zeus.show_ge(NameRow("Bea"), n, 2)
        zeus.show_ge(NameRow("Row"), n, 3)
        zeus.show_ge(NameRow("Row"), n, 4)
        zeus.Row(SPACE.Sm) {
            zeus.Button("Add row", look = zeus.LOOK.Solid, size = zeus.SIZE.Md, on_click = fn() {
                if n.get() < 4 {
                    n.set(n.get() + 1)
                }
            })
            zeus.Button("Remove", look = zeus.LOOK.Ghost, size = zeus.SIZE.Md, on_click = fn() {
                if n.get() > 0 {
                    n.set(n.get() - 1)
                }
            })
        }
    }
}

fn Cards() {
    zeus.SectionTitle("Surfaces", "Cards")
    zeus.Grid(config = GridConfig(columns = 3, gap = SPACE.Md)) {
        zeus.Card() { zeus.Pip(zeus.accent(), 8) zeus.Title("Small") zeus.Body("Neutral primary on paper.") }
        zeus.Card() { zeus.Pip(zeus.ok(), 8) zeus.Title("Medium") zeus.Body("Rounded-xl is the card radius.") }
        zeus.Card() { zeus.Pip(zeus.danger(), 8) zeus.Title("Large") zeus.Body("Badges and caps mark status.") }
    }
}

fn Skeletons() {
    zeus.SectionHeader("Feedback", "Skeleton",
                       "Placeholder fills while content loads. Radius matches the shape it replaces.")
    zeus.Card() {
        zeus.Row(SPACE.Md) {
            zeus.Skeleton(40, 40, 20)
            zeus.Column(SPACE.Exs) {
                zeus.Skeleton(220, 14, 7)
                zeus.Skeleton(160, 14, 7)
            }
        }
    }
}

fn Overlays() {
    let open = zeus.signal(0)
    let ask = zeus.signal(0)
    zeus.SectionTitle("Overlay", "Dialog and alert dialog")
    zeus.Row(SPACE.Sm) {
        zeus.Button("Dialog", look = zeus.LOOK.Solid, size = zeus.SIZE.Md, on_click = fn() => open.set(1))
        zeus.Button("Alert dialog", look = zeus.LOOK.Outline, size = zeus.SIZE.Md, on_click = fn() => ask.set(1))
    }
    zeus.Body("Dialog has a corner X; alert dialog does not. Cancel is ghost or outline; the destructive action closes.")
    zeus.Dialog(open, title = "Share the link?") {
        zeus.Body("Anyone with the link can view this project. You can revoke access later.")
        zeus.Row(SPACE.Sm) {
            zeus.Grow()
            zeus.Button("Cancel", look = zeus.LOOK.Ghost, size = zeus.SIZE.Md, on_click = fn() => open.set(0))
            zeus.Button("Share", look = zeus.LOOK.Solid, size = zeus.SIZE.Md, on_click = fn() => open.set(0))
        }
    }
    zeus.AlertDialog(ask, title = "Discard changes?") {
        zeus.Body("This cannot be undone. The working tree keeps whatever you have not saved.")
        zeus.Row(SPACE.Sm) {
            zeus.Grow()
            zeus.Button("Cancel", look = zeus.LOOK.Outline, size = zeus.SIZE.Md, on_click = fn() => ask.set(0))
            zeus.Button("Discard", look = zeus.LOOK.Danger, size = zeus.SIZE.Md, on_click = fn() => ask.set(0))
        }
    }
}

// --- phase 4 additions: disclosure, menus, feedback, anchored floaters ---

fn Disclosure() {
    let open = zeus.signal(-1)
    let more = zeus.signal(0)
    zeus.SectionHeader("Disclosure", "Accordion and collapsible",
                       "One open index closes the rest by construction; the collapsible is the same model without the card. Chevron and body fade are paint-only.")
    zeus.Accordion(open) {
        zeus.AccordionItem(open = open, index = 0, title = "Shipping", body = "Ships in 2-4 business days.")
        zeus.AccordionItem(open = open, index = 1, title = "Returns", body = "30 days, no questions asked.")
        zeus.AccordionItem(open = open, index = 2, title = "Warranty", body = "Two years, parts and labour.")
    }
    zeus.Collapsible(open = more, title = "Advanced options", border_color = zeus.rule()) {
        zeus.Body("A bare disclosure: a header row, a chevron, and a body that fades in.")
    }
}

fn Menus() {
    let act = zeus.signal(-1)
    let picked = zeus.signal(0)
    zeus.SectionHeader("Menus", "Dropdown menu",
                       "Arrows move the highlight, Enter runs the active command, and Escape or an outside click closes.")
    zeus.Row(SPACE.Sm) {
        let trigger = zeus.Button("Actions", look = zeus.LOOK.Outline, size = zeus.SIZE.Md)
        zeus.Menu(trigger, active = act, width = 200) {
            zeus.MenuLabel("File")
            zeus.MenuItem(active = act, index = 0, count = 3, label = "Rename",
                          on_click = fn() => picked.set(1))
            zeus.MenuItem(active = act, index = 1, count = 3, label = "Duplicate",
                          on_click = fn() => picked.set(2))
            zeus.MenuSeparator()
            zeus.MenuItem(active = act, index = 2, count = 3, label = "Delete", danger = true,
                          on_click = fn() => picked.set(3))
        }
        zeus.Text("last command: {{picked.get()}}", color = zeus.mute(), font = zeus.FONT_BODY)
    }
}

fn Feedback() {
    zeus.SectionHeader("Feedback", "Spinner and empty state",
                       "The spinner is clock-driven and settles under reduced motion; the empty state centres an optional action.")
    zeus.Card() {
        zeus.Row(SPACE.Md) {
            zeus.Spinner()
            zeus.Spinner(size = 24, color = zeus.ink())
            zeus.Text("Working...", color = zeus.mute(), font = zeus.FONT_BODY)
        }
    }
    zeus.Card() {
        zeus.Empty(icon = zeus.IC_INFO, title = "No projects",
                   body = "Create one to get started.") {
            zeus.Button("New project", look = zeus.LOOK.Solid, size = zeus.SIZE.Sm)
        }
    }
}

fn Floating() {
    let pop = zeus.signal(0)
    let toast = zeus.signal(0)
    let drawer = zeus.signal(0)
    zeus.SectionTitle("Overlay", "Popover, tooltip, hover card, toast, drawer")
    zeus.Row(SPACE.Sm) {
        let pt = zeus.Button("Open popover", look = zeus.LOOK.Solid, size = zeus.SIZE.Md,
                             on_click = fn() => pop.set(1))
        zeus.Popover(pt, open = pop, width = 220) {
            zeus.Title("Details")
            zeus.Body("Anchored to the trigger and edge-aware: it flips above near the bottom.")
        }
        zeus.Tooltip(pt, text = "Opens a popover")
        let hc = zeus.Button("Hover card", look = zeus.LOOK.Outline, size = zeus.SIZE.Md)
        zeus.HoverCard(hc, width = 240) {
            zeus.Title("Ada Lovelace")
            zeus.Body("Wrote the first algorithm for a machine.")
        }
        zeus.Tooltip(hc, text = "Hover for a card")
    }
    zeus.Row(SPACE.Sm) {
        zeus.Button("Toast", look = zeus.LOOK.Outline, size = zeus.SIZE.Md,
                    on_click = fn() => toast.set(1))
        zeus.Button("Drawer", look = zeus.LOOK.Solid, size = zeus.SIZE.Md,
                    on_click = fn() => drawer.set(1))
    }
    zeus.Toast(toast, width = 200) {
        zeus.Text("Saved", color = zeus.on_ink(), font = zeus.FONT_BODY)
    }
    zeus.Drawer(drawer, side = zeus.SIDE.SideEnd, size = 300) {
        zeus.Title("Filters")
        zeus.Body("A drawer pins to a window edge over a scrim and slides in.")
        zeus.Button("Close", look = zeus.LOOK.Outline, size = zeus.SIZE.Md,
                    on_click = fn() => drawer.set(0))
    }
}

// --- Charts (Patterns page): chart cards over zeus plots ---

let mut chart_labs: []string = []string {}
let mut chart_series: []string = []string {}
let mut chart_vals: []int = []int {}

fn ChartCards() {
    if chart_labs.len == 0 {
        push(chart_labs, "Jan")
        push(chart_labs, "Feb")
        push(chart_labs, "Mar")
        push(chart_labs, "Apr")
        push(chart_labs, "May")
        push(chart_labs, "Jun")
        push(chart_labs, "Jul")
        push(chart_labs, "Aug")
        push(chart_labs, "Sep")
        push(chart_labs, "Oct")
        push(chart_labs, "Nov")
        push(chart_labs, "Dec")
        push(chart_series, "Desktop")
        push(chart_series, "Mobile")
        push(chart_vals, 186)
        push(chart_vals, 82)
        push(chart_vals, 305)
        push(chart_vals, 134)
        push(chart_vals, 237)
        push(chart_vals, 290)
        push(chart_vals, 73)
        push(chart_vals, 226)
        push(chart_vals, 209)
        push(chart_vals, 91)
        push(chart_vals, 214)
        push(chart_vals, 240)
        push(chart_vals, 130)
        push(chart_vals, 170)
        push(chart_vals, 160)
        push(chart_vals, 210)
        push(chart_vals, 180)
        push(chart_vals, 150)
        push(chart_vals, 230)
        push(chart_vals, 190)
        push(chart_vals, 250)
        push(chart_vals, 220)
        push(chart_vals, 170)
        push(chart_vals, 260)
    }
    zeus.SectionHeader("Data", "Charts",
                       "Hover a column or a point: the floating tooltip lists every series value, like the recharts cursor. The plot re-fits its card on window resize.")
    zeus.Card() {
        zeus.Title("Bar chart · Total visitors")
        zeus.Body("Desktop and mobile sessions by month, grouped per category.")
        zeus.BarChart(chart_labs, chart_series, chart_vals, 850, 216)
    }
    zeus.Card() {
        zeus.Title("Line chart · Trend")
        zeus.Body("Straight segments with a dot on every data point; the stroke follows the series color.")
        zeus.LineChart(chart_labs, chart_series, chart_vals, 850, 216)
    }
    zeus.Card() {
        zeus.Title("Area chart · Volume")
        zeus.Body("A tinted wash under the line; the fill restyles with the appearance.")
        zeus.AreaChart(chart_labs, chart_series, chart_vals, 850, 216)
    }
}

fn Patterns() {
    LiveList()
    Cards()
    ChartCards()
    Skeletons()
    Feedback()
    Overlays()
    Floating()
}

fn Showcase() {
    let page = zeus.signal(1)
    zeus.Page() {
        Navbar(page)
        zeus.show_eq(zeus.Column(zeus.SECTION) {
            Foundations()
        }, page, 0)
        zeus.show_eq(zeus.Column(zeus.SECTION) {
            Components()
        }, page, 1)
        zeus.show_eq(zeus.Column(zeus.SECTION) {
            Patterns()
        }, page, 2)
    }
}

fn Screen() {
    Showcase()
}
