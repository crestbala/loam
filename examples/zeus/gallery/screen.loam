fn Field(name: Signal<string>, note: Signal<string>, st: Store) {
    zui.SectionHeader("Forms", "Input",
                       "A label + input pair: 36px tall, rounded, hairline border.")
    zui.Card() {
        zui.Field("Name", name, "Your name")
        zeus.Text(if name.get().len < 3 { "Name must be at least 3 characters." } else { "" },
                  color = zeus.danger(), font = spacing.FONT_CONTROL)
        zui.TextArea(note, "Draft — saved as you type", fn() => kv.set(st, "draft", note.get()))
        zui.Note("{{note.get().len}} chars · std:kv under Application Support")
        zui.Button("Submit", look = zeus.LOOK.Solid, size = zeus.SIZE.Md, on_click = fn() => name.set(name.get()))
    }
}

fn DateSection() {
    let year = zeus.signal(2026)
    let month = zeus.signal(10)
    let day = zeus.signal(17)
    zui.SectionHeader("Forms", "Date picker",
                       "Input-like trigger with a calendar icon; the sheet floats above the page, so the scroller cannot clip it.")
    zui.Card() {
        zui.DatePicker(year, month, day)
    }
}

fn Choice() {
    let tab = zeus.signal(0)
    let size = zeus.signal(1)
    let mode = zeus.signal(1)
    let group = zeus.signal(0)
    zui.SectionHeader("Choice", "Tabs, select, radio, toggle",
                       "A muted tray for tabs, a dropdown for sizes, radio dots for one pick, and an accent-pressed toggle group.")
    zui.Card() {
        zui.Note("tabs — active trigger is the card surface")
        zui.Tabs(tab, []string { "One", "Two", "Three" })
        zui.Note("select — the menu floats below the trigger")
        zui.Select(size, []string { "Small", "Medium", "Large" })
        zui.Note("combobox — type to filter, Enter picks")
        let query = zeus.signal("")
        zui.Combobox(query, []string { "Apple", "Apricot", "Banana", "Cherry" }, width = 200)
        zui.Note("radio group — filled dot on the picked row")
        zui.RadioGroup(mode, []string { "Default", "Comfortable", "Compact" })
        zui.Note("toggle group — muted fill when pressed")
        zui.ToggleGroup(group, []string { "Bold", "Italic", "Underline" })
        zui.Note("toggle — borderless until pressed")
        let blink = zeus.signal(1)
        zui.Toggle("Blink cursor", blink)
    }
}

fn Controls() {
    let on = zeus.signal(1)
    let notes = zeus.signal(0)
    let vol = zeus.signal(42)
    zui.SectionHeader("Controls", "Switch, check, slider, toggle",
                       "The switch eases onto its track; drag the slider thumb or use the arrow keys. Progress echoes the value.")
    zui.Card() {
        zui.Row(SPACE.Md) {
            zui.Switch(on)
            zeus.Text(if on.get() == 1 { "On" } else { "Off" }, color = zeus.ink(), font = spacing.FONT_BODY)
            zui.Grow()
            zui.Checkbox("Notify me", notes)
        }
        zui.Note("volume  {{vol.get()}}%")
        zui.Slider(vol)
        zui.Progress(vol)
    }
}

fn People() {
    zui.SectionTitle("People", "Avatars and stats")
    zui.Row(SPACE.Md) {
        zui.Card() {
            zui.User("AP", "Ada Park", "Operator", status = zeus.TINT.Ok)
            zui.User("BL", "Bea Liu", "Editor", status = zeus.TINT.Warn)
            zui.Row(SPACE.Xs) {
                zui.Avatar("AP", 32, status = zeus.TINT.Ok)
                zui.Avatar("BL", 40, status = zeus.TINT.Warn)
                zui.Avatar("CD", 48, status = zeus.TINT.Danger)
            }
            zui.AvatarGroup([]string { "AP", "BL", "CD" }, 32)
        }
        let spark = zeus.signal([]int { 3, 5, 4, 8, 7, 9, 12 })
        zui.Stat("Uptime", "99.9%", zeus.TINT.Ok, delta = "+0.2%", trend = zui.TREND.Up, spark = spark)
        zui.Stat("Errors", "2", zeus.TINT.Danger, delta = "-3 today", trend = zui.TREND.Down)
    }
}

fn Upload() {
    let photo = zeus.signal("")
    let pw = zeus.signal(0)
    let ph = zeus.signal(0)
    zui.SectionHeader("Media", "Upload",
                       "Choose a PNG, JPEG, WebP, or GIF. The preview keeps its aspect and auto-sizes to the device width.")
    zui.Card() {
        zui.Row(SPACE.Sm) {
            zui.Button("Choose image", look = zeus.LOOK.Solid, size = zeus.SIZE.Md, on_click = fn() {
                zui.pick_image(photo, pw, ph)
            })
            zui.Button("Clear", look = zeus.LOOK.Ghost, size = zeus.SIZE.Md, on_click = fn() {
                photo.set("")
                pw.set(0)
                ph.set(0)
            })
        }
        // `show =` is a plain bool read once at build, so it cannot follow the
        // pick; signal shows do. `pw` is 0 until `pick_image` reports a size.
        let empty = zeus.Box(
            align_direction = DIRECTION.Row,
            align_items = ALIGN.Center,
            justify = ALIGN.Center,
            height = 200,
            radius = 8,
            background = colors.raised()) {
            zeus.Text("No image yet", color = colors.mute(), font = spacing.FONT_CAPTION)
        }
        zeus.show_eq(empty, pw, 0)
        // No `width` / `max_width` / aspect wiring: `Image` takes the decoded
        // source size and shrinks to the card (device) width on its own.
        let shot = zui.Image(photo.get(), radius = 8, fit = IMAGE_FIT.Contain)
        zeus.show_ne(shot, pw, 0)
    }
}

struct Member {
    name: string,
    role: string,
    qty: int,
}

fn member_cells(m: Member) -> []string {
    return []string { m.name, m.role, "{{m.qty}}" }
}

fn Data() {
    let page = zeus.signal(3)
    let long_page = zeus.signal(1)
    let sort = zeus.signal(0)
    let picked = zeus.signal("none")
    let mut spec = []TableCol {}
    push(spec, TableCol { title: "Name", width: 0, sortable: true })
    push(spec, TableCol { title: "Role", width: 0, sortable: true })
    push(spec, TableCol { title: "Qty", width: 64, align: ALIGN.End, sortable: true })
    let mut members = []Member {}
    push(members, Member { name: "Ada", role: "Operator", qty: 12 })
    push(members, Member { name: "Bea", role: "Editor", qty: 7 })
    push(members, Member { name: "Cal", role: "Viewer", qty: 30 })
    push(members, Member { name: "Dee", role: "Viewer", qty: 4 })
    let rows = zeus.signal(members)
    zui.SectionTitle("Data", "Table and pagination")
    zui.Card() {
        zui.TableHead([]string {"Name", "Role", "Status"})
        zui.TableRow([]string {"Ada", "Operator", "Active"})
        zui.TableRow([]string {"Bea", "Editor", "Away"})
        zui.TableRow([]string {"Cal", "Viewer", "Active"})
    }
    zui.Note("Table — sortable headers reorder the rows · zebra · row click · end-aligned numbers · picked: {{picked.get()}}")
    zui.Card() {
        zui.Table(spec, rows, member_cells, sort = sort, zebra = true,
                   on_pick = fn(i: int) => picked.set(rows.get()[i].name))
    }
    zui.Note("Pagination — {{page.get()}} / 5 · ghost pages, outline current")
    zui.Pagination(page, 5)
    zui.Note("Pagination — {{long_page.get()}} / 20 · collapses to 1 … c-1 c c+1 … 20")
    zui.Pagination(long_page, 20)
}

fn Components() {
    let st = kv.open("zeus-gallery")
    let name = zeus.signal("")
    let note = zeus.signal(kv.get(st, "draft"))
    DateSection()
    ButtonScale()
    DisplayRow()
    Field(name, note, st)
    Choice()
    Controls()
    People()
    Upload()
    Data()
    Disclosure()
    Menus()
    States()
}

fn NameRow(name: string) -> Node {
    zui.Row(SPACE.Sm) {
        zui.Pip(colors.mute(), 6)
        zui.Body(name)
    }
}

fn LiveList() {
    let n = zeus.signal(2)
    zui.SectionHeader("Lists", "Growing rows",
                       "Add and remove rows. Extra rows are shown, not rebuilt with zui.For.")
    zui.Card() {
        zeus.show_ge(NameRow("Ada"), n, 1)
        zeus.show_ge(NameRow("Bea"), n, 2)
        zeus.show_ge(NameRow("Row"), n, 3)
        zeus.show_ge(NameRow("Row"), n, 4)
        zui.Row(SPACE.Sm) {
            zui.Button("Add row", look = zeus.LOOK.Solid, size = zeus.SIZE.Md, on_click = fn() {
                if n.get() < 4 {
                    n.set(n.get() + 1)
                }
            })
            zui.Button("Remove", look = zeus.LOOK.Ghost, size = zeus.SIZE.Md, on_click = fn() {
                if n.get() > 0 {
                    n.set(n.get() - 1)
                }
            })
        }
    }
}

fn Cards() {
    zui.SectionTitle("Surfaces", "Cards")
    zui.Grid(config = GridConfig(columns = 3, gap = SPACE.Md)) {
        zui.Card() { zui.Pip(zeus.accent(), 8) zui.Title("Small") zui.Body("Neutral primary on paper.") }
        zui.Card() { zui.Pip(colors.ok(), 8) zui.Title("Medium") zui.Body("Rounded-xl is the card radius.") }
        zui.Card() { zui.Pip(zeus.danger(), 8) zui.Title("Large") zui.Body("Badges and caps mark status.") }
    }
}

fn Skeletons() {
    zui.SectionHeader("Feedback", "Skeleton",
                       "Placeholder fills while content loads, with a left-to-right shimmer. Radius matches the shape it replaces.")
    zui.Card() {
        zui.Row(SPACE.Md) {
            zui.Skeleton(40, 40, 20)
            zui.Column(SPACE.Exs) {
                zui.Skeleton(220, 14, 7)
                zui.Skeleton(160, 14, 7)
            }
        }
    }
    let pct = zeus.signal(35)
    let busy = zeus.signal(-1)
    zui.Note("Progress — a plain set eases; a negative value sweeps (indeterminate)")
    zui.Card() {
        zui.Row(SPACE.Sm) {
            zui.Progress(pct)
            zui.Button("+20", look = zeus.LOOK.Outline, size = zeus.SIZE.Sm, on_click = fn() {
                if pct.get() >= 100 {
                    pct.set(0)
                } else {
                    pct.set(pct.get() + 20)
                }
            })
        }
        zui.Progress(busy)
    }
    zui.Note("Card — interactive: hover lifts, press scales; header / footer / media slots")
    let taps = zeus.signal(0)
    zui.Row(SPACE.Sm) {
        zui.Card(interactive = true, on_click = fn() => taps.set(taps.get() + 1)) {
            zui.Title("Interactive")
            zui.Body("Tapped {{taps.get()}} times.")
        }
        zui.Card(title = "Plan", subtitle = "Billed monthly", footer = fn() {
            zui.Grow()
            zui.Button("Upgrade", look = zeus.LOOK.Solid, size = zeus.SIZE.Sm)
        }) {
            zui.Body("Header and footer slots keep the body between them.")
        }
    }
}

fn Overlays() {
    let open = zeus.signal(0)
    let ask = zeus.signal(0)
    zui.SectionTitle("Overlay", "Dialog and alert dialog")
    zui.Row(SPACE.Sm) {
        zui.Button("Dialog", look = zeus.LOOK.Solid, size = zeus.SIZE.Md, on_click = fn() => open.set(1))
        zui.Button("Alert dialog", look = zeus.LOOK.Outline, size = zeus.SIZE.Md, on_click = fn() => ask.set(1))
    }
    zui.Body("Dialog has a corner X; alert dialog does not. Cancel is ghost or outline; the destructive action closes.")
    zui.Dialog(open, title = "Share the link?") {
        zui.Body("Anyone with the link can view this project. You can revoke access later.")
        zui.Row(SPACE.Sm) {
            zui.Grow()
            zui.Button("Cancel", look = zeus.LOOK.Ghost, size = zeus.SIZE.Md, on_click = fn() => open.set(0))
            zui.Button("Share", look = zeus.LOOK.Solid, size = zeus.SIZE.Md, on_click = fn() => open.set(0))
        }
    }
    zui.AlertDialog(ask, title = "Discard changes?") {
        zui.Body("This cannot be undone. The working tree keeps whatever you have not saved.")
        zui.Row(SPACE.Sm) {
            zui.Grow()
            zui.Button("Cancel", look = zeus.LOOK.Outline, size = zeus.SIZE.Md, on_click = fn() => ask.set(0))
            zui.Button("Discard", look = zeus.LOOK.Danger, size = zeus.SIZE.Md, on_click = fn() => ask.set(0))
        }
    }
}

// --- phase 4 additions: disclosure, menus, feedback, anchored floaters ---

fn Disclosure() {
    let open = zeus.signal(-1)
    let more = zeus.signal(0)
    let rows = []AccordionRow {
        AccordionRow { title: "Shipping", body: "Ships in 2-4 business days." },
        AccordionRow { title: "Returns", body: "30 days, no questions asked." },
        AccordionRow { title: "Warranty", body: "Two years, parts and labour." },
    }
    zui.SectionHeader("Disclosure", "Accordion and collapsible",
                       "One open index closes the rest by construction; the collapsible is the same model without the card. Chevron and body fade are paint-only.")
    zui.Accordion(open, items = rows)
    zui.Collapsible(open = more, title = "Advanced options", border_color = colors.rule()) {
        zui.Body("A bare disclosure: a header row, a chevron, and a body that fades in.")
    }
}

fn Menus() {
    let picked = zeus.signal(0)
    let active_label = zeus.signal("Rename")

    let menu_items = []MenuRow {
        MenuRow(label = "Rename"),
        MenuRow(label = "Duplicate", is_separated = true),
        MenuRow(label = "Delete"),
    }
    zui.SectionHeader("Menus", "Dropdown menu",
                       "Click the trigger to open it. Arrows move the highlight, Enter runs the active command, and Escape or an outside click closes.")
    zui.Row(SPACE.Sm) {
        // A menu trigger is any node: this one is a row with a chevron, so it
        // reads as a dropdown rather than a plain action button.
        let trigger = zeus.Box(
            align_direction = zeus.DIRECTION.Row,
            align_items = zeus.ALIGN.Center,
            spacing = 4,
            padding_x = 12,
            padding_y = 8,
            background = colors.plate(),
            border = spacing.HAIRLINE,
            border_color = colors.rule(),
            radius = spacing.RAD_MD,
            cursor = "pointer",
            hover_off = false,
            press = true,
            a11y_role = "button",
            a11y_label = "Open menu"
        ) {
            zeus.Text(active_label.get(), color = zeus.ink(), font = spacing.FONT_CONTROL)
            zui.Icon(zeus.IC_CHEV_DOWN, 16, colors.dim())
        }
        zui.Menu(trigger, width = 200, label = "File", items = menu_items,
                  on_select = fn(i: int) => active_label.set(menu_items[i].label))
        zeus.Text("last command: {{active_label.get()}}", color = colors.mute(), font = spacing.FONT_BODY)
    }
}

fn Feedback() {
    zui.SectionHeader("Feedback", "Spinner and empty state",
                       "The spinner is clock-driven and settles under reduced motion; the empty state centres an optional action.")
    zui.Card() {
        zui.Row(SPACE.Md) {
            zui.Spinner()
            zui.Spinner(size = 24, color = zeus.ink())
            zeus.Text("Working...", color = colors.mute(), font = spacing.FONT_BODY)
        }
    }
    zui.Card() {
        zui.Empty(icon = zeus.IC_INFO, title = "No projects",
                   body = "Create one to get started.") {
            zui.Button("New project", look = zeus.LOOK.Solid, size = zeus.SIZE.Sm)
        }
    }
}

/// One field in the state matrix. `edge` is the border token, `off` dims and
/// inerts it through the shared disabled state, `bad` records the shared
/// `invalid` state (the border color is how the chrome shows it).
///
/// These are REAL fields, not pictures of fields. They used to be a Box with a
/// Text in it, which read as a field but could not take a caret, so the
/// "resting" one could not be typed into — the one thing the row is for. A
/// `TextInput` bound to its own signal gives the resting and invalid rows a
/// caret and a working keyboard, and disabled keeps its inert state.
fn StateField(text: string, edge: string, off: int, bad: int) -> Node {
    let value = zeus.signal(text)
    let f = zui.TextInput(value, "", width = 200, border_color = edge,
                           font = spacing.FONT_CONTROL)
    if off != 0 {
        zeus.disabled(f, true)
    }
    if bad != 0 {
        zeus.invalid(f, true)
    }
    return f
}

/// Capstone: each control resting beside the states it can be posed in.
/// Disabled and loading are static props; invalid is the shared state model
/// (`invalid`), which an app's own chrome reads through `state_invalid`.
/// Hover, press and focus are live — the engine drives them from the pointer
/// and the keyboard, so they are shown by using the control, not posed.
fn States() {
    zui.SectionHeader("States", "Interaction matrix",
                       "Resting beside disabled, loading and invalid. Hover, press and focus are live: hover a control, press it, or Tab to it.")
    zui.Card() {
        zui.Note("Button — resting · disabled · loading · icon")
        let busy = zeus.signal(1)
        zui.RowWrap(SPACE.Sm) {
            zui.Button("Resting", look = zeus.LOOK.Solid, size = zeus.SIZE.Md)
            zui.Button("Disabled", look = zeus.LOOK.Solid, size = zeus.SIZE.Md, enabled = false)
            zui.Button("Loading", look = zeus.LOOK.Solid, size = zeus.SIZE.Md, loading = busy)
            zui.Button("Icon", look = zeus.LOOK.Solid, size = zeus.SIZE.Md, icon = zeus.IC_PLUS)
        }
        zui.Note("Outline · ghost · link — resting beside disabled")
        zui.RowWrap(SPACE.Sm) {
            zui.Button("Outline", look = zeus.LOOK.Outline, size = zeus.SIZE.Md)
            zui.Button("Outline", look = zeus.LOOK.Outline, size = zeus.SIZE.Md, enabled = false)
            zui.Button("Ghost", look = zeus.LOOK.Ghost, size = zeus.SIZE.Md)
            zui.Button("Ghost", look = zeus.LOOK.Ghost, size = zeus.SIZE.Md, enabled = false)
            zui.Button("Link", look = zeus.LOOK.Link, size = zeus.SIZE.Md)
            zui.Button("Link", look = zeus.LOOK.Link, size = zeus.SIZE.Md, enabled = false)
        }
    }
    zui.Card() {
        zui.Note("Field — resting · disabled · invalid")
        zui.Row(SPACE.Sm) {
            StateField("ada@lovelace.dev", colors.rule(), 0, 0)
            StateField("ada@lovelace.dev", colors.rule(), 1, 0)
            StateField("not-an-email", zeus.danger(), 0, 1)
        }
    }
}

fn Floating() {
    let pop = zeus.signal(0)
    let toast = zeus.signal(0)
    let drawer = zeus.signal(0)
    zui.SectionTitle("Overlay", "Popover, tooltip, hover card, toast, drawer")
    zui.Row(SPACE.Sm) {
        let pt = zui.Button("Open popover", look = zeus.LOOK.Solid, size = zeus.SIZE.Md,
                             on_click = fn() => pop.set(1))
        zui.Popover(pt, open = pop, width = 220) {
            zui.Title("Details")
            zui.Body("Anchored to the trigger and edge-aware: it flips above near the bottom.")
        }
        zui.Tooltip(pt, text = "Opens a popover")
        let hc = zui.Button("Hover card", look = zeus.LOOK.Outline, size = zeus.SIZE.Md)
        zui.HoverCard(hc, width = 240) {
            zui.Title("Ada Lovelace")
            zui.Body("Wrote the first algorithm for a machine.")
        }
        zui.Tooltip(hc, text = "Hover for a card")
    }
    zui.Row(SPACE.Sm) {
        zui.Button("Toast", look = zeus.LOOK.Outline, size = zeus.SIZE.Md,
                    on_click = fn() => toast.set(1))
        zui.Button("Drawer", look = zeus.LOOK.Solid, size = zeus.SIZE.Md,
                    on_click = fn() => drawer.set(1))
    }
    zui.Toast(toast, width = 200) {
        zeus.Text("Saved", color = colors.on_ink(), font = spacing.FONT_BODY)
    }
    zui.Drawer(drawer, side = zui.SIDE.SideEnd, size = 300) {
        zui.Title("Filters")
        zui.Body("A drawer pins to a window edge over a scrim and slides in.")
        zui.Button("Close", look = zeus.LOOK.Outline, size = zeus.SIZE.Md,
                    on_click = fn() => drawer.set(0))
    }
}

// --- Charts (Patterns page): chart cards over zeus plots ---

let mut chart_labs: []string = []string {}
let mut chart_series: []string = []string {}
let mut chart_vals: []int = []int {}

fn ChartCards() {
    if chart_labs.len == 0 {
        push(chart_labs, "Jan")
        push(chart_labs, "Feb")
        push(chart_labs, "Mar")
        push(chart_labs, "Apr")
        push(chart_labs, "May")
        push(chart_labs, "Jun")
        push(chart_labs, "Jul")
        push(chart_labs, "Aug")
        push(chart_labs, "Sep")
        push(chart_labs, "Oct")
        push(chart_labs, "Nov")
        push(chart_labs, "Dec")
        push(chart_series, "Desktop")
        push(chart_series, "Mobile")
        push(chart_vals, 186)
        push(chart_vals, 82)
        push(chart_vals, 305)
        push(chart_vals, 134)
        push(chart_vals, 237)
        push(chart_vals, 290)
        push(chart_vals, 73)
        push(chart_vals, 226)
        push(chart_vals, 209)
        push(chart_vals, 91)
        push(chart_vals, 214)
        push(chart_vals, 240)
        push(chart_vals, 130)
        push(chart_vals, 170)
        push(chart_vals, 160)
        push(chart_vals, 210)
        push(chart_vals, 180)
        push(chart_vals, 150)
        push(chart_vals, 230)
        push(chart_vals, 190)
        push(chart_vals, 250)
        push(chart_vals, 220)
        push(chart_vals, 170)
        push(chart_vals, 260)
    }
    zui.SectionHeader("Data", "Charts",
                       "Hover a column or a point: the floating tooltip lists every series value, like the recharts cursor. The plot re-fits its card on window resize.")
    zui.Card() {
        zui.Title("Bar chart · Total visitors")
        zui.Body("Desktop and mobile sessions by month, grouped per category.")
        zui.BarChart(chart_labs, chart_series, chart_vals, 850, 216)
    }
    zui.Card() {
        zui.Title("Line chart · Trend")
        zui.Body("Straight segments with a dot on every data point; the stroke follows the series color.")
        zui.LineChart(chart_labs, chart_series, chart_vals, 850, 216)
    }
    zui.Card() {
        zui.Title("Area chart · Volume")
        zui.Body("A tinted wash under the line; the fill restyles with the appearance.")
        zui.AreaChart(chart_labs, chart_series, chart_vals, 850, 216)
    }
}

