// Catalog screens. Components cover the standard widget catalogue (zinc
// theme): every row here demos one `std:zeus` component with its SVG icons.
// Dark restyles the whole palette via `zeus.appearance()`.
import "std:async"
import "std:zeus"
import "std:kv"

let mut ram_armed: int = 0

/// Navbar RAM pill: refreshes twice a second through the async timer, so the
/// chip shows live host memory (resident set on desktop, live wasm heap on
/// web). Reads once at mount so the chip is never blank.
fn RamChip() {
    let ram = zeus.signal(zeus.memory_kb())
    if ram_armed == 0 {
        ram_armed = 1
        async.interval(500, fn() { ram.set(zeus.memory_kb()) })
    }
    zeus.Box(align_direction = DIRECTION.Row, align_items = ALIGN.Center,
             spacing = SPACE.Exxs, padding_x = 10, padding_y = 4, height = 26,
             radius = zeus.RAD_FULL, background = zeus.raised()) {
        zeus.Text(fn() -> string {
            let mb = ram.get() / 1024
            return "RAM {{mb}} MB"
        }, color = zeus.mute(), font = zeus.FONT_CAPTION)
    }
}

fn Navbar(page: Signal<int>) {
    zeus.Column(SPACE.None) {
        zeus.Box(align_direction = DIRECTION.Row, spacing = SPACE.Md,
                 align_items = ALIGN.Center, height = zeus.BAR) {
            zeus.Box(width = 22, height = 22, radius = 6, background = zeus.ink())
            zeus.Text("Zeus", color = zeus.ink(), font = zeus.FONT_TITLE)
            zeus.NavTab("Foundations", page, 0)
            zeus.NavTab("Components", page, 1)
            zeus.NavTab("Patterns", page, 2)
            zeus.Grow()
            RamChip()
            zeus.Text("Dark", color = zeus.mute(), font = zeus.FONT_CONTROL)
            zeus.Switch(zeus.appearance())
        }
        zeus.Separator()
    }
}

fn ProjectCard() {
    let ticks = zeus.signal(0)
    zeus.Card() {
        zeus.Row(SPACE.Sm) {
            zeus.Title("Project card")
            zeus.Grow()
            zeus.Badge("In progress", zeus.TINT.Ok)
        }
        zeus.Body("A card with a title, supporting copy, and a footer of actions. Shadcn chrome: rounded-xl, hairline border, white surface.")
        zeus.Row(SPACE.Sm) {
            zeus.Button("Cancel", look = zeus.LOOK.Outline, size = zeus.SIZE.Md, on_click = fn() => ticks.set(ticks.get() + 1))
            zeus.Button("Save", look = zeus.LOOK.Solid, size = zeus.SIZE.Md, on_click = fn() => ticks.set(ticks.get() + 1))
            zeus.Grow()
            zeus.Text("{{ticks.get()}}", color = zeus.mute(), font = zeus.FONT_CAPTION)
        }
    }
}

fn Foundations() {
    zeus.Breadcrumbs([]string {"Zeus", "Examples", "Gallery"})
    zeus.Column(SPACE.Exs) {
        zeus.Display("Build interfaces with Zeus")
        zeus.Body("Zinc tokens, neutral primary, and lucide SVG icons. Dark inverts every token that reads appearance.")
    }
    zeus.Row(SPACE.Sm) {
        zeus.Chip("Stable", zeus.TINT.Ok)
        zeus.Chip("Canvas2D", zeus.TINT.Ink)
        zeus.Badge("zeus", zeus.TINT.Mute)
        zeus.Kbd("⌘K")
    }
    zeus.Alert("Heads up", "Signals update on click. Hover and press are engine fades — no DOM.")
    zeus.AlertDestructive("Session expired", "Sign back in to keep syncing. Your drafts are saved locally.")
    ProjectCard()
    Customize()
}

fn Customize() {
    zeus.SectionHeader("Customize", "Style props + slots",
                       "Style props restyle a recipe without copying it. Comp is the primitive for your own widget. Trailing blocks are slots.")
    zeus.Card() {
        zeus.RowWrap(SPACE.Sm) {
            zeus.Button("Recipe", look = zeus.LOOK.Solid, size = zeus.SIZE.Md)
            zeus.Button("Styled", look = zeus.LOOK.Solid, size = zeus.SIZE.Md,
                        radius = 999, padding_x = 20,)
            zeus.IconButton(zeus.IC_CHECK, zeus.LOOK.Soft, zeus.SIZE.Md, "Save")
            zeus.Chip("pill", zeus.TINT.Ok, radius = 6)
        }
        zeus.Card(radius = 6, padding = 12) {
            zeus.Body("This card used radius = 6, padding = 12.")
        }
        zeus.Comp(background = zeus.raised(), radius = 10,
                  padding = 12, spacing = 8,
                  align_direction = DIRECTION.Row, align_items = ALIGN.Center) {
            zeus.Pip(zeus.accent(), 8)
            zeus.Text("Comp — a function widget, styled by props", font = zeus.FONT_BODY,
                      color = zeus.ink())
        }
        zeus.Badge("custom", zeus.TINT.Mute, radius = 2, padding_x = 8)
        zeus.Alert("Styled alert", "Same recipe, different radius.",
                   radius = 4, padding = 10)
    }
}

