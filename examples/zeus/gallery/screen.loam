// Catalog screens. Components cover the standard widget catalogue (zinc
// theme): every row here demos one `std:zeus` component with its SVG icons.
// Dark restyles the whole palette via `zeus.appearance()`.
import "std:async"
import "std:zeus"
import "std:colors"
import "std:spacing"
import "std:zui"
import "std:kv"

let mut ram_armed: int = 0

/// Host memory in KB as "12.3 MB" (one decimal). Integer MB rounded the
/// wasm live heap — a few hundred KB — down to "0 MB", which read as broken.
fn fmt_mb(kb: int) -> string {
    let tenths = kb * 10 / 1024
    return "{{tenths / 10}}.{{tenths % 10}} MB"
}

/// Navbar RAM pill: refreshes twice a second through the async timer, so the
/// chip shows live host memory (phys_footprint on Apple, resident set on
/// Linux / Android, live wasm heap on web). Reads once at mount so the chip
/// is never blank.
fn RamChip() -> Node {
    let ram = zeus.signal(zeus.memory_kb())
    if ram_armed == 0 {
        ram_armed = 1
        async.interval(500, fn() { ram.set(zeus.memory_kb()) })
    }
    return zeus.Box(style = Style(height = px(26),
                           direction = Direction.Row,
                           gap = Space.Exxs,
                           align = Align.Center,
                           padding = edges2(4, 10),
                           radius = corners(spacing.RAD_FULL),
                           background = colors.raised())) {
        zeus.Text("RAM {{fmt_mb(ram.get())}}", style = Style(font = spacing.FONT_CAPTION, color = colors.mute()))
    }

}

fn Navbar(page: Signal<int>) -> Node {
    return zui.Column(Space.None) {
        zeus.Box(style = Style(height = px(spacing.BAR),
                               direction = Direction.Row,
                               gap = Space.Md,
                               align = Align.Center)) {
            zeus.Box(style = Style(width = px(22), height = px(22), radius = corners(6), background = zeus.ink()))
            zeus.Text("Zeus", style = Style(font = spacing.FONT_TITLE, color = zeus.ink()))
            zui.NavTab("Foundations", page, 0)
            zui.NavTab("Components", page, 1)
            zui.NavTab("Patterns", page, 2)
            zui.Grow()
            AccentDots()
            RamChip()
            zeus.Text("Dark", style = Style(font = spacing.FONT_CONTROL, color = colors.mute()))
            zui.ThemeSwitch()
        }
        zui.Separator()
    }
}

/// Accent picker: the five brand ramps as swatches. `set_accent` re-registers
/// the twelve A-slots in place, so every themed control follows on the next
/// paint with no rebuild and no effect runs — the same trick that makes the
/// light / dark switch free. The ring marks the ramp in effect.
fn AccentDots() -> Node {
    let which = zeus.signal(colors.accent_choice())
    let mut idx = []int {}
    for i in 0..colors.accent_count() {
        push(idx, i)
    }
    return zui.Row(Space.Exxs) {
        zui.Loop(idx, fn(i, k) {
            let dot = zeus.Box(style = Style(width = px(16),
                                             height = px(16),
                                             radius = corners(spacing.RAD_FULL),
                                             background = colors.accent_scale_light(i).s9,
                                             cursor = "pointer"),
                               role = "button",
                               label = colors.accent_name(i),
                               on_click = fn() {
                                   which.set(i)
                                   colors.set_accent(i)
                               }) {
                zeus.Box(style = Style(width = px(22),
                                       height = px(22),
                                       position = zeus.pos_absolute(),
                                       inset = Edges(top = -3, left = -3),
                                       radius = corners(spacing.RAD_FULL),
                                       border = line(2, zeus.ink()),
                                       display = if which.get() == i { Display.Flex } else { Display.None }))
            }
        })
    }

}

fn ProjectCard() -> Node {
    let ticks = zeus.signal(0)
    return zui.Card() {
        zui.Row(Space.Sm) {
            zui.Title("Project card")
            zui.Grow()
            zui.Badge("In progress", zeus.Tint.Ok)
        }
        zui.Body("A card with a title, supporting copy, and a footer of actions. Shadcn chrome: rounded-xl, hairline border, white surface.")
        zui.Row(Space.Sm) {
            zui.Button("Cancel", look = zeus.Look.Outline, size = zeus.Size.Md, on_click = fn() => ticks.set(ticks.get() + 1))
            zui.Button("Save", look = zeus.Look.Solid, size = zeus.Size.Md, on_click = fn() => ticks.set(ticks.get() + 1))
            zui.Grow()
            zeus.Text("{{ticks.get()}}", style = Style(font = spacing.FONT_CAPTION, color = colors.mute()))
        }
    }

}

fn Foundations() -> Node {
    return Column(spacing.SECTION) {
        zui.Breadcrumbs([]string {"Zeus", "Examples", "Gallery"})
        zui.Column(Space.Exs) {
            zui.Display("Build interfaces with Zeus")
            zui.Body("Zinc tokens, neutral primary, and lucide SVG icons. Dark inverts every token that reads appearance.")
        }
        let unread = zeus.signal(12)
        let iris = zeus.signal(1)
        zui.Row(Space.Sm) {
            zui.Chip("Stable", zeus.Tint.Ok)
            zui.Chip("Canvas2D", zeus.Tint.Ink)
            zui.Badge("zeus", zeus.Tint.Mute)
            zui.Badge("Live", zeus.Tint.Ok, dot = true)
            zui.BadgeCount(unread, zeus.Tint.Danger)
            zui.Show(when = iris.get() == 1) {
                zui.Chip("Iris", zeus.Tint.Ink, on_remove = fn() => iris.set(0))
            }
            zui.Kbd("⌘K")
        }
        zui.Alert("Heads up", "Signals update on click. Hover and press are engine fades — no DOM.")
        zui.Alert("Session expired", "Sign back in to keep syncing. Your drafts are saved locally.", tone = Tone.Danger)
        ProjectCard()
        Customize()

    }
}

fn Customize() -> Node {
    return Column(spacing.SECTION) {
        zui.SectionHeader("Customize", "Style props + slots",
                           "Style props restyle a recipe without copying it. Comp is the primitive for your own widget. Trailing blocks are slots.")
        zui.Card() {
            zui.RowWrap(Space.Sm) {
                zui.Button("Recipe", look = zeus.Look.Solid, size = zeus.Size.Md)
                zui.Button("Styled",
                            look = zeus.Look.Solid,
                            size = zeus.Size.Md,
                            style = Style(padding = Edges(right = 20, left = 20), radius = corners(999)))
                zui.IconButton(zeus.IC_CHECK, zeus.Look.Soft, zeus.Size.Md, "Save")
                zui.Chip("pill", zeus.Tint.Ok, style = Style(radius = corners(6)))
            }
            zui.Card(style = Style(padding = edges(12), radius = corners(6))) {
                zui.Body("This card used radius = 6, padding = 12.")
            }
            zui.Comp(style = Style(direction = Direction.Row,
                                    gap = 8,
                                    align = Align.Center,
                                    padding = edges(12),
                                    radius = corners(10),
                                    background = colors.raised())) {
                zui.Pip(zeus.accent(), 8)
                zeus.Text("Comp — a function widget, styled by props",
                          style = Style(font = spacing.FONT_BODY, color = zeus.ink()))
            }
            zui.Badge("custom", zeus.Tint.Mute, style = Style(padding = Edges(right = 8, left = 8), radius = corners(2)))
            zui.Alert("Styled alert",
                       "Same recipe, different radius.",
                       style = Style(padding = edges(10), radius = corners(4)))
        }

    }
}

fn ButtonScale() -> Node {
    return Column(spacing.SECTION) {
        zui.SectionHeader("Actions", "Buttons",
                           "The six variants across three sizes. Primary is the neutral ink fill; it inverts with appearance.")
        zui.Card() {
            zui.Overline("Primary · Secondary · Outline · Ghost · Destructive · Link")
            zui.Note("small")
            zui.RowWrap(Space.Sm) {
                zui.Button("Solid", look = zeus.Look.Solid, size = zeus.Size.Sm)
                zui.Button("Soft", look = zeus.Look.Soft, size = zeus.Size.Sm)
                zui.Button("Outline", look = zeus.Look.Outline, size = zeus.Size.Sm)
                zui.Button("Ghost", look = zeus.Look.Ghost, size = zeus.Size.Sm)
                zui.Button("Danger", look = zeus.Look.Danger, size = zeus.Size.Sm)
                zui.Button("Link", look = zeus.Look.Link, size = zeus.Size.Sm)
            }
            zui.Note("medium")
            zui.RowWrap(Space.Sm) {
                zui.Button("Solid", look = zeus.Look.Solid, size = zeus.Size.Md)
                zui.Button("Soft", look = zeus.Look.Soft, size = zeus.Size.Md)
                zui.Button("Outline", look = zeus.Look.Outline, size = zeus.Size.Md)
                zui.Button("Ghost", look = zeus.Look.Ghost, size = zeus.Size.Md)
                zui.Button("Danger", look = zeus.Look.Danger, size = zeus.Size.Md)
                zui.Button("Link", look = zeus.Look.Link, size = zeus.Size.Md)
            }
            zui.Note("large")
            zui.RowWrap(Space.Sm) {
                zui.Button("Solid", look = zeus.Look.Solid, size = zeus.Size.Lg)
                zui.Button("Soft", look = zeus.Look.Soft, size = zeus.Size.Lg)
                zui.Button("Outline", look = zeus.Look.Outline, size = zeus.Size.Lg)
                zui.Button("Ghost", look = zeus.Look.Ghost, size = zeus.Size.Lg)
                zui.Button("Danger", look = zeus.Look.Danger, size = zeus.Size.Lg)
                zui.Button("Link", look = zeus.Look.Link, size = zeus.Size.Lg)
            }
            zui.Note("states — icon slot, loading (spinner takes the slot, inert), disabled fill; press scales to 97%")
            let busy = zeus.signal(false)
            zui.RowWrap(Space.Sm) {
                zui.Button("Add item", look = zeus.Look.Solid, size = zeus.Size.Md, icon = zeus.IC_PLUS)
                zui.Button("Save", look = zeus.Look.Solid, size = zeus.Size.Md, icon = zeus.IC_CHECK,
                            loading = busy, on_click = fn() {
                    busy.set(true)
                    async.after(1500, fn() { busy.set(false) })
                })
                zui.Button("Disabled", look = zeus.Look.Solid, size = zeus.Size.Md, enabled = false)
                zui.Button("Disabled", look = zeus.Look.Outline, size = zeus.Size.Md, enabled = false)
            }
            zui.Note("icon — square, 16px lucide glyphs in every look")
            zui.RowWrap(Space.Sm) {
                zui.IconButton(zeus.IC_PLUS, zeus.Look.Solid, zeus.Size.Sm, "Add")
                zui.IconButton(zeus.IC_MINUS, zeus.Look.Soft, zeus.Size.Md, "Remove")
                zui.IconButton(zeus.IC_X, zeus.Look.Outline, zeus.Size.Md, "Close")
                zui.IconButton(zeus.IC_CHEV_LEFT, zeus.Look.Ghost, zeus.Size.Md, "Back")
                zui.IconButton(zeus.IC_ALERT_CIRCLE, zeus.Look.Danger, zeus.Size.Lg, "Warn")
            }
        }

    }
}

