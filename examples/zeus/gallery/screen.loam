        zui.Card() {
            zui.Note("chips")
            zui.Row(Space.Sm) {
                zui.Chip("Iris", zeus.Tint.Ink)
                zui.Chip("Live", zeus.Tint.Ok)
                zui.Chip("Quiet", zeus.Tint.Mute)
                zui.Chip("Faint", zeus.Tint.Dim)
                zui.Chip("Alert", zeus.Tint.Danger)
            }
            zui.Note("badges")
            zui.Row(Space.Sm) {
                zui.Badge("secondary", zeus.Tint.Mute)
                zui.Badge("default", zeus.Tint.Ink)
                zui.Badge("success", zeus.Tint.Ok)
                zui.Badge("outline", zeus.Tint.Dim)
                zui.Badge("destructive", zeus.Tint.Danger)
            }
            zui.Note("kbd")
