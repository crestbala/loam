//! membench — the Phase 0 Zeus memory baseline (`docs/mem-baseline.md`).
//!
//! Fixed modes so bytes-per-node can be derived from a slope:
//!
//!   membench empty      an empty root box
//!   membench one        one Ghost button
//!   membench thousand   1000 Ghost buttons
//!   membench scroll     a keyed windowed list scrolled 500 one-row frames
//!
//! `scroll` is the Phase 2 proof for `docs/mem-baseline.md` §5.1: it mirrors
//! the reported reproduction (a windowed list scrolled one row at a time) on the
//! keyed path (`zui.VirtualListKeyed`), so the scroll is a bounded delta instead
//! of a rebuild of every visible row per frame.
//!
//! Run headless (one layout, then the stats report on exit):
//!
//!   make bin/loamc
//!   ZEUS_MEM_STATS=1 ZEUS_HEADLESS=1 ./bin/loamc examples/zeus/membench/membench.loam -o out/membench
//!   ZEUS_MEM_STATS=1 ZEUS_HEADLESS=1 ./out/membench thousand
//!
//! The window is a fixed 320x240 so the baseline does not move with the host
//! screen, and every mode is the same tree plus N buttons. `empty` still builds
//! the root box, so the slope (not an absolute) is what carries bytes-per-node.

import "std:fmt"
import "std:sys"
import "std:zeus"
import "std:zui"

/// Button count for a mode name. Unknown modes are a hard error: a typo that
/// silently benches the wrong tree makes the whole baseline meaningless.
fn count_for(mode: string) -> int {
    if mode == "empty" {
        return 0
    }
    if mode == "one" {
        return 1
    }
    if mode == "thousand" {
        return 1000
    }
    fmt.println("membench: unknown mode '{{mode}}' (empty | one | thousand)")
    sys.exit(2)
    return 0
}

fn Screen(n: int) -> Node {
    return zeus.Box(style = Style(direction = Direction.Column, gap = 4, padding = edges(8))) {
        let mut i = 0
        while i < n {
            zui.Button(label = "b", look = zeus.Look.Ghost, size = zeus.Size.Sm)
            i = i + 1
        }
    }
}

struct BenchRow {
    id: int,
}

fn RowKey(r: BenchRow) -> string {
    return "r{{r.id}}"
}

fn RowView(i: int, r: BenchRow) -> Node {
    return zeus.Box(style = Style(height = px(20), direction = Direction.Row)) {
        zeus.Text("row {{r.id}}")
    }
}

/// The Phase 2 scroll proof: a keyed windowed list of 500 rows scrolled 500
/// one-row frames. Live node count and `proof_allocs` should stay bounded —
/// the keyed path moves the rows that stay in the window and builds only the
/// row entering it.
fn scroll_proof() {
    let mut rows = []BenchRow {}
    let mut i = 0
    while i < 500 {
        push(rows, BenchRow { id: i })
        i = i + 1
    }
    let items = zeus.signal(rows)
    zeus.snapshot(320, 240, fn() -> Node {
        zeus.Box(style = Style(direction = Direction.Column)) {
            zui.VirtualListKeyed(items, 20, RowKey, RowView)
        }
    })
    let nodes0 = zeus.mem_live_nodes()
    let allocs0 = zeus.proof_allocs()
    let mut f = 0
    while f < 500 {
        zeus.engine_scroll(20, 20, 0, 20)
        zeus.engine_layout(320, 240)
        f = f + 1
    }
    let nodes1 = zeus.mem_live_nodes()
    let allocs1 = zeus.proof_allocs()
    fmt.println("MEMBENCH scroll live_nodes", nodes0, "->", nodes1,
                "allocs", allocs1 - allocs0)
    if nodes1 > nodes0 + 40 {
        fmt.println("FAIL: live nodes grew with scroll")
        sys.exit(1)
    }
}

fn main() {
    let a = sys.args()
    let mut mode = "empty"
    if a.len > 1 {
        mode = a[1]
    }
    if mode == "scroll" {
        fmt.println("MEMBENCH mode=scroll rows=500 frames=500")
        scroll_proof()
        return
    }
    let n = count_for(mode)
    fmt.println("MEMBENCH mode=", mode, " buttons=", n)
    zeus.App("membench", fn() -> Node { return Screen(n) }, 320, 240)
}
