// nob — the Loam build and test tool.
//
// `nob` is a Loam program, so something else has to build the first compiler:
// `nob.sh` compiles a seed `bin/loamc` and `bin/nob`, then hands every command
// here. Everything after that bootstrap lives in this file.
//
//     nob                  build bin/loamc, bin/loam-lsp, bin/loam-fmt, bin/zeli
//     nob test [-j N]      build, then run the language suites and host checks
//     nob test --isolated  the same, but every fixture as its own binary
//     nob test <filter>    only fixtures whose path contains <filter>, isolated
//     nob test <f.loam>    build and run exactly this file
//     nob integration      the zeli/serve/pkg/fmt suite (slow; on demand)
//     nob lsp              build the language server (and its objects) only
//     nob bench            build, then run packages/loam/tests/bench/run.sh
//     nob grammar          regenerate, check and publish the tree-sitter grammar
//     nob grammar-check    check the grammar against the compiler's parser
//     nob install-editor   install the VS Code extension
//     nob clean            remove build output
//     nob fuzz-borrow [N]  hunt borrow-checker holes with ASan (phase 7)
//     nob help
//
// `-j N` (default: every core, or `NOB_JOBS` / `LOAM_JOBS`) bounds how many
// cases run at once; each case's result line is streamed as it finishes. The
// pool is `xargs -P`, because Loam's `thread.spawn` workers are deliberately
// barred from the C seam (`sys.exec` is not in `worker_seam_ok`), so parallelism
// is one process per case rather than one Loam thread per case.
//
// Why `nob test` batches: compiling hundreds of fixtures separately parses and
// compiles the same Zeus library hundreds of times, and macOS scans every new
// binary on its first exec, about 0.3s per binary, one at a time across the whole
// machine, whatever `-j` says. So a full run builds the fixtures into two
// binaries, and each binary forks one process per fixture before anything has
// initialized (`runtime/batch_run.c`); only that fixture's modules then start
// (`codegen_set_batch`). A fixture that does not pass that way is rerun, then
// retried on its own, and that verdict stands.
// `--isolated` is the slower check that no fixture depends on being batched.

import "std:fmt"
import "std:sys"

// --- location and options (set by main) ----------------------------------

let mut ROOT: string = "."
let mut SRC: string = ""
let mut OBJ: string = ""
let mut BIN: string = ""
let mut TESTS: string = ""
let mut TMP: string = ""
let mut EXB: string = ""
let mut NOB: string = ""
let mut LOAMC: string = ""
let mut ZELI: string = ""
let mut FMT: string = ""
let mut JOBS: int = 1
let mut CHANGED: bool = false
let mut N_PASS: int = 0
let mut N_FAIL: int = 0
/** *Cases that failed inside a batch and were retried alone. */
let mut N_RETRIED: int = 0
let mut TSTART: int = 0
let mut FAILURES: []string = []string {}
/** *`nob test <filter>`: run only the fixtures whose path contains this */
/** *substring, and skip the host checks. Empty means the whole suite. */
let mut ONLY: string = ""
/** *`nob test <file.loam>`: build and run exactly this file, headless. */
let mut ONLY_FILE: string = ""
/** *`nob test --isolated`: every fixture as its own binary. */
let mut ISOLATED: bool = false

// --- small string helpers ------------------------------------------------

/** *`s[a..b]` as a new string (empty when the range is empty or backwards). */
fn slice(s: string, a: int, b: int) -> string {
    let mut x = []int {}
    if a < b {
        for i in a..b {
            push(x, s[i])
        }
    }
    return string_from_bytes(x)
}

/** *`a` with `b` after it. Strings are values here, so building text is a pure */
/** *function returning a new string (Loam has no `+` for strings). */
fn cat(a: string, b: string) -> string {
    let mut x = []int {}
    for i in 0..a.len {
        push(x, a[i])
    }
    for i in 0..b.len {
        push(x, b[i])
    }
    return string_from_bytes(x)
}

fn trim(s: string) -> string {
    let mut a = 0
    while a < s.len {
        let c = s[a]
        if c == 32 || c == 9 || c == 13 || c == 10 {
            a += 1
        } else {
            break
        }
    }
    let mut b = s.len
    while b > a {
        let c = s[b - 1]
        if c == 32 || c == 9 || c == 13 || c == 10 {
            b -= 1
        } else {
            break
        }
    }
    return slice(s, a, b)
}

fn int_of(s: string) -> int {
    let t = trim(s)
    let mut n = 0
    let mut i = 0
    while i < t.len {
        let c = t[i]
        if c < 48 || c > 57 {
            break
        }
        n = n * 10 + (c - 48)
        i += 1
    }
    return n
}

/** *`s` as one word for the shell: single-quoted, with `'` closed, escaped and */
/** *reopened. `sys.exec` runs through `sh`, so every path goes through this. */
fn shq(s: string) -> string {
    let mut b = []int {}
    push(b, 39) /* ' */
    for i in 0..s.len {
        let c = s[i]
        if c == 39 {
            push(b, 39)
            push(b, 92) /* \ */
            push(b, 39)
            push(b, 39)
        } else {
            push(b, c)
        }
    }
    push(b, 39)
    return string_from_bytes(b)
}

fn starts_with(s: string, prefix: string) -> bool {
    if prefix.len > s.len {
        return false
    }
    for i in 0..prefix.len {
        if s[i] != prefix[i] {
            return false
        }
    }
    return true
}

fn ends_with(s: string, suffix: string) -> bool {
    if suffix.len > s.len {
        return false
    }
    let off = s.len - suffix.len
    for i in 0..suffix.len {
        if s[i + off] != suffix[i] {
            return false
        }
    }
    return true
}

/** *`p` without its last path segment ("" when it has none). */
fn dir_of(p: string) -> string {
    let mut cut = -1
    for i in 0..p.len {
        if p[i] == 47 /* / */ {
            cut = i
        }
    }
    if cut < 0 {
        return ""
    }
    return slice(p, 0, cut)
}

/** *The last path segment of `p`. */
fn base(p: string) -> string {
    let mut cut = -1
    for i in 0..p.len {
        if p[i] == 47 /* / */ {
            cut = i
        }
    }
    if cut < 0 {
        return p
    }
    return slice(p, cut + 1, p.len)
}

fn join(dir: string, name: string) -> string {
    if dir == "" {
        return name
    }
    return "{{dir}}/{{name}}"
}

/** *`p` without this repo's root prefix, the way the suite prints a file. */
fn rel_of(p: string) -> string {
    let pre = "{{ROOT}}/"
    if starts_with(p, pre) {
        return slice(p, pre.len, p.len)
    }
    return p
}

fn pad4(i: int) -> string {
    if i < 10 {
        return "000{{i}}"
    }
    if i < 100 {
        return "00{{i}}"
    }
    if i < 1000 {
        return "0{{i}}"
    }
    return "{{i}}"
}

/** *Ordering on byte strings, so a list of paths can be sorted without a */
/** *string `<` operator the language does not have. */
fn str_less(a: string, b: string) -> bool {
    let mut n = a.len
    if b.len < n {
        n = b.len
    }
    for i in 0..n {
        if a[i] < b[i] {
            return true
        }
        if a[i] > b[i] {
            return false
        }
    }
    return a.len < b.len
}

/** *A new array with `v`'s strings in order (insertion sort). */
fn sorted(v: []string) -> []string {
    let mut out = []string {}
    for i in 0..v.len {
        push(out, v[i])
    }
    let mut i = 1
    while i < out.len {
        let x = out[i]
        let mut j = i
        while j > 0 && str_less(x, out[j - 1]) {
            out[j] = out[j - 1]
            j -= 1
        }
        out[j] = x
        i += 1
    }
    return out
}

/** *`name` with its last `n` bytes removed. */
fn drop_last(name: string, n: int) -> string {
    if name.len < n {
        return name
    }
    return slice(name, 0, name.len - n)
}

/** *`p` without a `.loam` extension, as a stem (no directory). */
fn stem_of(p: string) -> string {
    return drop_last(base(p), 5)
}

/** *`name` without a `.c` extension. */
fn stem_c(name: string) -> string {
    return drop_last(name, 2)
}

// --- filesystem listings -------------------------------------------------

/** *Every `ext` file directly in `dir`, sorted (`sys.list_dir` sorts entries). */
fn list_ext(dir: string, ext: string) -> []string {
    let mut out = []string {}
    if sys.is_dir(dir) == 0 {
        return out
    }
    let entries = sys.list_dir(dir)
    for i in 0..entries.len {
        if ends_with(entries[i], ext) {
            push(out, join(dir, entries[i]))
        }
    }
    return out
}

fn list_loam(dir: string) -> []string {
    return list_ext(dir, ".loam")
}

/** *An entry point named after its directory (`examples/zeus/dashboard/ */
/** *dashboard.loam`). Full-stack examples have no such file and are excluded. */
fn zeus_apps() -> []string {
    let mut out = []string {}
    let dir = "{{ROOT}}/examples/zeus"
    if sys.is_dir(dir) == 0 {
        return out
    }
    let entries = sys.list_dir(dir)
    for i in 0..entries.len {
        let name = entries[i]
        let d = join(dir, name)
        if sys.is_dir(d) == 1 {
            let entry = join(d, "{{name}}.loam")
            if sys.exists(entry) == 1 {
                push(out, entry)
            }
        }
    }
    return out
}

// --- shell plumbing ------------------------------------------------------

/** *Run `cmd` from the repo root and return whether it exited 0. */
fn run_ok(cmd: string) -> bool {
    sys.exec("cd {{shq(ROOT)}} && {{cmd}}")
    return sys.exec_status() == 0
}

/** *Is `a` strictly newer than `b`? (`test -nt` is true when `b` is missing, */
/** *which is the wanted behaviour for "needs building".) */
fn is_newer(a: string, b: string) -> bool {
    sys.exec("cd {{shq(ROOT)}} && test {{shq(a)}} -nt {{shq(b)}}")
    return sys.exec_status() == 0
}

fn pkg_exists(name: string) -> bool {
    sys.exec("pkg-config --exists {{name}} 2>/dev/null")
    return sys.exec_status() == 0
}

fn now_s() -> int {
    return int_of(sys.exec("date +%s"))
}

/** *Non-overlapping occurrences of `needle` in `hay`. */
fn count_of(hay: string, needle: string) -> int {
    let mut n = 0
    let mut i = 0
    while needle.len > 0 && i + needle.len <= hay.len {
        let mut same = true
        for j in 0..needle.len {
            if hay[i + j] != needle[j] {
                same = false
            }
        }
        if same {
            n = n + 1
            i = i + needle.len
        } else {
            i = i + 1
        }
    }
    return n
}

fn contains_str(hay: string, needle: string) -> bool {
    if needle.len > hay.len {
        return false
    }
    for i in 0..hay.len - needle.len + 1 {
        let mut same = true
        for j in 0..needle.len {
            if hay[i + j] != needle[j] {
                same = false
            }
        }
        if same {
            return true
        }
    }
    return false
}

/** *Every line of `text` that starts with `prefix`, trimmed. */
fn lines_with(text: string, prefix: string) -> []string {
    let mut out = []string {}
    let all = split_lines(text)
    for i in 0..all.len {
        if starts_with(all[i], prefix) {
            push(out, trim(all[i]))
        }
    }
    return out
}

fn split_lines(s: string) -> []string {
    let mut out = []string {}
    let mut start = 0
    for i in 0..s.len {
        if s[i] == 10 {
            push(out, slice(s, start, i))
            start = i + 1
        }
    }
    if start < s.len {
        push(out, slice(s, start, s.len))
    }
    return out
}

// --- compiler build ------------------------------------------------------

/** *The flags the compiler is built with. Kept in one place: `nob.sh`'s seed */
/** *build mirrors this, and `build` stamps the value into `obj/.cflags` so a */
/** *change here forces a full object rebuild. */
fn cflags() -> string {
    let mut s = "-std=c11 -D_GNU_SOURCE -Wall -Wextra -Wpedantic -O2 -g"
    s = cat(s, " -DLOAM_RT_PATH='\"{{ROOT}}/packages/loam/runtime/loam_rt.h\"'")
    s = cat(s, " -DLOAM_RUNTIME_DIR='\"{{ROOT}}/packages/loam/runtime\"'")
    s = cat(s, " -DLOAM_STD_DIR='\"{{ROOT}}/packages/loam/std\"'")
    s = cat(s, " -DLOAM_ZEUS_DIR='\"{{ROOT}}/packages/zeus\"'")
    s = cat(s, " -DLOAM_RAYGUI_DIR='\"{{ROOT}}/packages/raygui\"'")
    s = cat(s, " -DLOAM_PATH='\"{{ROOT}}/packages/zeus:{{ROOT}}/packages/zeus-components:{{ROOT}}/packages/http:{{ROOT}}/packages/maya:{{ROOT}}/packages/raygui:{{ROOT}}/packages/sqlite:{{ROOT}}/packages/crypto\"'")
    return s
}

struct CSrc {
    full: string,
    rel: string,
    obj: string,
    lib: bool,
}

/** *Every compiler source, with its object path under `obj/`. */
fn c_sources() -> []CSrc {
    let mut out = []CSrc {}
    let top = list_ext(SRC, ".c")
    for i in 0..top.len {
        let stem = stem_c(base(top[i]))
        let lib = stem != "driver" && stem != "lsp" && stem != "fmt"
        push(out, CSrc {
            full: top[i],
            rel: "packages/loam/src/{{stem}}.c",
            obj: "{{OBJ}}/{{stem}}.o",
            lib: lib,
        })
    }
    let sema = list_ext("{{SRC}}/sema", ".c")
    for i in 0..sema.len {
        let stem = stem_c(base(sema[i]))
        push(out, CSrc {
            full: sema[i],
            rel: "packages/loam/src/sema/{{stem}}.c",
            obj: "{{OBJ}}/sema/{{stem}}.o",
            lib: true,
        })
    }
    return out
}

fn quoted_list(v: []string) -> string {
    let mut s = ""
    for i in 0..v.len {
        if i > 0 {
            s = cat(s, " ")
        }
        s = cat(s, shq(v[i]))
    }
    return s
}

/** *The objects that link into a given binary: `loamc` adds `driver.o`, `lsp` */
/** *adds `lsp.o`; both take every library object. */
fn objs_of(srcs: []CSrc, what: string) -> []string {
    let mut out = []string {}
    for i in 0..srcs.len {
        let s = srcs[i]
        let take = s.lib || (what == "loamc" && s.rel == "packages/loam/src/driver.c") || (what == "lsp" && s.rel == "packages/loam/src/lsp.c")
        if take {
            push(out, s.obj)
        }
    }
    return out
}

/** *Recompile every object that is missing or older than its source. `full` */
/** *rebuilds all of them (a header or the flags changed). */
fn compile_stale(srcs: []CSrc, full: bool) -> bool {
    for i in 0..srcs.len {
        let s = srcs[i]
        let mut need = full
        if !need {
            if sys.exists(s.obj) == 0 {
                need = true
            } else if is_newer(s.full, s.obj) {
                need = true
            }
        }
        if need {
            fmt.println("  cc  {{rel_of(s.full)}}")
            sys.exec("cd {{shq(ROOT)}} && cc {{cflags()}} -c {{shq(s.rel)}} -o {{shq(rel_of(s.obj))}}")
            if sys.exec_status() != 0 {
                fmt.println("nob: cc failed: {{rel_of(s.full)}}")
                return false
            }
            CHANGED = true
        }
    }
    return true
}

fn link(objs: []string, out: string) -> bool {
    fmt.println("  cc  {{shq(rel_of(out))}}")
    sys.exec("cd {{shq(ROOT)}} && cc {{cflags()}} {{quoted_list(objs)}} -o {{shq(rel_of(out))}}")
    if sys.exec_status() != 0 {
        fmt.println("nob: link failed: {{rel_of(out)}}")
        return false
    }
    return true
}

/** *`all` builds every binary; `lsp` stops after the language server. */
fn build(what: string) -> int {
    sys.mkdir(OBJ)
    sys.mkdir("{{OBJ}}/sema")
    sys.mkdir(BIN)

    let srcs = c_sources()
    let mut ref = "{{BIN}}/loamc"
    if what == "lsp" {
        ref = "{{BIN}}/loam-lsp"
    }

    // A full rebuild is needed when the reference binary is missing, when the
    // flags changed since the last build, or when any header is newer than that
    // build. Not newer than `ref`: the seed build links bin/loamc first, which
    // would hide the header and leave objects built against the old layout.
    let mut full = false
    let stamp = "{{OBJ}}/.cflags"
    if sys.read_file(stamp) != cflags() {
        full = true
    } else if sys.exists(ref) == 0 {
        full = true
    } else {
        let newer = sys.exec("cd {{shq(ROOT)}} && find packages/loam/src -name '*.h' -newer {{shq(rel_of(stamp))}} -print -quit")
        if trim(newer) != "" {
            full = true
        }
    }

    CHANGED = false
    if !compile_stale(srcs, full) {
        return 1
    }
    sys.write_file(stamp, cflags())

    if what == "lsp" {
        if CHANGED || sys.exists("{{BIN}}/loam-lsp") == 0 {
            if !link(objs_of(srcs, "lsp"), "{{BIN}}/loam-lsp") {
                return 1
            }
        }
        return 0
    }

    if CHANGED || sys.exists("{{BIN}}/loamc") == 0 {
        if !link(objs_of(srcs, "loamc"), "{{BIN}}/loamc") {
            return 1
        }
    }
    if CHANGED || sys.exists("{{BIN}}/loam-lsp") == 0 {
        if !link(objs_of(srcs, "lsp"), "{{BIN}}/loam-lsp") {
            return 1
        }
    }

    // `loam-fmt` is standalone: its own main and nothing else linked in.
    if sys.exists("{{BIN}}/loam-fmt") == 0 || is_newer("{{SRC}}/fmt.c", "{{BIN}}/loam-fmt") {
        fmt.println("  cc  bin/loam-fmt")
        sys.exec("cd {{shq(ROOT)}} && cc {{cflags()}} packages/loam/src/fmt.c -o bin/loam-fmt")
        if sys.exec_status() != 0 {
            fmt.println("nob: cc failed: bin/loam-fmt")
            return 1
        }
    }

    // `zeli` is a Loam program built by the compiler above it in this file.
    if sys.exists("{{BIN}}/zeli") == 0 || is_newer("{{BIN}}/loamc", "{{BIN}}/zeli") || is_newer("{{ROOT}}/packages/zeus/cli/zeli.loam", "{{BIN}}/zeli") || is_newer("{{ROOT}}/packages/zeus/cli/chunks.loam", "{{BIN}}/zeli") {
        fmt.println("  loamc packages/zeus/cli/zeli.loam -> bin/zeli")
        sys.exec("cd {{shq(ROOT)}} && ./bin/loamc packages/zeus/cli/zeli.loam -o bin/zeli")
        if sys.exec_status() != 0 {
            fmt.println("nob: zeli build failed")
            return 1
        }
    }
    return 0
}

// --- the test plan -------------------------------------------------------

/** *One fixture case. `kind` selects the shell body `body` generates; `desc` is */
/** *what the suite prints (a file, or a golden's stem). `bin` is the batch binary */
/** *that holds this fixture as `case_id`; "" means it is compiled on its own. */
struct Job {
    kind: string,
    src: string,
    out: string,
    want: string,
    desc: string,
    bin: string,
    case_id: int,
}

fn run_job(src: string, out: string) -> Job {
    return Job { kind: "run", src: src, out: out, want: "", desc: rel_of(src), bin: "", case_id: 0 }
}

fn reject_job(src: string, out: string) -> Job {
    return Job { kind: "reject", src: src, out: out, want: "", desc: rel_of(src), bin: "", case_id: 0 }
}

fn ir_job(src: string, out: string) -> Job {
    return Job { kind: "ir", src: src, out: out, want: "", desc: rel_of(src), bin: "", case_id: 0 }
}

fn irgold_job(src: string, out: string, want: string, desc: string) -> Job {
    return Job { kind: "irgold", src: src, out: out, want: want, desc: desc, bin: "", case_id: 0 }
}

fn draw_job(src: string, out: string, want: string, desc: string) -> Job {
    return Job { kind: "draw", src: src, out: out, want: want, desc: desc, bin: "", case_id: 0 }
}

fn inlang_job(src: string) -> Job {
    return Job { kind: "inlang", src: src, out: "", want: "", desc: rel_of(src), bin: "", case_id: 0 }
}

fn ztests_job(src: string) -> Job {
    return Job { kind: "ztests", src: src, out: "", want: "", desc: rel_of(src), bin: "", case_id: 0 }
}

fn oob_job(src: string, out: string) -> Job {
    return Job { kind: "oob", src: src, out: out, want: "", desc: rel_of(src), bin: "", case_id: 0 }
}

fn argv_job(src: string, out: string, want: string) -> Job {
    return Job { kind: "argv", src: src, out: out, want: want, desc: rel_of(src), bin: "", case_id: 0 }
}

fn fs_job(src: string, out: string, want: string) -> Job {
    return Job { kind: "fs", src: src, out: out, want: want, desc: rel_of(src), bin: "", case_id: 0 }
}

fn watch_job(src: string, out: string) -> Job {
    return Job { kind: "watch", src: src, out: out, want: "", desc: rel_of(src), bin: "", case_id: 0 }
}

fn missing_job(desc: string) -> Job {
    return Job { kind: "missing", src: "", out: "", want: "", desc: desc, bin: "", case_id: 0 }
}

/** *A named integration stanza, run as a child `nob` alongside the fixture cases. */
fn stanza_job(name: string) -> Job {
    return Job { kind: "stanza", src: "", out: "", want: "", desc: name, bin: "", case_id: 0 }
}

/** *Compile `j` for a case, or nothing when a batch binary already holds it. */
fn build_of(j: Job, id: string) -> string {
    if j.bin != "" {
        return "true"
    }
    return "{{shq(LOAMC)}} {{shq(j.src)}} -o {{shq(j.out)}} >\"$RES/{{id}}.build\" 2>&1"
}

/** *The command that runs `j`'s program. */
fn exe_of(j: Job) -> string {
    if j.bin != "" {
        return "LOAM_CASE={{j.case_id}} {{shq(j.bin)}}"
    }
    return shq(j.out)
}

/** *`j` as a case compiled on its own. */
fn alone(j: Job) -> Job {
    return Job { kind: j.kind, src: j.src, out: j.out, want: j.want, desc: j.desc, bin: "", case_id: 0 }
}

/** *The whole case. A failure inside a batch is not yet a verdict, since the */
/** *fixture has been built beside hundreds of others: it reruns alone, as */
/** *`--isolated` would, which also reports a compile error in its plain form. */
fn case_body(j: Job, id: string) -> string {
    if j.bin == "" {
        return body(j, id)
    }
    let mut s = body(j, id)
    s = cat(s, "if [ \"$st\" != 0 ]; then\n  echo \"warn batch: {{j.desc}} failed batched, retrying alone\"\n")
    s = cat(s, body(alone(j), id))
    return cat(s, "fi\n")
}

/** *The shell a case runs. Every branch sets `st` to 0 or 1; `pool` writes it to */
/** *the status file and the case exits with it. Output goes to `$RES/<id>.log`. */
fn body(j: Job, id: string) -> string {
    if j.kind == "run" && j.want != "" {
        return "if ! {{build_of(j, id)}}; then\n  echo \"FAIL compile {{j.desc}}\"\n  cat \"$RES/{{id}}.build\"\n  st=1\nelif ! {{exe_of(j)}} >\"$RES/{{id}}.out\" 2>/dev/null; then\n  echo \"FAIL run {{j.desc}}\"\n  st=1\nelif ! diff -u {{shq(j.want)}} \"$RES/{{id}}.out\" >\"$RES/{{id}}.diff\" 2>&1; then\n  echo \"FAIL output {{j.desc}} (differs from .expected)\"\n  cat \"$RES/{{id}}.diff\"\n  st=1\nelse\n  echo \"ok   {{j.desc}}\"\n  st=0\nfi\n"
    }
    if j.kind == "run" {
        return "if {{build_of(j, id)}}; then\n  if {{exe_of(j)}} >/dev/null 2>&1; then\n    echo \"ok   {{j.desc}}\"\n    st=0\n  else\n    echo \"FAIL run {{j.desc}}\"\n    st=1\n  fi\nelse\n  echo \"FAIL compile {{j.desc}}\"\n  cat \"$RES/{{id}}.build\"\n  st=1\nfi\n"
    }
    if j.kind == "reject" {
        return "if {{shq(LOAMC)}} {{shq(j.src)}} -o {{shq(j.out)}} >\"$RES/{{id}}.build\" 2>&1; then\n  echo \"FAIL should-reject {{j.desc}}\"\n  st=1\nelse\n  echo \"ok   {{j.desc}} (rejected)\"\n  st=0\nfi\n"
    }
    if j.kind == "ir" {
        return "if {{shq(LOAMC)}} --emit-ir {{shq(j.src)}} -o {{shq(j.out)}} >\"$RES/{{id}}.build\" 2>&1; then\n  st=0\n  if grep -q PARTIAL {{shq(j.out)}}; then\n    echo \"warn ir {{j.desc}} (partial lowering)\"\n  fi\nelse\n  echo \"FAIL ir {{j.desc}}\"\n  cat \"$RES/{{id}}.build\"\n  st=1\nfi\n"
    }
    if j.kind == "irgold" {
        return "if ! {{shq(LOAMC)}} --emit-ir {{shq(j.src)}} -o {{shq(j.out)}} >\"$RES/{{id}}.build\" 2>&1; then\n  echo \"FAIL ir golden emit {{j.desc}}\"\n  cat \"$RES/{{id}}.build\"\n  st=1\nelif ! diff -u {{shq(j.want)}} {{shq(j.out)}} >\"$RES/{{id}}.diff\" 2>&1; then\n  echo \"FAIL ir golden {{j.desc}}\"\n  cat \"$RES/{{id}}.diff\"\n  st=1\nelse\n  echo \"ok   ir golden {{j.desc}}\"\n  st=0\nfi\n"
    }
    if j.kind == "draw" {
        return "if ! {{build_of(j, id)}}; then\n  echo \"FAIL compile {{rel_of(j.src)}}\"\n  cat \"$RES/{{id}}.build\"\n  st=1\nelif ! {{exe_of(j)}} >\"$RES/{{id}}.out\" 2>&1; then\n  echo \"FAIL run {{rel_of(j.src)}}\"\n  st=1\nelif ! diff -u {{shq(j.want)}} \"$RES/{{id}}.out\" >\"$RES/{{id}}.diff\" 2>&1; then\n  echo \"FAIL draw golden {{j.desc}}\"\n  cat \"$RES/{{id}}.diff\"\n  st=1\nelse\n  echo \"ok   draw golden {{j.desc}}\"\n  st=0\nfi\n"
    }
    if j.kind == "inlang" {
        return "if {{shq(LOAMC)}} test {{shq(j.src)}} >\"$RES/{{id}}.build\" 2>&1; then\n  echo \"ok   in-language {{j.desc}}\"\n  st=0\nelse\n  echo \"FAIL in-language tests {{j.desc}}\"\n  cat \"$RES/{{id}}.build\"\n  st=1\nfi\n"
    }
    if j.kind == "ztests" {
        return "if {{shq(LOAMC)}} test {{shq(j.src)}} >\"$RES/{{id}}.build\" 2>&1; then\n  echo \"ok   in-language {{j.desc}}\"\n  st=0\nelse\n  echo \"FAIL in-language {{j.desc}}\"\n  cat \"$RES/{{id}}.build\"\n  st=1\nfi\n"
    }
    if j.kind == "oob" {
        return "if ! {{build_of(j, id)}}; then\n  echo \"FAIL compile {{rel_of(j.src)}}\"\n  cat \"$RES/{{id}}.build\"\n  st=1\nelif {{exe_of(j)}} >\"$RES/{{id}}.out\" 2>\"$RES/{{id}}.err\"; then\n  echo \"FAIL should-trap {{rel_of(j.src)}}\"\n  st=1\nelif ! grep -q \"index out of bounds\" \"$RES/{{id}}.err\"; then\n  echo \"FAIL trap message {{rel_of(j.src)}}\"\n  cat \"$RES/{{id}}.err\"\n  st=1\nelse\n  echo \"ok   {{rel_of(j.src)}} (trapped)\"\n  st=0\nfi\n"
    }
    if j.kind == "argv" {
        return "if ! {{build_of(j, id)}}; then\n  echo \"FAIL argv (compile)\"\n  cat \"$RES/{{id}}.build\"\n  st=1\nelif ! {{exe_of(j)}} alpha \"beta gamma\" >\"$RES/{{id}}.out\" 2>&1; then\n  echo \"FAIL argv (run)\"\n  st=1\nelif ! diff -u {{shq(j.want)}} \"$RES/{{id}}.out\" >\"$RES/{{id}}.diff\" 2>&1; then\n  echo \"FAIL argv (output)\"\n  cat \"$RES/{{id}}.diff\"\n  st=1\nelse\n  echo \"ok   sys args (argc / arg / args, spaces preserved)\"\n  st=0\nfi\n"
    }
    if j.kind == "fs" {
        return "if ! {{build_of(j, id)}}; then\n  echo \"FAIL fs (compile)\"\n  cat \"$RES/{{id}}.build\"\n  st=1\nelif ! {{exe_of(j)}} {{shq(TMP)}}/fsscratch >\"$RES/{{id}}.out\" 2>&1; then\n  echo \"FAIL fs (run)\"\n  st=1\nelif ! diff -u {{shq(j.want)}} \"$RES/{{id}}.out\" >\"$RES/{{id}}.diff\" 2>&1; then\n  echo \"FAIL fs (output)\"\n  cat \"$RES/{{id}}.diff\"\n  st=1\nelse\n  echo \"ok   sys filesystem (exists / is_dir / list_dir / remove_path)\"\n  st=0\nfi\n"
    }
    if j.kind == "watch" {
        return "if ! {{build_of(j, id)}}; then\n  echo \"FAIL sys watcher (compile)\"\n  cat \"$RES/{{id}}.build\"\n  st=1\nelse\n  {{exe_of(j)}} {{shq(TMP)}}/watchscratch >\"$RES/{{id}}.out\" 2>&1\n  wstat=$?\n  if grep -q 'no kernel watcher on this host' \"$RES/{{id}}.out\"; then\n    echo \"skip sys watcher (no kernel watcher on this host)\"\n    st=0\n  elif [ $wstat -ne 0 ]; then\n    echo \"FAIL sys watcher (exit $wstat)\"\n    cat \"$RES/{{id}}.out\"\n    st=1\n  elif ! grep -q '^  hit .*existing[.]loam$' \"$RES/{{id}}.out\"; then\n    echo \"FAIL sys watcher (an in-place edit did not wake it)\"\n    cat \"$RES/{{id}}.out\"\n    st=1\n  elif ! grep -q '^  hit .*new[.]loam$' \"$RES/{{id}}.out\"; then\n    echo \"FAIL sys watcher (a new file did not wake it)\"\n    cat \"$RES/{{id}}.out\"\n    st=1\n  elif ! grep -q '^  (none)$' \"$RES/{{id}}.out\"; then\n    echo \"FAIL sys watcher (a write outside the watch set woke it)\"\n    cat \"$RES/{{id}}.out\"\n    st=1\n  elif grep -qE '/build/|/[.]zeus/' \"$RES/{{id}}.out\"; then\n    echo \"FAIL sys watcher (build output or the cache woke it)\"\n    cat \"$RES/{{id}}.out\"\n    st=1\n  else\n    echo \"ok   sys watcher (in-place edit, new file, build output ignored)\"\n    st=0\n  fi\nfi\n"
    }
    if j.kind == "stanza" {
        let self = join(BIN, "nob")
        return "{{shq(self)}} integration {{j.desc}}\nst=$?\n"
    }
    if j.kind == "missing" {
        return "echo \"FAIL ir golden missing source {{j.desc}}\"\nst=1\n"
    }
    return "echo \"FAIL unknown job kind {{j.kind}}\"\nst=1\n"
}

/** *Run `jobs` as a bounded pool: `xargs -P JOBS` over one small script per case, */
/** *each of which redirects to its own log and records its status. Separate files */
/** *because `sh` parses a whole script to run any line of it, and a suite's worth */
/** *of cases in one script costs more to parse than most of them cost to run. */
fn pool(suite: string, jobs: []Job) -> int {
    let n = jobs.len
    if n == 0 {
        return 0
    }
    let res = "{{NOB}}/{{suite}}"
    let idxf = "{{NOB}}/{{suite}}.idx"
    let outlog = "{{NOB}}/{{suite}}.out"
    sys.remove_path(res)
    sys.mkdir(res)

    let mut ids = []int {}
    for i in 0..n {
        let id = pad4(i)
        let mut s = "#!/bin/sh\nRES={{shq(res)}}\n{\n"
        s = cat(s, case_body(jobs[i], id))
        s = cat(s, "echo \"$st\" >\"$RES/{{id}}.status\"\n} >\"$RES/{{id}}.log\" 2>&1\ncat \"$RES/{{id}}.log\" >&2\n")
        sys.write_file("{{res}}/{{id}}.sh", s)
        let line = "{{res}}/{{id}}.sh\n"
        for k in 0..line.len {
            push(ids, line[k])
        }
    }
    sys.write_file(idxf, string_from_bytes(ids))

    // Each case prints its result to stderr as it finishes, so a run shows
    // every file immediately instead of a silent suite followed by a dump.
    // stdout is kept only for anything xargs itself prints.
    let t0 = now_s()
    sys.exec("cd {{shq(ROOT)}} && { echo \"nob: {{suite}} — {{n}} check(s), -j {{JOBS}}\" >&2; ZEUS_HEADLESS=1 MAYA_HEADLESS=1 xargs -P {{JOBS}} -n 1 sh < {{shq(idxf)}} >{{shq(outlog)}}; }")
    let el = now_s() - t0
    sys.exec("echo 'nob: {{suite}} done in {{el}}s' >&2")

    let mut failed = 0
    for i in 0..n {
        let id = pad4(i)
        let st = trim(sys.read_file("{{res}}/{{id}}.status"))
        let log = sys.read_file("{{res}}/{{id}}.log")
        N_RETRIED += count_of(log, "warn batch: ")
        if jobs[i].kind == "stanza" {
            // A stanza is several checks: count its own ok lines.
            N_PASS += lines_with(log, "ok   ").len
            if st != "0" {
                failed += 1
                N_FAIL += 1
                push(FAILURES, "stanza {{jobs[i].desc}}")
            }
        } else if st != "0" {
            failed += 1
            N_FAIL += 1
            push(FAILURES, jobs[i].desc)
        } else {
            N_PASS += 1
        }
    }
    return failed
}

// --- the suites ----------------------------------------------------------

fn pass_files() -> []string {
    return list_loam("{{TESTS}}/compile_pass")
}

/** *The examples the suite compiles: the golden programs, the language demos */
/** *(minus the trap fixture, and minus raygui when raylib is absent), and the */
/** *Zeus apps whose entry point is named after their directory. */
fn example_files() -> []string {
    let mut files = []string {}
    let g = list_loam("{{TESTS}}/golden")
    for i in 0..g.len {
        push(files, g[i])
    }
    let have_raylib = pkg_exists("raylib")
    let lang = list_loam("{{ROOT}}/examples/language")
    for i in 0..lang.len {
        let b = base(lang[i])
        if b == "oob.loam" {
            continue
        }
        if b == "raygui.loam" && !have_raylib {
            continue
        }
        push(files, lang[i])
    }
    let z = zeus_apps()
    for i in 0..z.len {
        push(files, z[i])
    }
    return sorted(files)
}

fn pass_jobs() -> []Job {
    let mut out = []Job {}
    let fs = pass_files()
    for i in 0..fs.len {
        if job_kept(fs[i]) != 0 {
            let mut j = run_job(fs[i], "{{TMP}}/{{stem_of(fs[i])}}")
            // `<name>.expected` beside a fixture is its stdout, byte for byte.
            let want = "{{drop_last(fs[i], 5)}}.expected"
            if sys.exists(want) != 0 {
                j.want = want
            }
            push(out, j)
        }
    }
    return out
}

/** *`nob test <filter>` keeps only the fixtures whose path contains `ONLY`. */
fn job_kept(src: string) -> int {
    if ONLY == "" {
        return 1
    }
    if contains_str(src, ONLY) { return 1 }
    return 0
}

fn keep_jobs(js: []Job) -> []Job {
    if ONLY == "" {
        return js
    }
    let mut out = []Job {}
    for i in 0..js.len {
        if contains_str(js[i].src, ONLY) {
            push(out, js[i])
        }
    }
    return out
}

fn fail_jobs() -> []Job {
    let mut out = []Job {}
    let fs = list_loam("{{TESTS}}/compile_fail")
    for i in 0..fs.len {
        push(out, reject_job(fs[i], "{{TMP}}/{{stem_of(fs[i])}}"))
    }
    return out
}

fn example_jobs() -> []Job {
    let mut out = []Job {}
    let fs = example_files()
    for i in 0..fs.len {
        push(out, run_job(fs[i], "{{EXB}}/{{stem_of(fs[i])}}"))
    }
    return out
}

fn ir_jobs() -> []Job {
    let mut out = []Job {}
    let pf = pass_files()
    for i in 0..pf.len {
        push(out, ir_job(pf[i], "{{TMP}}/ir_{{stem_of(pf[i])}}.ir"))
    }
    let ef = example_files()
    for i in 0..ef.len {
        push(out, ir_job(ef[i], "{{TMP}}/ir_{{stem_of(ef[i])}}.ir"))
    }
    return out
}

fn irgolden_jobs() -> []Job {
    let mut out = []Job {}
    let dir = "{{TESTS}}/ir_golden"
    if sys.is_dir(dir) == 0 {
        return out
    }
    let gs = list_ext(dir, ".ir")
    for i in 0..gs.len {
        let g = gs[i]
        let stem = drop_last(base(g), 3)
        let mut src = "{{TESTS}}/compile_pass/{{stem}}.loam"
        if sys.exists(src) == 0 {
            src = "{{TESTS}}/golden/{{stem}}.loam"
        }
        if sys.exists(src) == 0 {
            push(out, missing_job(stem))
        } else {
            push(out, irgold_job(src, "{{TMP}}/golden_{{stem}}.ir", g, stem))
        }
    }
    return out
}

fn draw_jobs() -> []Job {
    let mut out = []Job {}
    let fs = list_loam("{{TESTS}}/draw_golden")
    for i in 0..fs.len {
        let stem = stem_of(fs[i])
        push(out, draw_job(fs[i], "{{TMP}}/dg_{{stem}}", "{{TESTS}}/draw_golden/{{stem}}.txt", stem))
    }
    return out
}

fn oob_jobs() -> []Job {
    let mut out = []Job {}
    push(out, oob_job("{{ROOT}}/examples/language/oob.loam", "{{EXB}}/oob"))
    return out
}

fn argv_jobs() -> []Job {
    let mut out = []Job {}
    push(out, argv_job("{{TESTS}}/argv/args.loam", "{{TMP}}/argv_args", "{{TESTS}}/argv/args.txt"))
    return out
}

fn fs_jobs() -> []Job {
    let mut out = []Job {}
    push(out, fs_job("{{TESTS}}/fs/fs.loam", "{{TMP}}/fs_probe", "{{TESTS}}/fs/fs.txt"))
    return out
}

fn watch_jobs() -> []Job {
    let mut out = []Job {}
    push(out, watch_job("{{TESTS}}/watch/watch.loam", "{{TMP}}/watch_probe"))
    return out
}

fn inlang_jobs() -> []Job {
    let mut out = []Job {}
    let fs = list_loam("{{TESTS}}/inlang")
    for i in 0..fs.len {
        push(out, inlang_job(fs[i]))
    }
    return out
}

fn ztests_jobs() -> []Job {
    let mut out = []Job {}
    let fs = list_loam("{{ROOT}}/packages/zeus/cli")
    for i in 0..fs.len {
        if ends_with(base(fs[i]), "_tests.loam") {
            push(out, ztests_job(fs[i]))
        }
    }
    return out
}

// --- commands ------------------------------------------------------------

/** *Regenerate the git-ignored fixtures tests import: the route tables of the */
/** *example apps that do not commit theirs (draw goldens import them) and */
/** *pkg_app's vendored tree (the modules stanza). Runs once, before any pool, */
/** *so a fresh checkout passes and stale local copies never mask a change. */
fn gen_fixtures() -> int {
    let l = tmpf("gen_fixtures.log")
    let script = cat(
        "cd {{shq(ROOT)}} && for d in examples/zeus/*/; do [ -d \"$d/routes\" ] && git check-ignore -q \"$d/app_routes.loam\" || continue; ",
        cat("{{shq(ZELI)}} routes \"$d\" || exit 1; done && ",
            "{{shq(ZELI)}} pkg sync packages/loam/tests/pkg_app"))
    sys.exec("{ {{script}}; } > {{shq(l)}} 2>&1")
    if sys.exec_status() != 0 {
        fmt.println("nob: generating ignored fixtures failed")
        catlog(l)
        return 1
    }
    return 0
}

fn test() -> int {
    sys.mkdir(TMP)
    sys.mkdir(EXB)
    sys.mkdir(NOB)
    if build("all") != 0 {
        fmt.println("nob: build failed; tests not run")
        return 1
    }
    if gen_fixtures() != 0 {
        return 1
    }
    N_PASS = 0
    N_FAIL = 0
    FAILURES = []string {}
    let t0 = now_s()
    TSTART = t0
    let mut failed = 0

    if ONLY_FILE != "" {
        // A single file: compile and run it, and show its own output and any
        // compiler/link error, rather than the pool's one-line verdict.
        let bin = "{{TMP}}/{{stem_of(ONLY_FILE)}}"
        let blog = "{{NOB}}/file.build"
        let rlog = "{{NOB}}/file.run"
        if !sh("{{shq(LOAMC)}} {{shq(ONLY_FILE)}} -o {{shq(bin)}} > {{shq(blog)}} 2>&1") {
            fmt.println("FAIL compile {{ONLY_FILE}}")
            catlog(blog)
            sys.exit(1)
        }
        let ok = sh("{{shq(bin)}} > {{shq(rlog)}} 2>&1")
        catlog(rlog)
        if !ok {
            fmt.println("FAIL run {{ONLY_FILE}}")
            sys.exit(1)
        }
        fmt.println("ok   {{ONLY_FILE}}")
        sys.exit(0)
    }

    if ONLY == "" && !ISOLATED {
        return test_batched(t0)
    }

    fmt.println("nob: test — language suites + host checks, isolated (-j {{JOBS}})")

    // Every fixture as its own binary; each suite is a bounded pool.
    let pj = pass_jobs()
    failed += pool("pass", pj)
    let fj = keep_jobs(fail_jobs())
    failed += pool("fail", fj)
    let ej = keep_jobs(example_jobs())
    failed += pool("examples", ej)
    let oj = keep_jobs(oob_jobs())
    failed += pool("oob", oj)
    let ij = keep_jobs(ir_jobs())
    failed += pool("ir", ij)
    fmt.println("ok   ir lowering + verify")
    let igj = keep_jobs(irgolden_jobs())
    failed += pool("irgolden", igj)
    let dj = keep_jobs(draw_jobs())
    failed += pool("draw", dj)
    let aj = keep_jobs(argv_jobs())
    failed += pool("argv", aj)
    let fsj = keep_jobs(fs_jobs())
    failed += pool("fs", fsj)
    let wj = keep_jobs(watch_jobs())
    failed += pool("watch", wj)
    let ilj = keep_jobs(inlang_jobs())
    failed += pool("inlang", ilj)
    let ztj = keep_jobs(ztests_jobs())
    failed += pool("ztests", ztj)

    // Host checks (wasm entry points, server split, LSP). The `zeli` suite is
    // deliberately not part of `test`: run `nob integration` for it. Skipped for
    // a filtered run, since they are whole-program checks with no fixture path.
    if ONLY == "" {
        failed += host_checks()
    }
    return report(t0, failed)
}

// --- batched runs --------------------------------------------------------

/** *Which batch `src` builds in. The two batches exist because a program's imports */
/** *choose its link line and build flags, so a fixture without Zeus should not get */
/** *them from a neighbour. "alone" is for what cannot share a program at all: maya */
/** *and raygui take over the link, and an app with a `runtime/` directory has C */
/** *seams the driver only finds beside its entry file. */
fn class_of(src: string) -> string {
    let text = sys.read_file(src)
    if contains_str(text, "\"std:maya\"") || contains_str(text, "import \"maya\"") || contains_str(text, "\"std:raygui\"") || contains_str(text, "import \"raygui\"") {
        return "alone"
    }
    if sys.is_dir(join(dir_of(src), "runtime")) == 1 {
        return "alone"
    }
    if contains_str(src, "/examples/zeus/") || contains_str(text, "import \"../") {
        return "zeus"
    }
    let zeus = []string { "\"std:zeus", "\"std:zui", "\"zeus:", "\"std:router", "\"std:colors", "\"std:devtools", "\"zeus\"", "\"zui\"", "\"zui:", "\"zeus-components" }
    for i in 0..zeus.len {
        if contains_str(text, zeus[i]) {
            return "zeus"
        }
    }
    return "plain"
}

fn has_str(v: []string, x: string) -> bool {
    for i in 0..v.len {
        if v[i] == x {
            return true
        }
    }
    return false
}

fn index_of(v: []string, x: string) -> int {
    for i in 0..v.len {
        if v[i] == x {
            return i
        }
    }
    return -1
}

fn suite_path(class: string, ext: string) -> string {
    return "{{NOB}}/suite_{{class}}{{ext}}"
}

fn unlines(v: []string) -> string {
    let mut b = []int {}
    for i in 0..v.len {
        let l = v[i]
        for k in 0..l.len {
            push(b, l[k])
        }
        push(b, 10)
    }
    return string_from_bytes(b)
}

/** *The program that holds `files`: each is imported as `case<N>`, and `LOAM_CASE` */
/** *picks the one whose `main` this process runs. */
fn suite_source(files: []string) -> string {
    let mut lines = []string { "import \"std:sys\"" }
    for i in 0..files.len {
        push(lines, "import \"{{files[i]}}\" as case{{i}}")
    }
    push(lines, "fn main() {")
    push(lines, "    let c = sys.env(\"LOAM_CASE\")")
    for i in 0..files.len {
        push(lines, "    if c == \"{{i}}\" { case{{i}}.main() }")
    }
    push(lines, "}")
    return unlines(lines)
}

/** *A case its batch binary can judge itself: exit status, plus a golden for a */
/** *draw. The rest need arguments or read their output in ways only a script does. */
fn servable(j: Job) -> bool {
    return j.kind == "run" || j.kind == "draw"
}

fn serve_label(j: Job) -> string {
    if j.kind == "draw" {
        return "draw golden {{j.desc}}"
    }
    return j.desc
}

fn split_tabs(s: string) -> []string {
    let mut out = []string {}
    let mut start = 0
    for i in 0..s.len {
        if s[i] == 9 {
            push(out, slice(s, start, i))
            start = i + 1
        }
    }
    push(out, slice(s, start, s.len))
    return out
}

/** *Have the suite binary fork its own cases. The runner reports what passed; a */
/** *case it does not report reruns as a script, so nothing here decides a failure. */
fn serve_suite(class: string, files: []string) {
    let dir = suite_path(class, "_serve")
    reset_dir(dir)
    mkdirp(dir)
    let jobs = split_lines(sys.read_file(suite_path(class, ".jobs")))
    let mut lines = []string {}
    for i in 0..jobs.len {
        let f = split_tabs(jobs[i])
        let at = index_of(files, f[1])
        if at >= 0 {
            push(lines, "{{at}}\t{{f[0]}}\t{{f[2]}}\t{{f[3]}}")
        }
    }
    let manifest = join(dir, "manifest")
    sys.write_file(manifest, unlines(lines))
    let bin = suite_path(class, "")
    sh("LOAM_SERVE={{shq(manifest)}} LOAM_SERVE_JOBS={{JOBS}} {{shq(bin)}} 1>&2")
}

/** *The fixtures every full run compiles, whichever way it builds them. */
fn program_jobs() -> []Job {
    let mut out = []Job {}
    let groups = [][]Job { pass_jobs(), example_jobs(), oob_jobs(), draw_jobs(), argv_jobs(), fs_jobs(), watch_jobs() }
    for g in 0..groups.len {
        let js = groups[g]
        for i in 0..js.len {
            push(out, js[i])
        }
    }
    return out
}

/** *A full run: build the batches beside everything that needs no fixture binary, */
/** *then run every case. All of it shares one pool, so the wall time is the slowest */
/** *part of each stage rather than the sum of them. */
fn test_batched(t0: int) -> int {
    fmt.println("nob: test — language suites + host checks, batched (-j {{JOBS}})")
    let jobs = program_jobs()
    let mut zeus = []string {}
    let mut plain = []string {}
    // Longest first: `xargs` starts jobs in order, so anything queued behind the
    // hundred quick rejections below would run after them, not beside the build.
    let mut setup = []Job {
        stanza_job("ir_zeus"), stanza_job("wasm_smoke"), stanza_job("wasm_trap"),
        stanza_job("suite_tests"), stanza_job("ir_plain"),
    }
    let hosts = host_stanzas()
    for i in 0..hosts.len {
        if !starts_with(hosts[i], "wasm_") {
            push(setup, stanza_job(hosts[i]))
        }
    }
    let mut lone = []string {}
    for i in 0..jobs.len {
        let src = jobs[i].src
        let class = class_of(src)
        if class == "zeus" {
            if !has_str(zeus, src) {
                push(zeus, src)
            }
        } else if class == "plain" {
            if !has_str(plain, src) {
                push(plain, src)
            }
        } else {
            // It depends on nothing, so it need not wait for the batches.
            push(setup, jobs[i])
            if !has_str(lone, src) {
                push(lone, src)
                push(setup, ir_job(src, "{{TMP}}/ir_{{stem_of(src)}}.ir"))
            }
        }
    }
    let classes = []string { "zeus", "plain" }
    for c in 0..classes.len {
        let class = classes[c]
        let mut files = zeus
        if class == "plain" {
            files = plain
        }
        sys.remove_path(suite_path(class, ".built"))
        sys.remove_path(suite_path(class, "_serve"))
        write_if_changed(suite_path(class, ".loam"), suite_source(files))
        let mut served = []string {}
        for i in 0..jobs.len {
            let j = jobs[i]
            if servable(j) && class_of(j.src) == class {
                push(served, "{{i}}\t{{j.src}}\t{{serve_label(j)}}\t{{j.want}}")
            }
        }
        sys.write_file(suite_path(class, ".jobs"), unlines(served))
    }
    sys.remove_path(suite_path("tests", ".failed"))
    let tests = [][]Job { inlang_jobs(), ztests_jobs() }
    let mut imports = []string {}
    for g in 0..tests.len {
        let js = tests[g]
        for i in 0..js.len {
            push(imports, "import \"{{js[i].src}}\" as t{{g}}_{{i}}")
        }
    }
    write_if_changed(suite_path("tests", ".loam"), unlines(imports))
    let groups = [][]Job { fail_jobs(), irgolden_jobs() }
    for g in 0..groups.len {
        let js = groups[g]
        for i in 0..js.len {
            push(setup, js[i])
        }
    }
    // Compiling the two batches is the long pole, so nothing else runs then.
    // Serving them forks hundreds of cases and overlaps the other checks.
    let heavy = []Job { stanza_job("suite_zeus"), stanza_job("suite_plain") }
    let mut failed = pool("batch", heavy)
    let built_zeus = split_lines(sys.read_file(suite_path("zeus", ".built")))
    let built_plain = split_lines(sys.read_file(suite_path("plain", ".built")))
    // Serving forks one process per fixture. It runs before the other checks
    // so those compilers are not on the machine while the forks are.
    failed += pool("serve", []Job { stanza_job("serve_zeus"), stanza_job("serve_plain") })
    for i in 0..jobs.len {
        let j = jobs[i]
        if servable(j) || has_str(lone, j.src) {
            continue
        }
        push(setup, batched_case(j, built_zeus, built_plain))
    }
    failed += pool("setup", setup)

    // A suite that could not hold a fixture left it out of `.built`, and with no
    // `.built` at all every fixture compiles alone: slower, never wrong. What a
    // suite served and passed is done; the rest goes through a case script.
    let mut done = []bool {}
    for i in 0..jobs.len {
        push(done, false)
    }
    for c in 0..classes.len {
        let dir = suite_path(classes[c], "_serve")
        let ids = split_lines(sys.read_file(join(dir, "passed")))
        for i in 0..ids.len {
            done[int_of(ids[i])] = true
        }
    }
    let mut cases = []Job {}
    if sys.exists(suite_path("tests", ".failed")) == 1 {
        for g in 0..tests.len {
            let js = tests[g]
            for i in 0..js.len {
                push(cases, js[i])
            }
        }
    }
    for i in 0..jobs.len {
        let j = jobs[i]
        if !servable(j) || done[i] || has_str(lone, j.src) {
            continue
        }
        push(cases, batched_case(j, built_zeus, built_plain))
    }
    if cases.len > 0 {
        failed += pool("cases", cases)
    }
    return report(t0, failed)
}

/** *`j` run from its batch binary when that batch kept it, and on its own when not. */
fn batched_case(j: Job, built_zeus: []string, built_plain: []string) -> Job {
    let z = index_of(built_zeus, j.src)
    let p = index_of(built_plain, j.src)
    if z >= 0 {
        return Job { kind: j.kind, src: j.src, out: j.out, want: j.want, desc: j.desc, bin: suite_path("zeus", ""), case_id: z }
    }
    if p >= 0 {
        return Job { kind: j.kind, src: j.src, out: j.out, want: j.want, desc: j.desc, bin: suite_path("plain", ""), case_id: p }
    }
    return j
}

/** *Compile one batch. A fixture the compiler rejects is left out, so it reports */
/** *alone with its own diagnostics and the rest stay batched. Files from a batch */
/** *that fails some other way (a link error names no fixture) all compile alone. */
fn ig_suite(class: string) {
    mark("suite {{class}}")
    let source = suite_path(class, ".loam")
    let mut files = suite_files(source)
    let log = suite_path(class, ".log")
    let bin = suite_path(class, "")
    let shard = tmpf("shard")
    let mut tries = 0
    while tries < 4 {
        tries += 1
        let mut env = "LOAM_BATCH=1"
        if class == "zeus" {
            env = "LOAM_BATCH=1 LOAM_SHARD={{shq(shard)}}"
        }
        if sh("{{env}} {{shq(LOAMC)}} {{shq(source)}} -o {{shq(bin)}} > {{shq(log)}} 2>&1") {
            sys.write_file(suite_path(class, ".built"), unlines(files))
            ok("batch {{class}} ({{files.len}} fixtures, one binary)")
            return
        }
        let text = sys.read_file(log)
        let mut rest = []string {}
        for i in 0..files.len {
            if contains_str(text, "{{files[i]}}:") {
                fmt.println("warn batch: {{rel_of(files[i])}} does not compile in a batch; building it alone")
            } else {
                push(rest, files[i])
            }
        }
        if rest.len == files.len {
            break
        }
        files = rest
        write_if_changed(source, suite_source(files))
    }
    fmt.println("warn batch: {{class}} did not build, so its fixtures compile alone")
    catlog(log)
    N_RETRIED += 1
}

/** *Fork every case the batch binary can judge. A case it does not pass is left */
/** *for the caller to rerun; this stanza does not fail the run on its own. */
fn ig_serve(class: string) {
    mark("serve {{class}}")
    let builtp = suite_path(class, ".built")
    if sys.exists(builtp) == 0 {
        return
    }
    serve_suite(class, split_lines(sys.read_file(builtp)))
}

/** *The files a generated suite imports. */
fn suite_files(source: string) -> []string {
    let mut out = []string {}
    let lines = split_lines(sys.read_file(source))
    let pre = "import \""
    for i in 0..lines.len {
        let l = lines[i]
        let close = " as case"
        if starts_with(l, pre) && contains_str(l, close) {
            let mut e = pre.len
            while l[e] != 34 {
                e += 1
            }
            push(out, slice(l, pre.len, e))
        }
    }
    return out
}

/** *Every `#[test]` file as one test binary, for the same reason as the suites. */
/** *If it fails, `.failed` sends each file to run alone and name its own failure. */
fn ig_suite_tests() {
    mark("suite tests")
    let log = suite_path("tests", ".log")
    let source = suite_path("tests", ".loam")
    let bin = suite_path("tests", "")
    if sh("{{shq(LOAMC)}} test {{shq(source)}} -o {{shq(bin)}} > {{shq(log)}} 2>&1") {
        ok("in-language tests ({{suite_files_tests(source)}} files, one binary)")
        return
    }
    fmt.println("warn batch: in-language tests failed together; running each alone")
    catlog(log)
    N_RETRIED += 1
    sys.write_file(suite_path("tests", ".failed"), "")
}

fn suite_files_tests(source: string) -> int {
    return split_lines(sys.read_file(source)).len
}

/** *Lower and verify every fixture in the batch. This pass is separate from the */
/** *build because the build lowers only what survives dead-code removal, while */
/** *`--emit-ir` covers every function the fixtures and libraries declare. */
fn ig_suite_ir(class: string) {
    mark("ir {{class}}")
    let source = tmpf("nob/suite_{{class}}_ir.loam")
    write_if_changed(source, sys.read_file(suite_path(class, ".loam")))
    let out = suite_path(class, ".ir")
    let log = suite_path(class, ".irlog")
    if !sh("{{shq(LOAMC)}} --emit-ir {{shq(source)}} -o {{shq(out)}} > {{shq(log)}} 2>&1") {
        bad("ir lowering + verify ({{class}})", log)
        return
    }
    if file_has(out, "[PARTIAL]") {
        fmt.println("warn ir {{class}} (partial lowering)")
    }
    ok("ir lowering + verify ({{class}})")
}

/** *Print the run summary and return the exit code. */
fn report(t0: int, failed: int) -> int {
    let secs = now_s() - t0
    fmt.println("")
    if N_RETRIED > 0 {
        fmt.println("note: {{N_RETRIED}} failed batched; see the `warn batch:` lines above")
    }
    if failed != 0 {
        fmt.println("{{N_PASS}} passed, {{N_FAIL}} failed in {{secs}}s — failed:")
        for i in 0..FAILURES.len {
            fmt.println("  FAIL {{FAILURES[i]}}")
        }
        return 1
    }
    fmt.println("{{N_PASS}} passed, {{N_FAIL}} failed in {{secs}}s")
    fmt.println("ALL TESTS PASSED")
    return 0
}

// --- integration checks --------------------------------------------------
//
// The process/port/git-shaped checks: they drive `bin/zeli`, watch processes,
// bind ports, and compare git-tracked output. Control flow is Loam; the shell
// is only used for the one-line primitives (background a process, sleep, kill,
// grep, diff, chmod). Each reports `ok` / `FAIL` lines, and `pool` counts them.

fn mark(name: string) {
    let el = now_s() - TSTART
    sys.exec("echo '[nob] {{name}} (+{{el}}s)' >&2")
}

fn ok(msg: string) {
    fmt.println("ok   {{msg}}")
    N_PASS += 1
}

fn bad(msg: string, log: string) {
    fmt.println("FAIL {{msg}}")
    catlog(log)
    N_FAIL += 1
    push(FAILURES, msg)
}

fn bad2(msg: string, log1: string, log2: string) {
    fmt.println("FAIL {{msg}}")
    catlog(log1)
    catlog(log2)
    N_FAIL += 1
    push(FAILURES, msg)
}

fn skip(msg: string) {
    fmt.println("skip {{msg}}")
}

fn catlog(p: string) {
    if sys.exists(p) == 1 {
        let t = sys.read_file(p)
        if t.len > 0 {
            fmt.write(t)
        }
    }
}

/** *A scratch path under `tests/tmp`. */
fn tmpf(name: string) -> string {
    return "{{TMP}}/{{name}}"
}

/** *Run `cmd` from the repo root; true when it exits 0, headless like every test. */
fn sh(cmd: string) -> bool {
    sys.exec("cd {{shq(ROOT)}} && ZEUS_HEADLESS=1 MAYA_HEADLESS=1 {{cmd}}")
    return sys.exec_status() == 0
}

/** *Run `cmd` from the repo root; its exit code. */
fn rc(cmd: string) -> int {
    sys.exec("cd {{shq(ROOT)}} && ZEUS_HEADLESS=1 MAYA_HEADLESS=1 {{cmd}}")
    return sys.exec_status()
}

fn is_file(p: string) -> bool {
    return sys.exists(p) == 1
}

fn is_exec(p: string) -> bool {
    sys.exec("test -x {{shq(p)}}")
    return sys.exec_status() == 0
}

fn is_nonempty(p: string) -> bool {
    sys.exec("test -s {{shq(p)}}")
    return sys.exec_status() == 0
}

fn file_has(p: string, needle: string) -> bool {
    return contains_str(sys.read_file(p), needle)
}

/** *`grep -qE` over `p`. */
fn file_matches(p: string, re: string) -> bool {
    sys.exec("grep -qE {{shq(re)}} {{shq(p)}} 2>/dev/null")
    return sys.exec_status() == 0
}

fn count_matches(p: string, needle: string) -> int {
    return int_of(trim(sys.exec("grep -c -- {{shq(needle)}} {{shq(p)}} 2>/dev/null")))
}

fn line_count(p: string) -> int {
    if sys.exists(p) == 0 {
        return 0
    }
    return int_of(trim(sys.exec("wc -l < {{shq(p)}} 2>/dev/null")))
}

fn diff_ok(a: string, b: string) -> bool {
    sys.exec("diff -q {{shq(a)}} {{shq(b)}} >/dev/null 2>&1")
    return sys.exec_status() == 0
}

fn diff_log(a: string, b: string, log: string) -> bool {
    sys.exec("diff -u {{shq(a)}} {{shq(b)}} >{{shq(log)}} 2>&1")
    return sys.exec_status() == 0
}

/** *`git diff --exit-code -- p`: git itself is the expectation. The output (the */
/** *diff, or nothing) goes to `log` for the failure branch to print. */
fn git_clean(p: string, log: string) -> bool {
    sys.exec("cd {{shq(ROOT)}} && git --no-optional-locks diff --exit-code -- {{shq(p)}} >{{shq(log)}} 2>&1")
    return sys.exec_status() == 0
}

fn write_text(p: string, body: string) -> bool {
    return sys.write_file(p, body) == 0
}

/** *Leave `p` untouched when it already holds `body`, so a later compile can see */
/** *that this input did not change. */
fn write_if_changed(p: string, body: string) {
    if sys.read_file(p) != body {
        sys.write_file(p, body)
    }
}

fn append_text(p: string, body: string) -> bool {
    return sys.write_file(p, cat(sys.read_file(p), body)) == 0
}

fn mkdirp(p: string) -> bool {
    return sys.mkdir(p) == 0
}

fn rmrf(p: string) -> bool {
    return sys.remove_path(p) == 0
}

/** *Remove a scratch tree, retrying: a leftover `zeli serve` can still be writing */
/** *into it, which makes `rm -rf` fail with "Directory not empty". */
fn reset_dir(p: string) -> bool {
    let mut n = 0
    while n < 6 {
        if rmrf(p) {
            return true
        }
        sys.exec("sleep 0.2")
        n += 1
    }
    return false
}

fn cp(from: string, to: string) -> bool {
    sys.exec("cp {{shq(from)}} {{shq(to)}}")
    return sys.exec_status() == 0
}

fn cpR(from: string, to: string) -> bool {
    sys.exec("cp -R {{shq(from)}} {{shq(to)}}")
    return sys.exec_status() == 0
}

fn chmod(spec: string, p: string) -> bool {
    sys.exec("chmod {{spec}} {{shq(p)}}")
    return sys.exec_status() == 0
}

fn pid_alive(pid: int) -> bool {
    if pid <= 0 {
        return false
    }
    sys.exec("kill -0 {{pid}} 2>/dev/null")
    return sys.exec_status() == 0
}

fn kill_pid(pid: int) {
    if pid <= 0 {
        return
    }
    sys.exec("kill {{pid}} 2>/dev/null")
}

/** *The pid after `needle` in `log`, first or last line that has one. */
fn picked_pid(log: string, needle: string, tail: bool) -> int {
    let mut sel = "head -1"
    if tail {
        sel = "tail -1"
    }
    let o = sys.exec("cd {{shq(ROOT)}} && grep -o '{{needle}}[0-9]*' {{shq(log)}} 2>/dev/null | {{sel}} | grep -o '[0-9]*'")
    return int_of(trim(o))
}

/** *Start `cmd` (absolute paths) as an orphaned background process; its pid. */
/** *The whole group's own stdout is `/dev/null`, so no child can inherit — and */
/** *hold open — the pipe `sys.exec` reads: otherwise this call would not return */
/** *until the server exited, which is the whole stanza. */
fn spawn(cmd: string) -> int {
    let pf = tmpf("spawn.pid")
    rmrf(pf)
    sys.exec("{ ZEUS_HEADLESS=1 MAYA_HEADLESS=1 {{cmd}} & echo $! > {{shq(pf)}}; } >/dev/null 2>&1")
    return int_of(trim(sys.read_file(pf)))
}

// --- the stanzas ---------------------------------------------------------

fn ig_routes_table() {
    mark("zeli routes (routes_app)")
    let l = tmpf("routes_gen.log")
    if !sh("{{shq(ZELI)}} routes packages/loam/tests/routes_app > {{shq(l)}} 2>&1") {
        bad("zeli routes generator", l)
        return
    }
    if !git_clean("packages/loam/tests/routes_app/app_routes.loam", tmpf("routes_diff.log")) {
        bad("zeli routes (the generated table is not what is committed)", tmpf("routes_diff.log"))
        return
    }
    let appbin = tmpf("routes_app")
    let clog = tmpf("routes_compile.log")
    let rlog = tmpf("routes_run.log")
    if !sh("{{shq(LOAMC)}} packages/loam/tests/routes_app/app.loam -o {{shq(appbin)}} > {{shq(clog)}} 2>&1") {
        bad("compile packages/loam/tests/routes_app/app.loam", clog)
        return
    }
    if !sh("{{shq(appbin)}} > {{shq(rlog)}} 2>&1") {
        bad("run packages/loam/tests/routes_app/app.loam", rlog)
        return
    }
    ok("zeli routes (regenerates the committed table, and it runs)")

    mark("zeli build (routes_app, web + macos)")
    let bl = tmpf("zeus_build.log")
    if !sh("{{shq(ZELI)}} build packages/loam/tests/routes_app --targets web,macos > {{shq(bl)}} 2>&1") {
        bad("zeli build", bl)
        return
    }
    let W = "packages/loam/tests/routes_app/build/web"
    if !is_nonempty("{{W}}/app.wasm") || !is_file("packages/loam/tests/routes_app/build/macos/app") {
        bad("zeli build artifacts", bl)
        return
    }
    ok("zeli build (web + macos artifacts)")

    mark("zeus web shell")
    if is_file("{{W}}/index.html") && is_file("{{W}}/blog/index.html") && is_file("{{W}}/blog/hello-world/index.html") && file_has("{{W}}/blog/index.html", "<title>Blog</title>") && file_has("{{W}}/blog/hello-world/index.html", "<title>hello-world</title>") && file_has("{{W}}/sitemap.xml", "/blog/hello-world") && file_has("{{W}}/robots.txt", "User-agent") && count_matches("{{W}}/blog/index.html", "<canvas") == 1 {
        ok("zeus web shell (per-route head + sitemap + robots)")
    } else {
        bad("zeus web shell", "")
    }
}

fn ig_pkg_sync() {
    mark("zeli pkg sync")
    let l = tmpf("pkg_sync.log")
    if !sh("{{shq(ZELI)}} pkg sync packages/loam/tests/pkg_app > {{shq(l)}} 2>&1") {
        bad("zeli pkg sync", l)
        return
    }
    if !git_clean("packages/loam/tests/pkg_app", tmpf("pkg_diff.log")) {
        bad("zeli pkg sync (the vendored tree or the lock is not what is committed)", tmpf("pkg_diff.log"))
        return
    }
    let pkgbin = tmpf("pkg_app")
    let pclog = tmpf("pkg_app.log")
    let prlog = tmpf("pkg_run.log")
    if !sh("{{shq(LOAMC)}} packages/loam/tests/pkg_app/app.loam -o {{shq(pkgbin)}} > {{shq(pclog)}} 2>&1") {
        bad("compile pkg app", pclog)
        return
    }
    if !sh("{{shq(pkgbin)}} > {{shq(prlog)}} 2>&1") {
        bad("run pkg app", prlog)
        return
    }
    ok("zeli pkg sync (vendors, locks, and the import resolves)")
}

fn ig_fmt() {
    mark("loam-fmt")
    let out = tmpf("fmt.out")
    let idem = tmpf("fmt.idem")
    let good = sh("{{shq(FMT)}} packages/loam/tests/fmt/in.loam > {{shq(out)}} 2>&1") && diff_ok("packages/loam/tests/fmt/want.loam", out) && !diff_ok("packages/loam/tests/fmt/in.loam", out) && sh("{{shq(FMT)}} packages/loam/tests/fmt/want.loam > {{shq(idem)}} 2>&1") && diff_ok("packages/loam/tests/fmt/want.loam", idem)
    if good {
        ok("loam-fmt (canonical + idempotent)")
    } else {
        bad("loam-fmt", out)
    }
}

fn ig_fmt_tree() {
    mark("zeli fmt tree")
    let d = tmpf("fmtapp")
    if !reset_dir(d) || !mkdirp("{{d}}/nested/deep") || !mkdirp("{{d}}/build") || !mkdirp("{{d}}/.hidden") {
        bad("zeli fmt (setup)", "")
        return
    }
    cp("packages/loam/tests/fmt/in.loam", "{{d}}/ugly.loam")
    cp("packages/loam/tests/fmt/in.loam", "{{d}}/nested/deep/inner.loam")
    write_text("{{d}}/app_routes.loam", "// Generated by `zeli routes`. Do not edit.\nfn x( ){ }\n")
    write_text("{{d}}/build/skipped.loam", "fn y( ){ }\n")
    write_text("{{d}}/.hidden/dot.loam", "fn z( ){ }\n")
    let zlog = tmpf("fmt_cmd.log")
    let zlog2 = tmpf("fmt_cmd2.log")
    let z1 = rc("{{shq(ZELI)}} fmt {{shq(d)}} > {{shq(zlog)}} 2>&1")
    let z2 = rc("{{shq(ZELI)}} fmt {{shq(d)}} > {{shq(zlog2)}} 2>&1")
    if z1 != 0 || z2 != 0 || !diff_ok("packages/loam/tests/fmt/want.loam", "{{d}}/ugly.loam") || !diff_ok("packages/loam/tests/fmt/want.loam", "{{d}}/nested/deep/inner.loam") {
        bad("zeli fmt (not canonical, or it failed)", zlog)
        return
    }
    if !file_has("{{d}}/app_routes.loam", "fn x( ){ }") {
        bad("zeli fmt (rewrote the generated route table)", "")
        return
    }
    if !file_has("{{d}}/build/skipped.loam", "fn y( ){ }") {
        bad("zeli fmt (rewrote something under build/)", "")
        return
    }
    if !file_has("{{d}}/.hidden/dot.loam", "fn z( ){ }") {
        bad("zeli fmt (rewrote something in a dotted directory)", "")
        return
    }
    if !file_has(tmpf("fmt_cmd2.log"), "0 formatted") {
        bad("zeli fmt (the second run is not a no-op)", tmpf("fmt_cmd2.log"))
        return
    }
    ok("zeli fmt (a tree: canonical, idempotent, generated and build output untouched)")
}

fn ig_myapp_routes() {
    mark("zeli routes (myapp)")
    let l = tmpf("myapp_routes_gen.log")
    if !sh("{{shq(ZELI)}} routes examples/zeus/myapp > {{shq(l)}} 2>&1") {
        bad("zeli routes (myapp)", l)
        return
    }
    if !git_clean("examples/zeus/myapp/app_routes.loam", tmpf("myapp_routes_diff.log")) {
        bad("zeli routes (myapp's table is not what is committed)", tmpf("myapp_routes_diff.log"))
        return
    }
    ok("zeli routes (myapp: groups, params, meta and paths)")
}

fn ig_new() {
    mark("zeli new")
    let d = tmpf("newapp")
    let empty = "{{d}}/empty"
    if !reset_dir(d) || !mkdirp(empty) {
        bad("zeli new (setup)", "")
        return
    }
    let l = tmpf("newapp.log")
    if !sh("{{shq(ZELI)}} new my-app {{shq(empty)}} > {{shq(l)}} 2>&1") {
        bad("zeli new", l)
        return
    }
    // The old byte-for-byte golden froze imports, padding, and targets that
    // `zeli new` no longer writes. The scaffold still has to come out runnable.
    if !is_file("{{empty}}/app.loam") || !is_file("{{empty}}/zeus.toml") || !is_file("{{empty}}/routes/page.loam") || !is_file("{{empty}}/app_routes.loam") {
        bad("zeli new (the scaffold is missing its entry)", l)
        return
    }
    let n2 = tmpf("newapp2.log")
    let nstat = rc("{{shq(ZELI)}} new my-app {{shq(empty)}} > {{shq(n2)}} 2>&1")
    if nstat != 2 {
        bad("zeli new (a non-empty target must be refused)", n2)
        return
    }
    if !file_has(n2, "already exists and is not empty") {
        bad("zeli new (the refusal does not say why)", n2)
        return
    }
    let nblog = tmpf("newapp_build.log")
    if !sh("{{shq(LOAMC)}} {{shq(empty)}}/app.loam -o {{shq(d)}}/app > {{shq(nblog)}} 2>&1") {
        bad("zeli new (the scaffold does not compile)", nblog)
        return
    }
    ok("zeli new (writes a scaffold, refuses a non-empty target, compiles)")
}

