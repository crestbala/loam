/** *`#[c]` on a client build: a reachable binding is refused, and one only a */
/** *`#[server]` body calls leaves no C behind, not even from a closure. */
fn ig_c_client() {
    mark("c client")
    let dir = "packages/loam/tests/c_client"
    let c = tmpf("c_client.c")
    let log = tmpf("c_client.log")
    if sh("{{shq(LOAMC)}} --target=wasm32 --emit-c {{dir}}/reachable.loam -o {{shq(c)}} >{{shq(log)}} 2>&1") {
        bad("reachable #[c] accepted on wasm", "")
        return
    }
    if !file_has(log, "C runs only on native builds") {
        bad("reachable #[c] refused without its diagnostic", sys.read_file(log))
        return
    }
    if !sh("{{shq(LOAMC)}} --target=wasm32 --emit-c {{dir}}/server_only.loam -o {{shq(c)}} >{{shq(log)}} 2>&1") {
        bad("server-only #[c] refused on wasm", sys.read_file(log))
        return
    }
    if file_has(c, "c_client_add") {
        bad("server-only #[c] leaked into client build", "")
        return
    }
    let bin = tmpf("c_client")
    if !sh("{{shq(LOAMC)}} {{dir}}/server_only.loam -o {{shq(bin)}} >{{shq(log)}} 2>&1") {
        bad("server-only #[c] failed on native", sys.read_file(log))
        return
    }
    ok("c client (reachable refused, server-only absent)")
}

fn ig_lsp() {
    mark("lsp smoke")
    let o = sys.exec("cd {{shq(ROOT)}} && python3 packages/loam/tests/lsp_smoke.py 2>&1")
    let good = sys.exec_status() == 0
    if o.len > 0 {
        fmt.write(o)
    }
    if good {
        N_PASS += lines_with(o, "ok   ").len
    } else {
        fmt.println("FAIL loam-lsp")
        N_FAIL += 1
        push(FAILURES, "loam-lsp")
    }
}

/** *`--cost` is the Phase 5 measurement, so it gets a check: a program whose */
/** *bounds/overflow traps the compiler can prove redundant must report fewer of */
/** *them (the elision is the language's whole point for speed). The numbers are */
/** *compared, not a golden string, so a diagnostic reformat does not break it. */
fn ig_stale_capture() {
    mark("stale capture")
    let src = "{{TESTS}}/compile_fail/stale_capture.loam"
    let out_c = tmpf("stale_capture.c")
    let o = sys.exec("{{shq(LOAMC)}} --emit-c {{shq(src)}} -o {{shq(out_c)}} 2>&1")
    if sys.exec_status() == 0 {
        bad("stale capture (a write after a copy-capture must fail the build)", o)
        return
    }
    let want = []string { "'name' is assigned after a closure captured it", "'xs' is assigned after", "'n' is assigned after", "'buf' is assigned after" }
    for i in 0..want.len {
        let w = want[i]
        if !contains_str(o, w) {
            bad("stale capture (missing: {{w}})", o)
            return
        }
    }
    if contains_str(o, "'fine'") || contains_str(o, "'own'") || contains_str(o, "'mine'") {
        bad("stale capture (a write before the capture, or to a closure's own copy, was reported)", o)
        return
    }
    if count_of(o, "'name' is assigned") != 1 {
        bad("stale capture (reported more than once per binding)", o)
        return
    }
    ok("stale capture (copy-captured let mut written later, incl. through &mut, is an error)")
}

fn ig_cost() {
    mark("cost report")
    let d = tmpf("cost_probe")
    if !reset_dir(d) || !mkdirp(d) {
        bad("cost report (setup)", "")
        return
    }
    let src = "{{d}}/probe.loam"
    let body = cat(
        "fn main() {\n",
        cat("    let xs = []int { 1, 2, 3, 4, 5 }\n",
            cat("    let mut s = 0\n",
                // The index is proven in range: the loop trap is elided. The
                // body has no dynamic arithmetic, so the only overflow site is
                // the literal sum, which folds — both counts land at 0.
                cat("    for i in 0..xs.len { s = xs[i] }\n",
                    cat("    let a = 1000 + 2000\n", "}\n")))))
    if !write_text(src, body) {
        bad("cost report (setup)", "")
        return
    }
    let o = sys.exec("{{shq(LOAMC)}} --cost {{shq(src)}} 2>&1")
    if sys.exec_status() != 0 {
        bad("cost report (run)", o)
        return
    }
    let bounds = cost_field(o, "bounds checks")
    let traps = cost_field(o, "overflow traps")
    if bounds != 0 {
        bad("cost report (loop index not elided: bounds={{bounds}})", o)
        return
    }
    /* One trap remains: the for-loop's own `i = i + 1` latch, whose operands
       are not literals. The literal `1000 + 2000` folded, so it added none. */
    if traps != 1 {
        bad("cost report (literal arithmetic not elided: traps={{traps}})", o)
        return
    }
    ok("cost report (bounds + overflow elision)")
}

/** *The first integer appearing after `label` in a `--cost` report, or -1 when */
/** *the label is missing. Bytes are compared directly; digits are ASCII. */
fn cost_field(report: string, label: string) -> int {
    let mut i = 0
    while i + label.len <= report.len {
        if same_at(report, i, label) {
            let mut k = i + label.len
            while k < report.len && (report[k] < 48 || report[k] > 57) {
                k = k + 1
            }
            if k >= report.len {
                return -1
            }
            let mut v = 0
            while k < report.len && report[k] >= 48 && report[k] <= 57 {
                v = v * 10 + (report[k] - 48)
                k = k + 1
            }
            return v
        }
        i = i + 1
    }
    return -1
}

/** *True when `s` has `needle` starting at byte `at`. */
fn same_at(s: string, at: int, needle: string) -> bool {
    let mut i = 0
    while i < needle.len {
        if s[at + i] != needle[i] {
            return false
        }
        i = i + 1
    }
    return true
}

/** *Phase 6: one program, five surfaces. The counter and gallery each have a */
/** *per-host entry (`macos` = native, shared by Linux + macOS; `ios`, */
/** *`android`, `frontend` = wasm Canvas2D) that is a **thin stub**: it imports */
/** *the shared `../ui.loam` and calls `ui.start()`, and holds no UI of its own. */
/** *This check pins that shape, so a host cannot drift into a second copy of the */
/** *UI — the whole point of "one UI change shows up on all five". */
fn ig_one_surface() {
    mark("one surface")
    let mut apps = []string {}
    push(apps, "examples/zeus/counter")
    push(apps, "examples/zeus/gallery")
    let mut hosts = []string {}
    push(hosts, "frontend")
    push(hosts, "macos")
    push(hosts, "ios")
    push(hosts, "android")
    let mut badish = ""
    for a in 0..apps.len {
        let root = "{{ROOT}}/{{apps[a]}}"
        if sys.exists("{{root}}/ui.loam") == 0 {
            badish = "{{apps[a]}} has no shared ui.loam"
            break
        }
        for h in 0..hosts.len {
            let p = "{{root}}/{{hosts[h]}}/app.loam"
            if sys.exists(p) == 0 {
                continue
            }
            let src = sys.read_file(p)
            let lines = lines_with(src, "").len
            if lines > 12 {
                badish = "{{apps[a]}}/{{hosts[h]}}/app.loam is {{lines}} lines, not a stub"
                break
            }
            if !contains_str(src, "../ui.loam") {
                badish = "{{apps[a]}}/{{hosts[h]}}/app.loam does not import ../ui.loam"
                break
            }
            if !contains_str(src, "ui.start()") {
                badish = "{{apps[a]}}/{{hosts[h]}}/app.loam does not call ui.start()"
                break
            }
            /* A host stub must not paint. `zeus.App`, `Box`, `Text`, … are the
               UI's job in ui.loam; a widget call here means the UI was copied. */
            if contains_str(src, "zeus.") {
                badish = "{{apps[a]}}/{{hosts[h]}}/app.loam calls zeus.* (UI belongs in ui.loam)"
                break
            }
        }
        if badish != "" {
            break
        }
    }
    if badish != "" {
        bad("one surface ({{badish}})", "")
        return
    }
    ok("one surface (thin host stubs share one ui.loam)")
}

/** *The component-model rule (`packages/zeus/docs/component-model.md` §6.1): */
/** *app code never touches the arena. Elements own `ui_push` / `slot` / `raw_*` */
/** * / `arena.*`; a component returns its tree. Comment lines are ignored. */
fn ig_arena_lint() {
    mark("arena lint")
    let l = tmpf("arena_lint.log")
    // `show` / `show_eq` / … are element-layer visibility hooks: components
    // and apps use `Show(when = …)` or a reactive `Style(display = …)`.
    let re = "(^|[^A-Za-z0-9_])((ui_push|ui_pop|slot|raw_[a-z_]+|show|show_(eq|ne|ge|le))[(]|arena[.]|intern_[a-z]|prop_int|set_prop_[a-z])"
    // A comment line starts with `//` or `/*`, including a doc comment.
    sh("grep -rnE {{shq(re)}} --include='*.loam' --exclude-dir=build --exclude-dir=node_modules examples/zeus www | grep -vE ':[0-9]+:[[:space:]]*(//|/[*])' > {{shq(l)}}")
    if is_nonempty(l) {
        bad("arena lint (app code reaches into the element layer)", l)
        return
    }
    // The library: a function may touch the arena only if it is element layer
    // (an element, a list / match host, a chart internal, a native control).
    // Everything else in these files is a component and must not.
    let lib = "packages/zeus-components/src"
    // Layering: the design system builds on `zeusbase` and `zeus:flow` only.
    // Engine internals (`zeuscore/*`: the arena, the platform seam) are not
    // public API, so no allow-list reaches them.
    let lay = tmpf("arena_lint_layers.log")
    sh("grep -nE '^import \"zeus:zeuscore/|(^|[^A-Za-z0-9_])(arena|platform|geometry)[.]' {{lib}}/*.loam | grep -vE ':[0-9]+:[[:space:]]*(//|/[*])' > {{shq(lay)}}")
    if is_nonempty(lay) {
        bad("arena lint (zeus-components imports or names zeuscore internals)", lay)
        return
    }
    let mut files = []string {}
    let mut allow = []string {}
    push(files, "atoms")
    push(allow, "Progress chart_tooltip ProgressTrack RingArc chart_lines chart_cursor chart_bars chart_areas chart_layer_live Svg Sparkline Scroll Overlay Image Icon Grid")
    push(files, "molecules")
    push(allow, "SwitchTrack ThemeSwitch Switch Slider Input Button")
    push(files, "organisms")
    push(allow, "LineChart Comp BarChart AreaChart LineChartOf BarChartOf AreaChartOf")
    push(files, "colors")
    push(allow, "")
    let ll = tmpf("arena_lint_lib.log")
    sys.write_file(ll, "")
    // A hit names the enclosing top-level fn; it fails unless that fn is in
    // the file's allow-list. Comment lines are skipped.
    let prog = tmpf("arena_lint.awk")
    sys.write_file(prog, "BEGIN { n = split(ALLOW, a, \" \"); for (k = 1; k <= n; k++) ok[a[k]] = 1 }\n/^fn / { match($0, /^fn [A-Za-z0-9_]+/); name = substr($0, 4, RLENGTH - 3) }\n$0 ~ RE && $0 !~ \"^[[:space:]]*(//|/[*])\" && !(name in ok) { print F \".loam:\" NR \": \" name \": \" $0 }\n")
    for i in 0..files.len {
        if !sh("awk -v RE={{shq(re)}} -v ALLOW={{shq(allow[i])}} -v F={{files[i]}} -f {{shq(prog)}} {{lib}}/{{files[i]}}.loam >> {{shq(ll)}} 2>&1") {
            bad("arena lint (awk failed on {{files[i]}}.loam)", ll)
            return
        }
    }
    if is_nonempty(ll) {
        bad("arena lint (a library component reaches into the element layer)", ll)
        return
    }
    ok("arena lint (examples, www and library components use no ui_push / slot / arena / raw_*; components import no zeuscore)")
}

/** *The public-surface freeze (`packages/zeus/docs/api-freeze.md`): every name */
/** *the freeze lists must still exist. `zeus.x` / `zui.x` / `value.x` are */
/** *top-level fns in the public zeus files, the component tiers, and */
/** *`zeuscore/style.loam`; `Style.k` (and `Float` / `Border` / `Edges` / */
/** *`Corners`) are struct fields there. Adding API never trips it; removing or */
/** *renaming a listed name does, until the freeze is edited on purpose. */
fn ig_api_freeze() {
    mark("api freeze")
    let doc = "packages/zeus/docs/api-freeze.md"
    let zs = "packages/zeus/src"
    let cs = "packages/zeus-components/src"
    let l = tmpf("api_freeze.log")
    let prog = tmpf("api_freeze.awk")
    sys.write_file(prog, "FNR == 1 { st = \"\"; cat = \"zeus\"; if (FILENAME ~ /api-freeze[.]md$/) cat = \"doc\"; else if (FILENAME ~ /zeus-components/) cat = \"zui\"; else if (FILENAME ~ /zeusraster[.]loam$/) cat = \"zeusraster\"; else if (FILENAME ~ /style[.]loam$/) cat = \"value\" }\ncat != \"doc\" && /^(pub )?fn [A-Za-z_]/ { n = $0; sub(/^(pub )?fn /, \"\", n); match(n, /^[A-Za-z0-9_]+/); have[cat \".\" substr(n, 1, RLENGTH)] = 1 }\ncat == \"value\" && /^struct [A-Za-z]+ [{]/ { st = $2; next }\ncat == \"value\" && st != \"\" && /^[}]/ { st = \"\" }\ncat == \"value\" && st != \"\" && /^    [A-Za-z_][A-Za-z0-9_]*:/ { k = $1; sub(/:.*/, \"\", k); have[st \".\" k] = 1 }\ncat == \"doc\" && /^- `[A-Za-z]+[.][A-Za-z0-9_]+`$/ { e = $0; sub(/^- `/, \"\", e); sub(/`$/, \"\", e); seen++; if (!(e in have)) print \"api-freeze.md:\" FNR \": \" e \" is listed but no longer defined\" }\nEND { if (seen == 0) print \"api-freeze.md: no entries found\" }\n")
    let srcs = "{{zs}}/zeus.loam {{zs}}/zeusbase.loam {{zs}}/flow.loam {{zs}}/media.loam {{zs}}/zeusraster.loam {{cs}}/atoms.loam {{cs}}/molecules.loam {{cs}}/organisms.loam {{zs}}/zeuscore/style.loam"
    if !sh("awk -f {{shq(prog)}} {{srcs}} {{doc}} > {{shq(l)}} 2>&1") {
        bad("api freeze (awk failed)", l)
        return
    }
    if is_nonempty(l) {
        bad("api freeze (a frozen zeus / zui / Style name disappeared)", l)
        return
    }
    ok("api freeze (every name in packages/zeus/docs/api-freeze.md still exists)")
}

fn ig_myapp() {
    ig_myapp_routes()
    ig_myapp_build()
}

/** *Package resolution, selective imports, and a reproducible vendor tree. */
/** *Self-hosting: the Loam lexer (`packages/loam/compiler/lexer.loam`) must agree */
/** *with `src/lexer.c` token for token — kind, span, and positions — on every */
/** *`.loam` file in the repo. `loamc --dump-tokens` is the reference. */
/** *A self-hosted compiler stage diffed against its C twin: `tool` (in */
/** *packages/loam/compiler) and `loamc <flag>` dump every .loam file in the */
/** *repo; stdout, stderr and the exit status must match byte for byte. */
fn selfhost_diff(what: string, tool: string, flag: string, ok_msg: string) {
    mark("selfhost {{what}}")
    // A private scratch dir per run: concurrent runs sharing fixed tmp paths
    // rewrite each other's binary (SIGKILL) and dumps (cmp SIGBUS).
    let tmpl = tmpf("selfhost_{{tool}}.XXXXXX")
    let d = trim(sys.exec("mkdir -p {{shq(TMP)}} && mktemp -d {{shq(tmpl)}}"))
    if sys.exec_status() != 0 || d.len == 0 {
        bad("selfhost {{what}} (mktemp)", d)
        return
    }
    let exe = "{{d}}/{{tool}}"
    let o = sys.exec("{{shq(LOAMC)}} {{shq(ROOT)}}/packages/loam/compiler/{{tool}}.loam -o {{shq(exe)}} 2>&1")
    if sys.exec_status() != 0 {
        sys.exec("rm -rf {{shq(d)}}")
        bad("selfhost {{what}} (build {{tool}})", o)
        return
    }
    let a = "{{d}}/out.c"
    let b = "{{d}}/out.loam"
    // `LOAM_HOME`: the Loam loader finds std and the runtime from it (the
    // tool is built into a scratch dir, not `bin/`).
    let script = cat(
        "cd {{shq(ROOT)}} && export LOAM_HOME={{shq(ROOT)}} && n=0; bad=''; for f in $(find packages examples nob.loam -name '*.loam' ",
        cat("-not -path '*/tmp/*' -not -path '*/build/*' -not -path '*/node_modules/*'); do n=$((n+1)); ",
            cat("{{shq(LOAMC)}} {{flag}} \"$f\" > {{shq(a)}} 2>&1; echo \"exit $?\" >> {{shq(a)}}; ",
                cat("{{shq(exe)}} \"$f\" > {{shq(b)}} 2>&1; echo \"exit $?\" >> {{shq(b)}}; ",
                    "cmp -s {{shq(a)}} {{shq(b)}} || bad=\"$bad $f\"; done; echo \"$n\"; [ -z \"$bad\" ] || { echo \"differ:$bad\"; exit 1; }"))))
    let r = sys.exec(script)
    let st = sys.exec_status()
    sys.exec("rm -rf {{shq(d)}}")
    if st != 0 {
        bad("selfhost {{what}} (dumps differ)", r)
        return
    }
    ok("selfhost {{what}} matches {{ok_msg}} on {{trim(r)}} files")
}

/** *A checker stage: `tcdump <tcdump_flags>` (fed the module list C's loader */
/** *resolved) against `loamc <dump_flag>` over every compile_pass / */
/** *compile_fail / draw_golden / examples/language entry: trees, tables, */
/** *diagnostics and exit status. Any difference fails. Files C cannot load */
/** *(parse errors: selfhost_parse) are counted apart. */
fn selfhost_checker_gate(stage: string, tcdump_flags: string, dump_flag: string, c_twin: string) {
    mark("selfhost {{stage}}")
    let scratch_template = tmpf("selfhost_{{stage}}.XXXXXX")
    let scratch_dir = trim(sys.exec("mkdir -p {{shq(TMP)}} && mktemp -d {{shq(scratch_template)}}"))
    if sys.exec_status() != 0 || scratch_dir.len == 0 {
        bad("selfhost {{stage}} (mktemp)", scratch_dir)
        return
    }
    let tcdump_exe = "{{scratch_dir}}/tcdump"
    let build_log = sys.exec("{{shq(LOAMC)}} {{shq(ROOT)}}/packages/loam/compiler/tcdump.loam -o {{shq(tcdump_exe)}} 2>&1")
    if sys.exec_status() != 0 {
        sys.exec("rm -rf {{shq(scratch_dir)}}")
        bad("selfhost {{stage}} (build tcdump)", build_log)
        return
    }
    // Eight entries at a time through tools/selfhost-tc-one.sh (the verdicts,
    // the watchdog and the result cache in TMP are described there). The
    // workers run in the background so the run reports progress as it goes.
    // The cache key includes the dump flag, so both gates share one cache.
    let entry_list = "{{scratch_dir}}/entries"
    let verdicts = "{{scratch_dir}}/verdicts"
    let done_marker = "{{scratch_dir}}/done"
    let cache_dir = "{{TMP}}/selfhost_tc_ref"
    let entry_count = int_of(trim(sys.exec(cat(
        "cd {{shq(ROOT)}} && mkdir -p {{shq(cache_dir)}} && ls packages/loam/tests/compile_pass/*.loam packages/loam/tests/compile_fail/*.loam packages/loam/tests/draw_golden/*.loam examples/language/*.loam ",
        "> {{shq(entry_list)}}; : > {{shq(verdicts)}}; wc -l < {{shq(entry_list)}}"))))
    let worker_env = cat("LOAMC={{shq(LOAMC)}} EXE={{shq(tcdump_exe)}} EXE_FLAGS={{shq(tcdump_flags)}} DUMP_FLAG={{shq(dump_flag)}} SCRATCH={{shq(scratch_dir)}} REF={{shq(cache_dir)}} ",
        "LOAMC_SUM=\"$(cksum < {{shq(LOAMC)}})\" EXE_SUM=\"$(cksum < {{shq(tcdump_exe)}})\"")
    sys.exec(cat("cd {{shq(ROOT)}} && ( export {{worker_env}}; xargs -P 8 -n 1 sh tools/selfhost-tc-one.sh < {{shq(entry_list)}} > {{shq(verdicts)}} 2>/dev/null; ",
        ": > {{shq(done_marker)}} ) > /dev/null 2>&1 &"))
    let mut reported = 0
    while sys.exists(done_marker) == 0 {
        let finished = int_of(trim(sys.exec("sleep 1; wc -l < {{shq(verdicts)}}")))
        if finished >= reported + 64 {
            mark("selfhost {{stage}} {{finished}}/{{entry_count}}")
            reported = finished
        }
    }
    let summary = sys.exec(cat("v={{shq(verdicts)}}; echo \"$(grep -c '^match' $v) match, $(grep -c '^load' $v) not loadable\"; ",
        "! grep -E '^(diff|hang)' $v"))
    let failed = sys.exec_status() != 0
    sys.exec("rm -rf {{shq(scratch_dir)}}")
    if failed {
        bad("selfhost {{stage}} (dumps differ)", summary)
        return
    }
    ok("selfhost {{stage}} vs {{c_twin}}: {{trim(summary)}}")
}

/** *The type checker: `tcdump` against `loamc --dump-typed`. */
fn ig_selfhost_typecheck() {
    selfhost_checker_gate("typecheck", "", "--dump-typed", "typecheck.c")
}

/** *The passes after typecheck: `tcdump --checked` against `loamc */
/** *--dump-checked` (threadcheck, borrowck and boundscheck: their diagnostics, */
/** *exit 3, and the moved / needs-drop / index-safe node flags). */
fn ig_selfhost_check() {
    selfhost_checker_gate("check", "--checked", "--dump-checked", "threadcheck.c, borrowck.c, boundscheck.c")
}

/** *IR lowering: `tcdump --ir` against `loamc --dump-ir` (every fn, local, */
/** *instruction and terminator codegen reads, and the verifier's verdict). */
fn ig_selfhost_ir() {
    selfhost_checker_gate("ir", "--ir", "--dump-ir", "ir.c")
}

/** *Dead-code elimination: `tcdump --dce` against `loamc --dump-dce` (the */
/** *fn declarations codegen keeps). */
fn ig_selfhost_dce() {
    selfhost_checker_gate("dce", "--dce", "--dump-dce", "dce.c")
}

/** *Codegen: `tcdump --c` against `loamc --dump-c`, the whole C translation */
/** *unit a default build emits, byte for byte. */
fn ig_selfhost_codegen() {
    selfhost_checker_gate("codegen", "--c", "--dump-c", "codegen_c.c")
}

fn ig_selfhost_lex() {
    selfhost_diff("lexer", "tokdump", "--dump-tokens", "lexer.c")
}

/** *The module loader: `moddump` against `loamc --dump-modules` (module */
/** *names, load ranks, std flags, paths, every import's resolution, and the */
/** *load and parse diagnostics), with every .loam file as the entry. */
fn ig_selfhost_load() {
    selfhost_diff("loader", "moddump", "--dump-modules", "compile.c, pkgresolve.c")
}

/** *The parser: `astdump` against `loamc --dump-ast` (trees, diagnostics, and */
/** *exit status), compile_fail files included. */
fn ig_selfhost_parse() {
    selfhost_diff("parser", "astdump", "--dump-ast", "parser.c")
}

/** *Floats on wasm: the wasm libc's exact `%g` / `strtod` match the host libc */
/** *(float_diff.c over the wasm-float block), and a program printing and parsing */
/** *floats writes the same bytes as a wasm module as it does natively. */
fn ig_wasm_float() {
    mark("wasm float")
    let dir = "{{ROOT}}/packages/loam/tests/wasm_smoke"
    let blk = tmpf("wasm_float_block.h")
    let diff = tmpf("float_diff")
    let o = sys.exec("sed -n '/BEGIN wasm-float/,/END wasm-float/p' {{shq(ROOT)}}/packages/loam/runtime/zeus_wasm_libc.c > {{shq(blk)}} && cc -O2 -w -DWASM_FLOAT_BLOCK='\"{{blk}}\"' {{shq(dir)}}/float_diff.c -o {{shq(diff)}} -lm 2>&1 && {{shq(diff)}} 20000 2>&1")
    if sys.exec_status() != 0 {
        bad("wasm float (exact %g / strtod vs host libc)", o)
        return
    }
    let nat = tmpf("float_app")
    let wasm = tmpf("float_app.wasm")
    let deno = tmpf("deno_float")
    let b = sys.exec("{{shq(LOAMC)}} {{shq(dir)}}/float_app.loam -o {{shq(nat)}} 2>&1 && {{shq(LOAMC)}} --target=wasm32 {{shq(dir)}}/float_app.loam -o {{shq(wasm)}} 2>&1")
    if sys.exec_status() != 0 {
        bad("wasm float (build)", b)
        return
    }
    let want = sys.exec(shq(nat))
    let got = sys.exec("DENO_DIR={{shq(deno)}} deno run --quiet --allow-read {{shq(dir)}}/run_plain.ts {{shq(wasm)}} 2>&1")
    if sys.exec_status() != 0 || got != want {
        bad("wasm float (wasm output differs from native)", "native:\n{{want}}\nwasm:\n{{got}}")
        return
    }
    ok("wasm float (exact %g / strtod; {{trim(o)}}; wasm prints what native prints)")
}

fn ig_modules() {
    mark("modules")
    let tests = "{{ROOT}}/packages/loam/tests"
    let src = tmpf("stdzeus.loam")
    let outc = tmpf("stdzeus.c")
    if !write_text(src, "import \"std:zeus\"\nfn main() {}\n") {
        bad("modules (setup std:zeus)", "")
        return
    }
    let o = sys.exec("{{shq(LOAMC)}} --emit-c {{shq(src)}} -o {{shq(outc)}} 2>&1")
    if sys.exec_status() == 0 {
        bad("modules (std:zeus should fail)", o)
        return
    }
    if !contains_str(o, "import \"zeus\"") || !contains_str(o, "language standard library") {
        bad("modules (std:zeus message)", o)
        return
    }
    let miss = tmpf("missing_pkg.loam")
    let missc = tmpf("missing_pkg.c")
    if !write_text(miss, "import \"no_such_pkg_zz\"\nfn main() {}\n") {
        bad("modules (setup missing package)", "")
        return
    }
    let mo = sys.exec("{{shq(LOAMC)}} --emit-c {{shq(miss)}} -o {{shq(missc)}} 2>&1")
    if sys.exec_status() == 0 {
        bad("modules (missing package should fail)", mo)
        return
    }
    if !contains_str(mo, "add it to loam.toml") || !contains_str(mo, "zeli pkg sync") {
        bad("modules (missing package message)", mo)
        return
    }
    let fullp = "{{tests}}/shake_app/app_full.loam"
    let selp = "{{tests}}/shake_app/app_sel.loam"
    let cf = tmpf("shake_full.c")
    let cs = tmpf("shake_sel.c")
    let fo = sys.exec("{{shq(LOAMC)}} --emit-c {{shq(fullp)}} -o {{shq(cf)}} 2>&1")
    if sys.exec_status() != 0 {
        bad("modules (full import emit)", fo)
        return
    }
    let so = sys.exec("{{shq(LOAMC)}} --emit-c {{shq(selp)}} -o {{shq(cs)}} 2>&1")
    if sys.exec_status() != 0 {
        bad("modules (selective import emit)", so)
        return
    }
    let full = sys.read_file(cf)
    let sel = sys.read_file(cs)
    if !contains_str(full, "BULKY_MARKER_TREE_SHAKE") {
        bad("modules (full import dropped the bulky fn)", full)
        return
    }
    if contains_str(sel, "BULKY_MARKER_TREE_SHAKE") {
        bad("modules (selective import kept the bulky fn)", sel)
        return
    }
    if full.len <= sel.len {
        bad("modules (selective C was not smaller)", "")
        return
    }
    let app = "{{tests}}/pkg_app/app.loam"
    let ca = tmpf("pkg_a.c")
    let cb = tmpf("pkg_b.c")
    let ao = sys.exec("LOAM_PATH=/tmp/loam-no-a {{shq(LOAMC)}} --emit-c {{shq(app)}} -o {{shq(ca)}} 2>&1")
    if sys.exec_status() != 0 {
        bad("modules (pkg_app under LOAM_PATH a)", ao)
        return
    }
    let bo = sys.exec("LOAM_PATH=/tmp/loam-no-b {{shq(LOAMC)}} --emit-c {{shq(app)}} -o {{shq(cb)}} 2>&1")
    if sys.exec_status() != 0 {
        bad("modules (pkg_app under LOAM_PATH b)", bo)
        return
    }
    let ca_txt = sys.read_file(ca)
    let cb_txt = sys.read_file(cb)
    if ca_txt != cb_txt {
        bad("modules (C changed when LOAM_PATH changed)", "")
        return
    }
    if contains_str(ca_txt, "/tmp/loam-no-a") || contains_str(ca_txt, "/tmp/loam-no-b") {
        bad("modules (LOAM_PATH leaked into C)", "")
        return
    }
    let bare = "{{tests}}/pkg_app/bare.loam"
    let bc = tmpf("pkg_bare.c")
    let bao = sys.exec("{{shq(LOAMC)}} --emit-c {{shq(bare)}} -o {{shq(bc)}} 2>&1")
    if sys.exec_status() != 0 {
        bad("modules (bare import greet)", bao)
        return
    }
    ok("modules (std:, packages, tree-shake, lock reproducibility)")
}

/** *`nob integration <name>` runs exactly one stanza; unknown names are refused. */
fn stanza_dispatch(name: string) -> bool {
    if name == "routes_app" {
        ig_routes_table()
    } else if name == "pkg_sync" {
        ig_pkg_sync()
    } else if name == "fmt" {
        ig_fmt()
    } else if name == "fmt_tree" {
        ig_fmt_tree()
    } else if name == "myapp" {
        ig_myapp()
    } else if name == "new" {
        ig_new()
    } else if name == "build_base" {
        ig_build_base()
    } else if name == "build_exits" {
        ig_build_exits()
    } else if name == "build_partial" {
        ig_build_partial()
    } else if name == "serve_build" {
        ig_serve_build()
    } else if name == "serve_native" {
        ig_serve_native()
    } else if name == "watch" {
        ig_watch()
    } else if name == "serve_boot" {
        ig_serve_boot()
    } else if name == "wasm_smoke" {
        ig_wasm_smoke()
    } else if name == "wasm_trap" {
        ig_wasm_trap()
    } else if name == "server_split" {
        ig_server_split()
        ig_c_client()
    } else if name == "lsp" {
        ig_lsp()
    } else if name == "cost" {
        ig_cost()
    } else if name == "stale_capture" {
        ig_stale_capture()
    } else if name == "one_surface" {
        ig_one_surface()
    } else if name == "arena_lint" {
        ig_arena_lint()
    } else if name == "api_freeze" {
        ig_api_freeze()
    } else if name == "modules" {
        ig_modules()
    } else if name == "wasm_float" {
        ig_wasm_float()
    } else if name == "selfhost_lex" {
        ig_selfhost_lex()
    } else if name == "selfhost_parse" {
        ig_selfhost_parse()
    } else if name == "selfhost_load" {
        ig_selfhost_load()
    } else if name == "selfhost_typecheck" {
        ig_selfhost_typecheck()
    } else if name == "selfhost_check" {
        ig_selfhost_check()
    } else if name == "selfhost_ir" {
        ig_selfhost_ir()
    } else if name == "selfhost_dce" {
        ig_selfhost_dce()
    } else if name == "selfhost_codegen" {
        ig_selfhost_codegen()
    } else if name == "suite_zeus" {
        ig_suite("zeus")
    } else if name == "suite_plain" {
        ig_suite("plain")
    } else if name == "serve_zeus" {
        ig_serve("zeus")
    } else if name == "serve_plain" {
        ig_serve("plain")
    } else if name == "suite_tests" {
        ig_suite_tests()
    } else if name == "ir_zeus" {
        ig_suite_ir("zeus")
    } else if name == "ir_plain" {
        ig_suite_ir("plain")
    } else {
        return false
    }
    return true
}

/** *The stanzas `nob integration` runs. A stanza is the unit of parallelism: `myapp` merges the route-table regeneration with the */
/** *build that consumes it, and each of the others owns a scratch tree of its */
/** *own, so no two can collide. */
fn stanza_names() -> []string {
    let mut v = []string {}
    push(v, "routes_app")
    push(v, "pkg_sync")
    push(v, "fmt")
    push(v, "fmt_tree")
    push(v, "myapp")
    push(v, "new")
    push(v, "build_base")
    push(v, "build_exits")
    push(v, "build_partial")
    push(v, "serve_build")
    push(v, "serve_native")
    push(v, "watch")
    push(v, "serve_boot")
    push(v, "wasm_smoke")
    push(v, "wasm_trap")
    push(v, "server_split")
    push(v, "lsp")
    push(v, "cost")
    push(v, "one_surface")
    push(v, "arena_lint")
    push(v, "api_freeze")
    push(v, "modules")
    push(v, "selfhost_lex")
    push(v, "selfhost_parse")
    push(v, "selfhost_load")
    push(v, "selfhost_typecheck")
    push(v, "selfhost_check")
    push(v, "selfhost_ir")
    push(v, "selfhost_dce")
    push(v, "selfhost_codegen")
    push(v, "wasm_float")
    return v
}

/** *Run the stanzas as `bin/nob integration <name>` children, bounded by `JOBS`. */
/** *Each child is a fresh process with its own Loam state, so the same pool the */
/** *fixtures use works here — and control flow stays in Loam, not in a script. */
fn pool_stanzas(names: []string) -> int {
    let n = names.len
    if n == 0 {
        return 0
    }
    let res = tmpf("ig")
    let script = tmpf("ig.sh")
    let idxf = tmpf("ig.idx")
    let outlog = tmpf("ig.out")
    let self = "{{BIN}}/nob"
    sys.remove_path(res)
    sys.mkdir(res)
    let mut s = "#!/bin/sh\n"
    s = cat(s, "RES={{shq(res)}}\ncase \"$1\" in\n")
    let mut ids = ""
    for i in 0..n {
        let id = pad4(i)
        s = cat(s, "{{id}})\n  {\n    {{shq(self)}} integration {{names[i]}} &\n    p=$!\n    ( sleep 300; kill $p 2>/dev/null ) >/dev/null 2>&1 &\n    w=$!\n    wait $p; st=$?\n    kill $w 2>/dev/null\n    echo $st >\"$RES/{{id}}.status\"\n  } 2>&1 | tee \"$RES/{{id}}.log\" >&2\n  ;;\n")
        ids = cat(ids, "{{id}}\n")
    }
    s = cat(s, "esac\nexit 0\n")
    sys.write_file(script, s)
    sys.write_file(idxf, ids)
    let t0 = now_s()
    sys.exec("cd {{shq(ROOT)}} && { echo \"nob: integration — {{n}} stanza(s), -j {{JOBS}}\" >&2; ZEUS_HEADLESS=1 MAYA_HEADLESS=1 xargs -P {{JOBS}} -n 1 sh {{shq(script)}} < {{shq(idxf)}} >{{shq(outlog)}}; }")
    let el = now_s() - t0
    sys.exec("echo 'nob: integration done in {{el}}s' >&2")

    let mut failed = 0
    for i in 0..n {
        let id = pad4(i)
        let st = trim(sys.read_file("{{res}}/{{id}}.status"))
        let log = sys.read_file("{{res}}/{{id}}.log")
        let oks = lines_with(log, "ok   ")
        N_PASS += oks.len
        let fls = lines_with(log, "FAIL ")
        for k in 0..fls.len {
            N_FAIL += 1
            push(FAILURES, slice(fls[k], 5, fls[k].len))
        }
        if st != "0" {
            failed += 1
            if fls.len == 0 {
                N_FAIL += 1
                push(FAILURES, "integration {{names[i]}} (exit {{st}})")
            }
        }
    }
    return failed
}

/** *Every integration check, run as a bounded pool of stanza children. This is */
/** *the `zeli`/serve/pkg/fmt suite; `nob test` does not run it (see */
/** *`host_checks`), because it is slow and the most environment-sensitive part. */
fn integration() -> int {
    return pool_stanzas(stanza_names())
}

/** *The host checks `test` does run: they need neither `bin/zeli` nor a scratch */
/** *app. The wasm module's entry points, the server/client split, and the */
/** *language server all sit next to the compiler. */
fn host_stanzas() -> []string {
    return []string { "wasm_smoke", "wasm_trap", "server_split", "lsp", "cost", "stale_capture", "one_surface", "arena_lint", "api_freeze", "modules", "selfhost_lex", "selfhost_parse", "selfhost_load", "selfhost_typecheck", "selfhost_check", "selfhost_ir", "selfhost_dce", "selfhost_codegen", "wasm_float" }
}

/** *One after another, for an `--isolated` run; a batched run pools them. */
fn host_checks() -> int {
    let before = N_FAIL
    let names = host_stanzas()
    for i in 0..names.len {
        stanza_dispatch(names[i])
    }
    return N_FAIL - before
}

/** *`nob integration`: the process/port/git checks alone (development). Same */
/** *reporting as `test`, without the fixture pools. */
fn run_integration_only() -> int {
    sys.mkdir(TMP)
    sys.mkdir(NOB)
    if build("all") != 0 {
        fmt.println("nob: build failed; checks not run")
        return 1
    }
    if gen_fixtures() != 0 {
        return 1
    }
    N_PASS = 0
    N_FAIL = 0
    FAILURES = []string {}
    let t0 = now_s()
    TSTART = t0
    let failed = integration()
    let secs = now_s() - t0
    fmt.println("")
    if failed != 0 {
        fmt.println("{{N_PASS}} passed, {{N_FAIL}} failed in {{secs}}s — failed:")
        for i in 0..FAILURES.len {
            fmt.println("  FAIL {{FAILURES[i]}}")
        }
        return 1
    }
    fmt.println("{{N_PASS}} passed, 0 failed in {{secs}}s")
    return 0
}

fn bench() -> int {
    if build("all") != 0 {
        return 1
    }
    sys.exec("cd {{shq(ROOT)}} && sh packages/loam/tests/bench/run.sh")
    return sys.exec_status()
}

/** *The grammar is a second, hand-maintained parser and nothing in `nob test` */
/** *reads it, so it rots silently while Loam moves on: `grammar` gates on this. */
fn grammar_check() -> int {
    return rc("bash packages/tooling/tree-sitter-loam/check.sh")
}

fn grammar() -> int {
    if !run_ok("cd packages/tooling/tree-sitter-loam && npx --yes tree-sitter-cli generate 1>&2") {
        return 1
    }
    if grammar_check() != 0 {
        return 1
    }
    return rc("sh packages/tooling/tree-sitter-loam/zed-grammar.sh 1>&2")
}

fn clean() {
    sys.remove_path(OBJ)
    sys.remove_path(BIN)
    sys.remove_path(TMP)
    sys.remove_path("{{ROOT}}/packages/loam/runtime/.obj")
    fmt.println("nob: clean")
}

// --- fuzz-borrow: look for borrow-checker holes with AddressSanitizer -------
//
// Generates small programs that aim references at lists, boxes, and locals,
// then grow, reassign, or drop what they point at, across branches, loops,
// `if` expressions, calls returning references, and `&mut` out parameters.
// Every program `loamc` accepts is built with ASan and run: an ASan report
// means the checker let unsafe code through. Kept out of `nob test`.
// `LOAM_FUZZ_LOAMC` picks the compiler under test (default bin/loamc);
// `FUZZ_SEED` the first seed. See docs/reference-escape.md, phase 7.
//
// The backend drops values at function exit, so a reference outliving an
// inner block is invisible at run time; what ASan sees is a list buffer
// reallocated or freed, a Box replaced, and a reference into a returned frame.

let mut FZ_SEED: i64 = i64(1)
let mut FZ_UID: int = 0

fn fz_next() -> int {
    FZ_SEED = (FZ_SEED * i64(1103515245) + i64(12345)) % i64(2147483647)
    return int(FZ_SEED / i64(65536))
}

fn fz(n: int) -> int {
    return fz_next() % n
}

fn fz_list() -> string {
    return "v{{fz(3)}}"
}

fn fz_box() -> string {
    return "b{{fz(2)}}"
}

fn fz_ref() -> string {
    if fz(2) == 0 {
        return "p"
    }
    return "q"
}

fn fz_cond() -> string {
    return "{{fz_list()}}.len > {{fz(4)}}"
}

/** *An expression of type `&int`. */
fn fz_refexpr(d: int) -> string {
    let k = fz(10)
    if k == 0 {
        return "&{{fz_list()}}[0]"
    }
    if k == 1 {
        return "first(&{{fz_list()}})"
    }
    if k == 2 {
        return "&*{{fz_box()}}"
    }
    if k == 3 {
        return fz_ref()
    }
    if k == 4 {
        return "id({{fz_ref()}})"
    }
    if k == 5 {
        return "pick(&{{fz_list()}}[0], {{fz_ref()}}, {{fz_cond()}})"
    }
    if k == 6 && d < 2 {
        return "if {{fz_cond()}} { {{fz_refexpr(d + 1)}} } else { {{fz_refexpr(d + 1)}} }"
    }
    if k == 7 {
        return "frame{{fz(3)}}({{fz_ref()}}, {{fz_cond()}})"
    }
    if k == 8 {
        return "first({{fz_list()}}ref(&{{fz_list()}}))"
    }
    return "&z"
}

fn fz_block(d: int, ind: string) -> string {
    let mut out = ""
    let n = 1 + fz(3)
    for i in 0..n {
        out = cat(out, "{{ind}}{{fz_stmt(d, ind)}}\n")
    }
    return out
}

fn fz_stmt(d: int, ind: string) -> string {
    let k = fz(15)
    let in2 = "{{ind}}    "
    if k <= 2 {
        return "{{fz_ref()}} = {{fz_refexpr(0)}}"
    }
    if k == 3 {
        return "for i in 0..40 { {{fz_list()}}.push(i) }"
    }
    if k == 4 {
        let l = fz_list()
        return "{{l}} = []int {}\n{{ind}}{{l}}.push(7)"
    }
    if k == 5 {
        return "{{fz_box()}} = Box::new({{fz(100)}})"
    }
    if k == 6 {
        return "fmt.println(*{{fz_ref()}})"
    }
    if k == 7 && d < 2 {
        return "if {{fz_cond()}} {\n{{fz_block(d + 1, in2)}}{{ind}}} else {\n{{fz_block(d + 1, in2)}}{{ind}}}"
    }
    if k == 8 && d < 2 {
        return "for j in 0..2 {\n{{fz_block(d + 1, in2)}}{{ind}}}"
    }
    if k == 9 {
        return "aim(&mut {{fz_ref()}}, {{fz_refexpr(0)}})"
    }
    if k == 10 {
        FZ_UID += 1
        return "let t{{FZ_UID}} = {{fz_refexpr(0)}}\n{{ind}}{{fz_ref()}} = t{{FZ_UID}}"
    }
    if k == 11 && d < 2 {
        return "if true {\n{{in2}}let bb = Box::new(5)\n{{in2}}{{fz_ref()}} = &*bb\n{{ind}}}"
    }
    if k == 12 {
        return "fmt.println(smash())"
    }
    if k == 13 {
        return "{{fz_list()}}[0] = {{fz(9)}}"
    }
    return "fmt.println(*{{fz_refexpr(0)}})"
}

/** *A helper returning a reference: mostly safe bodies, sometimes one that
    points into its own frame (the checker must reject the program then). */
fn fz_frame(i: int, unsafe_ok: bool) -> string {
    let head = "fn frame{{i}}(a: &int, c: bool) -> &int {\n"
    let mut k = fz(16)
    if !unsafe_ok && k >= 3 && k <= 8 {
        k = 0
    }
    let mut b = "    return a\n"
    if k == 1 {
        b = "    if c {\n        return a\n    }\n    return a\n"
    } else if k == 2 {
        b = "    let r = if c { a } else { a }\n    return r\n"
    } else if k == 3 {
        b = "    let x = 3\n    return if c { &x } else { a }\n"
    } else if k == 4 {
        b = "    let x = 3\n    let r = &x\n    return id(r)\n"
    } else if k == 5 {
        b = "    let bx = Box::new(4)\n    return &*bx\n"
    } else if k == 6 {
        b = "    let mut v = []int {}\n    v.push(1)\n    return first(&v)\n"
    } else if k == 7 {
        b = "    let x = 3\n    let mut r = a\n    if c {\n        r = &x\n    }\n    return r\n"
    } else if k == 8 {
        b = "    let x = 3\n    let mut r = a\n    aim(&mut r, &x)\n    return r\n"
    }
    return cat(cat(head, b), "}\n")
}

fn fz_program() -> string {
    let mut s = "import \"std:fmt\"\n\n"
    s = cat(s, "fn first(xs: &[]int) -> &int {\n    return &xs[0]\n}\n\n")
    s = cat(s, "fn id(a: &int) -> &int {\n    return a\n}\n\n")
    s = cat(s, "fn pick(a: &int, b: &int, l: bool) -> &int {\n    if l {\n        return a\n    }\n    return b\n}\n\n")
    s = cat(s, "fn aim(pp: &mut &int, src: &int) {\n    *pp = src\n}\n\n")
    s = cat(s, "fn smash() -> int {\n    let mut t = 0\n    for k in 0..64 {\n        t += k\n    }\n    return t\n}\n\n")
    for i in 0..3 {
        s = cat(s, "fn v{{i}}ref(xs: &[]int) -> &[]int {\n    return xs\n}\n\n")
    }
    // One helper in four programs may point into its own frame; the rest
    // stay safe so most programs reach the run.
    let bad_frame = fz(12)
    for i in 0..3 {
        s = cat(s, fz_frame(i, bad_frame == i))
        s = cat(s, "\n")
    }
    s = cat(s, "fn main() {\n")
    for i in 0..3 {
        s = cat(s, "    let mut v{{i}} = []int {}\n    v{{i}}.push({{i + 1}})\n")
    }
    s = cat(s, "    let mut b0 = Box::new(10)\n    let mut b1 = Box::new(20)\n")
    s = cat(s, "    let z = 0\n    let mut p = &z\n    let mut q = &z\n")
    let n = 3 + fz(6)
    for i in 0..n {
        s = cat(s, "    {{fz_stmt(0, \"    \")}}\n")
    }
    s = cat(s, "    fmt.println(*p + *q)\n}\n")
    return s
}

fn fuzz_borrow(count: int) -> int {
    let dir = tmpf("fuzz")
    sys.exec("rm -rf {{shq(dir)}} && mkdir -p {{shq(dir)}}/holes")
    let mut loamc = sys.env("LOAM_FUZZ_LOAMC")
    if loamc == "" {
        loamc = LOAMC
    }
    let seed = int_of(sys.env("FUZZ_SEED"))
    FZ_SEED = i64(1)
    if seed > 0 {
        FZ_SEED = i64(seed)
    }
    let first_seed = FZ_SEED
    for i in 0..count {
        sys.write_file("{{dir}}/f{{pad4(i)}}.loam", fz_program())
    }
    // One case: compile with ASan into a fresh binary, run it, classify.
    let borrow_msgs = "borrow|out of scope|live long enough|temporary|cannot assign to|cannot use|moved|stores its type parameter|cannot hold a reference"
    let runner = "f=\"$1\"; b=\"${f%.loam}\"\nif ! LOAM_NO_FRESH=1 LOAM_LINK_EXTRA='-O0 -fno-inline -fsanitize=address -fsanitize-address-use-after-return=always -g' {{shq(loamc)}} \"$f\" -o \"$b\" > \"$b.build\" 2>&1; then\n  if grep -qE '{{borrow_msgs}}' \"$b.build\"; then echo \"REJECT $f\"; else echo \"OTHER $f\"; fi\n  exit 0\nfi\nASAN_OPTIONS=detect_stack_use_after_return=1:detect_leaks=0 \"./$b\" > \"$b.out\" 2>&1\nif grep -q AddressSanitizer \"$b.out\"; then echo \"HOLE $f\"; elif [ -s \"$b.out\" ]; then echo \"SAFE $f\"; else echo \"OTHER $f\"; fi\nrm -f \"$b\"\n"
    sys.write_file("{{dir}}/case.sh", runner)
    fmt.println("nob: fuzz-borrow — {{count}} programs, seed {{first_seed}}, {{loamc}}")
    let res = sys.exec("cd {{shq(dir)}} && ls f*.loam | ZEUS_HEADLESS=1 MAYA_HEADLESS=1 xargs -P {{JOBS}} -n 1 sh case.sh")
    let lines = split_lines(res)
    let mut holes = 0
    let mut rejected = 0
    let mut safe = 0
    let mut other = 0
    for i in 0..lines.len {
        let l = lines[i]
        if starts_with(l, "HOLE ") {
            holes += 1
            let f = slice(l, 5, l.len)
            sys.exec("cp {{shq(dir)}}/{{f}} {{shq(dir)}}/holes/ && cp {{shq(dir)}}/{{stem_of(f)}}.out {{shq(dir)}}/holes/")
            fmt.println("HOLE {{dir}}/holes/{{f}}")
        } else if starts_with(l, "REJECT ") {
            rejected += 1
        } else if starts_with(l, "SAFE ") {
            safe += 1
        } else if starts_with(l, "OTHER ") {
            other += 1
            if other <= 3 {
                let f = slice(l, 6, l.len)
                fmt.println("note: {{f}} failed for a non-borrow reason (generator bug?):")
                catlog("{{dir}}/{{stem_of(f)}}.build")
            }
        }
    }
    fmt.println("accepted and ASan-clean {{safe}}, rejected {{rejected}}, holes {{holes}}, other {{other}}")
    if holes > 0 || other > 0 {
        return 1
    }
    return 0
}

fn usage() {
    fmt.println("nob — build and test Loam")
    fmt.println("")
    fmt.println("usage: nob [command] [-j N]")
    fmt.println("")
    fmt.println("  build   (default) bin/loamc, bin/loam-lsp, bin/loam-fmt, bin/zeli")
    fmt.println("  test    language suites + host checks (no zeli)")
    fmt.println("  test --isolated  the same, every fixture as its own binary")
    fmt.println("  test <s>  only fixtures whose path contains <s>, each as its own")
    fmt.println("          binary (no host checks)")
    fmt.println("  test <f.loam>  build and run exactly this file")
    fmt.println("  lsp     bin/loam-lsp and its objects only")
    fmt.println("  integration  the zeli/serve/pkg/fmt suite (slow; on demand)")
    fmt.println("  bench   build, then run packages/loam/tests/bench/run.sh")
    fmt.println("  grammar  regenerate, check and publish the tree-sitter grammar")
    fmt.println("  grammar-check  check the grammar against the compiler's parser")
    fmt.println("  install-editor  install the VS Code extension")
    fmt.println("  clean   remove obj/, bin/ and packages/loam/tests/tmp")
    fmt.println("  fuzz-borrow [N]  N random programs (default 200): any the checker")
    fmt.println("          accepts that ASan flags is a borrow-checker hole")
    fmt.println("")
    fmt.println("  -j N    cases in flight (default: every core; NOB_JOBS / LOAM_JOBS)")
}

fn main() {
    // Locate the repo root from argv[0] (bin/nob -> the directory above bin),
    // falling back to the working directory.
    let cwd = sys.cwd()
    let mut root = dir_of(dir_of(sys.arg(0)))
    if root == "" || sys.exists("{{root}}/packages/loam/src") == 0 {
        root = cwd
    }
    if !starts_with(root, "/") {
        if root == "." {
            root = cwd
        } else {
            root = "{{cwd}}/{{root}}"
        }
    }
    ROOT = root
    SRC = "{{ROOT}}/packages/loam/src"
    OBJ = "{{ROOT}}/obj"
    BIN = "{{ROOT}}/bin"
    TESTS = "{{ROOT}}/packages/loam/tests"
    TMP = "{{TESTS}}/tmp"
    EXB = "{{TMP}}/build"
    NOB = "{{TMP}}/nob"
    LOAMC = "{{BIN}}/loamc"
    ZELI = "{{BIN}}/zeli"
    FMT = "{{BIN}}/loam-fmt"

    let cores = int_of(sys.exec("sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null"))
    if cores > 0 {
        JOBS = cores
    }
    let mut ej = sys.env("NOB_JOBS")
    if ej == "" {
        ej = sys.env("LOAM_JOBS")
    }
    if ej != "" {
        let k = int_of(ej)
        if k > 0 {
            JOBS = k
        }
    }

    let argv = sys.args()
    let mut pos = []string {}
    let mut i = 1
    while i < argv.len {
        let a = argv[i]
        if a == "-j" || a == "--jobs" {
            if i + 1 < argv.len {
                i += 1
                let k = int_of(argv[i])
                if k > 0 {
                    JOBS = k
                }
            }
        } else if starts_with(a, "-j") && a.len > 2 {
            let k = int_of(slice(a, 2, a.len))
            if k > 0 {
                JOBS = k
            }
        } else if a == "--isolated" {
            ISOLATED = true
        } else if a == "-h" || a == "--help" {
            usage()
            return
        } else if starts_with(a, "-") {
            fmt.println("nob: unknown option", a)
            sys.exit(2)
        } else {
            push(pos, a)
        }
        i += 1
    }
    let mut cmd = "build"
    if pos.len > 0 {
        cmd = pos[0]
    }
    let mut only = ""
    if pos.len > 1 {
        only = pos[1]
    }
    if pos.len > 2 || (pos.len > 1 && cmd != "integration" && cmd != "test" &&
                       cmd != "fuzz-borrow") {
        fmt.println("nob: unexpected argument", only)
        sys.exit(2)
    }

    if cmd == "build" || cmd == "all" {
        sys.exit(build("all"))
    } else if cmd == "lsp" {
        sys.exit(build("lsp"))
    } else if cmd == "test" {
        ONLY = only
        // `nob test <file.loam>`: run exactly that file (repo-relative or absolute).
        if only != "" && ends_with(only, ".loam") {
            if sys.exists(only) != 0 {
                ONLY_FILE = only
            } else if sys.exists("{{ROOT}}/{{only}}") != 0 {
                ONLY_FILE = "{{ROOT}}/{{only}}"
            }
        }
        sys.exit(test())
    } else if cmd == "integration" {
        if only != "" {
            // One stanza, as a child of the pool above.
            N_PASS = 0
            N_FAIL = 0
            FAILURES = []string {}
            TSTART = now_s()
            if !stanza_dispatch(only) {
                fmt.println("nob: unknown stanza", only)
                sys.exit(2)
            }
            if N_FAIL != 0 {
                sys.exit(1)
            }
            sys.exit(0)
        }
        sys.exit(run_integration_only())
    } else if cmd == "bench" {
        sys.exit(bench())
    } else if cmd == "grammar" {
        sys.exit(grammar())
    } else if cmd == "grammar-check" {
        sys.exit(grammar_check())
    } else if cmd == "install-editor" {
        sys.exit(rc("python3 packages/tooling/editors/vscode/install.py 1>&2"))
    } else if cmd == "fuzz-borrow" {
        let mut n = 200
        if only != "" && int_of(only) > 0 {
            n = int_of(only)
        }
        sys.exit(fuzz_borrow(n))
    } else if cmd == "clean" {
        clean()
        sys.exit(0)
    } else if cmd == "help" {
        usage()
        sys.exit(0)
    } else {
        fmt.println("nob: unknown command", cmd)
        usage()
        sys.exit(2)
    }
}
