    let l = tmpf("myapp_routes_gen.log")
    if !sh("{{shq(ZELI)}} routes examples/zeus/myapp > {{shq(l)}} 2>&1") {
        bad("zeli routes (myapp)", l)
        return
    }
    if !git_clean("examples/zeus/myapp/app_routes.loam", tmpf("myapp_routes_diff.log")) {
        bad("zeli routes (myapp's table is not what is committed)", tmpf("myapp_routes_diff.log"))
        return
    }
    ok("zeli routes (myapp: groups, params, meta and paths)")
}

fn ig_new() {
    mark("zeli new")
    let d = tmpf("newapp")
    let empty = "{{d}}/empty"
    if !reset_dir(d) || !mkdirp(empty) {
        bad("zeli new (setup)", "")
        return
    }
    let l = tmpf("newapp.log")
    if !sh("{{shq(ZELI)}} new my-app {{shq(empty)}} > {{shq(l)}} 2>&1") {
        bad("zeli new", l)
        return
    }
    let manifest = tmpf("newapp.manifest")
    let gen = "cd {{shq(empty)}} && find . -type f -print | sed -e 's|^[.]/||' | LC_ALL=C sort | while IFS= read -r f; do printf '=== %s %s\\n' \"$f\" \"$(wc -c < \"$f\" | tr -d ' ')\"; cat \"$f\"; done > {{shq(manifest)}} 2>&1"
    if !sh(gen) {
        bad("zeli new (manifest)", manifest)
        return
    }
    if !diff_log("packages/zeus/tests/scaffold.golden", manifest, tmpf("newapp.diff")) {
        bad("zeli new (the scaffold is not the frozen one)", tmpf("newapp.diff"))
        return
    }
    let n2 = tmpf("newapp2.log")
    let nstat = rc("{{shq(ZELI)}} new my-app {{shq(empty)}} > {{shq(n2)}} 2>&1")
    if nstat != 2 {
        bad("zeli new (a non-empty target must be refused)", n2)
        return
    }
    if !file_has(n2, "already exists and is not empty") {
        bad("zeli new (the refusal does not say why)", n2)
        return
    }
    let nblog = tmpf("newapp_build.log")
    if !sh("{{shq(LOAMC)}} {{shq(empty)}}/app.loam -o {{shq(d)}}/app > {{shq(nblog)}} 2>&1") {
        bad("zeli new (the scaffold does not compile)", nblog)
        return
    }
    ok("zeli new (matches the frozen scaffold, refuses a non-empty target, compiles)")
}

