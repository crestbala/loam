    let W = "{{d}}/app/build/web"
    let good = bstat == 0 && is_nonempty("{{W}}/app.wasm") && is_exec("{{d}}/app/build/macos/app") && is_file("{{W}}/blog/index.html") && file_has("{{W}}/blog/index.html", "rel=\"canonical\" href=\"https://example.com/blog\"") && file_has("{{W}}/sitemap.xml", "https://example.com/blog/hello-world") && file_has("{{W}}/robots.txt", "Sitemap: https://example.com/sitemap.xml") && count_matches("{{W}}/blog/index.html", "<canvas") == 1
    if good {
        ok("zeli build (--base: canonical URLs, sitemap, robots)")
    } else {
        bad("zeli build (--base, shells, sitemap, robots)", out)
    }
}

fn ig_build_exits() {
    mark("zeli build exit codes")
    let d = tmpf("buildbad")
    if !reset_dir(d) {
        bad("zeli build (failure setup)", "")
        return
    }
    mkdirp("{{d}}/bad")
    write_text("{{d}}/bad/app.loam", "fn main() {\n    let x: int = \"no\"\n}\n")
    let bt = "{{d}}/bad_target.out"
    let ty = "{{d}}/type.out"
    let badstat = rc("{{shq(ZELI)}} build {{shq(d)}}/app --targets nope > {{shq(bt)}} 2>&1")
    let typestat = rc("{{shq(ZELI)}} build {{shq(d)}}/bad --targets web > {{shq(ty)}} 2>&1")
    if badstat != 2 || typestat != 1 || !file_has(bt, "unknown target 'nope' (want web, macos, ios, android, server)") || !file_has(ty, "failed the compiler check") {
        bad2("zeli build (exit codes / messages)", bt, ty)
        return
    }
    ok("zeli build (an unknown target and a type error exit as documented)")
}

fn ig_build_partial() {
    mark("zeli build partial")
    let d = tmpf("buildpart")
    sh("chmod -R u+w {{shq(d)}} 2>/dev/null")
    if !reset_dir(d) {
        bad("zeli build (partial setup)", "")
        return
    }
    mkdirp("{{d}}/build/web")
    cp("packages/loam/tests/routes_app/app.loam", "{{d}}/app.loam")
    cpR("packages/loam/tests/routes_app/routes", "{{d}}/routes")
    chmod("500", "{{d}}/build/web")
    let po = "{{d}}/part.out"
    let no = "{{d}}/none.out"
    let pstat = rc("{{shq(ZELI)}} build {{shq(d)}} --targets web,macos > {{shq(po)}} 2>&1")
    let nstat = rc("{{shq(ZELI)}} build {{shq(d)}} --targets web > {{shq(no)}} 2>&1")
    chmod("700", "{{d}}/build/web")
    if pstat != 0 || nstat != 1 || !file_matches(po, "^zeli: web failed") || !file_matches(po, "^zeli: built 1/2 target[(]s[)]") || !file_matches(no, "^zeli: built 0/1 target[(]s[)]") {
        bad2("zeli build (a partial build must exit 0, a total failure 1)", po, no)
        return
    }
    ok("zeli build (one target fails, the rest still build)")
}

