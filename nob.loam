    if !reset_dir(d) {
        bad("zeli serve (setup)", "")
        return
    }
    mkdirp("{{d}}/app")
    cpR("packages/loam/tests/routes_app/routes", "{{d}}/app/routes")
    cp("packages/loam/tests/routes_app/app.loam", "{{d}}/app/app.loam")
    let out = tmpf("serveonly.out")
    let dstat = rc("{{shq(ZELI)}} serve {{shq(d)}}/app --build-only > {{shq(out)}} 2>&1")
    let W = "{{d}}/app/build/web"
    let good = dstat == 0 && is_nonempty("{{W}}/app.wasm") && is_file("{{W}}/index.html") && is_file("{{W}}/sitemap.xml") && file_matches(out, "zeli: serve build ok [(]--build-only[)]$") && file_matches(out, "zeli: routes -> app_routes[.]loam$")
    if good {
