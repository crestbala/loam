fn ig_serve_native() {
    mark("zeli serve native")
    let d = tmpf("servenative")
    if !reset_dir(d) {
        bad("zeli serve native (setup)", "")
        return
    }
    mkdirp(d)
    let launches = tmpf("serve_launches")
    let log = tmpf("serve_native.log")
    rmrf(launches)
    // Remove the log too: the poll below must not read a pid left by an
    // earlier run before this run's server has finished starting.
    rmrf(log)
    cp("packages/loam/tests/serve/loop.loam", "{{d}}/app.loam")
    let srvpid = spawn("SERVE_LAUNCHES={{shq(launches)}} {{shq(ZELI)}} serve {{shq(d)}} --target macos > {{shq(log)}} 2>&1")
    let mut i = 0
    while i < 300 && !file_has(log, "zeli: serve on macos (pid ") && pid_alive(srvpid) {
        sys.exec("sleep 0.1")
        i += 1
    }
    if !file_has(log, "zeli: serve on macos (pid ") {
        bad("zeli serve native (nothing came up)", log)
        kill_pid(srvpid)
        return
    }
    let first = picked_pid(log, "zeli: serve on macos (pid ", false)
    // `serve` reports the app's pid before the app has finished starting, and an
    // edit right then would replace it before it appended its own pid — which
    // made `ran` hold only the second launch. Wait for the first write first.
    let mut w = 0
    while w < 100 && line_count(launches) < 1 {
        sys.exec("sleep 0.1")
        w += 1
    }
    append_text("{{d}}/app.loam", "\n// touched by the serve gate\n")
    let mut j = 0
    while j < 400 && !file_has(log, "zeli: restarted (pid ") {
        sys.exec("sleep 0.1")
        j += 1
    }
    let mut k = 0
    while k < 100 && line_count(launches) < 2 {
        sys.exec("sleep 0.1")
        k += 1
    }
    let second = picked_pid(log, "zeli: restarted (pid ", true)
    let restarts = count_matches(log, "zeli: restarted (pid ")
    let ran = sys.exec("cat {{shq(launches)}} 2>/dev/null | tr '\\n' ' '")
    let printed = count_matches("{{d}}/build/macos/app.log", "serve fixture up")
    let old_up = pid_alive(first)
    let new_up = pid_alive(second)
    kill_pid(srvpid)
    kill_pid(first)
    kill_pid(second)
    catlog(log)
    fmt.println("   launches ran=[{{ran}}] reported first={{first}} second={{second}} app-log-lines={{printed}}")
    if first <= 0 || second <= 0 {
        bad("zeli serve native (a launch did not report a pid)", "")
        return
    }
    if restarts != 1 {
        bad("zeli serve native (one edit was {{restarts}} restarts - a self-triggered cascade?)", "")
        return
    }
    if old_up {
        bad("zeli serve native (the replaced process is still running)", "")
        return
    }
    if !new_up {
        bad("zeli serve native (the replacement is not running)", "")
        return
    }
    if ran != "{{first}} {{second}} " {
        bad("zeli serve native (the processes that ran were [{{ran}}], serve reported [{{first}} {{second}}])", "")
        return
    }
    if printed == 0 {
        bad("zeli serve native (the app's output never reached its log)", "")
        return
    }
    ok("zeli serve --target macos (one edit is one restart, old process gone)")
}

fn ig_watch() {
    mark("serve watcher probe")
    let bin = tmpf("serve_watch_probe")
    let wblog = tmpf("serve_watch_build.log")
    let scratch = tmpf("servewatch")
    if !sh("{{shq(LOAMC)}} packages/zeus/cli/serve_watch_probe.loam -o {{shq(bin)}} > {{shq(wblog)}} 2>&1") {
        bad("serve watcher (compile)", wblog)
        return
    }
    let out = tmpf("serve_watch.out")
    let stat = rc("{{shq(bin)}} {{shq(scratch)}} > {{shq(out)}} 2>&1")
    if file_has(out, "no kernel watcher on this host") {
        skip("serve watcher (no kernel watcher on this host)")
        return
    }
    if stat != 0 {
        bad("serve watcher (exit {{stat}})", out)
        return
    }
    if !file_matches(out, "^  hit .*edited[.]loam$") {
        bad("serve watcher (an in-place edit did not wake it)", out)
        return
    }
    if !file_matches(out, "^  hit .*created[.]loam$") {
        bad("serve watcher (a new file did not wake it)", out)
        return
    }
    if !file_matches(out, "^  hit .*removed[.]loam$") {
        bad("serve watcher (a deleted file did not wake it)", out)
        return
    }
    if !file_matches(out, "^  [(]none[)]$") {
        bad("serve watcher (a write outside the watch set woke it)", out)
        return
    }
    if file_matches(out, "/build/|/[.]zeus/") {
        bad("serve watcher (build output or the cache woke it)", out)
        return
    }
    ok("serve watcher (in-place edit, new file, delete, build output ignored)")
}

fn ig_serve_boot() {
    mark("zeli serve boot")
    let d = tmpf("serveboot")
    if !reset_dir(d) {
        bad("zeli serve boot (setup)", "")
        return
    }
    let rpcbin = tmpf("serve_rpc_probe")
    let bootbin = tmpf("serve_boot_probe")
    let rblog = tmpf("serve_rpc_build.log")
    let bblog = tmpf("serve_boot_build.log")
    if !sh("{{shq(LOAMC)}} packages/zeus/cli/serve_rpc_probe.loam -o {{shq(rpcbin)}} > {{shq(rblog)}} 2>&1") || !sh("{{shq(LOAMC)}} packages/zeus/cli/serve_boot_probe.loam -o {{shq(bootbin)}} > {{shq(bblog)}} 2>&1") {
        bad2("zeli serve boot (setup)", rblog, bblog)
        return
    }
    mkdirp("{{d}}/app")
    cpR("packages/loam/tests/routes_app/routes", "{{d}}/app/routes")
    cp("packages/loam/tests/routes_app/app.loam", "{{d}}/app/app.loam")
    let rpclog = tmpf("serve_boot_rpc.log")
    let rpcout = tmpf("serve_boot_rpc.out")
    let srvlog = tmpf("serve_boot.log")
    rmrf(rpclog)
    rmrf(srvlog)
    let rpcpid = spawn("{{shq(rpcbin)}} 5197 {{shq(rpclog)}} > {{shq(rpcout)}} 2>&1")
    let srvpid = spawn("LOAM_RPC_ADDR=127.0.0.1:5197 {{shq(ZELI)}} serve {{shq(d)}}/app --port 5199 > {{shq(srvlog)}} 2>&1")
    let mut i = 0
    while i < 200 && !file_has(srvlog, "zeli: serve on http") && pid_alive(srvpid) {
        sys.exec("sleep 0.1")
        i += 1
    }
    if !pid_alive(srvpid) || !file_has(srvlog, "zeli: serve on http") {
        kill_pid(rpcpid)
        if file_has(srvlog, "cannot bind") {
            skip("zeli serve boot (this host cannot bind a listening socket)")
            catlog(srvlog)
        } else {
            bad2("zeli serve boot (the server never came up)", srvlog, rpcout)
        }
        return
    }
    let probeout = tmpf("serve_boot_probe.out")
    let dbstat = rc("{{shq(bootbin)}} 5199 5197 {{shq(d)}}/app {{shq(rpclog)}} > {{shq(probeout)}} 2>&1")
    sys.exec("sleep 3")
    let rebuilt = count_matches(srvlog, "zeli: rebuilt")
    kill_pid(srvpid)
    kill_pid(rpcpid)
    catlog(probeout)
    if dbstat != 0 {
        bad("zeli serve boot", srvlog)
        return
    }
    if rebuilt != 1 {
        bad("zeli serve boot (one edit was {{rebuilt}} rebuilds - a self-triggered cascade?)", srvlog)
        return
    }
    ok("zeli serve boot (serves, rebuilds, pushes a frame, proxies)")
}

