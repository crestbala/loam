//! Phase 5 PIXEL golden: the reference screen rasterized by Zeus itself.
//!
//! `ref_scene.loam` is the STRUCTURAL half (the draw list at 1x). This is the
//! pixel half: the same elements, rasterized by the Loam rasterizer at the
//! physical backing scale (2x) into the buffer Zeus owns, then dumped as a PPM.
//! No graphics API is involved anywhere — the bytes in the golden are bytes this
//! project produced.
//!
//! Keep this in step with `ref_scene.loam` for the elements both cover. The one
//! the raster pass still cannot do is the image op (it blits images the app has
//! decoded and registered, and this program has no decode in it); text IS here,
//! drawn through std:font + the glyph atlas with no font API — at the three body
//! sizes the baseline calls out, using the test fixture font, because the tree
//! ships no usable UI font. A real app points `scene_load_font` at a real font
//! file and the same code path draws it.
//!
//! Usage: `raster_scene <out.ppm>` (capture.sh passes the path).

import "std:sys"
import "std:zeus"

fn main() {
    let argv = sys.args()
    let mut out = "tests/golden/raster_scene.ppm"
    if argv.len > 1 {
        out = argv[1]
    }
    if zeus.scene_load_font("packages/loam/tests/fonts/tiny.ttf") != 1 {
        sys.exit(5)
    }

    // 160x196 logical at scale 2 -> a 320x392 physical image.
    zeus.window("zeus-golden", 160, 196)
    zeus.root(zeus.Box(align_direction = DIRECTION.Column, padding = 8, spacing = 6,
                       background = "#ffffff") {
        // Body text at the three sizes the baseline calls out, at 2x.
        zeus.Box(align_direction = DIRECTION.Row, spacing = 4) {
            zeus.Text("AC", font = 11, color = "#111111")
            zeus.Text("AC", font = 13, color = "#111111")
            zeus.Text("AC", font = 17, color = "#111111")
        }
        // A stroke-only SVG icon: parsed and rasterized in Loam from the
        // markup, no host svg reader. `currentColor` is the op's fg here.
        zeus.Box(align_direction = DIRECTION.Row, spacing = 6) {
            zeus.Icon("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><circle cx='12' cy='12' r='10' fill='none' stroke='currentColor' stroke-width='1.5'/><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M12 16v-4'/><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M12 8h.01'/></svg>",
                      16, "#111111")
            // Greedy word wrap, three lines at this width.
            zeus.Box(width = 100) {
                zeus.Text("AC AC AC AC AC", font = 11, color = "#111111", wrap = 1)
            }
        }
        // A 1px hairline border: it must land on exactly two device rows.
        zeus.Box(width = 144, height = 20, border = 1, border_color = "#cccccc")
        // Rounded card with a border and a drop shadow.
        zeus.Box(width = 144, height = 28, radius = 8, background = "#f4f4f5",
                 border = 1, border_color = "#e4e4e7", elevation = 2)
        // Vertical gradient, `bg` down to `bg2`.
        zeus.set_background_end(
            zeus.Box(width = 144, height = 40, radius = 6, background = "#4f46e5"),
            zeus.rgb(14, 165, 233))
    })
    zeus.engine_layout(160, 196)
    zeus.engine_paint()

    zeus.raster_ensure(160, 196, 2)
    zeus.scene_rasterize(2, 255, 255, 255)

    // The pass must not be silently dropping the elements this screen is made
    // of: shapes, gradients and text should leave nothing unhandled.
    if zeus.scene_raster_unhandled_total() != 0 {
        sys.exit(2)
    }
    if zeus.scene_glyphs_missing() != 0 {
        sys.exit(6)
    }
    if zeus.raster_width() != 320 {
        sys.exit(3)
    }
    if zeus.raster_dump_ppm(out) != 0 {
        sys.exit(4)
    }
}
